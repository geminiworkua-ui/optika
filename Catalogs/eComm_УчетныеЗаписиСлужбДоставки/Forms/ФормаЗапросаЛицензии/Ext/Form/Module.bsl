
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("СлужбаДоставки", СлужбаДоставки);
	Параметры.Свойство("УчетнаяЗапись", УчетнаяЗапись);
	
	Заголовок = Заголовок + " (" + СлужбаДоставки + ")";
	
	ОбновитьОпцииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТарифПриИзмененииНаКлиенте();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ТарифПриИзменении(Элемент)
	
	ТарифПриИзмененииНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОпцийИспользоватьПриИзменении(Элемент)
	
	ИндексТекущейСтроки = Элементы.ДеревоОпций.ТекущаяСтрока;

	Если ИндексТекущейСтроки <> Неопределено Тогда
		
		ЭлементКоллекции = ЭтаФорма["ДеревоОпций"].НайтиПоИдентификатору(ИндексТекущейСтроки);
		
		УстановкаФлажков(ЭлементКоллекции, ЭлементКоллекции.Использовать);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьЛицензию(Команда)
	
	Если ПроверитьЗаполнение() Тогда 
		
		СписокОпций = Новый СписокЗначений;
		
		Корень = ДеревоОпций.ПолучитьЭлементы();
	
		Для Каждого СтрокаКорня Из Корень Цикл 
			
			СписокОпций.Добавить(СтрокаКорня.КлючСтроки, , СтрокаКорня.Использовать);
			
			Для Каждого СтрокаДополнительнойОпции Из СтрокаКорня.ПолучитьЭлементы() Цикл 
				СписокОпций.Добавить(СтрокаДополнительнойОпции.КлючСтроки, , СтрокаДополнительнойОпции.Использовать);
			КонецЦикла;
			
		КонецЦикла;
		
		Если ОпцииВыбраны(СписокОпций) = Истина Тогда
			СтруктураЛицензии = Новый Структура("mail, phone, delivery, edrpou_drfo, option_list", АдресЭлектроннойПочты, КонтактныйТелефон, СлужбаДоставки, ЕДРПОУ_ДРФО, СписокОпций);
			Закрыть(СтруктураЛицензии);
		Иначе
			ТекстПредупреждения = НСтр("ru = 'Выберите тариф/приобретенные функции в списке опций или же обратитесь в техническую поддержку за помощью.';
										|uk = 'Відмітьте тариф/придбані функції в списку опцій або ж зверніться до технічної підтримки за допомогою.'");
			Сообщить(ТекстПредупреждения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


