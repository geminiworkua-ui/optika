// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаКлиенте
Процедура ТарифПриИзмененииНаКлиенте()
	
	Корень = ДеревоОпций.ПолучитьЭлементы();
	
	Если Тариф = 0 Тогда 
		
		Корень.Очистить();
		ОбновитьОпцииНаСервере();
		
		Для Каждого СтрокаКорня Из Корень Цикл
			Элементы.ДеревоОпций.Развернуть(СтрокаКорня.ПолучитьИдентификатор(), Истина);
		КонецЦикла;
		
	Иначе
		
		Для Каждого СтрокаКорня Из Корень Цикл 
			
			Если НЕ Тариф = 2 Тогда 
				СтрокаКорня.Использовать = Истина;
			КонецЕсли;
			
			Для Каждого СтрокаДополнительнойОпции Из СтрокаКорня.ПолучитьЭлементы() Цикл 
				
				Если Тариф = 3 Тогда 
					СтрокаДополнительнойОпции.Использовать = Истина;
				ИначеЕсли Тариф = 1 Тогда 
					СтрокаДополнительнойОпции.Использовать = Ложь;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Элементы.ДеревоОпций.ТолькоПросмотр = НЕ Тариф = 2; // Для произвольного набора оставим доступность

КонецПроцедуры

&НаСервере
Процедура ОбновитьОпцииНаСервере()

	Настройки = eCommДоставкаСервер.Настройки(УчетнаяЗапись);
	
	ТабОпций = Справочники.eComm_УчетныеЗаписиСлужбДоставки.ТаблицаОпций(Настройки);
	
	СтрокиОсновныхОпций = ТабОпций.НайтиСтроки(Новый Структура("КлючСтрокиРодителя", Неопределено));
	
	Корень = ДеревоОпций.ПолучитьЭлементы();
	
	Для Каждого СтрокаОсновнойОпции Из СтрокиОсновныхОпций Цикл 
		
		НоваяОсновнаяОпция = Корень.Добавить();
		НоваяОсновнаяОпция.Наименование = СтрокаОсновнойОпции.Наименование;
		НоваяОсновнаяОпция.Использовать = СтрокаОсновнойОпции.Использовать;
		НоваяОсновнаяОпция.КлючСтроки 	= СтрокаОсновнойОпции.КлючСтроки;

		СтрокиДопОпций = НоваяОсновнаяОпция.ПолучитьЭлементы();
		СтрокиДополнительныхОпций = ТабОпций.НайтиСтроки(Новый Структура("КлючСтрокиРодителя", СтрокаОсновнойОпции.КлючСтроки));
		
		Для Каждого СтрокаДополнительнойОпции Из СтрокиДополнительныхОпций Цикл 
			НоваяСтрокаДопОпции = СтрокиДопОпций.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДопОпции, СтрокаДополнительнойОпции);
		КонецЦикла;
		
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура УстановкаФлажков(ЭлементКоллекции, ЗначениеПометки)

    ПодчинЭлементы = ЭлементКоллекции.ПолучитьЭлементы();
    Для Каждого ТекЭлемент Из ПодчинЭлементы Цикл
		
		ТекЭлемент.Использовать = ЗначениеПометки;
        УстановкаФлажков(ТекЭлемент, ТекЭлемент.Использовать);
		
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ОпцииВыбраны(СписокОпций)

	Результат = Ложь;
	Для Каждого ЗначениеОпции Из СписокОпций Цикл 
		Если ЗначениеОпции.Пометка = Истина Тогда 
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
	
КонецФункции