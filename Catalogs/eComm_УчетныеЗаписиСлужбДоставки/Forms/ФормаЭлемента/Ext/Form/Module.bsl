&НаСервере
Процедура ВосстановитьРеквизиты(ТекущийОбъект)
	
	Настройки = ТекущийОбъект.Настройки.Получить();
	
	Если Не ТекущийОбъект = Неопределено Тогда
		Если Не ТипЗнч(Настройки) = Тип("Структура") Тогда
			НастройкиОбмена = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ПрочитатьНастройкиОбмена(Настройки, "ДанныеЗаполнения");
	ПрочитатьНастройкиОбмена(Настройки, "Настройки");

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиОбмена(НастройкиОбмена, БлокНастроек, МассивДополнительныхРеквизитов)

	ДополнительныеРеквизиты = Новый Структура;
	Для Каждого ЭлементМассива Из МассивДополнительныхРеквизитов Цикл
		Если ТипЗнч(ЭтаФорма[ЭлементМассива]) = Тип("ДанныеФормыКоллекция") Тогда
			ЗначениеРеквизита = РеквизитФормыВЗначение(ЭлементМассива);
		Иначе
			ЗначениеРеквизита = ЭтаФорма[ЭлементМассива];
		КонецЕсли;
		ДополнительныеРеквизиты.Вставить(ЭлементМассива, ЗначениеРеквизита);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ДополнительныеРеквизиты) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОбмена.Вставить(БлокНастроек, ДополнительныеРеквизиты);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройкиОбмена(НастройкиОбмена, БлокНастроек)

	Если НастройкиОбмена.Свойство(БлокНастроек) Тогда
		
		Если ТипЗнч(НастройкиОбмена[БлокНастроек]) = Тип("Структура") Тогда
			Для Каждого КлючЗначение Из НастройкиОбмена[БлокНастроек] Цикл
				Попытка
					Если ТипЗнч(КлючЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
						ЭтаФорма[КлючЗначение.Ключ].Загрузить(КлючЗначение.Значение);
					Иначе
						ЭтаФорма[КлючЗначение.Ключ] = КлючЗначение.Значение;
						Если ТипЗнч(КлючЗначение.Значение) = Тип("СписокЗначений") Тогда 
							// Может быть интерфейсный элемент
							//ЭтаФорма["" + КлючЗначение.Ключ + "Строкой"] = ВернутьПредставлениеСпискаЗначений(КлючЗначение.Значение);
							Элементы.ДекорацияОбновляемыеСправочники.Заголовок = ВернутьПредставлениеСпискаЗначений(КлючЗначение.Значение);
						КонецЕсли;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
			//++ На время обновления до версии 2.6.0.4
			Если Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта
				И БлокНастроек = "Настройки"
				И ТипОтправки = "ЗаборПоАдресу"
				И НЕ НастройкиОбмена[БлокНастроек].Свойство("ИспользоватьАдресОтправителяНоваяПочтаСтрокой")
				И НЕ ЗначениеЗаполнено(АдресОтправителя)
				И ЗначениеЗаполнено(УлицаОтправителяСтрокой) Тогда 
				ИспользоватьАдресОтправителяНоваяПочтаСтрокой = Истина;
			КонецЕсли;
			//--
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ

&НаСервере
Процедура УстановитьВидимость()

	// Применим настройки согласно шаблона для службы доставки
	//
	
	Если НЕ ЗначениеЗаполнено(Объект.СлужбаДоставки) Тогда 
		Возврат;
	КонецЕсли;
	
	МакетНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.ПолучитьМакет("НастройкиДоступностиРеквизитов");
	
	КоличествоЗаписей = МакетНастроек.ВысотаТаблицы;
	
	ИмяЗначенияПеречисления = eCommДоставкаСервер.ВернутьИмяЗначенияПеречисления(Объект.СлужбаДоставки);
	НомерКолонки			= 0;
	
	Для Сч = 0 По МакетНастроек.ШиринаТаблицы Цикл
		Если СокрЛП(МакетНастроек.Область(1, Сч).Текст) = ИмяЗначенияПеречисления Тогда 
			НомерКолонки = Сч;
		КонецЕсли;
	КонецЦикла;
		
	Для Сч = 2 по КоличествоЗаписей Цикл
		
		ИмяЭлемента = СокрЛП(МакетНастроек.Область(Сч, 1).Текст);
		
		Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда 
			Продолжить;
		КонецЕсли;
		
		Видимость = СокрЛП(МакетНастроек.Область(Сч, НомерКолонки).Текст) = "+";
		
		Если НЕ Элементы[ИмяЭлемента].Видимость = Видимость Тогда 
			Элементы[ИмяЭлемента].Видимость = Видимость;
		КонецЕсли;
		
	КонецЦикла;
	
	
	// Применим настройки учетной записи
	//
	
	Если ТипОтправки = "ЗаборПоАдресу" Тогда 
		ЭтоАдреснаяОтправка = Истина;
	Иначе
		ЭтоАдреснаяОтправка = Ложь;
	КонецЕсли;
	
	Элементы.ОтделениеОтправителя.Видимость								= НЕ ЭтоАдреснаяОтправка;
	Элементы.ГруппаУлицаНомерДомаОтправилеля.Видимость 					= ЭтоАдреснаяОтправка И ИспользоватьАдресОтправителяНоваяПочтаСтрокой;
	Элементы.ГруппаАдресОтправителяПоКлассифкаторуНоваяПочта.Видимость 	= ЭтоАдреснаяОтправка И НЕ ИспользоватьАдресОтправителяНоваяПочтаСтрокой;
	Элементы.ИспользоватьАдресОтправителяНоваяПочтаСтрокой.Видимость	= ЭтоАдреснаяОтправка; 
	
	ТипПостОплатыПриИзмененииНаСервере();
	СоздаватьПКОПриИзмененииНаСервере();
	ЗаполнятьДополнительнуюИнформациюПоЗаказуПриИзмененииНаСервере();

КонецПроцедуры

&НаСервере
Процедура УстановитьЛоготип()

	Если Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		Элементы.Декорация.Картинка = Элементы.ДекорацияНоваяПочта.Картинка;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Элементы.Декорация.Картинка = Элементы.ДекорацияУкрПочта.Картинка;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
		Элементы.Декорация.Картинка = Элементы.ДекорацияJustin.Картинка;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		Элементы.Декорация.Картинка = Элементы.ДекорацияMeest.Картинка;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОВыбореРасписания(НовоеРасписание, ИмяРеквизитаРасписание) Экспорт

	Если НЕ НовоеРасписание = Неопределено
		И ЭтаФорма[ИмяРеквизитаРасписание] <> НовоеРасписание Тогда
		Модифицированность = Истина;
		ЭтаФорма[ИмяРеквизитаРасписание]   = НовоеРасписание;
		Элементы[ИмяРеквизитаРасписание + "Строкой"].Заголовок  = Строка(ЭтаФорма[ИмяРеквизитаРасписание]);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеЗапросаЛицензии(СтруктураЛицензии, ДопПараметры) Экспорт

	Если ТипЗнч(СтруктураЛицензии) = Тип("Структура")
		И СтруктураЛицензии.Свойство("mail") Тогда 
		ЗапроситьЛицензионныйКлючСервере(СтруктураЛицензии);
		ПоказатьПредупреждение(,"Лицензионный ключ будет отправлен на электронный ящик """ + СтруктураЛицензии.mail + """");
	Иначе
		Сообщить("Почта не введена!!!");
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗапроситьЛицензионныйКлючСервере(СтруктураЛицензии)

	СтруктураНастроек = eCommДоставкаСервер.Настройки(Объект.Ссылка);
	Справочники.eComm_УчетныеЗаписиСлужбДоставки.ЗапроситьЛицензионныйКлюч(СтруктураНастроек, СтруктураЛицензии);

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораТипаКонтрагента()

	СлужбаДоставкиУчетнойЗаписи = Объект.СлужбаДоставки;
	Если СлужбаДоставкиУчетнойЗаписи = Перечисления.eComm_СлужбыДоставки.УкрПочта 
		ИЛИ СлужбаДоставкиУчетнойЗаписи = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		РодительТиповКонтрагентов = Справочники.eComm_ОбщиеСправочники.ТипыКонтрагентовУкрпочта;
	Иначе
		РодительТиповКонтрагентов = Справочники.eComm_ОбщиеСправочники.ТипыКонтрагентов;
	КонецЕсли;
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Родитель", РодительТиповКонтрагентов));    

	Элементы.ТипПолучателя.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
	// Приведем тип
	Если НЕ ТипПолучателя.Родитель = РодительТиповКонтрагентов Тогда 
		ТипПолучателя = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораСтатусаСозданияПКО()
	
	МассивПараметровВыбора = Новый Массив;
	
	СлужбаДоставкиУчетнойЗаписи = Объект.СлужбаДоставки;
	Если СлужбаДоставкиУчетнойЗаписи = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		
		РодительСтатусовСозданияПКО = Справочники.eComm_ОбщиеСправочники.СтатусыЭкспрессНакладных;
		
		МассивИдентификаторов = Новый Массив;
		МассивИдентификаторов.Добавить("10");
		МассивИдентификаторов.Добавить("11");
		
	ИначеЕсли СлужбаДоставкиУчетнойЗаписи = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		
		РодительСтатусовСозданияПКО = Справочники.eComm_ОбщиеСправочники.СтатусыЭкспрессНакладныхУкрпочта;
		
		МассивИдентификаторов = Новый Массив;
		МассивИдентификаторов.Добавить("DELIVERED");
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Родитель", РодительСтатусовСозданияПКО));
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Идентификатор", Новый ФиксированныйМассив(МассивИдентификаторов)));

	Элементы.СтатусСозданияПКО.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
	// Приведем тип
	Если НЕ СтатусСозданияПКО.Родитель = РодительСтатусовСозданияПКО Тогда 
		СтатусСозданияПКО = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ТипПостОплатыПриИзмененииНаСервере()
	
	Если ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.КонтрольОплаты 
		ИЛИ Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Элементы.ГруппаКонтрольОплат.Видимость 		= Истина;
		Элементы.ГруппаОбратнаяДоставка.Видимость 	= Ложь;
		ИмяКонфигурации = eCommДоставкаСервер.ИмяКонфигурации();
		Если ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда 
			Если НЕ Элементы.ГруппаКонтрольОплатУТП.Видимость = Истина Тогда 
				Элементы.ГруппаКонтрольОплатУТП.Видимость = Истина;
			КонецЕсли;
			Если НЕ Элементы.ГруппаКонтрольОплатУТBAS.Видимость = Ложь Тогда 
				Элементы.ГруппаКонтрольОплатУТBAS.Видимость = Ложь
			КонецЕсли;
		Иначе 
			Если НЕ Элементы.ГруппаКонтрольОплатУТBAS.Видимость = Истина Тогда 
				Элементы.ГруппаКонтрольОплатУТBAS.Видимость = Истина;
			КонецЕсли;
			Если НЕ Элементы.ГруппаКонтрольОплатУТП.Видимость = Ложь Тогда 
				Элементы.ГруппаКонтрольОплатУТП.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Элементы.ГруппаКонтрольОплат.Видимость 		= Ложь;
		Элементы.ГруппаОбратнаяДоставка.Видимость 	= Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздаватьПКОПриИзмененииНаСервере()

	Элементы.ГруппаПКО.Видимость = СоздаватьПКО;

КонецПроцедуры

&НаСервере
Процедура КонтактноеЛицоОтправителяПриИзмененииНаСервере()
	
	ТелефонОтправителя = КонтактноеЛицоОтправителя.Телефон;
	
КонецПроцедуры

&НаСервере
Процедура СпособОтправкиСМСПриИзмененииНаСервере()

	ОтправлятьВФоне = СпособОтправкиСМС = "ОтправлятьВФоне";
	
	Если Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		Элементы.СтатусФоновойОтправкиСМСНоваяПочта.Видимость 	= ОтправлятьВФоне;
		Элементы.СтатусФоновойОтправкиСМСУкрпочта.Видимость 	= Ложь;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда
		Элементы.СтатусФоновойОтправкиСМСНоваяПочта.Видимость 	= Ложь;
		Элементы.СтатусФоновойОтправкиСМСУкрпочта.Видимость 	= ОтправлятьВФоне;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнятьОбщийВесОбъемПоЗаказуПриИзмененииНаСервере()

	Элементы.ГруппаВесОбъемИзНастроек.Видимость = НЕ ЗаполнятьОбщийВесОбъемПоЗаказу;
	Элементы.ГруппаВесОбъемПоЗаказу.Видимость = ЗаполнятьОбщийВесОбъемПоЗаказу;

КонецПроцедуры

&НаСервере
Процедура ЗаполнятьДополнительнуюИнформациюПоЗаказуПриИзмененииНаСервере()

	Элементы.ДополнительнаяИнформация.Видимость = НЕ ЗаполнятьДополнительнуюИнформациюПоЗаказу;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СправочникиОбновлены(УчетнаяЗапись)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	eComm_КонтрагентыДоставки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_КонтрагентыДоставки КАК eComm_КонтрагентыДоставки
		|ГДЕ
		|	eComm_КонтрагентыДоставки.Отправитель = ИСТИНА";
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(РезультатВыбора, УчетнаяЗапись) Экспорт

	Если НЕ РезультатВыбора = КодВозвратаДиалога.ОК Тогда 
		Возврат;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда 
			Объект.Наименование = Объект.СлужбаДоставки;
		КонецЕсли;
		
		Записать();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		ОбновитьСтправочники(Объект.Ссылка);
		Состояние("Обновление справочников завершено",,"Обновление завершено");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтправочники(УчетнаяЗапись)

	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(УчетнаяЗапись);

	Справочники.eComm_УчетныеЗаписиСлужбДоставки.ОбновитьСправочники(СтруктураНастроек);	

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСписокДополнительныхУслуг(СписокДополнительныхУслуг, ДопПараметры) Экспорт

	Если СписокДополнительныхУслуг = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Объект.ДополнительныеУслуги.Очистить();
	
	ОписаниеКатегорий = "";
	
	Для Каждого СтруктураУслуги Из СписокДополнительныхУслуг Цикл 
		ЗаполнитьЗначенияСвойств(Объект.ДополнительныеУслуги.Добавить(), СтруктураУслуги);
	КонецЦикла;
	
	ЗаполнитьПредставлениеДополнительныхУслуг();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеДополнительныхУслуг()

	Если НЕ Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Возврат;
	КонецЕсли;
	
	ОписаниеДопУслуг = "";
	Для Каждого Стр Из Объект.ДополнительныеУслуги Цикл 
		ОписаниеДопУслуг = ОписаниеДопУслуг + ?(ОписаниеДопУслуг = "", "", "; ") + Стр.Услуга;
	КонецЦикла;
	
	Если ОписаниеДопУслуг = "" Тогда 
		ОписаниеДопУслуг = НСтр("ru = '<не выбрано>'; uk = '<не вибрано>'");
	КонецЕсли;
	
	ДополнительныеУслугиСтрокой = ОписаниеДопУслуг;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкуОбОзнакомленииСУведомлением()

	Если Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		ОзнакомленСИнформациейОNovaPoshta = НЕ ОзнакомленСИнформациейОNovaPoshta;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		ОзнакомленСИнформациейОUkrpost = НЕ ОзнакомленСИнформациейОUkrpost;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
		ОзнакомленСИнформациейОJustin = НЕ ОзнакомленСИнформациейОJustin;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		ОзнакомленСИнформациейОMeest = НЕ ОзнакомленСИнформациейОMeest;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоказыватьУведомлениеДляСлужбыДоставки()

	Если Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		Результат = НЕ ОзнакомленСИнформациейОNovaPoshta;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Результат = НЕ ОзнакомленСИнформациейОUkrpost;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
		Результат = НЕ ОзнакомленСИнформациейОJustin;
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		Результат = НЕ ОзнакомленСИнформациейОMeest;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция УстановитьТекстУведомленияДляСлужбыДоставки()

	Если Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		ТекстУведомления = Новый Массив;
		ТекстУведомления.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Изменения в личном кабинете'; uk = 'Зміни в особистому кабінеті'"), Новый Шрифт(,,Истина)));
		ТекстУведомления.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = ' (https://new.novaposhta.ua) экспресс-накладных или реестров, созданных через BAS/1С, '; uk = ' (https://new.novaposhta.ua) експрес-накладних або реєстрів, створених через BAS/1С, '")));
		ТекстУведомления.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'не будут отображаться'; uk = 'не будуть відображатись'"), Новый Шрифт(,,Истина)));
		ТекстУведомления.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = ' в учетной системе!!! Поэтому рекомендуется все изменения этих накладных/реестров производить на стороне BAS/1С.';
																   |uk = ' в обліковій системі!!! Тому рекомендується всі зміни ціх накладних/реєстрів проводити на стороні BAS/1C.'")));
	ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		ТекстУведомления = Новый Массив;
