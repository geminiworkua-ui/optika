
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТипОправителя = Истина;	
	// Расписания обмена
	Если НЕ ТипЗнч(РасписаниеОбменаСправочников) = Тип("РасписаниеРегламентногоЗадания") Тогда
		РасписаниеОбменаСправочников = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	Если НЕ ТипЗнч(РасписаниеОбменаСтатусовЭН) = Тип("РасписаниеРегламентногоЗадания") Тогда
		РасписаниеОбменаСтатусовЭН = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		УстановитьВидимость();
		
		Если Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
			ТипГруза 	= Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "Parcel", Справочники.eComm_ОбщиеСправочники.ВидыГруза);
		ИначеЕсли Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
			ТипГруза 	= Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "EXPRESS", Справочники.eComm_ОбщиеСправочники.ТипыОтправкиУкрпочта);
		КонецЕсли;
		
	    ТипПолучателя 	= eCommДоставкаСервер.ТипКонтрагентаЧастноеЛицо(Объект.СлужбаДоставки);
		ОписаниеГруза 	= "Товар";
		
	КонецЕсли;
	
	СпособОтправкиСМСПриИзмененииНаСервере();
	ЗаполнятьОбщийВесОбъемПоЗаказуПриИзмененииНаСервере();
	
	ЗаполнитьПредставлениеДополнительныхУслуг();
	
	УстановитьВидимостьСворачиваемыхГрупп();
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Заголовок = "Новое подключение (" + eCommДоставкаСервер.ВерсияБиблиотеки() + ")";
	КонецЕсли;
	
	УстановитьЛоготип();
	УстановитьПараметрыВыбораТипаКонтрагента();
	УстановитьПараметрыВыбораСтатусаСозданияПКО();
	
	ПоказатьИнформациюОЛицензии();
	
	// На время обмена до версии 2.5.0.0
	ЗаполнитьЗначенияДополнительныхРеквизитовПоУмолчанию();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Блок рег задания. Справочники
	Если ТипЗнч(РасписаниеОбменаСправочников) = Тип("РасписаниеРегламентногоЗадания") Тогда 
		Если Не ЗначениеЗаполнено(ТекущийОбъект.РегламентноеЗаданиеОбменаСправочниками) Тогда
			ЗаданиеСправочники = Неопределено;
		Иначе
			ЗаданиеСправочники = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ТекущийОбъект.РегламентноеЗаданиеОбменаСправочниками);
		КонецЕсли;
		
		Если ЗаданиеСправочники = Неопределено Тогда
			ЗаданиеСправочники = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.eComm_ОбновитьСправочникиДоставки);
		КонецЕсли;
		
		ЗаданиеСправочники.Использование = Объект.ОбменПоРегламентномуЗаданиюСправочники;
		
		НаименованиеЗадания = НСтр("ru='Обмен справочников по профилю %Профиль%';uk='Обмін довідників за профілем %Профиль%'");
		НаименованиеЗадания = СтрЗаменить(НаименованиеЗадания, "%Профиль%", ТекущийОбъект.Наименование);
		ЗаданиеСправочники.Наименование = НаименованиеЗадания;
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(ТекущийОбъект.Ссылка);
		ПараметрыЗадания.Добавить("ОбновлениеСправочников");
		
		ЗаданиеСправочники.Параметры  = ПараметрыЗадания;
		ЗаданиеСправочники.Расписание = РасписаниеОбменаСправочников;
		
		ЗаданиеСправочники.Записать();
		
		ТекущийОбъект.РегламентноеЗаданиеОбменаСправочниками = ЗаданиеСправочники.УникальныйИдентификатор;
		
	КонецЕсли;
	
	
	Если ТипЗнч(РасписаниеОбменаСтатусовЭН) = Тип("РасписаниеРегламентногоЗадания") Тогда
		// Блок рег задания. Статусы ЭН
		Если Не ЗначениеЗаполнено(ТекущийОбъект.РегламентноеЗаданиеОбменаСтатусамиЭН) Тогда
			ЗаданиеСтатусыЭН = Неопределено;
		Иначе
			ЗаданиеСтатусыЭН = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ТекущийОбъект.РегламентноеЗаданиеОбменаСтатусамиЭН);
		КонецЕсли;
		
		Если ЗаданиеСтатусыЭН = Неопределено Тогда
			ЗаданиеСтатусыЭН = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.eComm_ОбновитьСправочникиДоставки);
		КонецЕсли;
		
		ЗаданиеСтатусыЭН.Использование = Объект.ОбменПоРегламентномуЗаданиюСтатусыЭН;
		
		НаименованиеЗадания = НСтр("ru='Обмен статусами ЭН по профилю %Профиль%';uk='Обмін статусами ЕН за профілем %Профиль%'");
		НаименованиеЗадания = СтрЗаменить(НаименованиеЗадания, "%Профиль%", ТекущийОбъект.Наименование);
		ЗаданиеСтатусыЭН.Наименование = НаименованиеЗадания;
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(ТекущийОбъект.Ссылка);
		ПараметрыЗадания.Добавить("ОбновлениеСтатусовЭН");
		
		ЗаданиеСтатусыЭН.Параметры  = ПараметрыЗадания;
		ЗаданиеСтатусыЭН.Расписание = РасписаниеОбменаСтатусовЭН;
		
		ЗаданиеСтатусыЭН.Записать();
		
		ТекущийОбъект.РегламентноеЗаданиеОбменаСтатусамиЭН = ЗаданиеСтатусыЭН.УникальныйИдентификатор;
		
	КонецЕсли;
				
	УстановитьПривилегированныйРежим(Ложь);
	
	СохранитьРеквизиты(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПоказатьИнформациюОЛицензии();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Блок регламентных заданий. Справочники	
	ИдентификаторЗадания = ТекущийОбъект.РегламентноеЗаданиеОбменаСправочниками;
	
	ЗаданиеСправочники = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если ЗаданиеСправочники <> Неопределено Тогда
		РасписаниеОбменаСправочников = ЗаданиеСправочники.Расписание;
		Элементы.РасписаниеОбменаСправочниковСтрокой.Заголовок  = Строка(РасписаниеОбменаСправочников);
	КонецЕсли;
	
	// Блок регламентных заданий. Статусы ЭН	
	ИдентификаторЗадания = ТекущийОбъект.РегламентноеЗаданиеОбменаСтатусамиЭН;
	
	ЗаданиеСтатусыЭН = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если ЗаданиеСтатусыЭН <> Неопределено Тогда
		РасписаниеОбменаСтатусовЭН = ЗаданиеСтатусыЭН.Расписание;
		Элементы.РасписаниеОбменаСтатусовЭНСтрокой.Заголовок  = Строка(РасписаниеОбменаСтатусовЭН);
	КонецЕсли;

	Заголовок = "" + ТекущийОбъект.Ссылка + " (" + eCommДоставкаСервер.ВерсияБиблиотеки() + ")";
	
	ВосстановитьРеквизиты(ТекущийОбъект);
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если СтатусФоновойОтправкиСМС = "СпособОтправкиСМС" Тогда 
		ПроверяемыеРеквизиты.Добавить("СтатусФоновойОтправкиСМС");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	УстановитьТекстУведомленияДляСлужбыДоставки();
	Элементы.ГруппаУведомление.Видимость = ПоказыватьУведомлениеДляСлужбыДоставки();

КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура СлужбаДоставкиПриИзменении(Элемент)
	
	УстановитьЛоготип();
	УстановитьПараметрыВыбораТипаКонтрагента();
	УстановитьПараметрыВыбораСтатусаСозданияПКО();
	УстановитьВидимость();
	УстановитьТекстУведомленияДляСлужбыДоставки();
	Элементы.ГруппаУведомление.Видимость = ПоказыватьУведомлениеДляСлужбыДоставки();
	
	ЗаполнитьПредставлениеДополнительныхУслуг();
	
	ЗаполнитьЗначенияДополнительныхРеквизитовПоУмолчанию(Истина);
	
	ТипГруза = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура КлючПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.КлючAPI)
		И ЗначениеЗаполнено(Объект.ЛицензионныйКлюч) Тогда
		
		Если ЗначениеЗаполнено(Объект.Ссылка) 
			И НЕ СправочникиОбновлены(Объект.Ссылка) Тогда
			// Спросить / обновить справочники
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтаФорма, Объект.Ссылка);
			ТекстВопроса = "Произвести обновление справочников по учетной записи " + Объект.Ссылка + "?";
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , , "Обновление справочников");
			
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
			// Спросить / обновить справочники
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтаФорма, Объект.Ссылка);
			ТекстВопроса = "Произвести обновление справочников по текущей учетной записи?";
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , , "Обновление справочников");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьЛицензионныйКлюч(Команда)
	
	Если НЕ Модифицированность Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.КлючAPI) Тогда
			Сообщить(НСтр("ru = 'Ключ подключения к API не заполнен!!!'; uk = 'Ключ підключення до API не заповнений!!!'"));	
		Иначе
			ОписаниеОповещенияОВводе = Новый ОписаниеОповещения("ВыполнитьПослеЗапросаЛицензии", ЭтаФорма);
			ПараметрыОткрытия = Новый Структура("СлужбаДоставки, УчетнаяЗапись", Объект.СлужбаДоставки, Объект.Ссылка);
			ОткрытьФорму("Справочник.eComm_УчетныеЗаписиСлужбДоставки.Форма.ФормаЗапросаЛицензии", ПараметрыОткрытия, ЭтаФорма, , , , ОписаниеОповещенияОВводе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru = 'Элемент не записан!!!'; uk = 'Елемент не записаний!!!'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОбновляемыеПоляНажатие(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьЗначенияИзСписка", ЭтаФорма, "ОбновляемыеСправочники");
	
	ПараметрыОткрытия = Новый Структура("СписокЗначений, Заголовок", ОбновляемыеСправочники, "Список обновляемых справочников");
	ОткрытьФорму("Справочник.eComm_УчетныеЗаписиСлужбДоставки.Форма.ФормаСпискаЗначений", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписание(Команда)
	
	ИмяРеквизита = СтрЗаменить(Команда.Имя, "Настроить", "");
	
	ДиалогРасписания 	= Новый ДиалогРасписанияРегламентногоЗадания(ЭтаФорма[ИмяРеквизита]);
	
	ОповещениеОВыборе 	= Новый ОписаниеОповещения("ОповещениеОВыбореРасписания", ЭтаФорма, ИмяРеквизита);
	
	ДиалогРасписания.Показать(ОповещениеОВыборе);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактноеЛицоОтправителяПриИзменении(Элемент)
	КонтактноеЛицоОтправителяПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТипОтправкиПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура АдресОтправителяНоваяПочтаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипОтправки = "ЗаборПоАдресу" Тогда 
		ЭтоАдреснаяОтправка = Истина;
	Иначе
		ЭтоАдреснаяОтправка = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Отправитель) Тогда 
		Возврат;
	КонецЕсли;
	
	МассивАдресов = eCommДоставкаСервер.АдресаКлиентаНоваяПочта(Объект.Отправитель, КонтактноеЛицоОтправителя, Объект.СлужбаДоставки, НЕ ЭтоАдреснаяОтправка);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Каждого Адрес Из МассивАдресов Цикл 
		ДанныеВыбора.Добавить(Адрес);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресОтправителяУкрпочтаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипОтправки = "ЗаборПоАдресу" Тогда 
		ЭтоАдреснаяОтправка = Истина;
	Иначе
		ЭтоАдреснаяОтправка = Ложь;
	КонецЕсли;
	
	МассивАдресов = eCommДоставкаСервер.АдресаКлиента(Объект.Отправитель, КонтактноеЛицоОтправителя, Объект.СлужбаДоставки, НЕ ЭтоАдреснаяОтправка);
	
	ДанныеВыбора = Новый СписокЗначений;
	Для Каждого Адрес Из МассивАдресов Цикл 
		ДанныеВыбора.Добавить(Адрес);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПостОплатыПриИзменении(Элемент)
	
	ТипПостОплатыПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздаватьПКОПриИзменении(Элемент)
	
	СоздаватьПКОПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнятьОбщийВесОбъемПоЗаказуПриИзменении(Элемент)
	
	ЗаполнятьОбщийВесОбъемПоЗаказуПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнятьДополнительнуюИнформациюПоЗаказуПриИзменении(Элемент)
	
	ЗаполнятьДополнительнуюИнформациюПоЗаказуПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СпособОтправкиСМСПриИзменении(Элемент)
	
	СпособОтправкиСМСПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеУслугиСтрокойНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьСписокДополнительныхУслуг", ЭтаФорма);
	
	ДополнительныеУслуги = Новый Массив;
	Для Каждого Стр Из Объект.ДополнительныеУслуги Цикл 
		ДополнительныеУслуги.Добавить(Новый Структура("Услуга", Стр.Услуга));
	КонецЦикла;
	
	ПараметрыОткрытия = Новый Структура("ДополнительныеУслуги", ДополнительныеУслуги);
	ОткрытьФорму("Справочник.eComm_УчетныеЗаписиСлужбДоставки.Форма.ФормаДополнительныхУслуг", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДополнительнуюИнформацию(Команда)
	
	СохранитьНастройкуОбОзнакомленииСУведомлением();
	Элементы.ГруппаУведомление.Видимость = ПоказыватьУведомлениеДляСлужбыДоставки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗначенияУчетныхЗаписейПоУмолчанию(Команда)
	
	ОткрытьФорму("РегистрСведений.eComm_ЗначенияУчетныхЗаписейДоставкиПоУмолчанию.ФормаСписка", , ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЗакрытьУведомлениеНажатие(Элемент)
	
	СохранитьНастройкуОбОзнакомленииСУведомлением();
	Элементы.ГруппаУведомление.Видимость = ПоказыватьУведомлениеДляСлужбыДоставки();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьАдресОтправителяНоваяПочтаСтрокойПриИзменении(Элемент)
	
	Если ИспользоватьАдресОтправителяНоваяПочтаСтрокой = Истина Тогда 
		Элементы.ГруппаУлицаНомерДомаОтправилеля.Видимость 					= Истина;
		Элементы.ГруппаАдресОтправителяПоКлассифкаторуНоваяПочта.Видимость 	= Ложь;
	Иначе
		Элементы.ГруппаУлицаНомерДомаОтправилеля.Видимость 					= Ложь;
		Элементы.ГруппаАдресОтправителяПоКлассифкаторуНоваяПочта.Видимость 	= Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЛимитыПостоплаты(Команда)
	
	Отбор = Новый Структура("УчетнаяЗапись", Объект.Ссылка);
	ПараметрыОткрытия = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("РегистрСведений.eComm_ЛимитыПослеплаты.ФормаСписка", ПараметрыОткрытия, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


