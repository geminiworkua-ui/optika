&НаКлиенте
Процедура ВыбратьЗначенияИзСписка(Результат, ИмяРеквизитаСписокЗначений = "") Экспорт

	Если НЕ ТипЗнч(Результат) = Тип("СписокЗначений") 
		ИЛИ ИмяРеквизитаСписокЗначений = "" Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	Элементы.ДекорацияОбновляемыеСправочники.Заголовок = ВернутьПредставлениеСпискаЗначений(Результат);
	ЭтаФорма.ОбновляемыеСправочники = Результат;

КонецПроцедуры

&НаСервере
Функция ВернутьПредставлениеСпискаЗначений(Список)

	СтрокаСостоянияВыбора = "";
	Для Каждого Стр Из Список Цикл 
		Если Стр.Пометка Тогда 
			СтрокаСостоянияВыбора = СтрокаСостоянияВыбора + ?(СтрокаСостоянияВыбора = "", "", "; ") + Стр.Представление;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаСостоянияВыбора = "" Тогда 
		СтрокаСостоянияВыбора = НСтр("ru = '<не выбрано>'; uk = '<не вибрано>'");
	КонецЕсли;
	
	Возврат СтрокаСостоянияВыбора;

КонецФункции

&НаСервере
Процедура ЗаполнитьЗначенияДополнительныхРеквизитовПоУмолчанию(Перезаполнить = Ложь)

	Если НЕ Перезаполнить
		И НЕ ОбновляемыеСправочники.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ОбновляемыеСправочники.Очистить();
	
	Если Объект.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		
