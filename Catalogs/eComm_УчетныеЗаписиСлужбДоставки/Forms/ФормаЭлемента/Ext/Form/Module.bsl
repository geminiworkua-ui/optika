&НаСервере
Процедура ПоказатьИнформациюОЛицензии()

	Попытка
		
		Элементы.СрокДействияЛицензии.Заголовок = "";
		
		СрокДействияЛицензии_eComm 	= Неопределено;
		ТекущаяДата					= Неопределено;
		Объект.ЛицензионныйКлюч = "TMP";
		Если ЗначениеЗаполнено(Объект.ЛицензионныйКлюч) 
			И Лев(Объект.ЛицензионныйКлюч, 3) = "TMP" Тогда 
			
			Настройки = eCommДоставкаСервер.Настройки(Объект.Ссылка);
			
			ПараметрыЛицензии = Обработки[Настройки.Менеджер].ИнформацияОЛицензии(Настройки);
			
			ТекущаяДата = ТекущаяДата();
			СрокДействияЛицензии_eComm = ПараметрыЛицензии.СрокГодности;
			
			Элементы.СрокДействияЛицензии.Заголовок = НСтр("ru = 'Действ. до: '; uk = 'Діє до: '") + Формат(СрокДействияЛицензии_eComm, "ДЛФ=Д");
			
		КонецЕсли;
		
	Исключение
		
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСправочникиНаСервере()
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Объект.Ссылка);
	Справочники.eComm_УчетныеЗаписиСлужбДоставки.ОбновитьСправочники(СтруктураНастроек);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСправочники(Команда)
	ОбновитьСправочникиНаСервере();
