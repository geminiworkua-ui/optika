
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьСписокДополнительныхУслуг();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ОК(Команда)
	
	СписокДополнительныхУслуг = Новый Массив;
	
	Для Каждого Стр Из ДополнительныеУслуги Цикл 
		Если Стр.Пометка = Истина Тогда 
			СписокДополнительныхУслуг.Добавить(Новый Структура("Услуга", Стр.Услуга));
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(СписокДополнительныхУслуг);

КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура ОбновитьСписокДополнительныхУслуг()

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Услуга", Новый ОписаниеТипов("СправочникСсылка.eComm_ОбщиеСправочники"));
	
	Если Параметры.Свойство("ДополнительныеУслуги") Тогда 
		Для Каждого СтруктураДопУслуги Из Параметры.ДополнительныеУслуги Цикл 
			ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), СтруктураДопУслуги);
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Услуга КАК Услуга
		|ПОМЕСТИТЬ ВрТабДопУслуги
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	eComm_ОбщиеСправочники.Ссылка КАК Услуга,
		|	ВЫБОР
		|		КОГДА ВрТабДопУслуги.Услуга ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Пометка
		|ИЗ
		|	Справочник.eComm_ОбщиеСправочники КАК eComm_ОбщиеСправочники
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабДопУслуги КАК ВрТабДопУслуги
		|		ПО (ВрТабДопУслуги.Услуга = eComm_ОбщиеСправочники.Ссылка)
		|ГДЕ
		|	eComm_ОбщиеСправочники.Родитель = ЗНАЧЕНИЕ(Справочник.eComm_ОбщиеСправочники.ДополнительныеУслугиУкрпочта)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Пометка УБЫВ";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ЗначениеВРеквизитФормы(ТЗ, "ДополнительныеУслуги");

КонецПроцедуры
