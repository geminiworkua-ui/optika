
&НаКлиенте
Процедура ИспользоватьКакОсновную(Команда)
	
	СтрокаТабличнойЧасти = Элементы.Список.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьКакОсновнуюНаСервере(СтрокаТабличнойЧасти.Ссылка, СтрокаТабличнойЧасти.СлужбаДоставки);
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ИспользоватьКакОсновнуюНаСервере(УчетнаяЗапись, СлужбаДоставки)
	
	НачатьТранзакцию();
	
	ЕстьОшибка = Ложь;
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	УчетныеЗаписиДоставки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.eComm_УчетныеЗаписиСлужбДоставки КАК УчетныеЗаписиДоставки
			|ГДЕ
			|	УчетныеЗаписиДоставки.ОсновнаяУчетнаяЗапись = ИСТИНА
			|	И УчетныеЗаписиДоставки.СлужбаДоставки = &СлужбаДоставки";
		
		Запрос.УстановитьПараметр("СлужбаДоставки", СлужбаДоставки);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Пока РезультатЗапроса.Следующий() Цикл
			
			УчетнаяЗаписьОбъект = РезультатЗапроса.Ссылка.ПолучитьОбъект();
			УчетнаяЗаписьОбъект.ОсновнаяУчетнаяЗапись = Ложь;
			УчетнаяЗаписьОбъект.Записать();
			
		КонецЦикла;
		
		УчетнаяЗаписьОбъект = УчетнаяЗапись.ПолучитьОбъект();
		УчетнаяЗаписьОбъект.ОсновнаяУчетнаяЗапись = Истина;
		УчетнаяЗаписьОбъект.Записать();
		
	Исключение
		
		ЕстьОшибка = Истина;
		Сообщить("Не удалось установить основную учетную запись!!! См. детальнее в журнале регистрации.");
		ЗаписьЖурналаРегистрации("eComm.NovaPoshta", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		
	КонецПопытки;
	
	Если НЕ ЕстьОшибка Тогда 
		ЗафиксироватьТранзакцию();
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры
