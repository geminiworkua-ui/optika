Функция ВернутьСписокЭкспрессНакладных(СтруктураНастроек, ЭкспрессНакладная = Неопределено) Экспорт

	ИмяДокументаЗаказКлиента = eCommДоставкаСервер.ВернутьИмяПрикладногоОбъекта("ЗаказКлиента");
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	eComm_ЭкспрессНакладная.Ссылка КАК ЭкспрессНакладная,
		|	eComm_ЭкспрессНакладная.НомерТТН КАК НомерТТН,
		|	ЕСТЬNULL(eComm_СтатусыЭкспрессНакладных.Статус.Идентификатор, """") КАК КодСтатуса,
		|	ЗаказКлиента.Ссылка КАК ДокументОснование
		|ИЗ
		|	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.eComm_СтатусыЭкспрессНакладных КАК eComm_СтатусыЭкспрессНакладных
		|		ПО (eComm_СтатусыЭкспрессНакладных.ЭкспрессНакладная = eComm_ЭкспрессНакладная.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.#ИмяДокументаЗаказКлиента# КАК ЗаказКлиента
		|		ПО (eComm_ЭкспрессНакладная.ДокументОснование = ЗаказКлиента.Ссылка)
		|ГДЕ
		|	eComm_ЭкспрессНакладная.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И eComm_ЭкспрессНакладная.УчетнаяЗапись = &УчетнаяЗапись
		|	И НЕ eComm_ЭкспрессНакладная.НомерТТН = """"
		|	И ВЫБОР
		|			КОГДА &ЭкспрессНакладная = НЕОПРЕДЕЛЕНО
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ &ЭкспрессНакладная = eComm_ЭкспрессНакладная.Ссылка
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Meest)
		|					И (ЕСТЬNULL(eComm_СтатусыЭкспрессНакладных.Статус.Идентификатор, """") = ""1622""
		|						ИЛИ ЕСТЬNULL(eComm_СтатусыЭкспрессНакладных.Статус.Идентификатор, """") = ""1825"")
		|				ТОГДА ЛОЖЬ                                                                                      //Отфильтруем конечные статусы. Их обновлять уже не надо
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяДокументаЗаказКлиента#", ИмяДокументаЗаказКлиента);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("НачалоПериода"		, ДобавитьМесяц(ТекущаяДата(), -1));
	Запрос.УстановитьПараметр("ОкончаниеПериода"	, КонецМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("УчетнаяЗапись"		, СтруктураНастроек.УчетнаяЗапись);
	Запрос.УстановитьПараметр("СлужбаДоставки"		, СтруктураНастроек.СлужбаДоставки);
	Запрос.УстановитьПараметр("ЭкспрессНакладная"	, ЭкспрессНакладная);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;

КонецФункции

