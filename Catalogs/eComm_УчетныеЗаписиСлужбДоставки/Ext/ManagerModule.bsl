		Обработки["eComm_УкрПочта"].ОбновитьСтатусы(СтруктураНастроек, ЭкспрессНакладная);
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда
		Обработки["eComm_Justin"].ОбновитьСтатусы(СтруктураНастроек, ЭкспрессНакладная);
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда
		Обработки["eComm_Meest"].ОбновитьСтатусы(СтруктураНастроек, ЭкспрессНакладная);
	КонецЕсли;

