
#Область НАСТРОЙКИ

Функция Настройки(УчетнаяЗапись, ДанныеЗаполения = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписи.Ссылка КАК Ссылка,
		|	УчетныеЗаписи.Ссылка КАК УчетнаяЗапись,
		|	УчетныеЗаписи.ПометкаУдаления КАК ПометкаУдаления,
		|	УчетныеЗаписи.Код КАК Код,
		|	УчетныеЗаписи.Наименование КАК Наименование,
		|	УчетныеЗаписи.КлючAPI КАК КлючAPI,
		|	ВЫБОР
		|		КОГДА УчетныеЗаписи.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.НоваяПочта)
		|			ТОГДА ""https://api.novaposhta.ua""
		|		КОГДА УчетныеЗаписи.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.УкрПочта)
		|			ТОГДА ""https://www.ukrposhta.ua""
		|		КОГДА УчетныеЗаписи.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Justin)
		|			ТОГДА ""https://api.justin.ua""
		|		КОГДА УчетныеЗаписи.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Meest)
		|			ТОГДА ""https://api.meest.com""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК АдресAPI,
		|	УчетныеЗаписи.Настройки КАК Настройки,
		|	УчетныеЗаписи.РежимОтладки КАК РежимОтладки,
		|	УчетныеЗаписи.ЛицензионныйКлюч КАК ЛицензионныйКлюч,
		|	УчетныеЗаписи.СлужбаДоставки КАК СлужбаДоставки,
		|	УчетныеЗаписи.ДополнительныеУслуги.(
		|		Услуга КАК Услуга
		|	) КАК ДополнительныеУслуги

		|ИЗ
		|	Справочник.eComm_УчетныеЗаписиСлужбДоставки КАК УчетныеЗаписи
		|ГДЕ
		|	УчетныеЗаписи.Ссылка = &УчетнаяЗапись";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	
	РезультатЗапроса = Запрос.Выполнить();

	СтруктураНастроек = Новый Структура;
	
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		
		Если Колонка.Имя = "Настройки" 
			ИЛИ Колонка.Имя = "ДополнительныеУслуги" Тогда
			// Обработаем позже
			Продолжить;
		КонецЕсли;
		
		СтруктураНастроек.Вставить(Колонка.Имя);
		
	КонецЦикла; 
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		ЗаполнитьЗначенияСвойств(СтруктураНастроек, Выборка, , "АдресAPI");
		ДополнитьНастройкиПараметрамиПодключения(СтруктураНастроек, Выборка.АдресAPI);
		
		ИмяОбработки = eCommДоставкаСервер.ВернутьИмяЗначенияПеречисления(СтруктураНастроек.СлужбаДоставки);
		
		СтруктураНастроек.Вставить("ТипПлатформы"				, ТипПлатформыСтрокой());
		СтруктураНастроек.Вставить("Менеджер"					, "eComm_" + ИмяОбработки);
		СтруктураНастроек.Вставить("ИмяКонфигурации"			, eCommДоставкаСервер.ИмяКонфигурации());
		СтруктураНастроек.Вставить("НомерЗаказаССайтаВРегистре"	, НЕ Метаданные.РегистрыСведений.Найти("ЗаказыПокупателейССайта") = Неопределено);
		
		ПрикладныеНастройки = Выборка.Настройки.Получить();
		СтруктураНастроек.Вставить("ДанныеЗаполнения"	, ПрикладныеНастройки.ДанныеЗаполнения);
		СтруктураНастроек.Вставить("Настройки"			, ПрикладныеНастройки.Настройки);
		
		Если ТипЗнч(ПрикладныеНастройки.ДанныеЗаполнения) = Тип("Структура")
			И ПрикладныеНастройки.ДанныеЗаполнения.Свойство("Отправитель") Тогда 		
			СтруктураНастроек.ДанныеЗаполнения.Вставить("Отправитель", ПрикладныеНастройки.ДанныеЗаполнения.Отправитель);
		КонецЕсли;
			
		Если ТипЗнч(ПрикладныеНастройки.ДанныеЗаполнения) = Тип("Структура")
			И ПрикладныеНастройки.ДанныеЗаполнения.Свойство("НаселенныйПунктОтправителя") Тогда 
		
			СтруктураНастроек.ДанныеЗаполнения.Вставить("НаселенныйПунктОтправителя", ПрикладныеНастройки.ДанныеЗаполнения.НаселенныйПунктОтправителя);
		КонецЕсли;
		
		Если ТипЗнч(ПрикладныеНастройки.ДанныеЗаполнения) = Тип("Структура")
			И ПрикладныеНастройки.ДанныеЗаполнения.Свойство("ОтделениеОтправителя") Тогда 
		
			СтруктураНастроек.ДанныеЗаполнения.Вставить("ОтделениеОтправителя", ПрикладныеНастройки.ДанныеЗаполнения.ОтделениеОтправителя);
		КонецЕсли;   
		
		Если ТипЗнч(ПрикладныеНастройки.ДанныеЗаполнения) = Тип("Структура")
			И ПрикладныеНастройки.ДанныеЗаполнения.Свойство("АдресОтправителя") Тогда 
		
			СтруктураНастроек.ДанныеЗаполнения.Вставить("АдресОтправителя", ПрикладныеНастройки.ДанныеЗаполнения.АдресОтправителя);
		КонецЕсли;


		
		Если ТипЗнч(ПрикладныеНастройки.ДанныеЗаполнения) = Тип("Структура") 
			И ПрикладныеНастройки.ДанныеЗаполнения.Свойство("КонтактноеЛицоОтправителя") Тогда 
			СтруктураНастроек.ДанныеЗаполнения.Вставить("КонтактноеЛицоОтправителя", ПрикладныеНастройки.ДанныеЗаполнения.КонтактноеЛицоОтправителя);
		КонецЕсли;
		
		Если Выборка.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
			ВыборкаДополнительныеУслуги = Выборка.ДополнительныеУслуги.Выбрать();
			
			МассивДопУслуг = Новый Массив;
			Пока ВыборкаДополнительныеУслуги.Следующий() Цикл
				Если ВыборкаДополнительныеУслуги.Услуга = Справочники.eComm_ОбщиеСправочники.transferPostPayToBankAccount Тогда 
					СтруктураНастроек.ДанныеЗаполнения.Вставить("ЗачислятьНаIBAN", Истина);
				Иначе
					МассивДопУслуг.Добавить(ВыборкаДополнительныеУслуги.Услуга);
				КонецЕсли;
			КонецЦикла;
			
			СтруктураНастроек.ДанныеЗаполнения.Вставить("ДополнительныеУслуги", МассивДопУслуг);
		КонецЕсли;
				
	КонецЕсли;  
	
	Возврат СтруктураНастроек;

КонецФункции

Процедура ДополнитьНастройкиПараметрамиПодключения(СтруктураНастроек, АдресAPI) Экспорт
	
	АдресСайта = СокрЛП(АдресAPI); 
	
	Сервер 					= ""; 
	Порт 					= 0;
	ЗащищенноеСоединение 	= Ложь;
	
	Если НЕ ПустаяСтрока(АдресСайта) Тогда
		
		АдресСайта = СтрЗаменить(АдресСайта, "\", "/");
		АдресСайта = СтрЗаменить(АдресСайта, " ", "");
		
		Если НРег(Лев(АдресСайта, 7)) = "http://" Тогда
			Сервер = Сред(АдресСайта, 8);
		ИначеЕсли НРег(Лев(АдресСайта, 8)) = "https://" Тогда
			Сервер = Сред(АдресСайта, 9);
			ЗащищенноеСоединение = Истина;
		Иначе
			Сервер = АдресСайта;
		КонецЕсли;
		
		ПозицияДвоеточия = Найти(Сервер, ":");
		ПортСтрока = "0";
		Если ПозицияДвоеточия > 0 Тогда
			СерверСПортом = Сервер;
			Сервер = Лев(СерверСПортом, ПозицияДвоеточия - 1);
			ПортСтрока = Прав(СерверСПортом, СтрДлина(СерверСПортом) - ПозицияДвоеточия);
		КонецЕсли;
		
		Попытка
			
			Порт = Число(ПортСтрока);
			
		Исключение
			
			Сообщить("Не удалось получить номер порта: " + ПортСтрока + Символы.ПС
					+ "Проверьте правильность ввода адреса сайта.");
				
		КонецПопытки;
		
		Если Порт = 0 Тогда
			Порт = ?(ЗащищенноеСоединение, 443, 80);
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураНастроек.Вставить("HTTP_Сервер"				, Сервер); 
	СтруктураНастроек.Вставить("HTTP_Порт"					, Порт);
	СтруктураНастроек.Вставить("HTTP_ЗащищенноеСоединение"	, ЗащищенноеСоединение);
	
КонецПроцедуры

Функция ТипПлатформыСтрокой() Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда 
		ТипПлатформыСтрокой = "Windows";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64 Тогда 
		ТипПлатформыСтрокой = "Linux";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.MacOS_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.MacOS_x86_64 Тогда 
		ТипПлатформыСтрокой = "MacOS";
	Иначе
		ТипПлатформыСтрокой = "";
	КонецЕсли;
	
	Возврат ТипПлатформыСтрокой;
	
КонецФункции

Процедура ЗапроситьЛицензионныйКлюч(СтруктураНастроек, СтруктураЛицензии) Экспорт

	Если СтруктураЛицензии.delivery = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		Обработки["eComm_НоваяПочта"].ЗапроситьЛицензионныйКлюч(СтруктураНастроек, СтруктураЛицензии);
	ИначеЕсли СтруктураЛицензии.delivery = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Обработки["eComm_УкрПочта"].ЗапроситьЛицензионныйКлюч(СтруктураНастроек, СтруктураЛицензии);
	ИначеЕсли СтруктураЛицензии.delivery = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
		Обработки["eComm_Justin"].ЗапроситьЛицензионныйКлюч(СтруктураНастроек, СтруктураЛицензии);
	ИначеЕсли СтруктураЛицензии.delivery = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		Обработки["eComm_Meest"].ЗапроситьЛицензионныйКлюч(СтруктураНастроек, СтруктураЛицензии);
	КонецЕсли;

КонецПроцедуры

Функция ТаблицаОпций(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.Свойство("Менеджер")
		И ЗначениеЗаполнено(СтруктураНастроек.Менеджер) Тогда
		Возврат Обработки[СтруктураНастроек.Менеджер].ТаблицаОпций(СтруктураНастроек);
	КонецЕсли;

КонецФункции

