
Процедура ПередЗаписью(Отказ)
	
	ЛицензионныйКлюч = СокрЛП(ЛицензионныйКлюч);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписиДоставки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписиСлужбДоставки КАК УчетныеЗаписиДоставки
		|ГДЕ
		|	УчетныеЗаписиДоставки.ОсновнаяУчетнаяЗапись = ИСТИНА
		|	И УчетныеЗаписиДоставки.СлужбаДоставки = &СлужбаДоставки";
	
	Запрос.УстановитьПараметр("Ссылка"			, Ссылка);
	Запрос.УстановитьПараметр("СлужбаДоставки"	, СлужбаДоставки);
	
	Если Запрос.Выполнить().Пустой() Тогда 
		// Нет учетной записи по умолчанию. Установим
		ОсновнаяУчетнаяЗапись = Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписиСлужбДоставки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписиСлужбДоставки КАК УчетныеЗаписиСлужбДоставки
		|ГДЕ
		|	НЕ УчетныеЗаписиСлужбДоставки.Ссылка = &Ссылка
		|	И УчетныеЗаписиСлужбДоставки.КлючAPI = &КлючAPI";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("КлючAPI", КлючAPI);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Отказ = Истина;
		Сообщить("По учетной записи """ + Наименование + """ ключ """ + КлючAPI + """ уже используется!!! Дублирование запрещено");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ОсновнаяУчетнаяЗапись					= Ложь;
	РегламентноеЗаданиеОбменаСправочниками 	= Неопределено;
	РегламентноеЗаданиеОбменаСтатусамиЭН	= Неопределено;
	
КонецПроцедуры
