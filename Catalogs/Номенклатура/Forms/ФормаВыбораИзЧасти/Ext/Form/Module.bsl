
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры = Неопределено
		И Параметры.Свойство("УходЛечение")
		Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы.Дерево;
		Список.Параметры.УстановитьЗначениеПараметра("УходЛечение", Истина);
		
		
	Иначе
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
		Список.Параметры.УстановитьЗначениеПараметра("УходЛечение", Ложь); 
	КонецЕсли;
	
КонецПроцедуры
