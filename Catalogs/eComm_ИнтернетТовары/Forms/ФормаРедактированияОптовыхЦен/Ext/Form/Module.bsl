
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УчетнаяЗапись", УчетнаяЗапись);
	
	ТаблицаОптовыеЦеныИнтернетТовара = ОптовыеЦены.Выгрузить();

	Если Параметры.Свойство("ОптовыеЦены") Тогда 
		Для Каждого СтруктураЦены Из Параметры.ОптовыеЦены Цикл 
			ЗаполнитьЗначенияСвойств(ТаблицаОптовыеЦеныИнтернетТовара.Добавить(), СтруктураЦены);
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗОптовыеЦены.ВидЦены КАК ВидЦены,
		|	ТЗОптовыеЦены.ОптоваяЦенаПриЗаказеОт КАК ОптоваяЦенаПриЗаказеОт
		|ПОМЕСТИТЬ ВрТабОптовыеЦеныИнтернетТоваров
		|ИЗ
		|	&ТЗОптовыеЦены КАК ТЗОптовыеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	eComm_УчетныеЗаписиОптовыеЦены.ВидЦены КАК ВидЦены,
		|	eComm_УчетныеЗаписиОптовыеЦены.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВрТабОптовыеЦеныУчетнойЗаписи
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи.ОптовыеЦены КАК eComm_УчетныеЗаписиОптовыеЦены
		|ГДЕ
		|	eComm_УчетныеЗаписиОптовыеЦены.Ссылка = &УчетнаяЗапись
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВрТабОптовыеЦеныУчетнойЗаписи.ВидЦены, ВрТабОптовыеЦеныИнтернетТоваров.ВидЦены) КАК ВидЦены,
		|	ЕСТЬNULL(ВрТабОптовыеЦеныИнтернетТоваров.ОптоваяЦенаПриЗаказеОт, 0) КАК ОптоваяЦенаПриЗаказеОт
		|ИЗ
		|	ВрТабОптовыеЦеныУчетнойЗаписи КАК ВрТабОптовыеЦеныУчетнойЗаписи
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВрТабОптовыеЦеныИнтернетТоваров КАК ВрТабОптовыеЦеныИнтернетТоваров
		|		ПО ВрТабОптовыеЦеныУчетнойЗаписи.ВидЦены = ВрТабОптовыеЦеныИнтернетТоваров.ВидЦены
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВрТабОптовыеЦеныУчетнойЗаписи.НомерСтроки";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ТЗОптовыеЦены", ТаблицаОптовыеЦеныИнтернетТовара);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(ТЗ, "ОптовыеЦены");
	
КонецПроцедуры


