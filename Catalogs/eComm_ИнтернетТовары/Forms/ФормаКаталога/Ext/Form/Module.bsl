
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УчетнаяЗапись", УчетнаяЗапись);
	СписокТоваров.ТекстЗапроса = ТекстЗапросаСписокТоваров();
	
	УчетнаяЗаписьПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_eComm_КатегорииТоваров" Тогда
		
		НоваяКатегория = Неопределено;
		Если ТипЗнч(Параметр) = Тип("Массив") И Параметр.Количество() <> 0 Тогда
			НоваяКатегория = Параметр[0];
		ИначеЕсли ЗначениеЗаполнено(Параметр) Тогда
			НоваяКатегория = Параметр;
		КонецЕсли;
		
		ЗаполнитьДеревоКатегорийНаСервере(НоваяКатегория);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Элементы.СписокКатегорийИерархияВключаяВложенные.Пометка = ИерархияВключаяВложенные;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура УчетнаяЗаписьПриИзменении(Элемент)
	
	УчетнаяЗаписьПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьИнтернетТоварыКатегории(Команда)
	
	МодульГрупповоеИзменение = Вычислить("ГрупповоеИзменениеОбъектовКлиент");
	
	Если НЕ МодульГрупповоеИзменение = Неопределено Тогда
		
		ТекДанные = Элементы.СписокКатегорий.ТекущиеДанные;
		Если НЕ ТекДанные = Неопределено Тогда 
			Категория = ТекДанные.Значение;
		Иначе
			Категория = Неопределено;
		КонецЕсли;
		
		ТоварыКатегории = ТоварыКатегории(Категория);
		
		ПараметрыФормы = Новый Структура("МассивОбъектов", ТоварыКатегории);
		
		Если ПараметрыФормы.МассивОбъектов.Количество() = 0 Тогда
			ПоказатьПредупреждение(, НСтр("ru='Команда не может быть выполнена для указанного объекта.';uk='Команда не може бути виконана для зазначеного об`єкта.'"));
			Возврат;
		КонецЕсли;
		
		ОткрытьФорму("Обработка.ГрупповоеИзменениеРеквизитов.Форма", ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКатегорийПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("УстановитьОтборНаКлиенте", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКатегорийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	ЗначенияЗаполнения = Новый Структура;
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ЗначенияЗаполнения.Вставить("Владелец", УчетнаяЗапись);
		ЗначенияЗаполнения.Вставить("Родитель", Элемент.ТекущиеДанные.Значение);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.eComm_КатегорииТоваров.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения));
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКатегорийПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	ТекСтрока = Элемент.ДанныеСтроки(Строка);
	
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда 
		
		Если ЗаписатьКатегорииТоваров(ПараметрыПеретаскивания.Значение, ТекСтрока.Значение) = Истина Тогда 
			
			ПоказатьОповещениеПользователя(Строка(ТекСтрока.Значение), ,"Перемещено " + ПараметрыПеретаскивания.Значение.Количество() + " позиций в категорию """ + ТекСтрока.Значение + """"); 
						
			Если ПараметрыПеретаскивания.Значение.Количество() > 0
				И ТипЗнч(ПараметрыПеретаскивания.Значение[0]) = Тип("СправочникСсылка.eComm_ИнтернетТовары") Тогда 
				Элементы.СписокТоваров.Обновить();
			Иначе
				МассивКатегорий = Новый Массив;
				МассивКатегорий.Добавить(ТекСтрока.Значение);
				Оповестить("Запись_eComm_КатегорииТоваров", МассивКатегорий);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКатегорию(Команда)
	
	Если Элементы.СписокКатегорий.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, Элементы.СписокКатегорий.ТекущиеДанные.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСправочникКатегорий(Команда)
	
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда 
		ПараметрыОткрытия = Новый Структура("Отбор", Новый Структура("Владелец", УчетнаяЗапись));
		ОткрытьФорму("Справочник.eComm_КатегорииТоваров.ФормаСписка", ПараметрыОткрытия, ЭтаФорма, УчетнаяЗапись);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Учетная запись не выбрана!!!'; uk = 'Обліковий запис не вибраний!!!'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВыделенные(Команда)
	
	МодульГрупповоеИзменение = Вычислить("ГрупповоеИзменениеОбъектовКлиент");
	Если НЕ МодульГрупповоеИзменение = Неопределено Тогда
		МодульГрупповоеИзменение.ИзменитьВыделенные(Элементы.СписокТоваров);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИерархияВключаяВложенные(Команда)
	
	ЭтаФорма.ИерархияВключаяВложенные = НЕ ЭтаФорма.ИерархияВключаяВложенные;
	Элементы.СписокКатегорийИерархияВключаяВложенные.Пометка = ЭтаФорма.ИерархияВключаяВложенные;
	
	ПодключитьОбработчикОжидания("УстановитьОтборНаКлиенте", 0.1, Истина);
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Функция ТекстЗапросаСписокТоваров()

	ИмяОбъектаСвойстваХарактеристики 				= eCommСервер.ВернутьИмяПрикладногоОбъекта("ЗначенияСвойствХарактеристики", Истина);
	ИмяРеквизита_ЗначенияСвойств_Характеристика		= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗначенияСвойствНоменклатуры", "Номенклатура");
	ИмяРеквизита_ДополнительныеРеквизиты_Заголовок 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ПВХДополнительныеРеквизиты", "Заголовок");
	ИмяРеквизита_АртикулХарактеристики		 		= eCommСервер.ВернутьИмяРеквизитаОбъекта("ХарактеристикиНоменклатуры", "Артикул");
	ИмяРеквизита_ЦеныНоменклатуры_ВидЦен		 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЦеныНоменклатуры", "ВидЦен");
	ИмяРеквизита_ЦеныНоменклатуры_Характеристика	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЦеныНоменклатуры", "Характеристика");
	
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда 
		СтруктураНастроек = eCommСервер.Настройки(УчетнаяЗапись);
		ИспользоватьАртикулХарактеристики = eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ИспользоватьАртикулХарактеристики");
	Иначе
		ИспользоватьАртикулХарактеристики = Ложь;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
		|	СпрИнтернетТовары.Ссылка КАК Ссылка,
		|	СпрИнтернетТовары.ПометкаУдаления КАК ПометкаУдаления,
		|	СпрИнтернетТовары.Владелец КАК Владелец,
		|	СпрИнтернетТовары.Код КАК Код,
		|	СпрИнтернетТовары.Наименование КАК Наименование,
		|	СпрИнтернетТовары.Номенклатура КАК Номенклатура,
		|	СпрИнтернетТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	СпрИнтернетТовары.Категория КАК Категория,
		|	СпрИнтернетТовары.ИнтернетСсылка КАК ИнтернетСсылка,
		|	СпрИнтернетТовары.Описание КАК Описание,
		|	СпрИнтернетТовары.ОписаниеВФорматеHTML КАК ОписаниеВФорматеHTML,
		|	СпрИнтернетТовары.АкционнаяСкидка КАК АкционнаяСкидка,
		|	СпрИнтернетТовары.Производитель КАК Производитель,
		|	СпрИнтернетТовары.URLКартинки КАК URLКартинки,
		|	СпрИнтернетТовары.Отключить КАК Отключить,
		|	СпрИнтернетТовары.КлючевыеСлова КАК КлючевыеСлова,
		|	СпрИнтернетТовары.ОптоваяЦенаПриЗаказеОт КАК ОптоваяЦенаПриЗаказеОт,
		|	#ИмяРеквизита_Артикул# КАК Артикул,
		//++
		|	ЦеныНоменклатуры.Цена КАК Цена
		//--
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК СпрИнтернетТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|		ПО СпрИнтернетТовары.Номенклатура = СпрНоменклатура.Ссылка
		|		#СоединениеТаблицаАртикуловХарактеристик#
		//++
		|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, #ИмяРеквизита_ВидЦен# = &ВидЦены) КАК ЦеныНоменклатуры
		|		ПО СпрИнтернетТовары.Номенклатура = ЦеныНоменклатуры.Номенклатура
		|			И СпрИнтернетТовары.ХарактеристикаНоменклатуры = ЦеныНоменклатуры.#ИмяРеквизита_Характеристика#}
		//--
		|";
	
	Если НЕ ИмяРеквизита_АртикулХарактеристики = "" Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Артикул#", "ВЫБОР
																			|		КОГДА НЕ СпрХарактеристикиНоменклатуры.Артикул =""""
																			|			ТОГДА СпрХарактеристикиНоменклатуры.Артикул
																			|		ИНАЧЕ СпрНоменклатура.Артикул
																			|	КОНЕЦ");
	ИначеЕсли НЕ ИспользоватьАртикулХарактеристики = Истина Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Артикул#", "СпрНоменклатура.Артикул");
	ИначеЕсли ИспользоватьАртикулХарактеристики = Истина Тогда  
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Артикул#", "ВЫБОР
																			|		КОГДА ХарактеристикиДополнительныеРеквизиты.Значение ЕСТЬ NULL
																			|			ТОГДА СпрНоменклатура.Артикул
																			|		ИНАЧЕ ХарактеристикиДополнительныеРеквизиты.Значение
																			|	КОНЕЦ");
	КонецЕсли;
	
	Если НЕ ИмяРеквизита_АртикулХарактеристики = "" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#СоединениеТаблицаАртикуловХарактеристик#", "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
																			|		ПО СпрИнтернетТовары.ХарактеристикаНоменклатуры = СпрХарактеристикиНоменклатуры.Ссылка");
	ИначеЕсли НЕ ИспользоватьАртикулХарактеристики = Истина Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#СоединениеТаблицаАртикуловХарактеристик#"	, "");
	ИначеЕсли ИспользоватьАртикулХарактеристики = Истина Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#СоединениеТаблицаАртикуловХарактеристик#"	, "ЛЕВОЕ СОЕДИНЕНИЕ #ИмяОбъектаСвойстваХарактеристики# КАК ХарактеристикиДополнительныеРеквизиты
																			|		ПО СпрИнтернетТовары.ХарактеристикаНоменклатуры = ХарактеристикиДополнительныеРеквизиты.#ИмяРеквизита_ЗначенияСвойств_Характеристика#
																			|			И (ХарактеристикиДополнительныеРеквизиты.Свойство.#ИмяРеквизита_ДополнительныеРеквизиты_Заголовок# = ""Артикул"")
																			|			И ХарактеристикиДополнительныеРеквизиты.#ИмяРеквизита_ЗначенияСвойств_Характеристика# ССЫЛКА Справочник.ХарактеристикиНоменклатуры");
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаСвойстваХарактеристики#"				, ИмяОбъектаСвойстваХарактеристики);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ЗначенияСвойств_Характеристика#"	, ИмяРеквизита_ЗначенияСвойств_Характеристика);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ДополнительныеРеквизиты_Заголовок#"	, ИмяРеквизита_ДополнительныеРеквизиты_Заголовок);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ВидЦен#"							, ИмяРеквизита_ЦеныНоменклатуры_ВидЦен);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Характеристика#"					, ИмяРеквизита_ЦеныНоменклатуры_Характеристика);
	
	Возврат ТекстЗапроса;

КонецФункции

&НаСервере
Процедура УчетнаяЗаписьПриИзмененииНаСервере()

	Дерево = ДеревоКатегорий();
	ЗначениеВРеквизитФормы(Дерево, "СписокКатегорий");
	
	СписокТоваров.Параметры.УстановитьЗначениеПараметра("ВидЦены", УчетнаяЗапись.ТипЦены);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоКатегорийНаСервере(КатегорияТекущейСтроки = Неопределено)

	Дерево = ДеревоКатегорий();
	ЗначениеВРеквизитФормы(Дерево, "СписокКатегорий");
	
	ИдентификаторСтроки = Неопределено;
	Если КатегорияТекущейСтроки <> Неопределено Тогда
		ИдентификаторСтроки = ИдентификаторСтрокиДереваПоЗначению(СписокКатегорий, КатегорияТекущейСтроки);
	КонецЕсли;
	
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.СписокКатегорий.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДеревоКатегорий() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_КатегорииТоваров.Ссылка КАК Значение,
		|	eComm_КатегорииТоваров.Наименование КАК Представление,
		|	eComm_КатегорииТоваров.Отключить КАК Отключить
		|ИЗ
		|	Справочник.eComm_КатегорииТоваров КАК eComm_КатегорииТоваров
		|ГДЕ
		|	eComm_КатегорииТоваров.Владелец = &УчетнаяЗапись
		|
		|УПОРЯДОЧИТЬ ПО
		|	eComm_КатегорииТоваров.Наименование ИЕРАРХИЯ";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		
	СтрокаНетКатегории = Дерево.Строки.Вставить(0);
	СтрокаНетКатегории.Значение = Справочники.eComm_ИнтернетТовары.ПустаяСсылка();
	СтрокаНетКатегории.Представление = НСтр("ru='-Все категории-';uk='-Всі категорії-'");
	
	Возврат Дерево;
	
КонецФункции

&НаСервере
Функция ЗаписатьКатегорииТоваров(РедактируемыеОбъекты, Категория)
	
	Если НЕ ТипЗнч(РедактируемыеОбъекты) = Тип("Массив") Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого РедактируемыйОбъект Из РедактируемыеОбъекты Цикл 
		
		Если ТипЗнч(РедактируемыйОбъект) = Тип("СправочникСсылка.eComm_ИнтернетТовары") Тогда
			// Переносим интернет-товары
			ТоварОбъект = РедактируемыйОбъект.ПолучитьОбъект();
			ТоварОбъект.Категория = Категория;
			ТоварОбъект.Записать();
		Иначе
			// Меняем иерархию категорий
			СтрокаРедактируемойКатегории = СписокКатегорий.НайтиПоИдентификатору(РедактируемыйОбъект);
			Если НЕ СтрокаРедактируемойКатегории = Неопределено 
				И ЗначениеЗаполнено(СтрокаРедактируемойКатегории.Значение) Тогда 
				КатегорияОбъект = СтрокаРедактируемойКатегории.Значение.ПолучитьОбъект();
				КатегорияОбъект.Родитель = Категория;
				КатегорияОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ИдентификаторСтрокиДереваПоЗначению(Коллекция, ИскомоеЗначение)
	
	КоллекцияЭлементов = Коллекция.ПолучитьЭлементы();
	
	Для каждого Элемент Из КоллекцияЭлементов Цикл
		
		Если Элемент.Значение = ИскомоеЗначение Тогда
			Возврат Элемент.ПолучитьИдентификатор();
		КонецЕсли;
		
		Идентификатор = ИдентификаторСтрокиДереваПоЗначению(Элемент, ИскомоеЗначение);
		
		Если Идентификатор <> Неопределено Тогда
			Возврат Идентификатор;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура УстановитьОтборНаКлиенте()

	ТекДанные = Элементы.СписокКатегорий.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда 
		Категория = ТекДанные.Значение;
	Иначе
		Категория = Неопределено;
	КонецЕсли;
	
	УстановитьОтборНаСервере(Категория);

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборНаСервере(Категория)
	
	СписокТоваров.Отбор.Элементы.Очистить();
	Если НЕ ЗначениеЗаполнено(Категория) Тогда
		// Все товары по учетной записи
		ЭлементОтбора = СписокТоваров.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Владелец");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование 	= Истина;
		ЭлементОтбора.ПравоеЗначение 	= УчетнаяЗапись;
	Иначе
		ЭлементОтбора = СписокТоваров.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Категория");
		Если ИерархияВключаяВложенные Тогда 
			ЭлементОтбора.ВидСравнения 	= ВидСравненияКомпоновкиДанных.ВИерархии;
		Иначе
			ЭлементОтбора.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		ЭлементОтбора.Использование 	= Истина;
		ЭлементОтбора.ПравоеЗначение 	= Категория;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТоварыКатегории(Категория)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ИнтернетТовары.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &Категория = ЗНАЧЕНИЕ(Справочник.eComm_КатегорииТоваров.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ eComm_ИнтернетТовары.Категория = &Категория
		|		КОНЕЦ
		|	И eComm_ИнтернетТовары.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец"	, УчетнаяЗапись);
	Запрос.УстановитьПараметр("Категория"	, Категория);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат РезультатЗапроса;
	
КонецФункции





