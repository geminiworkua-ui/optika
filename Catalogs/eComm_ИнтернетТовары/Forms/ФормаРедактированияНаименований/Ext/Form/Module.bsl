
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ИспользоватьМультиязычность", ИспользоватьМультиязычность);
	
	Если Параметры.Свойство("ДеревоНаименований") Тогда 
		
		КореньДерева = ДеревоНаименований.ПолучитьЭлементы();
		
		Для Каждого СтрХарактеристики Из Параметры.ДеревоНаименований Цикл
			
			СтрокаХарактеристики = КореньДерева.Добавить();
			СтрокаХарактеристики.ХарактеристикаНоменклатуры = СтрХарактеристики.ХарактеристикаНоменклатуры;
			
			Если ИспользоватьМультиязычность Тогда 
				
				// Для мультиязычности формируем дерево
				СтрокиНаименований = СтрокаХарактеристики.ПолучитьЭлементы();
				
				Для Каждого СтрокаНаименования Из СтрХарактеристики.НаименованияХарактеристики Цикл 
					ЗаполнитьЗначенияСвойств(СтрокиНаименований.Добавить(), СтрокаНаименования);
				КонецЦикла;
				
			Иначе
				
				// Для одного языка достаточно таблицы
				СтрокаХарактеристики.ХарактеристикаНоменклатуры = СтрХарактеристики.ХарактеристикаНоменклатуры;
				ЗаполнитьЗначенияСвойств(СтрокаХарактеристики, СтрХарактеристики.НаименованияХарактеристики[0], "КодЯзыка, ИнтернетТовар, ПоУмолчанию, Наименование");
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЗакрыть(Команда)
	
	Характеристики = Новый Массив;
	
	СтрокиХарактеристик = ДеревоНаименований.ПолучитьЭлементы();
	
	Для Каждого СтрХарактеристики Из СтрокиХарактеристик Цикл
		
		НаименованияХарактеристики = Новый Массив;
		
		Если ИспользоватьМультиязычность Тогда
			
			СтрокиЛокализаций = СтрХарактеристики.ПолучитьЭлементы();
			
			Для Каждого СтрЛокализации Из СтрокиЛокализаций Цикл 
				НаименованияХарактеристики.Добавить(Новый Структура("КодЯзыка, Наименование, ИнтернетТовар, ПоУмолчанию", СтрЛокализации.КодЯзыка, СтрЛокализации.Наименование, СтрЛокализации.ИнтернетТовар, СтрЛокализации.ПоУмолчанию));
			КонецЦикла;
			
		Иначе
			
			НаименованияХарактеристики.Добавить(Новый Структура("КодЯзыка, Наименование, ИнтернетТовар, ПоУмолчанию", СтрХарактеристики.КодЯзыка, СтрХарактеристики.Наименование, СтрХарактеристики.ИнтернетТовар, СтрХарактеристики.ПоУмолчанию));
			
		КонецЕсли;
		
		Характеристики.Добавить(Новый Структура("ХарактеристикаНоменклатуры, НаименованияХарактеристики", СтрХарактеристики.ХарактеристикаНоменклатуры, НаименованияХарактеристики));
	
	КонецЦикла;
	
	Закрыть(Характеристики);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьХарактеристику(Команда)
	
	ТекДанные = Элементы.ДеревоНаименований.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.ХарактеристикаНоменклатуры) Тогда 
		ХарактеристикаНоменклатуры = ТекДанные.ХарактеристикаНоменклатуры;
	Иначе
		СтрокаВерхнегоУровня = ТекДанные.ПолучитьРодителя();
		ХарактеристикаНоменклатуры = СтрокаВерхнегоУровня.ХарактеристикаНоменклатуры;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ХарактеристикиНоменклатуры.ФормаОбъекта", Новый Структура("Ключ", ХарактеристикаНоменклатуры), ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
