/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ТипМетки", ТипМетки);
	ОбновитьСписокМеток();
		
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ОК(Команда)
	
	СписокМеток = Новый Массив;
	
	Для Каждого Стр Из Метки Цикл 
		Если Стр.Пометка = Истина Тогда 
			СписокМеток.Добавить(Новый Структура("Метка, ТипМетки", Стр.Метка, Стр.ТипМетки));
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(СписокМеток);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКлассификаторМеток(Команда)
	
	ОбновитьКлассификаторМетокНаСервере();
	ОбновитьСписокМеток();
	Закрыть();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура ОбновитьСписокМеток()

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Метка"		, Новый ОписаниеТипов("СправочникСсылка.eComm_МеткиИнтернетТоваров"));
	ТЗ.Колонки.Добавить("ТипМетки"	, Новый ОписаниеТипов("ПеречислениеСсылка.eComm_ТипыМеток"));
	
	Если Параметры.Свойство("Метки") Тогда 
		Для Каждого СтруктураМетки Из Параметры.Метки Цикл 
			ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), СтруктураМетки);
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Метки.Метка КАК Метка,
		|	Метки.ТипМетки КАК ТипМетки
		|ПОМЕСТИТЬ ВрТабМетки
		|ИЗ
		|	&ТЗ КАК Метки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА НЕ ВрТабМетки.Метка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Пометка,
		|	eComm_МеткиИнтернетТоваров.Ссылка КАК Метка,
		|	eComm_МеткиИнтернетТоваров.ТипМетки КАК ТипМетки
		|ИЗ
		|	Справочник.eComm_МеткиИнтернетТоваров КАК eComm_МеткиИнтернетТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабМетки КАК ВрТабМетки
		|		ПО eComm_МеткиИнтернетТоваров.Ссылка = ВрТабМетки.Метка
		|ГДЕ
		|	eComm_МеткиИнтернетТоваров.ТипМетки = &ТипМетки";
	
	Запрос.УстановитьПараметр("ТЗ"		, ТЗ);
	Запрос.УстановитьПараметр("ТипМетки", ТипМетки);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ЗначениеВРеквизитФормы(ТЗ, "Метки");

КонецПроцедуры

&НаСервере
Процедура ОбновитьКлассификаторМетокНаСервере()

	Макет = Справочники.eComm_МеткиИнтернетТоваров.ПолучитьМакет("ШаблоныМеток");
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		Наименование 			= ВернутьЗначениеЯчейки(Макет.Область(НомерСтроки, 1));
		ТорговаяПлощадкаСтрокой = ВернутьЗначениеЯчейки(Макет.Область(НомерСтроки, 2));
		ТипМеткиСтрокой			= ВернутьЗначениеЯчейки(Макет.Область(НомерСтроки, 3));
		
		Если ЗначениеЗаполнено(Наименование) Тогда 
			
			Метка = Справочники.eComm_МеткиИнтернетТоваров.НайтиПоНаименованию(Наименование, Истина);
			Если Метка = Справочники.eComm_МеткиИнтернетТоваров.ПустаяСсылка() Тогда 
				МеткаОбъект = Справочники.eComm_МеткиИнтернетТоваров.СоздатьЭлемент();
			Иначе
				МеткаОбъект = Метка.ПолучитьОбъект();
			КонецЕсли;  
			
			МеткаОбъект.Наименование = Наименование;
			МеткаОбъект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки[ТорговаяПлощадкаСтрокой];
			МеткаОбъект.ТипМетки = Перечисления["eComm_ТипыМеток"][ТипМеткиСтрокой];
			МеткаОбъект.Записать();
			
		КонецЕсли;
								
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВернутьЗначениеЯчейки(Ячейка)

	Если Ячейка.СодержитЗначение Тогда
		Значение = Ячейка.Значение;
	Иначе
		Значение = Ячейка.Текст;
	КонецЕсли;
	
	Возврат Значение;

КонецФункции

