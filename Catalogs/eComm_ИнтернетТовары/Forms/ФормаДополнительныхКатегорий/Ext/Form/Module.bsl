
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УчетнаяЗапись", УчетнаяЗапись);
	
	Если Параметры.Свойство("ДополнительныеКатегории") Тогда 
		Для Каждого СтруктураКатегории Из Параметры.ДополнительныеКатегории Цикл 
			ЗаполнитьЗначенияСвойств(ДополнительныеКатегории.Добавить(), СтруктураКатегории);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ОК(Команда)
	
	СписокКатегорий = Новый Массив;
	Для Каждого Стр Из ДополнительныеКатегории Цикл 
		СписокКатегорий.Добавить(Новый Структура("Категория", Стр.Категория));
	КонецЦикла;
	
	Закрыть(СписокКатегорий);
	
КонецПроцедуры


