&НаКлиенте
Процедура СписокСвойствВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.СписокСвойств.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыполнитьПослеРедактированияСвойства", ЭтаФорма);
	Если ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда 
		ПараметрыОткрытия = Новый Структура("Ключ", ТекДанные.Ссылка);
		ОткрытьФорму("Справочник.eComm_СвойстваТоваров.ФормаОбъекта", ПараметрыОткрытия,,,,,ОповещениеОЗакрытии);
	Иначе
		ПараметрыЗаполнения = Новый Структура("Владелец, Свойство, Наименование", Объект.Владелец, ТекДанные.Свойство, ТекДанные.НаименованиеСвойства);
		ОткрытьФорму("Справочник.eComm_СвойстваТоваров.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения),,,,,ОповещениеОЗакрытии);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеКатегорииСтрокойНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьСписокДополнительныхКатегорий", ЭтаФорма);
	
	ДополнительныеКатегории = Новый Массив;
	Для Каждого Стр Из Объект.ДополнительныеКатегории Цикл 
		ДополнительныеКатегории.Добавить(Новый Структура("Категория", Стр.Категория));
	КонецЦикла;
	
	ПараметрыОткрытия = Новый Структура("УчетнаяЗапись, ДополнительныеКатегории", Объект.Владелец, ДополнительныеКатегории);
	ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаДополнительныхКатегорий", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

