&НаСервере
Процедура ИнициализироватьУчетнуюЗапись()

	НастройкиУчетнойЗаписи = eCommСервер.Настройки(Объект.Владелец);
	
	ИспользоватьМультиязычность 				= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "ИспользоватьМультиязычность");
	НеПодставлятьХарактеристикуВНаименование 	= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "НеПодставлятьХарактеристикуВНаименование");
	ИмяРеквизитаНаименованиеИнтернетТовара 		= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "ИмяРеквизитаНаименованиеИнтернетТовара");
	ИмяРеквизитаОписаниеИнтернетТовара			= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "ИмяРеквизитаОписаниеИнтернетТовара");
	ИмяРеквизитаКатегорияИнтернетТовара			= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "ИмяРеквизитаКатегорияИнтернетТовара");
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		ЯрлыкиПоУмолчанию		= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "Ярлыки");
		МаркетплейсыПоУмолчанию	= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "Маркетплейсы");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяРеквизитаНаименованиеИнтернетТовара) Тогда 
		ИмяРеквизитаНаименованиеИнтернетТовара = "Наименование";
	КонецЕсли;
	
	ТипЦены 				= НастройкиУчетнойЗаписи.ТипЦены;
	ОкруглятьЦенуДоЦелого 	= НастройкиУчетнойЗаписи.ОкруглятьЦенуДоЦелого;
	
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда 
			МодульМультиязычность.ПриСозданииНаСервере(ЭтаФорма, Объект);
		КонецЕсли;
		
		Если НЕ НРег(eCommСервер.ВернутьКодТекущегоЯзыка()) = НРег(eCommСервер.ВернутьОсновнойЯзык()) Тогда 
			ТолькоПросмотр = Истина;
			Сообщить(НСтр("ru = 'Язык интерфейса не соответствует основному языку конфигурации. 
						|Измените язык интерфейса пользователя для продолжения редактирования'; 
						|uk = 'Мова інтерфейсу не відповідає основній мові конфігурації. 
						|Змініть мову интерфейсу користувача для продовження редагування'"));
		КонецЕсли;
		
	КонецЕсли;

	РедактироватьНоменклатуруХарактеристику = eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "РедактироватьНоменклатуруХарактеристику");
	Если РедактироватьНоменклатуруХарактеристику = Истина Тогда 
		Элементы.Номенклатура.ТолькоПросмотр				= Ложь;
		Элементы.ХарактеристикаНоменклатуры.ТолькоПросмотр 	= Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();
	УстановитьПараметрыВыбораКатегорияНаПортале();

КонецПроцедуры

&НаСервере
Функция КатегорияПоУмолчанию()

	Если НЕ ЗначениеЗаполнено(Объект.Номенклатура)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.Владелец) Тогда 
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить("ВЫБРАТЬ
		|	eComm_КатегорииТоваров.Ссылка КАК Категория
		|ИЗ
		|	Справочник.eComm_КатегорииТоваров КАК eComm_КатегорииТоваров
		|ГДЕ
		|	eComm_КатегорииТоваров.Владелец = &УчетнаяЗапись
		|	И eComm_КатегорииТоваров.ОснованиеКатегории В
		|			(ВЫБРАТЬ
		|				Номенклатура.#ИмяРеквизитаКатегорияИнтернетТовара# КАК КатегорияНоменклатуры
		|			ИЗ
		|				Справочник.Номенклатура КАК Номенклатура
		|			ГДЕ
		|				Номенклатура.Ссылка = &Номенклатура)", "#ИмяРеквизитаКатегорияИнтернетТовара#", ИмяРеквизитаКатегорияИнтернетТовара);
	
	Запрос.УстановитьПараметр("УчетнаяЗапись"	, Объект.Владелец);
	Запрос.УстановитьПараметр("Номенклатура"	, Объект.Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Количество() = 1 Тогда 
		РезультатЗапроса.Следующий();
		Возврат РезультатЗапроса.Категория;
	КонецЕсли;

КонецФункции
	
&НаКлиенте
Процедура ПослеВводаСтрокНаРазныхЯзыках(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Представление Из Результат.ЗначенияНаРазныхЯзыках Цикл
		Отбор = Новый Структура("КодЯзыка", Представление.КодЯзыка);
		НайденныеСтроки = Объект.Представления.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если ПустаяСтрока(Представление.ЗначениеРеквизита) 
				И НЕ ВРЕГ(Результат.ОсновнойЯзык) = ВРЕГ(Представление.КодЯзыка) Тогда
				Объект.Представления.Удалить(НайденныеСтроки[0]);
				Продолжить;
			КонецЕсли;
			СтрокаПредставлений = НайденныеСтроки[0];
		Иначе
			СтрокаПредставлений = Объект.Представления.Добавить();
			СтрокаПредставлений.КодЯзыка = Представление.КодЯзыка;
		КонецЕсли;
		СтрокаПредставлений[ДополнительныеПараметры.ИмяРеквизита] = Представление.ЗначениеРеквизита;
		
	КонецЦикла;
	
	Если Результат.Свойство("СтрокаНаТекущемЯзыке") Тогда
		Объект[ДополнительныеПараметры.ИмяРеквизита] = Результат.СтрокаНаТекущемЯзыке;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ИмяРеквизита = "Описание"
		И Объект.ОписаниеВФорматеHTML Тогда 
		ОписаниеВФорматеHTMLПриИзмененииНаСервере();		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОписаниеВФорматеHTMLПриИзмененииНаСервере()

	Если Найти(Объект.Описание, "</html>") = 0 Тогда
		_ОписаниеHTML = "<html>" + Объект.Описание + "</html>";	
	Иначе	
		_ОписаниеHTML = Объект.Описание;	
	КонецЕсли;
	
	ОписаниеHTML.УстановитьHTML(_ОписаниеHTML, Новый Структура);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеРедактированияСвойства(Результат, ДопПараметры) Экспорт

	Элементы.СписокСвойств.Обновить();	

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСписокДополнительныхКатегорий(СписокКатегорий, ДопПараметры) Экспорт

	Если СписокКатегорий = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Объект.ДополнительныеКатегории.Очистить();
	
	ОписаниеКатегорий = "";
	
	Для Каждого СтруктураКатегории Из СписокКатегорий Цикл 
		ЗаполнитьЗначенияСвойств(Объект.ДополнительныеКатегории.Добавить(), СтруктураКатегории);
	КонецЦикла;
	
	ЗаполнитьПредставлениеДополнительныхКатегорий();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСписокОптовыхЦен(ОптовыеЦены, ДопПараметры) Экспорт

	Если ОптовыеЦены = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Объект.ОптовыеЦены.Очистить();
	
	Для Каждого СтруктураЦены Из ОптовыеЦены Цикл 
		ЗаполнитьЗначенияСвойств(Объект.ОптовыеЦены.Добавить(), СтруктураЦены);
	КонецЦикла;

	ЗаполнитьПредставлениеОптовыхЦен();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСписокМеток(СписокМеток, ТипМетки) Экспорт

	Если СписокМеток = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	КоличествоСтрок = Объект.Метки.Количество()-1;
    ИндексСтроки = КоличествоСтрок;
	
	Для Сч = 0 По КоличествоСтрок Цикл
        Стр = Объект.Метки.Получить(ИндексСтроки);
        Если Стр.ТипМетки = ТипМетки Тогда
                Объект.Метки.Удалить(Стр);
        КонецЕсли;
        ИндексСтроки = ИндексСтроки - 1;
    КонецЦикла;
	
	Для Каждого СтруктураМетки Из СписокМеток Цикл 
		ЗаполнитьЗначенияСвойств(Объект.Метки.Добавить(), СтруктураМетки);
	КонецЦикла;
	
	ЗаполнитьПредставлениеМеток(ТипМетки);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеДополнительныхКатегорий()

	ОписаниеКатегорий = "";
	Для Каждого Стр Из Объект.ДополнительныеКатегории Цикл 
		ОписаниеКатегорий = ОписаниеКатегорий + ?(ОписаниеКатегорий = "", "", "; ") + Стр.Категория;
	КонецЦикла;
	
	Если ОписаниеКатегорий = "" Тогда 
		ОписаниеКатегорий = НСтр("ru = '<не выбрано>'; uk = '<не вибрано>'");
	КонецЕсли;
	
	ДополнительныеКатегорииСтрокой = ОписаниеКатегорий;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеОптовыхЦен()

	ОписаниеОптовыхЦен = "";
	Для Каждого Стр Из Объект.ОптовыеЦены Цикл 
		ОписаниеОптовыхЦен = ОписаниеОптовыхЦен + ?(ОписаниеОптовыхЦен = "", "", "; ") + Стр.ВидЦены + " " + "(от " + Стр.ОптоваяЦенаПриЗаказеОт + ")";
	КонецЦикла;
	
	Если ОписаниеОптовыхЦен = "" Тогда 
		ОписаниеОптовыхЦен = "<не выбрано>";
	КонецЕсли;
	
	ОптовыеЦеныСтрокой = ОписаниеОптовыхЦен;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеМеток(ТипМетки)

	ОписаниеМетки = "";
	Для Каждого Стр Из Объект.Метки Цикл
		Если Стр.ТипМетки = ТипМетки Тогда 
			ОписаниеМетки = ОписаниеМетки + ?(ОписаниеМетки = "", "", "; ") + Стр.Метка;
		КонецЕсли;
	КонецЦикла;
	
	Если ОписаниеМетки = "" Тогда 
		ОписаниеМетки = "<не выбрано>";
	КонецЕсли;
	
	ЭтаФорма["" + ТипМетки + "Строкой"] = ОписаниеМетки;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеЦены()

	Если ЗначениеЗаполнено(ТипЦены) Тогда 
		
		ИмяРеквизита_ЦеныНоменклатуры_Характеристика= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЦеныНоменклатуры", "Характеристика");
		ИмяРеквизита_ВидЦен							= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЦеныНоменклатуры", "ВидЦен");
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			|			,
			|			Номенклатура = &Номенклатура
			|				И #ИмяРеквизита_ЦеныНоменклатуры_Характеристика# = &Характеристика
			|				И #ИмяРеквизита_ВидЦен# = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ЦеныНоменклатуры_Характеристика#"	, ИмяРеквизита_ЦеныНоменклатуры_Характеристика);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ВидЦен#"							, ИмяРеквизита_ВидЦен);
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Номенклатура"	, Объект.Номенклатура);
		Запрос.УстановитьПараметр("Характеристика"	, Объект.ХарактеристикаНоменклатуры);
		Запрос.УстановитьПараметр("ТипЦены"			, ТипЦены);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Следующий() Тогда 
			ЦенаПродажи = РезультатЗапроса.Цена;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписаниеСтаройЦены()

	Если ЗначениеЗаполнено(ЦенаПродажи) 
		И ЗначениеЗаполнено(Объект.АкционнаяСкидка) Тогда
		
		СтруктураНастроек = Новый Структура("ОкруглятьЦенуДоЦелого", ОкруглятьЦенуДоЦелого);
		СтараяЦена = eCommСервер.ОкруглитьЦену(СтруктураНастроек, ЦенаПродажи * (1 + Объект.АкционнаяСкидка / 100));
		
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Старая цена равняется:';uk='Стара ціна становить:'"), , Новый Цвет(24,85,173)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + СтараяЦена, Новый Шрифт(,,Истина), Новый Цвет(0,150,70)));
		
		ОписаниеСтаройЦены = Новый ФорматированнаяСтрока(МассивСтрок);
		
	Иначе
		
		ОписаниеСтаройЦены = Новый ФорматированнаяСтрока("");
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписаниеПромоЦены()

	// Только для Rozetka.ua
	
	Если ЗначениеЗаполнено(ЦенаПродажи) 
		И ЗначениеЗаполнено(Объект.ПромоСкидка) Тогда
		
		СтруктураНастроек = Новый Структура("ОкруглятьЦенуДоЦелого", ОкруглятьЦенуДоЦелого);
		ЦенаПромо = eCommСервер.ОкруглитьЦену(СтруктураНастроек, ЦенаПродажи * (1 - Объект.ПромоСкидка / 100));
		
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Промо-цена равняется:';uk='Промо-ціна становить:'"), , Новый Цвет(24,85,173)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + ЦенаПромо, Новый Шрифт(,,Истина), Новый Цвет(0,150,70)));
		
		ОписаниеПромоЦены = Новый ФорматированнаяСтрока(МассивСтрок);
		
	Иначе
		
		ОписаниеПромоЦены = Новый ФорматированнаяСтрока("");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()

	// Применим настройки согласно шаблона для торговой площадки
	//
	
	МакетНастроек = Справочники.eComm_ИнтернетТовары.ПолучитьМакет("НастройкиДоступностиРеквизитов");
	
	КоличествоЗаписей = МакетНастроек.ВысотаТаблицы;
	
	ИмяЗначенияПеречисления = eCommСервер.ВернутьИмяЗначенияПеречисления(Объект.Владелец.ТорговаяПлощадка);
	НомерКолонки			= 0;
	
	Для Сч = 0 По МакетНастроек.ШиринаТаблицы - 1 Цикл
		Если СокрЛП(МакетНастроек.Область(1, Сч).Текст) = ИмяЗначенияПеречисления Тогда 
			НомерКолонки = Сч;
		КонецЕсли;
	КонецЦикла;
		
	Для Сч = 2 по КоличествоЗаписей Цикл
		
		ИмяЭлемента 	= СокрЛП(МакетНастроек.Область(Сч, 1).Текст);
		
		Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда 
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Владелец) Тогда 
			Продолжить;
		КонецЕсли;
		
		Видимость 				= СокрЛП(МакетНастроек.Область(Сч, НомерКолонки).Текст) = "+";
		
		Если НЕ Элементы[ИмяЭлемента].Видимость = Видимость Тогда 
			Элементы[ИмяЭлемента].Видимость = Видимость;
		КонецЕсли;
		
	КонецЦикла;
	
	// Применим настройки учетной записи
	//
	Элементы["Производитель"].Видимость = eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Производитель") = "";

	Если Объект.Владелец.ВыгружатьКартинкиИзБазы = Истина Тогда 
		Элементы.ГруппаКартинки.Видимость = Ложь;
	КонецЕсли;
	
	Если РучноеРедактированиеИзображений Тогда 
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаРучногоРедактирования;
	Иначе
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаКонструктораСсылок;
	КонецЕсли;
	
	Если Объект.ОписаниеВФорматеHTML = Истина Тогда 
		Элементы.СтраницыОписание.ТекущаяСтраница = Элементы.ГруппаОписаниеРедактирование;
	Иначе
		Элементы.СтраницыОписание.ТекущаяСтраница = Элементы.ГруппаОписаниеТекст;
	КонецЕсли;
	
	Если НЕ ИспользоватьМультиязычность Тогда 
		Элементы.РедактироватьОписание.Видимость = Ложь;
	КонецЕсли;
	
	ИспользоватьХарактеристики = eCommСервер.НоменклатураИспользуетХарактеристики(Объект.Номенклатура);
	Если НЕ ИспользоватьХарактеристики Тогда 
		Элементы.ХарактеристикаНоменклатуры.Видимость = Ложь;
	КонецЕсли;
	
	eCommСерверПереопределяемый.РеквизитыТовара_УстановитьВидимостьЭлементов(ЭтаФорма);

КонецПроцедуры

