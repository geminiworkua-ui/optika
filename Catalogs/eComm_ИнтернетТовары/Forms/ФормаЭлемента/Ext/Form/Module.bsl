&НаСервере
Процедура ПеревестиНаСервере()

	Настройки = eCommСервер.Настройки(Объект.Владелец);
	
	Если Не ЗначениеЗаполнено(Объект.Владелец) Тогда
		Возврат;
	КонецЕсли;
	
	ОсновнойЯзык 		= eCommСервер.ВернутьОсновнойЯзык();
	ЯзыкиКонфигурации 	= eCommСервер.ВернутьЯзыкиКонфигурации();
	
	Для Каждого Язык Из ЯзыкиКонфигурации Цикл 
		
		Если Язык = ОсновнойЯзык Тогда
			Продолжить;
		КонецЕсли;
		
		ЯзыкС	= ОсновнойЯзык;
		ЯзыкНа	= Язык;
		
		Представления_Строки = Объект.Представления.НайтиСтроки(Новый Структура("КодЯзыка", ЯзыкНа));
		Если ЗначениеЗаполнено(Представления_Строки) Тогда
			Представления_Строка = Представления_Строки[0];
		Иначе
			Представления_Строка = Объект.Представления.Добавить();
			Представления_Строка.КодЯзыка = ЯзыкНа;
		КонецЕсли;
		
		Для Каждого Реквизит Из Объект.Ссылка.Метаданные().ТабличныеЧасти.Представления.Реквизиты Цикл
			
			Если Реквизит.Имя = "КодЯзыка" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Объект[Реквизит.Имя]) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоHTML = (Реквизит.Имя = "Описание") И Объект.ОписаниеВФорматеHTML;
			
			Если eCommСервер.ПроизводитьПереводРеквизита(Настройки, Реквизит.Имя) = Истина Тогда
				Представления_Строка[Реквизит.Имя] = Обработки[Настройки.Менеджер].Перевести(Настройки, ЯзыкС, ЯзыкНа, Объект[Реквизит.Имя], ЭтоHTML);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПереводПроизведен = Истина;

КонецПроцедуры

