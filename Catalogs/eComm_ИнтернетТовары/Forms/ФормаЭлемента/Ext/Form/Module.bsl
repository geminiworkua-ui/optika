

/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ  ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьУчетнуюЗапись();

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		
		Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда 
			Если НеПодставлятьХарактеристикуВНаименование = Истина Тогда 
				Объект.Наименование = Объект.Номенклатура[ИмяРеквизитаНаименованиеИнтернетТовара];
			Иначе
				Объект.Наименование = Объект.Номенклатура[ИмяРеквизитаНаименованиеИнтернетТовара] + ?(ЗначениеЗаполнено(Объект.ХарактеристикаНоменклатуры), ", " + Объект.ХарактеристикаНоменклатуры, "");
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяРеквизитаОписаниеИнтернетТовара) Тогда 
			Объект.Описание = Объект.Номенклатура[ИмяРеквизитаОписаниеИнтернетТовара];
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяРеквизитаКатегорияИнтернетТовара) Тогда
			Объект.Категория = КатегорияПоУмолчанию();
		КонецЕсли;
		
		// Только для Horoshop.ua
		Для Каждого ЭлементСписка Из ЯрлыкиПоУмолчанию Цикл 
			СтрокаМетки = Объект.Метки.Добавить();
			СтрокаМетки.Метка = ЭлементСписка.Значение;
		КонецЦикла;
		
		Для Каждого ЭлементСписка Из МаркетплейсыПоУмолчанию Цикл 
			СтрокаМетки = Объект.Метки.Добавить();
			СтрокаМетки.Метка = ЭлементСписка.Значение;
		КонецЦикла;
		
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Объект.URLКартинки) Тогда 
		МассивСсылок = eCommСервер.РазложитьСтрокуВМассивПодстрок(Объект.URLКартинки, Символы.ПС, Истина, Истина);
		Для Каждого ЭлементМассива Из МассивСсылок Цикл 
			НовСтр = СписокИзображений.Добавить();
			НовСтр.URLКартинки = ЭлементМассива;
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьПредставлениеЦены();
	ЗаполнитьОписаниеСтаройЦены();
	ЗаполнитьОписаниеПромоЦены();
	ЗаполнитьПредставлениеДополнительныхКатегорий();
	ЗаполнитьПредставлениеОптовыхЦен();
	
	Если Элементы.Метки.Видимость = Истина 
		И ЗначениеЗаполнено(Объект.Владелец) Тогда    
		
		Для Каждого Стр Из Объект.Метки Цикл 
			Стр.ТипМетки = Стр.Метка.ТипМетки;
		КонецЦикла;
		
		ЗаполнитьПредставлениеМеток(Перечисления["eComm_ТипыМеток"].Ярлык);
		ЗаполнитьПредставлениеМеток(Перечисления["eComm_ТипыМеток"].Маркетплейс);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда 
			МодульМультиязычность.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.ОписаниеВФорматеHTML Тогда 
		Если Найти(Объект.Описание, "</html>") = 0 Тогда
			_ОписаниеHTML = "<html>" + Объект.Описание + "</html>";	
		Иначе	
			_ОписаниеHTML = Объект.Описание;	
		КонецЕсли;
		ОписаниеHTML.УстановитьHTML(_ОписаниеHTML, Новый Структура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ОписаниеВФорматеHTML Тогда 
		Если НЕ ОписаниеHTML.ПолучитьТекст() = "" Тогда 
			ОписаниеHTML.ПолучитьHTML(Объект.Описание, Новый Структура);
		Иначе
			Объект.Описание = "";
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ РучноеРедактированиеИзображений Тогда 
		Объект.URLКартинки = "";
		Для Каждого Стр Из СписокИзображений Цикл 
			Объект.URLКартинки = Объект.URLКартинки + ?(Объект.URLКартинки = "", Стр.URLКартинки, Символы.ПС + Стр.URLКартинки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда 
			МодульМультиязычность.ПередЗаписьюНаСервере(ТекущийОбъект);
		КонецЕсли;
		
		Если ПереводПроизведен = Истина Тогда 
			ТекущийОбъект.ДополнительныеСвойства.Вставить("ПереводПроизведен");
			ПереводПроизведен = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда
			МодульМультиязычность.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Оповестить("ЗаписьИнтернетТовара");
КонецПроцедуры


