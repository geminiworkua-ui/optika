&НаКлиенте
Процедура Подключаемый_Открытие(Элемент, СтандартнаяОбработка)   
	
	МодульМультиязычность = Вычислить("МультиязычностьКлиент");
	
	Если Элемент.Имя = "Описание"
		И Объект.ОписаниеВФорматеHTML = Истина Тогда 

		СтандартнаяОбработка = Ложь;
		ПутьКДанным = ЭтаФорма.ПараметрыМультиязычныхРеквизитов[Элемент.Имя];
		ИмяРеквизита = СтрЗаменить(ПутьКДанным, "Объект.", "");
		
		ИмяЭлемента = Элемент.Имя;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ссылка",          Объект.Ссылка);
		ПараметрыФормы.Вставить("ИмяРеквизита",    ИмяРеквизита);
		ПараметрыФормы.Вставить("ТекущиеЗначение", Элемент.ТекстРедактирования);
		ПараметрыФормы.Вставить("ТолькоПросмотр",  Элемент.ТолькоПросмотр);
		ПараметрыФормы.Вставить("Представления"	, Объект.Представления);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Объект", Объект);
		ДополнительныеПараметры.Вставить("ИмяРеквизита", ИмяРеквизита);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаСтрокНаРазныхЯзыках", ЭтаФорма, ДополнительныеПараметры);
		ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаРедактированияОписания", ПараметрыФормы,,,,, Оповещение);
		
	Иначе
		
		Если НЕ МодульМультиязычность = Неопределено Тогда 
			МодульМультиязычность.ПриОткрытии(ЭтаФорма, Объект, Элемент, СтандартнаяОбработка);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Перевести(Команда)
	
	ПеревестиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФотоНаСайте(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		ПоказатьПредупреждение(, НСтр("ru = 'Интернет-товар не записан'; uk = 'Інтернет-товар не записаний'"));
		Возврат;
	КонецЕсли;
	
	Настройки = eCommСервер.Настройки(Объект.Владелец);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеВыбораОтвета", ЭтотОбъект, Настройки);
	
	ТекстВопроса = НСтр("ru = 'Очистить изображения на сайте " + Объект.Владелец + "'; uk = 'Очистити зображення на сайті " + Объект.Владелец + "'") + "" ;
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , , Нстр("ru = 'Очистить изображения на сайте?'; uk = 'Очистити зображення на сайті?'"));
	
КонецПроцедуры


