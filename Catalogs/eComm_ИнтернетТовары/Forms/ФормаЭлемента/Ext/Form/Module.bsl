&НаКлиенте
Процедура СписокИзображенийИзменитьНаКлиенте(Результат, ДопПараметры) Экспорт

	Если НЕ Результат = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.СписокИзображений.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.ПолноеИмяФайла 		= "";
	ДиалогОткрытияФайла.Фильтр 				= "Все картинки (*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf)|*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf";
	ДиалогОткрытияФайла.МножественныйВыбор 	= Ложь;
	ДиалогОткрытияФайла.Заголовок 			= "Выберите изображение";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		МассивФайлов 	= ДиалогОткрытияФайла.ВыбранныеФайлы;
		ПутьКФайлу 		= МассивФайлов[0];
		Файл 			= Новый Файл(ПутьКФайлу);
	Иначе
		Предупреждение(НСтр("ru = 'Файл(ы) не выбран!'; en = 'File(s) not selected!'"));
		Возврат;
	КонецЕсли;

	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	
	// Очистка
	МассивПодстрок = eCommСервер.РазложитьСтрокуВМассивПодстрок(ТекДанные.URLКартинки, "/", Истина, Истина);
	КоличествоПодстрок = МассивПодстрок.Количество();
	Если КоличествоПодстрок > 0 Тогда 
		НазваниеФайла = МассивПодстрок[КоличествоПодстрок - 1];
		Если УдалитьНаСервере(НазваниеФайла) = Истина Тогда 
			АдресКартинки = ПередатьНаСервер(Адрес, НазваниеФайла);
			Если НЕ АдресКартинки = "" Тогда 
				ТекДанные.URLКартинки = АдресКартинки;
				ПоказатьИзображение();
				Модифицированность = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокИзображенийУдалитьНаКлиенте(Результат, ДопПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.СписокИзображений.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	МассивПодстрок = eCommСервер.РазложитьСтрокуВМассивПодстрок(ТекДанные.URLКартинки, "/", Истина, Истина);
	КоличествоПодстрок = МассивПодстрок.Количество();
	Если КоличествоПодстрок > 0 Тогда 
		НазваниеФайла = МассивПодстрок[КоличествоПодстрок - 1];
		Если УдалитьНаСервере(НазваниеФайла) = Истина Тогда 
			СписокИзображений.Удалить(ТекДанные);
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИзображение()

	ТекДанные = Элементы.СписокИзображений.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ИзображениеHTML = "<html>
	| <head>
	|  <meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"">
	| </head>
	| <body>
	|<img src=""" + ТекДанные.URLКартинки + """ width=""100%"" align=""center""/>
	| </body>
	|</html>";

КонецПроцедуры

&НаСервере
Функция ПередатьНаСервер(ФайлВХранилище, НазваниеФайла)

	СтруктураНастроек = eCommСервер.Настройки(Объект.Владелец);
	ТипПодключенияКВебСерверу = eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ТипПодключенияКВебСерверу");
	СтруктураНастроек.Вставить("ТипПодключенияКВебСерверу", ТипПодключенияКВебСерверу);
				
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ФайлВХранилище);
	
	//Запись файла локально
	ПутьКФайлу = КаталогВременныхФайлов() + НазваниеФайла;	
	
	ДвоичныеДанные.Записать(ПутьКФайлу);

	Если НЕ СтруктураНастроек.ТипПодключенияКВебСерверу = "ОбщаяПапка" Тогда
		
		FTPСоединение = eCommСервер.Установить_FTPСоединение(СтруктураНастроек);
		
		Если FTPСоединение = Неопределено Тогда 
			Возврат "";
		КонецЕсли;
				
		// Выгрузим картинку
		Если FTPСоединение.НайтиФайлы(НазваниеФайла).Количество() > 0 Тогда 
			FTPСоединение.Удалить(НазваниеФайла);
		КонецЕсли;
		
		// передача на фтп
		FTPСоединение.Записать(ПутьКФайлу, НазваниеФайла);
		
	Иначе
		
		КопироватьФайл(ПутьКФайлу, СтруктураНастроек.Сервер + "\" + НазваниеФайла);
		
	КонецЕсли;
	
	// почистим мусор
	УдалитьФайлы(ПутьКФайлу);
	
	Возврат СтруктураНастроек.URL_КаталогаКартинок + НазваниеФайла;

КонецФункции

&НаСервере
Функция УдалитьНаСервере(НазваниеФайла)

	СтруктураНастроек = eCommСервер.Настройки(Объект.Владелец);
	ТипПодключенияКВебСерверу = eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ТипПодключенияКВебСерверу");
	СтруктураНастроек.Вставить("ТипПодключенияКВебСерверу", ТипПодключенияКВебСерверу);
	
	Если НЕ СтруктураНастроек.ТипПодключенияКВебСерверу = "ОбщаяПапка" Тогда
		
		FTPСоединение = eCommСервер.Установить_FTPСоединение(СтруктураНастроек);
		
		Если FTPСоединение = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Попытка
			Если FTPСоединение.НайтиФайлы(НазваниеФайла).Количество() > 0 Тогда 
				FTPСоединение.Удалить(НазваниеФайла);
				Возврат Истина;
			КонецЕсли;
		Исключение
			Возврат Ложь;
		КонецПопытки;
		
	Иначе
		
		Попытка
			Если НайтиФайлы(СтруктураНастроек.Сервер + "\" + НазваниеФайла).Количество() > 0 Тогда
				УдалитьФайлы(СтруктураНастроек.Сервер + "\" + НазваниеФайла);
				Возврат Истина;
			КонецЕсли;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;

КонецФункции


















