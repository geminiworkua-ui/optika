Процедура СписокИзображенийПриАктивизацииСтроки(Элемент)
	
	ПоказатьИзображение();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокИзображенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	ДиалогОткрытияФайла.Фильтр = "Все картинки (*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf)|*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите изображение";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		МассивФайлов = ДиалогОткрытияФайла.ВыбранныеФайлы;
		ПутьКФайлу = МассивФайлов[0];
		Файл = Новый Файл(ПутьКФайлу);
	Иначе
		Предупреждение(НСтр("ru = 'Файл(ы) не выбран!'; en = 'File(s) not selected!'"));
	КонецЕсли;

	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	НазваниеФайла = Строка(Новый УникальныйИдентификатор()) + Файл.Расширение;
	АдресКартинки = ПередатьНаСервер(Адрес, НазваниеФайла);
	Если НЕ АдресКартинки = "" Тогда 
		НовСтр = СписокИзображений.Добавить();
		НовСтр.URLКартинки = АдресКартинки;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

