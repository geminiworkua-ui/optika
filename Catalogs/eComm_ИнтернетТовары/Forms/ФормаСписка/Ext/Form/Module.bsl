
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Отбор.Свойство("Номенклатура", Номенклатура);
	Параметры.Свойство("ИспользоватьХарактеристики", ИспользоватьХарактеристики);
	
	ОбновитьСписокНаСервере();

	Если НЕ ИспользоватьХарактеристики Тогда 
		Элементы.ФормаПомощникВвода.Видимость 	= Ложь;
		Элементы.СписокХарактеристика.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписьИнтернетТовара" Тогда 
		ОбновитьСписокНаСервере();
		РазвернутьДерево();
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.Владелец) 
		И ИспользоватьХарактеристики Тогда 
		
		ОткрытьПомощникНаКлиенте();
		
	Иначе
		ПараметрыФормы = Новый Структура("Ключ", ТекДанные.Ссылка);
		
		Если НЕ ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
			ПараметрыЗаполнения = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Владелец", ТекДанные.Номенклатура, ТекДанные.ХарактеристикаНоменклатуры, УчетнаяЗапись(ТекДанные));
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ПараметрыЗаполнения);
		КонецЕсли;
		
		ОткрытьФорму("Справочник.eComm_ИнтернетТовары.ФормаОбъекта", ПараметрыФормы, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца );
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПомощникВвода(Команда)
	
	  ОткрытьПомощникНаКлиенте();
	  
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	
	ОбновитьСписокНаСервере();
	РазвернутьДерево();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаКлиенте
Функция УчетнаяЗапись(ТекДанные)

	Если ЗначениеЗаполнено(ТекДанные.Владелец) Тогда 
		УчетнаяЗапись = ТекДанные.Владелец;
	Иначе
		СтрокаВерхнегоУровня = ТекДанные.ПолучитьРодителя();
		УчетнаяЗапись = СтрокаВерхнегоУровня.Владелец;
	КонецЕсли;
	
	Возврат УчетнаяЗапись;

КонецФункции

&НаКлиенте
Процедура ОткрытьПомощникНаКлиенте()

	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаПомощникаВводаИнтернетТоваров", Новый Структура("Номенклатура, Владелец", Номенклатура, УчетнаяЗапись(ТекДанные)), ЭтаФорма, Номенклатура, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокНаСервере()

	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры
		|ПОМЕСТИТЬ НоменклатураХарактеристика
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	(НЕ Номенклатура.#ИспользоватьХарактеристики#
		|			ИЛИ НЕ &ИспользоватьХарактеристики)
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И Номенклатура.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО Номенклатура.Ссылка = ХарактеристикиНоменклатуры.Владелец
		|			ИЛИ ХарактеристикиНоменклатуры.Владелец В
		|				(ВЫБРАТЬ
		|					Номенклатура.#КатегорияНоменклатуры# КАК КатегорияНоменклатуры
		|				ИЗ
		|					Справочник.Номенклатура КАК Номенклатура
		|				ГДЕ
		|					Номенклатура.Ссылка = &Ссылка)
		|ГДЕ
		|	&ИспользоватьХарактеристики
		|	И Номенклатура.#ИспользоватьХарактеристики#
		|	И Номенклатура.Ссылка = &Ссылка
		|	#УсловиеХарактеристикаНедействительна#
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НоменклатураХарактеристика.Номенклатура КАК Номенклатура,
		|	НоменклатураХарактеристика.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	eComm_УчетныеЗаписи.Ссылка КАК Владелец
		|ПОМЕСТИТЬ НоменклатураХаратктеристикаВладелец
		|ИЗ
		|	НоменклатураХарактеристика КАК НоменклатураХарактеристика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.eComm_УчетныеЗаписи КАК eComm_УчетныеЗаписи
		|		ПО (ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НоменклатураХаратктеристикаВладелец.Номенклатура КАК Номенклатура,
		|	НоменклатураХаратктеристикаВладелец.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	НоменклатураХаратктеристикаВладелец.Владелец КАК Владелец,
		|	eComm_ИнтернетТовары.Ссылка КАК Ссылка,
		|	eComm_ИнтернетТовары.Ссылка.Наименование КАК Наименование,
		|	eComm_ИнтернетТовары.Категория КАК Категория,
		|	eComm_ИнтернетТовары.Код КАК Код,
		|	eComm_ИнтернетТовары.Отключить КАК Отключить
		|ИЗ
		|	НоменклатураХаратктеристикаВладелец КАК НоменклатураХаратктеристикаВладелец
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|		ПО НоменклатураХаратктеристикаВладелец.Номенклатура = eComm_ИнтернетТовары.Номенклатура
		|			И НоменклатураХаратктеристикаВладелец.ХарактеристикаНоменклатуры = eComm_ИнтернетТовары.ХарактеристикаНоменклатуры
		|			И НоменклатураХаратктеристикаВладелец.Владелец = eComm_ИнтернетТовары.Владелец
		|ИТОГИ ПО
		|	Владелец";
	
	ИмяРеквизитаНедействителен  = eCommСервер.ВернутьИмяРеквизитаОбъекта("ХарактеристикиНоменклатуры", "Недействителен");
	Если ЗначениеЗаполнено(ИмяРеквизитаНедействителен) Тогда 
		УсловиеХарактеристикаНедействительна = "И НЕ ХарактеристикиНоменклатуры.Недействителен = ИСТИНА";
	Иначе
		УсловиеХарактеристикаНедействительна = "";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИспользоватьХарактеристики#"				, eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "ИспользоватьХарактеристики"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#КатегорияНоменклатуры#"					, eCommСервер.ВернутьИмяРеквизитаОбъекта("КатегорииНоменклатуры", "КатегорияНоменклатуры"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#УсловиеХарактеристикаНедействительна#"	, УсловиеХарактеристикаНедействительна);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики"	, ИспользоватьХарактеристики);
	Запрос.УстановитьПараметр("Ссылка"						, Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаВладелец = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	КореньДерева = Список.ПолучитьЭлементы();
	КореньДерева.Очистить();
	
	Пока ВыборкаВладелец.Следующий() Цикл
		
		ВыборкаДетальныеЗаписи = ВыборкаВладелец.Выбрать();
		
		СтрокаУчетнойЗаписи = КореньДерева.Добавить();
		СтрокаУчетнойЗаписи.Владелец = ВыборкаВладелец.Владелец;
		
		Если ИспользоватьХарактеристики Тогда 
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СтрокиИнтернетТовара = СтрокаУчетнойЗаписи.ПолучитьЭлементы();
				ЗаполнитьЗначенияСвойств(СтрокиИнтернетТовара.Добавить(), ВыборкаДетальныеЗаписи, , "Владелец");
			КонецЦикла;
		Иначе
			ВыборкаДетальныеЗаписи.Следующий();
			ЗаполнитьЗначенияСвойств(СтрокаУчетнойЗаписи, ВыборкаДетальныеЗаписи, , "Владелец");
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево()

	Для каждого Ид Из Список.ПолучитьЭлементы() Цикл
		Элементы.Список.Развернуть(Ид.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры




