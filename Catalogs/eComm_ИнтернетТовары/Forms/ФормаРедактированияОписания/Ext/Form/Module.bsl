
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НаборЯзыков = Новый ТаблицаЗначений;
	НаборЯзыков.Колонки.Добавить("КодЯзыка",      Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	НаборЯзыков.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	НаборЯзыков.Колонки.Добавить("Суффикс",       Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));

	Для Каждого ЯзыкКонфигурации Из Метаданные.Языки Цикл
		
		НовыйЯзык = НаборЯзыков.Добавить();
		НовыйЯзык.КодЯзыка = ЯзыкКонфигурации.КодЯзыка;
		НовыйЯзык.Представление = ЯзыкКонфигурации.Представление();
		
	КонецЦикла;
	
	ОсновнойЯзык 		= eCommСервер.ВернутьОсновнойЯзык();
	
	Сч = 1;
	// Привяжем к первому элементу основной язык
	Для Каждого ЯзыкКонфигурации Из НаборЯзыков Цикл
		Если ОсновнойЯзык = ЯзыкКонфигурации.КодЯзыка Тогда 
			НоваяСтрока = Языки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЯзыкКонфигурации);
			НоваяСтрока.Имя = "ОписаниеHTML_" + Сч;
			Элементы["Группа_" + Сч].Заголовок = Нстр("ru = 'Описание ('; uk = 'Опис ('") + ЯзыкКонфигурации.Представление + ")";
			Сч = Сч + 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Дополнительные языки разместим в элементах ниже основного
	Для Каждого ЯзыкКонфигурации Из НаборЯзыков Цикл
		Если НЕ ОсновнойЯзык = ЯзыкКонфигурации.КодЯзыка Тогда 
			НоваяСтрока = Языки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЯзыкКонфигурации);
			НоваяСтрока.Имя = "ОписаниеHTML_" + Сч;
			Элементы["Группа_" + Сч].Заголовок = Нстр("ru = 'Описание ('; uk = 'Опис ('") + ЯзыкКонфигурации.Представление + ")";
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЯзыка = ОписаниеЯзыка(eCommСервер.ВернутьКодТекущегоЯзыка());
	
	Если ОписаниеЯзыка <> Неопределено Тогда
		
		Если Найти(Параметры.ТекущиеЗначение, "</html>") = 0 Тогда
			_ОписаниеHTML = "<html>" + Параметры.ТекущиеЗначение + "</html>";	
		Иначе	
			_ОписаниеHTML = Параметры.ТекущиеЗначение;	
		КонецЕсли;
		
		ЭтаФорма[ОписаниеЯзыка.Имя].УстановитьHTML(_ОписаниеHTML, Новый Структура);
		
	КонецЕсли;
	
	Для каждого Представление Из Параметры.Представления Цикл
		
		ОписаниеЯзыка = ОписаниеЯзыка(Представление.КодЯзыка);
		Если ОписаниеЯзыка <> Неопределено Тогда
			Если ВРЕГ(ОписаниеЯзыка.КодЯзыка) = ВРЕГ(eCommСервер.ВернутьКодТекущегоЯзыка()) Тогда
				
				Если Найти(Параметры.ТекущиеЗначение, "</html>") = 0 Тогда
					_ОписаниеHTML = "<html>" + Параметры.ТекущиеЗначение + "</html>";	
				Иначе	
					_ОписаниеHTML = Параметры.ТекущиеЗначение;	
				КонецЕсли;

				Если ЗначениеЗаполнено(Параметры.ТекущиеЗначение) Тогда 
					ЭтаФорма[ОписаниеЯзыка.Имя].УстановитьHTML(_ОписаниеHTML, Новый Структура);
				Иначе
					ЭтаФорма[ОписаниеЯзыка.Имя].УстановитьHTML(Представление[Параметры.ИмяРеквизита], Новый Структура);
				КонецЕсли;

			Иначе
				ЭтаФорма[ОписаниеЯзыка.Имя].УстановитьHTML(Представление[Параметры.ИмяРеквизита], Новый Структура);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕТОВ ФОРМЫ

&НаКлиенте
Процедура ОК(Команда)
	
	Результат = Новый Структура("ОсновнойЯзык", ОсновнойЯзык);
	Результат.Вставить("ЗначенияНаРазныхЯзыках", Новый Массив);
	Результат.Вставить("ХранениеВТабличнойЧасти", Истина);
	
	Для каждого Язык Из Языки Цикл
		
		Если Язык.КодЯзыка = eCommСервер.ВернутьКодТекущегоЯзыка() Тогда
			
			ОписаниеСтрокой = "";
			ЭтаФорма[Язык.Имя].ПолучитьHTML(ОписаниеСтрокой, Новый Структура);
			
			Результат.Вставить("СтрокаНаТекущемЯзыке", ОписаниеСтрокой);
		КонецЕсли;
		
		Если eCommСервер.ВернутьКодТекущегоЯзыка() = ОсновнойЯзык И Язык.КодЯзыка = ОсновнойЯзык Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеСтрокой = "";
		ЭтаФорма[Язык.Имя].ПолучитьHTML(ОписаниеСтрокой, Новый Структура);
			
		Значения = Новый Структура;
		Значения.Вставить("КодЯзыка",          Язык.КодЯзыка);
		Значения.Вставить("ЗначениеРеквизита", ОписаниеСтрокой);
		Значения.Вставить("Суффикс",           Язык.Суффикс);
		
		Результат.ЗначенияНаРазныхЯзыках.Добавить(Значения);
	КонецЦикла;
	
	Закрыть(Результат);
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Функция ОписаниеЯзыка(КодЯзыка)
	
	Отбор = Новый Структура("КодЯзыка", КодЯзыка);
	НайденныеЭлементы = Языки.НайтиСтроки(Отбор);
	Если НайденныеЭлементы.Количество() > 0 Тогда
		Возврат НайденныеЭлементы[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

