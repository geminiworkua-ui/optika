// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Номенклатура"	, Номенклатура);
	Параметры.Свойство("Владелец"		, Владелец);
	
	ИнициализироватьУчетнуюЗапись();
	
	Если ЗначениеЗаполнено(Объект.URLКартинки) Тогда 
		МассивСсылок = eCommСервер.РазложитьСтрокуВМассивПодстрок(Объект.URLКартинки, Символы.ПС, Истина, Истина);
		//Для Каждого ЭлементМассива Из МассивСсылок Цикл 
		//	НовСтр = СписокИзображений.Добавить();
		//	НовСтр.URLКартинки = ЭлементМассива;
		//КонецЦикла;
	КонецЕсли;
	
	УстановитьПояснениеПомощника();
	ЗаполнитьПредставлениеОбновляемыхПолей();
	ЗаполнитьПредставлениеДополнительныхКатегорий();
	ЗаполнитьПредставлениеОптовыхЦен();
	
	Если Элементы.Метки.Видимость = Истина Тогда 
		ЗаполнитьПредставлениеМеток(Перечисления["eComm_ТипыМеток"].Ярлык);
		ЗаполнитьПредставлениеМеток(Перечисления["eComm_ТипыМеток"].Маркетплейс);
	КонецЕсли;
	
	ПриЧтенииНаСервере(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда 
			МультиязычностьПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.ОписаниеВФорматеHTML Тогда 
		Если Найти(Объект.Описание, "</html>") = 0 Тогда
			_ОписаниеHTML = "<html>" + Объект.Описание + "</html>";	
		Иначе	
			_ОписаниеHTML = Объект.Описание;	
		КонецЕсли;
		ОписаниеHTML.УстановитьHTML(_ОписаниеHTML, Новый Структура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ОписаниеВФорматеHTML Тогда 
		Если НЕ ОписаниеHTML.ПолучитьТекст() = "" Тогда 
			ОписаниеHTML.ПолучитьHTML(Объект.Описание, Новый Структура);
		Иначе
			Объект.Описание = "";
		КонецЕсли;
	КонецЕсли;
	
	//Если НЕ РучноеРедактированиеИзображений Тогда 
	//	Объект.URLКартинки = "";
	//	Для Каждого Стр Из СписокИзображений Цикл 
	//		Объект.URLКартинки = Объект.URLКартинки + ?(Объект.URLКартинки = "", Стр.URLКартинки, Символы.ПС + Стр.URLКартинки);
	//	КонецЦикла;
	//КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда 
			МультиязычностьПередЗаписьюНаСервере(ТекущийОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда
			МультиязычностьПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Оповестить("ЗаписьИнтернетТовара");
КонецПроцедуры


