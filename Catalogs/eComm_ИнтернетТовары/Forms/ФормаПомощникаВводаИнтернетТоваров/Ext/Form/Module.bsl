&НаСервере
Процедура ИнициализироватьУчетнуюЗапись()

	НастройкиУчетнойЗаписи = eCommСервер.Настройки(Владелец);
	
	ИспользоватьМультиязычность 				= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "ИспользоватьМультиязычность");
	НеПодставлятьХарактеристикуВНаименование 	= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "НеПодставлятьХарактеристикуВНаименование");
	ИмяРеквизитаНаименованиеИнтернетТовара 		= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "ИмяРеквизитаНаименованиеИнтернетТовара");
	ИмяРеквизитаОписаниеИнтернетТовара			= eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "ИмяРеквизитаОписаниеИнтернетТовара");
	Если НЕ ЗначениеЗаполнено(ИмяРеквизитаНаименованиеИнтернетТовара) Тогда 
		ИмяРеквизитаНаименованиеИнтернетТовара = "Наименование";
	КонецЕсли;
	
	Если ИспользоватьМультиязычность = Истина Тогда 
		
		Если НЕ НРег(eCommСервер.ВернутьКодТекущегоЯзыка()) = НРег(eCommСервер.ВернутьОсновнойЯзык()) Тогда 
			ТолькоПросмотр = Истина;
			Сообщить(НСтр("ru = 'Язык интерфейса не соответствует основному языку конфигурации. 
						|Измените язык интерфейса пользователя для продолжения редактирования'; 
						|uk = 'Мова інтерфейсу не відповідає основній мові конфігурації. 
						|Змініть мову интерфейсу користувача для продовження редагування'"));
		КонецЕсли;
		
	КонецЕсли;
	
	ИнициализироватьОбъект();
	ИнициализироватьОбновляемыеПоля();
	
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда 
			
			МультиязычностьПриСозданииНаСервере(ЭтотОбъект, Объект);
			
			ЭтаФорма.Элементы.Наименование.КнопкаОткрытия = Истина;
			ЭтаФорма.Элементы.Наименование.УстановитьДействие("Открытие", "Подключаемый_Открытие"); 
			ЭтаФорма["ПараметрыМультиязычныхРеквизитов"].Вставить("Наименование", "Наименование");
			
			ЭтаФорма.Элементы.Описание.КнопкаОткрытия = Истина;
			ЭтаФорма.Элементы.Описание.УстановитьДействие("Открытие", "Подключаемый_Открытие"); 
			ЭтаФорма["ПараметрыМультиязычныхРеквизитов"].Вставить("Описание", "Описание");
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();

КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОбъект()

	Объект = Новый Структура();
	Объект.Вставить("Ссылка"					, Справочники.eComm_ИнтернетТовары.ПустаяСсылка());
	Объект.Вставить("Владелец"					, Владелец);
	Объект.Вставить("Наименование"				, Наименование);
	Объект.Вставить("Номенклатура"				, Номенклатура);
	Объект.Вставить("Категория"					, Неопределено);
	Объект.Вставить("ИнтернетСсылка"			, "");
	Объект.Вставить("Описание"					, "");
	Объект.Вставить("ОписаниеВФорматеHTML"		, Ложь);
	Объект.Вставить("АкционнаяСкидка"			, 0);
	Объект.Вставить("Производитель"				, Неопределено);
	Объект.Вставить("URLКартинки"				, "");
	Объект.Вставить("Отключить"					, Ложь);
	Объект.Вставить("КлючевыеСлова"				, "");
	Объект.Вставить("ОптоваяЦенаПриЗаказеОт"	, 0);
	Объект.Вставить("Представления"				, Представления);
	Объект.Вставить("ДополнительныеКатегории"	, ДополнительныеКатегории);
	Объект.Вставить("Метки"						, Метки);
	Объект.Вставить("ОптовыеЦены"				, ОптовыеЦены);
	
	// Получим значение характеристики по умолчанию.
	// Интернет-товар характеристики по умолчанию будет
	// использоваться как шаблон для записи остальных характеристик
	
	ДанныеИнициализации = ПодготовитьДанныеИнициализации();
	
	ДанныеИнтернетТовара 		= ДанныеИнициализации.ИнтернетТовар.Выбрать();
	ВыборкаХарактеристики		= ДанныеИнициализации.ХарактеристикиНоменклатуры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ДанныеИнтернетТовара.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(Объект, ДанныеИнтернетТовара);
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеИнтернетТовара);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДанныеИнициализации.Представления.Выгрузить()			, "Представления");
	ЗначениеВРеквизитФормы(ДанныеИнициализации.ДополнительныеКатегории.Выгрузить()	, "ДополнительныеКатегории");
	ЗначениеВРеквизитФормы(ДанныеИнициализации.ОптовыеЦены.Выгрузить()				, "ОптовыеЦены");
	Если Владелец.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда
		ЗначениеВРеквизитФормы(ДанныеИнициализации.Метки.Выгрузить()				, "Метки");
	КонецЕсли;
	
	ДеревоХарактеристик.ПолучитьЭлементы().Очистить();
	
	КореньДерева = ДеревоХарактеристик.ПолучитьЭлементы();
	КореньДерева.Очистить();
	
	ОбщаяЧастьНаименования = Новый Соответствие;
	
	Пока ВыборкаХарактеристики.Следующий() Цикл
		
		СтрокаХарактеристики = КореньДерева.Добавить();
		СтрокаХарактеристики.ХарактеристикаНоменклатуры = ВыборкаХарактеристики.ХарактеристикаНоменклатуры;
		
		СтрокиНаименований = СтрокаХарактеристики.ПолучитьЭлементы();
		
		ВыборкаДетальныеЗаписи = ВыборкаХарактеристики.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Наименование) Тогда 
				ИнтернетТоварНаименование = ВыборкаДетальныеЗаписи.Наименование;
			ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.НоменклатураНаименование) Тогда 
				Если НеПодставлятьХарактеристикуВНаименование = Истина Тогда 
					ИнтернетТоварНаименование = ВыборкаДетальныеЗаписи.НоменклатураНаименование;
				Иначе
					ИнтернетТоварНаименование = ВыборкаДетальныеЗаписи.НоменклатураНаименование + ", " + ВыборкаДетальныеЗаписи.ХарактеристикаНаименование;
				КонецЕсли;
			Иначе
				Если НеПодставлятьХарактеристикуВНаименование = Истина Тогда
					ИнтернетТоварНаименование = ВыборкаХарактеристики.НоменклатураНаименование;
				Иначе
					ИнтернетТоварНаименование = ВыборкаХарактеристики.НоменклатураНаименование + ", " + ВыборкаДетальныеЗаписи.ХарактеристикаНаименование;
				КонецЕсли;
			КонецЕсли;
			
			Если ОбщаяЧастьНаименования[ВыборкаДетальныеЗаписи.КодЯзыка] = Неопределено Тогда 
				ОбщаяЧастьНаименования.Вставить(ВыборкаДетальныеЗаписи.КодЯзыка, ИнтернетТоварНаименование);
			Иначе
				ОбщаяЧастьНаименования.Вставить(ВыборкаДетальныеЗаписи.КодЯзыка, ВернутьОбщуюЧастьНаименований(ОбщаяЧастьНаименования[ВыборкаДетальныеЗаписи.КодЯзыка], ИнтернетТоварНаименование));
			КонецЕсли;
			
			СтрокаНаименования = СтрокиНаименований.Добавить();
			СтрокаНаименования.КодЯзыка 		= ВыборкаДетальныеЗаписи.КодЯзыка;
			СтрокаНаименования.Наименование		= ИнтернетТоварНаименование;
			СтрокаНаименования.ИнтернетТовар	= ВыборкаДетальныеЗаписи.ИнтернетТовар;
			СтрокаНаименования.ПоУмолчанию		= ВыборкаДетальныеЗаписи.ПоУмолчанию;
		КонецЦикла;
		
	КонецЦикла;
	
	ПеренестиОбщуюЧастьНаименованияВОбъект(ОбщаяЧастьНаименования);

КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеИнициализации(СтруктураНастроек = Неопределено)

	СтруктураВозврата 	= Новый Структура();
	
	ТекстыЗапроса 		= Новый СписокЗначений;
	ПараметрыЗапроса 	= Новый Структура();
	
	ДополнитьТекстыЗапросаХарактеристикойПоУмолчанию(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаШаблономИнтернетТовара(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаПредставлениямиПоУмолчанию(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаМеткамиПоУмолчанию(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаДополнительнымиКатегориямиПоУмолчанию(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаОптовымиЦенамиПоУмолчанию(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаНаименованияШаблонаИнтернетТовара(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаНаименованияИнтернетТоваров(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	
	// Формирование текст запроса.
	ЗапросТекст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		ЗапросТекст = ЗапросТекст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросТекст;
	
	Для Каждого Параметр Из ПараметрыЗапроса Цикл 
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	// Выполнение запроса.
	Результат = Запрос.ВыполнитьПакет();
	
	// Помещение результатов запроса в таблицы
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		
		ИмяТаблицы = ТекстЗапроса.Представление;
		
		Если Не ПустаяСтрока(ИмяТаблицы) 
			И НЕ ПустаяСтрока(ТекстЗапроса.Значение) Тогда
			
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			СтруктураВозврата.Вставить(ИмяТаблицы, Результат[Индекс]);
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат СтруктураВозврата;

КонецФункции

&НаСервере
Процедура ДополнитьТекстыЗапросаХарактеристикойПоУмолчанию(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ЗначенияНоменклатурыПоУмолчанию = eCommСервер.ВернутьИмяПрикладногоОбъекта("ЗначенияНоменклатурыПоУмолчанию");
	
	ТекстЗапроса = "";
	Если НЕ ЗначенияНоменклатурыПоУмолчанию = "" Тогда
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	ХарактеристикаПоУмолчанию.Номенклатура КАК Номенклатура,
			|	ХарактеристикаПоУмолчанию.Характеристика КАК Характеристика
			|ПОМЕСТИТЬ ВрТабНоменклатураХарактеристика
			|ИЗ
			|	(ВЫБРАТЬ
			|		ЗначенияНоменклатурыПоУмолчанию.Номенклатура КАК Номенклатура,
			|		ЗначенияНоменклатурыПоУмолчанию.Характеристика КАК Характеристика,
			|		1 КАК Порядок
			|	ИЗ
			|		РегистрСведений.ЗначенияНоменклатурыПоУмолчанию КАК ЗначенияНоменклатурыПоУмолчанию
			|	ГДЕ
			|		ЗначенияНоменклатурыПоУмолчанию.Номенклатура = &Номенклатура
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ ПЕРВЫЕ 1
			|		ХарактеристикиНоменклатуры.Владелец,
			|		ХарактеристикиНоменклатуры.Ссылка,
			|		2
			|	ИЗ
			|		Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
			|	ГДЕ
			|		ХарактеристикиНоменклатуры.Владелец = &Номенклатура) КАК ХарактеристикаПоУмолчанию
			|
			|УПОРЯДОЧИТЬ ПО
			|	ХарактеристикаПоУмолчанию.Порядок
			|
			|;";
	Иначе
		ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ ПЕРВЫЕ 1
			|	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура,
			|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
			|ПОМЕСТИТЬ ВрТабНоменклатураХарактеристика
			|ИЗ
			|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
			|ГДЕ
			|	ХарактеристикиНоменклатуры.Владелец = &Номенклатура
			|
			|;";	
	КонецЕсли;
				
	ПараметрыЗапроса.Вставить("Номенклатура"	, Номенклатура);
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "");
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьТекстыЗапросаШаблономИнтернетТовара(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ТекстЗапроса = "ВЫБРАТЬ
		|	eComm_ИнтернетТовары.Наименование КАК Наименование,
		|	eComm_ИнтернетТовары.Номенклатура КАК Номенклатура,
		|	eComm_ИнтернетТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	eComm_ИнтернетТовары.Категория КАК Категория,
		|	eComm_ИнтернетТовары.ИнтернетСсылка КАК ИнтернетСсылка,
		|	eComm_ИнтернетТовары.Описание КАК Описание,
		|	eComm_ИнтернетТовары.ОписаниеВФорматеHTML КАК ОписаниеВФорматеHTML,
		|	eComm_ИнтернетТовары.АкционнаяСкидка КАК АкционнаяСкидка,
		|	eComm_ИнтернетТовары.Производитель КАК Производитель,
		|	eComm_ИнтернетТовары.URLКартинки КАК URLКартинки,
		|	eComm_ИнтернетТовары.Отключить КАК Отключить,
		|	eComm_ИнтернетТовары.КлючевыеСлова КАК КлючевыеСлова,
		|	eComm_ИнтернетТовары.ОптоваяЦенаПриЗаказеОт КАК ОптоваяЦенаПриЗаказеОт,
		|	eComm_ИнтернетТовары.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВрТабИнтернетТовар
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|ГДЕ
		|	(eComm_ИнтернетТовары.Номенклатура, eComm_ИнтернетТовары.ХарактеристикаНоменклатуры) В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ВрТабНоменклатураХарактеристика.Номенклатура КАК Номенклатура,
		|				ВрТабНоменклатураХарактеристика.Характеристика КАК Характеристика
		|			ИЗ
		|				ВрТабНоменклатураХарактеристика КАК ВрТабНоменклатураХарактеристика)
		|	И eComm_ИнтернетТовары.Владелец = &Владелец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИнтернетТовар.Наименование КАК Наименование,
		|	ИнтернетТовар.Номенклатура КАК Номенклатура,
		|	ИнтернетТовар.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ИнтернетТовар.Категория КАК Категория,
		|	ИнтернетТовар.ИнтернетСсылка КАК ИнтернетСсылка,
		|	ИнтернетТовар.Описание КАК Описание,
		|	ИнтернетТовар.ОписаниеВФорматеHTML КАК ОписаниеВФорматеHTML,
		|	ИнтернетТовар.АкционнаяСкидка КАК АкционнаяСкидка,
		|	ИнтернетТовар.Производитель КАК Производитель,
		|	ИнтернетТовар.URLКартинки КАК URLКартинки,
		|	ИнтернетТовар.Отключить КАК Отключить,
		|	ИнтернетТовар.КлючевыеСлова КАК КлючевыеСлова,
		|	ИнтернетТовар.ОптоваяЦенаПриЗаказеОт КАК ОптоваяЦенаПриЗаказеОт
		|ИЗ
		|	ВрТабИнтернетТовар КАК ИнтернетТовар
		|;";
	
	ПараметрыЗапроса.Вставить("Владелец"		, Владелец);
	
	ТекстыЗапроса.Добавить("", "ВрТабИнтернетТовар");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ИнтернетТовар");

КонецПроцедуры

