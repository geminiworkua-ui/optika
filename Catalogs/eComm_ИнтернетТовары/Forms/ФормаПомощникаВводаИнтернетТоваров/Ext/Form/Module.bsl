&НаСервере
Процедура ДополнитьТекстыЗапросаНаименованияШаблонаИнтернетТовара(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ТекстЗапроса = "ВЫБРАТЬ
		|	eComm_ИнтернетТовары.Наименование КАК Наименование,
		|	&ОсновнойЯзык КАК КодЯзыка,
		|	eComm_ИнтернетТовары.Ссылка КАК ИнтернетТовар,
		|	eComm_ИнтернетТовары.Номенклатура КАК Номенклатура,
		|	eComm_ИнтернетТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	1 КАК Порядок
		|ПОМЕСТИТЬ ВрТабЛокализованныеНаименования
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|ГДЕ
		|	eComm_ИнтернетТовары.Владелец = &Владелец
		|	И eComm_ИнтернетТовары.Номенклатура = &Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	eComm_ИнтернетТоварыПредставления.Наименование,
		|	eComm_ИнтернетТоварыПредставления.КодЯзыка,
		|	eComm_ИнтернетТоварыПредставления.Ссылка,
		|	eComm_ИнтернетТоварыПредставления.Ссылка.Номенклатура,
		|	eComm_ИнтернетТоварыПредставления.Ссылка.ХарактеристикаНоменклатуры,
		|	2
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары.Представления КАК eComm_ИнтернетТоварыПредставления
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ИспользоватьМультияЗычность = ИСТИНА
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	И eComm_ИнтернетТоварыПредставления.Ссылка.Владелец = &Владелец
		|	И eComm_ИнтернетТоварыПредставления.Ссылка.Номенклатура = &Номенклатура
		|;";
	
	ПараметрыЗапроса.Вставить("ОсновнойЯзык"				, eCommСервер.ВернутьОсновнойЯзык());
	ПараметрыЗапроса.Вставить("ИспользоватьМультияЗычность"	, ИспользоватьМультияЗычность);
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "");

КонецПроцедуры

&НаСервере
Процедура ДополнитьТекстыЗапросаНаименованияИнтернетТоваров(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ИмяРеквизита_КатегорияНоменклатуры 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("КатегорииНоменклатуры", "КатегорияНоменклатуры");
	ИмяРеквизитаНедействителен  		= eCommСервер.ВернутьИмяРеквизитаОбъекта("ХарактеристикиНоменклатуры", "Недействителен");
	
	Если ЗначениеЗаполнено(ИмяРеквизитаНедействителен) Тогда 
		УсловиеХарактеристикаНедействительна = "И НЕ ХарактеристикиНоменклатуры.Недействителен = ИСТИНА";
	Иначе
		УсловиеХарактеристикаНедействительна = "";
	КонецЕсли;
	
	ЯзыкиКонфигурации 					= eCommСервер.ВернутьЯзыкиКонфигурации();

	ТекстЗапросаДополнительныхЯзыков = "";
	Сч = 1;
	
	Для Каждого Язык Из ЯзыкиКонфигурации Цикл
		
		Если Язык = ПараметрыЗапроса.ОсновнойЯзык 
			ИЛИ ИспользоватьМультиязычность = Ложь Тогда 
			Продолжить;
		КонецЕсли;
		
		Сч = Сч + 1;
		
		ТекстЗапросаДополнительныхЯзыков = ТекстЗапросаДополнительныхЯзыков + 
			"		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ
			|			""" + Язык + """, 
			|			" + Сч + " ";
		
	КонецЦикла;
		
	ТекстЗапроса = "ВЫБРАТЬ
		//++
		//|	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ХарактеристикиНоменклатуры.Владелец ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ХарактеристикиНоменклатуры.Владелец
		|		ИНАЧЕ &Номенклатура
		|	КОНЕЦ КАК Номенклатура,
		//--
		|	ХарактеристикиНоменклатуры.Ссылка КАК ХарактеристикаНоменклатуры,
		|	ХарактеристикиНоменклатуры.Наименование КАК ХарактеристикаНаименование,
		|	ХарактеристикиНоменклатуры.Владелец." + ИмяРеквизитаНаименованиеИнтернетТовара + " КАК НоменклатураНаименование,
		|	ТабЯзыки.КодЯзыка КАК КодЯзыка,
		|	ВЫБОР
		|		КОГДА НЕ ЗначенияНоменклатурыПоУмолчанию.Характеристика ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПоУмолчанию,
		|	ТабЯзыки.Порядок КАК Порядок
		|ПОМЕСТИТЬ ВрТабХарактеристикиНоменклатуры
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			&ОсновнойЯзык КАК КодЯзыка, 
		|			1 КАК Порядок
		|"	+ ТекстЗапросаДополнительныхЯзыков + "	
		|			) КАК ТабЯзыки
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабНоменклатураХарактеристика КАК ЗначенияНоменклатурыПоУмолчанию
		|		ПО ЗначенияНоменклатурыПоУмолчанию.Характеристика = ХарактеристикиНоменклатуры.Ссылка
		|			И ЗначенияНоменклатурыПоУмолчанию.Номенклатура = ХарактеристикиНоменклатуры.Владелец
		|ГДЕ
		|	ХарактеристикиНоменклатуры.ПометкаУдаления = ЛОЖЬ 
		|	#УсловиеХарактеристикаНедействительна#
		|	И (ХарактеристикиНоменклатуры.Владелец = &Номенклатура
		|	ИЛИ ХарактеристикиНоменклатуры.Владелец В
		|		(ВЫБРАТЬ
		|			Номенклатура." + ИмяРеквизита_КатегорияНоменклатуры + " КАК КатегорияНоменклатуры
		|		ИЗ
		|			Справочник.Номенклатура КАК Номенклатура
		|		ГДЕ
		|			Номенклатура.Ссылка = &Номенклатура))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабЛокализованныеНаименования.ИнтернетТовар КАК ИнтернетТовар,
		|	ВрТабЛокализованныеНаименования.Наименование КАК Наименование,
		|	ВрТабХарактеристикиНоменклатуры.КодЯзыка КАК КодЯзыка,
		|	ВрТабХарактеристикиНоменклатуры.ПоУмолчанию КАК ПоУмолчанию,
		|	ВрТабХарактеристикиНоменклатуры.НоменклатураНаименование КАК НоменклатураНаименование,
		|	ВрТабХарактеристикиНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВрТабХарактеристикиНоменклатуры.ХарактеристикаНаименование КАК ХарактеристикаНаименование
		//|	ВрТабЛокализованныеНаименования.ИнтернетТовар.Наименование КАК ИнтернетТоварНаименование
		|ИЗ
		|	ВрТабХарактеристикиНоменклатуры КАК ВрТабХарактеристикиНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабЛокализованныеНаименования КАК ВрТабЛокализованныеНаименования
		|		ПО ВрТабХарактеристикиНоменклатуры.Номенклатура = ВрТабЛокализованныеНаименования.Номенклатура
		|			И ВрТабХарактеристикиНоменклатуры.ХарактеристикаНоменклатуры = ВрТабЛокализованныеНаименования.ХарактеристикаНоменклатуры
		|			И ВрТабХарактеристикиНоменклатуры.КодЯзыка = ВрТабЛокализованныеНаименования.КодЯзыка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВрТабХарактеристикиНоменклатуры.ПоУмолчанию УБЫВ,
		|	ВрТабХарактеристикиНоменклатуры.Порядок
		|ИТОГИ
		|	МАКСИМУМ(НоменклатураНаименование)
		|ПО
		|	ХарактеристикаНоменклатуры";
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#УсловиеХарактеристикаНедействительна#", УсловиеХарактеристикаНедействительна);
	
	ТекстыЗапроса.Добавить("", "ВрТабХарактеристикиНоменклатуры");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ХарактеристикиНоменклатуры");
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОбновляемыеПоля()

	ОбновляемыеПоля.Добавить("Наименование"				, "Наименование"			, Истина);
	ОбновляемыеПоля.Добавить("Категория"				, "Категория"				, Истина);
	ОбновляемыеПоля.Добавить("ДополнительныеКатегории"	, "Доп. категории"			, Истина);
	ОбновляемыеПоля.Добавить("Описание"					, "Описание"				, Истина);
	ОбновляемыеПоля.Добавить("АкционнаяСкидка"			, "Изменение старой цены (%)", Истина);
	ОбновляемыеПоля.Добавить("Отключить"				, "Отключить"				, Истина);
	ОбновляемыеПоля.Добавить("КлючевыеСлова"			, "Ключевые слова"			, Истина);
	Если Владелец.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда 
		ОбновляемыеПоля.Добавить("Метки"				, "Ярлыки / Маркетплейсы"	, Истина);
	ИначеЕсли Владелец.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда 
		ОбновляемыеПоля.Добавить("ОптовыеЦены"			, "Оптовые цены"			, Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()

	// Применим настройки согласно шаблона для торговой площадки
	
	МакетНастроек = Справочники.eComm_ИнтернетТовары.ПолучитьМакет("НастройкиДоступностиРеквизитов");
	
	КоличествоЗаписей = МакетНастроек.ВысотаТаблицы;
	
	ИмяЗначенияПеречисления = eCommСервер.ВернутьИмяЗначенияПеречисления(Объект.Владелец.ТорговаяПлощадка);
	НомерКолонки			= 0;
	
	Для Сч = 0 По МакетНастроек.ШиринаТаблицы - 1 Цикл
		Если СокрЛП(МакетНастроек.Область(1, Сч).Текст) = ИмяЗначенияПеречисления Тогда 
			НомерКолонки = Сч;
		КонецЕсли;
	КонецЦикла;
		
	Для Сч = 2 по КоличествоЗаписей Цикл
		
		ИмяЭлемента 	= СокрЛП(МакетНастроек.Область(Сч, 1).Текст);
		
		Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда 
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Владелец) Тогда 
			Продолжить;
		КонецЕсли;
		
		Видимость 				= СокрЛП(МакетНастроек.Область(Сч, НомерКолонки).Текст) = "+";
		
		Попытка
			Если НЕ Элементы[ИмяЭлемента].Видимость = Видимость Тогда 
				Элементы[ИмяЭлемента].Видимость = Видимость;
			КонецЕсли;
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	// Применим настройки учетной записи
	
	Элементы["Производитель"].Видимость = eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Производитель") = "";

	Если Объект.Владелец.ВыгружатьКартинкиИзБазы = Истина Тогда 
		Элементы.ГруппаКартинки.Видимость = Ложь;
	КонецЕсли;
	
	//Если РучноеРедактированиеИзображений Тогда 
	//	Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаРучногоРедактирования;
	//Иначе
	//	Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаКонструктораСсылок;
	//КонецЕсли;
	//
	Если Объект.ОписаниеВФорматеHTML = Истина Тогда 
		Элементы.СтраницыОписание.ТекущаяСтраница = Элементы.ГруппаОписаниеHTML;
	Иначе
		Элементы.СтраницыОписание.ТекущаяСтраница = Элементы.ГруппаОписаниеТекст;
	КонецЕсли;
	
	Если НЕ ИспользоватьМультиязычность Тогда 
		Элементы.РедактироватьОписание.Видимость = Ложь;
	КонецЕсли;
	
	ИспользоватьХарактеристики = eCommСервер.НоменклатураИспользуетХарактеристики(Объект.Номенклатура);
	Если НЕ ИспользоватьХарактеристики Тогда 
		Элементы.ХарактеристикаНоменклатуры.Видимость = Ложь;
	КонецЕсли;
	
	eCommСерверПереопределяемый.РеквизитыТовара_УстановитьВидимостьЭлементов(ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура УстановитьПояснениеПомощника()

	ТекстСтроки = "ВНИМАНИЕ!!! Производится редактирование всех интернет-товаров номенклатуры:" + Символы.ПС;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока(ТекстСтроки, Новый Шрифт(,10,Истина)));
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока("" + Номенклатура, Новый Шрифт(,10,Истина,,,), Новый Цвет(0,0,255),, ПолучитьНавигационнуюСсылку(Номенклатура)));
	
	Пояснение = Новый ФорматированнаяСтрока(МассивСтрок);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтрокНаРазныхЯзыках(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Представление Из Результат.ЗначенияНаРазныхЯзыках Цикл
		Отбор = Новый Структура("КодЯзыка", Представление.КодЯзыка);
		НайденныеСтроки = Объект.Представления.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если ПустаяСтрока(Представление.ЗначениеРеквизита) 
				И НЕ ВРЕГ(Результат.ОсновнойЯзык) = ВРЕГ(Представление.КодЯзыка) Тогда
				Объект.Представления.Удалить(НайденныеСтроки[0]);
				Продолжить;
			КонецЕсли;
			СтрокаПредставлений = НайденныеСтроки[0];
		Иначе
			СтрокаПредставлений = Объект.Представления.Добавить();
			СтрокаПредставлений.КодЯзыка = Представление.КодЯзыка;
		КонецЕсли;
		СтрокаПредставлений[ДополнительныеПараметры.ИмяРеквизита] = Представление.ЗначениеРеквизита;
		
	КонецЦикла;
	
	Если Результат.Свойство("СтрокаНаТекущемЯзыке") Тогда
		Объект[ДополнительныеПараметры.ИмяРеквизита] = Результат.СтрокаНаТекущемЯзыке;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ИмяРеквизита = "Описание"
		И Объект.ОписаниеВФорматеHTML Тогда 
		ОписаниеВФорматеHTMLПриИзмененииНаСервере();		
	КонецЕсли;
	
	ЭтаФорма[ДополнительныеПараметры.ИмяРеквизита] = Объект[ДополнительныеПараметры.ИмяРеквизита];
	
	Если ДополнительныеПараметры.ИмяРеквизита = "Наименование" Тогда
		
		ОбщаяЧастьНаименования = Новый Соответствие;
		ОбщаяЧастьНаименования.Вставить(eCommСервер.ВернутьОсновнойЯзык(), Объект.Наименование);
		
		Для Каждого Стр Из Объект.Представления Цикл 
			ОбщаяЧастьНаименования.Вставить(Стр.КодЯзыка, Стр.Наименование);
		КонецЦикла;
		
		ПеренестиОбщуюЧастьНаименованияВДеревоХарактеристик(ОбщаяЧастьНаименования);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗначенияИзСписка(Результат, ИмяРеквизитаСписокЗначений = "") Экспорт

	Если НЕ ТипЗнч(Результат) = Тип("СписокЗначений") 
		ИЛИ ИмяРеквизитаСписокЗначений = "" Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	ЭтаФорма["" + ИмяРеквизитаСписокЗначений + "Строкой"] = ВернутьПредставлениеСпискаЗначений(Результат);	
	ЭтаФорма[ИмяРеквизитаСписокЗначений] = Результат;

КонецПроцедуры

&НаСервере
Функция ВернутьПредставлениеСпискаЗначений(Список)

	СтрокаСостоянияВыбора = "";
	Для Каждого Стр Из Список Цикл 
		Если Стр.Пометка Тогда 
			СтрокаСостоянияВыбора = СтрокаСостоянияВыбора + ?(СтрокаСостоянияВыбора = "", "", "; ") + Стр.Представление;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаСостоянияВыбора = "" Тогда 
		СтрокаСостоянияВыбора = "<не указано>";
	КонецЕсли;
	
	Возврат СтрокаСостоянияВыбора;

КонецФункции

&НаКлиенте
Функция ВернутьСписокНаименований()

	Характеристики = Новый Массив;
	
	СтрокиХарактеристик = ДеревоХарактеристик.ПолучитьЭлементы();
	
	Для Каждого СтрХарактеристики Из СтрокиХарактеристик Цикл
		
		НаименованияХарактеристики = Новый Массив;
		
		СтрокиЛокализаций = СтрХарактеристики.ПолучитьЭлементы();
		
		Для Каждого СтрЛокализации Из СтрокиЛокализаций Цикл 
			НаименованияХарактеристики.Добавить(Новый Структура("КодЯзыка, Наименование, ИнтернетТовар, ПоУмолчанию", СтрЛокализации.КодЯзыка, СтрЛокализации.Наименование, СтрЛокализации.ИнтернетТовар, СтрЛокализации.ПоУмолчанию));
		КонецЦикла;
		
		Характеристики.Добавить(Новый Структура("ХарактеристикаНоменклатуры, НаименованияХарактеристики", СтрХарактеристики.ХарактеристикаНоменклатуры, НаименованияХарактеристики));
	
	КонецЦикла;
	
	Возврат Характеристики;

КонецФункции

&НаСервере
Процедура ОписаниеВФорматеHTMLПриИзмененииНаСервере()

	Если Найти(Объект.Описание, "</html>") = 0 Тогда
		_ОписаниеHTML = "<html>" + Объект.Описание + "</html>";	
	Иначе	
		_ОписаниеHTML = Объект.Описание;	
	КонецЕсли;
	
	ОписаниеHTML.УстановитьHTML(_ОписаниеHTML, Новый Структура);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСписокДополнительныхКатегорий(СписокКатегорий, ДопПараметры = Неопределено) Экспорт

	Если СписокКатегорий = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ПеренестиДопКатегорииВОбъект(СписокКатегорий);
	
	ЗаполнитьПредставлениеДополнительныхКатегорий();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСписокОптовыхЦен(ОптовыеЦены, ДопПараметры) Экспорт

	Если ОптовыеЦены = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ПеренестиОптовыеЦеныВОбъект(ОптовыеЦены);

	ЗаполнитьПредставлениеОптовыхЦен();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСписокМеток(СписокМеток, ТипМетки) Экспорт

	Если СписокМеток = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ПеренестиМеткиВОбъект(СписокМеток, ТипМетки);
	
	ЗаполнитьПредставлениеМеток(ТипМетки);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСписокНаименованийХарактеристик(СписокХарактеристик, Действие = "") Экспорт

	Если СписокХарактеристик = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	КореньДерева = ДеревоХарактеристик.ПолучитьЭлементы();
	КореньДерева.Очистить();
	
	ОбщаяЧастьНаименования = Новый Соответствие;
	
	Для Каждого СтрХарактеристики Из СписокХарактеристик Цикл
		
		СтрокаХарактеристики = КореньДерева.Добавить();
		СтрокаХарактеристики.ХарактеристикаНоменклатуры = СтрХарактеристики.ХарактеристикаНоменклатуры;
		
		СтрокиНаименований = СтрокаХарактеристики.ПолучитьЭлементы();
		
		Для Каждого СтрокаНаименования Из СтрХарактеристики.НаименованияХарактеристики Цикл
			
			ЗаполнитьЗначенияСвойств(СтрокиНаименований.Добавить(), СтрокаНаименования);
			
			Если ОбщаяЧастьНаименования[СтрокаНаименования.КодЯзыка] = Неопределено Тогда 
				ОбщаяЧастьНаименования.Вставить(СтрокаНаименования.КодЯзыка, СтрокаНаименования.Наименование);
			Иначе
				ОбщаяЧастьНаименования.Вставить(СтрокаНаименования.КодЯзыка, ВернутьОбщуюЧастьНаименований(ОбщаяЧастьНаименования[СтрокаНаименования.КодЯзыка], СтрокаНаименования.Наименование));
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПеренестиОбщуюЧастьНаименованияВОбъект(ОбщаяЧастьНаименования);
	
	Если Действие = "Запись" Тогда 
		ЗаписатьНаКлиенте();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеОбновляемыхПолей()

	ОписаниеПолей = "";
	Для Каждого Стр Из ОбновляемыеПоля Цикл 
		ОписаниеПолей = ОписаниеПолей + ?(ОписаниеПолей = "", "", "; ") + Стр.Представление;
	КонецЦикла;
	
	Если ОписаниеПолей = "" Тогда 
		ОписаниеПолей = "<не выбрано>";
	КонецЕсли;
	
	ОбновляемыеПоляСтрокой = ОписаниеПолей;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеДополнительныхКатегорий()

	ОписаниеКатегорий = "";
	Для Каждого Стр Из Объект.ДополнительныеКатегории Цикл 
		ОписаниеКатегорий = ОписаниеКатегорий + ?(ОписаниеКатегорий = "", "", "; ") + Стр.Категория;
	КонецЦикла;
	
	Если ОписаниеКатегорий = "" Тогда 
		ОписаниеКатегорий = "<не выбрано>";
	КонецЕсли;
	
	ДополнительныеКатегорииСтрокой = ОписаниеКатегорий;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеОптовыхЦен()

	ОписаниеОптовыхЦен = "";
	Для Каждого Стр Из Объект.ОптовыеЦены Цикл 
		ОписаниеОптовыхЦен = ОписаниеОптовыхЦен + ?(ОписаниеОптовыхЦен = "", "", "; ") + Стр.ВидЦены + " " + "(от " + Стр.ОптоваяЦенаПриЗаказеОт + ")";
	КонецЦикла;
	
	Если ОписаниеОптовыхЦен = "" Тогда 
		ОписаниеОптовыхЦен = "<не выбрано>";
	КонецЕсли;
	
	ОптовыеЦеныСтрокой = ОписаниеОптовыхЦен;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеМеток(ТипМетки)

	ОписаниеМетки = "";
	Для Каждого Стр Из Объект.Метки Цикл
		Если Стр.ТипМетки = ТипМетки Тогда 
			ОписаниеМетки = ОписаниеМетки + ?(ОписаниеМетки = "", "", "; ") + Стр.Метка;
		КонецЕсли;
	КонецЦикла;
	
	Если ОписаниеМетки = "" Тогда 
		ОписаниеМетки = "<не выбрано>";
	КонецЕсли;
	
	ЭтаФорма["" + ТипМетки + "Строкой"] = ОписаниеМетки;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНаКлиенте()

	Отказ = Ложь;
	ЗаписатьИнтернетТоварыНаСервере(Отказ);
	
	Если Отказ = Ложь Тогда 
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьИнтернетТоварыНаСервере(Отказ)
	
	ОсновнойЯзык = eCommСервер.ВернутьОсновнойЯзык();
	
	СтрокиХарактеристик = ДеревоХарактеристик.ПолучитьЭлементы();
	
	Отказ = Ложь;
	
	НачатьТранзакцию();
	
	Попытка
		
		Для Каждого СтрХарактеристики Из СтрокиХарактеристик Цикл 
			
			ИнтернетТовар = ИнтернетТовар(Объект.Владелец, Объект.Номенклатура, СтрХарактеристики.ХарактеристикаНоменклатуры);
			Если ЗначениеЗаполнено(ИнтернетТовар) Тогда 
				ИнтернетТоварОбъект = ИнтернетТовар.ПолучитьОбъект();
			Иначе
				ИнтернетТоварОбъект = Справочники.eComm_ИнтернетТовары.СоздатьЭлемент();
				ИнтернетТоварОбъект.Владелец					= Объект.Владелец;
				ИнтернетТоварОбъект.Номенклатура				= Объект.Номенклатура;
				ИнтернетТоварОбъект.ХарактеристикаНоменклатуры 	= СтрХарактеристики.ХарактеристикаНоменклатуры;
			КонецЕсли;
			
			Для Каждого ЭлементСписка Из ОбновляемыеПоля Цикл 
				
				Если НЕ ЭлементСписка.Пометка = Истина Тогда 
					Продолжить;
				КонецЕсли;
				
				Если ЭлементСписка.Значение = "Наименование" Тогда 
					// Наименование и представления на разных языках
					
					СтрокиЛокализаций = СтрХарактеристики.ПолучитьЭлементы();
					
					Для Каждого СтрЛокализации Из СтрокиЛокализаций Цикл
						
						Если СтрЛокализации.КодЯзыка = ОсновнойЯзык Тогда 
							
							ИнтернетТоварОбъект.Наименование = СтрЛокализации.Наименование;
							
						Иначе
							
							СтрокиПредставлений = ИнтернетТоварОбъект.Представления.НайтиСтроки(Новый Структура("КодЯзыка", СтрЛокализации.КодЯзыка));
							Если СтрокиПредставлений.Количество() > 0 Тогда 
								СтрокаПредставления = СтрокиПредставлений[0];
							Иначе
								СтрокаПредставления = ИнтернетТоварОбъект.Представления.Добавить();
								СтрокаПредставления.КодЯзыка = СтрЛокализации.КодЯзыка;
							КонецЕсли;  
							СтрокаПредставления.Наименование = СтрЛокализации.Наименование;
							
						КонецЕсли;
						
					КонецЦикла;
					
				ИначеЕсли ЭлементСписка.Значение = "Описание" Тогда
					// Описание и представления на разных языках
					
					ЗаполнитьЗначенияСвойств(ИнтернетТоварОбъект, Объект, "Описание, ОписаниеВФорматеHTML");
					
					Для Каждого Стр Из Объект.Представления Цикл 
						СтрокиПредставлений = ИнтернетТоварОбъект.Представления.НайтиСтроки(Новый Структура("КодЯзыка", Стр.КодЯзыка));
						Если СтрокиПредставлений.Количество() > 0 Тогда 
							СтрокаПредставления = СтрокиПредставлений[0];
						Иначе
							СтрокаПредставления = ИнтернетТоварОбъект.Представления.Добавить();
							СтрокаПредставления.КодЯзыка = Стр.КодЯзыка;
						КонецЕсли;  
						СтрокаПредставления.Описание = Стр.Описание;
						
					КонецЦикла;
					
				ИначеЕсли ЭлементСписка.Значение = "КлючевыеСлова" Тогда
					// Описание и представления на разных языках
					
					ЗаполнитьЗначенияСвойств(ИнтернетТоварОбъект, Объект, "КлючевыеСлова");
					
					Для Каждого Стр Из Объект.Представления Цикл 
						СтрокиПредставлений = ИнтернетТоварОбъект.Представления.НайтиСтроки(Новый Структура("КодЯзыка", Стр.КодЯзыка));
						Если СтрокиПредставлений.Количество() > 0 Тогда 
							СтрокаПредставления = СтрокиПредставлений[0];
						Иначе
							СтрокаПредставления = ИнтернетТоварОбъект.Представления.Добавить();
							СтрокаПредставления.КодЯзыка = Стр.КодЯзыка;
						КонецЕсли;  
						СтрокаПредставления.КлючевыеСлова = Стр.КлючевыеСлова;
						
					КонецЦикла;
					
				ИначеЕсли ЭлементСписка.Значение = "ДополнительныеКатегории" Тогда 
					// Дополнительные категории
					
					ИнтернетТоварОбъект.ДополнительныеКатегории.Очистить();    
					Для Каждого Стр Из Объект.ДополнительныеКатегории Цикл 
						ДопКатегория = ИнтернетТоварОбъект.ДополнительныеКатегории.Добавить();
						ДопКатегория.Категория = Стр.Категория;
					КонецЦикла;
					
				ИначеЕсли ЭлементСписка.Значение = "ОптовыеЦены" Тогда 
					// Метки
					
					ИнтернетТоварОбъект.ОптовыеЦены.Очистить();    
					Для Каждого Стр Из Объект.ОптовыеЦены Цикл 
						СтрокаЦены = ИнтернетТоварОбъект.ОптовыеЦены.Добавить();
						СтрокаЦены.ВидЦены = Стр.ВидЦены;
						СтрокаЦены.ОптоваяЦенаПриЗаказеОт = Стр.ОптоваяЦенаПриЗаказеОт;
					КонецЦикла;
					
				ИначеЕсли ЭлементСписка.Значение = "Метки" Тогда 
					// Метки
					
					ИнтернетТоварОбъект.Метки.Очистить();    
					Для Каждого Стр Из Объект.Метки Цикл 
						СтрокаМетки = ИнтернетТоварОбъект.Метки.Добавить();
						СтрокаМетки.Метка = Стр.Метка;
					КонецЦикла;
	
				Иначе
					// Другие реквизиты
					
					ИнтернетТоварОбъект[ЭлементСписка.Значение] = Объект[ЭлементСписка.Значение];
					
				КонецЕсли;
				
			КонецЦикла;
			
			ПередЗаписьюНаСервере(Ложь, ИнтернетТоварОбъект, Новый Структура);
			ИнтернетТоварОбъект.Записать();
			
		КонецЦикла;
		
	Исключение
		
		Отказ = Истина;
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки;
	
	Если НЕ Отказ Тогда 
		ЗафиксироватьТранзакцию();
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
	
	ПослеЗаписиНаСервере(Объект, Новый Структура);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначениеРеквизитаОбъекта(ИнтернетТоварОбъект, ИмяРеквизита, Обновлять)

	Если НЕ Обновлять = Истина Тогда 
		Возврат;
	КонецЕсли;
	
	Если ИмяРеквизита = "Наименование" Тогда 
		// Обработаем исключение
		
	ИначеЕсли ИмяРеквизита = "ДополнительныеКатегории" Тогда 
		// Обработаем исключение
		ИнтернетТоварОбъект[ИмяРеквизита].Очистить();
		Для Каждого СтрокаДопКатегории Из Объект.ДополнительныеКатегории Цикл 
			НовСтр = ИнтернетТоварОбъект[ИмяРеквизита].Добавить();
			НовСтр.Категория = СтрокаДопКатегории.Категория;
		КонецЦикла;
	Иначе
		// Штатный сценарий
		ИнтернетТоварОбъект[ИмяРеквизита] = Объект[ИмяРеквизита];
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВернутьОбщуюЧастьНаименований(ОбщаяЧастьНачальная, СравниваемоеНаименование)

	ДлинаОбщейЧасти 			= СтрДлина(ОбщаяЧастьНачальная);
	ДлинаСравнивНаименования 	= СтрДлина(СравниваемоеНаименование);
	
	ОграничениеДлиныОбщейЧасти = Мин(ДлинаОбщейЧасти, ДлинаСравнивНаименования);
	
	ОбщаяЧастьИтоговая = "";
	
	Для Сч = 1 По ОграничениеДлиныОбщейЧасти Цикл 
		
		Символ = Сред(ОбщаяЧастьНачальная, Сч, 1);
		Если Символ = Сред(СравниваемоеНаименование, Сч, 1) Тогда 
			ОбщаяЧастьИтоговая = ОбщаяЧастьИтоговая + Символ;
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбщаяЧастьИтоговая;

КонецФункции

&НаСервере
Процедура ПеренестиОбщуюЧастьНаименованияВОбъект(ОбщаяЧастьНаименования)

	ОсновнойЯзык = eCommСервер.ВернутьОсновнойЯзык();
	
	Для Каждого КлючЗначение Из ОбщаяЧастьНаименования Цикл 
		
		Если КлючЗначение.Ключ = ОсновнойЯзык Тогда 
			Наименование 		= КлючЗначение.Значение;
			Объект.Наименование = КлючЗначение.Значение;
		Иначе
			СтрокиПредставлений = Представления.НайтиСтроки(Новый Структура("КодЯзыка", КлючЗначение.Ключ));
			Если СтрокиПредставлений.Количество() > 0 Тогда 
				СтрокаПредставления = СтрокиПредставлений[0];
			Иначе
				СтрокаПредставления = Представления.Добавить();
				СтрокаПредставления.КодЯзыка = КлючЗначение.Ключ;
			КонецЕсли;  
			СтрокаПредставления.Наименование = КлючЗначение.Значение;
			
			СтрокиПредставлений = Объект.Представления.НайтиСтроки(Новый Структура("КодЯзыка", КлючЗначение.Ключ));
			Если СтрокиПредставлений.Количество() > 0 Тогда 
				СтрокаПредставления = СтрокиПредставлений[0];
			Иначе
				СтрокаПредставления = Объект.Представления.Добавить();
				СтрокаПредставления.КодЯзыка = КлючЗначение.Ключ;
			КонецЕсли;  
			СтрокаПредставления.Наименование = КлючЗначение.Значение;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПеренестиДопКатегорииВОбъект(СписокКатегорий)

	Объект.ДополнительныеКатегории.Очистить();
	
	Для Каждого СтруктураКатегории Из СписокКатегорий Цикл 
		ЗаполнитьЗначенияСвойств(Объект.ДополнительныеКатегории.Добавить(), СтруктураКатегории);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПеренестиОптовыеЦеныВОбъект(СписокЦен)

	Объект.ОптовыеЦены.Очистить();
	
	Для Каждого СтруктураЦены Из СписокЦен Цикл 
		ЗаполнитьЗначенияСвойств(Объект.ОптовыеЦены.Добавить(), СтруктураЦены);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПеренестиМеткиВОбъект(СписокМеток, ТипМетки)

	КоличествоСтрок = Объект.Метки.Количество()-1;
    ИндексСтроки = КоличествоСтрок;
	
	Для Сч = 0 По КоличествоСтрок Цикл
        Стр = Объект.Метки.Получить(ИндексСтроки);
        Если Стр.ТипМетки = ТипМетки Тогда
                Объект.Метки.Удалить(Стр);
        КонецЕсли;
        ИндексСтроки = ИндексСтроки - 1;
    КонецЦикла;
	
	Для Каждого СтруктураМетки Из СписокМеток Цикл 
		ЗаполнитьЗначенияСвойств(Объект.Метки.Добавить(), СтруктураМетки);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПеренестиОбщуюЧастьНаименованияВДеревоХарактеристик(НоваяОбщаяЧастьНаименования)

	ОбщаяЧастьНаименования = Новый Соответствие;
	
	СтрокиХарактеристик = ДеревоХарактеристик.ПолучитьЭлементы();
	
	Для Каждого СтрХарактеристики Из СтрокиХарактеристик Цикл
		
		СтрокиЛокализаций = СтрХарактеристики.ПолучитьЭлементы();
		
		Для Каждого СтрЛокализации Из СтрокиЛокализаций Цикл
			
			Если ОбщаяЧастьНаименования[СтрЛокализации.КодЯзыка] = Неопределено Тогда 
				ОбщаяЧастьНаименования.Вставить(СтрЛокализации.КодЯзыка, СтрЛокализации.Наименование);
			Иначе
				ОбщаяЧастьНаименования.Вставить(СтрЛокализации.КодЯзыка, ВернутьОбщуюЧастьНаименований(ОбщаяЧастьНаименования[СтрЛокализации.КодЯзыка], СтрЛокализации.Наименование));
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	
	СтрокиХарактеристик = ДеревоХарактеристик.ПолучитьЭлементы();
	
	Для Каждого СтрХарактеристики Из СтрокиХарактеристик Цикл
		
		СтрокиЛокализаций = СтрХарактеристики.ПолучитьЭлементы();
		
		Для Каждого СтрЛокализации Из СтрокиЛокализаций Цикл
			
			ДлинаОбщейЧастиНаименования = СтрДлина(ОбщаяЧастьНаименования[СтрЛокализации.КодЯзыка]);
			
			СтрЛокализации.Наименование = "" + НоваяОбщаяЧастьНаименования[СтрЛокализации.КодЯзыка] + Сред(СтрЛокализации.Наименование, ДлинаОбщейЧастиНаименования + 1);
			
		КонецЦикла;
	
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнтернетТовар(УчетнаяЗапись, Номенклатура, Характеристика)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ИнтернетТовары.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|ГДЕ
		|	eComm_ИнтернетТовары.Владелец = &Владелец
		|	И eComm_ИнтернетТовары.Номенклатура = &Номенклатура
		|	И eComm_ИнтернетТовары.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры";
	
	Запрос.УстановитьПараметр("Владелец"					, УчетнаяЗапись);
	Запрос.УстановитьПараметр("Номенклатура"				, Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры"	, Характеристика);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат РезультатЗапроса.Ссылка;
	КонецЕсли;
	
КонецФункции












