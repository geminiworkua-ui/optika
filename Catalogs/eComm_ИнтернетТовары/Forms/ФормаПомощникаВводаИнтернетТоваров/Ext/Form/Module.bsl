&НаКлиенте
Процедура ДополнительныеКатегорииСтрокойНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьСписокДополнительныхКатегорий", ЭтаФорма);
	
	ФормаДополнительныеКатегории = Новый Массив;
	Для Каждого Стр Из Объект.ДополнительныеКатегории Цикл 
		ФормаДополнительныеКатегории.Добавить(Новый Структура("Категория", Стр.Категория));
	КонецЦикла;
	
	ПараметрыОткрытия = Новый Структура("УчетнаяЗапись, ДополнительныеКатегории", Объект.Владелец, ФормаДополнительныеКатегории);
	ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаДополнительныхКатегорий", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеВФорматеHTMLПриИзменении(Элемент)
	
	РеквизитФормыПриИзменении(Элемент);
	
	УстановитьВидимостьЭлементов();
	
	ОписаниеВФорматеHTMLПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьНаименование(Команда)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьСписокНаименованийХарактеристик", ЭтаФорма);
	
	ПараметрыОткрытия = Новый Структура("ДеревоНаименований, ИспользоватьМультиязычность", ВернутьСписокНаименований(), ИспользоватьМультиязычность);
	ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаРедактированияНаименований", ПараметрыОткрытия, ЭтаФорма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьОписание(Команда)
	
	Подключаемый_Открытие(Элементы.Описание, Истина);	
	
КонецПроцедуры

&НаКлиенте
Процедура МеткаСтрокойНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяЭлемента = Элемент.Имя;
	
	ТипМетки = ПредопределенноеЗначение("Перечисление.eComm_ТипыМеток." + СтрЗаменить(ИмяЭлемента, "Строкой", ""));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьСписокМеток", ЭтаФорма, ТипМетки);
	
	СписокМеток = Новый Массив;
	Для Каждого Стр Из Объект.Метки Цикл
		
		Если НЕ Стр.ТипМетки = ТипМетки Тогда 
			Продолжить;
		КонецЕсли;
		
		СписокМеток.Добавить(Новый Структура("Метка, ТипМетки", Стр.Метка, Стр.ТипМетки));
		
	КонецЦикла;
	
	ПараметрыОткрытия = Новый Структура("Метки, ТипМетки", СписокМеток, ТипМетки);
	ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаРедактированияМеток", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОптовыеЦеныСтрокойНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьСписокОптовыхЦен", ЭтаФорма);
	
	СписокОптовыхЦен = Новый Массив;
	Для Каждого Стр Из Объект.ОптовыеЦены Цикл
		
		СписокОптовыхЦен.Добавить(Новый Структура("ВидЦены, ОптоваяЦенаПриЗаказеОт", Стр.ВидЦены, Стр.ОптоваяЦенаПриЗаказеОт));
		
	КонецЦикла;
	
	ПараметрыОткрытия = Новый Структура("ОптовыеЦены, УчетнаяЗапись", СписокОптовыхЦен, Объект.Владелец);
	ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаРедактированияОптовыхЦен", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Открытие(Элемент, СтандартнаяОбработка)   
	
	МодульМультиязычность = Вычислить("МультиязычностьКлиент");
	Если МодульМультиязычность = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ПутьКДанным = ЭтотОбъект.ПараметрыМультиязычныхРеквизитов[Элемент.Имя];
	ИмяРеквизита = СтрЗаменить(ПутьКДанным, "Объект.", "");
	
	ИмяЭлемента = Элемент.Имя;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ссылка",          Объект.Ссылка);
	ПараметрыФормы.Вставить("ИмяРеквизита",    ИмяРеквизита);
	ПараметрыФормы.Вставить("ТекущиеЗначение", Элемент.ТекстРедактирования);
	ПараметрыФормы.Вставить("ТолькоПросмотр",  Элемент.ТолькоПросмотр);
	ПараметрыФормы.Вставить("Представления"	, Объект.Представления);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяРеквизита", ИмяРеквизита);
	
	Если Элемент.Имя = "Описание"
		И Объект.ОписаниеВФорматеHTML = Истина Тогда 
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаСтрокНаРазныхЯзыках", ЭтаФорма, ДополнительныеПараметры);
		ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаРедактированияОписания", ПараметрыФормы,,,,, Оповещение);
		
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаСтрокНаРазныхЯзыках", ЭтаФорма, ДополнительныеПараметры);
		ОткрытьФорму("ОбщаяФорма.ВводНаРазныхЯзыках", ПараметрыФормы,,,,, Оповещение);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОписаниеHTMLПриИзменении(Элемент)
	
	Если Объект.ОписаниеВФорматеHTML Тогда 
		Если НЕ ОписаниеHTML.ПолучитьТекст() = "" Тогда 
			ОписаниеHTML.ПолучитьHTML(Объект.Описание, Новый Структура);
		Иначе
			Объект.Описание = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитФормыПриИзменении(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	Объект[ИмяЭлемента] = ЭтаФорма[ИмяЭлемента];
	
	Если ИмяЭлемента = "Наименование" Тогда
		
		ОбщаяЧастьНаименования = Новый Соответствие;
		ОбщаяЧастьНаименования.Вставить(eCommСервер.ВернутьОсновнойЯзык(), Объект.Наименование);
		
		Для Каждого Стр Из Объект.Представления Цикл 
			ОбщаяЧастьНаименования.Вставить(Стр.КодЯзыка, Стр.Наименование);
		КонецЦикла;
		
		ПеренестиОбщуюЧастьНаименованияВДеревоХарактеристик(ОбщаяЧастьНаименования);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИнтернетТовары(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	Если ОбновляемыеПоля.НайтиПоЗначению("Наименование").Пометка = Истина Тогда 
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьСписокНаименованийХарактеристик", ЭтаФорма, "Запись");
		
		ПараметрыОткрытия = Новый Структура("ДеревоНаименований, ИспользоватьМультиязычность, Действие", ВернутьСписокНаименований(), ИспользоватьМультиязычность, "Запись");
		ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаРедактированияНаименований", ПараметрыОткрытия, ЭтаФорма, ,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		ЗаписатьНаКлиенте();
		
	КонецЕсли;
	
КонецПроцедуры

