
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если НЕ ЗначениеЗаполнено(ПараметрКоманды) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользуетсяТолькоОднаУчетнаяЗапись() Тогда
		
		Отказ = Ложь;
		
		СтруктураТовара = ВернутьИнтернетТовар(ПараметрКоманды, Отказ);
		
		Если Отказ = Истина Тогда
			
			ПараметрыФормы = Новый Структура("Отбор, ИспользоватьХарактеристики", Новый Структура("Номенклатура", СтруктураТовара.Номенклатура), СтруктураТовара.ИспользоватьХарактеристики);
			ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);

			//ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаПомощникаВводаИнтернетТоваров", Новый Структура("Номенклатура, Владелец", ПараметрКоманды, eCommСервер.ВернутьЕдинственнуюУчетнуюЗапись()), ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка); 
			//Сообщить("Редактирование интернет-товаров номенклатуры с характеристиками производится из формы характеристики!!!");
			Возврат;
			
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("Ключ", СтруктураТовара.ИнтернетТовар);
		
		Если НЕ ЗначениеЗаполнено(СтруктураТовара.ИнтернетТовар) Тогда 
			ПараметрыЗаполнения = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Владелец", СтруктураТовара.Номенклатура, СтруктураТовара.ХарактеристикаНоменклатуры, eCommСервер.ВернутьЕдинственнуюУчетнуюЗапись());
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ПараметрыЗаполнения);
		КонецЕсли;
		
		ОткрытьФорму("Справочник.eComm_ИнтернетТовары.ФормаОбъекта", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка); 
		
	Иначе
		
		ИспользоватьХарактеристики = Ложь;
		
		СтруктураТовара = ВернутьПараметрыОтбора(ПараметрКоманды, ИспользоватьХарактеристики);
		
		Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда 
			// Открываем список интернет-товаров одной характеристики, но разных учетных записей
			Отбор = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", СтруктураТовара.Номенклатура, СтруктураТовара.ХарактеристикаНоменклатуры); 
			ПараметрыФормы = Новый Структура("Отбор", Отбор);
		Иначе
			// Открываем список интернет-товаров всех характеристик всех учетных записей этой номенклатуры
			Отбор = Новый Структура("Номенклатура", СтруктураТовара.Номенклатура);
			ПараметрыФормы = Новый Структура("Отбор, ИспользоватьХарактеристики", Отбор, ИспользоватьХарактеристики);
		КонецЕсли;
		
		ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ИспользуетсяТолькоОднаУчетнаяЗапись()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи КАК УчетныеЗаписи
		|ГДЕ
		|	УчетныеЗаписи.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Возврат РезультатЗапроса.Количество() = 1;
	
КонецФункции

&НаСервере
Функция ВернутьИнтернетТовар(ПараметрКоманды, Отказ)

	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.Номенклатура") Тогда 
		//Должен быть товар без характеристик
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|				И Номенклатура.#ИспользоватьХарактеристики#
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ КАК ХарактеристикаНоменклатуры,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|				И Номенклатура.#ИспользоватьХарактеристики#
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ИспользоватьХарактеристики
			|ПОМЕСТИТЬ ВрТабНоменклатураХарактеристика
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Ссылка = &ПараметрКоманды
			|;";
		
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда 
		// Должна быть номенклатура с характеристиками
		
		ТекстЗапроса = "ВЫБРАТЬ
			|	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|				И Номенклатура.#ИспользоватьХарактеристики#
			|			ТОГДА &ПараметрКоманды
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ КАК ХарактеристикаНоменклатуры,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|				И Номенклатура.#ИспользоватьХарактеристики#
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ИспользоватьХарактеристики
			|ПОМЕСТИТЬ ВрТабНоменклатураХарактеристика
			|ИЗ
			|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			|		ПО ХарактеристикиНоменклатуры.Владелец = Номенклатура.Ссылка
			|ГДЕ
			|	ХарактеристикиНоменклатуры.Ссылка = &ПараметрКоманды
			|;";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИспользоватьХарактеристики#", eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "ИспользоватьХарактеристики"));
	ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ
		|	ИнтернетТовары.Ссылка
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК ИнтернетТовары
		|ГДЕ
		|	(ИнтернетТовары.Номенклатура, ИнтернетТовары.ХарактеристикаНоменклатуры) В
		|			(ВЫБРАТЬ
		|				ВрТабНоменклатураХарактеристика.Номенклатура,
		|				ВрТабНоменклатураХарактеристика.ХарактеристикаНоменклатуры
		|			ИЗ
		|				ВрТабНоменклатураХарактеристика КАК ВрТабНоменклатураХарактеристика)
		|	И ИнтернетТовары.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабНоменклатураХарактеристика.Номенклатура,
		|	ВрТабНоменклатураХарактеристика.ХарактеристикаНоменклатуры,
		|	ВрТабНоменклатураХарактеристика.ИспользоватьХарактеристики
		|ИЗ
		|	ВрТабНоменклатураХарактеристика КАК ВрТабНоменклатураХарактеристика";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПараметрКоманды"				, ПараметрКоманды);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики"	, eCommСервер.ВключеноИспользованиеХарактеристик());

	МассивРезультатов 		= Запрос.ВыполнитьПакет();
	ИнтернетТоварВыборка 	= МассивРезультатов[1].Выбрать();
	НоменклХарактВыборка 	= МассивРезультатов[2].Выбрать();
	
	СтруктураНоменклатуры = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, ИнтернетТовар, ИспользоватьХарактеристики");
	
	Если ИнтернетТоварВыборка.Следующий() Тогда 
		СтруктураНоменклатуры.Вставить("ИнтернетТовар", ИнтернетТоварВыборка.Ссылка);
	Иначе
		СтруктураНоменклатуры.Вставить("ИнтернетТовар", Справочники.eComm_ИнтернетТовары.ПустаяСсылка());
	КонецЕсли;
	
	Если НоменклХарактВыборка.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(СтруктураНоменклатуры, НоменклХарактВыборка);
		Если НоменклХарактВыборка.ИспользоватьХарактеристики = Истина
			И НЕ ЗначениеЗаполнено(НоменклХарактВыборка.ХарактеристикаНоменклатуры) Тогда 
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураНоменклатуры;

КонецФункции

Функция ВернутьПараметрыОтбора(ПараметрКоманды, ИспользоватьХарактеристики)

	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.Номенклатура") Тогда 
		//Должен быть товар без характеристик
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|				И Номенклатура.#ИспользоватьХарактеристики#
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ КАК ХарактеристикаНоменклатуры,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|				И Номенклатура.#ИспользоватьХарактеристики#
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ИспользоватьХарактеристики
			//|ПОМЕСТИТЬ ВрТабНоменклатураХарактеристика
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Ссылка = &ПараметрКоманды
			|;";
		
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда 
		// Должна быть номенклатура с характеристиками
		
		ТекстЗапроса = "ВЫБРАТЬ
			|	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|				И Номенклатура.#ИспользоватьХарактеристики#
			|			ТОГДА &ПараметрКоманды
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ КАК ХарактеристикаНоменклатуры,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|				И Номенклатура.#ИспользоватьХарактеристики#
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ИспользоватьХарактеристики
			//|ПОМЕСТИТЬ ВрТабНоменклатураХарактеристика
			|ИЗ
			|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			|		ПО ХарактеристикиНоменклатуры.Владелец = Номенклатура.Ссылка
			|ГДЕ
			|	ХарактеристикиНоменклатуры.Ссылка = &ПараметрКоманды
			|;";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИспользоватьХарактеристики#", eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "ИспользоватьХарактеристики"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПараметрКоманды"				, ПараметрКоманды);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики"	, eCommСервер.ВключеноИспользованиеХарактеристик());
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		
		ИспользоватьХарактеристики = РезультатЗапроса.ИспользоватьХарактеристики;
		
		Возврат Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", РезультатЗапроса.Номенклатура, РезультатЗапроса.ХарактеристикаНоменклатуры);
		
	КонецЕсли;
	
КонецФункции
