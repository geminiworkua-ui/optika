
Процедура ПередЗаписью(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА &ИспользоватьХарактеристики
		|				И Номенклатура.#ИспользоватьХарактеристики#
		|			ТОГДА &Характеристика
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|	КОНЕЦ КАК ХарактеристикаНоменклатуры
		|ПОМЕСТИТЬ ВрТабНоменклатураХарактеристика
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИнтернетТовары.Ссылка,
		|	ИнтернетТовары.Код
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК ИнтернетТовары
		|ГДЕ
		|	ИнтернетТовары.Владелец = &Владелец
		|	И НЕ ИнтернетТовары.Ссылка = &Ссылка
		|	И (ИнтернетТовары.Номенклатура, ИнтернетТовары.ХарактеристикаНоменклатуры) В
		|			(ВЫБРАТЬ
		|				ВрТабНоменклатураХарактеристика.Номенклатура,
		|				ВрТабНоменклатураХарактеристика.ХарактеристикаНоменклатуры
		|			ИЗ
		|				ВрТабНоменклатураХарактеристика КАК ВрТабНоменклатураХарактеристика)
		|	И ИнтернетТовары.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИспользоватьХарактеристики#", eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "ИспользоватьХарактеристики"));
	
	Запрос.УстановитьПараметр("Владелец"		, Владелец); 
	Запрос.УстановитьПараметр("Номенклатура"	, Номенклатура);
	Запрос.УстановитьПараметр("Характеристика"	, ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("Ссылка"			, Ссылка);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики", eCommСервер.ВключеноИспользованиеХарактеристик());
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Отказ = Истина;
		Сообщить("По учетной записи """ + Владелец + """ для номенклатуры """ + Номенклатура + """ (" + ХарактеристикаНоменклатуры + ") интернет-товар уже создан: """ + РезультатЗапроса.Ссылка + """ (" + РезультатЗапроса.Код + ")!!! Дублирование запрещено");
	КонецЕсли;
	
	Если НЕ Отказ
		И НЕ ДополнительныеСвойства.Свойство("ПереводПроизведен") Тогда     // свойство "ПереводПроизведен" добавляется в момент перевода помощником
		ПеревестиПредставления();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЧтенииПредставленийНаСервере() Экспорт
	
	МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
	Если НЕ МодульМультиязычность = Неопределено Тогда 
		МодульМультиязычность.ПриЧтенииПредставленийНаСервере(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеревестиПредставления()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_УчетныеЗаписи.Ссылка КАК Ссылка,
		|	eComm_УчетныеЗаписи.ИспользоватьМультиязычность КАК ИспользоватьМультиязычность,
		|	eComm_УчетныеЗаписи.ВариантИспользованияПереводчика КАК ВариантИспользованияПереводчика
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи КАК eComm_УчетныеЗаписи
		|ГДЕ
		|	eComm_УчетныеЗаписи.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Владелец);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий()
		И РезультатЗапроса.ИспользоватьМультиязычность = Истина Тогда 
		
		Если (РезультатЗапроса.ВариантИспользованияПереводчика = 1 
			ИЛИ РезультатЗапроса.ВариантИспользованияПереводчика = 2) Тогда 
			
			Настройки 		= eCommСервер.Настройки(Владелец);
			ПереводСервис 	= eCommСервер.ВернутьЗначениеНастройки(Настройки, "ВыгрузкаТоваров", "ПереводСервис");
			
			
			Если НЕ ЗначениеЗаполнено(ПереводСервис) Тогда
				Сообщить("Сервис перевода не указан в настройках!!!");
				Возврат;
			КонецЕсли;
			
			Если РезультатЗапроса.ВариантИспользованияПереводчика = 2 Тогда 
				СтруктураСохраненныхРеквизитов = РеквизитыСохраненные();
			КонецЕсли;
			
			ОсновнойЯзык 		= eCommСервер.ВернутьОсновнойЯзык();
			ЯзыкиКонфигурации 	= eCommСервер.ВернутьЯзыкиКонфигурации();
			
			Для Каждого Язык Из ЯзыкиКонфигурации Цикл 
				
				Если Язык = ОсновнойЯзык Тогда
					Продолжить;
				КонецЕсли;
				
				ЯзыкС 	= ОсновнойЯзык;
				ЯзыкНа 	= Язык;
				
				Представления_Строки = Представления.НайтиСтроки(Новый Структура("КодЯзыка", ЯзыкНа));
				Если ЗначениеЗаполнено(Представления_Строки) Тогда
					Представления_Строка = Представления_Строки[0];
				Иначе
					Представления_Строка = Представления.Добавить();
					Представления_Строка.КодЯзыка = ЯзыкНа;
				КонецЕсли;
				
				ИнтернетТоварыМетаданные = Метаданные.Справочники.eComm_ИнтернетТовары;
				
				Для Каждого Реквизит Из ИнтернетТоварыМетаданные.ТабличныеЧасти.Представления.Реквизиты Цикл
					
					Если Реквизит.Имя = "КодЯзыка" Тогда
						Продолжить;
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(ЭтотОбъект[Реквизит.Имя]) Тогда
						Продолжить;
					КонецЕсли;
					
					ЭтоHTML = (Реквизит.Имя = "Описание") И ЭтотОбъект.ОписаниеВФорматеHTML;
					
					Если (РезультатЗапроса.ВариантИспользованияПереводчика = 1 И НЕ ЗначениеЗаполнено(Представления_Строка[Реквизит.Имя]))
						ИЛИ (РезультатЗапроса.ВариантИспользованияПереводчика = 2 И НЕ ЭтотОбъект[Реквизит.Имя] = СтруктураСохраненныхРеквизитов[Реквизит.Имя]) Тогда
						
						Если eCommСервер.ПроизводитьПереводРеквизита(Настройки, Реквизит.Имя) = Истина Тогда 
							Представления_Строка[Реквизит.Имя] = Обработки[Настройки.Менеджер].Перевести(Настройки, ЯзыкС, ЯзыкНа, ЭтотОбъект[Реквизит.Имя], ЭтоHTML);
						КонецЕсли;
						
					КонецЕсли;
			
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция РеквизитыСохраненные()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ИнтернетТовары.Наименование КАК Наименование,
		|	eComm_ИнтернетТовары.Описание КАК Описание,
		|	eComm_ИнтернетТовары.КлючевыеСлова КАК КлючевыеСлова,
		|	eComm_ИнтернетТовары.seo_Наименование КАК seo_Наименование,
		|	eComm_ИнтернетТовары.seo_Описание КАК seo_Описание,
		|	eComm_ИнтернетТовары.seo_h1_Заголовок КАК seo_h1_Заголовок
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|ГДЕ
		|	eComm_ИнтернетТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	СтруктураРеквизитов = Новый Структура("Наименование, Описание, КлючевыеСлова, seo_Наименование, seo_Описание, seo_h1_Заголовок");
	Если РезультатЗапроса.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, РезультатЗапроса);
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;

КонецФункции
