			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникФизическиеЛица.Ссылка,
	СправочникФизическиеЛица.ПометкаУдаления,
	СправочникФизическиеЛица.Родитель,
	СправочникФизическиеЛица.ЭтоГруппа,
	СправочникФизическиеЛица.Наименование,
	СправочникФизическиеЛица.ДатаРождения,
	СправочникФизическиеЛица.Пол,
	СправочникФизическиеЛица.ГруппаДоступа,
	СправочникФизическиеЛица.Уточнение,
	СправочникФизическиеЛица.КодПоДРФО,
	СправочникФизическиеЛица.Подразделение,
	СправочникФизическиеЛица.КонтактнаяИнформация.(
		Ссылка,
		НомерСтроки,
		Тип,
		Вид,
		Представление,
		ЗначенияПолей,
		Страна,
		Регион,
		Город,
		АдресЭП,
		ДоменноеИмяСервера,
		НомерТелефона,
		НомерТелефонаБезКодов,
		ВидДляСписка
	),
	СправочникФизическиеЛица.ДополнительныеРеквизиты.(
		Ссылка,
		НомерСтроки,
		Свойство,
		Значение,
		ТекстоваяСтрока
	),
	СправочникФизическиеЛица.Предопределенный,
	СправочникФизическиеЛица.ИмяПредопределенныхДанных,
	СрокиДействияСертификатов.СрокДействия
ИЗ
	Справочник.ФизическиеЛица КАК СправочникФизическиеЛица
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ДокументыФизическихЛицСрезПоследних.Физлицо КАК Физлицо,
			ДокументыФизическихЛицСрезПоследних.СрокДействия КАК СрокДействия
		ИЗ
			РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(, ВидДокумента.Наименование = "Сертифікат лікаря/оптометриста") КАК ДокументыФизическихЛицСрезПоследних) КАК СрокиДействияСертификатов
		ПО СправочникФизическиеЛица.Ссылка = СрокиДействияСертификатов.Физлицо.Ссылка</QueryText>
				<MainTable>Catalog.ФизическиеЛица</MainTable>
