
&НаКлиенте
Процедура СтатусВыполненияПриИзменении(Элемент)
	
	Если Объект.ДатаВыполнения < Дата(2024,01,01) 
		И Объект.СтатусВыполнения = ПредопределенноеЗначение("Перечисление.СтатусВыполнения.ЗадачаВыполнена")
		ТОгда Объект.ДатаВыполнения = Текущаядата();
	КонецЕсли;
	
	ПроверитьЗваполнитьИсполнителя();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗваполнитьИсполнителя()
	
	Если Не ЗначениеЗаполнено(ОБъект.Исполнитель) 
		Тогда
		ОБъект.Исполнитель = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
КонецПроцедуры	 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.ДатаНачала < Дата(2024,01,01) 
		ТОгда Объект.ДатаНачала = Текущаядата();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Автор) Тогда
		ОБъект.Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Если НЕ РольДоступна("ПолныеПрава")
		Тогда
		Элементы.Группа9.ТолькоПросмотр = Истина;
		Элементы.Согласовано.ТолькоПросмотр = Истина; 
	//	Элементы.ЗатраченноеВремя.Видимость = Ложь;
	КонецЕсли;
	
	//Комментарии.Параметры.УстановитьЗначениеПараметра("Обращение", ОБъект.Ссылка);
	//Комментарии.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	
	Если
		Строка(ПараметрыСеанса.ТекущийПользователь.ИдентификаторПользователяИБ) = "4b7558c8-a342-4bf8-bac5-767dfd67e47d"
		Тогда
		Элементы.ЗатраченноеВремя.Видимость = Истина;
	Иначе
		Элементы.ЗатраченноеВремя.Видимость = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_КомментарийОбращенияТехническаяПоддержка"
		ТОгда
		Элементы.Комментарии.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКомментарий(Команда)
	
	Если Не ЗначениеЗаполнено(ОБъект.Ссылка) ТОгда
		Сообщить("Створювати коментр можливо лише у записаному зверненні");
	ИНаче
		П = Новый Структура("Обращение", ОБъект.Ссылка);
		ОткрытьФорму("РегистрСведений.КомментарииОбращенияТехническаяПоддержка.Форма.ФормаЗаписи", П);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомментарииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекСтр = Элементы.Комментарии.ТекущиеДанные;
	Если Не ТекСтр = Неопределено
		И ТекСтр.Прочитано = Ложь
		Тогда
		ЗарегистрироватьПрочтениеКомментария(ТекСтр.ИД, Объект.Ссылка);
		Элементы.Комментарии.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура  ЗарегистрироватьПрочтениеКомментария(ИД, Обращение)
	
	Запись = РегистрыСведений.РегистрацияПросмотровКомментариевТехподдержки.СоздатьМенеджерЗаписи();
	Запись.ИД = ИД;
	Запись.Обращение = Обращение;
	Запись.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Запись.ДатаВремя = ТекущаяДата();
	Запись.Записать(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомментарииПриАктивизацииСтроки(Элемент)

	ТекСтр = Элементы.Комментарии.ТекущиеДанные;
	Если Не ТекСтр = Неопределено
		И ТекСтр.Прочитано = Ложь
		Тогда
		ЗарегистрироватьПрочтениеКомментария(ТекСтр.ИД, Объект.Ссылка);
		Элементы.Комментарии.Обновить();
	КонецЕсли;

	Оповестить("РегистрацияПросмотраКомментария");
	
КонецПроцедуры

 &НаКлиенте
Асинх Процедура ВыгрузитьДанные()
	КлиентИД = "OL_ut";	
	мРез = ПолучитьМассивДанныхСправочника(КлиентИД);
		
	SSL = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС());  
	HttpСоединение = Новый HTTPСоединение("demo.infraline.com.ua",50185,"DataJob","TestTest",,,SSL,);
	Данные = Новый Структура();
	Данные.Вставить("ClientID", КлиентИД);
	Данные.Вставить("database", мРез);
	Данные.Вставить("type", "DataJobTransfer");
		
	ЗаписьJSON = Новый ЗаписьJSON;            
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);            
	ТелоЗапроса = ЗаписьJSON.Закрыть(); 	
	
	HttpЗапрос = Новый HttpЗапрос();  
	HttpЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	HttpЗапрос.Заголовки.Вставить("Content-Type", "application/json"); 
	HttpЗапрос.АдресРесурса = "/InfraInside/hs/DataJob/POST/All";
	
	Ответ = HttpСоединение.ВызватьHTTPМетод("POST",HttpЗапрос); 
	
	ПараметрыJSON = Ответ.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ПараметрыJSON);              
	Результат = ПрочитатьJSON(ЧтениеJSON);
	
	Сообщить(?(Результат.Result, "Успешно", "Ошибка ") + Результат.Description);

КонецПроцедуры

&НаСервере
Функция ПолучитьМассивДанныхСправочника(КлиентИД)
	
 	Запрос = Новый Запрос("ВЫБРАТЬ
 	                      |	ОбращенияТехническаяПоддержка.ПометкаУдаления КАК ПометкаУдаления,
 	                      |	ОбращенияТехническаяПоддержка.Код КАК КодКлиентский,
 	                      |	ОбращенияТехническаяПоддержка.Задача КАК Задача,
 	                      |	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОбращенияТехническаяПоддержка.Приоритет) КАК Приоритет,
 	                      |	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОбращенияТехническаяПоддержка.ПричинаОбращения) КАК ПричинаОбращения,
 	                      |	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОбращенияТехническаяПоддержка.СтатусВыполнения) КАК СтатусВыполнения,
 	                      |	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОбращенияТехническаяПоддержка.Автор) КАК Автор,
 	                      |	ОбращенияТехническаяПоддержка.ДатаНачала КАК ДатаНачалаИсх,
 	                      |	ОбращенияТехническаяПоддержка.ДатаВыполнения КАК ДатаВыполненияИсх,
 	                      |	ОбращенияТехническаяПоддержка.ЗатраченноеВремя КАК ЗатраченноеВремя,
 	                      |	ОбращенияТехническаяПоддержка.КомментарийАдминистратора КАК КомментарийАдминистратора,
 	                      |	ОбращенияТехническаяПоддержка.КомментарийИсполнителя КАК КомментарийИсполнителя,
 	                      |	&ИдКлиента КАК ИдКлиента,
 	                      |	ОбращенияТехническаяПоддержка.Наименование КАК Наименование,
 	                      |	""                                     "" КАК ДатаНачала,
 	                      |	""                                     "" КАК ДатаВыполнения
 	                      |ИЗ
 	                      |	Справочник.ОбращенияТехническаяПоддержка КАК ОбращенияТехническаяПоддержка
 	                      |ГДЕ
 	                      |	ОбращенияТехническаяПоддержка.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("ИдКлиента", КлиентИД);
	Запрос.УстановитьПараметр("Ссылка", ОБъект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для каждого Стр из ТЗ цикл
		Стр.ДатаВыполнения = сокрЛП(Формат(СТр.ДатаВыполненияИсх, "ДФ=yyyyMMddHHmmss"));
		Стр.ДатаНачала = сокрЛП(Формат(СТр.ДатаНачалаИсх, "ДФ=yyyyMMddHHmmss"));	
	КонецЦикла;
	
	мРез = ОБщегоНазначения.ТаблицаЗначенийВМассив(ТЗ);
	Возврат мРез;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ВыгрузитьДанные();
КонецПроцедуры
