
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Владелец);
	
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта
		ИЛИ СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		
		СтруктураКонтрагента = Новый Структура("Фамилия, Имя, Отчество,  ЕДРПОУ, Отправитель, Наименование, Телефон, РасчетныйСчет, Email");
		СтруктураКонтрагента.Имя = Наименование;
		ЗаполнитьЗначенияСвойств(СтруктураКонтрагента, ЭтотОбъект);
		СтруктураКонтрагента.Вставить("ТипКонтрагента", ЭтотОбъект.ТипКонтрагента.Идентификатор);
		СтруктураКонтрагента.Вставить("ФормаСобственности",?(ЭтотОбъект.ФормаСобственности = Справочники.eComm_ОбщиеСправочники.ПустаяСсылка(), "",ЭтотОбъект.ФормаСобственности.Идентификатор));
		ДополнитьАдресами(СтруктураНастроек, СтруктураКонтрагента);
		
		Если НЕ ОбменДанными.Загрузка = Истина Тогда
			Идентификатор = Справочники.eComm_УчетныеЗаписиСлужбДоставки.СоздатьКонтрагентаВЛичномКабинете(СтруктураНастроек, СтруктураКонтрагента);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда 
			Отказ = Истина;
			Сообщить("Ошибка создания контрагента в личном кабинете!!!");
		КонецЕсли;
		
	Иначе
		// Для Justin и Meest ограничений нет
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Владелец);
	
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта
		ИЛИ СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда
		
		Если ЗначениеЗаполнено(Идентификатор) Тогда 
			
			СтруктураКонтрагента = Новый Структура("Идентификатор", Идентификатор);	
			Отказ = НЕ Справочники.eComm_УчетныеЗаписиСлужбДоставки.УдалитьКонтрагентаВЛичномКабинете(СтруктураНастроек, СтруктураКонтрагента) = Истина;
			Если Отказ = Истина Тогда 
				Сообщить("Ошибка удаления контрагента в личном кабинете!!!");
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		// Для Justin и Meest ограничений нет
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьАдресами(СтруктураНастроек, СтруктураКонтактногоЛица)

	Если НЕ СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Возврат;
	КонецЕсли;
	
	// Убедимся что есть основной адрес и он один
	ОсновнойАдресНайден = Ложь;
	
	Для Каждого СтрокаАдреса Из Адреса Цикл 
		Если СтрокаАдреса.ОсновнойАдрес = Истина Тогда 
			Если ОсновнойАдресНайден = Ложь Тогда 
				ОсновнойАдресНайден = Истина;
			Иначе
				СтрокаАдреса.ОсновнойАдрес = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Если основного адреса нет - тогда назначим первый
	Если НЕ ОсновнойАдресНайден
		И Адреса.Количество() > 0 Тогда 
		Адреса[0].ОсновнойАдрес = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаАдреса Из Адреса Цикл 
		Если СтрокаАдреса.ОсновнойАдрес = Истина 
			И ЗначениеЗаполнено(СтрокаАдреса.Адрес) Тогда 
			СтруктураКонтактногоЛица.Вставить("ОсновнойАдрес", СтрокаАдреса.Адрес);
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры