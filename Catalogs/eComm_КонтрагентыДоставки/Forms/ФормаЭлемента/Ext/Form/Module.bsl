
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьПараметрыВыбораТипаКонтрагента();
	УстановитьВидимость();
	УстановитьОтборНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СлужбаДоставки = ТекущийОбъект.Владелец.СлужбаДоставки;
	
	Если (СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта ИЛИ СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest)
		И ТекущийОбъект.Отправитель = Ложь
		И НЕ ТекущийОбъект.ТипКонтрагента = eCommДоставкаСервер.ТипКонтрагентаОрганизация(СлужбаДоставки) Тогда 
		// Создаем контрагента только для юр.лица
		Отказ = Истина;
		Сообщить("Контрагент с типом ""Физическое лицо"" и ""Физическое лицо предприниматель"" не создается вручную для ""Укрпочта"" и ""Meest""");
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	УстановитьПараметрыВыбораТипаКонтрагента();
	УстановитьВидимость();
	УстановитьОтборНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипКонтрагентаПриИзменении(Элемент)
	
	УстановитьВидимость();
	
	Если ЭтоЧастноеЛицо() Тогда 
		
		ФормаСобственностиФизическеЛицо = ФизическоеЛицо();
		
		Если ЗначениеЗаполнено(ФормаСобственностиФизическеЛицо)
			И НЕ Объект.ФормаСобственности = ФормаСобственностиФизическеЛицо Тогда 
			Объект.ФормаСобственности = ФормаСобственностиФизическеЛицо;
		КонецЕсли;
		
		Если НЕ Объект.Наименование = "Приватна особа" Тогда 
			Объект.Наименование = "Приватна особа";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправительПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьКакОсновной(Команда)
	
	ТекДанные = Элементы.Адреса.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаАдреса Из Объект.Адреса Цикл 
		СтрокаАдреса.ОсновнойАдрес = Ложь;
	КонецЦикла;
	
	ТекДанные.ОсновнойАдрес = Истина;

КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура УстановитьВидимость()

	ЭтоЧасноеЛицо = ЭтоЧастноеЛицо();
	
	Элементы.ЕДРПОУ.Видимость = НЕ ЭтоЧасноеЛицо;
	
	СлужбаДоставки = Объект.Владелец.СлужбаДоставки;
	
	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		
		Элементы.Телефон.Видимость = Истина;
		Элементы.ГруппаАдресУкрпочта.Видимость = Истина;
		Элементы.ГруппаАдресНоваяПочта.Видимость = Ложь;
		
		Если eCommДоставкаСервер.ТипКонтрагентаОрганизация(СлужбаДоставки) = Объект.ТипКонтрагента Тогда 
			Элементы.РасчетныйСчет.Видимость = Объект.Отправитель;
		Иначе
			Элементы.РасчетныйСчет.Видимость = Ложь;
		КонецЕсли;
		
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда
		
		Элементы.ГруппаАдресУкрпочта.Видимость 	= Ложь;
		Элементы.РасчетныйСчет.Видимость 		= Ложь;
		
		Если Объект.Отправитель = Истина Тогда 
			Элементы.ГруппаАдресНоваяПочта.Видимость = Истина;
		Иначе
			Элементы.ГруппаАдресНоваяПочта.Видимость = Ложь;
		КонецЕсли;
		
	Иначе
		
		Элементы.ГруппаАдресУкрпочта.Видимость 	= Ложь;
		Элементы.ГруппаАдресНоваяПочта.Видимость = Ложь;
		Элементы.РасчетныйСчет.Видимость 		= Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЭтоЧастноеЛицо()

	Возврат Объект.ТипКонтрагента.Идентификатор = "PrivatePerson"    				// Новая почта
			ИЛИ Объект.ТипКонтрагента.Идентификатор = "INDIVIDUAL"					// Укрпочта
			ИЛИ Объект.ТипКонтрагента.Идентификатор = "PRIVATE_ENTREPRENEUR";		// Укрпочта

КонецФункции

&НаСервере
Функция ФизическоеЛицо()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ОбщиеСправочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_ОбщиеСправочники КАК eComm_ОбщиеСправочники
		|ГДЕ
		|	eComm_ОбщиеСправочники.Родитель = ЗНАЧЕНИЕ(Справочник.eComm_ОбщиеСправочники.ФормыСобственности)
		|	И eComm_ОбщиеСправочники.Наименование = ""Фізична особа""";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		Возврат РезультатЗапроса.Ссылка;
	КонецЦикла;
	
КонецФункции

&НаСервере
Процедура УстановитьПараметрыВыбораТипаКонтрагента()

	СлужбаДоставкиУчетнойЗаписи = Объект.Владелец.СлужбаДоставки;
	Если СлужбаДоставкиУчетнойЗаписи = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		РодительТиповКонтрагентов = Справочники.eComm_ОбщиеСправочники.ТипыКонтрагентовУкрпочта;
	Иначе
		РодительТиповКонтрагентов = Справочники.eComm_ОбщиеСправочники.ТипыКонтрагентов;
	КонецЕсли;
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Родитель", РодительТиповКонтрагентов));    

	Элементы.ТипКонтрагента.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборНаСервере()

	ЭлементОтбора = Адреса.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Контрагент");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование 	= Истина;
	
	Если Объект.Владелец.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
	Иначе
		ЭлементОтбора.ПравоеЗначение = Неопределено;
	КонецЕсли;

КонецПроцедуры










