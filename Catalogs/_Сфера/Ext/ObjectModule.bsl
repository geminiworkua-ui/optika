 // ++  Боков
Процедура ПередЗаписью(Отказ)
	
	Стр = Наименование;
	Стр = СтрЗаменить(Стр, "+", "");
	Стр = СтрЗаменить(Стр, ".", ",");
	Стр = СтрЗаменить(Стр, " ", "");
	ЧисловоеЗначение = Число(Стр);
	Наименование = строка(формат(ЧисловоеЗначение, "ЧДЦ=2"));
	Если СтрДлина(Наименование) > 1
		И НЕ Лев(Наименование, 1) = "-"
		И НЕ Лев(Наименование, 1) = "+"
		Тогда
		Наименование = "+" + Наименование;
	КонецЕсли;
	
	Если Наименование = ""
		Тогда Наименование = "0,00"
	КонецЕсли;
	
	Наименование_ru = Наименование;	

	
КонецПроцедуры