

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если НЕ ЗначениеЗаполнено(ПараметрКоманды) Тогда 
		ПоказатьПредупреждение(, НСтр("ru = 'Учетная запись не выбрана'; uk = 'Обліковий запис не вибраний'"));
		Возврат;
	КонецЕсли;
	
	Если ПоддерживаетсяВыгрузкаЗаказов(ПараметрКоманды) Тогда 
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтотОбъект, ПараметрКоманды);
		ТекстВопроса = НСтр("ru = 'Произвести выгрузку изменений заказов по учетной записи '; uk = 'Виконати вивантаження змін замовлень для облікового запису '") + ПараметрКоманды + "?";
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , , НСтр("ru = 'Выгрузка изменений заказов на сайт'; uk = 'Вивантаження змін замовлень на сайт'"));
		
	Иначе
		ПоказатьПредупреждение( , НСтр("ru = 'API сайта ""'; uk = 'API сайту ""'") + ТорговаяПлощадка(ПараметрКоманды) + НСтр("ru = '"" не поддерживает выгрузку изменений состава товаров заказа на сайт.'; uk = '"" не підтримує ввантаження змін складу товарів замовлення на сайт.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(РезультатВыбора, УчетнаяЗапись) Экспорт

	Если РезультатВыбора = КодВозвратаДиалога.ОК Тогда 
		
		СтруктураНастроек = eCommСервер.Настройки(УчетнаяЗапись);
		
		eCommСервер.ВыгрузитьЗаказы(СтруктураНастроек);
		
		Состояние(НСтр("ru = 'Выгрузка изменений заказов завершена'; uk = 'Вивантаження змін замовлень завершено'"),, НСтр("ru = 'Выгрузка завершена'; uk = 'Вивантаження зевершено'"));
	Иначе
		Состояние(НСтр("ru = 'Выгрузка изменений заказов ОТМЕНЕНА пользователем'; uk = 'Вивантаження змін замовлень ВІДМІНЕНО користувачем'"),,НСтр("ru = 'Выгрузка отменена'; uk = 'Вивантаження відмінено'"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПоддерживаетсяВыгрузкаЗаказов(УчетнаяЗапись)

	Если УчетнаяЗапись.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ТорговаяПлощадка(УчетнаяЗапись)

	Возврат УчетнаяЗапись.ТорговаяПлощадка;

КонецФункции

