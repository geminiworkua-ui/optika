
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если НЕ ЗначениеЗаполнено(ПараметрКоманды) Тогда 
		ПоказатьПредупреждение(, НСтр("ru = 'Учетная запись не выбрана'; uk = 'Обліковий запис не вибраний'"));
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = eCommСервер.Настройки(ПараметрКоманды);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеВыбораВариантаВыгрузки", ЭтотОбъект, СтруктураНастроек);
	ТекстВопроса = "Произвести выгрузку на сервер или сохранить в файл?";
	
	Если СтруктураНастроек.ВыгружатьКартинкиИзБазы = Истина Тогда 
		ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС + "Поскольку выбран режим ""Выгружать картинки из базы"",
					|то длительность выгрузки увеличится (до 15 мин на каждой тысяче товаров)";
	КонецЕсли;
	
	СписокВариантовВыбора = Новый СписокЗначений;
	СписокВариантовВыбора.Добавить("ВыгрузкаНаФТП"	, "Выгрузить на Сервер");
	СписокВариантовВыбора.Добавить("ВыгрузкаВФайл"	, "Выгрузить в файл");
	СписокВариантовВыбора.Добавить("Отменить"		, "Отменить");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокВариантовВыбора, , , "Формирование " + ВРег(СтруктураНастроек.РасширениеФайла));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораВариантаВыгрузки(РезультатВыбора, СтруктураНастроек) Экспорт

	Если РезультатВыбора = "ВыгрузкаНаФТП" Тогда
		
		eCommСервер.ВыгрузитьТовары(СтруктураНастроек);
		Состояние("Выгрузка товаров завершена",,"Выгрузка завершена");
		
	ИначеЕсли РезультатВыбора = "ВыгрузкаВФайл" Тогда 
		
		ЭтоПорционнаяВыгрузка 	= Ложь;
		РазмерПорции 			= Неопределено;
		РасширениеФайла 		= СтруктураНастроек.РасширениеФайла;
		
		Если eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ВыгружатьВАрхивеProm") = Истина Тогда 
			РасширениеФайла = "zip";
		КонецЕсли;
				
		Если СтруктураНастроек.НастройкиОбмена.Свойство("ВыгрузкаТоваров")
			И СтруктураНастроек.НастройкиОбмена.ВыгрузкаТоваров.Свойство("РазмерПорции", РазмерПорции)
			И ТипЗнч(РазмерПорции) = Тип("Число")
			И РазмерПорции > 0 Тогда 
			
			ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
			ДиалогВыбораФайла.Заголовок 					= "Сохранение выгрузки в " + РасширениеФайла + " для " + СтруктураНастроек.УчетнаяЗапись;
			ЭтоПорционнаяВыгрузка = Истина;
			
		Иначе
			
			ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
			ДиалогВыбораФайла.Заголовок 					= "Сохранение выгрузки в " + РасширениеФайла + " для " + СтруктураНастроек.УчетнаяЗапись;
			ДиалогВыбораФайла.Фильтр 						= "Файл " + ВРег(РасширениеФайла) + " (*." + РасширениеФайла +")|*." + РасширениеФайла +""; 
			ДиалогВыбораФайла.ПроверятьСуществованиеФайла 	= Истина;

		КонецЕсли;
				
		Если ДиалогВыбораФайла.Выбрать() Тогда
			
			Если НЕ ЭтоПорционнаяВыгрузка Тогда 
				ПутьКФайлу = ДиалогВыбораФайла.ПолноеИмяФайла;
			Иначе
				ПутьКФайлу = ДиалогВыбораФайла.Каталог; 
			КонецЕсли;
			
			СтруктураНастроек.Вставить("ВыгрузкаВФайл", Истина);
			
			Состояние("Формирование " + ВРег(РасширениеФайла) + "",,"Производится формирование " + ВРег(РасширениеФайла) + "");
			eCommСервер.ВыгрузитьТовары(СтруктураНастроек);
			
			Если СтруктураНастроек.Свойство("СписокФайловКВыгрузке") 
				И ЗначениеЗаполнено(ПутьКФайлу) Тогда 
				
				Сч = 0;
				Для Каждого ДеталиФайла Из СтруктураНастроек.СписокФайловКВыгрузке Цикл 
					Сч = Сч + 1;
					ПолучитьФайл(ДеталиФайла.АдресВоВременномХранилище, ?(ЭтоПорционнаяВыгрузка, ПутьКФайлу + "/Price_part_" + Сч + "." + РасширениеФайла, ПутьКФайлу), Ложь);
				КонецЦикла;
				
			КонецЕсли; 
			
			Состояние(Нстр("ru = 'Выгрузка товаров завершена'; uk = 'Вивантаження товарів завершено'"),,НСтр("ru = 'Выгрузка завершена'; uk = 'Вивантаження завершено'"));
			
		КонецЕсли;
		
	Иначе
		
		Состояние(НСтр("ru = 'Выгрузка отменена...'; uk = 'Відміна вивантаження...'"), , НСтр("ru = 'Отмена'; uk = 'Відміна'"));
		
	КонецЕсли;


КонецПроцедуры