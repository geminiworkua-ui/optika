
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если НЕ ЗначениеЗаполнено(ПараметрКоманды) Тогда 
		ПоказатьПредупреждение(, НСтр("ru = 'Учетная запись не выбрана'; uk = 'Обліковий запис не вибраний'"));
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = eCommСервер.Настройки(ПараметрКоманды);

	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтотОбъект, СтруктураНастроек);
	ТекстВопроса = "Произвести синхронизацию статусов заказов с " + СтруктураНастроек.УчетнаяЗапись + "?";
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , , "Синхронизация статусов");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(РезультатВыбора, СтруктураНастроек) Экспорт

	Если РезультатВыбора = КодВозвратаДиалога.ОК Тогда 
		eCommСервер.СинхронизироватьСтатусыЗаказов(СтруктураНастроек);
		
		Состояние("Синхронизация статусов завершена",,"Синхронизация завершена");
	Иначе
		Состояние("Синхронизация статусов ОТМЕНЕНА пользователем",,"Синхронизация отменена");
	КонецЕсли;

КонецПроцедуры