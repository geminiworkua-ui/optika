
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если НЕ ЗначениеЗаполнено(ПараметрКоманды) Тогда 
		ПоказатьПредупреждение(, НСтр("ru = 'Учетная запись не выбрана'; uk = 'Обліковий запис не вибраний'"));
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтотОбъект, ПараметрКоманды);
	ТекстВопроса = НСтр("ru = 'Произвести загрузку статусов оплат по заказам для учетной записи ';
						|uk = 'Провести завантаження статусів оплат по замовленням для облікового запису '") + ПараметрКоманды + "?";
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , , НСтр("ru = 'Загрузка статусов оплат по заказам'; uk = 'Завантаження статусів оплат по зомовленням'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(РезультатВыбора, УчетнаяЗапись) Экспорт

	Если РезультатВыбора = КодВозвратаДиалога.ОК Тогда 
		
		СтруктураНастроек = eCommСервер.Настройки(УчетнаяЗапись);
		
		eCommСервер.ЗагрузитьСтатусыОплатПоЗаказам(СтруктураНастроек);
		
		Состояние(НСтр("ru = 'Загрузка статусов оплат по заказам завершена'; 
					   |uk = 'Завантаження статусів оплат по замовленням завершене'"),,"Загрузка завершена");
	Иначе
		Состояние(НСтр("ru = 'Загрузка статусов оплат по заказов ОТМЕНЕНА пользователем';
					   |uk = 'Завантаження статусів оплат по замовленням ВІДМІНЕНЕ користувачем'"),,"Загрузка отменена");
	КонецЕсли;

КонецПроцедуры

