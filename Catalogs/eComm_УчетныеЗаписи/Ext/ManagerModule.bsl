Процедура ДополнитьТекстыЗапросаТаблицейСопутствующиеТовары(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейСопутствующиеТовары(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop
		ИЛИ eCommСервер.ВернутьИмяПрикладногоОбъекта("СопутствующиеТовары") = "" Тогда 
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита_ХарактеристикаСопутствующегоТовара = eCommСервер.ВернутьИмяРеквизитаОбъекта("СопутствующиеТовары", "ХарактеристикаСопутствующегоТовара");
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	СопутствующиеТовары.Номенклатура КАК Номенклатура,
		|	СопутствующиеТовары.Характеристика КАК Характеристика,
		|	СопутствующиеИнтернетТовары.Код КАК СопутствующийТоварКод
		|ИЗ
		|	РегистрСведений.СопутствующиеТовары КАК СопутствующиеТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары КАК ИнтернетТовары
		|		ПО СопутствующиеТовары.Номенклатура = ИнтернетТовары.Номенклатура
		|			И СопутствующиеТовары.Характеристика = ИнтернетТовары.ХарактеристикаНоменклатуры
		|			И (ИнтернетТовары.Владелец = &УчетнаяЗапись)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары КАК СопутствующиеИнтернетТовары
		|		ПО СопутствующиеТовары.СопутствующийТовар = СопутствующиеИнтернетТовары.Номенклатура
		|			И СопутствующиеТовары.#ИмяРеквизита_ХарактеристикаСопутствующегоТовара# = СопутствующиеИнтернетТовары.ХарактеристикаНоменклатуры
		|			И (СопутствующиеИнтернетТовары.Владелец = &УчетнаяЗапись)
		|ГДЕ
		|	(СопутствующиеТовары.Номенклатура, СопутствующиеТовары.Характеристика) В
		|			(ВЫБРАТЬ
		|				ВрТабТаблицаТоваров.Номенклатура КАК Номенклатура,
		|				ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры
		|			ИЗ
		|				ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров)
		|;";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ХарактеристикаСопутствующегоТовара#", ИмяРеквизита_ХарактеристикаСопутствующегоТовара); 
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, "СопутствующиеТовары");

