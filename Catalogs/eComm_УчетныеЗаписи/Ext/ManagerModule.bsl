Процедура ДополнитьТекстыЗапросаТаблицейИзображенияХарактеристик(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейИзображенияХарактеристик(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если eCommСервер.ВернутьИмяПрикладногоОбъекта("ХарактеристикиНоменклатурыПрисоединенныеФайлы") = "" Тогда 
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ИзображенияХарактеристик.Ссылка КАК ПрисоединенныйФайл,
		|	ИзображенияХарактеристик.#ИмяРеквизита_ВладелецФайла# КАК ВладелецФайла,
		|	ВЫБОР
		|		КОГДА ХарактеристикиНоменклатуры.#ИмяРеквизита_ФайлКартинки# = ИзображенияХарактеристик.Ссылка
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОсновноеИзображение,
		|	#РеквизитРасширениеИзображенияХарактеристики#,
		|	#РеквизитХранилищеХарактеристики#,
		|	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА НЕ ИзображенияХарактеристикИзменения.Ссылка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ИзображениеИзменено,
		|	ВЫБОР
		|		КОГДА НЕ ИзображенияВыгруженные.ПрисоединенныйФайл ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ИзображениеВыгружено,
		|	ИзображенияХарактеристик.ПометкаУдаления КАК ИзображениеУдалено
		|ИЗ
		|	ВрТабТаблицаТоваров КАК ВрТабТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.#ХарактеристикиПрисоединенныеФайлы# КАК ИзображенияХарактеристик
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|			ПО ИзображенияХарактеристик.#ИмяРеквизита_ВладелецФайла# = ХарактеристикиНоменклатуры.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.eComm_ВыгруженныеИзображения КАК ИзображенияВыгруженные
		|			ПО (ИзображенияВыгруженные.УчетнаяЗапись = &УчетнаяЗапись)
		|				И (ИзображенияВыгруженные.ПрисоединенныйФайл ССЫЛКА Справочник.#ХарактеристикиПрисоединенныеФайлы#)
		|				И ИзображенияХарактеристик.Ссылка = ИзображенияВыгруженные.ПрисоединенныйФайл
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.#ХарактеристикиПрисоединенныеФайлы#.Изменения КАК ИзображенияХарактеристикИзменения
		|			ПО (ИзображенияХарактеристикИзменения.Узел = &УзелОбмена)
		|				И ИзображенияХарактеристик.Ссылка = ИзображенияХарактеристикИзменения.Ссылка
		|		ПО ВрТабТовары.ХарактеристикаНоменклатуры = ИзображенияХарактеристик.#ИмяРеквизита_ВладелецФайла#
		|			И (ВЫБОР
		|				КОГДА &ЭтоВыгрузкаДляХорошоп = ИСТИНА
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ИзображенияХарактеристик.ПометкаУдаления = ЛОЖЬ
		|			КОНЕЦ)
		|			 
		|ГДЕ
		|	&ИспользоватьХарактеристики
		|	И &ВыгружатьКартинкиИзБазы
		|	И ХарактеристикиНоменклатуры.Владелец ССЫЛКА Справочник.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОсновноеИзображение УБЫВ
		|;";
		
	ПараметрыЗапроса.Вставить("ИспользоватьХарактеристики"	, СтруктураНастроек.ИспользоватьХарактеристики);
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ИзображенияХарактеристик");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейИзображенияНоменклатуры(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейИзображенияНоменклатуры(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ИзображенияНоменклатуры.Ссылка КАК ПрисоединенныйФайл,
		|	СпрНоменклатура.Ссылка КАК ВладелецФайла,
		|	ВЫБОР
		|		КОГДА СпрНоменклатура.#ИмяРеквизита_ФайлКартинки# = ИзображенияНоменклатуры.Ссылка
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОсновноеИзображение,
		|	#РеквизитРасширениеИзображенияНоменклатуры#,
		|	#РеквизитХранилищеНоменклатуры#,
		|	ВЫБОР
		|		КОГДА НЕ ИзображенияНоменклатурыИзменения.Ссылка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ИзображениеИзменено,
		|	ВЫБОР
		|		КОГДА НЕ ИзображенияВыгруженные.ПрисоединенныйФайл ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ИзображениеВыгружено,
		|	ИзображенияНоменклатуры.ПометкаУдаления КАК ИзображениеУдалено
		|ИЗ
		|	Справочник.Номенклатура КАК СпрНоменклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.#НоменклатураПрисоединенныеФайлы# КАК ИзображенияНоменклатуры
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.eComm_ВыгруженныеИзображения КАК ИзображенияВыгруженные
		|			ПО (ИзображенияВыгруженные.УчетнаяЗапись = &УчетнаяЗапись)
		|				И (ИзображенияВыгруженные.ПрисоединенныйФайл ССЫЛКА Справочник.#НоменклатураПрисоединенныеФайлы#)
		|				И ИзображенияНоменклатуры.Ссылка = ИзображенияВыгруженные.ПрисоединенныйФайл
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.#НоменклатураПрисоединенныеФайлы#.Изменения КАК ИзображенияНоменклатурыИзменения
		|			ПО (ИзображенияНоменклатурыИзменения.Узел = &УзелОбмена)
		|				И ИзображенияНоменклатуры.Ссылка = ИзображенияНоменклатурыИзменения.Ссылка
		|		ПО (СпрНоменклатура.Ссылка В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					ВрТабТаблицаТоваров.Номенклатура
		|				ИЗ
		|					ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров))
		|			И СпрНоменклатура.Ссылка = ИзображенияНоменклатуры.#ИмяРеквизита_ВладелецФайла#
		|			И (ВЫБОР
		|				КОГДА &ЭтоВыгрузкаДляХорошоп = ИСТИНА
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ИзображенияНоменклатуры.ПометкаУдаления = ЛОЖЬ
		|			КОНЕЦ)
		|ГДЕ
		|	&ВыгружатьКартинкиИзБазы
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОсновноеИзображение УБЫВ
		|;";
	
	ПараметрыЗапроса.Вставить("УзелОбмена"					, СтруктураНастроек.УзелОбмена);
	ПараметрыЗапроса.Вставить("ВыгружатьКартинкиИзБазы"		, СтруктураНастроек.ВыгружатьКартинкиИзБазы);
	ПараметрыЗапроса.Вставить("ЭтоВыгрузкаДляХорошоп"		, СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop);  // Для хорошоп мы можем передавать признак удаления картинки

	ТекстыЗапроса.Добавить(ТекстЗапроса, "ИзображенияНоменклатуры");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейНаборы(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейНаборы(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если eCommСервер.ВернутьИмяПрикладногоОбъекта("СоставНаборов") = "" Тогда 
		Возврат;
	КонецЕсли;
	
	ВыгружатьКомплекты = eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ВыгружатьКомплекты");
	ВыгружатьНаборыКакКомплекты = ВыгружатьКомплекты = Истина;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ВрТабТаблицаТоваров.Номенклатура КАК НоменклатураНабора,
		|	ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНабора,
		|	СоставНаборов.#ИмяРеквизита_НоменклатураКомплектующая# КАК Номенклатура,
		|	СоставНаборов.#ИмяРеквизита_ХарактеристикаКомплектующая# КАК Характеристика,
		|	СоставНаборов.Количество КАК Количество,
		|	ИнтернетНаборы.Ссылка КАК ИнтернетНабор,
		|	ИнтернетНаборы.Код КАК НаборКод,
		|	ИнтернетНаборы.Наименование КАК НаборНаименование,
		|	ЕСТЬNULL(ИнтернетКомплектующие.Код, """") КАК ЭлементаСоставаКод
		|ПОМЕСТИТЬ ВрТабСоставНаборов
		|ИЗ
		|	ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.#ИмяОбъектаСоставНаборов# КАК СоставНаборов
		|		ПО ВрТабТаблицаТоваров.Номенклатура = СоставНаборов.#ИмяРеквизита_НоменклатураНабора#
		|			И (ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры = СоставНаборов.#ИмяРеквизита_ХарактеристикаНабора#
		|				#ИмяРеквизита_Общий#)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары КАК ИнтернетНаборы
		|		ПО ВрТабТаблицаТоваров.Номенклатура = ИнтернетНаборы.Номенклатура
		|			И ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры = ИнтернетНаборы.ХарактеристикаНоменклатуры
		|			И (ИнтернетНаборы.Владелец = &УчетнаяЗапись)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары КАК ИнтернетКомплектующие
		|		ПО (СоставНаборов.#ИмяРеквизита_НоменклатураКомплектующая# = ИнтернетКомплектующие.Номенклатура)
		|			И (СоставНаборов.#ИмяРеквизита_ХарактеристикаКомплектующая# = ИнтернетКомплектующие.ХарактеристикаНоменклатуры)
		|			И (ИнтернетКомплектующие.Владелец = &УчетнаяЗапись)
		//|ГДЕ
		//|	НЕ ИнтернетКомплектующие.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабСоставНаборов.НаборКод КАК НаборКод,
		|	ВрТабСоставНаборов.НаборНаименование КАК НаборНаименование,
		|	ВрТабСоставНаборов.ЭлементаСоставаКод КАК ЭлементаСоставаКод,
		|	ВрТабСоставНаборов.ИнтернетНабор КАК ИнтернетНабор
		|ИЗ
		|	ВрТабСоставНаборов КАК ВрТабСоставНаборов
		|ГДЕ
		|	&ВыгружатьНаборыКакКомплекты
		|ИТОГИ
		|	МАКСИМУМ(НаборКод),
		|	МАКСИМУМ(НаборНаименование)
		|ПО
		|	ИнтернетНабор
		|;";
	
	ПараметрыЗапроса.Вставить("ВыгружатьНаборыКакКомплекты", ВыгружатьНаборыКакКомплекты);
	
	ТекстыЗапроса.Добавить("", "ВрТабСоставНаборов");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "СоставНаборов");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейЦеныНаборов(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейЦеныНаборов(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураНастроек.ИмяКонфигурации = "BASSmallBusiness" Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ЦеныКомплектующих.Номенклатура КАК Номенклатура,
		|	ЦеныКомплектующих.Характеристика КАК Характеристика,
		|	ЦеныКомплектующих.ВидЦен КАК ВидЦен,
		|	ЦеныКомплектующих.Цена КАК Цена
		|ПОМЕСТИТЬ ВрТабЦеныКомплектующих
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			&ТекущаяДата,
		|			(Номенклатура, Характеристика) В
		|					(ВЫБРАТЬ
		|						ВрТабСоставНаборов.Номенклатура КАК Номенклатура,
		|						ВрТабСоставНаборов.Характеристика КАК ХарактеристикаНоменклатуры
		|					ИЗ
		|						ВрТабСоставНаборов КАК ВрТабСоставНаборов)
		|				И ВидЦен В
		|					(ВЫБРАТЬ
		|						ВрТабОптовыеЦены.ВидЦены КАК ВидЦены
		|					ИЗ
		|						ВрТабОптовыеЦены КАК ВрТабОптовыеЦены)) КАК ЦеныКомплектующих
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЦеныНаборов.НоменклатураНабора КАК Номенклатура,
		|	ЦеныНаборов.ХарактеристикаНабора КАК ХарактеристикаНоменклатуры,
		|   ВрТабЦеныКомплектующих.ВидЦен КАК ВидЦен,
		|	СУММА(ЕСТЬNULL(ВрТабЦеныКомплектующих.Цена, 0) * ЦеныНаборов.Количество) КАК Цена
		|ИЗ
		|	ВрТабСоставНаборов КАК ЦеныНаборов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабЦеныКомплектующих КАК ВрТабЦеныКомплектующих
		|		ПО ЦеныНаборов.Номенклатура = ВрТабЦеныКомплектующих.Номенклатура
		|			И ЦеныНаборов.Характеристика = ВрТабЦеныКомплектующих.Характеристика
		|ГДЕ
		|	ЦеныНаборов.НоменклатураНабора.СпособРасчетаЦеныНабора = ЗНАЧЕНИЕ(Перечисление.СпособыРасчетаЦеныНабора.СкладыватьИзЦенКомплектующих)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦеныНаборов.НоменклатураНабора,
		|	ЦеныНаборов.ХарактеристикаНабора,
		|   ВрТабЦеныКомплектующих.ВидЦен
		|;";
	
	ПараметрыЗапроса.Вставить("ТекущаяДата", СтруктураНастроек.ТекущаяДата);
	
	ТекстыЗапроса.Добавить("", "ВрТабЦеныКомплектующих");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ЦеныНаборов");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейОстаткиНаборов(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейОстаткиНаборов(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураНастроек.ИмяКонфигурации = "BASSmallBusiness" Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ
			|	ЗапасыОстатки.Номенклатура КАК Номенклатура,
			|	ЗапасыОстатки.Характеристика КАК Характеристика,
			|	ЗапасыОстатки.КоличествоОстаток КАК КоличествоОстаток
			|ПОМЕСТИТЬ ВрТабОстаткиКомплектующих
			|ИЗ
			|	РегистрНакопления.Запасы.Остатки(
			|			,
			|			(Номенклатура, Характеристика) В
			|				(ВЫБРАТЬ
			|					ВрТабСоставНаборов.Номенклатура КАК Номенклатура,
			|					ВрТабСоставНаборов.Характеристика КАК Характеристика
			|				ИЗ
			|					ВрТабСоставНаборов КАК ВрТабСоставНаборов)) КАК ЗапасыОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВрТабСоставНаборов.НоменклатураНабора КАК НоменклатураНабора,
			|	ВрТабСоставНаборов.ХарактеристикаНабора КАК ХарактеристикаНабора,
			|	ВрТабСоставНаборов.Номенклатура КАК Номенклатура,
			|	ВрТабСоставНаборов.Характеристика КАК Характеристика,
			|	СУММА(ВЫБОР
			|			КОГДА ЕСТЬNULL(ВрТабСоставНаборов.Количество, 0) = 0
			|				ТОГДА 0
			|			ИНАЧЕ ЕСТЬNULL(ЗапасыОстатки.КоличествоОстаток, 0) / ВрТабСоставНаборов.Количество
			|		КОНЕЦ) КАК Количество
			|ПОМЕСТИТЬ ВрТабОстаткиКомплектующихНаборов
			|ИЗ
			|	ВрТабСоставНаборов КАК ВрТабСоставНаборов
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабОстаткиКомплектующих КАК ЗапасыОстатки
			|		ПО ВрТабСоставНаборов.Номенклатура = ЗапасыОстатки.Номенклатура
			|			И ВрТабСоставНаборов.Характеристика = ЗапасыОстатки.Характеристика
			|
			|СГРУППИРОВАТЬ ПО
			|	ВрТабСоставНаборов.НоменклатураНабора,
			|	ВрТабСоставНаборов.ХарактеристикаНабора,
			|	ВрТабСоставНаборов.Номенклатура,
			|	ВрТабСоставНаборов.Характеристика
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВрТабОстаткиКомплектующихНаборов.НоменклатураНабора КАК Номенклатура,
			|	ВрТабОстаткиКомплектующихНаборов.ХарактеристикаНабора КАК ХарактеристикаНоменклатуры,
			|	МИНИМУМ(ВрТабОстаткиКомплектующихНаборов.Количество) КАК Количество
			|ИЗ
			|	ВрТабОстаткиКомплектующихНаборов КАК ВрТабОстаткиКомплектующихНаборов
			|
			|СГРУППИРОВАТЬ ПО
			|	ВрТабОстаткиКомплектующихНаборов.НоменклатураНабора,
			|	ВрТабОстаткиКомплектующихНаборов.ХарактеристикаНабора
			|;";
		
		ТекстыЗапроса.Добавить("", "ВрТабОстаткиКомплектующих");
		ТекстыЗапроса.Добавить("", "ВрТабОстаткиКомплектующихНаборов");
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ОстаткиНаборов");
		
	ИначеЕсли СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины"  Тогда 
		
		ТекстЗапроса = "ВЫБРАТЬ
			|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|			ТОГДА ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ КАК Характеристика,
			|	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток
			|ПОМЕСТИТЬ ВрТабОстаткиНеСгрупп
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ТоварыНаСкладахОстатки.Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|			ТОГДА ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТоварыВРозницеОстатки.Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|			ТОГДА ТоварыВРозницеОстатки.ХарактеристикаНоменклатуры
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ,
			|	СУММА(ТоварыВРозницеОстатки.КоличествоОстаток)
			|ИЗ
			|	РегистрНакопления.ТоварыВРознице.Остатки(, ) КАК ТоварыВРозницеОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ТоварыВРозницеОстатки.Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|			ТОГДА ТоварыВРозницеОстатки.ХарактеристикаНоменклатуры
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|			ТОГДА ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ,
			|	СУММА(-ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток)
			|ИЗ
			|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеНаСкладахОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|			ТОГДА ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
			|		ИНАЧЕ ЗНАЧЕНИЕ(справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА &ИспользоватьХарактеристики
			|			ТОГДА ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|	КОНЕЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВрТабОстаткиНеСгрупп.Номенклатура КАК Номенклатура,
			|	ВрТабОстаткиНеСгрупп.Характеристика КАК Характеристика,
			|	СУММА(ВрТабОстаткиНеСгрупп.КоличествоОстаток) КАК КоличествоОстаток
			|ПОМЕСТИТЬ ВрТабОстаткиКомплектующих
			|ИЗ
			|	ВрТабОстаткиНеСгрупп КАК ВрТабОстаткиНеСгрупп
			|
			|СГРУППИРОВАТЬ ПО
			|	ВрТабОстаткиНеСгрупп.Номенклатура,
			|	ВрТабОстаткиНеСгрупп.Характеристика
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВрТабСоставНаборов.НоменклатураНабора КАК НоменклатураНабора,
			|	ВрТабСоставНаборов.ХарактеристикаНабора КАК ХарактеристикаНабора,
			|	ВрТабСоставНаборов.Номенклатура КАК Номенклатура,
			|	ВрТабСоставНаборов.Характеристика КАК Характеристика,
			|	СУММА(ВЫБОР
			|			КОГДА ЕСТЬNULL(ВрТабСоставНаборов.Количество, 0) = 0
			|				ТОГДА 0
			|			ИНАЧЕ ЕСТЬNULL(ЗапасыОстатки.КоличествоОстаток, 0) / ВрТабСоставНаборов.Количество
			|		КОНЕЦ) КАК Количество
			|ПОМЕСТИТЬ ВрТабОстаткиКомплектующихНаборов
			|ИЗ
			|	ВрТабСоставНаборов КАК ВрТабСоставНаборов
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабОстаткиКомплектующих КАК ЗапасыОстатки
			|		ПО ВрТабСоставНаборов.Номенклатура = ЗапасыОстатки.Номенклатура
			|			И ВрТабСоставНаборов.Характеристика = ЗапасыОстатки.Характеристика
			|
			|СГРУППИРОВАТЬ ПО
			|	ВрТабСоставНаборов.НоменклатураНабора,
			|	ВрТабСоставНаборов.ХарактеристикаНабора,
			|	ВрТабСоставНаборов.Номенклатура,
			|	ВрТабСоставНаборов.Характеристика
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВрТабОстаткиКомплектующихНаборов.НоменклатураНабора КАК Номенклатура,
			|	ВрТабОстаткиКомплектующихНаборов.ХарактеристикаНабора КАК ХарактеристикаНоменклатуры,
			|	МИНИМУМ(ВрТабОстаткиКомплектующихНаборов.Количество) КАК Количество
			|ИЗ
			|	ВрТабОстаткиКомплектующихНаборов КАК ВрТабОстаткиКомплектующихНаборов
			|
			|СГРУППИРОВАТЬ ПО
			|	ВрТабОстаткиКомплектующихНаборов.НоменклатураНабора,
			|	ВрТабОстаткиКомплектующихНаборов.ХарактеристикаНабора
			|;";
		
		ПараметрыЗапроса.Вставить("ИспользоватьХарактеристики", eCommСервер.ВключеноИспользованиеХарактеристик());
		
		ТекстыЗапроса.Добавить("", "ВрТабОстаткиНеСгрупп");
		ТекстыЗапроса.Добавить("", "ВрТабОстаткиКомплектующих");
		ТекстыЗапроса.Добавить("", "ВрТабОстаткиКомплектующихНаборов");
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ОстаткиНаборов");
		
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаДополнительнымиДанными(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаДополнительнымиДанными(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	
КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейРазновидности(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	Если НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда 
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ВрТабДополнительныеРеквизиты.Ссылка КАК Номенклатура,
		|	ВрТабДополнительныеРеквизиты.КодСвойстваСервиса КАК КодСвойстваСервиса,
		|	СпрНоменклатура.Код КАК НоменклатураКод,
		|	СпрНоменклатура.Наименование КАК Наименование
		|ПОМЕСТИТЬ ВрТабСгрупп
		|ИЗ
		|	ВрТабДополнительныеРеквизиты КАК ВрТабДополнительныеРеквизиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|		ПО ВрТабДополнительныеРеквизиты.Ссылка = СпрНоменклатура.Ссылка
		|ГДЕ
		|	ВрТабДополнительныеРеквизиты.ЭтоМодификатор = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	ВрТабДополнительныеРеквизиты.Ссылка,
		|	СпрНоменклатура.Код,
		|	ВрТабДополнительныеРеквизиты.КодСвойстваСервиса,
		|	СпрНоменклатура.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабСгрупп.Номенклатура КАК Номенклатура,
		|	ВрТабСгрупп.КодСвойстваСервиса КАК КодСвойстваСервиса,
		|	ВрТабСгрупп.НоменклатураКод КАК НоменклатураКод,
		|	ВрТабСгрупп.Наименование КАК Наименование
		|ИЗ
		|	ВрТабСгрупп КАК ВрТабСгрупп
		|ИТОГИ
		|	МАКСИМУМ(НоменклатураКод),
		|	МАКСИМУМ(Наименование)
		|ПО
		|	Номенклатура";
	
	ТекстыЗапроса.Добавить(""			, "ВрТабСгрупп");
	ТекстыЗапроса.Добавить(ТекстЗапроса	, "Разновидности");

КонецПроцедуры

Функция АдаптированныйТекстЗапросаПодКонфигурацию(СтруктураНастроек, ТекстЗапроса)
	
	ИмяОбъектаСвойствТовара 					= eCommСервер.ВернутьИмяПрикладногоОбъекта("ЗначенияСвойствНоменклатуры", Истина);
	ИмяОбъектаСвойстваХарактеристики 			= eCommСервер.ВернутьИмяПрикладногоОбъекта("ЗначенияСвойствХарактеристики", Истина);
	ИмяОбъектаЗначенияНоменклатурыПоУмолчанию	= eCommСервер.ВернутьИмяПрикладногоОбъекта("ЗначенияНоменклатурыПоУмолчанию");
	ИмяОбъектаСпособыРасчетаЦеныНабора			= eCommСервер.ВернутьИмяПрикладногоОбъекта("СпособыРасчетаЦеныНабора");
	ИмяОбъектаСоставНаборов						= eCommСервер.ВернутьИмяПрикладногоОбъекта("СоставНаборов");
	НоменклатураПрисоединенныеФайлы 			= eCommСервер.ВернутьИмяПрикладногоОбъекта("НоменклатураПрисоединенныеФайлы");
	ХарактеристикиПрисоединенныеФайлы 			= eCommСервер.ВернутьИмяПрикладногоОбъекта("ХарактеристикиНоменклатурыПрисоединенныеФайлы");
	
	ИмяРеквизита_ТовараВСвойстве 				= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗначенияСвойствНоменклатуры", "Номенклатура");
	ИмяРеквизита_ИспользоватьХарактеристики 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "ИспользоватьХарактеристики");
	ИмяРеквизита_ЭтоНабор					 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "ЭтоНабор");
	ИмяРеквизита_СпособРасчетаЦеныНабора		= eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "СпособРасчетаЦеныНабора");
	ИмяРеквизита_НоменклатураНабора				= eCommСервер.ВернутьИмяРеквизитаОбъекта("СоставНаборов", "НоменклатураНабора");
	ИмяРеквизита_ХарактеристикаНабора			= eCommСервер.ВернутьИмяРеквизитаОбъекта("СоставНаборов", "ХарактеристикаНабора");
	ИмяРеквизита_НоменклатураКомплектующая		= eCommСервер.ВернутьИмяРеквизитаОбъекта("СоставНаборов", "Номенклатура");
	ИмяРеквизита_ХарактеристикаКомплектующая	= eCommСервер.ВернутьИмяРеквизитаОбъекта("СоставНаборов", "Характеристика");
	ИмяРеквизита_Общий							= eCommСервер.ВернутьИмяРеквизитаОбъекта("СоставНаборов", "Общий");
	ИмяРеквизита_ОписаниеНоменклатуры 			= eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Описание");
	ИмяРеквизита_ПроизводительНоменклатуры		= eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Производитель");
	ИмяРеквизита_СтранаПроисхождения			= eCommСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "СтранаПроисхождения");
	ИмяРеквизита_ВладелецФайла					= eCommСервер.ВернутьИмяРеквизитаОбъекта("НоменклатураПрисоединенныеФайлы", "ВладелецФайла");
	ИмяРеквизита_МножествСвойствоНоменклатуры	= ?(СтруктураНастроек.ИспользоватьМножественныеРеквизиты, "НоменклатураДополнительныеРеквизиты.Свойство.МножественныйРеквизит", "ЛОЖЬ");
	ИмяРеквизита_МножествСвойствоХарактеристики	= ?(СтруктураНастроек.ИспользоватьМножественныеРеквизиты, "ХарактеристикиДополнительныеРеквизиты.Свойство.МножественныйРеквизит", "ЛОЖЬ");
	ИмяРеквизита_ЦеныНоменклатуры_Характеристика= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЦеныНоменклатуры", "Характеристика");
	ИмяРеквизита_ВидЦен							= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЦеныНоменклатуры", "ВидЦен");
	ИмяРеквизита_Валюта							= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЦеныНоменклатуры", "Валюта");
	ИмяЗначения_СкладыватьИзЦенКомплектующих	= eCommСервер.ВернутьИмяРеквизитаОбъекта("СпособыРасчетаЦеныНабора", "СкладыватьИзЦенКомплектующих");
	
	ИмяРеквизита_АртикулХарактеристики		 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ХарактеристикиНоменклатуры", "Артикул");
	ИспользоватьАртикулХарактеристики			= eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ИспользоватьАртикулХарактеристики");
	ЭтоУТП = СтруктураНастроек.ИмяКонфигурации 	= "УправлениеТорговымПредприятиемДляУкраины";
	
	// Дополнительные реквизиты
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаСвойствТовара#"					, ИмяОбъектаСвойствТовара);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаСвойстваХарактеристики#"        	, ИмяОбъектаСвойстваХарактеристики);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяСсылкиТовараВСвойстве#"					, ИмяРеквизита_ТовараВСвойстве);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяСсылкиХарактеристикиВСвойстве#"			, ИмяРеквизита_ТовараВСвойстве);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_НаименованиеСвойства#"			, ?(ЭтоУТП, ".Наименование", ".Заголовок"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_МножествСвойствоНоменклатуры#"	, ИмяРеквизита_МножествСвойствоНоменклатуры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_МножествСвойствоХарактеристики#", ИмяРеквизита_МножествСвойствоХарактеристики);
	
	// Номенклатура
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ИспользоватьХарактеристики#"	, ИмяРеквизита_ИспользоватьХарактеристики);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ОписаниеНоменклатуры#"			, ИмяРеквизита_ОписаниеНоменклатуры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ПроизводительНоменклатуры#"		, ?(ИмяРеквизита_ПроизводительНоменклатуры = "", "ЕСТЬNULL(ДопРеквизитыТоваров.Производитель, """")", "СпрНоменклатура." + ИмяРеквизита_ПроизводительНоменклатуры));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_СтранаПроисхождения#"			, ?(ИмяРеквизита_СтранаПроисхождения = "", """""", "СпрНоменклатура." + ИмяРеквизита_СтранаПроисхождения));
	
	Если НЕ Метаданные.Справочники.Найти("eComm_КатегорииТорговойПлощадки") = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ЛимитИзображенийНаПортале#"	, "ЕСТЬNULL(ДопРеквизитыТоваров.КатегорияНаПортале.ЛимитИзображений, 0)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_КодКатегорииНаПортале#"		, "ВЫБОР
																								|		КОГДА НЕ КатегорииТоваров.КодКатегорииСервиса = """"
																								|			ТОГДА КатегорииТоваров.КодКатегорииСервиса
																								|		ИНАЧЕ ЕСТЬNULL(КатегорииТоваров.КатегорияНаПортале.ИдентификаторСервиса, """")
																								|	КОНЕЦ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_КодКатегорииТовараНаПортале#", "ЕСТЬNULL(ДопРеквизитыТоваров.КатегорияНаПортале.ИдентификаторСервиса, """")");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ЛимитИзображенийНаПортале#"	, "0");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_КодКатегорииНаПортале#"		, """""");      // Категории
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_КодКатегорииТовараНаПортале#", """""");     // Товар
	КонецЕсли;
	
	Если НЕ ИмяРеквизита_АртикулХарактеристики = "" Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Артикул#", "ВЫБОР
																								|		КОГДА ЕСТЬNULL(ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры.Артикул, """") = """"
																								|			ТОГДА СпрНоменклатура.Артикул
																								|		ИНАЧЕ ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры.Артикул
																								|	КОНЕЦ");
	ИначеЕсли НЕ ИспользоватьАртикулХарактеристики = Истина Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Артикул#", "СпрНоменклатура.Артикул");
	ИначеЕсли ИспользоватьАртикулХарактеристики = Истина Тогда  
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Артикул#", "ВЫБОР
																								|		КОГДА ХарактеристикиДополнительныеРеквизиты.Значение ЕСТЬ NULL
																								|			ТОГДА СпрНоменклатура.Артикул
																								|		ИНАЧЕ ХарактеристикиДополнительныеРеквизиты.Значение
																								|	КОНЕЦ");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#СоединениеТаблицаАртикуловХарактеристик#"	, ?(НЕ ИспользоватьАртикулХарактеристики = Истина, "", 
																								"ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиДополнительныеРеквизиты
																								|		ПО ДопРеквизитыТоваров.ХарактеристикаНоменклатуры = ХарактеристикиДополнительныеРеквизиты.Ссылка
																								|			И (ХарактеристикиДополнительныеРеквизиты.Свойство.Заголовок = ""Артикул"")"));
	// Наборы
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаСоставНаборов#"					, ИмяОбъектаСоставНаборов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_НоменклатураНабора#"			, ИмяРеквизита_НоменклатураНабора);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ХарактеристикаНабора#"			, ИмяРеквизита_ХарактеристикаНабора);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_НоменклатураКомплектующая#"		, ИмяРеквизита_НоменклатураКомплектующая);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ХарактеристикаКомплектующая#"	, ИмяРеквизита_ХарактеристикаКомплектующая);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Общий#"							, ?(ИмяРеквизита_Общий = "", "", "ИЛИ СоставНаборов.Общий"));
	
	Если ИмяРеквизита_ЭтоНабор = "ТипНоменклатуры" Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ЭтоНабор#"					, "ВЫБОР
																								|		КОГДА СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
																								|			ТОГДА ИСТИНА
																								|		ИНАЧЕ ЛОЖЬ
																								|	КОНЕЦ");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ЭтоНабор#"					, ?(ИмяРеквизита_ЭтоНабор = "", "ЛОЖЬ", "СпрНоменклатура." + ИмяРеквизита_ЭтоНабор));
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#СпособРасчетаЦеныНабора#"					, ?(ИмяОбъектаСпособыРасчетаЦеныНабора = "" ИЛИ ИмяЗначения_СкладыватьИзЦенКомплектующих = "", """""", 
																							"ВЫБОР
																								|		КОГДА СпрНоменклатура." + ИмяРеквизита_СпособРасчетаЦеныНабора + " = ЗНАЧЕНИЕ(Перечисление." + ИмяОбъектаСпособыРасчетаЦеныНабора + "." + ИмяЗначения_СкладыватьИзЦенКомплектующих + ")
																								|			ТОГДА ИСТИНА
																								|		ИНАЧЕ ЛОЖЬ
																								|	КОНЕЦ"));
	
	Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Joom Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ИдентификаторПродуктаJoom#"	, "СпрНоменклатура.eComm_ИдентификаторТовара КАК ИдентификаторПродуктаJoom,");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ИдентификаторПродуктаJoom#"	, "");
	КонецЕсли;
	
	// Цены
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ЦеныНоменклатуры_Характеристика#", ИмяРеквизита_ЦеныНоменклатуры_Характеристика);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ВидЦен#"						, ИмяРеквизита_ВидЦен);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Валюта_ОптЦены#"				, ?(ИмяРеквизита_Валюта = "", "ВрТабНоменклатураВидыЦен.Валюта", "ЦеныНоменклатуры.Валюта"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Валюта_УровниЦен#"				, ?(ИмяРеквизита_Валюта = "", "ВрТабНоменклатураУровниЦенB2B.Валюта", "ЦеныНоменклатуры.Валюта"));
	//ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ОптоваяЦенаПриЗаказеОт#"		, ?(НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom, "0", "ТаблицаОптовыеЦеныИнтернетТоваров.ОптоваяЦенаПриЗаказеОт"));
	//ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#СоединениеТаблицаОптовыеЦеныИнтернетТоваров#", ?(НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom, "",
	//																							"		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары.ОптовыеЦены КАК ТаблицаОптовыеЦеныИнтернетТоваров
	//																							|			ПО ВрТабНоменклатураВидыЦен.ИнтернетТовар = ТаблицаОптовыеЦеныИнтернетТоваров.Ссылка
	//																							|				И ВрТабНоменклатураВидыЦен.ВидЦен = ТаблицаОптовыеЦеныИнтернетТоваров.ВидЦены"));
	
	// Характеристики
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ОсновнаяХарактеристика#"		, ?(ИмяОбъектаЗначенияНоменклатурыПоУмолчанию = "", "ЛОЖЬ", 
																								"	ВЫБОР
																								|		КОГДА НЕ ЗначенияНоменклатурыПоУмолчанию.Характеристика ЕСТЬ NULL
																								|			ТОГДА ИСТИНА
																								|		ИНАЧЕ ЛОЖЬ
																								|	КОНЕЦ"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#СоединениеЗначенияНоменклатурыПоУмолчанию#"	, ?(ИмяОбъектаЗначенияНоменклатурыПоУмолчанию = "", "",
																								"		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияНоменклатурыПоУмолчанию КАК ЗначенияНоменклатурыПоУмолчанию
																								|			ПО ВрТабТаблицаТоваров.Номенклатура = ЗначенияНоменклатурыПоУмолчанию.Номенклатура
																							  	|			И ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры = ЗначенияНоменклатурыПоУмолчанию.Характеристика"));
	
	// Изображения характеристик
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ХарактеристикиПрисоединенныеФайлы#"			, ХарактеристикиПрисоединенныеФайлы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#РеквизитРасширениеИзображенияХарактеристики#", ?(ЭтоУТП, "null КАК Расширение", "ИзображенияХарактеристик.Расширение КАК Расширение"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#РеквизитХранилищеХарактеристики#"			, ?(ЭтоУТП, "ИзображенияХарактеристик.Хранилище", "null КАК Хранилище"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#УсловиеВидДанныхИзображенияХарактеристики#"	, ?(ЭтоУТП, "И ИзображенияХарактеристик.ВидДанных = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительнойИнформацииОбъектов.Изображение)", ""));
	
	// Изображения номенклатуры
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#НоменклатураПрисоединенныеФайлы#"			, НоменклатураПрисоединенныеФайлы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#РеквизитРасширениеИзображенияНоменклатуры#"	, ?(ЭтоУТП, "null КАК Расширение", "ИзображенияНоменклатуры.Расширение КАК Расширение"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ВладелецФайла#"					, ИмяРеквизита_ВладелецФайла);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#РеквизитХранилищеНоменклатуры#"				, ?(ЭтоУТП, "ИзображенияНоменклатуры.Хранилище", "null КАК Хранилище"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#УсловиеВидДанных#"							, ?(ЭтоУТП, "И ИзображенияНоменклатуры.ВидДанных = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительнойИнформацииОбъектов.Изображение)", ""));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ФайлКартинки#"                  , ?(ЭтоУТП, "ОсновноеИзображение", "ФайлКартинки"));
	
	eCommСерверПереопределяемый.ПередУстановкойТекстаЗапросаИнициализацииДанныхВыгрузки(СтруктураНастроек, ТекстЗапроса);

	Возврат ТекстЗапроса;

КонецФункции


/////////////////////////////////////////////////////////////////////
// ЗАГРУЗКА ЗАКАЗОВ

Процедура ЗагрузитьЗаказы(СтруктураНастроек, НачалоПериода, КонецПериода) Экспорт

	Если СтруктураНастроек.Свойство("Менеджер")
		И ЗначениеЗаполнено(СтруктураНастроек.Менеджер) Тогда
		Обработки[СтруктураНастроек.Менеджер].ЗагрузитьЗаказы(СтруктураНастроек, НачалоПериода, КонецПериода);
	Иначе
		Сообщить("Загрузка заказов по учетной записи """ + СтруктураНастроек.УчетнаяЗапись + """ не предусмотрена");
	КонецЕсли;

КонецПроцедуры 


/////////////////////////////////////////////////////////////////////
// ВЫГРУЗКА ЗАКАЗОВ

Процедура ВыгрузитьЗаказы(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда 
		Обработки["eComm_Rozetka"].ВыгрузитьЗаказы(СтруктураНастроек);
	Иначе
		Сообщить("Выгрузка заказов по учетной записи """ + СтруктураНастроек.УчетнаяЗапись + """ не предусмотрена");
	КонецЕсли;

КонецПроцедуры

Функция ВернутьТекстПакетаЗапросовЗаказыКВыгрузкеНаСайт(СтруктураНастроек) Экспорт
	
	ИспользоватьВстроенныйОбработчик = Истина;
	
	ТекстЗапроса = eCommСерверПереопределяемый.ВернутьТекстПакетаЗапросовЗаказыКВыгрузкеНаСайт(СтруктураНастроек, ИспользоватьВстроенныйОбработчик);
	
	Если НЕ ИспользоватьВстроенныйОбработчик = Ложь Тогда 
		
		ИмяДокументаЗаказ 			= eCommСервер.ВернутьИмяДокументЗаказ();
		ИмяРеквизитаЗаказаНомер 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "НомерПоДаннымКлиента");
		ИмяРеквизитаЗаказаИсточник 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Источник");
		ИмяРеквизитаЗаказаТовары 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары");
		ИмяРеквизитаХарактеристика 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары_Характеристика");
		
		ТекстЗапроса = "ВЫБРАТЬ
			|	ДокЗаказИзменения.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВрТабЗаказы
			|ИЗ
			|	Документ.#ИмяДокументаЗаказ#.Изменения КАК ДокЗаказИзменения
			|ГДЕ
			|	ДокЗаказИзменения.Узел = &Узел
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДокЗаказ.Ссылка КАК Заказ,
			|	ДокЗаказ.#ИмяРеквизитаНомерНаСайте# КАК НомерНаСайте,
			|	ДокЗаказ.#ИмяРеквизитаЗаказаИсточник# КАК ИсточникЗаказа
			|ИЗ
			|	Документ.#ИмяДокументаЗаказ# КАК ДокЗаказ
			|ГДЕ
			|	ДокЗаказ.Ссылка В
			|			(ВЫБРАТЬ
			|				ВрТабЗаказы.Ссылка КАК Ссылка
			|			ИЗ
			|				ВрТабЗаказы КАК ВрТабЗаказы)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗаказТовары.Ссылка КАК Заказ,
			|	ЗаказТовары.Номенклатура КАК Номенклатура,
			|	ЗаказТовары.#ИмяРеквизитаХарактеристика# КАК Характеристика,
			|	ЗаказТовары.Количество КАК Количество,
			|	ЗаказТовары.Цена КАК Цена,
			|	ЗаказТовары.Сумма КАК Сумма,
			|	ЗаказТовары.eComm_ИдентификаторСтроки КАК ИдентификаторСтроки,
			|	ЕСТЬNULL(eComm_ИнтернетТовары.Ссылка, Неопределено) КАК ИнтернетТовар,
			|	ЕСТЬNULL(eComm_ИнтернетТовары.Код, 0) КАК ИдентификаторТовара,
			|	ЕСТЬNULL(eComm_ИнтернетТовары.ИдентификаторСервиса, 0) КАК ИдентификаторСервиса
			|ИЗ
			|	Документ.#ИмяДокументаЗаказ#.#ИмяРеквизитаЗаказаТовары# КАК ЗаказТовары
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
			|		ПО ЗаказТовары.Номенклатура = eComm_ИнтернетТовары.Номенклатура
			|			И ЗаказТовары.#ИмяРеквизитаХарактеристика# = eComm_ИнтернетТовары.ХарактеристикаНоменклатуры
			|			И (eComm_ИнтернетТовары.Владелец = &УчетнаяЗапись)
			|ГДЕ
			|	ЗаказТовары.Ссылка В (ВЫБРАТЬ Ссылка ИЗ ВрТабЗаказы)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЗаказТовары.Ссылка,
			|	ЗаказТовары.НомерСтроки";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяДокументаЗаказ#",			ИмяДокументаЗаказ);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизитаНомерНаСайте#", 	ИмяРеквизитаЗаказаНомер);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизитаЗаказаИсточник#",ИмяРеквизитаЗаказаИсточник);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизитаЗаказаТовары#",	ИмяРеквизитаЗаказаТовары);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизитаХарактеристика#",ИмяРеквизитаХарактеристика);
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции


