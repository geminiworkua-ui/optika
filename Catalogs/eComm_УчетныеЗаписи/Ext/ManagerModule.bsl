Процедура ДополнитьТекстыЗапросаТаблицейДополнительныеКатегорииНоменклатуры(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейДополнительныеКатегорииНоменклатуры(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда 
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ИнтернетРеквизиты.Номенклатура КАК Номенклатура,
		|	ИнтернетРеквизиты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		//|	ИнтернетРеквизиты.Ссылка КАК ИнтернетРеквизит,
		|	ТабДополнительныеКатегории.Категория КАК Категория,
		|	ТабДополнительныеКатегории.Категория.Код КАК КодКатегории
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК ИнтернетРеквизиты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары.ДополнительныеКатегории КАК ТабДополнительныеКатегории
		|		ПО (ТабДополнительныеКатегории.Ссылка = ИнтернетРеквизиты.Ссылка)
		|			И (НЕ ТабДополнительныеКатегории.Ссылка = ЗНАЧЕНИЕ(Справочник.eComm_КатегорииТоваров.ПустаяСсылка))
		|			И (ИнтернетРеквизиты.Номенклатура В
		|				(ВЫБРАТЬ
		|					ВрТабТаблицаТоваров.Номенклатура КАК Номенклатура
		|				ИЗ
		|					ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров))
		|			И (ИнтернетРеквизиты.Владелец = &УчетнаяЗапись)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТабДополнительныеКатегории.Категория,
		|	ИнтернетРеквизиты.ХарактеристикаНоменклатуры,
		|	ИнтернетРеквизиты.Номенклатура,
		|	ИнтернетРеквизиты.Ссылка,
		|	ТабДополнительныеКатегории.Категория.Код
		|	
		|УПОРЯДОЧИТЬ ПО
		|	ИнтернетРеквизиты.Ссылка
		//|	,ТабДополнительныеКатегории.НомерСтроки
		|;";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ДополнительныеКатегорииНоменклатуры");

