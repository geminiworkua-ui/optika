// МЕТОДЫ МЕНЕДЖЕРА

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Данные.СрокДействияТокенаAPI)
		И Данные.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда 
		
		Представление = Данные.Наименование + " (" + НСтр("ru = 'Prom.ua: токен действует до '; uk = 'Prom.ua: токен діє до '") + Формат(Данные.СрокДействияТокенаAPI, "ДФ=дд.ММ.гггг") + ")";
		
	Иначе
		
		Представление = Данные.Наименование + " (" + Данные.ТорговаяПлощадка + ")";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("Наименование");
	Поля.Добавить("ТорговаяПлощадка");
	Поля.Добавить("СрокДействияТокенаAPI");
	
	СтандартнаяОбработка = Ложь;

КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ЛИЦЕНЗИРОВАНИЕ

Процедура ЗапроситьЛицензионныйКлюч(СтруктураНастроек, СтруктураЛицензии = "") Экспорт

	Если СтруктураНастроек.Свойство("Менеджер")
		И ЗначениеЗаполнено(СтруктураНастроек.Менеджер) Тогда
		Обработки[СтруктураНастроек.Менеджер].ЗапроситьЛицензионныйКлюч(СтруктураНастроек, СтруктураЛицензии);
	КонецЕсли;

КонецПроцедуры

Функция ТаблицаОпций(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.Свойство("Менеджер")
		И ЗначениеЗаполнено(СтруктураНастроек.Менеджер) Тогда
		Возврат Обработки[СтруктураНастроек.Менеджер].ТаблицаОпций(СтруктураНастроек);
	КонецЕсли;

КонецФункции

Функция ТестовоеПодключениеКСайтуУспешно(СтруктураНастроек) Экспорт
	
	Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда 
		
		Возврат Обработки["eComm_Horoshop"].ТестовоеПодключениеКСайтуУспешно(СтруктураНастроек);
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции


/////////////////////////////////////////////////////////////////////
// ВЫГРУЗКА ТОВАРОВ

Процедура ВыгрузитьТовары(СтруктураНастроек) Экспорт

	ИмяОбработки = Неопределено;
	Если НЕ СтруктураНастроек.Свойство("Менеджер", ИмяОбработки)
		ИЛИ НЕ ЗначениеЗаполнено(ИмяОбработки) Тогда 
		Возврат;
	КонецЕсли;
	
	// Для прома делаем обработку по промовскому сценарию
	Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom 
		И НЕ ИмяОбработки = "eComm_Prom" Тогда 
		
		// Значит старый "типовой" метод выгрузки
		Если НЕ Метаданные.Обработки.Найти(ИмяОбработки) = Неопределено Тогда 
			Обработки[ИмяОбработки].ВыгрузитьТовары(СтруктураНастроек);
		КонецЕсли;

		Возврат;
		
	КонецЕсли;
	
	//RegExp = Новый COMОбъект("VBScript.RegExp");
	//RegExp.IgnoreCase 	= Ложь; 	//Игнорировать регистр   
	//RegExp.Global 		= Истина; 	//Поиск всех вхождений шаблона   
	//RegExp.MultiLine 	= Ложь; 	//Многострочный режим 
	RegExp = Неопределено;
	
	//СтруктураНастроек.Вставить("ВременныйФайл", ПолучитьИмяВременногоФайла(СтруктураНастроек.РасширениеФайла)); 
	СтруктураНастроек.Вставить("СписокФайловКВыгрузке", Новый Массив);
	
	Обработки[СтруктураНастроек.Менеджер].СформироватьПрайс(СтруктураНастроек, RegExp);
	
	ВыгрузкаВФайл = Неопределено;
	Если СтруктураНастроек.Свойство("ВыгрузкаВФайл", ВыгрузкаВФайл) 
		И ВыгрузкаВФайл = Истина Тогда
		
		Для Каждого ДеталиФайла Из СтруктураНастроек.СписокФайловКВыгрузке Цикл 
			// Выгрузка для пользователя
			
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ДеталиФайла.ПутьКФайлуНаДиске);
			АдресВрХранилища 	= ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
			
			УдалитьФайлы(ДеталиФайла.ПутьКФайлуНаДиске);
			
			ДеталиФайла.ПутьКФайлуНаДиске			= "";
			ДеталиФайла.АдресВоВременномХранилище 	= АдресВрХранилища;
		
		КонецЦикла;
		
	Иначе 
		
		Обработки[СтруктураНастроек.Менеджер].СохранитьПрайсНаСервере(СтруктураНастроек);
				
	КонецЕсли;
	
КонецПроцедуры

// Отбор

Функция ВернутьТаблицуТоваров(СтруктураНастроек) Экспорт

	СхемаКомпоновкиДанных = Обработки[СтруктураНастроек.Менеджер].ПолучитьМакет("Подбор");
	
	ТекстЗапросаПоТоварам = eCommСервер.ВернутьТекстЗапросаПоТоварам(СтруктураНастроек);
	
	Если ЗначениеЗаполнено(ТекстЗапросаПоТоварам) Тогда 
		СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Запрос = ТекстЗапросаПоТоварам;
	КонецЕсли;

	ПараметрыКомпоновки = СхемаКомпоновкиДанных.Параметры;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ТипЦены");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, СтруктураНастроек.ТипЦены);
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ТекущаяДата");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, ТекущаяДата());
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ИспользоватьХарактеристики");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, eCommСервер.ВключеноИспользованиеХарактеристик());
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ОграничениеМаксимальогоОстатка");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, СтруктураНастроек.ОграничениеМаксимальогоОстатка);
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ОграничениеМинимальногоОстатка");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, СтруктураНастроек.ОграничениеМинимальногоОстатка);
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ВыгружатьТолькоИзменения");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, СтруктураНастроек.ВыгружатьТолькоИзменения);
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("УчетнаяЗапись");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, СтруктураНастроек.УчетнаяЗапись);
	КонецЕсли;
		
	Попытка 
		Настройки = СтруктураНастроек.НастройкиКомпоновщика;//.Получить();
	Исключение
		Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		ЗаписьЖурналаРегистрации("eComm.ПодготовкаТаблицыТоваров", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
	КонецПопытки;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);

    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
    ТаблицаРезультат = Новый ТаблицаЗначений;
    ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если ТаблицаРезультат.Колонки.Найти("ХарактеристикаНоменклатуры") = Неопределено Тогда 
		// Возможно функциональная опция "Использовать характеристики" отключена
		ТаблицаРезультат.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КонецЕсли;
	
	Если ТаблицаРезультат.Колонки.Найти("Валюта") = Неопределено Тогда 
		// Возможно функциональная опция "Учет в разых валютах" отключена
		ТаблицаРезультат.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	КонецЕсли;
	
	ТаблицаРезультат.Сортировать("Номенклатура Возр");
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Процедура УстановитьПараметрКомпоновки(ЭлементПараметра, ЗначениеПараметра) Экспорт
	
	ЭлементПараметра.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
	ЭлементПараметра.Значение = ЗначениеПараметра;
	
КонецПроцедуры

// Инициализация

Функция ПодготовитьДанныеДляВыгрузки(СтруктураНастроек, ТаблицаТоваров) Экспорт

	СтруктураВозврата 	= Новый Структура();
	
	ТекстыЗапроса 		= Новый СписокЗначений;
	ПараметрыЗапроса 	= Новый Структура("ТаблицаТоваров", ТаблицаТоваров);
	
	СтруктураНастроек.Вставить("ТекущаяДата", ТекущаяДата());
	
	ДополнитьТекстыЗапросаТаблицейКатегории(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейАтрибутыПортальныхКатегорий(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейДополнительныеРеквизиты(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейЗначенияСвойствОбъектовПредставления(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейНоменклатура(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейНоменклатураПредставления(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейДополнительныеКатегорииНоменклатуры(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейСопутствующиеТовары(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейНоменклатураЯрлыки(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейНоменклатураМаркетплейсы(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейИзображенияХарактеристик(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейИзображенияНоменклатуры(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейОптовыеЦены(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейУровниЦенB2B(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейНаборы(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейЦеныНаборов(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейОстаткиНаборов(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаДополнительнымиДанными(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
	ДополнитьТекстыЗапросаТаблицейРазновидности(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса);
		
	// Формирование текст запроса.
	ЗапросТекст = "";
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		ЗапросТекст = ЗапросТекст + ТекстЗапроса.Значение;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = АдаптированныйТекстЗапросаПодКонфигурацию(СтруктураНастроек, ЗапросТекст);
	
	Для Каждого Параметр Из ПараметрыЗапроса Цикл 
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	// Выполнение запроса.
	Результат = Запрос.ВыполнитьПакет();
	
	// Помещение результатов запроса в таблицы
	Для Каждого ТекстЗапроса из ТекстыЗапроса Цикл
		
		ИмяТаблицы = ТекстЗапроса.Представление;
		
		Если Не ПустаяСтрока(ИмяТаблицы) 
			И НЕ ПустаяСтрока(ТекстЗапроса.Значение) Тогда
			
			Индекс = ТекстыЗапроса.Индекс(ТекстЗапроса);
			СтруктураВозврата.Вставить(ИмяТаблицы, Результат[Индекс]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	eCommСерверПереопределяемый.ПодготовитьДополнительныеДанныеДляВыгрузки(СтруктураНастроек, СтруктураВозврата);

	Возврат СтруктураВозврата;
	
КонецФункции

Процедура ДополнитьТекстыЗапросаТаблицейКатегории(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейКатегории(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ТаблицаТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТаблицаТоваров.ИнтернетТовар КАК ИнтернетТовар,
		|	ТаблицаТоваров.КоличествоОстаток КАК КоличествоОстаток,
		|	ТаблицаТоваров.Цена КАК Цена,
		|	ТаблицаТоваров.Валюта КАК Валюта,
		|	ТаблицаТоваров.ЭтоГруппа КАК ЭтоГруппа
		|ПОМЕСТИТЬ ВрТабТаблицаТоваров
		|ИЗ
		|	&ТаблицаТоваров КАК ТаблицаТоваров
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	ХарактеристикаНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КатегорииТоваров.Ссылка КАК Ссылка,
		|	КатегорииТоваров.Код КАК Код,
		|	КатегорииТоваров.Родитель КАК Родитель,
		|	КатегорииТоваров.Родитель.Код КАК РодительКод,
		|	КатегорииТоваров.Наименование КАК Наименование,
		|	КатегорииТоваров.КатегорияНаПортале КАК КатегорияНаПортале,
		|	#ИмяРеквизита_КодКатегорииНаПортале# КАК КатегорияСервисаКод
		|ИЗ
		|	Справочник.eComm_КатегорииТоваров КАК КатегорииТоваров
		|ГДЕ
		|	КатегорииТоваров.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				eComm_ИнтернетТовары.Категория
		|			ИЗ
		|				Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|			ГДЕ
		|				eComm_ИнтернетТовары.Владелец = &УчетнаяЗапись)
		|ИТОГИ ПО
		|	Ссылка ТОЛЬКО ИЕРАРХИЯ
		|АВТОУПОРЯДОЧИВАНИЕ
		|;";
	
	ПараметрыЗапроса.Вставить("УчетнаяЗапись", СтруктураНастроек.УчетнаяЗапись);
	
	ТекстыЗапроса.Добавить("", "ВрТабТаблицаТоваров");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "Категории");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейАтрибутыПортальныхКатегорий(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	Если НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.OLX Тогда 
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	eComm_ИнтернетТовары.КатегорияНаПортале КАК КатегорияНаПортале
		|ПОМЕСТИТЬ ВрТабПортальныеКатегории
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|ГДЕ
		|	eComm_ИнтернетТовары.Владелец = &УчетнаяЗапись
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	eComm_КатегорииТоваров.КатегорияНаПортале
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_КатегорииТоваров КАК eComm_КатегорииТоваров
		|		ПО eComm_ИнтернетТовары.Категория = eComm_КатегорииТоваров.Ссылка
		|ГДЕ
		|	eComm_ИнтернетТовары.Владелец = &УчетнаяЗапись
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АтрибутыПортальныхКатегорий.Ссылка КАК КатегорияНаПортале,
		|	АтрибутыПортальныхКатегорий.Имя КАК Имя,
		|	АтрибутыПортальныхКатегорий.Представление КАК Представление,
		|	АтрибутыПортальныхКатегорий.Обязательное КАК Обязательное,
		|	АтрибутыПортальныхКатегорий.Множественное КАК Множественное
		|ИЗ
		|	Справочник.eComm_КатегорииТорговойПлощадки.СвойстваКатегории КАК АтрибутыПортальныхКатегорий
		|ГДЕ
		|	АтрибутыПортальныхКатегорий.Ссылка В
		|			(ВЫБРАТЬ
		|				ВрТабПортальныеКатегории.КатегорияНаПортале КАК КатегорияНаПортале
		|			ИЗ
		|				ВрТабПортальныеКатегории КАК ВрТабПортальныеКатегории)
		|;";
	
	ТекстыЗапроса.Добавить("", "ВрТабПортальныеКатегории");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "АтрибутыПортальныхКатегорий");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейДополнительныеРеквизиты(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейДополнительныеРеквизиты(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	НоменклатураДополнительныеРеквизиты.#ИмяСсылкиТовараВСвойстве# КАК Ссылка,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
		|	ЕСТЬNULL(СвойстваТоваров.КодСервиса, """") КАК КодСвойстваСервиса,
		|	ВЫБОР
		|		КОГДА НЕ ЕСТЬNULL(СвойстваТоваров.Наименование, """") = """"
		|			ТОГДА СвойстваТоваров.Наименование
		|		ИНАЧЕ НоменклатураДополнительныеРеквизиты.Свойство#ИмяРеквизита_НаименованиеСвойства#
		|	КОНЕЦ КАК Свойство,
		//++
		|	НоменклатураДополнительныеРеквизиты.Значение КАК ЗначениеСвойстваСсылка,
		//|	ВЫБОР 
		//|		КОГДА ТИПЗНАЧЕНИЯ(НоменклатураДополнительныеРеквизиты.Значение) = ТИП(Справочник.ЗначенияСвойствОбъектов)
		//|			ТОГДА НоменклатураДополнительныеРеквизиты.Значение.Наименование
		//|		ИНАЧЕ НоменклатураДополнительныеРеквизиты.Значение 
		//|	КОНЕЦ КАК Значение,
		|	ВЫБОР
        |		КОГДА ТИПЗНАЧЕНИЯ(НоменклатураДополнительныеРеквизиты.Значение) = ТИП(Справочник.ЗначенияСвойствОбъектов)
        |				И НЕ ЕСТЬNULL(ЗначенияСвойств.Наименование, """") = """"
        |			ТОГДА ЗначенияСвойств.Наименование
        |		КОГДА ТИПЗНАЧЕНИЯ(НоменклатураДополнительныеРеквизиты.Значение) = ТИП(Справочник.ЗначенияСвойствОбъектов)
        |				И ЕСТЬNULL(ЗначенияСвойств.Наименование, """") = """"
        |			ТОГДА НоменклатураДополнительныеРеквизиты.Значение.Наименование
        |		ИНАЧЕ НоменклатураДополнительныеРеквизиты.Значение
        |	КОНЕЦ КАК Значение,
		//--
		|	ЕСТЬNULL(ЗначенияСвойств.КодСервиса, """") КАК КодЗначенияСервиса,
		|	#ИмяРеквизита_МножествСвойствоНоменклатуры# КАК МножественныйРеквизит,
		|	ЕСТЬNULL(СвойстваТоваров.ЕдиницаИзмерения, """") КАК ЕдиницаИзмерения,
		|	ЕСТЬNULL(СвойстваТоваров.Модификатор, ЛОЖЬ) КАК ЭтоМодификатор,
		|	""Номенклатура"" КАК ТипОбъекта
		|ПОМЕСТИТЬ ВрТабДополнительныеРеквизиты
		|ИЗ
		|	#ИмяОбъектаСвойствТовара# КАК НоменклатураДополнительныеРеквизиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_СвойстваТоваров КАК СвойстваТоваров
		|		ПО НоменклатураДополнительныеРеквизиты.Свойство = СвойстваТоваров.Свойство
		|			И (СвойстваТоваров.Владелец = &УчетнаяЗапись)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ЗначенияСвойствТоваров КАК ЗначенияСвойств
		|		ПО НоменклатураДополнительныеРеквизиты.Значение = ЗначенияСвойств.ЗначениеСвойства
		|			И (ЗначенияСвойств.Владелец = &УчетнаяЗапись)
		|ГДЕ
		|	НоменклатураДополнительныеРеквизиты.#ИмяСсылкиТовараВСвойстве# ССЫЛКА Справочник.Номенклатура
		|	И НоменклатураДополнительныеРеквизиты.#ИмяСсылкиТовараВСвойстве# В
		|			(ВЫБРАТЬ
		|				ВрТабТаблицаТоваров.Номенклатура
		|			ИЗ
		|				ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров)
		|	И НоменклатураДополнительныеРеквизиты.Свойство.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|		КОГДА СвойстваТоваров.Ссылка ЕСТЬ NULL
		|			ТОГДА Истина
		|		ИНАЧЕ НЕ СвойстваТоваров.Отключить
		|	КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВрТабТаблицаТоваров.Номенклатура,
		|	ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры,
		|	ЕСТЬNULL(СвойстваТоваров.КодСервиса, """"),
		|	ВЫБОР
		|		КОГДА НЕ ЕСТЬNULL(СвойстваТоваров.Наименование, """") = """"
		|			ТОГДА СвойстваТоваров.Наименование
		|		ИНАЧЕ ХарактеристикиДополнительныеРеквизиты.Свойство#ИмяРеквизита_НаименованиеСвойства#
		|	КОНЕЦ,
		//++
		|	ХарактеристикиДополнительныеРеквизиты.Значение,
		//|	ВЫБОР 
		//|		КОГДА ТИПЗНАЧЕНИЯ(ХарактеристикиДополнительныеРеквизиты.Значение) = ТИП(Справочник.ЗначенияСвойствОбъектов)
		//|			ТОГДА ХарактеристикиДополнительныеРеквизиты.Значение.Наименование
		//|		ИНАЧЕ ХарактеристикиДополнительныеРеквизиты.Значение 
		//|	КОНЕЦ КАК Значение,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ХарактеристикиДополнительныеРеквизиты.Значение) = ТИП(Справочник.ЗначенияСвойствОбъектов)
		|				И НЕ ЕСТЬNULL(ЗначенияСвойств.Наименование, """") = """"
		|			ТОГДА ЗначенияСвойств.Наименование
		|		КОГДА ТИПЗНАЧЕНИЯ(ХарактеристикиДополнительныеРеквизиты.Значение) = ТИП(Справочник.ЗначенияСвойствОбъектов)
		|				И ЕСТЬNULL(ЗначенияСвойств.Наименование, """") = """"
		|			ТОГДА ХарактеристикиДополнительныеРеквизиты.Значение.Наименование
		|		ИНАЧЕ ХарактеристикиДополнительныеРеквизиты.Значение
		|	КОНЕЦ,
		//--
		|	ЕСТЬNULL(ЗначенияСвойств.КодСервиса, """"),
		|	#ИмяРеквизита_МножествСвойствоХарактеристики#,
		|	ЕСТЬNULL(СвойстваТоваров.ЕдиницаИзмерения, """"),
		|	ЕСТЬNULL(СвойстваТоваров.Модификатор, ЛОЖЬ),
		|	""Характеристика""
		|ИЗ
		|	ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ #ИмяОбъектаСвойстваХарактеристики# КАК ХарактеристикиДополнительныеРеквизиты
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_СвойстваТоваров КАК СвойстваТоваров
		|			ПО ХарактеристикиДополнительныеРеквизиты.Свойство = СвойстваТоваров.Свойство
		|				И (СвойстваТоваров.Владелец = &УчетнаяЗапись)
		|		ПО ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры = ХарактеристикиДополнительныеРеквизиты.#ИмяСсылкиХарактеристикиВСвойстве#
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ЗначенияСвойствТоваров КАК ЗначенияСвойств
		|		ПО ХарактеристикиДополнительныеРеквизиты.Значение = ЗначенияСвойств.ЗначениеСвойства
		|			И (ЗначенияСвойств.Владелец = &УчетнаяЗапись)
		|ГДЕ
		|	ХарактеристикиДополнительныеРеквизиты.#ИмяСсылкиХарактеристикиВСвойстве# ССЫЛКА Справочник.ХарактеристикиНоменклатуры
		|	И ХарактеристикиДополнительныеРеквизиты.#ИмяСсылкиХарактеристикиВСвойстве# В
		|			(ВЫБРАТЬ
		|				ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры
		|			ИЗ
		|				ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров)
		|	И ХарактеристикиДополнительныеРеквизиты.Свойство.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|		КОГДА СвойстваТоваров.Ссылка ЕСТЬ NULL
		|			ТОГДА Истина
		|		ИНАЧЕ НЕ СвойстваТоваров.Отключить
		|	КОНЕЦ
		|;
		|
	    |ВЫБРАТЬ
		|	ВрТабДополнительныеРеквизиты.Ссылка,
		|	ВрТабДополнительныеРеквизиты.Характеристика,
		|	ВрТабДополнительныеРеквизиты.КодСвойстваСервиса,
		|	ВрТабДополнительныеРеквизиты.КодЗначенияСервиса,
		|	ВрТабДополнительныеРеквизиты.Свойство,
		|	ВрТабДополнительныеРеквизиты.Значение,
		|	ВрТабДополнительныеРеквизиты.ЗначениеСвойстваСсылка,
		|	ВрТабДополнительныеРеквизиты.МножественныйРеквизит,
		|	ВрТабДополнительныеРеквизиты.ЭтоМодификатор,
		|	ВрТабДополнительныеРеквизиты.ЕдиницаИзмерения,
		|	ВрТабДополнительныеРеквизиты.ТипОбъекта
		|ИЗ
		|	ВрТабДополнительныеРеквизиты КАК ВрТабДополнительныеРеквизиты
		|;";
	
	ТекстыЗапроса.Добавить(""			, "ВрТабДополнительныеРеквизиты");
	ТекстыЗапроса.Добавить(ТекстЗапроса	, "ДополнительныеРеквизиты");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейЗначенияСвойствОбъектовПредставления(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)
	
	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейЗначенияСвойствОбъектовПредставления(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если (НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop
		И НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom)
		ИЛИ НЕ eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ИспользоватьМультиязычность") = Истина 
		ИЛИ Метаданные.Справочники.ЗначенияСвойствОбъектов.ТабличныеЧасти.Найти("Представления") = Неопределено Тогда 
		// Мультиязычность интересна только для Horoshop.ua в случае включенности данного функционала
		Возврат;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗначенияСвойствПредставления.Ссылка КАК Ссылка,
		|	ЗначенияСвойствПредставления.КодЯзыка КАК КодЯзыка,
		|	ЗначенияСвойствПредставления.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ЗначенияСвойствОбъектов.Представления КАК ЗначенияСвойствПредставления
		|ГДЕ 
		|	ЗначенияСвойствПредставления.Ссылка В (ВЫБРАТЬ
		|				ВрТабДополнительныеРеквизиты.ЗначениеСвойстваСсылка
		|			ИЗ
		|				ВрТабДополнительныеРеквизиты КАК ВрТабДополнительныеРеквизиты
		|			ГДЕ 
		|				ВрТабДополнительныеРеквизиты.ЗначениеСвойстваСсылка ССЫЛКА Справочник.ЗначенияСвойствОбъектов)
		|	И НЕ ЗначенияСвойствПредставления.КодЯзыка = &КодОсновногоЯзыка
		|	И НЕ ЗначенияСвойствПредставления.Наименование = """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Ссылка,
		|	&КодОсновногоЯзыка,
		|	ЗначенияСвойствОбъектов.Наименование
		|ИЗ
		|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Ссылка В (ВЫБРАТЬ
		|				ВрТабДополнительныеРеквизиты.ЗначениеСвойстваСсылка
		|			ИЗ
		|				ВрТабДополнительныеРеквизиты КАК ВрТабДополнительныеРеквизиты
		|			ГДЕ 
		|				ВрТабДополнительныеРеквизиты.ЗначениеСвойстваСсылка ССЫЛКА Справочник.ЗначенияСвойствОбъектов)
		|
		|;";
	
	Если НЕ ПараметрыЗапроса.Свойство("КодОсновногоЯзыка") Тогда
		ПараметрыЗапроса.Вставить("КодОсновногоЯзыка", eCommСервер.ВернутьОсновнойЯзык());
	КонецЕсли;
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ЗначенияСвойствОбъектовПредставления");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейНоменклатура(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейНоменклатура(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ВрТабТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВрТабТаблицаТоваров.КоличествоОстаток КАК КоличествоОстаток,
		|	ВрТабТаблицаТоваров.Цена КАК Цена,
		|	ВрТабТаблицаТоваров.Валюта КАК Валюта,
		|	ВрТабТаблицаТоваров.ЭтоГруппа КАК ЭтоГруппа,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.Категория, Значение(Справочник.eComm_КатегорииТоваров.ПустаяСсылка)) КАК Категория,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.Категория.Код, """") КАК КодКатегории,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.КатегорияНаПортале, ДопРеквизитыТоваров.Категория.КатегорияНаПортале) КАК КатегорияТовараНаПортале, 
		|	#ИмяРеквизита_КодКатегорииТовараНаПортале# КАК КодКатегорииНаПортале,
		|	#ИмяРеквизита_ЛимитИзображенийНаПортале# КАК ЛимитИзображенийКатегорииНаПортале,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.Код, ""id_not_found"") КАК Код,
		|	СпрНоменклатура.Код КАК НоменклатураКод,
		|	#ИмяРеквизита_Артикул# КАК Артикул,
		|	ВЫБОР
		|		КОГДА НЕ ЕСТЬNULL(ДопРеквизитыТоваров.Наименование, """") = """"
		|			ТОГДА ДопРеквизитыТоваров.Наименование
		|		ИНАЧЕ СпрНоменклатура.Наименование
		|	КОНЕЦ КАК Наименование,
		|	ВЫБОР
		|		КОГДА НЕ ЕСТЬNULL(ВЫРАЗИТЬ(ДопРеквизитыТоваров.Описание КАК Строка(1000)), """") = """"
		|			ТОГДА ДопРеквизитыТоваров.Описание
		|		ИНАЧЕ СпрНоменклатура.#ИмяРеквизита_ОписаниеНоменклатуры#
		|	КОНЕЦ КАК Описание,
		//|	"""" КАК ХарактеристикаКод,
		//|	"""" КАК ХарактеристикаНаименование,
		//|	ЕСТЬNULL(ДопРеквизитыТоваров.ОптоваяЦенаПриЗаказеОт, 0) КАК ОптоваяЦенаПриЗаказеОт,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.ИнтернетСсылка, """") КАК ИнтернетСсылка,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.ИдентификаторСервиса, """") КАК ИдентификаторСервиса,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.КлючевыеСлова, """") КАК КлючевыеСлова,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.seo_Наименование, """") КАК seo_Наименование,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.seo_Описание, """") КАК seo_Описание,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.seo_h1_Заголовок, """") КАК seo_h1_Заголовок,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.URLКартинки, """") КАК URLКартинки,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.АкционнаяСкидка, 0) КАК АкционнаяСкидка,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.ПромоСкидка, 0) КАК ПромоСкидка,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.ОплатаЧастямиПриватБанк, """") КАК ОплатаЧастямиПриватБанк,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.ОплатаЧастямиМонобанк, """") КАК ОплатаЧастямиМонобанк,
		|	ЕСТЬNULL(ДопРеквизитыТоваров.Отключить, Ложь) КАК Отключить,
		|	СпрНоменклатура.#ИмяРеквизита_ИспользоватьХарактеристики# КАК ИспользоватьХарактеристики,
		|	#ИмяРеквизита_ЭтоНабор# КАК ЭтоНабор,
		|	#СпособРасчетаЦеныНабора# КАК СкладыватьИзЦенКомплектующих,
		|	#ИмяРеквизита_ПроизводительНоменклатуры# КАК Производитель,
		|	#ИмяРеквизита_СтранаПроисхождения# КАК СтранаПроисхождения,
		|	#ИмяРеквизита_ИдентификаторПродуктаJoom#
		|	#ИмяРеквизита_ОсновнаяХарактеристика# КАК ОсновнаяХарактеристика
		|	//ДОПОЛНИТЕЛЬНЫЕ РЕКВИЗИТЫ
		|ИЗ
		|	ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|		ПО ВрТабТаблицаТоваров.Номенклатура = СпрНоменклатура.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары КАК ДопРеквизитыТоваров
		|		ПО ВрТабТаблицаТоваров.Номенклатура = ДопРеквизитыТоваров.Номенклатура
		|			И (ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры = ДопРеквизитыТоваров.ХарактеристикаНоменклатуры)
		|			И (ДопРеквизитыТоваров.Владелец = &УчетнаяЗапись)
		|		#СоединениеТаблицаАртикуловХарактеристик#
		|		#СоединениеЗначенияНоменклатурыПоУмолчанию#
		|		//ДОПОЛНИТЕЛЬНЫЕ СОЕДИНЕНИЯ
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура,
		|	ОсновнаяХарактеристика УБЫВ,
		|	ХарактеристикаНоменклатуры
		|ИТОГИ
		|	МАКСИМУМ(ИспользоватьХарактеристики)
		|ПО
		|	Номенклатура		
		|;";
		
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "Номенклатура");

