Процедура ДополнитьТекстыЗапросаТаблицейНоменклатураПредставления(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейНоменклатураПредставления(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ИспользоватьМультиязычность") = Истина Тогда 
		// Мультиязычность интересна только для Horoshop.ua в случае включенности данного функционала
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ИнтернетРеквизитыПредставления.Ссылка КАК ИнтернетРеквизит,
		|	ИнтернетРеквизитыПредставления.КодЯзыка КАК КодЯзыка,
		|	ИнтернетРеквизитыПредставления.Наименование КАК Наименование,
		|	ИнтернетРеквизитыПредставления.Описание КАК Описание,
		|	ИнтернетРеквизитыПредставления.КлючевыеСлова КАК КлючевыеСлова,
		|	ИнтернетРеквизитыПредставления.seo_Наименование КАК seo_Наименование,
		|	ИнтернетРеквизитыПредставления.seo_Описание КАК seo_Описание,
		|	ИнтернетРеквизитыПредставления.seo_h1_Заголовок КАК seo_h1_Заголовок,
		|	ИнтернетРеквизиты.Номенклатура КАК Номенклатура,
		|	ИнтернетРеквизиты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК ИнтернетРеквизиты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары.Представления КАК ИнтернетРеквизитыПредставления
		|		ПО (ИнтернетРеквизитыПредставления.Ссылка = ИнтернетРеквизиты.Ссылка)
		|ГДЕ
		|	ИнтернетРеквизиты.Номенклатура В
		|			(ВЫБРАТЬ
		|				ВрТабТаблицаТоваров.Номенклатура
		|			ИЗ
		|				ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров)
		|	И ИнтернетРеквизиты.Владелец = &УчетнаяЗапись
		|;";
	
	ПараметрыЗапроса.Вставить("УчетнаяЗапись", СтруктураНастроек.УчетнаяЗапись);

	ТекстыЗапроса.Добавить(ТекстЗапроса, "НоменклатураПредставления");

