	ТекстыЗапроса.Добавить(ТекстЗапроса, "НоменклатураМаркетплейсы");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейОптовыеЦены(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейОптовыеЦены(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураНастроек.Свойство("ОптовыеЦены") 
		ИЛИ НЕ ТипЗнч(СтруктураНастроек.ОптовыеЦены) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ОптовыеЦены.ВидЦены КАК ВидЦены,
		|	ОптовыеЦены.ВидЦены.ВалютаЦены КАК Валюта,
		|	ИСТИНА КАК ЭтоОпт
		|ПОМЕСТИТЬ ВрТабОптовыеЦены
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи.ОптовыеЦены КАК ОптовыеЦены
		|ГДЕ
		|	ОптовыеЦены.Ссылка = &УчетнаяЗапись
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УчетныеЗаписи.ТипЦены,
		|	УчетныеЗаписи.ТипЦены.ВалютаЦены КАК Валюта,
		|	ЛОЖЬ
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи КАК УчетныеЗаписи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВрТабТаблицаТоваров.ИнтернетТовар КАК ИнтернетТовар,
		|	ВрТабОптовыеЦены.ВидЦены КАК ВидЦен,
		|	ВрТабОптовыеЦены.Валюта КАК Валюта
		|ПОМЕСТИТЬ ВрТабНоменклатураВидыЦен
		|ИЗ
		|	ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабОптовыеЦены КАК ВрТабОптовыеЦены
		|		ПО (ВрТабОптовыеЦены.ЭтоОпт = ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабНоменклатураВидыЦен.Номенклатура КАК Номенклатура,
		|	ВрТабНоменклатураВидыЦен.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВрТабНоменклатураВидыЦен.ВидЦен КАК ВидЦен,
		|	#ИмяРеквизита_Валюта_ОптЦены# КАК Валюта,
		|	ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0) КАК Цена,
		|	ТаблицаОптовыеЦеныИнтернетТоваров.ОптоваяЦенаПриЗаказеОт КАК ОптоваяЦенаПриЗаказеОт
		|ИЗ
		|	ВрТабНоменклатураВидыЦен КАК ВрТабНоменклатураВидыЦен
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|				&ТекущаяДата,
		|				(Номенклатура, #ИмяРеквизита_ЦеныНоменклатуры_Характеристика#, #ИмяРеквизита_ВидЦен#) В
		|					(ВЫБРАТЬ
		|						ВрТабНоменклатураВидыЦен.Номенклатура КАК Номенклатура,
		|						ВрТабНоменклатураВидыЦен.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|						ВрТабНоменклатураВидыЦен.ВидЦен КАК ВидЦен
		|					ИЗ
		|						ВрТабНоменклатураВидыЦен КАК ВрТабНоменклатураВидыЦен)) КАК ЦеныНоменклатуры
		|		ПО ВрТабНоменклатураВидыЦен.Номенклатура = ЦеныНоменклатуры.Номенклатура
		|			И ВрТабНоменклатураВидыЦен.ХарактеристикаНоменклатуры = ЦеныНоменклатуры.#ИмяРеквизита_ЦеныНоменклатуры_Характеристика#
		|			И ВрТабНоменклатураВидыЦен.ВидЦен = ЦеныНоменклатуры.#ИмяРеквизита_ВидЦен#
		|
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары.ОптовыеЦены КАК ТаблицаОптовыеЦеныИнтернетТоваров
		|			ПО ВрТабНоменклатураВидыЦен.ИнтернетТовар = ТаблицаОптовыеЦеныИнтернетТоваров.Ссылка
		|				И ВрТабНоменклатураВидыЦен.ВидЦен = ТаблицаОптовыеЦеныИнтернетТоваров.ВидЦены
		|;";
	
	ПараметрыЗапроса.Вставить("ТекущаяДата", СтруктураНастроек.ТекущаяДата);
	
	ТекстыЗапроса.Добавить(""			, "ВрТабОптовыеЦены");
	ТекстыЗапроса.Добавить(""			, "ВрТабНоменклатураВидыЦен");
	ТекстыЗапроса.Добавить(ТекстЗапроса	, "ОптовыеЦены");

КонецПроцедуры

Процедура ДополнитьТекстыЗапросаТаблицейУровниЦенB2B(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса)

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	eCommСерверПереопределяемый.ДополнитьТекстыЗапросаТаблицейУровниЦенB2B(СтруктураНастроек, ТекстыЗапроса, ПараметрыЗапроса, ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop 
		ИЛИ НЕ СтруктураНастроек.Свойство("УровниЦенB2B") Тогда
		// Требуется для функционала B2B horoshop.ua
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	УровниЦенB2B.ВидЦены КАК ВидЦены,
		|	УровниЦенB2B.ВидЦены.ВалютаЦены КАК Валюта
		|ПОМЕСТИТЬ ВрТабУровниЦенB2B
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи.УровниЦенB2B КАК УровниЦенB2B
		|ГДЕ
		|	УровниЦенB2B.Ссылка = &УчетнаяЗапись
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ВрТабТаблицаТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВрТабТаблицаТоваров.ИнтернетТовар КАК ИнтернетТовар,
		|	ВрТабУровниЦенB2B.ВидЦены КАК ВидЦен,
		|	ВрТабУровниЦенB2B.Валюта КАК Валюта
		|ПОМЕСТИТЬ ВрТабНоменклатураУровниЦенB2B
		|ИЗ
		|	ВрТабТаблицаТоваров КАК ВрТабТаблицаТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабУровниЦенB2B КАК ВрТабУровниЦенB2B
		|		ПО (ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабНоменклатураУровниЦенB2B.Номенклатура КАК Номенклатура,
		|	ВрТабНоменклатураУровниЦенB2B.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВрТабНоменклатураУровниЦенB2B.ВидЦен КАК ВидЦен,
		|	#ИмяРеквизита_Валюта_УровниЦен# КАК Валюта,
		|	ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0) КАК Цена
		|ИЗ
		|	ВрТабНоменклатураУровниЦенB2B КАК ВрТабНоменклатураУровниЦенB2B
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|				&ТекущаяДата,
		|				(Номенклатура, #ИмяРеквизита_ЦеныНоменклатуры_Характеристика#, #ИмяРеквизита_ВидЦен#) В
		|					(ВЫБРАТЬ
		|						ВрТабНоменклатураУровниЦенB2B.Номенклатура КАК Номенклатура,
		|						ВрТабНоменклатураУровниЦенB2B.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|						ВрТабНоменклатураУровниЦенB2B.ВидЦен КАК ВидЦен
		|					ИЗ
		|						ВрТабНоменклатураУровниЦенB2B КАК ВрТабНоменклатураУровниЦенB2B)) КАК ЦеныНоменклатуры
		|		ПО ВрТабНоменклатураУровниЦенB2B.Номенклатура = ЦеныНоменклатуры.Номенклатура
		|			И ВрТабНоменклатураУровниЦенB2B.ХарактеристикаНоменклатуры = ЦеныНоменклатуры.#ИмяРеквизита_ЦеныНоменклатуры_Характеристика#
		|			И ВрТабНоменклатураУровниЦенB2B.ВидЦен = ЦеныНоменклатуры.#ИмяРеквизита_ВидЦен#
		|;";
	
	ПараметрыЗапроса.Вставить("ТекущаяДата", СтруктураНастроек.ТекущаяДата);
	
	ТекстыЗапроса.Добавить(""			, "ВрТабУровниЦенB2B");
	ТекстыЗапроса.Добавить(""			, "ВрТабНоменклатураУровниЦенB2B");
	ТекстыЗапроса.Добавить(ТекстЗапроса	, "УровниЦенB2B");

