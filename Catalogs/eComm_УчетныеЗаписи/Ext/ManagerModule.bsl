// СИНХРОНИЗАЦИЯ СТАТУСОВ ОПЛАТ

Функция ЗагрузитьСтатусыОплатПоЗаказам(СтруктураНастроек, НачалоПериода, КонецПериода) Экспорт

	Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда 
		Обработки["eComm_Prom"].ЗагрузитьСтатусыОплатПоЗаказам(СтруктураНастроек, НачалоПериода, КонецПериода);
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда 
		Обработки["eComm_Rozetka"].ЗагрузитьСтатусыОплатПоЗаказам(СтруктураНастроек, НачалоПериода, КонецПериода);
	Иначе
		Сообщить("Загрузка статусов оплат по учетной записи """ + СтруктураНастроек.УчетнаяЗапись + """ не предусмотрена");
	КонецЕсли;	

КонецФункции


/////////////////////////////////////////////////////////////////////
// СИНХРОНИЗАЦИЯ СТАТУСОВ ЗАКАЗОВ

Функция ПолучитьСпособыОплаты(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда
		Возврат Обработки["eComm_Horoshop"].СпособыОплаты(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда
		Возврат Обработки["eComm_Prom"].СпособыОплаты(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда
		Возврат Обработки["eComm_Rozetka"].СпособыОплаты(СтруктураНастроек);
	КонецЕсли;

КонецФункции




