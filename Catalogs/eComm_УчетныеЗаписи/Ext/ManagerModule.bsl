// СИНХРОНИЗАЦИЯ СТАТУСОВ ЗАКАЗОВ

Процедура СинхронизироватьСтатусыЗаказов(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда
		Обработки["eComm_Rozetka"].СинхронизироватьСтатусыЗаказов(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда
		Обработки["eComm_Prom"].СинхронизироватьСтатусыЗаказов(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда
		Обработки["eComm_Horoshop"].СинхронизироватьСтатусыЗаказов(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Allo Тогда
		Обработки["eComm_Allo"].СинхронизироватьСтатусыЗаказов(СтруктураНастроек);
	Иначе
		Сообщить("Загрузка заказов по учетной записи """ + СтруктураНастроек.УчетнаяЗапись + """ не предусмотрена");
	КонецЕсли;	

КонецПроцедуры

Процедура АктуализироватьСправочникСтатусов(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда
		Обработки["eComm_Rozetka"].АктуализироватьСправочникСтатусов(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда
		Обработки["eComm_Prom"].АктуализироватьСправочникСтатусов(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда
		Обработки["eComm_Horoshop"].АктуализироватьСправочникСтатусов(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Allo Тогда
		Обработки["eComm_Allo"].АктуализироватьСправочникСтатусов(СтруктураНастроек);
	КонецЕсли;

КонецПроцедуры

Функция ПодготовитьДанныеДляВыгрузкиСтатусовЗаказов(СтруктураНастроек) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = ВернутьТекстЗапросаСтатусыЗаказовКСинхронизации(СтруктураНастроек);
	Запрос.УстановитьПараметр("УчетнаяЗапись", СтруктураНастроек.УчетнаяЗапись);
	
	ТаблицаЗаказовКИзменениюСтатусов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаЗаказовКИзменениюСтатусов;

КонецФункции

Функция ВернутьТекстЗапросаСтатусыЗаказовКСинхронизации(СтруктураНастроек)

	ИспользоватьВстроенныйОбработчик = Истина;
	
	ТекстЗапроса = eCommСерверПереопределяемый.ВернутьТекстЗапросаСтатусыЗаказовКСинхронизации(СтруктураНастроек, ИспользоватьВстроенныйОбработчик);
	
	Если НЕ ИспользоватьВстроенныйОбработчик = Ложь Тогда 
		
		ИмяРеквизита_НомерПоДаннымКлиента 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "НомерПоДаннымКлиента");
		ИмяРеквизита_ТрекНомер				= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "ТрекНомер");
		
		Если НЕ СтруктураНастроек.Свойство("Используется_eCommДоставка")
			ИЛИ НЕ СтруктураНастроек.Используется_eCommДоставка = Истина Тогда 
			
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 99
				|	ЗаказыКИзменениюСтатусов.Период КАК Период,
				|	ЗаказыКИзменениюСтатусов.Заказ КАК Заказ,
				|	ЗаказыКИзменениюСтатусов.Статус.Наименование КАК Статус,
				|	ЗаказыКИзменениюСтатусов.Заказ.#ИмяРеквизита_НомерПоДаннымКлиента# КАК НомерПоДаннымКлиента,
				|	#ИмяРеквизита_ТрекНомер# КАК НомерТТН,
				|	""nova_poshta"" КАК СлужбаДоставки,
				|	ЗаказыКИзменениюСтатусов.Статус.ПричинаОтменыСервиса КАК ПричинаОтменыСервиса,      // Используется только для Prom.ua
				|	"""" КАК ОписаниеПричиныОтмены,       												// Используется только для Prom.ua
				|	ЗаказыКИзменениюСтатусов.Статус.ПользовательскийСтатус КАК ПользовательскийСтатус	// Используется только для Prom.ua
				|ИЗ
				|	РегистрСведений.eComm_ЗаказыКИзменениюСтатусов КАК ЗаказыКИзменениюСтатусов
				|ГДЕ
				|	ЗаказыКИзменениюСтатусов.УчетнаяЗапись = &УчетнаяЗапись
				|	И НЕ ЗаказыКИзменениюСтатусов.Заказ.#ИмяРеквизита_НомерПоДаннымКлиента# = """"
				|
				|УПОРЯДОЧИТЬ ПО
				|	Период";
			
		Иначе
			
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 99
				|	ЗаказыКИзменениюСтатусов.Период КАК Период,
				|	ЗаказыКИзменениюСтатусов.Заказ КАК Заказ,
				|	ЗаказыКИзменениюСтатусов.Статус.Наименование КАК Статус,
				|	ЗаказыКИзменениюСтатусов.Статус.ПользовательскийСтатус КАК ПользовательскийСтатус,	// Используется только для Prom.ua
				|	ЗаказыКИзменениюСтатусов.Заказ.#ИмяРеквизита_НомерПоДаннымКлиента# КАК НомерПоДаннымКлиента,
				|	ЗаказыКИзменениюСтатусов.Статус.ПричинаОтменыСервиса КАК ПричинаОтменыСервиса,
				|	"""" КАК ОписаниеПричиныОтмены
				|ПОМЕСТИТЬ ВрТабЗаказы
				|ИЗ
				|	РегистрСведений.eComm_ЗаказыКИзменениюСтатусов КАК ЗаказыКИзменениюСтатусов
				|ГДЕ
				|	ЗаказыКИзменениюСтатусов.УчетнаяЗапись = &УчетнаяЗапись
				|	И НЕ ЗаказыКИзменениюСтатусов.Заказ.#ИмяРеквизита_НомерПоДаннымКлиента# = """"
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	МАКСИМУМ(eComm_ЭкспрессНакладная.Дата) КАК Дата,
				|	eComm_ЭкспрессНакладная.ДокументОснование КАК ДокументОснование
				|ПОМЕСТИТЬ ВрТабДатыЭкспрессНакладных
				|ИЗ
				|	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
				|ГДЕ
				|	eComm_ЭкспрессНакладная.ПометкаУдаления = ЛОЖЬ
				|	И eComm_ЭкспрессНакладная.ДокументОснование В
				|			(ВЫБРАТЬ
				|				ВрТабЗаказы.Заказ КАК Заказ
				|			ИЗ
				|				ВрТабЗаказы КАК ВрТабЗаказы)
				|	И НЕ eComm_ЭкспрессНакладная.НомерТТН = """"
				|
				|СГРУППИРОВАТЬ ПО
				|	eComm_ЭкспрессНакладная.ДокументОснование
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВрТабДатыЭкспрессНакладных.ДокументОснование КАК ДокументОснование,
				|	МАКСИМУМ(eComm_ЭкспрессНакладная.Ссылка) КАК Ссылка
				|ПОМЕСТИТЬ ВрТабЭкспрессНакладныеЗаказов
				|ИЗ
				|	ВрТабДатыЭкспрессНакладных КАК ВрТабДатыЭкспрессНакладных
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
				|		ПО ВрТабДатыЭкспрессНакладных.ДокументОснование = eComm_ЭкспрессНакладная.ДокументОснование
				|			И ВрТабДатыЭкспрессНакладных.Дата = eComm_ЭкспрессНакладная.Дата
				|
				|СГРУППИРОВАТЬ ПО
				|	ВрТабДатыЭкспрессНакладных.ДокументОснование
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВрТабЭкспрессНакладныеЗаказов.ДокументОснование КАК ДокументОснование,
				|	ВрТабЭкспрессНакладныеЗаказов.Ссылка КАК Ссылка,
				|	eComm_ЭкспрессНакладная.НомерТТН КАК НомерТТН,
				|	eComm_ЭкспрессНакладная.УчетнаяЗапись.СлужбаДоставки КАК СлужбаДоставки
				|ПОМЕСТИТЬ ВрТабДанныеЭкспрессНакладных
				|ИЗ
				|	ВрТабЭкспрессНакладныеЗаказов КАК ВрТабЭкспрессНакладныеЗаказов
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
				|		ПО ВрТабЭкспрессНакладныеЗаказов.Ссылка = eComm_ЭкспрессНакладная.Ссылка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВрТабЗаказы.Период КАК Период,
				|	ВрТабЗаказы.Заказ КАК Заказ,
				|	ВрТабЗаказы.Статус КАК Статус,
				|	ВрТабЗаказы.НомерПоДаннымКлиента КАК НомерПоДаннымКлиента,
				|	ВрТабЗаказы.ПричинаОтменыСервиса КАК ПричинаОтменыСервиса,
				|	ВрТабЗаказы.ОписаниеПричиныОтмены КАК ОписаниеПричиныОтмены,
				|	ВрТабЗаказы.ПользовательскийСтатус КАК ПользовательскийСтатус,
				|	ВрТабДанныеЭкспрессНакладных.НомерТТН КАК НомерТТН,
				|	ВЫБОР
				|		КОГДА ВрТабДанныеЭкспрессНакладных.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.НоваяПочта)
				|			ТОГДА ""nova_poshta""
				|		КОГДА ВрТабДанныеЭкспрессНакладных.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.УкрПочта)
				|			ТОГДА ""ukrposhta""
				|		КОГДА ВрТабДанныеЭкспрессНакладных.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Justin)
				|			ТОГДА ""justin""
				|		КОГДА ВрТабДанныеЭкспрессНакладных.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Meest)
				|			ТОГДА ""meest""
				|		ИНАЧЕ """"
				|	КОНЕЦ КАК СлужбаДоставки
				|ИЗ
				|	ВрТабЗаказы КАК ВрТабЗаказы
				|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТабДанныеЭкспрессНакладных КАК ВрТабДанныеЭкспрессНакладных
				|		ПО ВрТабЗаказы.Заказ = ВрТабДанныеЭкспрессНакладных.ДокументОснование
				|
				|УПОРЯДОЧИТЬ ПО
				|	Период";
			
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_НомерПоДаннымКлиента#"	, ИмяРеквизита_НомерПоДаннымКлиента);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_ТрекНомер#"				, ?(ИмяРеквизита_ТрекНомер = "", """""", "ЗаказыКИзменениюСтатусов.Заказ." + ИмяРеквизита_ТрекНомер));		
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции


/////////////////////////////////////////////////////////////////////
// EVO-PAY

Функция ВернутьТекстЗапросаОперацииПоПлатежнымКартам(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	*
			|ПОМЕСТИТЬ
			|	втДанные
			|ИЗ
			|	&Данные КАК Данные
			|;
			|
			|ВЫБРАТЬ
			|	втДанные.ДатаПеречисления КАК Дата,
			|	втДанные.СуммаПеречисленныхСредств КАК СуммаДокумента,
			|	втДанные.ЭлектронноеПлатежноеСредство КАК НомерПлатежнойКарты,
			|	втДанные.СуммаКомиссииСПолучателя КАК СуммаКомиссииПоДоговору,
			|	Документ_Заказ.Ссылка КАК ЗаказПокупателя,
			|	Документ_Заказ.ДоговорКонтрагента КАК Договор,
			|	Документ_ОперацияПоПлатежнымКартам.Ссылка КАК ОперацияПоПлатежнымКартам,
			|	ЕСТЬNULL(Документ_ОперацияПоПлатежнымКартам.Ссылка.Проведен, ЛОЖЬ) КАК ОперацияПоПлатежнымКартам_Проведен
			|ИЗ
			|	втДанные
			|	ЛЕВОЕ СОЕДИНЕНИЕ
			|		Документ.ЗаказПокупателя КАК Документ_Заказ
			|	ПО
			|		(Документ_Заказ.ПометкаУдаления = Ложь)
			|		И (Документ_Заказ.НомерВходящегоДокументаЭлектронногоОбмена = втДанные.НомерЗаказа)
			|	ЛЕВОЕ СОЕДИНЕНИЕ
			|		Документ.ОплатаОтПокупателяПлатежнойКартой.РасшифровкаПлатежа КАК Документ_ОперацияПоПлатежнымКартам
			|	ПО
			|		(НЕ Документ_ОперацияПоПлатежнымКартам.Ссылка.ПометкаУдаления)
			|		И (Документ_ОперацияПоПлатежнымКартам.НомерСтроки = 1)
			|		И (Документ_ОперацияПоПлатежнымКартам.Сделка = Документ_Заказ.Ссылка)
			|";
			
	ИначеЕсли СтруктураНастроек.ИмяКонфигурации = "BASSmallBusiness" Тогда
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	*
			|ПОМЕСТИТЬ
			|	втДанные
			|ИЗ
			|	&Данные КАК Данные
			|;
			|
			| ВЫБРАТЬ
			|	втДанные.ДатаПеречисления КАК Дата,
			|	втДанные.СуммаПеречисленныхСредств КАК СуммаДокумента,
			|	втДанные.ЭлектронноеПлатежноеСредство КАК НомерПлатежнойКарты,
			|	втДанные.СуммаКомиссииСПолучателя КАК СуммаКомиссииПоДоговору,
			|	"""" КАК ВидПлатежнойКарты,
			|	ЗаказыПокупателейССайта.ЗаказПокупателя КАК ЗаказПокупателя,
			|	ЗаказыПокупателейССайта.ЗаказПокупателя.Договор КАК Договор,
			|	Документ_ОперацияПоПлатежнымКартам.Ссылка КАК ОперацияПоПлатежнымКартам,
			|	ЕСТЬNULL(Документ_ОперацияПоПлатежнымКартам.Проведен, ЛОЖЬ) КАК ОперацияПоПлатежнымКартам_Проведен
			|ИЗ
			|	втДанные
			|	ЛЕВОЕ СОЕДИНЕНИЕ
			|		РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыПокупателейССайта
			|	ПО
			|		(ЗаказыПокупателейССайта.НомерЗаказаНаСайте = втДанные.НомерЗаказа)
			|	ЛЕВОЕ СОЕДИНЕНИЕ
			|		Документ.ОперацияПоПлатежнымКартам КАК Документ_ОперацияПоПлатежнымКартам
			|	ПО
			|		(НЕ Документ_ОперацияПоПлатежнымКартам.ПометкаУдаления)
			|		И (Документ_ОперацияПоПлатежнымКартам.ДокументОснование = ЗаказыПокупателейССайта.ЗаказПокупателя)
			|";
		
	Иначе
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	*
			|ПОМЕСТИТЬ
			|	втДанные
			|ИЗ
			|	&Данные КАК Данные
			|;
			|
			|ВЫБРАТЬ
			|	втДанные.ДатаПеречисления КАК Дата,
			|	втДанные.СуммаПеречисленныхСредств КАК СуммаДокумента,
			|	втДанные.ЭлектронноеПлатежноеСредство КАК НомерПлатежнойКарты,
			|	втДанные.СуммаКомиссииСПолучателя КАК СуммаКомиссииПоДоговору,
			|	Документ_Заказ.Ссылка КАК ЗаказПокупателя,
			|	Документ_Заказ.Договор КАК Договор,
			|	Документ_ОперацияПоПлатежнымКартам.Ссылка КАК ОперацияПоПлатежнымКартам,
			|	ЕСТЬNULL(Документ_ОперацияПоПлатежнымКартам.Ссылка.Проведен, ЛОЖЬ) КАК ОперацияПоПлатежнымКартам_Проведен
			|ИЗ
			|	втДанные
			|	ЛЕВОЕ СОЕДИНЕНИЕ
			|		Документ.ЗаказКлиента КАК Документ_Заказ
			|	ПО
			|		(Документ_Заказ.ПометкаУдаления = Ложь)
			|		И (Документ_Заказ.НомерПоДаннымКлиента = втДанные.НомерЗаказа)
			|	ЛЕВОЕ СОЕДИНЕНИЕ
			|		Документ.ОперацияПоПлатежнойКарте.РасшифровкаПлатежа КАК Документ_ОперацияПоПлатежнымКартам
			|	ПО
			|		(НЕ Документ_ОперацияПоПлатежнымКартам.Ссылка.ПометкаУдаления)
			|		И (Документ_ОперацияПоПлатежнымКартам.НомерСтроки = 1)
			|		И (Документ_ОперацияПоПлатежнымКартам.ОснованиеПлатежа = Документ_Заказ.Ссылка)
			|";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции