
Процедура ПередЗаписью(Отказ)
	
	Если Прав(АдресAPI, 1) = "/" Тогда 
		ДлинаАдреса = СтрДлина(АдресAPI);
		АдресAPI 	= Сред(АдресAPI, 1, ДлинаАдреса - 1);
	КонецЕсли;
	
	Сервер = СокрЛП(Сервер);
	Если Прав(Сервер, 1) = "\" Тогда 
		ДлинаАдресаСервера = СтрДлина(Сервер);
		Сервер 	= Сред(Сервер, 1, ДлинаАдресаСервера - 1);
	КонецЕсли;
	
	ЛицензионныйКлюч = СокрЛП(ЛицензионныйКлюч);
	
	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka 
		И ВыгружатьЗаказы = Истина Тогда 
		
		ИмяДокументаЗаказ 	= eCommСервер.ВернутьИмяДокументЗаказ();
		ИмяТЧТовары 		= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары");

		МетаданныеТЧТовары = Метаданные.Документы[ИмяДокументаЗаказ].ТабличныеЧасти.Найти(ИмяТЧТовары);
		
		Если МетаданныеТЧТовары.Реквизиты.Найти("eComm_ИдентификаторСтроки") = Неопределено Тогда
			
			ВыгружатьЗаказы = Ложь;
			Отказ = Истина;
			
			Сообщить(НСтр("ru = 'Выполнены не все требования по встраиванию модуля ""Rozetka.ua"". 
                          |Подробнее см. http://wiki.ingenumeurope.com';
						  |uk = 'Виконані не всі не всі вимоги по інтеграції модуля ""Rozetka.ua"". 
                          |Детальніше див. http://wiki.ingenumeurope.com'"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ВыгружатьТолькоИзменения 
		ИЛИ ВыгружатьЗаказы Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	eComm_Обмен.Ссылка КАК Ссылка
			|ИЗ
			|	ПланОбмена.eComm_Обмен КАК eComm_Обмен
			|ГДЕ
			|	eComm_Обмен.УчетнаяЗапись = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда 
			// Создадим служебный узел обмена для 
			// отслеживания изменений
			УзелОбмена = ПланыОбмена.eComm_Обмен.СоздатьУзел();
			УзелОбмена.УстановитьНовыйКод();
			УзелОбмена.Наименование = Наименование;
			УзелОбмена.УчетнаяЗапись = Ссылка;
			УзелОбмена.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	РегламентноеЗаданиеОбменаТоварами = Неопределено;
	РегламентноеЗаданиеОбменаЗаказами = Неопределено;
	
КонецПроцедуры


