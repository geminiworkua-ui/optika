	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникeComm_УчетныеЗаписи.Ссылка КАК Ссылка,
	СправочникeComm_УчетныеЗаписи.Код КАК Код,
	СправочникeComm_УчетныеЗаписи.ВыгружатьТовары КАК ВыгружатьТовары,
	СправочникeComm_УчетныеЗаписи.ЗагружатьЗаказы КАК ЗагружатьЗаказы,
	СправочникeComm_УчетныеЗаписи.СинхронизироватьСтатусыЗаказов КАК СинхронизироватьСтатусыЗаказов,
	СостояниеОбменовЗаказами.ДатаОкончания КАК ОбменЗаказами,
	СостояниеОбменовТоварами.ДатаОкончания КАК ОбменТоварами
ИЗ
	Справочник.eComm_УчетныеЗаписи КАК СправочникeComm_УчетныеЗаписи
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.eComm_СостояниеОбменовДанными КАК СостояниеОбменовТоварами
		ПО СправочникeComm_УчетныеЗаписи.Ссылка = СостояниеОбменовТоварами.УчетнаяЗапись
			И (СостояниеОбменовТоварами.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.eComm_ДействияПриОбмене.ОбменТоварами))
			И (СостояниеОбменовТоварами.ПрофильНастроек = ЗНАЧЕНИЕ(Справочник.eComm_ПрофилиНастроекУчетнойЗаписи.ПустаяСсылка))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.eComm_СостояниеОбменовДанными КАК СостояниеОбменовЗаказами
		ПО СправочникeComm_УчетныеЗаписи.Ссылка = СостояниеОбменовЗаказами.УчетнаяЗапись
			И (СостояниеОбменовЗаказами.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.eComm_ДействияПриОбмене.ОбменЗаказами))
			И (СостояниеОбменовЗаказами.ПрофильНастроек = ЗНАЧЕНИЕ(Справочник.eComm_ПрофилиНастроекУчетнойЗаписи.ПустаяСсылка))</QueryText>
				<MainTable>Catalog.eComm_УчетныеЗаписи</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
