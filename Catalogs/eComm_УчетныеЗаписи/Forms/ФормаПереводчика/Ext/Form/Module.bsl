
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УчетнаяЗапись", УчетнаяЗапись);
	
	ОсновнойЯзык = eCommСервер.ВернутьОсновнойЯзык();
	
	ЯзыкиКонфигурации = eCommСервер.ВернутьЯзыкиКонфигурации();
	
	Для Каждого Язык Из ЯзыкиКонфигурации Цикл 
		Если Язык = ОсновнойЯзык Тогда 
			ЯзыкС = Язык;
		Иначе
			Элементы.ЯзыкНа.СписокВыбора.Добавить(Язык);
		КонецЕсли;
	КонецЦикла;
	
	Если Элементы.ЯзыкНа.СписокВыбора.Количество() = 1 Тогда 
		ЯзыкНа = Элементы.ЯзыкНа.СписокВыбора[0].Значение;
		Элементы.ЯзыкНа.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ЯзыкНа.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	ЗаполнитьВариантИспользованияПереводчикаПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьПараметрыВыбора();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ЭЛЕМЕНТОВ СОБЫТИЙ ФОРМЫ

&НаКлиенте
Процедура ОбъектыЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	УстановитьПараметрыВыбора();

КонецПроцедуры

&НаКлиенте
Процедура УчетнаяЗаписьПриИзменении(Элемент)
	
	ЗаполнитьВариантИспользованияПереводчикаПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	ВыполнитьОбработкуНаСервере();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура ВыполнитьОбработкуНаСервере()
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЯзыкНа = ОсновнойЯзык Тогда 
		Сообщить("Перевод возможен только на дополнительный язык.");
		Возврат;
	КонецЕсли;
	
	Настройки 		= eCommСервер.Настройки(УчетнаяЗапись);
	ПереводСервис 	= eCommСервер.ВернутьЗначениеНастройки(Настройки, "ВыгрузкаТоваров", "ПереводСервис");
	
	Если НЕ ЗначениеЗаполнено(ПереводСервис) Тогда 
		Сообщить("Сервис перевода не указан в настройках!!!");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Ссылка
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары
		|ГДЕ
		|	(НЕ ПометкаУдаления)
		|	И (Владелец = &УчетнаяЗапись)
		|	" + ?(ЗначениеЗаполнено(Объекты), "И (Ссылка В (&Объекты))", "") + "
		|";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись"	, УчетнаяЗапись);
	Запрос.УстановитьПараметр("Объекты"			, Объекты.ВыгрузитьЗначения());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		eComm_ИнтернетТовары_Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		ДанныеИсточник = eComm_ИнтернетТовары_Объект;
		
		Если ЯзыкНа <> ОсновнойЯзык Тогда
			
			Представления_Строки = eComm_ИнтернетТовары_Объект.Представления.НайтиСтроки(Новый Структура("КодЯзыка", ЯзыкНа));
			Если ЗначениеЗаполнено(Представления_Строки) Тогда
				ДанныеПолучатель = Представления_Строки[0];
			Иначе
				ДанныеПолучатель = eComm_ИнтернетТовары_Объект.Представления.Добавить();
				ДанныеПолучатель.КодЯзыка = ЯзыкНа;
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого Реквизит Из eComm_ИнтернетТовары_Объект.Метаданные().ТабличныеЧасти.Представления.Реквизиты Цикл
			
			Если Реквизит.Имя = "КодЯзыка" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ДанныеИсточник[Реквизит.Имя]) Тогда
				Продолжить;
			КонецЕсли;
				
			Если (ВариантИспользованияПереводчика = 1 И НЕ ЗначениеЗаполнено(ДанныеПолучатель[Реквизит.Имя]))
				ИЛИ (ВариантИспользованияПереводчика = 2) Тогда
				
				ЭтоHTML = (Реквизит.Имя = "Описание") И eComm_ИнтернетТовары_Объект.ОписаниеВФорматеHTML;
				ДанныеПолучатель[Реквизит.Имя] = Обработки[Настройки.Менеджер].Перевести(Настройки, ЯзыкС, ЯзыкНа, ДанныеИсточник[Реквизит.Имя], ЭтоHTML);
				
			КонецЕсли;
				
		КонецЦикла;
		
		eComm_ИнтернетТовары_Объект.ДополнительныеСвойства.Вставить("ПереводПроизведен");
		eComm_ИнтернетТовары_Объект.Записать();
			
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыВыбора()

	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец", УчетнаяЗапись));
	
	Элементы.ОбъектыЗначение.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВариантИспользованияПереводчикаПоУмолчанию()

	Настройки	= eCommСервер.Настройки(УчетнаяЗапись);
	
	Если НЕ Настройки.ВариантИспользованияПереводчика = 0 Тогда 
		ВариантИспользованияПереводчика = Настройки.ВариантИспользованияПереводчика;		// 1- Переводить при отсутствии перевода
	Иначе                                                                                   // 2- Переводить в любом случае
		ВариантИспользованияПереводчика = 1;
	КонецЕсли;

КонецПроцедуры



