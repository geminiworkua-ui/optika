&НаКлиенте
Процедура ПриИзмененииВыбораПоляШапкиЗаказа(Элемент)
	
	ИмяРеквизита = Элемент.Имя;
	ЗначениеВыбора = ЭтаФорма[ИмяРеквизита];
	ЭтаФорма.Элементы[СтрЗаменить(ИмяРеквизита, "фл_", "ген_")].Доступность = ЗначениеВыбора;
		
КонецПроцедуры

&НаСервере
Функция ВернутьНастройкиАвтозаполненияНаСервере()
		
	СтруктураНастроек = Новый Структура("РеквизитыШапкиЗаказа, РеквизитыТЧ, НастройкиАвтозаполненияЗаказа");  
	СтруктураНастроек.РеквизитыШапкиЗаказа = Новый Структура;
	
	Для каждого ИмяРеквизита Из ВернутьСохраняемыеРеквизитыЗаказа("Шапка") Цикл
		
		ПолеВыбрано = ЭтаФорма["фл_"+ИмяРеквизита];
		Если Не ПолеВыбрано Тогда
			Продолжить;		
		КонецЕсли;
		
		ЗначениеПоля = ЭтаФорма["ген_"+ИмяРеквизита];
		СтруктураНастроек.РеквизитыШапкиЗаказа.Вставить(ИмяРеквизита, ЗначениеПоля);
		
	КонецЦикла;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, СтруктураНастроек);
	
	ТекстНастроек = ЗаписьXML.Закрыть();
	
	Возврат ТекстНастроек;
	
КонецФункции

&НаСервере
Функция ВернутьСохраняемыеРеквизитыЗаказа(РазмещениеРеквизитов)

	МассивВозможныйРеквизитов 	= eCommСервер.ВернутьСохраняемыеРеквизитыЗаказа();
	Результат 					= Новый Массив;
	
	Для каждого мдРеквизита Из Метаданные.Документы[eCommСервер.ВернутьИмяДокументЗаказ()].Реквизиты Цикл
		Если МассивВозможныйРеквизитов.Найти(мдРеквизита.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(мдРеквизита.Имя);
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПрочитатьНастройкиАвтозаполненияНаСервере()

	СоздатьРеквизитыШапкиЗаказа();
	
	Если НЕ Объект.НастройкиАвтозаполненияЗаказа = "" Тогда 
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Объект.НастройкиАвтозаполненияЗаказа);
		
		СтруктураНастроек = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
		Если ТипЗнч(СтруктураНастроек) <> Тип("Структура") Тогда 
			Сообщить("Настройки не соответствуют ожидаемому формату, загрузка настроек остановлена.", СтатусСообщения.Информация);
			Возврат Неопределено;
		Иначе
			Для Каждого КлючЗначение Из СтруктураНастроек.РеквизитыШапкиЗаказа Цикл 
				ЭтаФорма["ген_" + КлючЗначение.Ключ] = КлючЗначение.Значение;
				ЭтаФорма["фл_" + КлючЗначение.Ключ] = Истина;
				ЭтаФорма.Элементы["ген_" + КлючЗначение.Ключ].Доступность = Истина;
			КонецЦикла;
			//Если СтруктураНастроек.Свойство("ДопПараметры") 
			//	И ЗначениеЗаполнено(СтруктураНастроек.НастройкиАвтозаполненияЗаказа.СегментНовогоПартнера) Тогда 
			//	СегментНовогоПартнера = СтруктураНастроек.ДопПараметры.СегментНовогоПартнера;
			//КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура СоздатьРеквизитыШапкиЗаказа() 
		
	// Реквизиты
	ДобавляемыеРеквизиты = Новый Массив;
	мдРеквизитов = Новый Соответствие;
	
	Для каждого мдРеквизита Из ПолучитьМетаданныеРеквизитовШапкиЗаказа() Цикл
		
		// Флаг
		РеквизитФормы = Новый РеквизитФормы(
			"фл_"+мдРеквизита.Имя,
			Новый ОписаниеТипов("Булево"),
			,
			"Выбор " + мдРеквизита.Синоним
		);			
		ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
		
		// Поле
		РеквизитФормы = Новый РеквизитФормы(
			"ген_"+мдРеквизита.Имя,
			мдРеквизита.Тип,
			,
			мдРеквизита.Синоним
		);			
		ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
		
		мдРеквизитов.Вставить(РеквизитФормы, мдРеквизита);

	КонецЦикла;
		
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
		// Элементы
	Для Номер=1 По ДобавляемыеРеквизиты.Количество()/2 Цикл
		
		// Флаг
		РеквизитФормы = ДобавляемыеРеквизиты[(Номер-1)*2];
		Элемент = Элементы.Добавить(РеквизитФормы.Имя, Тип("ПолеФормы"), Элементы["АвтозаполнениеПраво"]);
		Элемент.Вид 				= ВидПоляФормы.ПолеФлажка;
		Элемент.ВидФлажка 			= ВидФлажка.Тумблер;
		Элемент.форматредактирования = "БЛ=Выкл; БИ=Вкл";
		Элемент.ПутьКДанным 		= РеквизитФормы.Имя;
		Элемент.ТолькоПросмотр 		= Ложь;
		Элемент.ПоложениеЗаголовка 	= ПоложениеЗаголовкаЭлементаФормы.Нет;
		Элемент.УстановитьДействие("ПриИзменении", "ПриИзмененииВыбораПоляШапкиЗаказа");
		
		// Поле
		РеквизитФормы = ДобавляемыеРеквизиты[(Номер*2)-1];
		
		мдРеквизита = мдРеквизитов[РеквизитФормы];
		
		Элемент = Элементы.Добавить(РеквизитФормы.Имя, Тип("ПолеФормы"), Элементы["АвтозаполнениеЛево"]);
		Элемент.Вид 			= ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным 	= РеквизитФормы.Имя;
		Элемент.ТолькоПросмотр 	= Ложь;
		Элемент.Доступность 	= Ложь;		
		Элемент.Подсказка 		= мдРеквизита.Подсказка;
							
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьМетаданныеРеквизитовШапкиЗаказа()

	Результат = Новый Массив();
	
	РеквизитыЗаказаАвтоЗаполнения = ВернутьСохраняемыеРеквизитыЗаказа("Шапка");
	
	Для каждого мдРеквизита Из Метаданные.Документы[eCommСервер.ВернутьИмяДокументЗаказ()].Реквизиты Цикл
		
		Если РеквизитыЗаказаАвтоЗаполнения.Найти(мдРеквизита.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(мдРеквизита);
		
	КонецЦикла;	
	
	Возврат Результат;

КонецФункции 


