&НаКлиенте
Процедура СвернутьРазвернутьГруппу(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	ИмяГруппы 	= СтрЗаменить(ИмяЭлемента, "Декорация", "") + "СворачиваемаяГруппа";
	
	СвернутьРазвернутьГруппуНаСервере(ИмяГруппы, НЕ Элементы[ИмяГруппы].Видимость); 
	
КонецПроцедуры

&НаСервере
Процедура СвернутьРазвернутьГруппуНаСервере(ИмяГруппы, Видимость)
	
	Элементы[ИмяГруппы].Видимость = Видимость;
	
	Если Видимость Тогда 
		Элементы["Декорация" + СтрЗаменить(ИмяГруппы, "СворачиваемаяГруппа", "")].Картинка = Элементы["ДекорацияСвернуть" + ЦветИзображенийСворачиваемыхГрупп].Картинка;
	Иначе
		Элементы["Декорация" + СтрЗаменить(ИмяГруппы, "СворачиваемаяГруппа", "")].Картинка = Элементы["ДекорацияРазвернуть" + ЦветИзображенийСворачиваемыхГрупп].Картинка;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьВсеНастройкиПриИзменении(Элемент)
	
	УстановитьВидимостьСворачиваемыхГрупп();
	УстановитьВидимостьРасширенныхГрупп();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСворачиваемыхГрупп()

	СтруктураСворачиваемыхГрупп = СтруктураСворачиваемыхГрупп();
	
	Для Каждого СворачиваемаяГруппа Из СтруктураСворачиваемыхГрупп Цикл
		Если НЕ ЕстьВидимыеЭлементыВГруппе(Элементы["Группа" + СворачиваемаяГруппа.Ключ]) Тогда 
			Элементы[СворачиваемаяГруппа.Ключ + "Заголовок"].Видимость = Ложь;
			Элементы[СворачиваемаяГруппа.Ключ + "СворачиваемаяГруппа"].Видимость = Ложь;
			Продолжить;
		Иначе
			Элементы[СворачиваемаяГруппа.Ключ + "Заголовок"].Видимость = Истина;
			//Элементы[СворачиваемаяГруппа.Ключ + "СворачиваемаяГруппа"].Видимость = Ложь;
			СвернутьРазвернутьГруппуНаСервере(СворачиваемаяГруппа.Ключ + "СворачиваемаяГруппа", СворачиваемаяГруппа.Значение);
		КонецЕсли;
		//Если Объект.ПоказыватьВсеНастройки = Истина Тогда 
		//	СвернутьРазвернутьГруппуНаСервере(СворачиваемаяГруппа.Ключ + "СворачиваемаяГруппа", Истина);
		//Иначе
			
		//КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьРасширенныхГрупп()

	СтруктураРасширенныхГрупп = СтруктураРасширенныхГрупп();
	
	Для Каждого РасширеннаяГруппа Из СтруктураРасширенныхГрупп Цикл
		Если НЕ ЕстьВидимыеЭлементыВГруппе(Элементы[РасширеннаяГруппа.Ключ]) Тогда 
			Элементы[РасширеннаяГруппа.Ключ].Видимость = Ложь;
			Продолжить;
		КонецЕсли;
		Если Объект.ПоказыватьВсеНастройки = Истина Тогда 
			Элементы[РасширеннаяГруппа.Ключ].Видимость = Истина;
		Иначе
			Элементы[РасширеннаяГруппа.Ключ].Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьЦветИзображенийСворачиваемыхГрупп()
	
	Попытка
		Если ЦветаСтиля.ЦветАкцента = Новый Цвет(0, 136, 204) Тогда 
			ЦветИзображенийСворачиваемыхГрупп = "Синяя";
		Иначе
			ЦветИзображенийСворачиваемыхГрупп = "Зеленая";
		КонецЕсли;
	Исключение
		ЦветИзображенийСворачиваемыхГрупп = "Зеленая";
	КонецПопытки;
	
КонецПроцедуры

