Процедура ПолучитьСписокСпособовОплат(Команда)
	
	СпособыОплаты = ПолучитьСписокСпособовОплатНаСервере();
	
	Если ТипЗнч(СпособыОплаты) = Тип("Массив")
		И СпособыОплаты.Количество() > 0 Тогда 
		
		Если Объект.СпособыОплаты.Количество() > 0 Тогда 
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеВопросаОбОчисткеСпособовОплат", ЭтаФорма, СпособыОплаты);
			ТекстВопроса = НСтр("ru = 'Текущий список способов оплат будет очищен.
                            |Продолжить?'; 
							|uk = 'Поточний список способів оплати буде очищений.
                            |Продовжити?'");
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена,,, НСтр("ru = 'Способы оплаты'; uk = 'Способи оплати'"));
			
		Иначе
			
			ЗаполнитьСпособыОплатыНаКлиенте(СпособыОплаты);
			
		КонецЕсли;
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru = 'Нет доступных способов оплат'; uk = 'Відсутні способи оплати'"), , НСтр("ru = 'Способы оплаты'; uk = 'Способи оплати'"));
		
