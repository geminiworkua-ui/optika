&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Расписания обмена
	Если НЕ ТипЗнч(РасписаниеОбменаТоварами) = Тип("РасписаниеРегламентногоЗадания") Тогда
		РасписаниеОбменаТоварами = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	Если НЕ ТипЗнч(РасписаниеОбменаЗаказами) = Тип("РасписаниеРегламентногоЗадания") Тогда
		РасписаниеОбменаЗаказами = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		ЗагрузитьНастройкиОтборовКомпоновкиДанныхПриЧтении();
		Элементы.ТорговаяПлощадка.ТолькоПросмотр = Ложь;
		Объект.Версия = eCommСервер.ВерсияБиблиотеки();
	КонецЕсли;
	
	ПрочитатьНастройкиАвтозаполненияНаСервере();
	
	УстановитьСписокВыбораИмяРеквизитаКатегорияИнтернетТовара();
	УстановитьСписокВыбораИмяРеквизитаОписаниеИнтернетТовара();
	УстановитьВидимостьЭлементов();
	УстановитьЦветИзображенийСворачиваемыхГрупп();
	УстановитьВидимостьСворачиваемыхГрупп();
	УстановитьВидимостьРасширенныхГрупп();
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Заголовок = "Новое подключение (" + eCommСервер.ВерсияБиблиотеки() + ")";
	КонецЕсли;
	
	ИмяДокументаЗаказ = eCommСервер.ВернутьИмяДокументЗаказ();
	
	Для Каждого Реквизит Из Метаданные.Документы[ИмяДокументаЗаказ].Реквизиты Цикл 
		Элементы.СпособыОплатыИмяРеквизита.СписокВыбора.Добавить(Реквизит.Имя, Реквизит.Синоним);
	КонецЦикла;
	
	ДобавитьУсловноеОформлениеТекстаДляСпискаВыбора(Элементы.СпособыОплатыИмяРеквизита);
	
	ЗаполнитьПредставлениеПутиКПрайсу();
	ЗаполнитьПредставлениеСпискаОптовыхЦен();
	ЗаполнитьПредставлениеСпискаУровнейЦен();
	ПоказатьИнформациюОЛицензии();
	УстановитьВидимость_eCommДоставка();
		
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	УстановитьПривилегированныйРежим(Истина);
	
	
	// Блок отборов
	ТекущийОбъект.НастройкиКомпоновщика = Новый ХранилищеЗначения(КомпоновщикНастроек.ПолучитьНастройки());
	
	
	// Блок рег задания. Товары
	Если ТипЗнч(РасписаниеОбменаТоварами) = Тип("РасписаниеРегламентногоЗадания") Тогда 
		Если Не ЗначениеЗаполнено(ТекущийОбъект.РегламентноеЗаданиеОбменаТоварами) Тогда
			ЗаданиеТовары = Неопределено;
		Иначе
			ЗаданиеТовары = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ТекущийОбъект.РегламентноеЗаданиеОбменаТоварами);
		КонецЕсли;
		
		Если ЗаданиеТовары = Неопределено Тогда
			ЗаданиеТовары = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.eComm_ВыполнитьОбмен);
		КонецЕсли;
		
		ЗаданиеТовары.Использование = Объект.ОбменПоРегламентномуЗаданиюВыгрузкаТоваров;
		
		НаименованиеЗадания = НСтр("ru='Обмен товарами по профилю %Профиль%';uk='Обмін товарами за профілем %Профиль%'");
		НаименованиеЗадания = СтрЗаменить(НаименованиеЗадания, "%Профиль%", ТекущийОбъект.Наименование);
		ЗаданиеТовары.Наименование = НаименованиеЗадания;
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(ТекущийОбъект.Ссылка);
		ПараметрыЗадания.Добавить("ВыгружатьТовары");
		
		ЗаданиеТовары.Параметры  = ПараметрыЗадания;
		ЗаданиеТовары.Расписание = РасписаниеОбменаТоварами;
		
		ЗаданиеТовары.Записать();
		
		ТекущийОбъект.РегламентноеЗаданиеОбменаТоварами = ЗаданиеТовары.УникальныйИдентификатор;
	КонецЕсли;
	
	
	Если ТипЗнч(РасписаниеОбменаЗаказами) = Тип("РасписаниеРегламентногоЗадания") Тогда
		// Блок рег задания. Заказы
		Если Не ЗначениеЗаполнено(ТекущийОбъект.РегламентноеЗаданиеОбменаЗаказами) Тогда
			ЗаданиеЗаказы = Неопределено;
		Иначе
			ЗаданиеЗаказы = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ТекущийОбъект.РегламентноеЗаданиеОбменаЗаказами);
		КонецЕсли;
		
		Если ЗаданиеЗаказы = Неопределено Тогда
			ЗаданиеЗаказы = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.eComm_ВыполнитьОбмен);
		КонецЕсли;
		
		ЗаданиеЗаказы.Использование = Объект.ОбменПоРегламентномуЗаданиюЗагрузкаЗаказов;
		
		НаименованиеЗадания = НСтр("ru='Обмен заказами по профилю %Профиль%';uk='Обмін замовленнями за профілем %Профиль%'");
		НаименованиеЗадания = СтрЗаменить(НаименованиеЗадания, "%Профиль%", ТекущийОбъект.Наименование);
		ЗаданиеЗаказы.Наименование = НаименованиеЗадания;
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(ТекущийОбъект.Ссылка);
		ПараметрыЗадания.Добавить("ЗагружатьЗаказы");
		
		ЗаданиеЗаказы.Параметры  = ПараметрыЗадания;
		ЗаданиеЗаказы.Расписание = РасписаниеОбменаЗаказами;
		
		ЗаданиеЗаказы.Записать();
		
		ТекущийОбъект.РегламентноеЗаданиеОбменаЗаказами = ЗаданиеЗаказы.УникальныйИдентификатор;
	КонецЕсли;
				
	УстановитьПривилегированныйРежим(Ложь);
	
	СохранитьРеквизиты(ТекущийОбъект);
	
	// Блок настроек автозаполнения
	ТекущийОбъект.НастройкиАвтозаполненияЗаказа = ВернутьНастройкиАвтозаполненияНаСервере();
	
	Элементы.ТорговаяПлощадка.ТолькоПросмотр = ЗначениеЗаполнено(ТекущийОбъект.Ссылка);
	
	ТекущийОбъект.ИспользоватьМультиязычность = ИспользоватьМультиязычность;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПоказатьИнформациюОЛицензии();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Блок восстановления отборов
	ЗагрузитьНастройкиОтборовКомпоновкиДанныхПриЧтении(ТекущийОбъект);
	
	// Блок регламентных заданий. Товары	
	ИдентификаторЗадания = ТекущийОбъект.РегламентноеЗаданиеОбменаТоварами;
	
	ЗаданиеТовары = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если ЗаданиеТовары <> Неопределено Тогда
		РасписаниеОбменаТоварами      				= ЗаданиеТовары.Расписание;
		Элементы.РасписаниеОбменаТоварамиСтрокой.Заголовок  = Строка(РасписаниеОбменаТоварами);
	КонецЕсли;
	
	// Блок регламентных заданий. Заказы	
	ИдентификаторЗадания = ТекущийОбъект.РегламентноеЗаданиеОбменаЗаказами;
	
	ЗаданиеЗаказы = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если ЗаданиеЗаказы <> Неопределено Тогда
		РасписаниеОбменаЗаказами      				= ЗаданиеЗаказы.Расписание;
		Элементы.РасписаниеОбменаЗаказамиСтрокой.Заголовок  = Строка(РасписаниеОбменаЗаказами);
	КонецЕсли;

	Если Объект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka 
		ИЛИ Объект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom 
		ИЛИ Объект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop
		ИЛИ Объект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Allo Тогда
		
		ДанныеСостоянияОбмена 	= eCommСервер.ДанныеСостоянияОбмена(Новый Структура("УчетнаяЗапись, ПрофильНастроек", Объект.Ссылка, Справочники.eComm_ПрофилиНастроекУчетнойЗаписи.ПустаяСсылка()), Перечисления.eComm_ДействияПриОбмене.ОбменЗаказами);
		ДатаЗагрузки 			= ДанныеСостоянияОбмена.ДатаОкончания;
		
		//Запрос = Новый Запрос;
		//Запрос.Текст = 
		//	"ВЫБРАТЬ
		//	|	ВремяЗагруженногоЗаказа.ДатаЗагрузки
		//	|ИЗ
		//	|	РегистрСведений.eComm_ВремяЗагруженногоЗаказа КАК ВремяЗагруженногоЗаказа
		//	|ГДЕ
		//	|	ВремяЗагруженногоЗаказа.УчетнаяЗапись = &УчетнаяЗапись";
		//
		//Запрос.УстановитьПараметр("УчетнаяЗапись", ТекущийОбъект.Ссылка);
		//
		//РезультатЗапроса = Запрос.Выполнить().Выбрать();
		//
		//Если РезультатЗапроса.Следующий() Тогда 
		//	ДатаЗагрузки = РезультатЗапроса.ДатаЗагрузки;
		//КонецЕсли;
		
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
	Заголовок = "" + ТекущийОбъект.Ссылка + " (" + eCommСервер.ВерсияБиблиотеки() + ")";
	
	ВосстановитьРеквизиты(ТекущийОбъект);
	
КонецПроцедуры

