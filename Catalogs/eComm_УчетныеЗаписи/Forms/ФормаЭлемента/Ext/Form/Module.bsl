&НаСервере
Процедура ВосстановитьРеквизиты(ТекущийОбъект)
	
	НастройкиОбмена = ТекущийОбъект.НастройкиОбмена.Получить();
	
	Если Не ТекущийОбъект = Неопределено Тогда
		Если Не ТипЗнч(НастройкиОбмена) = Тип("Структура") Тогда
			НастройкиОбмена = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ПрочитатьНастройкиОбмена(НастройкиОбмена, "ВыгрузкаТоваров");
	ПрочитатьНастройкиОбмена(НастройкиОбмена, "ЗагрузкаЗаказов");

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиОбмена(НастройкиОбмена, БлокНастроек, МассивДополнительныхРеквизитов)

	ДополнительныеРеквизиты = Новый Структура;
	Для Каждого ЭлементМассива Из МассивДополнительныхРеквизитов Цикл
		Если ТипЗнч(ЭтаФорма[ЭлементМассива]) = Тип("ДанныеФормыКоллекция") Тогда
			ЗначениеРеквизита = РеквизитФормыВЗначение(ЭлементМассива);
		Иначе
			ЗначениеРеквизита = ЭтаФорма[ЭлементМассива];
		КонецЕсли;
		ДополнительныеРеквизиты.Вставить(ЭлементМассива, ЗначениеРеквизита);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ДополнительныеРеквизиты) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОбмена.Вставить(БлокНастроек, ДополнительныеРеквизиты);	

КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройкиОбмена(НастройкиОбмена, БлокНастроек)

	Если НастройкиОбмена.Свойство(БлокНастроек) Тогда
		
		//++
		// Временно на этап обновления до версии 2.5
		Если БлокНастроек = "ВыгрузкаТоваров" Тогда 
			Если Объект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom 
				И НастройкиОбмена.ВыгрузкаТоваров.Свойство("ОбновляемыеПоляНаСайтеProm") Тогда
				НастройкиОбмена.ВыгрузкаТоваров.Вставить("ОбновляемыеПоляНаСайте", НастройкиОбмена.ВыгрузкаТоваров.ОбновляемыеПоляНаСайтеProm);
				НастройкиОбмена.ВыгрузкаТоваров.Удалить("ОбновляемыеПоляНаСайтеProm");
			ИначеЕсли Объект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop 
				И НастройкиОбмена.ВыгрузкаТоваров.Свойство("ОбновляемыеПоляНаСайтеHoroshop") Тогда
				НастройкиОбмена.ВыгрузкаТоваров.Вставить("ОбновляемыеПоляНаСайте", НастройкиОбмена.ВыгрузкаТоваров.ОбновляемыеПоляНаСайтеHoroshop);
				НастройкиОбмена.ВыгрузкаТоваров.Удалить("ОбновляемыеПоляНаСайтеHoroshop");
			КонецЕсли;
		КонецЕсли;
		//--
		
		//++
		// Для перехода на версию 2.6.0.8
		Если НЕ НастройкиОбмена.ВыгрузкаТоваров.Свойство("ПоляДляПеревода") Тогда 
			ЗаполнитьСписокРеквизитовКПереводу();
		КонецЕсли;
		Если Объект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom 
			И НастройкиОбмена.ВыгрузкаТоваров.Свойство("НеИспользоватьРазновидностиProm") Тогда
			НастройкиОбмена.ВыгрузкаТоваров.Вставить("НеИспользоватьРазновидности", НастройкиОбмена.ВыгрузкаТоваров.НеИспользоватьРазновидностиProm);
			НастройкиОбмена.ВыгрузкаТоваров.Удалить("НеИспользоватьРазновидностиProm");
		КонецЕсли;
		//--
		
		Если ТипЗнч(НастройкиОбмена[БлокНастроек]) = Тип("Структура") Тогда
			Для Каждого КлючЗначение Из НастройкиОбмена[БлокНастроек] Цикл
				Попытка
					Если ТипЗнч(КлючЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
						ЭтаФорма[КлючЗначение.Ключ].Загрузить(КлючЗначение.Значение);
					Иначе
						ЭтаФорма[КлючЗначение.Ключ] = КлючЗначение.Значение;
						Если ТипЗнч(КлючЗначение.Значение) = Тип("СписокЗначений") Тогда 
							// Может быть интерфейсный элемент
							Если КлючЗначение.Ключ = "ОбновляемыеПоляНаСайте" Тогда
								Элементы.ДекорацияОбновляемыеПоля.Заголовок = ВернутьПредставлениеСпискаЗначений(КлючЗначение.Значение);
							ИначеЕсли КлючЗначение.Ключ = "ПоляДляПеревода" Тогда 
								Элементы.ДекорацияПоляДляПеревода.Заголовок = ВернутьПредставлениеСпискаЗначений(КлючЗначение.Значение);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры

