		ИмяЭлемента = "Маркетплейсы"
	Иначе
		Возврат;
	КонецЕсли;
	
	Метки.Очистить();
	
	Для Каждого СтруктураМетки Из СписокМеток Цикл
		Метки.Добавить(СтруктураМетки.Метка);
	КонецЦикла;
	
