&НаКлиенте
Процедура МеткаСтрокойНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.Имя = "ЯрлыкиСтрокой" Тогда 
		ИмяЭлемента = "Ярлыки";
		ТипМетки = ПредопределенноеЗначение("Перечисление.eComm_ТипыМеток.Ярлык");
	ИначеЕсли Элемент.Имя = "МаркетплейсыСтрокой" Тогда 
		ИмяЭлемента = "Маркетплейсы";
		ТипМетки = ПредопределенноеЗначение("Перечисление.eComm_ТипыМеток.Маркетплейс");
	Иначе
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеВыбораСпискаМеток", ЭтаФорма, ТипМетки);
	
	Метки = Новый Массив;
	Для Каждого Стр Из ЭтаФорма[ИмяЭлемента] Цикл
		Метки.Добавить(Новый Структура("Метка, ТипМетки", Стр.Значение, ТипМетки));
	КонецЦикла;
	
	ПараметрыОткрытия = Новый Структура("Метки, ТипМетки", Метки, ТипМетки);
	ОткрытьФорму("Справочник.eComm_ИнтернетТовары.Форма.ФормаРедактированияМеток", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
