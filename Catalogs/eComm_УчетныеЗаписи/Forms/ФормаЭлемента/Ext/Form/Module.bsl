КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеПутиКПрайсу()

	Если ЗначениеЗаполнено(Объект.URL_КаталогаКартинок)
		И ЗначениеЗаполнено(Объект.ИмяФайла) Тогда 
		
		Настройки = eCommСервер.Настройки(Объект.Ссылка);
		
		Если Прав(Объект.URL_КаталогаКартинок, 1) = "/" Тогда 
			URL_КаталогаКартинок = Объект.URL_КаталогаКартинок;
		Иначе
			URL_КаталогаКартинок = Объект.URL_КаталогаКартинок + "/";
		КонецЕсли;
		
		ПутьКПрайсу = URL_КаталогаКартинок + Объект.ИмяФайла + "." + Настройки.РасширениеФайла;
		
	Иначе
		
		ПутьКПрайсу = "";
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТестовоеПодключениеКСайтуНаСервере()
	
	Настройки = eCommСервер.Настройки(Объект.Ссылка);
	
	Если Объект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда 
		Возврат Обработки.eComm_Horoshop.ТестовоеПодключениеКСайтуУспешно(Настройки);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ПоказатьИнформациюОЛицензии()

	Попытка
		
		Элементы.СрокДействияЛицензии.Заголовок = "";
		
		СрокДействияЛицензии_eComm 	= Неопределено;
		ТекущаяДата					= Неопределено;
		
		Если ЗначениеЗаполнено(Объект.ЛицензионныйКлюч) 
			И Лев(Объект.ЛицензионныйКлюч, 3) = "TMP" Тогда 
			
			Настройки = eCommСервер.Настройки(Объект.Ссылка);
			
			ПараметрыЛицензии = Обработки[Настройки.Менеджер].ИнформацияОЛицензии(Настройки);
			
			ТекущаяДата = ТекущаяДата();
			СрокДействияЛицензии_eComm = ПараметрыЛицензии.СрокГодности;
			
			Элементы.СрокДействияЛицензии.Заголовок = НСтр("ru = 'Действ. до: '; uk = 'Діє до: '") + Формат(СрокДействияЛицензии_eComm, "ДЛФ=Д");
			
		КонецЕсли;
		
	Исключение
		
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость_eCommДоставка()

	ЕстьПодсистема_eCommДоставка = НЕ Метаданные.Справочники.Найти("eComm_УчетныеЗаписиСлужбДоставки") = Неопределено;
	
	Если ЕстьПодсистема_eCommДоставка Тогда
		
		Если НЕ Метаданные.Справочники.Найти("ЭквайринговыеТерминалы") = Неопределено Тогда
			// Для управляеых форм
			ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.ЭквайринговыеТерминалы"); 
		Иначе
			// Для обычных форм
			ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.Организации"); 
		КонецЕсли;
		
		Элементы.ЭквайринговыйТерминалИлиОрганизация.ОграничениеТипа = ОписаниеТипов;
		
	Иначе
		
		// Для модулей без службы доставки eComm
		Элементы.ЭквайринговыйТерминалИлиОрганизация.ОграничениеТипа = Новый ОписаниеТипов("Строка");
		Элементы.ЭквайринговыйТерминалИлиОрганизация.Доступность = Ложь;
		
	КонецЕсли;

КонецПроцедуры











