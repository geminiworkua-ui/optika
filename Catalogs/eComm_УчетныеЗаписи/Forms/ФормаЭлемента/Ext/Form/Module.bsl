// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура НастроитьРасписание(Команда)
	
	ИмяРеквизита = СтрЗаменить(Команда.Имя, "Настроить", "");
	
	ДиалогРасписания 	= Новый ДиалогРасписанияРегламентногоЗадания(ЭтаФорма[ИмяРеквизита]);
	
	ОповещениеОВыборе 	= Новый ОписаниеОповещения("ОповещениеОВыбореРасписания", ЭтаФорма, ИмяРеквизита);
	
	ДиалогРасписания.Показать(ОповещениеОВыборе);
	
КонецПроцедуры

&НаКлиенте
Процедура ФлажокПриИзменении(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	Элементы["Группа" + ИмяЭлемента].Доступность = Объект[ИмяЭлемента];
	
КонецПроцедуры

&НаКлиенте
Процедура ТорговаяПлощадкаПриИзменении(Элемент)
	
	Если НЕ МодульВстроен(Объект.ТорговаяПлощадка) Тогда 
		Объект.ТорговаяПлощадка = ПредопределенноеЗначение("Перечисление.eComm_ТорговыеПлощадки.ПустаяСсылка");
	Иначе
		ЗагрузитьНастройкиОтборовКомпоновкиДанныхПриЧтении();
		ЗаполнитьЗначенияДополнительныхРеквизитовПоУмолчанию();
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();
	УстановитьВидимостьСворачиваемыхГрупп();
	УстановитьВидимостьРасширенныхГрупп();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагружатьЗаказыПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();

КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьТоварыПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();

КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОбновляемыеПоляНажатие(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьЗначенияИзСписка", ЭтаФорма, Элемент.Имя);
	
	ПараметрыОткрытия = Новый Структура("СписокЗначений, Заголовок", ОбновляемыеПоляНаСайте, НСтр("ru = 'Список обновляемых полей'; uk = 'Список оновлюваних полів'"));
	ОткрытьФорму("Справочник.eComm_УчетныеЗаписи.Форма.ФормаСпискаЗначений", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПоляДляПереводаНажатие(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьЗначенияИзСписка", ЭтаФорма, Элемент.Имя);
	
	ПараметрыОткрытия = Новый Структура("СписокЗначений, Заголовок", ПоляДляПеревода, НСтр("ru = 'Реквизиты для перевода'; uk = 'Реквізити до перекладу'"));
	ОткрытьФорму("Справочник.eComm_УчетныеЗаписи.Форма.ФормаСпискаЗначений", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьСтатусыЗаказовПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПодключенияКВебСерверуПриИзменении(Элемент)
	
	Если ТипПодключенияКВебСерверу = "" Тогда
		// Это ФТП
		Элементы.ГруппаФТП.Видимость 			= Истина;
		Элементы.ГруппаОбщаяПапка.Видимость 	= Ложь;
	ИначеЕсли ТипПодключенияКВебСерверу = "ОбщаяПапка" Тогда
		// Это сетевая папка
		Элементы.ГруппаФТП.Видимость 			= Ложь;
		Элементы.ГруппаОбщаяПапка.Видимость 	= Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиПеревозчиковСпособДоставкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = ВернутьСписокСпособовДоставки();
	
КонецПроцедуры

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПриИзменении(Элемент)
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОВыбореРасписания(НовоеРасписание, ИмяРеквизитаРасписание) Экспорт

	Если НЕ НовоеРасписание = Неопределено
		И ЭтаФорма[ИмяРеквизитаРасписание] <> НовоеРасписание Тогда
		Модифицированность = Истина;
		ЭтаФорма[ИмяРеквизитаРасписание]   = НовоеРасписание;
		Элементы[ИмяРеквизитаРасписание + "Строкой"].Заголовок  = Строка(ЭтаФорма[ИмяРеквизитаРасписание]);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьНастройкиПоУмолчанию(Команда)
	
	ЗагрузитьНастройкиОтборовКомпоновкиДанныхПриЧтении();
	ЗаполнитьЗначенияДополнительныхРеквизитовПоУмолчанию();
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеПрофилиНастроек(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		ПараметрыОткрытия = Новый Структура("Отбор", Новый Структура("Владелец", Объект.Ссылка));
		ОткрытьФорму("Справочник.eComm_ПрофилиНастроекУчетнойЗаписи.ФормаСписка", ПараметрыОткрытия, ЭтаФорма, Объект.Ссылка);
	Иначе
		ПоказатьПредупреждение(, "Элемент не записан!!!");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорииТоваров(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		ПараметрыОткрытия = Новый Структура("Отбор", Новый Структура("Владелец", Объект.Ссылка));
		ОткрытьФорму("Справочник.eComm_КатегорииТоваров.ФормаСписка", ПараметрыОткрытия, ЭтаФорма, Объект.Ссылка);
	Иначе
		ПоказатьПредупреждение(, "Элемент не записан!!!");
	КонецЕсли;

