		МетаданныеРеквизита = Метаданные.Справочники.Номенклатура.Реквизиты.Найти(ИмяРеквизитаОписаниеНоменклатуры);
		Если НЕ МетаданныеРеквизита = Неопределено Тогда
			Представление = НСтр("ru = 'из реквизита ""'; uk = 'з реквізиту ""'") + МетаданныеРеквизита.Синоним + НСтр("ru = '"" номенклатуры'; uk = '"" номенклатури'");
			Элементы.ИмяРеквизитаОписаниеИнтернетТовара.СписокВыбора.Добавить(ИмяРеквизитаОписаниеНоменклатуры, Представление);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

