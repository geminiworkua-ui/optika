&НаКлиенте
Процедура ЗапроситьЛицензионныйКлюч(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Если НЕ Модифицированность Тогда 
			
			Если Не ЗначениеЗаполнено(Объект.АдресAPI)
				И (Объект.ТорговаяПлощадка = ПредопределенноеЗначение("Перечисление.eComm_ТорговыеПлощадки.Horoshop")
					ИЛИ Объект.ТорговаяПлощадка = ПредопределенноеЗначение("Перечисление.eComm_ТорговыеПлощадки.OpenCart")) Тогда 
				Сообщить("Адрес API не заполнен!!!");
				Возврат;
			ИначеЕсли Не ЗначениеЗаполнено(Объект.ЛогинAPI)
				И (Объект.ТорговаяПлощадка = ПредопределенноеЗначение("Перечисление.eComm_ТорговыеПлощадки.Prom")
					ИЛИ Объект.ТорговаяПлощадка = ПредопределенноеЗначение("Перечисление.eComm_ТорговыеПлощадки.Rozetka")
					ИЛИ Объект.ТорговаяПлощадка = ПредопределенноеЗначение("Перечисление.eComm_ТорговыеПлощадки.Allo")) Тогда 
				Сообщить("Логин API не заполнен!!!");
				Возврат;
			КонецЕсли;
			
			ОписаниеОповещенияОВводе = Новый ОписаниеОповещения("ВыполнитьПослеВводаПочты", ЭтаФорма);
			
			ПараметрыОткрытия = Новый Структура("ТорговаяПлощадка, УчетнаяЗапись", Объект.ТорговаяПлощадка, Объект.Ссылка);
			ОткрытьФорму("Справочник.eComm_УчетныеЗаписи.Форма.ФормаЗапросаЛицензии", ПараметрыОткрытия, ЭтаФорма,  , , , ОписаниеОповещенияОВводе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'Элемент не записан!!!'; uk = 'Елемент не записаний!!!'"));
		КонецЕсли;
		
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Элемент не записан!!!'; uk = 'Елемент не записаний!!!'"));
	КонецЕсли;
	
КонецПроцедуры

