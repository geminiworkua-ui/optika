&НаСервере
Процедура СгенерироватьИнтернетРеквизитыНаСервере()

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		
		СтруктураНастроек 	= eCommСервер.Настройки(Объект.Ссылка);
		ТаблицаТоваров 		= Справочники.eComm_УчетныеЗаписи.ВернутьТаблицуТоваров(СтруктураНастроек);
		ИмяСпрКатегорииНоменклатуры 	= eCommСервер.ВернутьИмяПрикладногоОбъекта("КатегорииНоменклатуры");
		ИмяРеквизитаКатегория 			= eCommСервер.ВернутьИмяРеквизитаОбъекта("КатегорииНоменклатуры", "КатегорияНоменклатуры");
		СоответствиеСозданныхКатегорий 	= Новый Соответствие;
		
		Если НЕ ИмяСпрКатегорииНоменклатуры = "" Тогда 
			СгенерироватьИерархиюКатегорий(ТаблицаТоваров, СоответствиеСозданныхКатегорий, ИмяСпрКатегорииНоменклатуры, ИмяРеквизитаКатегория);
		КонецЕсли;
		
		ТаблицаТоваров.Свернуть("Номенклатура");
		Для Каждого Стр Из ТаблицаТоваров Цикл 
			
			НовыйИнтернетРеквизит = Справочники.eComm_ИнтернетТовары.СоздатьЭлемент();
			НовыйИнтернетРеквизит.Владелец 		= Объект.Ссылка;
			НовыйИнтернетРеквизит.Номенклатура 	= Стр.Номенклатура;
			НовыйИнтернетРеквизит.Наименование 	= Строка(Стр.Номенклатура);
			
			КатегорияКод 	= Стр.Номенклатура[ИмяРеквизитаКатегория].Код;
			КатегорияСсылка = СоответствиеСозданныхКатегорий[КатегорияКод];
			
			Если ЗначениеЗаполнено(КатегорияКод) 
				И ЗначениеЗаполнено(КатегорияСсылка) Тогда 
				НовыйИнтернетРеквизит.Категория = КатегорияСсылка;
			КонецЕсли;
			
			НовыйИнтернетРеквизит.Записать();
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СгенерироватьИерархиюКатегорий(ТаблицаТоваров, СоответствиеРодителей, ИмяСпрКатегорииНоменклатуры, ИмяРеквизитаКатегория)

	ЗапросТекст = 
		"ВЫБРАТЬ
		|	ТЗ.Номенклатура
		|ПОМЕСТИТЬ ВрТабНоменклатура
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Номенклатура.#КатегорияНоменклатуры# КАК КатегорияНоменклатуры
		|ПОМЕСТИТЬ ВрТабКатегории
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В
		|			(ВЫБРАТЬ
		|				ВрТабНоменклатура.Номенклатура
		|			ИЗ
		|				ВрТабНоменклатура КАК ВрТабНоменклатура)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КатегорииНоменклатуры.Ссылка КАК Ссылка,
		|	КатегорииНоменклатуры.Код КАК Код,
		|	КатегорииНоменклатуры.Родитель,
		|	КатегорииНоменклатуры.Родитель КАК РодительКод
		|ИЗ
		|	Справочник.#КатегорииНоменклатуры# КАК КатегорииНоменклатуры
		|ГДЕ
		|	КатегорииНоменклатуры.Ссылка В
		|			(ВЫБРАТЬ
		|				ВрТабКатегории.КатегорияНоменклатуры
		|			ИЗ
		|				ВрТабКатегории КАК ВрТабКатегории)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка ИЕРАРХИЯ"; 
	
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "#КатегорииНоменклатуры#", ИмяСпрКатегорииНоменклатуры);
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "#КатегорияНоменклатуры#", ИмяРеквизитаКатегория);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросТекст;
	Запрос.УстановитьПараметр("ТЗ", ТаблицаТоваров);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НоваяКатегория = Справочники.eComm_КатегорииТоваров.СоздатьЭлемент();
		НоваяКатегория.Код 			= СокрЛП(ВыборкаДетальныеЗаписи.Код);
		НоваяКатегория.Наименование = Строка(ВыборкаДетальныеЗаписи.Ссылка);
		НоваяКатегория.Владелец 	= Объект.Ссылка;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.РодительКод) Тогда 
			НоваяКатегория.Родитель = СоответствиеРодителей[ВыборкаДетальныеЗаписи.РодительКод];
		КонецЕсли;
		
		НоваяКатегория.Записать();
		
		СоответствиеРодителей.Вставить(НоваяКатегория.Код, НоваяКатегория.Ссылка)
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВернутьТекущийУзелОбмена()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	eComm_Обмен.Ссылка КАК УзелОбмена
		|ИЗ
		|	ПланОбмена.eComm_Обмен КАК eComm_Обмен
		|ГДЕ
		|	eComm_Обмен.УчетнаяЗапись = &УчетнаяЗапись
		|	И eComm_Обмен.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат РезультатЗапроса.УзелОбмена;
	КонецЕсли;

