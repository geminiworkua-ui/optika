			|ГДЕ
			|	eComm_ИнтернетТовары.Владелец = &Владелец
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	eComm_ИнтернетТовары.Категория.КатегорияНаПортале
			|ИЗ
			|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	eComm_КатегорииТорговойПлощадки.Ссылка КАК КатегорияНаПортале,
			|	eComm_КатегорииТорговойПлощадки.ИдентификаторСервиса КАК ИдентификаторСервиса
			|ИЗ
			|	Справочник.eComm_КатегорииТорговойПлощадки КАК eComm_КатегорииТорговойПлощадки
			|ГДЕ
			|	eComm_КатегорииТорговойПлощадки.Ссылка В
			|			(ВЫБРАТЬ
			|				ВрТабПортальныеКатегории.КатегорияНаПортале КАК КатегорияНаПортале
			|			ИЗ
			|				ВрТабПортальныеКатегории КАК ВрТабПортальныеКатегории)
			|	И eComm_КатегорииТорговойПлощадки.ТорговаяПлощадка = &ТорговаяПлощадка";
		
		Запрос.УстановитьПараметр("Владелец"		, Объект.Ссылка);
		Запрос.УстановитьПараметр("ТорговаяПлощадка", Объект.ТорговаяПлощадка);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		СчУспешных 		= 0;
		СчНеуспешных 	= 0;
		
		Пока РезультатЗапроса.Следующий() Цикл
			
			Если Обработки["eComm_OLX"].ОбновитьСвойстваКатегории(Объект.Ссылка, РезультатЗапроса.КатегорияНаПортале) Тогда 
				СчУспешных = СчУспешных + 1;
			Иначе
			    СчНеуспешных = СчНеуспешных + 1;
			КонецЕсли;
			
		КонецЦикла;
		
		Сообщить(НСтр("ru = 'Обновлено атрибуты в портальных категориях: '; uk = 'Оновлено атрибути в портальних категоріях: '") + СчУспешных);
		Сообщить(НСтр("ru = 'Ошибки при обновлении атрибутов в портальных категориях: '; uk = 'Помилки при оновленні атрибутів в портальних категоріях: '") + СчНеуспешных);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТорговаяПлощадка()

	Возврат Объект.ТорговаяПлощадка;

КонецФункции

&НаСервере
Функция ПолучитьСписокСпособовОплатНаСервере()

	Настройки = eCommСервер.Настройки(Объект.Ссылка);
	
	СпособыОплаты = Справочники.eComm_УчетныеЗаписи.ПолучитьСпособыОплаты(Настройки);
	
	Возврат СпособыОплаты;

КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеВыбораЭлементаСправочникаOLX(Данные, ДопПараметры = Неопределено) Экспорт

	Если ТипЗнч(Данные) = Тип("Структура") Тогда 
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Данные);
		Модифицированность = Истина;
		
	КонецЕсли;

КонецПроцедуры

