&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(Ответ, Действие) Экспорт

	Если НЕ Ответ = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	Если Действие = "СгенерироватьИнтернетРеквизиты" Тогда 
		СгенерироватьИнтернетРеквизитыНаСервере();
	ИначеЕсли Действие = "ОчиститьКэшВыгруженныхИзображений" Тогда 
		ОчиститьКэшВыгруженныхИзображенийНаСервере();
	ИначеЕсли Действие = "ОбновитьПортальныеКатегории" Тогда 
		ОбновитьПортальныеКатегорииНаСервере();
	ИначеЕсли Действие = "ОбновитьАтрибутыПортальныхКатегорий" Тогда 
		ОбновитьАтрибутыПортальныхКатегорийНаСервере();	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗначенияИзСписка(Результат, ИмяРеквизитаСписокЗначений = "") Экспорт

	Если НЕ ТипЗнч(Результат) = Тип("СписокЗначений") 
		ИЛИ ИмяРеквизитаСписокЗначений = "" Тогда 
		
		Возврат;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Если ИмяРеквизитаСписокЗначений = "ДекорацияОбновляемыеПоля" Тогда 
		Элементы.ДекорацияОбновляемыеПоля.Заголовок = ВернутьПредставлениеСпискаЗначений(Результат);	
		ЭтаФорма.ОбновляемыеПоляНаСайте = Результат;
	ИначеЕсли ИмяРеквизитаСписокЗначений = "ДекорацияПоляДляПеревода" Тогда 
		Элементы.ДекорацияПоляДляПеревода.Заголовок = ВернутьПредставлениеСпискаЗначений(Результат);	
		ЭтаФорма.ПоляДляПеревода = Результат;
	Иначе
		ЭтаФорма["" + ИмяРеквизитаСписокЗначений + "Строкой"] = ВернутьПредставлениеСпискаЗначений(Результат);	
		ЭтаФорма[ИмяРеквизитаСписокЗначений] = Результат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВопросаОбОчисткеСпособовОплат(Ответ, СпособыОплат) Экспорт

	Если Ответ = КодВозвратаДиалога.ОК Тогда 
		ЗаполнитьСпособыОплатыНаКлиенте(СпособыОплат);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗаказыЗаПериодНаКлиенте(Период, СтруктураНастроек) Экспорт

	Если Период = Неопределено Тогда 
		Возврат;
	КонецЕсли;

	eCommСервер.ЗагрузитьЗаказы(СтруктураНастроек, Период.ДатаНачала, Период.ДатаОкончания);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСтатусыОплатЗаПериодНаКлиенте(Период, СтруктураНастроек) Экспорт

	Если Период = Неопределено Тогда 
		Возврат;
	КонецЕсли;

	eCommСервер.ЗагрузитьСтатусыОплатПоЗаказам(СтруктураНастроек, Период.ДатаНачала, Период.ДатаОкончания);
	
КонецПроцедуры

&НаСервере
Функция ВернутьПредставлениеСпискаЗначений(Список)

	СтрокаСостоянияВыбора = "";
	Для Каждого Стр Из Список Цикл 
		Если Стр.Пометка Тогда 
			СтрокаСостоянияВыбора = СтрокаСостоянияВыбора + ?(СтрокаСостоянияВыбора = "", "", "; ") + Стр.Представление;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаСостоянияВыбора = "" Тогда 
		СтрокаСостоянияВыбора = "<не указано>";
	КонецЕсли;
	
	Возврат СтрокаСостоянияВыбора;

КонецФункции

&НаСервере
Процедура ЗаполнитьПредставлениеСпискаОптовыхЦен()

	СтрокаПредставления = "";
	
	Для Каждого Стр Из Объект.ОптовыеЦены Цикл 
		СтрокаПредставления = СтрокаПредставления + ?(СтрокаПредставления = "", "", "; ") + Стр.ВидЦены;
	КонецЦикла;
	
	Если СтрокаПредставления = "" Тогда 
		СтрокаПредставления = "<не указано>";
	КонецЕсли;
	
	ОптовыеЦеныСтрокой = СтрокаПредставления;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеСпискаУровнейЦен()

	СтрокаПредставления = "";
	
	Для Каждого Стр Из Объект.УровниЦенB2B Цикл 
		СтрокаПредставления = СтрокаПредставления + ?(СтрокаПредставления = "", "", "; ") + Стр.ВидЦены;
	КонецЦикла;
	
	Если СтрокаПредставления = "" Тогда 
		СтрокаПредставления = "<не указано>";
	КонецЕсли;
	
	УровниЦенСтрокой = СтрокаПредставления;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеМеток(ТипМетки, Метки, ИмяЭлемента)

	ОписаниеМетки = "";
	Для Каждого Стр Из Метки Цикл
		Если Стр.Значение.ТипМетки = ТипМетки Тогда 
			ОписаниеМетки = ОписаниеМетки + ?(ОписаниеМетки = "", "", "; ") + Стр.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если ОписаниеМетки = "" Тогда 
		ОписаниеМетки = "<не выбрано>";
	КонецЕсли;
	
	ЭтаФорма["" + ИмяЭлемента + "Строкой"] = ОписаниеМетки;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()

	// Применим настройки согласно шаблона для торговой площадки
	//
	
	Если НЕ ЗначениеЗаполнено(Объект.ТорговаяПлощадка) Тогда 
		Возврат;
	КонецЕсли;
	
	МакетНастроек = Справочники.eComm_УчетныеЗаписи.ПолучитьМакет("НастройкиДоступностиРеквизитов");
	
	КоличествоЗаписей = МакетНастроек.ВысотаТаблицы;
	
	ИмяЗначенияПеречисления = eCommСервер.ВернутьИмяЗначенияПеречисления(Объект.ТорговаяПлощадка);
	НомерКолонки			= 0;
	
	Для Сч = 0 По МакетНастроек.ШиринаТаблицы - 1 Цикл
		Если СокрЛП(МакетНастроек.Область(1, Сч).Текст) = ИмяЗначенияПеречисления Тогда 
			НомерКолонки = Сч;
		КонецЕсли;
	КонецЦикла;
		
	Для Сч = 2 по КоличествоЗаписей Цикл
		
		ИмяЭлемента = СокрЛП(МакетНастроек.Область(Сч, 1).Текст);
		
		Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда 
			Продолжить;
		КонецЕсли;
		
		Видимость = СокрЛП(МакетНастроек.Область(Сч, НомерКолонки).Текст) = "+";
		
		Если НЕ Элементы[ИмяЭлемента].Видимость = Видимость Тогда 
			Элементы[ИмяЭлемента].Видимость = Видимость;
		КонецЕсли;
		
	КонецЦикла;

	
	// Применим настройки учетной записи
	//
	
	Элементы.ЗагрузкаЗаказов.Видимость 			= Объект.ЗагружатьЗаказы;
	Элементы.ВыгрузкаТоваров.Видимость 			= Объект.ВыгружатьТовары;
	
	Элементы.ГруппаРасписаниеТовары.Доступность = Объект.ВыгружатьТовары;
	Элементы.ГруппаВыгружатьТовары.Доступность	= Объект.ВыгружатьТовары;
	Элементы.ГруппаЗагружатьЗаказы.Доступность 	= Объект.ЗагружатьЗаказы;
	Элементы.ГруппаРасписаниеЗаказы.Доступность = Объект.ЗагружатьЗаказы;
	
	Если Объект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда 
		Если НЕ Элементы.ГруппаВыгружатьЗаказы.Видимость = Истина Тогда 
			Элементы.ГруппаВыгружатьЗаказы.Видимость = Истина;
		КонецЕсли;
		Элементы.ГруппаВыгружатьЗаказы.Доступность = Объект.ЗагружатьЗаказы;
	Иначе
		Элементы.ГруппаВыгружатьЗаказы.Видимость = Ложь;
	КонецЕсли;
	
	Если ТипПодключенияКВебСерверу = "" Тогда
		// Это ФТП
		Элементы.ГруппаФТП.Видимость 			= Истина;
		Элементы.ГруппаОбщаяПапка.Видимость 	= Ложь;
	ИначеЕсли ТипПодключенияКВебСерверу = "ОбщаяПапка" Тогда
		// Это сетевая папка
		Элементы.ГруппаФТП.Видимость 			= Ложь;
		Элементы.ГруппаОбщаяПапка.Видимость 	= Истина;
	КонецЕсли;
	
	Элементы.СкопироватьПутьКФайлу.Видимость = eCommСервер.ТипПлатформыСтрокой() = "Windows";
		
	Элементы.ПланСинхронизацииСтатусов.Доступность 				= Объект.СинхронизироватьСтатусыЗаказов;
	Элементы.НеИзменятьСтатусОплаченногоЗаказаProm.Доступность 	= Объект.СинхронизироватьСтатусыЗаказов;
	
	МультиязычностьПоддерживается = НЕ eCommСервер.ОбщийМодуль("МультиязычностьСервер") = Неопределено;
	Элементы.МультиязычностьЗаголовок.Видимость				= МультиязычностьПоддерживается;
	Элементы.МультиязычностьСворачиваемаяГруппа.Видимость	= МультиязычностьПоддерживается;
	
	Элементы.ГруппаПереводчик.Доступность 		= МультиязычностьПоддерживается 
												И ИспользоватьМультиязычность; 
												//И НЕ Метаданные.Обработки.Найти("eComm_Translator") = Неопределено;
											
	Элементы.ИспользоватьАртикулХарактеристики.Видимость 	= Метаданные.Справочники.ХарактеристикиНоменклатуры.Реквизиты.Найти("Артикул") = Неопределено;
	
	//Элементы.ПереводYandexTranslateAPIKey.Видимость = (ПереводСервис = "Yandex");
	Элементы.ПереводAPIKey.Видимость = (ПереводСервис = "DeepL");
	
	ИмяСправочникаКлиенты = eCommСервер.ВернутьИмяСправочникПартнеры();
	//Элементы.ГруппаДляНовыхКлиентов.Видимость	= НЕ Метаданные.Справочники[ИмяСправочникаКлиенты].ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияЭлементов;
	Если ИмяСправочникаКлиенты = "Партнеры" Тогда 
		Элементы.ГруппаДляНовыхКлиентов.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + ИмяСправочникаКлиенты);
	КонецЕсли;
	
	// Только для Хорошоп
	Если Элементы.ГруппаМетки.Видимость = Истина Тогда 
		ЗаполнитьПредставлениеМеток(Перечисления["eComm_ТипыМеток"].Ярлык, Ярлыки, "Ярлыки");
		ЗаполнитьПредставлениеМеток(Перечисления["eComm_ТипыМеток"].Маркетплейс, Маркетплейсы, "Маркетплейсы");
	КонецЕсли;
	
	Попытка
		ИмяКартинки = Строка(Объект.ТорговаяПлощадка);
		ИмяКартинки = СтрЗаменить(ИмяКартинки, ".ua", "");
		ИмяКартинки = СтрЗаменить(ИмяКартинки, ".ru", "");
		ИмяКартинки = СтрЗаменить(ИмяКартинки, ".com", "");
		ИмяКартинки = СтрЗаменить(ИмяКартинки, ".pro", "");
		ИмяКартинки = СтрЗаменить(ИмяКартинки, " ", "");
		Элементы.Декорация.Картинка = Элементы["Декорация" + ИмяКартинки].Картинка;
	Исключение
	КонецПопытки;

КонецПроцедуры

