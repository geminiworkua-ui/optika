
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УчетнаяЗапись", УчетнаяЗапись);
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Сообщить("Не заполнена учетная запись!!!");
		Отказ = Истина;
	Иначе
		Заголовок = "Создание интернет-реквизитов для " + УчетнаяЗапись;
	КонецЕсли;
	
	Настройки = eCommСервер.Настройки(УчетнаяЗапись);
	
	ЯрлыкиПоУмолчанию		= eCommСервер.ВернутьЗначениеНастройки(Настройки, "ВыгрузкаТоваров", "Ярлыки");
	МаркетплейсыПоУмолчанию	= eCommСервер.ВернутьЗначениеНастройки(Настройки, "ВыгрузкаТоваров", "Маркетплейсы");
	
	//++
	//СтруктураКатегорий = eCommСервер.ВернутьЗначениеНастройки(Настройки, "ВыгрузкаТоваров", "ОснованиеГенерацииКатегорий");
	//ИмяСправочникаКатегории = СтруктураКатегорий;
	//МетаданныеСправочникаКатегорий = Метаданные.Справочники.Найти(ИмяСправочникаКатегории);
	//Если НЕ МетаданныеСправочникаКатегорий = Неопределено Тогда 
	//	СинонимСправочникаКатегорий = МетаданныеСправочникаКатегорий.Синоним;
	//	Элементы.СтруктураКатегорий.СписокВыбора.Добавить(ИмяСправочникаКатегории, "Справочника """ + СинонимСправочникаКатегорий + """");
	//КонецЕсли;
	
	ИмяРеквизитаКатегорияНоменклатуры	= eCommСервер.ВернутьЗначениеНастройки(Настройки, "ВыгрузкаТоваров", "ИмяРеквизитаКатегорияИнтернетТовара");
	Если ЗначениеЗаполнено(ИмяРеквизитаКатегорияНоменклатуры) Тогда 
		
		Если ИмяРеквизитаКатегорияНоменклатуры = "Родитель" Тогда 
			ИмяСправочникаКатегории 	= "Номенклатура";
			Элементы.ИмяСправочникаКатегории.СписокВыбора.Добавить(ИмяСправочникаКатегории, "Справочника ""Номенклатура""");
		Иначе
			МетаданныеРеквизита = Метаданные.Справочники.Номенклатура.Реквизиты.Найти(ИмяРеквизитаКатегорияНоменклатуры);
			Если НЕ МетаданныеРеквизита = Неопределено Тогда
				// Получим объект метаданных из типа
				
				МассивТипов = МетаданныеРеквизита.Тип.Типы();
				Если МассивТипов.Количество() = 1 Тогда 
					
					МетаданныеСправочникаКатегорий = Метаданные.НайтиПоТипу(МассивТипов[0]);
					
					ИмяСправочникаКатегории 	= МетаданныеСправочникаКатегорий.Имя;
					СинонимСправочникаКатегорий = МетаданныеСправочникаКатегорий.Синоним;
					
					Элементы.ИмяСправочникаКатегории.СписокВыбора.Добавить(ИмяСправочникаКатегории, "Справочника """ + СинонимСправочникаКатегорий + """");
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	//--
	
	УстановитьВидимость();
	
	ЗагрузитьНастройкиОтборовКомпоновкиДанныхПриЧтении(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ВариантСозданияКатегорий = Истина Тогда 
		//ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Категория"));
	Иначе
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ИмяСправочникаКатегории"));
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВариантСозданияКатегорийПриИзменении(Элемент)
	
	УстановитьВидимость();
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьИнтернетРеквизиты(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтаФорма, "СгенерироватьИнтернетРеквизиты");
	ТекстВопроса = "Вы действительно хотите сгенерировать интернет-реквизиты для учетной записи 
					|""" + УчетнаяЗапись + """ согласно установленного отбора?
					|Как правило это требуется для новой учетной записи. Продолжайте
					|только в случае если Вы точно уверены в необходимости этого.
					|Продолжить?";
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена,,, "Создание интернет-реквизитов");
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура ЗагрузитьНастройкиОтборовКомпоновкиДанныхПриЧтении(ТекущийОбъект = Неопределено)

	СтруктураНастроек 	= eCommСервер.Настройки(УчетнаяЗапись);
	
	СхемаКомпоновкиДанных = Неопределено;
	
	Попытка 
		СхемаКомпоновкиДанных = Справочники.eComm_УчетныеЗаписи.ПолучитьМакет("НастройкиГенерацииИнтернетТоваров");
	Исключение
		
	КонецПопытки;
	
	Если СхемаКомпоновкиДанных = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ТекстЗапросаПоТоварам = eCommСервер.ВернутьТекстЗапросаПоТоварам(СтруктураНастроек);
	
	Если ЗначениеЗаполнено(ТекстЗапросаПоТоварам) Тогда 
		СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Запрос = ТекстЗапросаПоТоварам;
	КонецЕсли;
	
	ПараметрыКомпоновки = СхемаКомпоновкиДанных.Параметры;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ТипЦены");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, СтруктураНастроек.ТипЦены);
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ТекущаяДата");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, ТекущаяДата());
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ИспользоватьХарактеристики");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, eCommСервер.ВключеноИспользованиеХарактеристик());
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ОграничениеМаксимальогоОстатка");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, СтруктураНастроек.ОграничениеМаксимальогоОстатка);
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("ОграничениеМинимальногоОстатка");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, СтруктураНастроек.ОграничениеМинимальногоОстатка);
	КонецЕсли;
	
	ЭлементПараметра = ПараметрыКомпоновки.Найти("УчетнаяЗапись");
	Если НЕ ЭлементПараметра = Неопределено Тогда 
		УстановитьПараметрКомпоновки(ЭлементПараметра, СтруктураНастроек.УчетнаяЗапись);
	КонецЕсли;
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресВоВременномХранилище);
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрКомпоновки(ЭлементПараметра, ЗначениеПараметра) Экспорт
	
	ЭлементПараметра.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
	ЭлементПараметра.Значение = ЗначениеПараметра;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	Если ВариантСозданияКатегорий = Истина Тогда 
		НоваяСтраница = Элементы.СтраницаАвтоматически;
	Иначе
		НоваяСтраница = Элементы.СтраницаВручную;
	КонецЕсли;
	
	Элементы.СтраницыКатегорий.ТекущаяСтраница = НоваяСтраница;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(Ответ, Действие) Экспорт

	Если НЕ Ответ = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	Если Действие = "СгенерироватьИнтернетРеквизиты" Тогда 
		СгенерироватьИнтернетРеквизитыНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СгенерироватьИнтернетРеквизитыНаСервере()

	Если НЕ ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда 
		
		СтруктураНастроек 	= eCommСервер.Настройки(УчетнаяЗапись);
		СтруктураНастроек.ВыгружатьТолькоИзменения = Ложь;
		
		НеПодставлятьХарактеристикуВНаименование 	= eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "НеПодставлятьХарактеристикуВНаименование");
		ИмяРеквизитаНаименованиеИнтернетТовара 		= eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ИмяРеквизитаНаименованиеИнтернетТовара");
		ИмяРеквизитаОписаниеИнтернетТовара			= eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ИмяРеквизитаОписаниеИнтернетТовара");
		ИмяРеквизитаКатегорияИнтернетТовара			= eCommСервер.ВернутьЗначениеНастройки(СтруктураНастроек, "ВыгрузкаТоваров", "ИмяРеквизитаКатегорияИнтернетТовара");
		
		Если НЕ ЗначениеЗаполнено(ИмяРеквизитаНаименованиеИнтернетТовара) Тогда 
			ИмяРеквизитаНаименованиеИнтернетТовара = "Наименование";
		КонецЕсли;
		
		СтруктураНастроек.Вставить("НастройкиКомпоновщика", КомпоновщикНастроек.ПолучитьНастройки());

		ТаблицаТоваров = Справочники.eComm_УчетныеЗаписи.ВернутьТаблицуТоваров(СтруктураНастроек);
		
		Если ВариантСозданияКатегорий = Истина Тогда 
			ИмяСпрКатегорииНоменклатуры = ИмяСправочникаКатегории;
			//Если ИмяСпрКатегорииНоменклатуры = "Номенклатура" Тогда 
			//	ИмяРеквизитаКатегория = "Родитель";
			//Иначе
			//	ИмяРеквизитаКатегория = eCommСервер.ВернутьИмяРеквизитаОбъекта("КатегорииНоменклатуры", "КатегорияНоменклатуры");
			//КонецЕсли;      
			
			СоответствиеСозданныхКатегорий 	= Новый Соответствие;
			
			Если НЕ ИмяСпрКатегорииНоменклатуры = "" Тогда 
				СгенерироватьИерархиюКатегорий(ТаблицаТоваров, СоответствиеСозданныхКатегорий, ИмяСпрКатегорииНоменклатуры, ИмяРеквизитаКатегорияИнтернетТовара);
			КонецЕсли;
			
		Иначе // Ручной выбор категории
			
		КонецЕсли;
		
		//ТаблицаТоваров.Свернуть("Номенклатура");
		Для Каждого Стр Из ТаблицаТоваров Цикл 
			
			НовыйИнтернетРеквизит = Справочники.eComm_ИнтернетТовары.СоздатьЭлемент();
			НовыйИнтернетРеквизит.Владелец 		= УчетнаяЗапись;
			НовыйИнтернетРеквизит.Номенклатура 	= Стр.Номенклатура;
			НовыйИнтернетРеквизит.ХарактеристикаНоменклатуры = Стр.ХарактеристикаНоменклатуры;
			Если НеПодставлятьХарактеристикуВНаименование = Истина Тогда 
				НовыйИнтернетРеквизит.Наименование 	= Строка(Стр.Номенклатура[ИмяРеквизитаНаименованиеИнтернетТовара]);
			Иначе
				НовыйИнтернетРеквизит.Наименование 	= Строка(Стр.Номенклатура[ИмяРеквизитаНаименованиеИнтернетТовара]) + ?(ЗначениеЗаполнено(Стр.ХарактеристикаНоменклатуры), ", " + Стр.ХарактеристикаНоменклатуры, "");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИмяРеквизитаОписаниеИнтернетТовара) Тогда 
				НовыйИнтернетРеквизит.Описание = Строка(Стр.Номенклатура[ИмяРеквизитаОписаниеИнтернетТовара]);
			КонецЕсли;
			
			Если ВариантСозданияКатегорий = Истина Тогда 
				
				КатегорияСсылка = СоответствиеСозданныхКатегорий[Стр.Номенклатура[ИмяРеквизитаКатегорияИнтернетТовара]];
				
				Если ЗначениеЗаполнено(КатегорияСсылка) Тогда 
					НовыйИнтернетРеквизит.Категория = КатегорияСсылка;
				КонецЕсли;
			Иначе
				НовыйИнтернетРеквизит.Категория = Категория;
			КонецЕсли;
			
			// Только для Horoshop.ua
			Для Каждого ЭлементСписка Из ЯрлыкиПоУмолчанию Цикл 
				СтрокаМетки = НовыйИнтернетРеквизит.Метки.Добавить();
				СтрокаМетки.Метка = ЭлементСписка.Значение;
			КонецЦикла;
			
			Для Каждого ЭлементСписка Из МаркетплейсыПоУмолчанию Цикл 
				СтрокаМетки = НовыйИнтернетРеквизит.Метки.Добавить();
				СтрокаМетки.Метка = ЭлементСписка.Значение;
			КонецЦикла;
			
			НовыйИнтернетРеквизит.Записать();
			
		КонецЦикла;
		
		Сообщить("Создано " + ТаблицаТоваров.Количество() + " интернет-товаров...");
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СгенерироватьИерархиюКатегорий(ТаблицаТоваров, СоответствиеРодителей, ИмяСпрКатегорииНоменклатуры, ИмяРеквизитаКатегория)

	ЗапросТекст = 
		"ВЫБРАТЬ
		|	ТЗ.Номенклатура
		|ПОМЕСТИТЬ ВрТабНоменклатура
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Номенклатура.#КатегорияНоменклатуры# КАК КатегорияНоменклатуры
		|ПОМЕСТИТЬ ВрТабКатегории
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В
		|			(ВЫБРАТЬ
		|				ВрТабНоменклатура.Номенклатура
		|			ИЗ
		|				ВрТабНоменклатура КАК ВрТабНоменклатура)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КатегорииНоменклатуры.Ссылка КАК Ссылка,
		|	КатегорииНоменклатуры.Родитель
		|ИЗ
		|	Справочник.#КатегорииНоменклатуры# КАК КатегорииНоменклатуры
		|ГДЕ
		|	КатегорииНоменклатуры.Ссылка В
		|			(ВЫБРАТЬ
		|				ВрТабКатегории.КатегорияНоменклатуры
		|			ИЗ
		|				ВрТабКатегории КАК ВрТабКатегории)
		|
		|Итоги ПО
		|	Ссылка Только ИЕРАРХИЯ"; 
	
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "#КатегорииНоменклатуры#", ИмяСпрКатегорииНоменклатуры);
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "#КатегорияНоменклатуры#", ИмяРеквизитаКатегория);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросТекст;
	Запрос.УстановитьПараметр("ТЗ", ТаблицаТоваров);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		// Идентификатор ссылки перенесем из родительского справочника
		// для будущей идентификации категорий
		//СсылкаНового = Справочники.eComm_КатегорииТоваров.ПолучитьСсылку(ВыборкаДетальныеЗаписи.Ссылка.УникальныйИдентификатор());
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Ссылка) Тогда
			// категория верхнего уровня
			Продолжить;
		КонецЕсли;
		
		Категория = Справочники.eComm_КатегорииТоваров.НайтиПоРеквизиту("ОснованиеКатегории", ВыборкаДетальныеЗаписи.Ссылка, , УчетнаяЗапись);
		
		// Убедимся что ранее еще не создавали данную категорию
		//Если СсылкаНового.ПолучитьОбъект() = Неопределено Тогда 
		Если НЕ ЗначениеЗаполнено(Категория) Тогда 
			
			НоваяКатегория = Справочники.eComm_КатегорииТоваров.СоздатьЭлемент();
