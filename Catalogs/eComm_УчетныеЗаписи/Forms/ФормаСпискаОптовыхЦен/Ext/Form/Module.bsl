
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УровниЦенB2B", УровниЦенB2B);
	Если УровниЦенB2B = Ложь Тогда 
		Элементы.ОптовыеЦеныКодЦеныНаСайте.Видимость = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("СписокСтрок") 
		И ТипЗнч(Параметры.СписокСтрок) = Тип("Массив") Тогда 
		
		Для Каждого Стр Из Параметры.СписокСтрок Цикл 
			ЗаполнитьЗначенияСвойств(ОптовыеЦены.Добавить(), Стр);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	СписокСтрок = Новый Массив;
	Для Каждого Стр Из ОптовыеЦены Цикл
		СписокСтрок.Добавить(Новый Структура("ВидЦены, КодЦеныНаСайте", Стр.ВидЦены, Стр.КодЦеныНаСайте));
	КонецЦикла;

	Закрыть(СписокСтрок);
	
КонецПроцедуры
