
Процедура ПередЗаписью(Отказ)
	
	Если ЗначениеЗаполнено(СостояниеЗаказаПокупателя) Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	eComm_СостоянияЗаказовТорговойПлощадки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.eComm_СостоянияЗаказовТорговойПлощадки КАК eComm_СостоянияЗаказовТорговойПлощадки
			|ГДЕ
			|	eComm_СостоянияЗаказовТорговойПлощадки.Владелец = &Владелец
			|	И eComm_СостоянияЗаказовТорговойПлощадки.СостояниеЗаказаПокупателя = &СостояниеЗаказаПокупателя
			|	И НЕ eComm_СостоянияЗаказовТорговойПлощадки.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Владелец"					, Владелец);
		Запрос.УстановитьПараметр("СостояниеЗаказаПокупателя"	, СостояниеЗаказаПокупателя);
		Запрос.УстановитьПараметр("Ссылка"						, Ссылка);
		
		Отказ = НЕ Запрос.Выполнить().Пустой();
		
		Если Отказ Тогда 
			Сообщить("По учетной записи """ + Владелец + """ для состояния заказа """ + СостояниеЗаказаПокупателя + """ соответствие уже задано!!! Дублирование запрещено");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
