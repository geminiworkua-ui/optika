
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьВидимость();	
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	УстановитьВидимость();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОграничиватьДоступныеСостоянияПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура УстановитьВидимость()

	Если Объект.Владелец.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда
		
		Элементы.ПользовательскийСтатус.Видимость = Истина;
		Если Объект.Наименование = "canceled" Тогда 
			Элементы.ПричинаОтменыСервиса.Видимость = Истина;
			
			Настройки = eCommСервер.Настройки(Объект.Владелец);
			
			ПричиныОтмены = Обработки["eComm_Prom"].ПричиныОтменыЗаказа(Настройки);
			
			Если ТипЗнч(ПричиныОтмены) = Тип("Массив") Тогда
				Элементы.ПричинаОтменыСервиса.РежимВыбораИзСписка = Истина;
				Для Каждого ПричинаОтмены Из ПричиныОтмены Цикл 
					Элементы.ПричинаОтменыСервиса.СписокВыбора.Добавить(ПричинаОтмены.Значение, ПричинаОтмены.Представление);
				КонецЦикла;
			Иначе
				
				// Дадим возможность ввести вручную
				Элементы.ПричинаОтменыСервиса.РежимВыбораИзСписка = Ложь;
				
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Объект.Владелец.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Allo Тогда
		
		Если Объект.Наименование = "5" Тогда 
			
			Элементы.ПричинаОтменыСервиса.Видимость = Истина;
			
			Настройки = eCommСервер.Настройки(Объект.Владелец);
			
			ПричиныОтмены = Обработки["eComm_Allo"].ПричиныОтменыЗаказа(Настройки);
			
			Если ТипЗнч(ПричиныОтмены) = Тип("Массив") Тогда
				Элементы.ПричинаОтменыСервиса.РежимВыбораИзСписка = Истина;
				Для Каждого ПричинаОтмены Из ПричиныОтмены Цикл 
					Элементы.ПричинаОтменыСервиса.СписокВыбора.Добавить(ПричинаОтмены.Значение, ПричинаОтмены.Представление);
				КонецЦикла;
			Иначе
				
				// Дадим возможность ввести вручную
				Элементы.ПричинаОтменыСервиса.РежимВыбораИзСписка = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		Элементы.ПользовательскийСтатус.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ДоступныеСостояния.Видимость = Объект.ОграничиватьДоступныеСостояния;

КонецПроцедуры

