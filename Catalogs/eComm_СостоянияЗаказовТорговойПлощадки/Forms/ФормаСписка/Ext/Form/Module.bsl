
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Отбор")
		И ТипЗнч(Параметры.Отбор) = Тип("Структура")
		И Параметры.Отбор.Свойство("Владелец")
		И ТипЗнч(Параметры.Отбор.Владелец) = Тип("СправочникСсылка.eComm_УчетныеЗаписи")
		И ЗначениеЗаполнено(Параметры.Отбор.Владелец) Тогда
		
		УчетнаяЗапись = Параметры.Отбор.Владелец;
		
	КонецЕсли;
	
	Элементы.ФормаЗаполнитьПоШаблону.Видимость = ЗначениеЗаполнено(УчетнаяЗапись);
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ЗаполнитьПоШаблону(Команда)
	
	Если ЕстьСтатусыВУчетнойЗаписи(УчетнаяЗапись) Тогда 
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтаФорма, Неопределено);
		
		ТекстВопроса 	= НСтр("ru = 'Заполнить список статусов по умолчанию для этой учетной записи?'; uk = 'Заповнити список статусів для цього облікового запису?'");
		ТекстЗаголовка 	= НСтр("ru = 'Обновление списка статусов'; uk = 'Оновлення списку статусів'");
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , КодВозвратаДиалога.ОК, ТекстЗаголовка);
		
	Иначе
		
		ЗаполнитьПоШаблонуНаСервере(УчетнаяЗапись);
		Элементы.Список.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(Ответ, ДопПараметры = Неопределено) Экспорт

	Если НЕ Ответ = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоШаблонуНаСервере(УчетнаяЗапись);
	Элементы.Список.Обновить();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПоШаблонуНаСервере(УчетнаяЗапись)

	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда 
		
		СтруктураНастроек = eCommСервер.Настройки(УчетнаяЗапись);
		Справочники.eComm_УчетныеЗаписи.АктуализироватьСправочникСтатусов(СтруктураНастроек);
		
		Сообщить(НСтр("ru = 'Обновление статусов успешно завершено. Проверьте (заполните вручную) поле ""Состояние заказа покупателя""'; uk = 'Оновлення статусів успішно завершено. Перевірте (заповніть вручну) поле ""Стан замовлення покупця""'"));
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьСтатусыВУчетнойЗаписи(УчетнаяЗапись)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СостоянияЗаказовТоргПлощадки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_СостоянияЗаказовТорговойПлощадки КАК СостоянияЗаказовТоргПлощадки
		|ГДЕ
		|	СостоянияЗаказовТоргПлощадки.Владелец = &УчетнаяЗапись";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции






