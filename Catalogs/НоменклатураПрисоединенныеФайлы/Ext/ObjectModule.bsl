Процедура ПриЗаписи(Отказ)
		
	//ЗарегистрироватьКПередачеНаСайт(Ссылка);
	ЗарегистрироватьКПередачеНаСайт(Ссылка);

	
КонецПроцедуры

Процедура ЗарегистрироватьКПередачеНаСайт(Ссылка)
	
	Если НЕ Ссылка.ВладелецФайла.РазрешенОбменСайт Тогда	
		Возврат;
	КонецЕсли;	
	Узлы = Новый Массив;
	Если Ссылка.ВладелецФайла.СайтLuxor Тогда	
		Узлы.Добавить(ПланыОбмена.ОбменССайтомНовый.НайтиПоКоду("0002"));
	КонецЕсли;
	Если Ссылка.ВладелецФайла.СайтPolaroid Тогда	
		Узлы.Добавить(ПланыОбмена.ОбменССайтомНовый.НайтиПоКоду("0001"));
	КонецЕсли;
	Для каждого Узел из Узлы Цикл 
		НаборСС = РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
		НаборСС.Отбор.Номенклатура.Установить(Ссылка.ВладелецФайла);
		НаборСС.Отбор.Направление.Установить(Перечисления.НаправлениеДляПередачи.Картинки); 
		НаборСС.Отбор.УзелРегистрации.Установить(Узел);
		НаборСС.Прочитать();
		Если НаборСС.Количество() = 0 Тогда 
			Запись = наборСС.Добавить();
			Запись.Номенклатура = Ссылка.ВладелецФайла;
			Запись.Направление = Перечисления.НаправлениеДляПередачи.Картинки;
			Запись.УзелРегистрации = Узел;
			НаборСС.Записать(Истина);		
		КонецЕсли;                   
	КонецЦикла;
	
КонецПроцедуры

