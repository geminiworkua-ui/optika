	//	И НЕ Лев(Наименование_ru, 1) = "+"
	//	Тогда
	//	Наименование_ru = "+" + Наименование_ru;
	//КонецЕсли;
	Если Наименование_ru = ""
		ТОгда
		Наименование_ru = Наименование;	
	КонецЕсли;
		
