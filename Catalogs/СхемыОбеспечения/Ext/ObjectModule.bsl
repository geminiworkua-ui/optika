


Процедура ПередЗаписью(Отказ)
	
	НужнаяСсылка = Ссылка;
	Если НужнаяСсылка.Пустая() Тогда
	   	ЭтотОбъект.УстановитьСсылкуНового(Справочники.СхемыОбеспечения.ПолучитьСсылку());
		НужнаяСсылка = ПолучитьСсылкуНового();
		
	КонецЕсли;
	
	УстановитьПРивилегированныйРежим(Истина);
	Запрос = НОвый Запрос("ВЫБРАТЬ
	                      |	Назначения.ВидНоменклатуры,
	                      |	Назначения.Марка
	                      |ПОМЕСТИТЬ вт_Сбор1
	                      |ИЗ
	                      |	&Назначения КАК Назначения
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	вт_Сбор1.ВидНоменклатуры,
	                      |	вт_Сбор1.Марка,
	                      |	ВложенныйЗапрос.СсылкаСхема
	                      |ПОМЕСТИТЬ вт_сбор2
	                      |ИЗ
	                      |	вт_Сбор1 КАК вт_Сбор1
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			СхемыОбеспеченияНазначения.Ссылка.Ссылка КАК СсылкаСхема,
	                      |			СхемыОбеспеченияНазначения.ВидНоменклатуры КАК ВидНоменклатуры,
	                      |			СхемыОбеспеченияНазначения.Марка КАК Марка
	                      |		ИЗ
	                      |			Справочник.СхемыОбеспечения.Назначения КАК СхемыОбеспеченияНазначения
	                      |		ГДЕ
	                      |			НЕ СхемыОбеспеченияНазначения.Ссылка.Ссылка = &Ссылка) КАК ВложенныйЗапрос
	                      |		ПО вт_Сбор1.ВидНоменклатуры = ВложенныйЗапрос.ВидНоменклатуры
	                      |			И вт_Сбор1.Марка = ВложенныйЗапрос.Марка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	вт_сбор2.ВидНоменклатуры,
	                      |	вт_сбор2.Марка,
	                      |	вт_сбор2.СсылкаСхема
	                      |ИЗ
	                      |	вт_сбор2 КАК вт_сбор2
	                      |ГДЕ
	                      |	НЕ вт_сбор2.СсылкаСхема ЕСТЬ NULL");	
	
	Запрос.УстановитьПараметр("Ссылка", НужнаяСсылка);
	Запрос.УстановитьПараметр("Назначения", Назначения);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		Отказ = Истина;
		Сообщить("Помилка! Комбінація Виду номенклатури ``" + Строка(Выборка.ВидНоменклатуры) + "`` та бренду ``" + Строка(Выборка.Марка) + 
				"`` вже використана у схемі забезпечення " + Строка(Выборка.СсылкаСхема));
	КонецЦикла;
	УстановитьПРивилегированныйРежим(Ложь);
	
КонецПроцедуры	