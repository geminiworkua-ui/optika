
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ЗначениеЗаполнено(ПараметрКоманды) Тогда
		Если ИспользуетсяТолькоОднаУчетнаяЗапись() Тогда
			
			ЗначениеИнтернетСвойства = ВернутьЗначениеИнтернетСвойства(ПараметрКоманды);   
			ПараметрыФормы = Новый Структура("Ключ", ЗначениеИнтернетСвойства);
			
			Если НЕ ЗначениеЗаполнено(ЗначениеИнтернетСвойства) Тогда 
				ПараметрыЗаполнения = Новый Структура("ЗначениеСвойства", ПараметрКоманды);
				ПараметрыФормы.Вставить("ЗначенияЗаполнения", ПараметрыЗаполнения);
			КонецЕсли;
			
			ОткрытьФорму("Справочник.eComm_ЗначенияСвойствТоваров.ФормаОбъекта", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка); 
			
		Иначе
			
			ПараметрыФормы = Новый Структура("Отбор", Новый Структура("ЗначениеСвойства", ПараметрКоманды));
			ОткрытьФорму("Справочник.eComm_ЗначенияСвойствТоваров.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ИспользуетсяТолькоОднаУчетнаяЗапись()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи КАК УчетныеЗаписи
		|ГДЕ
		|	УчетныеЗаписи.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Возврат РезультатЗапроса.Количество() = 1;
	
КонецФункции

&НаСервере
Функция ВернутьЗначениеИнтернетСвойства(ЗначениеСвойства)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияИнтернетСвойств.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_ЗначенияСвойствТоваров КАК ЗначенияИнтернетСвойств
		|ГДЕ
		|	ЗначенияИнтернетСвойств.ЗначениеСвойства = &ЗначениеСвойства
		|	И ЗначенияИнтернетСвойств.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ЗначениеСвойства", ЗначениеСвойства);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Результат = РезультатЗапроса.Ссылка;
	Иначе
		Результат = Справочники.eComm_ЗначенияСвойствТоваров.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

