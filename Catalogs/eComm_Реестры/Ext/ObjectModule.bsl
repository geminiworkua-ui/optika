
Процедура ПередЗаписью(Отказ)  
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Владелец);
	
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		
		// Идентификатор реестра создается при добавлении накладной в реестр
		// Дополнительные действия не требуются
		
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		
		// Реестр создается до добавления накладной
		
		СтруктураРеестра = Новый Структура("Владелец, Наименование, Дата, Тип, Идентификатор, Отправитель, КонтактноеЛицоОтправителя");
		ЗаполнитьЗначенияСвойств(СтруктураРеестра, ЭтотОбъект);
		
		//Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		// Редактируем наименование в том числе
		Идентификатор = Справочники.eComm_УчетныеЗаписиСлужбДоставки.СохранитьРеестр(СтруктураНастроек, СтруктураРеестра);
		//КонецЕсли;
		
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда
		
		// Идентификатор реестра создается при добавлении накладной в реестр
		// Дополнительные действия не требуются
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда 
		Отказ = Истина;
		Сообщить("Ошибка создания реестра в личном кабинете!!!");
	КонецЕсли;
	
КонецПроцедуры
