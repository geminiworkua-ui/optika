

/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ  ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Расписания обмена
	Если НЕ ТипЗнч(РасписаниеОбменаТоварами) = Тип("РасписаниеРегламентногоЗадания") Тогда
		РасписаниеОбменаТоварами = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	УстановитьТорговуюПлощадку();
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьЗначенияДополнительныхРеквизитовПоУмолчанию();
		ЗагрузитьНастройкиОтборовКомпоновкиДанныхПриЧтении();
		Элементы.Владелец.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();
	УстановитьВидимостьСворачиваемыхГрупп();
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Заголовок = "Новое подключение (" + eCommСервер.ВерсияБиблиотеки() + ")";
	КонецЕсли;
	
	ИмяДокументаЗаказ = eCommСервер.ВернутьИмяДокументЗаказ();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	УстановитьПривилегированныйРежим(Истина);
	
	
	// Блок отборов
	ТекущийОбъект.НастройкиКомпоновщика = Новый ХранилищеЗначения(КомпоновщикНастроек.ПолучитьНастройки());
	
	
	// Блок рег задания. Товары
	Если ТипЗнч(РасписаниеОбменаТоварами) = Тип("РасписаниеРегламентногоЗадания") Тогда 
		Если Не ЗначениеЗаполнено(ТекущийОбъект.РегламентноеЗаданиеОбменаТоварами) Тогда
			ЗаданиеТовары = Неопределено;
		Иначе
			ЗаданиеТовары = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ТекущийОбъект.РегламентноеЗаданиеОбменаТоварами);
		КонецЕсли;
		
		Если ЗаданиеТовары = Неопределено Тогда
			ЗаданиеТовары = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.eComm_ВыполнитьОбмен);
		КонецЕсли;
		
		ЗаданиеТовары.Использование = Объект.ОбменПоРегламентномуЗаданиюВыгрузкаТоваров;
		
		НаименованиеЗадания = НСтр("ru='Обмен товарами по дополнительному профилю %Профиль%';uk='Обмін товарами за дадатковим профілем %Профиль%'");
		НаименованиеЗадания = СтрЗаменить(НаименованиеЗадания, "%Профиль%", ТекущийОбъект.Наименование);
		ЗаданиеТовары.Наименование = НаименованиеЗадания;
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(ТекущийОбъект.Ссылка);
		ПараметрыЗадания.Добавить("ВыгружатьТовары");
		
		ЗаданиеТовары.Параметры  = ПараметрыЗадания;
		ЗаданиеТовары.Расписание = РасписаниеОбменаТоварами;
		
		ЗаданиеТовары.Записать();
		
		ТекущийОбъект.РегламентноеЗаданиеОбменаТоварами = ЗаданиеТовары.УникальныйИдентификатор;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	СохранитьРеквизиты(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Блок восстановления отборов
	ЗагрузитьНастройкиОтборовКомпоновкиДанныхПриЧтении(ТекущийОбъект);
	
	// Блок регламентных заданий. Товары	
	ИдентификаторЗадания = ТекущийОбъект.РегламентноеЗаданиеОбменаТоварами;
	
	ЗаданиеТовары = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если ЗаданиеТовары <> Неопределено Тогда
		РасписаниеОбменаТоварами      				= ЗаданиеТовары.Расписание;
		Элементы.РасписаниеОбменаТоварамиСтрокой.Заголовок  = Строка(РасписаниеОбменаТоварами);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Заголовок = "" + ТекущийОбъект.Ссылка + " (" + eCommСервер.ВерсияБиблиотеки() + ")";
	
	ВосстановитьРеквизиты(ТекущийОбъект);
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура НастроитьРасписание(Команда)
	
	ИмяРеквизита = СтрЗаменить(Команда.Имя, "Настроить", "");
	
	ДиалогРасписания 	= Новый ДиалогРасписанияРегламентногоЗадания(ЭтаФорма[ИмяРеквизита]);
	
	ОповещениеОВыборе 	= Новый ОписаниеОповещения("ОповещениеОВыбореРасписания", ЭтаФорма, ИмяРеквизита);
	
	ДиалогРасписания.Показать(ОповещениеОВыборе);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПодключенияКВебСерверуПриИзменении(Элемент)
	
	Если ТипПодключенияКВебСерверу = "" Тогда
		// Это ФТП
		Элементы.ГруппаФТП.Видимость 			= Истина;
		Элементы.ГруппаОбщаяПапка.Видимость 	= Ложь;
	ИначеЕсли ТипПодключенияКВебСерверу = "ОбщаяПапка" Тогда
		// Это сетевая папка
		Элементы.ГруппаФТП.Видимость 			= Ложь;
		Элементы.ГруппаОбщаяПапка.Видимость 	= Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	УстановитьТорговуюПлощадку();
	ЗаполнитьЗначенияДополнительныхРеквизитовПоУмолчанию();
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОбновляемыеПоляНажатие(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьЗначенияИзСписка", ЭтаФорма, Элемент.Имя);
	
	ПараметрыОткрытия = Новый Структура("СписокЗначений, Заголовок", ОбновляемыеПоляНаСайте, "Список обновляемых полей");
	ОткрытьФорму("Справочник.eComm_УчетныеЗаписи.Форма.ФормаСпискаЗначений", ПараметрыОткрытия,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСворачиваемыхГрупп()

	СтруктураСворачиваемыхГрупп = СтруктураСворачиваемыхГрупп();
	
	Для Каждого СворачиваемаяГруппа Из СтруктураСворачиваемыхГрупп Цикл
		Если НЕ ЕстьВидимыеЭлементыВГруппе(Элементы["Группа" + СворачиваемаяГруппа.Ключ]) Тогда 
			Элементы[СворачиваемаяГруппа.Ключ + "Заголовок"].Видимость = Ложь;
			Элементы[СворачиваемаяГруппа.Ключ + "СворачиваемаяГруппа"].Видимость = Ложь;
			Продолжить;
		КонецЕсли;
		//Если Объект.ПоказыватьВсеНастройки = Истина Тогда 
			СвернутьРазвернутьГруппуНаСервере(СворачиваемаяГруппа.Ключ + "СворачиваемаяГруппа", Истина);
		//Иначе
		//	СвернутьРазвернутьГруппуНаСервере(СворачиваемаяГруппа.Ключ + "СворачиваемаяГруппа", СворачиваемаяГруппа.Значение);
		//КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СтруктураСворачиваемыхГрупп()
	
	ИменаСворачиваемыхГрупп = Новый Структура;
	
	ИменаСворачиваемыхГрупп.Вставить("ПодключениеКВебСерверу"	, Истина);
	ИменаСворачиваемыхГрупп.Вставить("ИнтернетТовары"			, Истина);
	ИменаСворачиваемыхГрупп.Вставить("Изображения"				, Истина);

	Возврат ИменаСворачиваемыхГрупп;
	
КонецФункции

&НаСервере
Функция ЕстьВидимыеЭлементыВГруппе(Элемент)
	Для Каждого ПодчиненныйЭлемент Из Элемент.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") Тогда
			Если ПодчиненныйЭлемент.Видимость 
				И ЕстьВидимыеЭлементыВГруппе(ПодчиненныйЭлемент) Тогда
				Возврат Истина;
			КонецЕсли;
		Иначе
			Если ПодчиненныйЭлемент.Видимость Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура СвернутьРазвернутьГруппу(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	ИмяГруппы 	= СтрЗаменить(ИмяЭлемента, "Декорация", "") + "СворачиваемаяГруппа";
	
	СвернутьРазвернутьГруппуНаСервере(ИмяГруппы, НЕ Элементы[ИмяГруппы].Видимость); 
	
КонецПроцедуры

&НаСервере
Процедура СвернутьРазвернутьГруппуНаСервере(ИмяГруппы, Видимость)
	
	Элементы[ИмяГруппы].Видимость = Видимость;
	
	Если Видимость Тогда 
		Элементы["Декорация" + СтрЗаменить(ИмяГруппы, "СворачиваемаяГруппа", "")].Картинка = Элементы["ДекорацияСвернуть"].Картинка;
	Иначе
		Элементы["Декорация" + СтрЗаменить(ИмяГруппы, "СворачиваемаяГруппа", "")].Картинка = Элементы["ДекорацияРазвернуть"].Картинка;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОВыбореРасписания(НовоеРасписание, ИмяРеквизитаРасписание) Экспорт

	Если НЕ НовоеРасписание = Неопределено
		И ЭтаФорма[ИмяРеквизитаРасписание] <> НовоеРасписание Тогда
		Модифицированность = Истина;
		ЭтаФорма[ИмяРеквизитаРасписание]   = НовоеРасписание;
		Элементы[ИмяРеквизитаРасписание + "Строкой"].Заголовок  = Строка(ЭтаФорма[ИмяРеквизитаРасписание]);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьНастройкиПоУмолчанию(Команда)
	
	ЗагрузитьНастройкиОтборовКомпоновкиДанныхПриЧтении();
	ЗаполнитьЗначенияДополнительныхРеквизитовПоУмолчанию();
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТКА ДОПОЛНИТЕЛЬНЫХ РЕКВИЗИТОВ

&НаСервере
Процедура СохранитьРеквизиты(ТекущийОбъект)
	
	НастройкиОбмена = Новый Структура("ВыгрузкаТоваров, ЗагрузкаЗаказов");
	
	РеквизитыВыгрузки = Новый Массив;
	РеквизитыВыгрузки.Добавить("ТипПодключенияКВебСерверу");
	РеквизитыВыгрузки.Добавить("РазмерПорции");
	РеквизитыВыгрузки.Добавить("Сервер");
	РеквизитыВыгрузки.Добавить("Каталог");
	РеквизитыВыгрузки.Добавить("Логин");
	РеквизитыВыгрузки.Добавить("Пароль");
	РеквизитыВыгрузки.Добавить("ИмяФайла");
	РеквизитыВыгрузки.Добавить("ОграничениеМинимальногоОстатка");
	РеквизитыВыгрузки.Добавить("ОграничениеМаксимальогоОстатка");
	РеквизитыВыгрузки.Добавить("URL_КаталогаКартинок");
	РеквизитыВыгрузки.Добавить("ВыгружатьКартинкиИзБазы");

	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда
		РеквизитыВыгрузки.Добавить("ОбновляемыеПоляНаСайте");
		РеквизитыВыгрузки.Добавить("СтатусТоваровОтсутствующихВПрайсе");
		РеквизитыВыгрузки.Добавить("ОбновитьПринудительноProm");
		РеквизитыВыгрузки.Добавить("СтатусТоваровСПоложительнымОстаткомProm");
		//РеквизитыВыгрузки.Добавить("НеИспользоватьРазновидностиProm");
	КонецЕсли;
	
	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда 
		РеквизитыВыгрузки.Добавить("ОбновляемыеПоляНаСайте");
		//РеквизитыВыгрузки.Добавить("НазваниеСкладаHoroshop");
		РеквизитыВыгрузки.Добавить("СтатусТоваровНеВНаличииHoroshop");
		РеквизитыВыгрузки.Добавить("ОчищатьКартинкиHoroshop");
	КонецЕсли;
	
	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Facebook Тогда 
		РеквизитыВыгрузки.Добавить("СтатусТоваровНеВНаличииFacebook");
	КонецЕсли;
	
	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.OLX Тогда 
		//РеквизитыВыгрузки.Добавить("ОдноразовыйТокенАвторизацииOAuth");
		//РеквизитыВыгрузки.Добавить("ТокенДоступаOAuth");
		//РеквизитыВыгрузки.Добавить("ТокенОбновленияOAuth");
		//РеквизитыВыгрузки.Добавить("ГородOLX");
		//РеквизитыВыгрузки.Добавить("РайонГородаOLX");
		//РеквизитыВыгрузки.Добавить("ИмяКонтактаOLX");
		//РеквизитыВыгрузки.Добавить("ТелефонКонтактаOLX");
		//РеквизитыВыгрузки.Добавить("ТипОбъявленияOLX");
	КонецЕсли;
	
	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Joom Тогда 
		//РеквизитыВыгрузки.Добавить("ОдноразовыйТокенАвторизацииOAuth");
		//РеквизитыВыгрузки.Добавить("ТокенДоступаOAuth");
		//РеквизитыВыгрузки.Добавить("ТокенОбновленияOAuth");
		//РеквизитыВыгрузки.Добавить("ИдентификаторМагазинаJoom");
	КонецЕсли;
	
	ЗаписатьНастройкиОбмена(НастройкиОбмена, "ВыгрузкаТоваров", РеквизитыВыгрузки);
		
	ТекущийОбъект.НастройкиОбмена = Новый ХранилищеЗначения(НастройкиОбмена);

КонецПроцедуры

&НаСервере
Процедура ВосстановитьРеквизиты(ТекущийОбъект)
	
	НастройкиОбмена = ТекущийОбъект.НастройкиОбмена.Получить();
	
	Если Не ТекущийОбъект = Неопределено Тогда
		Если Не ТипЗнч(НастройкиОбмена) = Тип("Структура") Тогда
			НастройкиОбмена = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ПрочитатьНастройкиОбмена(НастройкиОбмена, "ВыгрузкаТоваров");

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиОбмена(НастройкиОбмена, БлокНастроек, МассивДополнительныхРеквизитов)

	ДополнительныеРеквизиты = Новый Структура;
	Для Каждого ЭлементМассива Из МассивДополнительныхРеквизитов Цикл
		Если ТипЗнч(ЭтаФорма[ЭлементМассива]) = Тип("ДанныеФормыКоллекция") Тогда
			ЗначениеРеквизита = РеквизитФормыВЗначение(ЭлементМассива);
		Иначе
			ЗначениеРеквизита = ЭтаФорма[ЭлементМассива];
		КонецЕсли;
		ДополнительныеРеквизиты.Вставить(ЭлементМассива, ЗначениеРеквизита);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ДополнительныеРеквизиты) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОбмена.Вставить(БлокНастроек, ДополнительныеРеквизиты);	

КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройкиОбмена(НастройкиОбмена, БлокНастроек)

	Если НастройкиОбмена.Свойство(БлокНастроек) Тогда
		
		Если ТипЗнч(НастройкиОбмена[БлокНастроек]) = Тип("Структура") Тогда
			Для Каждого КлючЗначение Из НастройкиОбмена[БлокНастроек] Цикл
				Попытка
					Если ТипЗнч(КлючЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
						ЭтаФорма[КлючЗначение.Ключ].Загрузить(КлючЗначение.Значение);
					Иначе
						ЭтаФорма[КлючЗначение.Ключ] = КлючЗначение.Значение;
						Если ТипЗнч(КлючЗначение.Значение) = Тип("СписокЗначений") Тогда 
							// Может быть интерфейсный элемент
							Элементы.ДекорацияОбновляемыеПоля.Заголовок = ВернутьПредставлениеСпискаЗначений(КлючЗначение.Значение);
						КонецЕсли;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияДополнительныхРеквизитовПоУмолчанию()

	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда 
		
		ОбновляемыеПоляНаСайте.Очистить();
		ОбновляемыеПоляНаСайте.Добавить("name"				, "Название");
