
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Владелец.Владелец);
	
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта
		ИЛИ СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда
		
		СтруктураКонтактногоЛица = Новый Структура("КонтрагентДоставки, Фамилия, Имя, Отчество, Телефон, Идентификатор, Наименование, ИНН, Email, РасчетныйСчет", Владелец, Идентификатор);
		ЗаполнитьЗначенияСвойств(СтруктураКонтактногоЛица, ЭтотОбъект);
		
		ДополнитьАдресами(СтруктураНастроек, СтруктураКонтактногоЛица);
		
		Если НЕ ОбменДанными.Загрузка = Истина Тогда
			Идентификатор = Справочники.eComm_УчетныеЗаписиСлужбДоставки.СоздатьКонтактноеЛицоКонтрагентаВЛичномКабинете(СтруктураНастроек, СтруктураКонтактногоЛица);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда 
			Отказ = Истина;
			Сообщить("Ошибка создания контактного лица в личном кабинете!!!");
		Иначе
			Наименование = СокрЛП(?(ЗначениеЗаполнено(Фамилия), Фамилия + " ", "") 
								+ ?(ЗначениеЗаполнено(Имя), Имя + " ", "") 
								+ ?(ЗначениеЗаполнено(Отчество), Отчество + " ", ""));
		КонецЕсли;
						
	Иначе
		// Для Justin и Meest ограничений нет
		
		Наименование = СокрЛП(?(ЗначениеЗаполнено(Фамилия), Фамилия + " ", "") 
								+ ?(ЗначениеЗаполнено(Имя), Имя + " ", "") 
								+ ?(ЗначениеЗаполнено(Отчество), Отчество + " ", ""));

	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Владелец.Владелец);
	
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта
		ИЛИ СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда
		
		Если ЗначениеЗаполнено(Идентификатор) Тогда 
			
			СтруктураКонтактногоЛица = Новый Структура("Идентификатор", Идентификатор);	
			Отказ = НЕ Справочники.eComm_УчетныеЗаписиСлужбДоставки.УдалитьКонтактноеЛицоКонтрагентаВЛичномКабинете(СтруктураНастроек, СтруктураКонтактногоЛица) = Истина;
			Если Отказ = Истина Тогда 
				Сообщить("Ошибка удаления контактного лица в личном кабинете!!!");
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		// Для Justin и Meest ограничений нет
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_КонтрагентыДоставки.Владелец КАК УчетнаяЗапись
		|ПОМЕСТИТЬ ВрТабУчетнаяЗапись
		|ИЗ
		|	Справочник.eComm_КонтрагентыДоставки КАК eComm_КонтрагентыДоставки
		|ГДЕ
		|	eComm_КонтрагентыДоставки.Ссылка = &Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	eComm_УчетныеЗаписиСлужбДоставки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписиСлужбДоставки КАК eComm_УчетныеЗаписиСлужбДоставки
		|ГДЕ
		|	eComm_УчетныеЗаписиСлужбДоставки.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Укрпочта)
		|	И eComm_УчетныеЗаписиСлужбДоставки.Ссылка В
		|			(ВЫБРАТЬ
		|				ВрТабУчетнаяЗапись.УчетнаяЗапись КАК УчетнаяЗапись
		|			ИЗ
		|				ВрТабУчетнаяЗапись КАК ВрТабУчетнаяЗапись)";
	
	Запрос.УстановитьПараметр("Контрагент", Владелец);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда 
		ПроверяемыеРеквизиты.Добавить("Адреса");
		ПроверяемыеРеквизиты.Добавить("Адреса.Адрес");
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьАдресами(СтруктураНастроек, СтруктураКонтактногоЛица)

	Если НЕ СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Возврат;
	КонецЕсли;
	
	// Убедимся что есть основной адрес и он один
	ОсновнойАдресНайден = Ложь;
	
	Для Каждого СтрокаАдреса Из Адреса Цикл 
		Если СтрокаАдреса.ОсновнойАдрес = Истина Тогда 
			Если ОсновнойАдресНайден = Ложь Тогда 
				ОсновнойАдресНайден = Истина;
			Иначе
				СтрокаАдреса.ОсновнойАдрес = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Если основного адреса нет - тогда назначим первый
	Если НЕ ОсновнойАдресНайден 
		И Адреса.Количество() > 0 Тогда 
		Адреса[0].ОсновнойАдрес = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаАдреса Из Адреса Цикл 
		Если СтрокаАдреса.ОсновнойАдрес = Истина 
			И ЗначениеЗаполнено(СтрокаАдреса.Адрес) Тогда 
			СтруктураКонтактногоЛица.Вставить("ОсновнойАдрес", СтрокаАдреса.Адрес);
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


