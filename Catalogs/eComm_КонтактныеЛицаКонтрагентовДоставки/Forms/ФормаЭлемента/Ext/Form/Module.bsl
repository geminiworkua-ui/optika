
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	 УстановитьВидимость();
	 
	 ЗаполнитьУчетнуюЗапись();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	УстановитьВидимость();
	
	ЗаполнитьУчетнуюЗапись();
	
КонецПроцедуры

&НаКлиенте
Процедура ФИОПриИзменении(Элемент)
	
	Объект.Наименование =  СокрЛП(?(ЗначениеЗаполнено(Объект.Фамилия), Объект.Фамилия + " ", "") 
								+ ?(ЗначениеЗаполнено(Объект.Имя), Объект.Имя + " ", "") 
								+ ?(ЗначениеЗаполнено(Объект.Отчество), Объект.Отчество + " ", ""));
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьКакОсновной(Команда)
	
	ТекДанные = Элементы.Адреса.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаАдреса Из Объект.Адреса Цикл 
		СтрокаАдреса.ОсновнойАдрес = Ложь;
	КонецЦикла;
	
	ТекДанные.ОсновнойАдрес = Истина;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаСервере
Процедура УстановитьВидимость()

	СлужбаДоставки = СлужбаДоставки();
	
	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		
		Элементы.ИНН.Видимость 				= Ложь;
		Элементы.Адреса.Видимость 			= Ложь;
		Элементы.РасчетныйСчет.Видимость 	= Ложь;
		
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		
		Если eCommДоставкаСервер.ТипКонтрагентаФОП(СлужбаДоставки) = Объект.Владелец.ТипКонтрагента Тогда 
			Элементы.ИНН.Видимость 	= Истина;
		Иначе
			Элементы.ИНН.Видимость 	= Ложь;
		КонецЕсли;
		
		Элементы.Адреса.Видимость 			= Истина;
		Элементы.РасчетныйСчет.Видимость 	= Объект.Владелец.Отправитель
		
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
		
		Элементы.Адреса.Видимость 			= Ложь;
		Элементы.РасчетныйСчет.Видимость 	= Ложь;
		
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		
		Элементы.Адреса.Видимость 			= Ложь;
		Элементы.РасчетныйСчет.Видимость 	= Ложь;	
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СлужбаДоставки()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	eComm_КонтрагентыДоставки.Владелец КАК УчетнаяЗапись
		|ПОМЕСТИТЬ УчетнаяЗаписьДоставки
		|ИЗ
		|	Справочник.eComm_КонтрагентыДоставки КАК eComm_КонтрагентыДоставки
		|ГДЕ
		|	eComm_КонтрагентыДоставки.Ссылка = &КонтрагентДоставки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	eComm_УчетныеЗаписиСлужбДоставки.СлужбаДоставки КАК СлужбаДоставки
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписиСлужбДоставки КАК eComm_УчетныеЗаписиСлужбДоставки
		|ГДЕ
		|	eComm_УчетныеЗаписиСлужбДоставки.Ссылка В
		|			(ВЫБРАТЬ
		|				УчетнаяЗаписьДоставки.УчетнаяЗапись КАК УчетнаяЗапись
		|			ИЗ
		|				УчетнаяЗаписьДоставки КАК УчетнаяЗаписьДоставки)";
	
	Запрос.УстановитьПараметр("КонтрагентДоставки", Объект.Владелец);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат РезультатЗапроса.СлужбаДоставки;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ЗаполнитьУчетнуюЗапись()

	УчетнаяЗапись = Объект.Владелец.Владелец;

КонецПроцедуры





