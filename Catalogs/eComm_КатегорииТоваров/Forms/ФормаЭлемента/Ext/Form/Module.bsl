// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкиУчетнойЗаписи = eCommСервер.Настройки(Объект.Владелец);
	
	НастройкаИспользоватьМультиязычность = eCommСервер.ВернутьЗначениеНастройки(НастройкиУчетнойЗаписи, "ВыгрузкаТоваров", "ИспользоватьМультиязычность");
	
	ИспользоватьМультиязычность = НастройкаИспользоватьМультиязычность = Истина 
								И НастройкиУчетнойЗаписи.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.OpenCart;
								
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда 
			МодульМультиязычность.ПриСозданииНаСервере(ЭтаФорма, Объект);
		КонецЕсли;
		
		Если НЕ НРег(eCommСервер.ВернутьКодТекущегоЯзыка()) = НРег(eCommСервер.ВернутьОсновнойЯзык()) Тогда 
			ТолькоПросмотр = Истина;
			Сообщить(НСтр("ru = 'Язык интерфейса не соответствует основному языку конфигурации. 
						|Измените язык интерфейса пользователя для продолжения редактирования'; 
						|uk = 'Мова інтерфейсу не відповідає основній мові конфігурації. 
						|Змініть мову интерфейсу користувача для продовження редагування'"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	УстановитьВидимостьЭлементов();
	
	//Мультиязычность
	Если ИспользоватьМультиязычность Тогда
		
		МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
		Если НЕ МодульМультиязычность = Неопределено Тогда 
			МодульМультиязычность.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_eComm_КатегорииТоваров", Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
