/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	УстановитьПараметрыВыбораКатегорияНаПортале();
	
КонецПроцедуры

&НаКлиенте
Процедура Перевести(Команда)
	
	ПеревестиНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Открытие(Элемент, СтандартнаяОбработка)   
	
	МодульМультиязычность = Вычислить("МультиязычностьКлиент");
	
	Если НЕ МодульМультиязычность = Неопределено Тогда 
		МодульМультиязычность.ПриОткрытии(ЭтаФорма, Объект, Элемент, СтандартнаяОбработка);
	КонецЕсли;

КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	ТорговаяПлощадка = Объект.Владелец.ТорговаяПлощадка;
	
	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Epicentrk
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Facebook
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.GoogleMerchant
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.OLX
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда
		
		Если НЕ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Epicentrk Тогда  
			Элементы.КодКатегрииСервиса.Видимость = Истина;
		КонецЕсли;
		
		Элементы.КатегорияНаПортале.Видимость = Истина;
		УстановитьПараметрыВыбораКатегорияНаПортале();
		
	КонецЕсли;
	
	Элементы.ФормаПеревести.Видимость = ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.OpenCart;

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораКатегорияНаПортале()

	ТорговаяПлощадка = Объект.Владелец.ТорговаяПлощадка;
	
	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Epicentrk
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Facebook
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.GoogleMerchant 
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.OLX
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom
		ИЛИ ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда 
		
		МассивПараметровВыбора = Новый Массив;
		МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.ТорговаяПлощадка", ТорговаяПлощадка));    
		
		Элементы.КатегорияНаПортале.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПеревестиНаСервере()

	Настройки = eCommСервер.Настройки(Объект.Владелец);
	
	Справочники.eComm_УчетныеЗаписи.ПеревестиПредставления(Настройки, Объект);
	
	ПереводПроизведен = Истина;

КонецПроцедуры






