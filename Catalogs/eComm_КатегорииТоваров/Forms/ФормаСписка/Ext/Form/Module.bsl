/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ  ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Отбор")
		И ТипЗнч(Параметры.Отбор) = Тип("Структура")
		И Параметры.Отбор.Свойство("Владелец") Тогда 
		
		УчетнаяЗапись = Параметры.Отбор.Владелец;
		
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура СписокКатегорийПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("УстановитьОтбор", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКатегорийПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	ТекСтрока = Элемент.ДанныеСтроки(Строка);
	
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда 
		
		Если ЗаписатьКатегорииТоваров(ПараметрыПеретаскивания.Значение, ТекСтрока.Ссылка) = Истина Тогда 
			ПоказатьОповещениеПользователя(Строка(ТекСтрока.Ссылка), ,"Перемещено " + ПараметрыПеретаскивания.Значение.Количество() + " позиций в категорию """ + ТекСтрока.Ссылка + """"); 
			Элементы.СписокТоваров.Обновить();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// КОМАНДЫ ФОРМЫ

&НаКлиенте
Процедура ИзменитьВыделенные(Команда)
	
	МодульГрупповоеИзменение = Вычислить("ГрупповоеИзменениеОбъектовКлиент");
	Если НЕ МодульГрупповоеИзменение = Неопределено Тогда
		МодульГрупповоеИзменение.ИзменитьВыделенные(Элементы.СписокТоваров);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСписокКатегорий(Команда)
	ПолучитьСписокКатегорийНаСервере();
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаКлиенте
Процедура УстановитьОтбор()

	ТекДанные = Элементы.СписокКатегорий.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда 
		Категория = ТекДанные.Ссылка;
	Иначе
		Категория = Неопределено;
	КонецЕсли;
	
	СписокТоваров.Отбор.Элементы.Очистить();
	ЭлементОтбора = СписокТоваров.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Категория");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование 	= Истина;
	ЭлементОтбора.ПравоеЗначение 	= Категория;

КонецПроцедуры

Функция ЗаписатьКатегорииТоваров(Товары, Категория)
	
	Если НЕ ТипЗнч(Товары) = Тип("Массив") Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Товар Из Товары Цикл 
		ТоварОбъект = Товар.ПолучитьОбъект();
		ТоварОбъект.Категория = Категория;
		ТоварОбъект.Записать();
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПолучитьСписокКатегорийНаСервере()
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Сообщить(НСтр("ru = 'Учетная запись не выбрана!!!'; uk = 'Обліковий запис не вибраний!!!'"));
		Возврат;
	КонецЕсли;
	
	Настройки = eCommСервер.Настройки(УчетнаяЗапись);
	Обработки.eComm_Horoshop.ОбновитьСписокКатегорий(Настройки);
	
КонецПроцедуры







