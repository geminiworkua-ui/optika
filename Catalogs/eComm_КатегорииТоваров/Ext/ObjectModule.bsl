
Процедура ПередЗаписью(Отказ)
	
	Если ЗначениеЗаполнено(КодКатегорииСервиса) Тогда 
		// Удалим лишние символы
		КодКатегорииЧислом = eCommСервер.ВернутьЗначениеЧислом(КодКатегорииСервиса);
		Если ЗначениеЗаполнено(КодКатегорииЧислом) Тогда 
			КодКатегорииСервиса = Формат(КодКатегорииЧислом, "ЧГ=0");
		Иначе
			КодКатегорииСервиса = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЧтенииПредставленийНаСервере() Экспорт
	
	МодульМультиязычность = eCommСервер.ОбщийМодуль("МультиязычностьСервер");
	Если НЕ МодульМультиязычность = Неопределено Тогда 
		МодульМультиязычность.ПриЧтенииПредставленийНаСервере(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры