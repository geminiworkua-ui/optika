&НаКлиенте
Процедура СохранитьЗакрыть(Команда)
	
	П = Новый Структура("_Радіус, _Сфера, _Циліндр, _Вісь, _Аддідація, _Диаметр, _Дегресія, _Цвет");
	ЗаполнитьЗначенияСвойств(П, ОБъект);
	п.Вставить("Владелец", Объект.Владелец);
	ОБъект.Наименование = СформироватьНаименованиеНаСервере(П);
	РезультатПроверки = ЕстьТакаяЖеХарактеристика(П);
	
	Если РезультатПроверки.ЕстьАналог ТОгда
		Этаформа.Закрыть(РезультатПроверки);	
	Иначе
		Записать();
		СформироватьУстановкуЦены(ОБъект.Владелец, ОБъект.Ссылка);
		РезультатПроверки.Ссылка = ОБъект.Ссылка;
	КонецЕсли;
	
	Этаформа.Закрыть(РезультатПроверки);	
КонецПроцедуры

