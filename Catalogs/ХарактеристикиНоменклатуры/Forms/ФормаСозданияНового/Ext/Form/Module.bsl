	 ОбработатьВводПараметровНаКлиенте();
КонецПроцедуры

&НаСервере
Функция ЕстьТакаяЖеХарактеристика(П)
    Запрос = Новый Запрос("ВЫБРАТЬ
                          |	ХарактеристикиНоменклатуры.Ссылка
                          |ИЗ
                          |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
                          |ГДЕ
                          |	ХарактеристикиНоменклатуры.Владелец = &Владелец
                          |	И ХарактеристикиНоменклатуры._Сфера = &_Сфера
                          |	И ХарактеристикиНоменклатуры._Аддідація = &_Аддідація
                          |	И ХарактеристикиНоменклатуры._Циліндр = &_Циліндр
                          |	И ХарактеристикиНоменклатуры._Диаметр = &_Диаметр
                          |	И ХарактеристикиНоменклатуры._Радіус = &_Радіус
                          |	И ХарактеристикиНоменклатуры._Вісь = &_Вісь
                          |	И ХарактеристикиНоменклатуры._Дегресія = &_Дегресія
                          |	И ХарактеристикиНоменклатуры._Цвет = &_Цвет
						  |	И ХарактеристикиНоменклатуры._ВидЛинзы = &_ВидЛинзы
						  |	И ХарактеристикиНоменклатуры._Покрытие = &_Покрытие
						  |	И ХарактеристикиНоменклатуры._Тонирование = &_Тонирование
                          |
                          |СГРУППИРОВАТЬ ПО
                          |	ХарактеристикиНоменклатуры.Ссылка");
	
	Для каждого Запись из П цикл
		Запрос.УстановитьПараметр(Запись.Ключ, Запись.значение);
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Новый Структура("ЕстьАналог, Ссылка", Истина, Выборка.ссылка);
	Иначе
		Возврат Новый Структура("ЕстьАналог, Ссылка", Ложь, Выборка.ссылка);
	КонецЕсли;
КонецФункции

