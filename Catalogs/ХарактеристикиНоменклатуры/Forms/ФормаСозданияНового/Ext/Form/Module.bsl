
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Владелец") Тогда
		Объект.Владелец = Параметры.Владелец;
	КонецЕсли;	
		
	НастроитьВидимостьДопРеквизитов();
	// +y.surai IBS 2026.07.13
	Если ЗначениеЗаполнено(Объект.Владелец) И Объект.Владелец.Рецептура = Перечисления.Рецептура.Да Тогда
		Элементы._ВидЛинзы.Видимость 	= Истина;
		Элементы._Покрытие.Видимость 	= Истина;
		Элементы._Тонирование.Видимость = Истина;
	КонецЕсли;
	// -y.surai IBS 2026.07.13	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьДопРеквизитов()
	
	Если Объект.Владелец = Неопределено Тогда 
		Возврат;
	КонецЕсли;  
	
	Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.Номенклатура") Тогда
		ВидНоменклатуры = Объект.Владелец.ВидНоменклатуры;
	Иначе
		ВидНоменклатуры = Объект.Владелец;
	КонецЕсли;	
	//
	//Если ЗначениеЗАполнено(ВидНоменклатуры) Тогда
	//	Для каждого Свойство из ВидНоменклатуры.РеквизитыДляКонтроляХарактеристик Цикл  
	//		ДопСвойство = Строка(Свойство.ИмяРеквизита);
	//		Если 
	//			Свойство.ТребоватьЗаполнения Тогда
	//			Попытка  
	//				Элементы[ДопСвойство].Видимость = Истина;
	//			Исключение
	//			КонецПопытки;	
	//		Иначе
	//			Попытка  
	//				Элементы[ДопСвойство].Видимость = Ложь;
	//			Исключение
	//			КонецПопытки;
	//		КонецЕсли;	
	//	КонецЦикла; 
	//КонецЕсли;
	
	Если ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.Номенклатура")
		И ЗначениеЗаполнено(Объект.Владелец.СвойстваОбъектовНабор) Тогда
		ДопОтбор = Истина;                                                  
		мСвойств = Новый Массив;
		Для каждого Стр из Объект.Владелец.СвойстваОбъектовНабор.Состав цикл
			мСвойств.Добавить(Строка(Стр.Свойство));
		КонецЦикла;
	ИНаче
		ДопОтбор = Ложь  
	Конецесли;
	
	Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		Для каждого Свойство Из ВидНоменклатуры.РеквизитыДляКонтроляХарактеристик Цикл  
			ДопСвойство = Строка(Свойство.ИмяРеквизита);
			Если НЕ ДопОтбор И Свойство.ТребоватьЗаполнения Тогда
				Попытка  
					Элементы[ДопСвойство].Видимость = Истина;
				Исключение
				КонецПопытки;	
			ИначеЕсли ДопОтбор И Свойство.ТребоватьЗаполнения И Не мСвойств.Найти(ДопСвойство) = Неопределено Тогда
				Попытка  
					Элементы[ДопСвойство].Видимость = Истина;
				Исключение
				КонецПопытки;		
			Иначе
				Попытка  
					Элементы[ДопСвойство].Видимость = Ложь;
				Исключение
				КонецПопытки;
			КонецЕсли;	
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция СформироватьНаименованиеНаСервере(П)
		
 	Наименование = ""; 
	
	Наименование = Наименование + ?(П._Радіус 	   = Справочники._Радіус.ПустаяСсылка()	    ,	"", " Рад: " + СокрЛП(П._Радіус.Наименование)	 + " ");
   	Наименование = Наименование + ?(П._Сфера 	   = Справочники._Сфера.ПустаяСсылка()	    ,	"", " Сф.: " + СокрЛП(П._Сфера.Наименование) 	 + " ");
  	Наименование = Наименование + ?(П._Циліндр 	   = Справочники._Циліндр.ПустаяСсылка()    ,	"", " Ц. : " + СокрЛП(П._Циліндр.Наименование)	 + " ");
  	Наименование = Наименование + ?(П._Вісь	 	   = Справочники._Вісь.ПустаяСсылка()	    ,	"", " В. : " + СокрЛП(П._Вісь.Наименование)		 + " ");
	Наименование = Наименование + ?(П._Аддідація   = Справочники._Аддідація.ПустаяСсылка()  , 	"", " Ад.: " + СокрЛП(П._Аддідація.Наименование) + " ");
	Наименование = Наименование + ?(П._Диаметр 	   = Справочники._Диаметр.ПустаяСсылка()    ,	"", " Д. : " + СокрЛП(П._Диаметр.Наименование)	 + " ");
	Наименование = Наименование + ?(П._Дегресія    = Справочники._Дегресія.ПустаяСсылка()   , 	"", " Дег: " + СокрЛП(П._Дегресія.Наименование)  + " ");
	Наименование = Наименование + ?(П._Цвет 	   = Справочники._Цвет.ПустаяСсылка()	    ,	"", " Цв.: " + СокрЛП(П._Цвет.Наименование)      + " ");
	Наименование = Наименование + ?(П._ВидЛинзы	   = Перечисления.ВидЛинзы.ПустаяСсылка()   ,	"", " Л.: "  + СокрЛП(П._ВидЛинзы.Наименование)  + " ");
	Наименование = Наименование + ?(П._Покрытие    = Справочники._Покрытие.ПустаяСсылка()   ,	"", " П.: "  + СокрЛП(П._Покрытие.Наименование)  + " ");
	Наименование = Наименование + ?(П._Тонирование = Справочники._Тонирование.ПустаяСсылка(),	"", " Т.: "  + СокрЛП(П._ВидЛинзы.Наименование)  + " ");

	Возврат Наименование;

КонецФункции

&НаКлиенте
Процедура ОбработатьВводПараметровНаКлиенте()

	П = Новый Структура("_Радіус, _Сфера, _Циліндр, _Вісь, _Аддідація, _Диаметр, _Дегресія, _Цвет, _ВидЛинзы, _Покрытие, _Тонирование");
	ЗаполнитьЗначенияСвойств(П, ОБъект);
	п.Вставить("Владелец", Объект.Владелец);
	ОБъект.Наименование = СформироватьНаименованиеНаСервере(П);
	
	РезультатПроверки = ЕстьТакаяЖеХарактеристика(П);
	
	Если РезультатПроверки.естьАналог
		ТОгда Элементы.Декорация1.Видимость = Истина;
	Иначе
		Элементы.Декорация1.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

