&НаСервере
Процедура УстановитьОтбор( ) Экспорт
	
	ДатаЗапроса = ТекущаяДата();
	
	Если ЗначениеЗаполнено(объект.Ссылка) Тогда
		ФильтрНом = Объект.Владелец;
		Фильтр = Объект.Ссылка;
	Иначе        
		ФильтрНом = Справочники.Номенклатура.ПустаяСсылка();
		Фильтр = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	НоменклатураПостащиков.Параметры.УстановитьЗначениеПараметра("Номенклатура", ФильтрНом);
	НоменклатураПостащиков.Параметры.УстановитьЗначениеПараметра("Характеристика", Фильтр);
	
	Переработка.Параметры.УстановитьЗначениеПараметра("Продукция", Фильтр);
	Переработка.Параметры.УстановитьЗначениеПараметра("Дата", ДатаЗапроса);
	
	Состав.Параметры.УстановитьЗначениеПараметра("Продукция", Фильтр);
	Состав.Параметры.УстановитьЗначениеПараметра("Дата", ДатаЗапроса);
	
	Резерв.Параметры.УстановитьЗначениеПараметра("Дата", ДатаЗапроса);
    Резерв.Параметры.УстановитьЗначениеПараметра("Номенклатура", ФильтрНом);
	Резерв.Параметры.УстановитьЗначениеПараметра("Характеристика", Фильтр);
	
	СвойстваОбъекта.Параметры.УстановитьЗначениеПараметра("Объект", Фильтр);
	
    ЦеныНоменклатуры.Параметры.УстановитьЗначениеПараметра("Номенклатура", ФильтрНом);
	ЦеныНоменклатуры.Параметры.УстановитьЗначениеПараметра("Характеристика", Фильтр);
	ЦеныНоменклатуры.Параметры.УстановитьЗначениеПараметра("Дата", ДатаЗапроса);	
	
	ЦеныПоставщиков.Параметры.УстановитьЗначениеПараметра("Номенклатура", ФильтрНом);
	ЦеныПоставщиков.Параметры.УстановитьЗначениеПараметра("Характеристика", Фильтр);
	ЦеныПоставщиков.Параметры.УстановитьЗначениеПараметра("Дата", ДатаЗапроса);	
	
	Штрихкоды.Параметры.УстановитьЗначениеПараметра("Номенклатура", ФильтрНом);
	Штрихкоды.Параметры.УстановитьЗначениеПараметра("Характеристика", Фильтр);
	ЗначенияОбъекта.Параметры.УстановитьЗначениеПараметра("Объект", Фильтр);
	ЗначенияОбъекта.Параметры.УстановитьЗначениеПараметра("Дата", ДатаЗапроса);
	РеквизитыОбъекта.Параметры.УстановитьЗначениеПараметра("Объект", Фильтр);
	ЕстьПравоРедактированияКартинки    = ПравоДоступа("Редактирование", Метаданные.Справочники.Номенклатура.Реквизиты.ФайлКартинки);
    Элементы.ГруппаФайлКартинки.Доступность = ЕстьПравоРедактированияКартинки;
	Элементы.ФайлКартинки.Доступность = ЕстьПравоРедактированияКартинки;
	Элементы.ДобавитьИзображение.Доступность = ЕстьПравоРедактированияКартинки;
	Элементы.ИзменитьИзображение.Доступность = ЕстьПравоРедактированияКартинки;
	Элементы.ОчиститьИзображение.Доступность = ЕстьПравоРедактированияКартинки;
	Элементы.ВыбратьКартинкуИзПрисоединенныхФайлов.Видимость = ЕстьПравоРедактированияКартинки;
	
	// +y.surai IBS 2026.07.13
	Если ЗначениеЗаполнено(Объект.Владелец) И Объект.Владелец.Рецептура = Перечисления.Рецептура.Да Тогда
		Элементы.Группа10.Видимость = Истина;
	КонецЕсли;
	// -y.surai IBS 2026.07.13
	
