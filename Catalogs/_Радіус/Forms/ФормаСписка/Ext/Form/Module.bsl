
&НаКлиенте
Процедура ПерезаписатьВсе(Команда)
	ПерезаписатьВсеНаСервере();
	Элементы.Список.Обновить();
КонецПроцедуры

&НаСервере
Процедура ПерезаписатьВсеНаСервере()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	_Радіус.Ссылка
	                      |ИЗ
	                      |	Справочник._Радіус КАК _Радіус
	                      |ГДЕ
	                      |	НЕ _Радіус.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		СО = Выборка.Ссылка.ПолучитьОБъект();
		СО.Записать();
	КонецЦикла;	
	
КонецПроцедуры
