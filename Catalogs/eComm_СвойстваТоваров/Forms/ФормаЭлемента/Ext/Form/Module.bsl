
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТорговаяПлощадка = Объект.Владелец.ТорговаяПлощадка;
	
	Если ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Epicentrk Тогда 
		
		Элементы.КодСервиса.Видимость 	= Истина;
		
	ИначеЕсли ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда 
		
		Элементы.КодСервиса.Видимость 	= Истина;
		Элементы.Модификатор.Видимость 	= Истина;
		
	ИначеЕсли ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда
		
		МакетЕдиницИзмерения = Обработки["eComm_Prom"].ПолучитьМакет("ЕдиницыИзмерения");
		
		КоличествоЗаписей = МакетЕдиницИзмерения.ВысотаТаблицы;
		
		Для Сч = 2 по КоличествоЗаписей Цикл
			
			ЕдиницаИзмерения = СокрЛП(МакетЕдиницИзмерения.Область(Сч, 1).Текст);
			
			Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда 
				Продолжить;
			КонецЕсли;
			
			Элементы.ЕдиницаИзмерения.СписокВыбора.Добавить(ЕдиницаИзмерения);
			
		КонецЦикла;

		Элементы.ЕдиницаИзмерения.Видимость = Истина;
		
	ИначеЕсли ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда 
		Элементы.Модификатор.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Объект.Модификатор = Истина Тогда 
		// Доступен только для хорошопа
		// Значение должно удовлетворять требования к переменным
		Попытка
			ТестоваяСтруктура = Новый Структура(Объект.Наименование);
		Исключение
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Для модифицируемого параметра запрещено использование в наименовании спец. символов и пробела";
			Сообщение.Поле = "Наименование";
			Сообщение.УстановитьДанные(Объект);
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры
