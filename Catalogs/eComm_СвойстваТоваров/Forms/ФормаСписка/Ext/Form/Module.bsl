
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ  ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Свойство("УчетнаяЗапись", УчетнаяЗапись) Тогда 
		Отказ = Истина;
		ВызватьИсключение("Список свойств открывается только из учетной записи торговой площадки!!!");
		Возврат;
	Иначе
		Заголовок = "Интернет-свойства для """ + УчетнаяЗапись + """";
	КонецЕсли;
	
	ИмяОбъектаДополнительныеРеквизиты = eCommСервер.ВернутьИмяПрикладногоОбъекта("ПВХДополнительныеРеквизиты");
	ИмяРеквизитаНаборСвойств = ?(ИмяОбъектаДополнительныеРеквизиты = "СвойстваОбъектов", "ДополнительныеРеквизитыИСведения.НазначениеСвойства", "ВЫБОР
		|		КОГДА ДополнительныеРеквизитыИСведения.НаборСвойств = ЗНАЧЕНИЕ(Справочник.НаборыДополнительныхРеквизитовИСведений.ПустаяСсылка)
		|			ТОГДА ""Общие (Для нескольких наборов)""
		|		КОГДА ДополнительныеРеквизитыИСведения.НаборСвойств.Родитель = ЗНАЧЕНИЕ(Справочник.НаборыДополнительныхРеквизитовИСведений.ПустаяСсылка)
		|			ТОГДА ДополнительныеРеквизитыИСведения.НаборСвойств
		|		ИНАЧЕ ДополнительныеРеквизитыИСведения.НаборСвойств.Родитель.Наименование + "" ("" + ДополнительныеРеквизитыИСведения.НаборСвойств.Наименование + "")""
		|	КОНЕЦ");
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Свойство,
		|	eComm_СвойстваТоваров.Отключить КАК Отключить,
		//++
		//|	eComm_СвойстваТоваров.Наименование КАК НаименованиеДляСайта,
		|	ЕСТЬNULL(eComm_СвойстваТоваров.Наименование, """") + ВЫБОР
		|		КОГДА ЕСТЬNULL(eComm_СвойстваТоваров.ЕдиницаИзмерения, """") = """"
		|			ТОГДА """"
		|		ИНАЧЕ "" ("" + ЕСТЬNULL(eComm_СвойстваТоваров.ЕдиницаИзмерения, """") + "")""
		|	КОНЕЦ + ВЫБОР
		|		КОГДА ЕСТЬNULL(eComm_СвойстваТоваров.Модификатор, ЛОЖЬ) = ЛОЖЬ
		|			ТОГДА """"
		|		ИНАЧЕ "" (Модификатор)""
		|	КОНЕЦ КАК НаименованиеДляСайта,
		//--
		|	ДополнительныеРеквизитыИСведения.Наименование КАК Наименование,
		|	eComm_СвойстваТоваров.Ссылка КАК ИнтернетСвойство,
		|	#ИмяРеквизитаНаборСвойств# КАК НаборСвойств,
		|	ВЫБОР
		|		КОГДА ДополнительныеРеквизитыИСведения.ПометкаУдаления = Истина
		|			ТОГДА 2
		|		КОГДА ДополнительныеРеквизитыИСведения.ПометкаУдаления = Ложь
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НомерКартинки
		|ИЗ
		|	ПланВидовХарактеристик.#ИмяОбъектаДополнительныеРеквизиты# КАК ДополнительныеРеквизитыИСведения
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_СвойстваТоваров КАК eComm_СвойстваТоваров
		|		ПО (eComm_СвойстваТоваров.Свойство = ДополнительныеРеквизитыИСведения.Ссылка)
		|			И (eComm_СвойстваТоваров.Владелец = &УчетнаяЗапись)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаДополнительныеРеквизиты#"	, ИмяОбъектаДополнительныеРеквизиты);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизитаНаборСвойств#"			, ИмяРеквизитаНаборСвойств);
	
	Список.ОсновнаяТаблица 		= "ПланВидовХарактеристик." + ИмяОбъектаДополнительныеРеквизиты;
	Список.ПроизвольныйЗапрос 	= Истина;
	Список.ТекстЗапроса 		= ТекстЗапроса;
	Список.Параметры.УстановитьЗначениеПараметра("УчетнаяЗапись", УчетнаяЗапись);
	
	ГруппировкаСписка = Список.Группировка.Элементы;
	ЭлементГруппировки = ГруппировкаСписка.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ЭлементГруппировки.Поле = Новый ПолеКомпоновкиДанных("НаборСвойств");
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ТекДанные.Свойство("ИнтернетСвойство") Тогда 
		// Это группировка
		
		ТекСтрока = Элементы.Список.ТекущаяСтрока;
		Если Элементы.Список.Развернут(ТекСтрока)Тогда 
			Элементы.Список.Свернуть(ТекСтрока);
		Иначе
			Элементы.Список.Развернуть(ТекСтрока);
		КонецЕсли;
		
	Иначе	
		// Это детальная запись
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыполнитьПослеРедактированияСвойства", ЭтаФорма);
		Если ЗначениеЗаполнено(ТекДанные.ИнтернетСвойство) Тогда 
			ПараметрыОткрытия = Новый Структура("Ключ", ТекДанные.ИнтернетСвойство);
			ОткрытьФорму("Справочник.eComm_СвойстваТоваров.ФормаОбъекта", ПараметрыОткрытия,,,,,ОповещениеОЗакрытии);
		Иначе
			ПараметрыЗаполнения = Новый Структура("Владелец, Свойство, Наименование", УчетнаяЗапись, ТекДанные.Свойство, ТекДанные.Наименование);
			ОткрытьФорму("Справочник.eComm_СвойстваТоваров.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения),,,,,ОповещениеОЗакрытии);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ

&НаКлиенте
Процедура ВыполнитьПослеРедактированияСвойства(Результат, ДопПараметры) Экспорт

	Элементы.Список.Обновить();	

КонецПроцедуры


