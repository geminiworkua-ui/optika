
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Свойство", Свойство);
	
	Если Параметры.Свойство("СписокЗначенийСвойств") Тогда 
		
		Для Каждого ЭлементСписка Из Параметры.СписокЗначенийСвойств Цикл 
			ЗаполнитьЗначенияСвойств(Список.Добавить(), ЭлементСписка);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Свойство) Тогда 
		Заголовок = НСтр("ru = 'Выберите значения свойства'; uk = 'Виберыть значення властивості'") + Свойство;
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура Выбрать(Команда)
	
	МассивВыбранныхЗначений = Новый Массив;
	список.Сортировать("Пометка Убыв");
	Для Каждого Стр Из Список Цикл 
		//Если Стр.Пометка = Истина Тогда 
			МассивВыбранныхЗначений.Добавить(Новый Структура("Свойство, ЗначениеСвойства, Пометка", Стр.Свойство, Стр.ЗначениеСвойства, Стр.Пометка));
		//КонецЕсли;
	КонецЦикла;
	
	Закрыть(МассивВыбранныхЗначений);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДополнительноеЗначение(Команда)
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыполнитьПослеРедактированияДополнительногоЗначения", ЭтаФорма);
	
	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", Новый Структура("Владелец", Свойство));
	ОткрытьФорму("Справочник.ЗначенияСвойствОбъектов.ФормаОбъекта", ПараметрыОткрытия, ЭтаФорма, Новый УникальныйИдентификатор, , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьДополнительноеЗначение(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	//ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыполнитьПослеРедактированияДополнительногоЗначения", ЭтаФорма);
	
	ПараметрыОткрытия = Новый Структура("Ключ", ТекДанные.ЗначениеСвойства);
	ОткрытьФорму("Справочник.ЗначенияСвойствОбъектов.ФормаОбъекта", ПараметрыОткрытия, ЭтаФорма, ТекДанные.ЗначениеСвойства, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДополнительныеЗначения(Команда)
	
	ОбновитьСписокНаСервере();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаКлиенте
Процедура ВыполнитьПослеРедактированияДополнительногоЗначения(Результат, ДопПараметры = Неопределено) Экспорт

	ОбновитьСписокНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Ссылка КАК ЗначениеСвойства,
		|	ЗначенияСвойствОбъектов.Владелец КАК Свойство
		|ИЗ
		|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Владелец = &Свойство";
	
	Запрос.УстановитьПараметр("Свойство", Свойство);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Отбор = Новый Структура("Свойство, ЗначениеСвойства", РезультатЗапроса.Свойство, РезультатЗапроса.ЗначениеСвойства);
		
		НайденныеЗначения = Список.НайтиСтроки(Отбор);
		Если НайденныеЗначения.Количество() > 0 Тогда 
			// Ето значение уже есть в списке
		Иначе
			НовСтр = Список.Добавить();
			НовСтр.Свойство 		= Свойство;
			НовСтр.ЗначениеСвойства = РезультатЗапроса.ЗначениеСвойства;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры




