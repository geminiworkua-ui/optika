
&НаСервере
Процедура ДозаполнитьСправочникНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Склады.Ссылка,
		|	ВложенныйЗапрос.ВариантИсточникаОбеспечения
		|ПОМЕСТИТЬ вт_Привязка
		|ИЗ
		|	Справочник.Склады КАК Склады
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВариантыИсточниковОбеспечения.Ссылка КАК ВариантИсточникаОбеспечения,
		|			ВариантыИсточниковОбеспечения.СкладИсточник КАК СкладИсточник
		|		ИЗ
		|			Справочник.ВариантыИсточниковОбеспечения КАК ВариантыИсточниковОбеспечения) КАК ВложенныйЗапрос
		|		ПО Склады.Ссылка = ВложенныйЗапрос.СкладИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Привязка.Ссылка КАК Ссылка
		|ИЗ
		|	вт_Привязка КАК вт_Привязка
		|ГДЕ
		|	вт_Привязка.ВариантИсточникаОбеспечения ЕСТЬ NULL";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовЗапись = Справочники.ВариантыИсточниковОбеспечения.СоздатьЭлемент();
		НовЗапись.СкладИсточник = Выборка.Ссылка;
		НовЗапись.Наименование = Строка(Выборка.Ссылка);
		НовЗапись.Иерархия = "500";
		НовЗапись.Записать();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДозаполнитьСправочник(Команда)
	ДозаполнитьСправочникНаСервере();
КонецПроцедуры
