Процедура ПередЗаписью(Отказ)
	Если Не ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_НаселенныеПунктыДоставки.Ссылка КАК Ссылка,
		|	eComm_НаселенныеПунктыДоставки.СлужбаДоставки КАК СлужбаДоставки
		|ПОМЕСТИТЬ ВрТабВладелец
		|ИЗ
		|	Справочник.eComm_НаселенныеПунктыДоставки КАК eComm_НаселенныеПунктыДоставки
		|ГДЕ
		|	eComm_НаселенныеПунктыДоставки.Ссылка = &Владелец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Спр.Ссылка КАК Ссылка,
		|	Спр.Код КАК Код
		|ИЗ
		|	Справочник.eComm_ОтделенияДоставки КАК Спр
		|ГДЕ
		|	Спр.Идентификатор = &Идентификатор
		|	И НЕ Спр.Ссылка = &Ссылка
		|	И Спр.Владелец.СлужбаДоставки В
		|			(ВЫБРАТЬ
		|				ВрТабВладелец.СлужбаДоставки КАК СлужбаДоставки
		|			ИЗ
		|				ВрТабВладелец КАК ВрТабВладелец)
		|	И НЕ Спр.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Идентификатор"	, Идентификатор);
	Запрос.УстановитьПараметр("Владелец"		, Владелец);
	Запрос.УстановитьПараметр("Ссылка"			, Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Отказ = Истина;
		Сообщить("Для идентификатора """ + Идентификатор + """ отделение уже создано: """ + РезультатЗапроса.Ссылка + """ (" + РезультатЗапроса.Код + ")!!! Дублирование запрещено");
	КонецЕсли;
	
КонецПроцедуры