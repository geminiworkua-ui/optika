
&НаСервере
Процедура ПриОткрытииНаСервере()
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыНоменклатуры.Наименование
	               |ИЗ
	               |	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры";
	Результат = Запрос.Выполнить().Выгрузить();
	Для Каждого Вид из Результат Цикл
		Соответствие = Справочники.ДоступныеРеквизитыСайт.НайтиПоНаименованию(Вид.Наименование);
		Если Соответствие.Наименование = "" Тогда
			НовыйВид = Справочники.ДоступныеРеквизитыСайт.СоздатьГруппу();
			НовыйВид.Наименование = Вид.Наименование;
			НовыйВид.Записать();
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
КонецПроцедуры
