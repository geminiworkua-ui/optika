
Процедура ЗаполнитьНаименование(Объект) Экспорт

	Если Объект.ЭтоАдресОтделения Тогда 
		Объект.Улица 			= "";
		Объект.НомерДома 		= "";
		Объект.НомерКвартиры 	= "";
		Объект.Наименование 	= Объект.Отделение;
	Иначе
		Объект.Наименование	= "" + ?(ЗначениеЗаполнено(Объект.ПочтовыйИндекс), Объект.ПочтовыйИндекс + ", ", "")
								+ Объект.Регион + " обл., " 
								+ ?(ЗначениеЗаполнено(Объект.Район), "" + Объект.Район + " р-н, ", "") 
								+ Объект.НаселенныйПункт + " " 
								+ Объект.Улица + " " 
								+ Объект.НомерДома + " " 
								+ Объект.НомерКвартиры;
	КонецЕсли;

КонецПроцедуры