
Процедура ПередЗаписью(Отказ)
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КОнецЕсли;	
	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Владелец);
	
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		// Если Новая почта
		
		СтруктураАдреса = Новый Структура("Контрагент, Регион, НаселенныйПункт, Улица, НомерДома, НомерКвартиры, Идентификатор");
		ЗаполнитьЗначенияСвойств(СтруктураАдреса, ЭтотОбъект);
		СтруктураАдреса.Вставить("Улица", ЭтотОбъект.УлицаПоКлассификатору);
		Если ЭтотОбъект.ЭтоАдресОтделения Тогда
		СтруктураАдреса.Вставить("Отделение", ЭтотОбъект.Отделение);
		КонецЕсли;
		Если НЕ ОбменДанными.Загрузка = Истина Тогда
			Идентификатор = Справочники.eComm_УчетныеЗаписиСлужбДоставки.СоздатьАдресВЛичномКабинете(СтруктураНастроек, СтруктураАдреса);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда 
			
			Отказ = Истина;
			Сообщить("Ошибка создания адреса в личном кабинете!!!");
			
		КонецЕсли;
		
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		// Если Укрпошта
		
		СтруктураАдреса = Новый Структура("ПочтовыйИндекс, Регион, Район, НаселенныйПункт, Улица, НомерДома, НомерКвартиры, ЭтоАдресОтделения, Идентификатор");
		ЗаполнитьЗначенияСвойств(СтруктураАдреса, ЭтотОбъект);
		
		Если НЕ ОбменДанными.Загрузка = Истина Тогда
			Идентификатор = Справочники.eComm_УчетныеЗаписиСлужбДоставки.СоздатьАдресВЛичномКабинете(СтруктураНастроек, СтруктураАдреса);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда 
			
			Отказ = Истина;
			Сообщить("Ошибка создания адреса в личном кабинете!!!");
			
		Иначе
			
			Справочники.eComm_АдресаДоставки.ЗаполнитьНаименование(ЭтотОбъект);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

