
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипАдреса = "";
	
	УстановитьОтборы();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ТипАдресаПриИзменении(Элемент)
	
	УстановитьОтборы();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура УстановитьОтборы()

	ИмяПоля 		= "ЭтоАдресОтделения";
	ЭлементОтбора 	= Неопределено;
	Если ТипАдреса = "ТолькоОтделения" Тогда 
		ЗначениеОтбора	= Истина;
	ИначеЕсли ТипАдреса = "ТолькоАдреса" Тогда
		ЗначениеОтбора	= Ложь;
	Иначе
		ЗначениеОтбора 	= Неопределено;
	КонецЕсли;
	
	Для Каждого ТекущийЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТекущийЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля) Тогда
			ЭлементОтбора = ТекущийЭлементОтбора;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	КонецЕсли;
	
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(ИмяПоля);  
	ЭлементОтбора.Использование 	= НЕ ЗначениеОтбора = Неопределено;
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение	= ЗначениеОтбора;
	
КонецПроцедуры
