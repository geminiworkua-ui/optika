
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьВидимость();
	УстановитьПараметрыВыбора();
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) 
		И СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Объект.ЭтоАдресОтделения = Истина;
	КонецЕсли;
	
	ТолькоПросмотр = ЗначениеЗаполнено(Объект.Идентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ЗаполнитьНаименованиеНаСервере();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	УстановитьВидимость();
	УстановитьПараметрыВыбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтоАдресОтделенияПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтделениеПриИзменении(Элемент)
	
	ПриИзмененииАдресаНаСервере(Объект.Отделение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПочтовыйИндексЗнаюПриИзменении(Элемент)
	
	ПриИзмененииАдресаНаСервере(, Объект.ПочтовыйИндекс)
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура УстановитьВидимость()

	Если Объект.Владелец.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНоваяПочта;
		
	Иначе
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаУкрпочта;
		
		Если Объект.ЭтоАдресОтделения Тогда 
			Элементы.ГруппаУлицаНомерДома.Видимость 	= Ложь;
			Элементы.ГруппаУлицаНомерДомаЗнаю.Видимость = Ложь;
			Элементы.Отделение.Видимость 				= Истина;
		Иначе
			Элементы.ГруппаУлицаНомерДома.Видимость 	= Истина;
			Элементы.ГруппаУлицаНомерДомаЗнаю.Видимость = Истина;
			Элементы.Отделение.Видимость 				= Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииАдресаНаСервере(Отделение = Неопределено, ПочтовыйИндекс = "")

	Если НЕ ЗначениеЗаполнено(Отделение)
		И НЕ ЗначениеЗаполнено(ПочтовыйИндекс) Тогда 
		
		Объект.Регион 			= Неопределено;
		Объект.Район 			= Неопределено;
		Объект.НаселенныйПункт 	= Неопределено;
		Объект.Отделение 		= Неопределено;
		Объект.ПочтовыйИндекс 	= "";
		
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_НаселенныеПунктыДоставки.Владелец КАК Регион,
		|	eComm_НаселенныеПунктыДоставки.Район КАК Район,
		|	eComm_ОтделенияДоставки.Владелец КАК НаселенныйПункт,
		|	eComm_ОтделенияДоставки.Ссылка КАК Отделение,
		|	eComm_ОтделенияДоставки.ПочтовыйИндекс КАК ПочтовыйИндекс
		|ИЗ
		|	Справочник.eComm_ОтделенияДоставки КАК eComm_ОтделенияДоставки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_НаселенныеПунктыДоставки КАК eComm_НаселенныеПунктыДоставки
		|		ПО eComm_ОтделенияДоставки.Владелец = eComm_НаселенныеПунктыДоставки.Ссылка
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ПочтовыйИндекс = """"
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ eComm_ОтделенияДоставки.ПочтовыйИндекс = &ПочтовыйИндекс
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &Отделение = НЕОПРЕДЕЛЕНО
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ eComm_ОтделенияДоставки.Ссылка = &Отделение
		|		КОНЕЦ
		|	И eComm_ОтделенияДоставки.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Отделение"		, Отделение);
	Запрос.УстановитьПараметр("ПочтовыйИндекс"	, ПочтовыйИндекс);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(Объект, РезультатЗапроса);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаименованиеНаСервере()
	
	Справочники.eComm_АдресаДоставки.ЗаполнитьНаименование(Объект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбора()

	СлужбаДоставки = Объект.Владелец.СлужбаДоставки;
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.СлужбаДоставки", СлужбаДоставки));

	Элементы.Регион.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	Элементы.РегионНоваяПочта.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
	Если Не СлужбаДоставки = Объект.Регион.СлужбаДоставки Тогда 
		Объект.Регион = Неопределено;
	КонецЕсли;

КонецПроцедуры





