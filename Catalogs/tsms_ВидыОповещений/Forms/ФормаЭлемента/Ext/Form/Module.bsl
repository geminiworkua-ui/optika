
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//ДК: 16.11.2026
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ЭскалацияВСМС      = Истина;
		Объект.ЭскалацияЧерезДней = 3;
	КонецЕсли;
	//:ДК 16.11.2026
	ОбновитьФормуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьФормуНаСервере()
	НастройкаВидимости();
	НастроитьЗаголовокКоличестваДней();
	ОбновитьДоступныеПараметрыНаСервере();
КонецПроцедуры 

&НаСервере
Процедура НастройкаВидимости()

	ЭтоПокупка = (Объект.ВидСобытия = Перечисления.tsms_ВидыСобытийОповещений.СрокПослеПокупки);
	
	Элементы.ГруппыНоменклатуры.Видимость   = ЭтоПокупка;
	Элементы.ЗначениеРежимаЗамены.Видимость = ЭтоПокупка;
	Элементы.РасчетПоЗапасуЛинз.Видимость   = ЭтоПокупка;
	//ДК: 29.10.2026
	Элементы.КаналПродаж.Видимость          = ЭтоПокупка;
	//:ДК 29.10.2026

	//ДК: 17.11.2026
	Элементы.ПродажаВЛинзах.Видимость = ЭтоПокупка И Объект.РасчетПоЗапасуЛинз;
	//:ДК 17.11.2026
	
	//ДК: 16.11.2026
	ЭтоКарусель = (Объект.ТипViberСообщения = Перечисления.tsms_ТипыViberСообщений.Карусель);
	Элементы.ГруппаКарусель.Видимость = ЭтоКарусель;
	Элементы.Группа9.Видимость        = Не ЭтоКарусель; // картинка обычного сообщения
	Элементы.Группа10.Видимость       = Не ЭтоКарусель; // кнопка обычного сообщения
	//:ДК 16.11.2026
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЗаголовокКоличестваДней()
	
	Если Объект.ВидСобытия = Перечисления.tsms_ВидыСобытийОповещений.ДеньРождения Тогда
		Заголовок = "Днів до дня народження";
		Подсказка = "За скільки днів до дня народження клієнта надіслати сповіщення";
	ИначеЕсли Объект.ВидСобытия = Перечисления.tsms_ВидыСобытийОповещений.СрокПослеПокупки
		И Объект.РасчетПоЗапасуЛинз Тогда
		Заголовок = "Днів до закінчення запасу";
		Подсказка = "За скільки днів до закінчення запасу лінз надіслати сповіщення";
	ИначеЕсли Объект.ВидСобытия = Перечисления.tsms_ВидыСобытийОповещений.СрокПослеПокупки Тогда
		Заголовок = "Днів після покупки";
		Подсказка = "Через скільки днів після останньої покупки надіслати сповіщення";
	Иначе
		Заголовок = "Кількість днів";
		Подсказка = "";
	КонецЕсли;
	
	Элементы.КоличествоДней.Заголовок = Заголовок;
	Элементы.КоличествоДней.Подсказка = Подсказка;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСобытияПриИзменении(Элемент)
	ОбновитьФормуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступныеПараметрыНаСервере()
	
	ДоступныеПараметрыДляШаблона.Очистить();
	
	ДоступныеПараметрыДляШаблона.Добавить("[НаименованиеКлиента]", "Найменування клієнта");
	ДоступныеПараметрыДляШаблона.Добавить("[КоличествоДней]",     "Кількість днів (з настройки)");
	//ДК: 16.11.2026
	Если Объект.ВидСобытия = Перечисления.tsms_ВидыСобытийОповещений.РучнаяРассылка Тогда
		ДоступныеПараметрыДляШаблона.Добавить("[ФіліяПокупки]", "Філія останньої покупки");
		ДоступныеПараметрыДляШаблона.Добавить("[НомерТелефонуФіліїПокупки]", "Номер телефону філії останньої покупки");
		ДоступныеПараметрыДляШаблона.Добавить("[АдресаФіліїПокупки]", "Адреса філії останньої покупки");
	КонецЕсли;
	//:ДК 16.11.2026
	
	Если Объект.ВидСобытия = Перечисления.tsms_ВидыСобытийОповещений.СрокПослеПокупки Тогда
		ДоступныеПараметрыДляШаблона.Добавить("[Номенклатура]", "Найменування купленого товару");
		//ДК: 07.10.2026
		ДоступныеПараметрыДляШаблона.Добавить("[ФіліяПокупки]", "Філія де була покупка");
		ДоступныеПараметрыДляШаблона.Добавить("[НомерТелефонуФіліїПокупки]", "Номер телефону філії де була покупка");
		ДоступныеПараметрыДляШаблона.Добавить("[АдресаФіліїПокупки]", "Адреса філії де була покупка");
		//: ДК 07.10.2026
		Если Объект.РасчетПоЗапасуЛинз Тогда
			ДоступныеПараметрыДляШаблона.Добавить("[ДатаОкончания]",  "Дата закінчення запасу лінз");
			ДоступныеПараметрыДляШаблона.Добавить("[КоличествоЛинз]", "Кількість куплених лінз");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДоступныеПараметрыДляШаблонаНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Значение) Тогда
		ПараметрыПеретаскивания.Значение = Элемент.ТекущиеДанные.Значение;
	Иначе
		Выполнение = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЯзыкСообщенияПриИзменении(Элемент)
	ОбновитьОстатокСимволов(Элементы.ШаблонСообщения.ТекстРедактирования);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОстатокСимволов(Знач ВведенныйТекст)
	
	МаксДлина = ?(ЯзыкСообщения = 0, 661, 1521);
	
	ТекущаяДлина = СтрДлина(ВведенныйТекст);
	Осталось = МаксДлина - ТекущаяДлина;
	
	Элементы.ШаблонСообщения.Подсказка = СтрШаблон("Залишок символів: %1 з %2", Осталось, МаксДлина);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьОстатокСимволов(Объект.ШаблонСообщения);
КонецПроцедуры


&НаКлиенте
Процедура ШаблонСообщенияПриИзменении(Элемент)
	ОбновитьОстатокСимволов(Объект.ШаблонСообщения);
КонецПроцедуры  

&НаКлиенте
Процедура ШаблонСообщенияИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)		
	ОбновитьОстатокСимволов(Текст);	
КонецПроцедуры  


&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	МаксДлина = ?(ЯзыкСообщения = 0, 661, 1521);
	
	ТекущаяДлина = СтрДлина(Объект.ШаблонСообщения);
	
	Если ТекущаяДлина > МаксДлина Тогда
		Отказ = Истина;
		Сообщить("Помилка запису змін. Текст перевищує максимальну довжину.");
		Возврат;	
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ОтправитьТестовоеСообщениеНаСервере()
	
	Если Не ЗначениеЗаполнено(НомерТелефонаДляТестовойОтправки) Тогда
		Сообщить("Не указан номер телефона для тестовой отправки");
		Возврат;	
	КонецЕсли;
	
	НормТелефон = tsms_СерверныйМодуль.НормализоватьНомерТелефона(НомерТелефонаДляТестовойОтправки);
	
	Если СтрДлина(НормТелефон) <> 12 Или Не СтрНачинаетсяС(НормТелефон, "380") Тогда
		Сообщить(СтрШаблон("Некорректный номер телефона: '%1'", НомерТелефонаДляТестовойОтправки));
		Возврат;
	КонецЕсли;
	
	МассивТелефонов = Новый Массив;
	МассивТелефонов.Добавить(НормТелефон);
	
	ТекстВайбер   = СокрЛП(ТестовыйТекстПоШаблону(Объект.ШаблонСообщенияViber));
	ТекстСМС      = СокрЛП(ТестовыйТекстПоШаблону(Объект.ШаблонСообщения));
	ТекстТелеграм = СокрЛП(ТестовыйТекстПоШаблону(Объект.ШаблонСообщенияTelegram)); 
	
	ПараметрыViber = Новый Структура;
	ПараметрыViber.Вставить("ИДКартинки", Объект.КартинкаViberИД);
	ПараметрыViber.Вставить("ТекстКнопки", Объект.КнопкаViberТекст);
	ПараметрыViber.Вставить("СсылкаКнопки", Объект.КнопкаViberСсылка);
	
	//ДК: 16.11.2026
	ЭтоКарусель = (Объект.ТипViberСообщения = Перечисления.tsms_ТипыViberСообщений.Карусель);
	Если ЭтоКарусель Тогда
		ТекстОшибки = ОшибкаЗаполненияКарусели(Объект.КарточкиКарусели);
		Если ТекстОшибки <> "" Тогда
			Сообщить(ТекстОшибки);
			Возврат;
		КонецЕсли;
		ПараметрыViber.Вставить("Карусель", tsms_СерверныйМодуль.КарусельИзСтрок(Объект.КарточкиКарусели));
	КонецЕсли;
	//:ДК 16.11.2026
	
	Если Объект.КартинкаViberИД > 0
		И (Не ЗначениеЗаполнено(Объект.КнопкаViberТекст) Или Не ЗначениеЗаполнено(Объект.КнопкаViberСсылка)) Тогда
		Сообщить("Viber: картинка не будет отправлена - не заполнены текст и ссылка кнопки");
	КонецЕсли;
	
	КаналSMS      = Перечисления.tsms_КаналыОтправки.SMS;
	КаналViber    = Перечисления.tsms_КаналыОтправки.Viber;
	КаналTelegram = Перечисления.tsms_КаналыОтправки.Telegram;
	
	// Каналы по приоритету (порядок строк). Пусто - Viber, затем SMS.
	Каналы = Новый Массив;
	Для Каждого СтрокаКанала Из Объект.КаналыОтправки Цикл
		Если ЗначениеЗаполнено(СтрокаКанала.Канал) И Каналы.Найти(СтрокаКанала.Канал) = Неопределено Тогда
			Каналы.Добавить(СтрокаКанала.Канал);
		КонецЕсли;
	КонецЦикла;
	Если Каналы.Количество() = 0 Тогда
		Каналы.Добавить(КаналViber);
		Каналы.Добавить(КаналSMS);
	КонецЕсли;
	
	Количество = Каналы.Количество();
	Индекс = 0;
	Пока Индекс < Количество Цикл
		
		Канал = Каналы[Индекс];
		
		Если Канал = КаналViber Тогда
			
			Если ТекстВайбер = "" Тогда
				Сообщить("Viber: шаблон не заполнен, пропускаем");
			Иначе
				ГибриднаяSMS = "";
				//ДК: 16.11.2026
				//Если Индекс + 1 < Количество И Каналы[Индекс + 1] = КаналSMS Тогда
				Если Индекс + 1 < Количество И Каналы[Индекс + 1] = КаналSMS И Не ЭтоКарусель Тогда
				//:ДК 16.11.2026
					ГибриднаяSMS = ТекстСМС;
				КонецЕсли;
				Если ТестоваяОтправкаTurboSMS(МассивТелефонов, ТекстВайбер, ГибриднаяSMS, ПараметрыViber) Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли Канал = КаналSMS Тогда
			
			Если ТекстСМС = "" Тогда
				Сообщить("SMS: шаблон не заполнен, пропускаем");
			ИначеЕсли ТестоваяОтправкаTurboSMS(МассивТелефонов, "", ТекстСМС, Неопределено) Тогда
				Возврат;
			КонецЕсли;
			
		ИначеЕсли Канал = КаналTelegram Тогда
			
			Сообщить("Telegram: канал пока не подключен, пропускаем");
			
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Сообщить("Ни один канал не отправил сообщение");
		
КонецПроцедуры

// ТекстВайбер и ТекстСМС заполнены - гибрид, иначе один канал.
&НаСервере
Функция ТестоваяОтправкаTurboSMS(МассивТелефонов, ТекстВайбер, ТекстСМС, ПараметрыViber)
	
	Если ТекстВайбер <> "" И ТекстСМС <> "" Тогда
		Описание = "viber+sms (гибрид)";
	ИначеЕсли ТекстВайбер <> "" Тогда
		Описание = "viber";
	Иначе
		Описание = "sms";
	КонецЕсли;
	
	Попытка
		Ответ = ИнтеграцияСТурбоСМС.ОтправитьСообщениеTurboSMSРасш(МассивТелефонов, ТекстВайбер, ТекстСМС, ПараметрыViber);
	Исключение
		Сообщить(СтрШаблон("%1: исключение при отправке: %2", Описание, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;
	
	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Сообщить(СтрШаблон("%1: сервер TurboSMS повернув некоректну відповідь", Описание));
		Возврат Ложь;
	КонецЕсли;
	
	Статус = Строка(Ответ.Получить("response_status"));
	
	СтатусПолучателя = "";
	Результаты = Ответ.Получить("response_result");
	Если ТипЗнч(Результаты) = Тип("Массив") И Результаты.Количество() > 0
		И ТипЗнч(Результаты[0]) = Тип("Соответствие") Тогда
		СтатусПолучателя = Строка(Результаты[0].Получить("response_status"));
	КонецЕсли;
	
	Успех = СтрНачинаетсяС(Статус, "SUCCESS")
		И (Не ЗначениеЗаполнено(СтатусПолучателя)
			Или СтатусПолучателя = "OK"
			Или СтрНачинаетсяС(СтатусПолучателя, "SUCCESS"));
	
	Сообщить(СтрШаблон("%1: %2 / %3 -> %4", Описание, Статус, СтатусПолучателя, ?(Успех, "отправлено", "ошибка")));
	
	//ДК: 16.11.2026
	Если Успех Тогда
		ЕстьViber    = (ТекстВайбер <> "");
		ТестКарусели = ЕстьViber И ТипЗнч(ПараметрыViber) = Тип("Структура") И ПараметрыViber.Свойство("Карусель");
		
		ДанныеЖурнала = Новый Структура;
		ДанныеЖурнала.Вставить("ИДСообщения", tsms_Журнал.ИДСообщенияИзОтвета(Ответ));
		ДанныеЖурнала.Вставить("НомерТелефона", МассивТелефонов[0]);
		ДанныеЖурнала.Вставить("ВидОповещения", Объект.Ссылка);
		ДанныеЖурнала.Вставить("СпособОтправки", Перечисления.tsms_СпособыОтправки.Тестовая);
		ДанныеЖурнала.Вставить("Пользователь", Пользователи.ТекущийПользователь());
		ДанныеЖурнала.Вставить("КаналПлановый", ?(ЕстьViber,
			Перечисления.tsms_КаналыОтправки.Viber, Перечисления.tsms_КаналыОтправки.SMS));
		ДанныеЖурнала.Вставить("ТекстViber", ТекстВайбер);
		ДанныеЖурнала.Вставить("ТекстСМС", ТекстСМС);
		ДанныеЖурнала.Вставить("ОтслеживатьКлики", ЕстьViber И (ТестКарусели
			Или ЗначениеЗаполнено(Объект.КнопкаViberТекст) И ЗначениеЗаполнено(Объект.КнопкаViberСсылка)));
		Если ТестКарусели Тогда
			ДанныеЖурнала.Вставить("ТипСообщения", Перечисления.tsms_ТипыViberСообщений.Карусель);
		КонецЕсли;
		
		tsms_Журнал.ЗаписатьСообщение(ДанныеЖурнала);
	КонецЕсли;
	//:ДК 16.11.2026
	
	Возврат Успех;
	
КонецФункции

&НаСервере
Функция ТестовыйТекстПоШаблону(Шаблон)
	
	Текст = СтрЗаменить(Шаблон, "[НаименованиеКлиента]", "Тестовый клиент");
	Текст = СтрЗаменить(Текст, "[КоличествоДней]", Строка(Объект.КоличествоДней));
	
	//ДК: 14.10.2026
	Текст = СтрЗаменить(Текст, "[Номенклатура]", "Тестовий товар");
	Текст = СтрЗаменить(Текст, "[ФіліяПокупки]", "Тестова філія");
	Текст = СтрЗаменить(Текст, "[НомерТелефонуФіліїПокупки]", "+38 (000) 000-00-00");
	Текст = СтрЗаменить(Текст, "[АдресаФіліїПокупки]", "м. Київ, вул. Тестова, 1");
	
	// Как будто сообщение отправлено сегодня: запас заканчивается через КоличествоДней
	Текст = СтрЗаменить(Текст, "[ДатаОкончания]",
		Формат(НачалоДня(ТекущаяДатаСеанса()) + Объект.КоличествоДней * 86400, "ДФ=dd.MM.yyyy"));
	Текст = СтрЗаменить(Текст, "[КоличествоЛинз]", "2");
	//: ДК 14.10.2026
	
	Возврат Текст;
	
КонецФункции


&НаКлиенте
Процедура ОтправитьТестовоеСообщение(Команда)
	ОтправитьТестовоеСообщениеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДанныеКартинки = ТекущийОбъект.КартинкаViber.Получить();
	Если ТипЗнч(ДанныеКартинки) = Тип("ДвоичныеДанные") Тогда
		АдресКартинкиViber = ПоместитьВоВременноеХранилище(ДанныеКартинки, УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//ДК: 16.11.2026
	Если ТекущийОбъект.ТипViberСообщения = Перечисления.tsms_ТипыViberСообщений.Карусель Тогда
		ТекстОшибки = ОшибкаЗаполненияКарусели(ТекущийОбъект.КарточкиКарусели);
		Если ТекстОшибки <> "" Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//:ДК 16.11.2026
	
	Если Не КартинкаViberИзменена Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресКартинкиViber) Тогда
		ТекущийОбъект.КартинкаViber = Новый ХранилищеЗначения(
			ПолучитьИзВременногоХранилища(АдресКартинкиViber), Новый СжатиеДанных(9));
	Иначе
		ТекущийОбъект.КартинкаViber = Новый ХранилищеЗначения(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	КартинкаViberИзменена = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКартинкуViber(Команда)
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите картинку для Viber";
	ПараметрыДиалога.Фильтр = "Картинки (*.jpg;*.jpeg;*.png)|*.jpg;*.jpeg;*.png";
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьКартинкуViberЗавершение", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(Оповещение, , , , ПараметрыДиалога, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКартинкуViberЗавершение(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	
		Если ОписаниеПомещенногоФайла = Неопределено Или ОписаниеПомещенногоФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьКартинкуViberНаСервере(ОписаниеПомещенногоФайла.Адрес,
		ОписаниеПомещенногоФайла.СсылкаНаФайл.Расширение);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКартинкуViberНаСервере(Адрес, Расширение)
	
	ДанныеКартинки = ПолучитьИзВременногоХранилища(Адрес);
	
	Попытка
		ИДФайла = ИнтеграцияСТурбоСМС.ЗагрузитьФайлTurboSMS(ДанныеКартинки, Расширение);
	Исключение
		Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	АдресКартинкиViber    = ПоместитьВоВременноеХранилище(ДанныеКартинки, УникальныйИдентификатор);
	Объект.КартинкаViberИД = ИДФайла;
	КартинкаViberИзменена = Истина;
	Модифицированность    = Истина;
	
	Сообщить(СтрШаблон("Картинка загружена в TurboSMS (id %1)", ИДФайла));
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКартинкуViber(Команда)
	
	АдресКартинкиViber     = "";
	Объект.КартинкаViberИД = 0;
	КартинкаViberИзменена  = Истина;
	Модифицированность     = Истина;
	
КонецПроцедуры

