// Возвращает текст ошибки или "", если карусель заполнена верно.
&НаСервереБезКонтекста
Функция ОшибкаЗаполненияКарусели(Карточки)
	
	Количество = Карточки.Количество();
	Если Количество < 2 Или Количество > 5 Тогда
		Возврат "Карусель: має бути від 2 до 5 карток.";
	КонецЕсли;
	
	Номер = 0;
	Для Каждого Карточка Из Карточки Цикл
		
		Номер = Номер + 1;
		
		Если ПустаяСтрока(Карточка.Заголовок) Тогда
			Возврат СтрШаблон("Карусель, картка %1: не заповнено заголовок.", Номер);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Карточка.КартинкаИД) Тогда
			Возврат СтрШаблон("Карусель, картка %1: не вибрано картинку.", Номер);
		КонецЕсли;
		Если ПустаяСтрока(Карточка.ТекстКнопки) Или Не ЭтоАдресСайта(Карточка.СсылкаКнопки) Тогда
			Возврат СтрШаблон("Карусель, картка %1: заповніть текст кнопки і посилання (http:// або https://).", Номер);
		КонецЕсли;
		Если ПустаяСтрока(Карточка.ТекстСсылки) <> ПустаяСтрока(Карточка.АдресСсылки) Тогда
			Возврат СтрШаблон("Карусель, картка %1: додаткове посилання — заповніть і текст, і адресу, або очистіть обидва поля.", Номер);
		КонецЕсли;
		Если Не ПустаяСтрока(Карточка.АдресСсылки) И Не ЭтоАдресСайта(Карточка.АдресСсылки) Тогда
			Возврат СтрШаблон("Карусель, картка %1: адреса додаткового посилання має починатися з http:// або https://.", Номер);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоАдресСайта(Знач Адрес)
	
	Адрес = НРег(СокрЛП(Адрес));
	Возврат СтрНачинаетсяС(Адрес, "http://") Или СтрНачинаетсяС(Адрес, "https://");
	
КонецФункции

&НаКлиенте
Процедура ВыбратьКартинкуКарточки(Команда)
	
	ТекущиеДанные = Элементы.КарточкиКарусели.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Спочатку додайте картку та виділіть її рядок.");
		Возврат;
	КонецЕсли;
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Картинка картки (рекомендовано 215x185)";
	ПараметрыДиалога.Фильтр = "Картинки (*.jpg;*.jpeg;*.png)|*.jpg;*.jpeg;*.png";
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьКартинкуКарточкиЗавершение", ЭтотОбъект,
		ТекущиеДанные.ПолучитьИдентификатор());
	НачатьПомещениеФайлаНаСервер(Оповещение, , , , ПараметрыДиалога, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКартинкуКарточкиЗавершение(ОписаниеПомещенногоФайла, ИдентификаторСтроки) Экспорт
	
	Если ОписаниеПомещенногоФайла = Неопределено Или ОписаниеПомещенногоФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьКартинкуКарточкиНаСервере(ОписаниеПомещенногоФайла.Адрес,
		ОписаниеПомещенногоФайла.СсылкаНаФайл.Расширение,
		ОписаниеПомещенногоФайла.СсылкаНаФайл.Имя, ИдентификаторСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКартинкуКарточкиНаСервере(Адрес, Расширение, ИмяФайла, ИдентификаторСтроки)
	
	СтрокаКарточки = Объект.КарточкиКарусели.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаКарточки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ИДФайла = ИнтеграцияСТурбоСМС.ЗагрузитьФайлTurboSMS(ПолучитьИзВременногоХранилища(Адрес), Расширение);
	Исключение
		Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	СтрокаКарточки.КартинкаИД       = ИДФайла;
	СтрокаКарточки.ИмяФайлаКартинки = Лев(ИмяФайла, 150);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКартинкуКарточки(Команда)
	
	ТекущиеДанные = Элементы.КарточкиКарусели.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.КартинкаИД       = 0;
	ТекущиеДанные.ИмяФайлаКартинки = "";
	Модифицированность = Истина;
	
КонецПроцедуры
//:ДК 16.11.2026