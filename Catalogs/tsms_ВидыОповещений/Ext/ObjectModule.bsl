Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Встреченные = Новый Соответствие;
	
	Для Каждого СтрокаКанала Из КаналыОтправки Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаКанала.Канал) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Встреченные[СтрокаКанала.Канал] <> Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Канал ""%1"" указан повторно", СтрокаКанала.Канал);
			Сообщение.Поле  = СтрШаблон("КаналыОтправки[%1].Канал", Формат(СтрокаКанала.НомерСтроки - 1, "ЧГ=0"));
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
		Встреченные.Вставить(СтрокаКанала.Канал, Истина);
		
	КонецЦикла;
	
КонецПроцедуры
