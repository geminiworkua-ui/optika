
&НаКлиенте
Процедура ЗаполнитьСписокПоУмолчанию(Команда)
	ЗаполнитьСписокПоУмолчаниюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПоУмолчаниюНаСервере()
	
	Макет = Справочники.eComm_СостоянияЗаказовПокупателей.ПолучитьМакет("ШаблоныСтатусов");
	
	Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
		
		Ячейка = Макет.Область(НомерСтроки, 1);
		Если Ячейка.СодержитЗначение Тогда
			Значение = Ячейка.Значение;
		Иначе
			Значение = Ячейка.Текст;
		КонецЕсли;			
		Если ЗначениеЗаполнено(Значение) Тогда 
			Если Справочники.eComm_СостоянияЗаказовПокупателей.НайтиПоНаименованию(Значение) = Справочники.eComm_СостоянияЗаказовПокупателей.ПустаяСсылка() Тогда 
				НовыйЭлемент = Справочники.eComm_СостоянияЗаказовПокупателей.СоздатьЭлемент();
				НовыйЭлемент.Наименование = Значение;
				НовыйЭлемент.Записать();
			КонецЕсли;
		КонецЕсли;
								
	КонецЦикла;
	
КонецПроцедуры
