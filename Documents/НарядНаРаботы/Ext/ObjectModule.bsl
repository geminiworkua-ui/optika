Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// + Боков
	СформироватьДвиженияПоРегиструИсторияСтатусов();
	// - Боков

	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый запрос("ВЫБРАТЬ
	                      |	ИсторияСтатусовНарядовНаРаботыСрезПоследних.Статус
	                      |ИЗ
	                      |	РегистрСведений.ИсторияСтатусовНарядовНаРаботы.СрезПоследних(&Дата, ДокументНарядНаРаботы = &Ссылка) КАК ИсторияСтатусовНарядовНаРаботыСрезПоследних");
	
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Статус = Статус 
		Тогда
		
		
	Иначе
		
	Запись = РегистрыСведений.ИсторияСтатусовНарядовНаРаботы.СоздатьМенеджерЗаписи();
	Запись.Автор = параметрыСеанса.ТекущийПользователь;
	Запись.Статус = Статус;
	Запись.Период = ТекущаяДата();
	Запись.ДокументНарядНаРаботы = Ссылка;
	Запись.Записать();
КонецЕсли;

КонецПроцедуры	


Процедура СформироватьДвиженияПоРегиструИсторияСтатусов()        // Боков
	
    // проверим, было ли изменение статуса относительно прошлой записи  
	// Если статус меняется, то формируем записи по строкам, где есть назначение (т.е. там, где есть привязка к заказам клиента)
	ТекущаяДата = ТекущаяДата();

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИсторияСтатусовДокументовСрезПоследних.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовДокументов.СрезПоследних(&ТекДата, ДокументРегистратор = &ДокументРегистратор) КАК ИсторияСтатусовДокументовСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИсторияСтатусовДокументовСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументРегистратор", Ссылка);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если НЕ Ссылка.Статус = Выборка.Статус
			Тогда
			   НадоЗаписать = Истина;
		   Иначе
			   НадоЗаписать = Ложь;
		КонецЕсли
	Иначе
		 НадоЗаписать = Истина;
	КонецЕсли;
	
	Если НадоЗаписать = Истина 
		Тогда
		
		// Найдем и заполним данные из спраыочника Назначения
		
		Если НЕ ЗначениеЗаполнено(Назначение)
			Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Назначения.Ссылка КАК Назначение
			|ИЗ
			|	Справочник.Назначения КАК Назначения
			|ГДЕ
			|	Назначения.Заказ = &Заказ";
			
			Запрос.УстановитьПараметр("Заказ", Ссылка.ЗаказКлиента);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				НовНазначение = Выборка.Назначение;
				//ЭтотОбъект.ПолучитьОбъект();
				ЭтотОбъект.Назначение = НовНазначение;
				ЭтотОбъект.Записать();
			КонецЕсли;

			
			
		КонецЕсли;	
		// Заполним регистр
		НаборЗаписей = РегистрыСведений.ИсторияСтатусовДокументов.СоздатьНаборЗаписей(); 
		
		НаборЗаписей.Отбор.Период.Установить(ТекущаяДата); 
		
		Если 
			НЕ Назначение = неопределено
			Тогда
			НовЗапись = НаборЗаписей.Добавить();
			НовЗапись.Период = ТекущаяДата;
			НовЗапись.ДокументРегистратор = Ссылка;
			НовЗапись.Статус = Статус;
			НовЗапись.Назначение = Назначение;
			НовЗапись.Номенклатура = НоменклатураРабот;
			НовЗапись.Характеристика = Неопределено;
			НовЗапись.ДатаПлан = ТекущаяДата;
			НовЗапись.Автор = Автор;
			НовЗапись.Количество = 1;
			НовЗапись.ЗаказКлиента = Ссылка.ЗаказКлиента;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Склады.Ссылка КАК Склад,
			|	Склады.Наименование
			|ИЗ
			|	Справочник.Склады КАК Склады
			|ГДЕ
			|	Склады.Подразделение = &Подразделение";
			Запрос.УстановитьПараметр("Подразделение", Подразделение);
			Выборка2 = Запрос.Выполнить().Выбрать();
			Если Выборка2.Следующий() Тогда
				Склад = Выборка2.Склад;
			КонецЕсли; 
			
			НовЗапись.СкладНазначения = Склад;
			
		КонецЕсли;
		НаборЗаписей.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

