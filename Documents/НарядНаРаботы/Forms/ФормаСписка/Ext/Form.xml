			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументНарядНаРаботы.Ссылка,
	ДокументНарядНаРаботы.ПометкаУдаления,
	ДокументНарядНаРаботы.Номер,
	ДокументНарядНаРаботы.Дата,
	ДокументНарядНаРаботы.Проведен,
	ДокументНарядНаРаботы.Статус,
	ДокументНарядНаРаботы.ДатаВыполнения,
	ДокументНарядНаРаботы.ЗаказКлиента,
	ДокументНарядНаРаботы.Подразделение,
	ДокументНарядНаРаботы.Автор,
	ДокументНарядНаРаботы.ОписаниеРабот,
	ДокументНарядНаРаботы.Комментарий,
	ДокументНарядНаРаботы.Мастер,
	ДокументНарядНаРаботы.Начисление,
	ДокументНарядНаРаботы.НоменклатураРабот,
	ДокументНарядНаРаботы.Товары.(
		Ссылка,
		НомерСтроки,
		Номенклатура,
		Характеристика,
		Количество,
		Цена,
		Сумма
	),
	ДокументНарядНаРаботы.МоментВремени,
	ДокументНарядНаРаботы.ПодразделениеИсполнитель
ИЗ
	Документ.НарядНаРаботы КАК ДокументНарядНаРаботы
ГДЕ
	ВЫБОР
			КОГДА &amp;ОтбиратьПоАктуальности = ИСТИНА
					И (ДокументНарядНаРаботы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусДокументаНарядНаРаботу.ОжидаетПринятияВработу)
						ИЛИ ДокументНарядНаРаботы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусДокументаНарядНаРаботу.ПринятВработу))
				ТОГДА ИСТИНА
			КОГДА &amp;ОтбиратьПоАктуальности = ЛОЖЬ
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ПодразделениеИсполнитель ЕСТЬ NULL
					ИЛИ &amp;ПодразделениеИсполнитель = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
				ТОГДА ИСТИНА
			КОГДА НЕ &amp;ПодразделениеИсполнитель ЕСТЬ NULL
					И ДокументНарядНаРаботы.ПодразделениеИсполнитель = &amp;ПодразделениеИсполнитель
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;Подразделение ЕСТЬ NULL
					ИЛИ &amp;Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
				ТОГДА ИСТИНА
			КОГДА НЕ &amp;Подразделение ЕСТЬ NULL
					И ДокументНарядНаРаботы.Подразделение = &amp;Подразделение
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ</QueryText>
				<MainTable>Document.НарядНаРаботы</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
