
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьПараметрыОтбора();
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыОтбора()
	
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("ПодразделениеИсполнитель",ЭтаФорма.ПодразделениеОтбор);
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("Подразделение",ЭтаФорма.ПодразделениеЗаказчик);
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("ОтбиратьПоАктуальности",ЭтаФорма.НарядыКРаботе);
	
КонецПроцедуры

&НаКлиенте
Процедура НарядыКРаботеПриИзменении(Элемент)
	УстановитьПараметрыОтбора();
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	УстановитьПараметрыОтбора();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыОбеспечения(Команда)
	
	 	ОбновитьСтатусыОбеспеченияНаСервере();
        Элементы.Список.Обновить();

КонецПроцедуры

&НаСервере
Процедура   ОбновитьСтатусыОбеспеченияНаСервере()
	
	 Инфра_ОбщиеМодули.КонтрольОбеспеченияМастераМатериалами();
	 
	
КонецПроцедуры	
	