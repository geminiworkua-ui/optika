
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("НарядНаРаботы")
		Тогда
		ДокументНарядНаРаботы = Параметры.НарядНаРаботы;
	ИНаче
		ДокументНарядНаРаботы = Перечисления.СтатусДокументаНарядНаРаботу.ПустаяСсылка()
	КонецЕсли;
		
	СписокИсторияСтатусов.Параметры.УстановитьЗначениеПараметра("ДокументНарядНаРаботы", ДокументНарядНаРаботы);
	
	ЭтаФорма.ТолькоПросмотр = Истина;
	
КонецПроцедуры
