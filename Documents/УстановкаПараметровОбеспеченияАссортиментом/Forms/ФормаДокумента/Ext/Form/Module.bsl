
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка)
		Тогда 
		Объект.Автор = ПользователиКлиентСервер.ТекущийПользователь();   
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПараметрам(Команда)
	
	Если ЗначениеЗаполнено(объект.ПроцентБС) Тогда
		Для
			
			
			каждого Стр из ОБъект.Критерии цикл
			Если ЗначениеЗаполнено(Стр.КОличествоНорма)
				Тогда
				Стр.КОличествоБС = окр(Стр.КоличествоНорма * объект.ПроцентБС,0,РежимОкругления.Окр15как20) / 100;
				Стр.КоличествоСезон = окр(Стр.КоличествоНорма * объект.ПроцентСезон,0,РежимОкругления.Окр15как20) /  100;
				Стр.КоличествоМакс = Стр.КоличествоНорма + окр(Стр.КоличествоНорма * объект.ПроцентМакс,0,РежимОкругления.Окр15как20) / 100;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
