
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	СтруктураРеквизитов = Новый Структура("Дата, УчетнаяЗапись, ТипГруза");
	СтруктураРеестра 	= eCommДоставкаСервер.ВернутьЗначенияРеквизитовДокумента(ПараметрКоманды, СтруктураРеквизитов);
	СтруктураНастроек	= eCommДоставкаСервер.Настройки(СтруктураРеестра.УчетнаяЗапись);
	
	Реестр = РеестрНакладной(ПараметрКоманды);//eCommДоставкаСервер.НайтиРеестр(СтруктураНастроек, СтруктураРеестра);
	
	СтруктураРеестра.Вставить("Реестр"				, Реестр);
	СтруктураРеестра.Вставить("ЭкспрессНакладная"	, ПараметрКоманды);
	
	НазваниеРеестра = "" + Реестр;
	
	ОписаниеОповещения 	= Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтотОбъект, СтруктураРеестра);
	
	ТекстВопроса = НСтр("ru = 'Удалить накладную " + ПараметрКоманды + " из реестра " + НазваниеРеестра + "?'; 
						|uk = 'Видалити накладну " + ПараметрКоманды + " з реестру " + НазваниеРеестра + "?'") ;
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , , НСтр("ru = 'Удаление из реестру'; uk = 'Видалення з реєстру'"));

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(РезультатВыбора, СтруктураРеестра) Экспорт
	
	Если НЕ РезультатВыбора = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	УдалитьНакладнуюИзРеестра(СтруктураРеестра)
	
КонецПроцедуры

&НаСервере
Функция УдалитьНакладнуюИзРеестра(СтруктураРеестра)
	
	СтруктураНастроек = eCommДоставкаСервер.Настройки(СтруктураРеестра.УчетнаяЗапись);
	
	Возврат Справочники.eComm_УчетныеЗаписиСлужбДоставки.УдалитьНакладнуюИзРеестра(СтруктураНастроек, СтруктураРеестра.Реестр, СтруктураРеестра.ЭкспрессНакладная);

КонецФункции

&НаСервере
Функция РеестрНакладной(ЭкспрессНакладная)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_Реестры.Реестр КАК Реестр
		|ИЗ
		|	РегистрСведений.eComm_Реестры КАК eComm_Реестры
		|ГДЕ
		|	eComm_Реестры.ЭкспрессНакладная = &ЭкспрессНакладная";
	
	Запрос.УстановитьПараметр("ЭкспрессНакладная", ЭкспрессНакладная);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат РезультатЗапроса.Реестр;
	КонецЕсли;
	
КонецФункции




