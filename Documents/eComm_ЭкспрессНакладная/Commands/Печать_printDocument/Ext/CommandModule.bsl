
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	СтруктураЭН 		= eCommДоставкаСервер.ВернутьСтруктуруЭН(ПараметрКоманды);
	СтруктураНастроек 	= Настройки(СтруктураЭН.УчетнаяЗапись);
	
	Если ЗначениеЗаполнено(СтруктураЭН.НомерТТН) Тогда
		
		Если СтруктураНастроек.СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.НоваяПочта") Тогда
			
			Адрес = "https://my.novaposhta.ua/orders/printDocument/orders/" + СтруктураЭН.НомерТТН + "/type/pdf/apiKey/" + СтруктураНастроек.КлючAPI;   
			ЗапуститьПриложение(Адрес);
			
		ИначеЕсли СтруктураНастроек.СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.УкрПочта") Тогда
			
			ПоказатьПредупреждение(, "Функционал не поддерживается!!!");
			
		ИначеЕсли СтруктураНастроек.СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.Meest") Тогда 
			
			Адрес = СтруктураЭН.НомерТТН + ".pdf"; 
			
			АдресВоВременномХранилище = АдресДекларацииВоВременномХранилище(ПараметрКоманды);
			Если ЗначениеЗаполнено(АдресВоВременномХранилище) Тогда 
				ПолучитьФайл(АдресВоВременномХранилище, Адрес, Истина);
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Сообщить("Номер экспресс-накладной не получен!!!");
		
	КонецЕсли;
	
КонецПроцедуры

Функция Настройки(УчетнаяЗапись)

	Возврат Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(УчетнаяЗапись);

КонецФункции

Функция АдресДекларацииВоВременномХранилище(ЭкспрессНакладная)

	Возврат Справочники.eComm_УчетныеЗаписиСлужбДоставки.ПечатьДекларации(ЭкспрессНакладная);

КонецФункции