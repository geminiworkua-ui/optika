
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПоказатьВопросОСоздании(ПараметрКоманды);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(РезультатВыбора, ЭН) Экспорт
	
	Если НЕ ТипЗнч(РезультатВыбора) = Тип("Структура")
		ИЛИ НЕ РезультатВыбора.Ответ = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	ДобавитьКРееструНаСервере(ЭН, РезультатВыбора.Реестр);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросОСоздании(ЭН)

	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтотОбъект, ЭН);
	
	ОткрытьФорму("Документ.eComm_ЭкспрессНакладная.Форма.ФормаВопроса", Новый Структура("ЭН", ЭН), ЭтотОбъект, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Процедура ДобавитьКРееструНаСервере(ЭкспрессНакладная, Реестр)
	
	СтруктураЭН 			= Новый Структура("Ссылка, УчетнаяЗапись, ДокументОснование, ТелефонПолучателя");
	ЗначенияРеквизитовЭН 	= eCommДоставкаСервер.ВернутьЗначенияРеквизитовДокумента(ЭкспрессНакладная, СтруктураЭН);
	
	СтруктураНастроек = eCommДоставкаСервер.Настройки(ЗначенияРеквизитовЭН.УчетнаяЗапись);
	
	Если СтруктураНастроек.Настройки.Свойство("ИспользоватьРеестры")
		И СтруктураНастроек.Настройки.ИспользоватьРеестры = Истина Тогда 
		
		Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
			
			// Для Укрпочты реестр создается перед созданием экспресс-накладной
			Если Реестр = "СОЗДАТЬ_РЕЕСТР" Тогда 
				
				СтруктураРеестра = Новый Структура;
				СтруктураРеестра.Вставить("Дата"						, НачалоДня(ЭкспрессНакладная.Дата));
				СтруктураРеестра.Вставить("ТипГруза"					, ЭкспрессНакладная.ТипГруза);
				СтруктураРеестра.Вставить("Отправитель"					, ЭкспрессНакладная.Отправитель);
				СтруктураРеестра.Вставить("КонтактноеЛицоОтправителя"	, ЭкспрессНакладная.КонтактноеЛицоОтправителя);
				СтруктураРеестра.Вставить("ОтделениеОтправителя"		, ЭкспрессНакладная.ОтделениеОтправителя);
				
				Реестр = eCommДоставкаСервер.СоздатьРеестр(СтруктураНастроек, СтруктураРеестра);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Справочники.eComm_УчетныеЗаписиСлужбДоставки.ДобавитьНакладнуюВРеестр(СтруктураНастроек, Реестр, ЭкспрессНакладная.Ссылка); 
		
	КонецЕсли;

КонецПроцедуры



