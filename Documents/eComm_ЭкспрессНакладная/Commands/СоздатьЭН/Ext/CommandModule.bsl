
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеОтветаНаВопрос", ЭтотОбъект, ПараметрКоманды);
	
	ОткрытьФорму("Документ.eComm_ЭкспрессНакладная.Форма.ФормаВопроса", Новый Структура("ЭН", ПараметрКоманды), ЭтотОбъект, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(РезультатВыбора, ЭН) Экспорт
	
	Если НЕ ТипЗнч(РезультатВыбора) = Тип("Структура")
		ИЛИ НЕ РезультатВыбора.Ответ = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	СоздатьЭННаСервере(ЭН);
	
	Оповестить("ЭкспрессНакладнаяСоздана", ЭН);
	
	ЭтоНовыйРеестр = РезультатВыбора.Реестр = "СОЗДАТЬ_РЕЕСТР";
	
	ДобавитьКРееструНаСервере(ЭН, РезультатВыбора.Реестр);
	
	Если ЭтоНовыйРеестр Тогда 
		Оповестить("ОбновитьСписокРеестров");
	КонецЕсли;
	
	СоздатьСМС(ЭН);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭННаСервере(ЭН)

	Справочники.eComm_УчетныеЗаписиСлужбДоставки.ОформитьДокумент(ЭН);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьСМС(ЭН)

	СтруктураЭкспрессНакладной = СтруктураЭкспрессНакладной(ЭН);
	
	СтруктураНастроек = eCommДоставкаСервер.Настройки(СтруктураЭкспрессНакладной.УчетнаяЗапись);
	
	Если СтруктураНастроек.Настройки.Свойство("СпособОтправкиСМС") Тогда 
		СпособОтправкиСМС = СтруктураНастроек.Настройки.СпособОтправкиСМС;
	Иначе
		СпособОтправкиСМС = "";
	КонецЕсли;
	
	ШаблонСМС = СтруктураНастроек.Настройки.ШаблонСМС;
	
	Если НЕ СпособОтправкиСМС = "ОткрыватьФормуСМС" 
		ИЛИ НЕ ЗначениеЗаполнено(ШаблонСМС) Тогда 
		Возврат;
	КонецЕсли;    
	
	ИмяДокументаСообщениеSMS 				= eCommДоставкаСервер.ВернутьИмяПрикладногоОбъекта("СообщениеSMS");
	ОтправлятьВТранслите_ВРеквизитахФормы 	= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("СообщениеSMS", "ОтправлятьВТранслите") = "";

	Если ИмяДокументаСообщениеSMS = "Событие" Тогда 
		ПутьКФорме = "Документ." + ИмяДокументаСообщениеSMS + ".Форма.ФормаСообщенияSMS";
	Иначе
		ПутьКФорме = "Документ." + ИмяДокументаСообщениеSMS + ".Форма.ФормаДокумента";
	КонецЕсли;
	Форма = ПолучитьФорму(ПутьКФорме);
	
	ДанныеФормы = Форма.Объект;
	eCommДоставкаСервер.ЗаполнитьСМСНаСервере(СтруктураНастроек, ДанныеФормы, СтруктураЭкспрессНакладной, ШаблонСМС, ОтправлятьВТранслите_ВРеквизитахФормы);
	КопироватьДанныеФормы(ДанныеФормы, Форма.Объект);
	
	Если ОтправлятьВТранслите_ВРеквизитахФормы Тогда 
		Форма["ОтправлятьВТранслите"] = eCommДоставкаСервер.ОтправлятьВТранслите(ШаблонСМС);
	КонецЕсли;
	
	Форма.Открыть();

КонецПроцедуры

&НаСервере
Функция СтруктураЭкспрессНакладной(ЭН)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ЭкспрессНакладная.Ссылка КАК Ссылка,
		|	eComm_ЭкспрессНакладная.ДокументОснование КАК ДокументОснование,
		|	eComm_ЭкспрессНакладная.УчетнаяЗапись КАК УчетнаяЗапись,
		|	eComm_ЭкспрессНакладная.ТелефонПолучателя КАК ТелефонПолучателя
		|ИЗ
		|	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
		|ГДЕ
		|	eComm_ЭкспрессНакладная.Ссылка = &ЭН";
	
	Запрос.УстановитьПараметр("ЭН", ЭН);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		
		СтруктураЭкспрессНакладной = Новый Структура("Ссылка, ДокументОснование, ТелефонПолучателя, УчетнаяЗапись");
		ЗаполнитьЗначенияСвойств(СтруктураЭкспрессНакладной, РезультатЗапроса);
		
		Возврат СтруктураЭкспрессНакладной;
		
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ДобавитьКРееструНаСервере(ЭкспрессНакладная, Реестр)
	
	СтруктураЭН 			= Новый Структура("Ссылка, УчетнаяЗапись, ДокументОснование, ТелефонПолучателя");
	ЗначенияРеквизитовЭН 	= eCommДоставкаСервер.ВернутьЗначенияРеквизитовДокумента(ЭкспрессНакладная, СтруктураЭН);
	
	СтруктураНастроек = eCommДоставкаСервер.Настройки(ЗначенияРеквизитовЭН.УчетнаяЗапись);
	
	Если СтруктураНастроек.Настройки.Свойство("ИспользоватьРеестры")
		И СтруктураНастроек.Настройки.ИспользоватьРеестры = Истина Тогда 
		
		Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
			
			// Для Укрпочты реестр создается перед созданием экспресс-накладной
			Если Реестр = "СОЗДАТЬ_РЕЕСТР" Тогда 
				
				СтруктураРеестра = Новый Структура;
				СтруктураРеестра.Вставить("Дата"						, НачалоДня(ЭкспрессНакладная.Дата));
				СтруктураРеестра.Вставить("ТипГруза"					, ЭкспрессНакладная.ТипГруза);
				СтруктураРеестра.Вставить("Отправитель"					, ЭкспрессНакладная.Отправитель);
				СтруктураРеестра.Вставить("КонтактноеЛицоОтправителя"	, ЭкспрессНакладная.КонтактноеЛицоОтправителя);
				СтруктураРеестра.Вставить("ОтделениеОтправителя"		, ЭкспрессНакладная.ОтделениеОтправителя);
				
				Реестр = eCommДоставкаСервер.СоздатьРеестр(СтруктураНастроек, СтруктураРеестра);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Справочники.eComm_УчетныеЗаписиСлужбДоставки.ДобавитьНакладнуюВРеестр(СтруктураНастроек, Реестр, ЭкспрессНакладная.Ссылка);
		
	КонецЕсли;

КонецПроцедуры