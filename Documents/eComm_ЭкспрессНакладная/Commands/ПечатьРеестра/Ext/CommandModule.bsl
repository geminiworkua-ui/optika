
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Реестр = ПараметрКоманды;
	
	СтруктураНастроек = eCommДоставкаСервер.Настройки(УчетнаяЗапись(ПараметрКоманды));
	
	Если ЗначениеЗаполнено(Реестр) Тогда
		
		Если СтруктураНастроек.СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.НоваяПочта") Тогда 
			
			СтруктураРеестра = eCommДоставкаСервер.ВернутьЗначенияРеквизитовСправочника(Реестр, Новый Структура("Идентификатор"));
			
			Адрес = "https://my.novaposhta.ua/scanSheet/printScanSheet/refs[]/" + СтруктураРеестра.Идентификатор + "/type/pdf/apiKey/" + СтруктураНастроек.КлючAPI;
			ЗапуститьПриложение(Адрес);
			
			eCommДоставкаСервер.ПослеПечатиРеестра(СтруктураНастроек, Новый Структура("Реестр", Реестр));
			
		ИначеЕсли СтруктураНастроек.СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.УкрПочта") Тогда 
			
			Адрес = "" + Реестр + ".pdf";
			Адрес = СтрЗаменить(Адрес, "/", "_");
			
			АдресВоВременномХранилище = АдресПечатнойФормыУкрПочтаВоВременномХранилище(ПараметрКоманды);
			Если ЗначениеЗаполнено(АдресВоВременномХранилище) Тогда 
				ПолучитьФайл(АдресВоВременномХранилище, Адрес, Истина);
			КонецЕсли;
			
		ИначеЕсли СтруктураНастроек.СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.Justin") 
			ИЛИ СтруктураНастроек.СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.Meest") Тогда
			
			СтруктураРеестра = eCommДоставкаСервер.ВернутьЗначенияРеквизитовСправочника(Реестр, Новый Структура("Идентификатор"));
			
			Адрес = "" + СтруктураРеестра.Идентификатор + ".pdf";
			
			АдресВоВременномХранилище = АдресПечатнойФормыУкрПочтаВоВременномХранилище(ПараметрКоманды);
			Если ЗначениеЗаполнено(АдресВоВременномХранилище) Тогда 
				ПолучитьФайл(АдресВоВременномХранилище, Адрес, Истина);
			КонецЕсли;
			
		КонецЕсли;
		
		Оповестить("ОбновитьСписокРеестров");
		
	Иначе
		
		Сообщить("Реестр не получен!!!");
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АдресПечатнойФормыУкрПочтаВоВременномХранилище(Реестр)

	Настройки = eCommДоставкаСервер.Настройки(Реестр.Владелец);
	Возврат Справочники.eComm_УчетныеЗаписиСлужбДоставки.ПечатьРеестра(Настройки, Реестр);

КонецФункции

&НаСервере
Функция УчетнаяЗапись(Реестр)

	Возврат Реестр.Владелец;

КонецФункции
