Функция НайтиАдрес(СтруктураАдреса)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_АдресаДоставки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_АдресаДоставки КАК eComm_АдресаДоставки
		|ГДЕ
		|	eComm_АдресаДоставки.Владелец = &УчетнаяЗапись
		|	И eComm_АдресаДоставки.ЭтоАдресОтделения = &ЭтоАдресОтделения
		|	И eComm_АдресаДоставки.Отделение = &Отделение
		|	И eComm_АдресаДоставки.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|			КОГДА &ЭтоАдресОтделения = ИСТИНА
		|				ТОГДА eComm_АдресаДоставки.Отделение = &Отделение
		|			КОГДА &ЭтоАдресОтделения = ЛОЖЬ
		|				ТОГДА eComm_АдресаДоставки.Регион = &Регион
		|						И eComm_АдресаДоставки.НаселенныйПункт = &НаселенныйПункт
		|						И eComm_АдресаДоставки.Улица = &Улица
		|						И eComm_АдресаДоставки.НомерДома = &НомерДома
		|						И eComm_АдресаДоставки.НомерКвартиры = &НомерКвартиры
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись"		, СтруктураАдреса.УчетнаяЗапись);
	Запрос.УстановитьПараметр("ЭтоАдресОтделения"	, СтруктураАдреса.ЭтоАдресОтделения);
	Запрос.УстановитьПараметр("Регион"				, СтруктураАдреса.Регион);
	Запрос.УстановитьПараметр("НаселенныйПункт"		, СтруктураАдреса.НаселенныйПункт);
	Запрос.УстановитьПараметр("Отделение"			, СтруктураАдреса.Отделение);
	Запрос.УстановитьПараметр("Улица"				, СтруктураАдреса.Улица);
	Запрос.УстановитьПараметр("НомерДома"			, СтруктураАдреса.НомерДома);
	Запрос.УстановитьПараметр("НомерКвартиры"		, СтруктураАдреса.НомерКвартиры);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат РезультатЗапроса.Ссылка;
	Иначе
