Функция Улица(НастройкиДоставки, УлицаСтрокой)

	Если ТипЗнч(УлицаСтрокой) = Тип("Строка") Тогда 
		
		Улица = СтрЗаменить(УлицаСтрокой, "вул.", "");
		Улица = СтрЗаменить(Улица, "ул.", "");
		
		Возврат СокрЛП(Улица);
		
	КонецЕсли;	

