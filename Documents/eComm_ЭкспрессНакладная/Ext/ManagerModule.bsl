Функция УлицаПоСправочнику(НаселенныйПункт, УлицаСтрокой)

	Если НЕ ЗначениеЗаполнено(НаселенныйПункт) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_Улицы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_Улицы КАК eComm_Улицы
		|ГДЕ
		|	eComm_Улицы.Владелец = &Владелец
		|	И (eComm_Улицы.Идентификатор = &УлицаСтрокой
		|			ИЛИ eComm_Улицы.НаименованиеRu = &УлицаСтрокой)";
	
	Запрос.УстановитьПараметр("Владелец", НаселенныйПункт);
	Запрос.УстановитьПараметр("УлицаСтрокой", УлицаСтрокой);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 1 
		И РезультатЗапроса.Следующий() Тогда 
		
		Возврат РезультатЗапроса.Ссылка;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

