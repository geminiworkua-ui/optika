
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Представление = ?(ЗначениеЗаполнено(Данные.НомерТТН), Данные.НомерТТН, НСтр("ru='Накладная не оформлена'; uk='Накладна не оформлена'"));
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("НомерТТН");
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

// Заполнение ЭН
Процедура ЗаполнитьПоОснованию(НастройкиДоставки, ЭкспрессНакладнаяОбъект, ПараметрыЗаказа) Экспорт

	ДокументОснование = ПараметрыЗаказа.Ссылка;
	
	Если ЗначениеЗаполнено(ПараметрыЗаказа.УчетнаяЗапись) Тогда 
		
		ЭкспрессНакладнаяОбъект.УчетнаяЗапись		= НастройкиДоставки.УчетнаяЗапись;
		ЭкспрессНакладнаяОбъект.ДокументОснование 	= ДокументОснование;

		ЗначенияПоУмолчанию = НастройкиДоставки.ДанныеЗаполнения;
		
		Если НЕ НастройкиДоставки.Настройки.ТипОтправки = "ЗаборПоАдресу" Тогда  
			// Отправка из отделения
			ЭтоАдреснаяОтправка = Ложь;
		Иначе  
			// Адресная отправка
			ЭтоАдреснаяОтправка = Истина;
		КонецЕсли;

		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "ТипПолучателя", ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "ФормаОплаты"	, ЗначенияПоУмолчанию);
				
		Если ЗначениеЗаполнено(ЗначенияПоУмолчанию.ВидПлательщика) Тогда
			ЭкспрессНакладнаяОбъект.ВидПлательщика = ЗначенияПоУмолчанию.ВидПлательщика;
		Иначе
			// Получатель
			ЭкспрессНакладнаяОбъект.ВидПлательщика = Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "Recipient", Справочники.eComm_ОбщиеСправочники.ВидыПлательщиков);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗначенияПоУмолчанию.ТипГруза) Тогда
			ЭкспрессНакладнаяОбъект.ТипГруза = ЗначенияПоУмолчанию.ТипГруза;
		Иначе
			// Посылка
			ЭкспрессНакладнаяОбъект.ТипГруза = Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "Parcel", Справочники.eComm_ОбщиеСправочники.ВидыГруза);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗначенияПоУмолчанию.ОписаниеГруза) Тогда
			ЭкспрессНакладнаяОбъект.ОписаниеГруза = ЗначенияПоУмолчанию.ОписаниеГруза;
		Иначе
			ЭкспрессНакладнаяОбъект.ОписаниеГруза = "Товары";
		КонецЕсли;
		
		Если НастройкиДоставки.Настройки.Свойство("ЗаполнятьОбщийВесОбъемПоЗаказу")
			И НастройкиДоставки.Настройки.ЗаполнятьОбщийВесОбъемПоЗаказу = Истина Тогда 
			// В таком случае вес/объем будет заполняться в момент выгрузки ЭН
			
		Иначе
			ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "Вес"					, ЗначенияПоУмолчанию);
			ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "Объем"				, ЗначенияПоУмолчанию);
			ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "МаксимальнаяСторона"	, ЗначенияПоУмолчанию);
		КонецЕсли;
		
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "Отправитель"					, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "НаселенныйПунктОтправителя"	, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "ОтделениеОтправителя"		, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "УлицаОтправителяСтрокой"		, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "НомерДомаОтправителя"		, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "НомерКвартирыОтправителя"	, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "АдресОтправителя"			, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "КонтактноеЛицоОтправителя"	, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "ТелефонОтправителя"			, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "ДействиеВСлучаеНевручения"	, ЗначенияПоУмолчанию);
		ЗаполнитьЗначениеПоУмолчанию(ЭкспрессНакладнаяОбъект, "ЗачислятьНаIBAN"				, ЗначенияПоУмолчанию);
	
		Если НастройкиДоставки.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта 
			И ЗначенияПоУмолчанию.Свойство("ДополнительныеУслуги") 
			И ТипЗнч(ЗначенияПоУмолчанию.ДополнительныеУслуги) = Тип("Массив") Тогда 
			
			Для Каждого ДопУслуга Из ЗначенияПоУмолчанию.ДополнительныеУслуги Цикл 
				НоваяДопУслуга = ЭкспрессНакладнаяОбъект.ДополнительныеУслуги.Добавить();
				НоваяДопУслуга.Услуга = ДопУслуга;
			КонецЦикла;
			
		КонецЕсли;
		
		Если НастройкиДоставки.Настройки.Свойство("ЗаполнятьДополнительнуюИнформациюПоЗаказу")
			И НастройкиДоставки.Настройки.ЗаполнятьДополнительнуюИнформациюПоЗаказу = Истина Тогда 
			// В таком случае доп. описание будет заполняться в момент выгрузки ЭН
			
		ИначеЕсли ЗначениеЗаполнено(ЗначенияПоУмолчанию.ДополнительнаяИнформация) Тогда
			ЭкспрессНакладнаяОбъект.ДополнительнаяИнформация = ЗначенияПоУмолчанию.ДополнительнаяИнформация;
		КонецЕсли;
		
		Если ТипЗнч(ПараметрыЗаказа) = Тип("Структура") Тогда 
			// Заполнение в момент получения заказа
			// На этом этапе имеем больше данных
			
			ЗаполнитьДанныеПолучателя(НастройкиДоставки, ПараметрыЗаказа, ЭкспрессНакладнаяОбъект);
			
		Иначе
			// Заполнение / перезаполнение по данным
			// заказа
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьДанныеПолучателя(НастройкиДоставки, ПараметрыЗаказа, ЭкспрессНакладнаяОбъект)

	Если НастройкиДоставки.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		ЗаполнитьДанныеПолучателяНоваяПочта(НастройкиДоставки, ПараметрыЗаказа, ЭкспрессНакладнаяОбъект);
	ИначеЕсли НастройкиДоставки.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		ЗаполнитьДанныеПолучателяУкрпочта(НастройкиДоставки, ПараметрыЗаказа, ЭкспрессНакладнаяОбъект);
	ИначеЕсли НастройкиДоставки.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда
		ЗаполнитьДанныеПолучателяJustin(НастройкиДоставки, ПараметрыЗаказа, ЭкспрессНакладнаяОбъект);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьДанныеПолучателяНоваяПочта(НастройкиДоставки, ПараметрыЗаказа, ЭкспрессНакладнаяОбъект)

	ЗначенияПоУмолчанию = НастройкиДоставки.ДанныеЗаполнения;
	
	Если НЕ НастройкиДоставки.Настройки.ТипОтправки = "ЗаборПоАдресу" Тогда  
		// Отправка из отделения
		ЭтоАдреснаяОтправка = Ложь;
	Иначе  
		// Адресная отправка
		ЭтоАдреснаяОтправка = Истина;
	КонецЕсли;
	
	КонтрагентДоставки = ПолучательЧастноеЛицо(НастройкиДоставки.УчетнаяЗапись);
	
	ЭкспрессНакладнаяОбъект.Получатель = КонтрагентДоставки;
	
	Если ЗначениеЗаполнено(КонтрагентДоставки) Тогда 
		
		СтруктураКонтактногоЛица = Новый Структура("КонтрагентДоставки, Фамилия, Имя, Отчество, Телефон");
		СтруктураКонтактногоЛица.Вставить("КонтрагентДоставки", КонтрагентДоставки);
		ЗаполнитьЗначенияСвойств(СтруктураКонтактногоЛица, ПараметрыЗаказа.Контакты);
		
		ЭкспрессНакладнаяОбъект.КонтактноеЛицоПолучателя = eCommДоставкаСервер.НайтиСоздатьКонтактноеЛицоКонтрагентаСлужбыДоставки(НастройкиДоставки, СтруктураКонтактногоЛица);
		
		ЭкспрессНакладнаяОбъект.ТелефонПолучателя = СтруктураКонтактногоЛица.Телефон;
		
	КонецЕсли;
	
	Если ПараметрыЗаказа.Доставка.Свойство("ИдОтделения") 
		И ЗначениеЗаполнено(ПараметрыЗаказа.Доставка.ИдОтделения) Тогда
		
		// Доставка в отделение
		ЭтоАдреснаяДоставка = Ложь;
		
		Если Лев(ПараметрыЗаказа.Доставка.ИдОтделения, 2) = "NP" Тогда 
			// С маркетплейса Allo.ua приходит не идентификатор отделения,
			// а ключ сайта с префиксом. Необходимо искать именно по нему
			ПоискПоИдентификатору 	= Ложь;
			ИдОтделения 			= СтрЗаменить(ПараметрыЗаказа.Доставка.ИдОтделения, "NP", "");
		Иначе
			// Со всех остальных маркетплейсов
			// ищем по идентификатору отделения
			ПоискПоИдентификатору 	= Истина;
			ИдОтделения 			= ПараметрыЗаказа.Доставка.ИдОтделения;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	eComm_ОтделенияДоставки.Владелец КАК НаселенныйПунктПолучателя,
			|	eComm_ОтделенияДоставки.Ссылка КАК ОтделениеПолучателя
			|ИЗ
			|	Справочник.eComm_ОтделенияДоставки КАК eComm_ОтделенияДоставки
			|ГДЕ
			|	ВЫБОР
			|			КОГДА &ПоискПоИдентификатору = ИСТИНА
			|				ТОГДА eComm_ОтделенияДоставки.Идентификатор = &Идентификатор
			|			ИНАЧЕ eComm_ОтделенияДоставки.Ключ = &Идентификатор
			|		КОНЕЦ";
		
		Запрос.УстановитьПараметр("ПоискПоИдентификатору"	, ПоискПоИдентификатору);
		Запрос.УстановитьПараметр("Идентификатор"			, ИдОтделения);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Следующий() Тогда 
			ЗаполнитьЗначенияСвойств(ЭкспрессНакладнаяОбъект, РезультатЗапроса);
		КонецЕсли;
		
	Иначе
		
		// Адресная доставка
		ЭтоАдреснаяДоставка = Истина;
		
		Если ЗначениеЗаполнено(ПараметрыЗаказа.Доставка.Улица) Тогда
			
			ЭкспрессНакладнаяОбъект.НаселенныйПунктПолучателя 	= НаселенныйПункт(НастройкиДоставки, ПараметрыЗаказа.Доставка.Город);
			ЭкспрессНакладнаяОбъект.УлицаПолучателяСтрокой		= ПараметрыЗаказа.Доставка.Улица;
			
			УлицаСсылка = УлицаПоСправочнику(ЭкспрессНакладнаяОбъект.НаселенныйПунктПолучателя, ПараметрыЗаказа.Доставка.Улица);
			Если ЗначениеЗаполнено(УлицаСсылка) Тогда 
				ЭкспрессНакладнаяОбъект.УлицаПолучателя = УлицаСсылка;
			Иначе
				ЭкспрессНакладнаяОбъект.ИспользоватьУлицаПолучателяСтрокой = Истина;
			КонецЕсли;
			
			ЭкспрессНакладнаяОбъект.НомерДомаПолучателя 		= ПараметрыЗаказа.Доставка.НомерДома;
			ЭкспрессНакладнаяОбъект.НомерКвартирыПолучателя 	= ПараметрыЗаказа.Доставка.НомерКвартиры;
			
		Иначе
			// Вероятно в формате:
			// Харьков, ул. Хмельницького Богдана пров., дом. 432, кв. 91
			МассивПодстрокАдреса = eCommДоставкаСервер.РазложитьСтрокуВМассивПодстрок(ПараметрыЗаказа.Доставка.Город, ",", Истина);
			Если МассивПодстрокАдреса.Количество() > 0 Тогда 
				ЭкспрессНакладнаяОбъект.НаселенныйПунктПолучателя = НаселенныйПункт(НастройкиДоставки, МассивПодстрокАдреса[0]);
			КонецЕсли;
			
			УлицаСсылка = УлицаПоСправочнику(ЭкспрессНакладнаяОбъект.НаселенныйПунктПолучателя, ПараметрыЗаказа.Доставка.Улица);
			Если ЗначениеЗаполнено(УлицаСсылка) Тогда 
				ЭкспрессНакладнаяОбъект.УлицаПолучателя = УлицаСсылка;
			Иначе
				ЭкспрессНакладнаяОбъект.ИспользоватьУлицаПолучателяСтрокой = Истина;
			КонецЕсли;
			
			Если МассивПодстрокАдреса.Количество() > 1 Тогда
				ЭкспрессНакладнаяОбъект.УлицаПолучателяСтрокой = Улица(НастройкиДоставки, МассивПодстрокАдреса[1]);
			КонецЕсли;
			Если МассивПодстрокАдреса.Количество() > 2 Тогда
				ЭкспрессНакладнаяОбъект.НомерДомаПолучателя = Дом(НастройкиДоставки, МассивПодстрокАдреса[2]);
			КонецЕсли;
			Если МассивПодстрокАдреса.Количество() > 3 Тогда
				ЭкспрессНакладнаяОбъект.НомерКвартирыПолучателя = НомерКвартиры(НастройкиДоставки, МассивПодстрокАдреса[3]);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// Оплата 
	НаложенныйПлатеж = ПараметрыЗаказа.Оплата.НаложенныйПлатеж = Истина;
	Если НаложенныйПлатеж Тогда 
		// Сумму заказа и доставку оплачивает покупатель
		
		ТипПостОплаты = Неопределено;
		НастройкиДоставки.Настройки.Свойство("ТипПостОплаты", ТипПостОплаты);
		
		Если ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.КонтрольОплаты Тогда
			// Это контроль оплаты
			//ЭкспрессНакладнаяОбъект.КонтрольОплаты 	= ДокументОснование.СуммаДокумента;
			ЭкспрессНакладнаяОбъект.ТипПостОплаты	= ТипПостОплаты;
		Иначе
			// Это денежный перевод
			ЭкспрессНакладнаяОбъект.ТипПостОплаты 			= Справочники.eComm_ОбщиеСправочники.ДенежныйПеревод;
			//ЭкспрессНакладнаяОбъект.ОбратнаяДоставкаСумма 	= ДокументОснование.СуммаДокумента;
			
			Если ЗначениеЗаполнено(ЗначенияПоУмолчанию.ОбратнаяДоставкаВидГруза) Тогда 
				ЭкспрессНакладнаяОбъект.ОбратнаяДоставкаВидГруза = ЗначенияПоУмолчанию.ОбратнаяДоставкаВидГруза;
			Иначе
				ЭкспрессНакладнаяОбъект.ОбратнаяДоставкаВидГруза = Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "Money", Справочники.eComm_ОбщиеСправочники.ВидыОбратнойДоставкиГруза);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЗначенияПоУмолчанию.ОбратнаяДоставкаВидПлательщика) Тогда 
				ЭкспрессНакладнаяОбъект.ОбратнаяДоставкаВидПлательщика = ЗначенияПоУмолчанию.ОбратнаяДоставкаВидПлательщика;
			Иначе
				ЭкспрессНакладнаяОбъект.ОбратнаяДоставкаВидПлательщика = Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "Recipient", Справочники.eComm_ОбщиеСправочники.ВидыПлательщиковОбратнойДоставки);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЭкспрессНакладнаяОбъект.ТехнологияДоставки = ТехнологияДоставки(ЭтоАдреснаяОтправка, ЭтоАдреснаяДоставка);

КонецПроцедуры

Процедура ЗаполнитьДанныеПолучателяУкрпочта(НастройкиДоставки, ПараметрыЗаказа, ЭкспрессНакладнаяОбъект)

	ЗначенияПоУмолчанию = НастройкиДоставки.ДанныеЗаполнения;
	
	Если НЕ НастройкиДоставки.Настройки.ТипОтправки = "ЗаборПоАдресу" Тогда  
		// Отправка из отделения
		ЭтоАдреснаяОтправка = Ложь;
	Иначе  
		// Адресная отправка
		ЭтоАдреснаяОтправка = Истина;
	КонецЕсли;
	
	ЭтоДоставкаВОтделение = Истина;
	
	Если ПараметрыЗаказа.Доставка.Свойство("ЭтоАдреснаяДоставка") Тогда 
		
		Если ПараметрыЗаказа.Доставка.ЭтоАдреснаяДоставка = Истина Тогда
			ЭтоДоставкаВОтделение = Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыЗаказа.Доставка.НомерОтделения) Тогда 
			// Заказ с Rozetka.ua
			ИндексПолучателя = ПараметрыЗаказа.Доставка.НомерОтделения;
		Иначе
			ИндексПолучателя = eCommДоставкаСервер.ИндексИзСтроки(ПараметрыЗаказа.Доставка.Улица);
			Если НЕ ЗначениеЗаполнено(ИндексПолучателя) Тогда 
				ИндексПолучателя = eCommДоставкаСервер.ИндексИзСтроки(ПараметрыЗаказа.Доставка.Город);
			КонецЕсли;
			//++
			Если НЕ ЗначениеЗаполнено(ИндексПолучателя)
				И ПараметрыЗаказа.Доставка.Свойство("ИдОтделения") 
				И ЗначениеЗаполнено(ПараметрыЗаказа.Доставка.ИдОтделения) Тогда 
				ИндексПолучателя = ПараметрыЗаказа.Доставка.ИдОтделения;
			КонецЕсли
			//--
		КонецЕсли;
		
	Иначе
		// Заказ с других маркетплейсов
		
		ИндексПолучателя = eCommДоставкаСервер.ИндексИзСтроки(ПараметрыЗаказа.Доставка.Улица);
		
	КонецЕсли;
	
	СтруктураАдреса = Новый Структура();
	СтруктураАдреса.Вставить("ЭтоАдресОтделения", ЭтоДоставкаВОтделение);
	СтруктураАдреса.Вставить("УчетнаяЗапись"	, НастройкиДоставки.УчетнаяЗапись);
	СтруктураАдреса.Вставить("Регион"			, Справочники.eComm_РегионыДоставки.ПустаяСсылка());
	СтруктураАдреса.Вставить("Район"			, Справочники.eComm_РайоныДоставки.ПустаяСсылка());
	СтруктураАдреса.Вставить("НаселенныйПункт"	, Справочники.eComm_НаселенныеПунктыДоставки.ПустаяСсылка());
	СтруктураАдреса.Вставить("Отделение"		, Справочники.eComm_ОтделенияДоставки.ПустаяСсылка());
	СтруктураАдреса.Вставить("Улица"			, "");
	СтруктураАдреса.Вставить("НомерДома"		, "");
	СтруктураАдреса.Вставить("НомерКвартиры"	, "");
	СтруктураАдреса.Вставить("ПочтовыйИндекс"	, ИндексПолучателя);

	Если ЭтоДоставкаВОтделение = Истина Тогда 
		// Доставка в отделение
		ЭтоАдреснаяДоставка = Ложь;
		
		ОтделениеДоставки = ОтделениеДоставки(ИндексПолучателя);
		
		СтруктураАдреса.Вставить("ЭтоАдресОтделения", ЭтоДоставкаВОтделение);
		СтруктураАдреса.Вставить("Отделение"		, ОтделениеДоставки);
		СтруктураАдреса.Вставить("НаселенныйПункт"	, СтруктураАдреса.Отделение.Владелец);
		СтруктураАдреса.Вставить("Регион"			, СтруктураАдреса.НаселенныйПункт.Владелец);
		СтруктураАдреса.Вставить("Район"			, СтруктураАдреса.НаселенныйПункт.Район);
		
	Иначе
		
		// Адресная доставка
		ЭтоАдреснаяДоставка = Истина;
		
		// Вероятно в формате:
		// Харьков, ул. Хмельницького Богдана пров., дом. 432, кв. 91
		Если ЗначениеЗаполнено(ПараметрыЗаказа.Доставка.Улица) Тогда
			
			СтруктураАдреса.НаселенныйПункт = НаселенныйПункт(НастройкиДоставки, ПараметрыЗаказа.Доставка.Город);
			
			Если ЗначениеЗаполнено(СтруктураАдреса.НаселенныйПункт) Тогда 
				СтруктураАдреса.Регион			= СтруктураАдреса.НаселенныйПункт.Владелец;
				СтруктураАдреса.Район			= СтруктураАдреса.НаселенныйПункт.Район;
				СтруктураАдреса.Улица 			= ПараметрыЗаказа.Доставка.Улица;
				СтруктураАдреса.НомерДома 		= ПараметрыЗаказа.Доставка.НомерДома;
				СтруктураАдреса.НомерКвартиры 	= ПараметрыЗаказа.Доставка.НомерКвартиры;
			Иначе
				ЗаписьЖурналаРегистрации("eComm.Укрпочта.ПоискНаселенногоПункта", , , , "Населенный пункт """ + ПараметрыЗаказа.Доставка.Город + """ не найден");
			КонецЕсли;
			
		Иначе
			
			МассивПодстрокАдреса = eCommДоставкаСервер.РазложитьСтрокуВМассивПодстрок(ПараметрыЗаказа.Доставка.Город, ",", Истина);
			Если МассивПодстрокАдреса.Количество() > 0 Тогда 
				СтруктураАдреса.НаселенныйПункт = НаселенныйПункт(НастройкиДоставки, МассивПодстрокАдреса[0]);
				СтруктураАдреса.Регион			= СтруктураАдреса.НаселенныйПункт.Владелец;
				СтруктураАдреса.Район			= СтруктураАдреса.НаселенныйПункт.Район;
			КонецЕсли;
			Если МассивПодстрокАдреса.Количество() > 1 Тогда
				СтруктураАдреса.Улица = Улица(НастройкиДоставки, МассивПодстрокАдреса[1]);
			КонецЕсли;
			Если МассивПодстрокАдреса.Количество() > 2 Тогда
				СтруктураАдреса.НомерДома = Дом(НастройкиДоставки, МассивПодстрокАдреса[2]);
			КонецЕсли;
			Если МассивПодстрокАдреса.Количество() > 3 Тогда
				СтруктураАдреса.НомерКвартиры = НомерКвартиры(НастройкиДоставки, МассивПодстрокАдреса[3]);
			КонецЕсли;    
			
		КонецЕсли;
		
	КонецЕсли;
	
	АдресДоставки = НайтиАдрес(СтруктураАдреса);
	
	Если НЕ ЗначениеЗаполнено(АдресДоставки) Тогда 
		
		АдресДоставкиОбъект = Справочники.eComm_АдресаДоставки.СоздатьЭлемент();
		АдресДоставкиОбъект.Владелец = НастройкиДоставки.УчетнаяЗапись;
		ЗаполнитьЗначенияСвойств(АдресДоставкиОбъект, СтруктураАдреса);
		АдресДоставкиОбъект.Записать();
		
		АдресДоставки = АдресДоставкиОбъект.Ссылка;
		
	КонецЕсли;

	
	// Оплата 
	НаложенныйПлатеж = ПараметрыЗаказа.Оплата.НаложенныйПлатеж = Истина;
	Если НаложенныйПлатеж Тогда 
		// Сумму заказа и доставку оплачивает покупатель
		
		ЭкспрессНакладнаяОбъект.ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.ПостОплатаУкрПочта;
		
	КонецЕсли;
	
	ЭкспрессНакладнаяОбъект.ТехнологияДоставки = ТехнологияДоставки(ЭтоАдреснаяОтправка, ЭтоАдреснаяДоставка);

	КонтрагентДоставки = ПолучательЧастноеЛицо(НастройкиДоставки.УчетнаяЗапись);
	
	ЭкспрессНакладнаяОбъект.Получатель = КонтрагентДоставки;
	
	Если ЗначениеЗаполнено(КонтрагентДоставки) Тогда 
		
		СтруктураКонтактногоЛица = Новый Структура("КонтрагентДоставки, Фамилия, Имя, Отчество, Телефон");
		СтруктураКонтактногоЛица.Вставить("КонтрагентДоставки", КонтрагентДоставки);
		ЗаполнитьЗначенияСвойств(СтруктураКонтактногоЛица, ПараметрыЗаказа.Контакты);
		СтруктураКонтактногоЛица.Вставить("АдресДоставки", АдресДоставки);
		
		ЭкспрессНакладнаяОбъект.КонтактноеЛицоПолучателя = eCommДоставкаСервер.НайтиСоздатьКонтактноеЛицоКонтрагентаСлужбыДоставки(НастройкиДоставки, СтруктураКонтактногоЛица);
		
		Если НЕ АдресПринадлежитКлиенту(ЭкспрессНакладнаяОбъект.КонтактноеЛицоПолучателя, АдресДоставки) Тогда 
			КонтактноеЛицоОбъект = ЭкспрессНакладнаяОбъект.КонтактноеЛицоПолучателя.ПолучитьОбъект();
			НовАдр = КонтактноеЛицоОбъект.Адреса.Добавить();
			НовАдр.Адрес = АдресДоставки;
			КонтактноеЛицоОбъект.Записать();
		КонецЕсли;
		
		ЭкспрессНакладнаяОбъект.ТелефонПолучателя = СтруктураКонтактногоЛица.Телефон;
		
	КонецЕсли;
	
	ЭкспрессНакладнаяОбъект.АдресПолучателя = АдресДоставки;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПолучателяJustin(НастройкиДоставки, ПараметрыЗаказа, ЭкспрессНакладнаяОбъект)

	ЗначенияПоУмолчанию = НастройкиДоставки.ДанныеЗаполнения;
	
	Если НЕ НастройкиДоставки.Настройки.ТипОтправки = "ЗаборПоАдресу" Тогда  
		// Отправка из отделения
		ЭтоАдреснаяОтправка = Ложь;
	Иначе  
		// Адресная отправка
		ЭтоАдреснаяОтправка = Истина;
	КонецЕсли;
	
	КонтрагентДоставки = ПолучательЧастноеЛицо(НастройкиДоставки.УчетнаяЗапись);
	
	ЭкспрессНакладнаяОбъект.Получатель = КонтрагентДоставки;
	
	Если ЗначениеЗаполнено(КонтрагентДоставки) Тогда 
		
		СтруктураКонтактногоЛица = Новый Структура("КонтрагентДоставки, Фамилия, Имя, Отчество, Телефон");
		СтруктураКонтактногоЛица.Вставить("КонтрагентДоставки", КонтрагентДоставки);
		ЗаполнитьЗначенияСвойств(СтруктураКонтактногоЛица, ПараметрыЗаказа.Контакты);
		
		ЭкспрессНакладнаяОбъект.КонтактноеЛицоПолучателя = eCommДоставкаСервер.НайтиСоздатьКонтактноеЛицоКонтрагентаСлужбыДоставки(НастройкиДоставки, СтруктураКонтактногоЛица);
		
		ЭкспрессНакладнаяОбъект.ТелефонПолучателя = СтруктураКонтактногоЛица.Телефон;
		
	КонецЕсли;
	
	Если ПараметрыЗаказа.Доставка.Свойство("ИдОтделения") 
		И ЗначениеЗаполнено(ПараметрыЗаказа.Доставка.ИдОтделения) Тогда
		
		// Доставка в отделение
		ЭтоАдреснаяДоставка = Ложь;
		
		Если Лев(ПараметрыЗаказа.Доставка.ИдОтделения, 2) = "NP" Тогда 
			// С маркетплейса Allo.ua приходит не идентификатор отделения,
			// а ключ сайта с префиксом. Необходимо искать именно по нему
			ПоискПоИдентификатору 	= Ложь;
			ИдОтделения 			= СтрЗаменить(ПараметрыЗаказа.Доставка.ИдОтделения, "NP", "");
			
		ИначеЕсли ПараметрыЗаказа.Свойство("ТорговаяПлощадка")
			И (ПараметрыЗаказа.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka 
				ИЛИ ПараметрыЗаказа.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom) Тогда 
			
			ПоискПоИдентификатору 	= Ложь;
			ИдОтделения 			= ПараметрыЗаказа.Доставка.ИдОтделения;
	
		Иначе
			// Со всех остальных маркетплейсов
			// ищем по идентификатору отделения
			ПоискПоИдентификатору 	= Истина;
			ИдОтделения 			= ПараметрыЗаказа.Доставка.ИдОтделения;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	eComm_ОтделенияДоставки.Владелец КАК НаселенныйПунктПолучателя,
			|	eComm_ОтделенияДоставки.Ссылка КАК ОтделениеПолучателя
			|ИЗ
			|	Справочник.eComm_ОтделенияДоставки КАК eComm_ОтделенияДоставки
			|ГДЕ
			|	ВЫБОР
			|			КОГДА &ПоискПоИдентификатору = ИСТИНА
			|				ТОГДА eComm_ОтделенияДоставки.Идентификатор = &Идентификатор
			|			ИНАЧЕ eComm_ОтделенияДоставки.Ключ = &Идентификатор
			|		КОНЕЦ";
		
		Запрос.УстановитьПараметр("ПоискПоИдентификатору"	, ПоискПоИдентификатору);
		Запрос.УстановитьПараметр("Идентификатор"			, ИдОтделения);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Следующий() Тогда 
			ЗаполнитьЗначенияСвойств(ЭкспрессНакладнаяОбъект, РезультатЗапроса);
		КонецЕсли;
		
	Иначе
		
		// Адресная доставка
		ЭтоАдреснаяДоставка = Истина;
		
		// Вероятно в формате:
		// Харьков, ул. Хмельницького Богдана пров., дом. 432, кв. 91
		Если ЗначениеЗаполнено(ПараметрыЗаказа.Доставка.Улица) Тогда
			
			ЭкспрессНакладнаяОбъект.НаселенныйПунктПолучателя 	= НаселенныйПункт(НастройкиДоставки, ПараметрыЗаказа.Доставка.Город);
			ЭкспрессНакладнаяОбъект.УлицаПолучателяСтрокой		= ПараметрыЗаказа.Доставка.Улица;
			ЭкспрессНакладнаяОбъект.НомерДомаПолучателя 		= ПараметрыЗаказа.Доставка.НомерДома;
			ЭкспрессНакладнаяОбъект.НомерКвартирыПолучателя 	= ПараметрыЗаказа.Доставка.НомерКвартиры;
			
		Иначе
			
			МассивПодстрокАдреса = eCommДоставкаСервер.РазложитьСтрокуВМассивПодстрок(ПараметрыЗаказа.Доставка.Город, ",", Истина);
			Если МассивПодстрокАдреса.Количество() > 0 Тогда 
				ЭкспрессНакладнаяОбъект.НаселенныйПунктПолучателя = НаселенныйПункт(НастройкиДоставки, МассивПодстрокАдреса[0]);
			КонецЕсли;
			Если МассивПодстрокАдреса.Количество() > 1 Тогда
				ЭкспрессНакладнаяОбъект.УлицаПолучателяСтрокой = Улица(НастройкиДоставки, МассивПодстрокАдреса[1]);
			КонецЕсли;
			Если МассивПодстрокАдреса.Количество() > 2 Тогда
				ЭкспрессНакладнаяОбъект.НомерДомаПолучателя = Дом(НастройкиДоставки, МассивПодстрокАдреса[2]);
			КонецЕсли;
			Если МассивПодстрокАдреса.Количество() > 3 Тогда
				ЭкспрессНакладнаяОбъект.НомерКвартирыПолучателя = НомерКвартиры(НастройкиДоставки, МассивПодстрокАдреса[3]);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// Оплата 
	НаложенныйПлатеж = ПараметрыЗаказа.Оплата.НаложенныйПлатеж = Истина;
	Если НаложенныйПлатеж Тогда 
		// Сумму заказа и доставку оплачивает покупатель
		
		ЭкспрессНакладнаяОбъект.ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.ПостОплатаУкрПочта;
		
		Если ЗначениеЗаполнено(ЗначенияПоУмолчанию.ОбратнаяДоставкаВидПлательщика) Тогда 
			ЭкспрессНакладнаяОбъект.ОбратнаяДоставкаВидПлательщика = ЗначенияПоУмолчанию.ОбратнаяДоставкаВидПлательщика;
		Иначе
			ЭкспрессНакладнаяОбъект.ОбратнаяДоставкаВидПлательщика = Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "Recipient", Справочники.eComm_ОбщиеСправочники.ВидыПлательщиковОбратнойДоставки);
		КонецЕсли;

	КонецЕсли;
	
	ЭкспрессНакладнаяОбъект.ТехнологияДоставки = ТехнологияДоставки(ЭтоАдреснаяОтправка, ЭтоАдреснаяДоставка);

КонецПроцедуры

// Общие справочники
Функция ТехнологияДоставки(ЭтоАдреснаяОтправка, ЭтоАдреснаяДоставка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ОбщиеСправочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_ОбщиеСправочники КАК eComm_ОбщиеСправочники
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ЭтоАдреснаяОтправка = ИСТИНА
		|					И &ЭтоАдреснаяДоставка = ИСТИНА
		|				ТОГДА eComm_ОбщиеСправочники.Идентификатор = ""DoorsDoors""
		|			КОГДА &ЭтоАдреснаяОтправка = ИСТИНА
		|					И &ЭтоАдреснаяДоставка = ЛОЖЬ
		|				ТОГДА eComm_ОбщиеСправочники.Идентификатор = ""DoorsWarehouse""
		|			КОГДА &ЭтоАдреснаяОтправка = ЛОЖЬ
		|					И &ЭтоАдреснаяДоставка = ИСТИНА
		|				ТОГДА eComm_ОбщиеСправочники.Идентификатор = ""WarehouseDoors""
		|			КОГДА &ЭтоАдреснаяОтправка = ЛОЖЬ
		|					И &ЭтоАдреснаяДоставка = ЛОЖЬ
		|				ТОГДА eComm_ОбщиеСправочники.Идентификатор = ""WarehouseWarehouse""
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ЭтоАдреснаяОтправка", ЭтоАдреснаяОтправка);
	Запрос.УстановитьПараметр("ЭтоАдреснаяДоставка", ЭтоАдреснаяДоставка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат РезультатЗапроса.Ссылка;
