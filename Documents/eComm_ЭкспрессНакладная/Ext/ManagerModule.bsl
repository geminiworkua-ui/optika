Функция НаселенныйПункт(НастройкиДоставки, НаселенныйПунктСтрокой)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_НаселенныеПунктыДоставки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_НаселенныеПунктыДоставки КАК eComm_НаселенныеПунктыДоставки
		|ГДЕ
		|	(eComm_НаселенныеПунктыДоставки.Наименование = &Наименование
		|			ИЛИ eComm_НаселенныеПунктыДоставки.НаименованиеRu = &Наименование)
		|	И eComm_НаселенныеПунктыДоставки.СлужбаДоставки = &СлужбаДоставки
		|	И eComm_НаселенныеПунктыДоставки.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Наименование"	, НаселенныйПунктСтрокой);
	Запрос.УстановитьПараметр("СлужбаДоставки"	, НастройкиДоставки.УчетнаяЗапись.СлужбаДоставки);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() 
		И РезультатЗапроса.Количество() = 1 Тогда 
		// Интересуют только однозначно идентифицированные
		// населенные пункты
		
		Возврат РезультатЗапроса.Ссылка;
		
	КонецЕсли;

	Возврат Неопределено;
	
