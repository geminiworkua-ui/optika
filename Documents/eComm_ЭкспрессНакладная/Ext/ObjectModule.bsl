
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	СлужбаДоставки = УчетнаяЗапись.СлужбаДоставки;
	
	Если ЗначениеЗаполнено(ДокументОснование)
		И СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
		// Очистим идентификатор (используется для удаления и печати ЭН)
		// если заказ изменился
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЭкспрессНакладная.ДокументОснование КАК ДокументОснование
			|ИЗ
			|	Документ.eComm_ЭкспрессНакладная КАК ЭкспрессНакладная
			|ГДЕ
			|	ЭкспрессНакладная.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Следующий()
			И ЗначениеЗаполнено(РезультатЗапроса.ДокументОснование)
			И НЕ РезультатЗапроса.ДокументОснование = ДокументОснование Тогда 
			Идентификатор = "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	НомерТТН 			= "";
	Идентификатор 		= "";
	ИдентификаторМеста 	= "";
	ПрогнозируемаяДатаДоставки 	= Неопределено;
	СтоимостьДоставки 			= Неопределено;
	Для Каждого Стр Из Места Цикл 
		Стр.Идентификатор = "";
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ИмяОбъектаЗаказ = eCommДоставкаСервер.ВернутьИмяПрикладногоОбъекта("ЗаказКлиента");
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка." + ИмяОбъектаЗаказ) Тогда 
		
				
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда 
		
		Если НЕ ДанныеЗаполнения.Свойство("СтруктураНастроек")
			ИЛИ НЕ ДанныеЗаполнения.Свойство("ПараметрыДоставки") Тогда 
			Возврат;
		КонецЕсли;
		
		//ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.СтруктураНастроек);
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.ПараметрыДоставки);
		//ЭтоАдреснаяОтправка = Ложь;
		//Если НЕ ЭтоАдреснаяОтправка Тогда 
		//	
		//КонецЕсли;
		//
		//// Получатель
		
		
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ТипПостОплаты)
		И ЗначениеЗаполнено(СуммаПостОплаты) Тогда 
		// Это пост-оплата и сумма пост-оплаты установлена вручную
		// Убедимся что пост-оплата не превышает объявленную стоимость
		
		Если ЗначениеЗаполнено(ОбъявленнаяСтоимость) Тогда
			// Объявленная стоимость установлена вручную
			
			Если СуммаПостОплаты > ОбъявленнаяСтоимость Тогда 
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = НСтр("ru = 'Сумма пост-оплаты не может быть больше объявленной стоимости!'; uk = 'Сума пос-оплати не може бути більшою за оголошену вартість!'");
				Сообщение.УстановитьДанные(ЭтотОбъект);
				
				Сообщение.Сообщить();
				
				Отказ = Истина;
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ДокументОснование) Тогда 
			// Объявленная стоимость "по умолчанию"
			
			Если СуммаПостОплаты > eCommДоставкаСервер.СуммаЗаказа(ДокументОснование) Тогда 
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = НСтр("ru = 'Сумма пост-оплаты не может быть больше объявленной стоимости!'; uk = 'Сума пос-оплати не може бути більшою за оголошену вартість!'");
				Сообщение.УстановитьДанные(ЭтотОбъект);
				
				Сообщение.Сообщить();
				
				Отказ = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)    
СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(УчетнаяЗапись);
	
eCommДоставкаСервер.ЗарегистирироватьЕН(СтруктураНастроек, ЭтотОбъект, Отказ);	
Если Отказ Тогда
	Сообщить("Ошибка регистрации ЕН");
КонецЕсли;	
КонецПроцедуры



