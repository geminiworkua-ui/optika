
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Места") Тогда 
		Для Каждого СтруктураМеста Из Параметры.Места Цикл 
			ЗаполнитьЗначенияСвойств(Места.Добавить(), СтруктураМеста);
		КонецЦикла;
	КонецЕсли;
	
	Параметры.Свойство("СлужбаДоставки"			, СлужбаДоставки);
	Параметры.Свойство("ОбъявленнаяСтоимость"	, ОбъявленнаяСтоимость);
	
	Если Места.Итог("ОбъявленнаяСтоимость") = 0 Тогда 
		// Автоматическй расчет
		ПересчитатьОбъявленнуюСтоимостьАвто();
	Иначе
		// Ручной расчет
		РаспределитьВручную = Истина;
		УстановитьДоступность();
	КонецЕсли;
	
	УстановитьВидимсть();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		
		ПроверяемыеРеквизиты.Добавить("Места.ОбъявленнаяСтоимость");
		
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ОК(Команда)
	
	Если НЕ ПроверитьЗаполнениеНаСервере() Тогда 
		Возврат;
	КонецЕсли;
	
	СписокМест = Новый Массив;
	Для Каждого Стр Из Места Цикл 
		СписокМест.Добавить(Новый Структура("Вес, Длина, Ширина, Высота, Объем, Идентификатор, ОбъявленнаяСтоимость", Стр.Вес, Стр.Длина, Стр.Ширина, Стр.Высота, Стр.Объем, Стр.Идентификатор, ?(РаспределитьВручную = Истина, Стр.ОбъявленнаяСтоимость, 0)));
	КонецЦикла;
	
	ПараметрыЗакрытия = Новый Структура("Места, ОбъявленнаяСтоимость", СписокМест, Места.Итог("ОбъявленнаяСтоимость"));
	
	Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура МестаДШВПриИзменении(Элемент)
	
	ТекДанные = Элементы.Места.ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено Тогда 
		ТекДанные.Объем = ТекДанные.Длина * ТекДанные.Ширина * ТекДанные.Высота / 1000000;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МестаОбъявленнаяСтоимостьПриИзменении(Элемент)
	
	ОбъявленнаяСтоимость = Места.Итог("ОбъявленнаяСтоимость");
	
КонецПроцедуры

&НаКлиенте
Процедура МестаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ПересчитатьОбъявленнуюСтоимостьАвто();
КонецПроцедуры

&НаКлиенте
Процедура МестаПослеУдаления(Элемент)
	ПересчитатьОбъявленнуюСтоимостьАвто();
КонецПроцедуры

&НаКлиенте
Процедура ОбъявленнаяСтоимостьПриИзменении(Элемент)
	ПересчитатьОбъявленнуюСтоимостьАвто();
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьВручнуюПриИзменении(Элемент)
	УстановитьДоступность();
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ

&НаСервере
Процедура УстановитьВидимсть()

	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта
		ИЛИ СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		Элементы.МестаОбъявленнаяСтоимость.Видимость 	= Истина;
		Элементы.ГруппаОбъявленнаяСтоимость.Видимость 	= Истина;
		Элементы.МестаОбъем.Видимость 					= Ложь;
	Иначе
		Элементы.МестаОбъявленнаяСтоимость.Видимость 	= Ложь;
		Элементы.ГруппаОбъявленнаяСтоимость.Видимость 	= Ложь;
		Элементы.МестаОбъем.Видимость 					= Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность()

	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта
		ИЛИ СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		Элементы.МестаОбъявленнаяСтоимость.ТолькоПросмотр = НЕ РаспределитьВручную;
		Элементы.ОбъявленнаяСтоимость.ТолькоПросмотр = РаспределитьВручную;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьОбъявленнуюСтоимостьАвто()

	Если РаспределитьВручную Тогда 
		Возврат;
	КонецЕсли;
	
	КоличествоМест 	= Места.Количество();
	
	Если КоличествоМест = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СредняяОбъявленнаяСтоимостьМеста 	= Окр(ОбъявленнаяСтоимость / КоличествоМест, 0);
	ОбъявленнаяСтоимостьОтраженная 		= 0;
	СчетчикМест 						= 0;
	
	Для Каждого Место Из Места Цикл
		
		СчетчикМест = СчетчикМест + 1;
		
		Если СчетчикМест = КоличествоМест Тогда 
			// На последнее место отражаем остаток суммы
			Место.ОбъявленнаяСтоимость = ОбъявленнаяСтоимость - ОбъявленнаяСтоимостьОтраженная;
		Иначе
			// На первые места отражаем среднюю объявленную стоимость места
			Место.ОбъявленнаяСтоимость 		= СредняяОбъявленнаяСтоимостьМеста;
			ОбъявленнаяСтоимостьОтраженная 	= ОбъявленнаяСтоимостьОтраженная + Место.ОбъявленнаяСтоимость;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПроверитьЗаполнениеНаСервере()

	Возврат ПроверитьЗаполнение();

КонецФункции



