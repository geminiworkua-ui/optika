
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ЭН", ЭкспрессНакладная);
	
	СтруктураЭН 			= Новый Структура("Дата, УчетнаяЗапись, Отправитель, КонтактноеЛицоОтправителя, ОтделениеОтправителя, ТипГруза");
	ЗначенияРеквизитовЭН 	= eCommДоставкаСервер.ВернутьЗначенияРеквизитовДокумента(ЭкспрессНакладная, СтруктураЭН);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураЭН);
	
	Настройки 			= eCommДоставкаСервер.Настройки(УчетнаяЗапись);
	ИспользоватьРеестры = Настройки.Настройки.ИспользоватьРеестры;
	
	Если ИспользоватьРеестры = Истина Тогда 
		// Подберем реестр из созданных.
		// Если таких нет - предложим создать новый
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	eComm_Реестры.Ссылка КАК Ссылка,
			|	eComm_Реестры.Наименование КАК Наименование
			|ИЗ
			|	Справочник.eComm_Реестры КАК eComm_Реестры
			|ГДЕ
			|	eComm_Реестры.Владелец = &УчетнаяЗапись
			|	И eComm_Реестры.Отправитель = &Отправитель
			|	И eComm_Реестры.КонтактноеЛицоОтправителя = &КонтактноеЛицоОтправителя
			//++
			|	И eComm_Реестры.ОтделениеОтправителя = &ОтделениеОтправителя
			//|	И ВЫБОР
			//|			КОГДА eComm_Реестры.Владелец.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Укрпочта)
			//|				ТОГДА ИСТИНА
			//|			ИНАЧЕ eComm_Реестры.ОтделениеОтправителя = &ОтделениеОтправителя
			//|		КОНЕЦ
            //--
			//|	И eComm_Реестры.Дата = &Дата
			|	И ВЫБОР
			|			КОГДА eComm_Реестры.Владелец.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.НоваяПочта)
			|				ТОГДА ИСТИНА
			|			КОГДА eComm_Реестры.Владелец.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Укрпочта)
			|				ТОГДА eComm_Реестры.Тип = &ТипГруза
			|			КОГДА eComm_Реестры.Владелец.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Justin)
			|				ТОГДА ИСТИНА
			|			КОГДА eComm_Реестры.Владелец.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Meest)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ
			|	И eComm_Реестры.ПометкаУдаления = ЛОЖЬ
			|	И eComm_Реестры.Распечатан = ЛОЖЬ
			|
			|УПОРЯДОЧИТЬ ПО
			|	eComm_Реестры.Дата УБЫВ,
			|	eComm_Реестры.Ссылка";
		
		Запрос.УстановитьПараметр("Дата"						, Дата);
		Запрос.УстановитьПараметр("УчетнаяЗапись"				, УчетнаяЗапись);
		Запрос.УстановитьПараметр("ТипГруза"					, ЗначенияРеквизитовЭН.ТипГруза);
		Запрос.УстановитьПараметр("Отправитель"					, Отправитель);
		Запрос.УстановитьПараметр("КонтактноеЛицоОтправителя"	, КонтактноеЛицоОтправителя);
		Запрос.УстановитьПараметр("ОтделениеОтправителя"		, ОтделениеОтправителя);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		КоличествоСозданныхРеестров = РезультатЗапроса.Количество();
		
		Элементы.Реестр.СписокВыбора.Добавить("СОЗДАТЬ_РЕЕСТР", НСтр("ru = 'Создать новый реестр'; uk = 'Створити новий реєстр'"));
		
		Пока РезультатЗапроса.Следующий() Цикл
			Элементы.Реестр.СписокВыбора.Добавить(РезультатЗапроса.Ссылка, РезультатЗапроса.Наименование);
		КонецЦикла;
		
		ТекущийРеестр = ТекущийРеестр(ЭкспрессНакладная);
		Если ЗначениеЗаполнено(ТекущийРеестр) Тогда
			// Текущий реестр не заменяем
			Реестр = ТекущийРеестр;
		ИначеЕсли КоличествоСозданныхРеестров = 1 Тогда
			// Если создан только один реестр - его и подставим
			РезультатЗапроса.Сбросить();
			РезультатЗапроса.Следующий();
			Реестр = РезультатЗапроса.Ссылка;
		ИначеЕсли КоличествоСозданныхРеестров = 0 Тогда
			Реестр = "СОЗДАТЬ_РЕЕСТР";
		Иначе
			// Дадим возможность пользователю выбрать реестр
		КонецЕсли;

		МассивСтрок = Новый Массив;
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Параметры реестра:';uk='Параметри реєстру:'"), , Новый Цвет(74,77,74)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока("" + Формат(ЗначенияРеквизитовЭН.Дата, "ДФ=dd.MM.yyyy") + Символы.ПС + 
								ЗначенияРеквизитовЭН.ОтделениеОтправителя + Символы.ПС + 
								//ЗначенияРеквизитовЭН.Отправитель + Символы.ПС + 
								ЗначенияРеквизитовЭН.КонтактноеЛицоОтправителя, Новый Шрифт(,,Истина), Новый Цвет(74,142,214)));			
		
		Элементы.ДекорацияОписание.Заголовок = Новый ФорматированнаяСтрока(МассивСтрок);
		
	Иначе
		
		Описание = НСтр("ru = 'Сохранить накладную в личном кабинете """"'; uk = 'Зберегти накладну в особистому кабінеті """"'") + Настройки.СлужбаДоставки + """?";
		Элементы.ДекорацияОписание.Заголовок =Новый ФорматированнаяСтрока(Описание, , Новый Цвет(74,77,74));
		Элементы.Реестр.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ИспользоватьРеестры Тогда 
		ПроверяемыеРеквизиты.Добавить("Реестр");
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура Ок(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	НовыйРеестр = Неопределено;
	
	Если ИспользоватьРеестры Тогда 
		
		НовыйРеестр = Реестр;
		
	КонецЕсли;
	
	Закрыть(Новый Структура("Ответ, Реестр", КодВозвратаДиалога.ОК, НовыйРеестр));
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Функция ТекущийРеестр(ЭкспрессНакладная)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	eComm_Реестры.Реестр КАК Реестр
		|ИЗ
		|	РегистрСведений.eComm_Реестры КАК eComm_Реестры
		|ГДЕ
		|	eComm_Реестры.ЭкспрессНакладная = &ЭкспрессНакладная";
	
	Запрос.УстановитьПараметр("ЭкспрессНакладная", ЭкспрессНакладная);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда  
		Возврат РезультатЗапроса.Реестр;
	КонецЕсли;

КонецФункции
