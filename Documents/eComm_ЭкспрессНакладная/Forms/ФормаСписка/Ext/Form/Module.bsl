
/////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УчетнаяЗапись", УчетнаяЗапись);
	
	УчетнаяЗаписьПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСписокРеестров" Тогда 
		Элементы.СписокРеестров.Обновить();
	КонецЕсли;

КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура УчетнаяЗаписьДоставкиПриИзменении(Элемент)
	
	УчетнаяЗаписьПриИзмененииНаСервере();
	
	УстановитьОтборНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРеестровПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("УстановитьОтборНаКлиенте", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНакладныхНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРеестровПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРеестровПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	ТекСтрока = Элемент.ДанныеСтроки(Строка);
	
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда 
		
		Если ДобавитьНакладныеВРеестр(ПараметрыПеретаскивания.Значение, ТекСтрока.Ссылка) = Истина Тогда 
			ПоказатьОповещениеПользователя(Строка(ТекСтрока.Ссылка), ,"Перемещено " + ПараметрыПеретаскивания.Значение.Количество() + " накладных в реестр """ + ТекСтрока.Ссылка + """"); 
			Элементы.СписокНакладных.Обновить();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеестр(Команда)
	
	Если Элементы.СписокРеестров.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, Элементы.СписокРеестров.ТекущиеДанные.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРеестры(Команда)
	
	Элементы.СписокРеестров.Обновить();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура УчетнаяЗаписьПриИзмененииНаСервере()
	
	СписокРеестров.Отбор.Элементы.Очистить();
	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(УчетнаяЗапись);
	Если СтруктураНастроек.Свойство("Настройки")
		И СтруктураНастроек.Настройки.Свойство("ИспользоватьРеестры", ИспользоватьРеестры) Тогда 
		
		ЭлементОтбора = СписокРеестров.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Владелец");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= УчетнаяЗапись;
		ЭлементОтбора.Использование 	= Истина;
		
		Элементы.ГруппаСписокРеестров.Видимость = ИспользоватьРеестры;
		Элементы.УчетнаяЗапись1.Видимость 		= НЕ ИспользоватьРеестры;
		
	Иначе
		
		ИспользоватьРеестры = Ложь;
		
		Элементы.ГруппаСписокРеестров.Видимость = Ложь;
		Элементы.УчетнаяЗапись1.Видимость 		= Истина;
		
	КонецЕсли;  
	
	//Элементы.СписокРеестровДокументeComm_ЭкспрессНакладнаяПечатьАдресныхЯрлыковРеестра.Видимость  = СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта;
	СписокРеестров.Параметры.УстановитьЗначениеПараметра("УчетнаяЗапись", УчетнаяЗапись);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборНаКлиенте()

	ТекДанные = Элементы.СписокРеестров.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ ТекДанные.Наименование = "-Все накладные-" Тогда 
		Реестр = ТекДанные.Ссылка;
	Иначе
		Реестр = Неопределено;
	КонецЕсли;
	
	УстановитьОтборНаСервере(Реестр);

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборНаСервере(Реестр)
	
	СписокНакладных.Отбор.Элементы.Очистить();
	Если Реестр = Неопределено 
		ИЛИ НЕ ИспользоватьРеестры = Истина Тогда
		// Все экспресс-накладные по учетной записи
		ЭлементОтбора = СписокНакладных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("УчетнаяЗапись");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование 	= Истина;
		ЭлементОтбора.ПравоеЗначение 	= УчетнаяЗапись;
	Иначе
		ЭлементОтбора = СписокНакладных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("УчетнаяЗапись");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование 	= Истина;
		ЭлементОтбора.ПравоеЗначение 	= УчетнаяЗапись;
		
		ЭлементОтбора = СписокНакладных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Реестр");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование 	= Истина;
		ЭлементОтбора.ПравоеЗначение 	= Реестр;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДобавитьНакладныеВРеестр(Накладные, Реестр)
	
	Если НЕ ТипЗнч(Накладные) = Тип("Массив") Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(УчетнаяЗапись);
	
	Для Каждого ЭкспрессНакладная Из Накладные Цикл 
		
		Справочники.eComm_УчетныеЗаписиСлужбДоставки.ДобавитьНакладнуюВРеестр(СтруктураНастроек, Реестр, ЭкспрессНакладная);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеОтветаНаВопрос(РезультатВыбора, СтруктураРеестра) Экспорт
	
	Если НЕ РезультатВыбора = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	ДобавитьНакладнуюВРеестр(СтруктураРеестра)
	
КонецПроцедуры

&НаСервере
Функция ДобавитьНакладнуюВРеестр(СтруктураРеестра)
	
	СтруктураНастроек = eCommДоставкаСервер.Настройки(СтруктураРеестра.УчетнаяЗапись);
	
	Если ЗначениеЗаполнено(СтруктураРеестра.Реестр) Тогда
		Реестр = СтруктураРеестра.Реестр;
	Иначе
		Реестр = eCommДоставкаСервер.СоздатьРеестр(СтруктураНастроек, СтруктураРеестра);
	КонецЕсли;
	
	Возврат Справочники.eComm_УчетныеЗаписиСлужбДоставки.ДобавитьНакладнуюВРеестр(СтруктураНастроек, Реестр, СтруктураРеестра.ЭкспрессНакладная);

КонецФункции








