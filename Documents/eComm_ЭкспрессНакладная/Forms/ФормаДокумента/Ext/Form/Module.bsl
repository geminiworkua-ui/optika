&НаСервере
Процедура ОбновитьСостояниеОплаты()

	МассивСтрок = Новый Массив;
	
	Если ЗначениеЗаполнено(ОбъявленнаяСтоимость) Тогда 
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Объявленная стоимость';uk='Оголошена вартість'"), , Новый Цвет(51,51,153)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + ОбъявленнаяСтоимость + "; ", Новый Шрифт(,,Истина), Новый Цвет(178,34,34)));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВидПлательщика) Тогда 
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Плательщик доставки';uk='Платник доставки'"), , Новый Цвет(51,51,153)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + Объект.ВидПлательщика + "; ", Новый Шрифт(,,Истина), Новый Цвет(178,34,34)));
	КонецЕсли;
	
	Если Объект.ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.КонтрольОплаты 
		И СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Контроль оплаты';uk='Контроль оплати'"), , Новый Цвет(51,51,153)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + ВернутьСуммуПостОплаты() + "; ", Новый Шрифт(,,Истина), Новый Цвет(178,34,34)));
		
	ИначеЕсли Объект.ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.ДенежныйПеревод 
		И СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		
		ЭтоДоставкаДенег = НЕ Элементы.ОбратнаяДоставкаОписание.Видимость;
		
		Если ЭтоДоставкаДенег Тогда 
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Обратная доставка денег';uk='Зворотня доставка грошей'"), , Новый Цвет(51,51,153)));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + ВернутьСуммуПостОплаты() + "; ", Новый Шрифт(,,Истина), Новый Цвет(178,34,34)));
		Иначе
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Обратная доставка документов';uk='Зворотня доставка документів'"), , Новый Цвет(51,51,153)));
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + Объект.ОбратнаяДоставкаОписание + "; ", Новый Шрифт(,,Истина), Новый Цвет(178,34,34)));
		КонецЕсли;
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Плательщик обратной доставки';uk='Платник зворотньої доставки'"), , Новый Цвет(51,51,153)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + Объект.ОбратнаяДоставкаВидПлательщика + "; ", Новый Шрифт(,,Истина), Новый Цвет(178,34,34)));
		
	ИначеЕсли Объект.ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.ПостОплатаУкрПочта 
		И (СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта 
			ИЛИ СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin
			ИЛИ СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest) Тогда
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Пост-оплата';uk='Пост-оплата'"), , Новый Цвет(51,51,153)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + ВернутьСуммуПостОплаты() + "; ", Новый Шрифт(,,Истина), Новый Цвет(178,34,34)));
		
	Иначе
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Предоплата';uk='Передплата'"), , Новый Цвет(51,51,153)));
	КонецЕсли;
	
	//Если НЕ СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		СостояниеОплаты = Новый ФорматированнаяСтрока(МассивСтрок);
	//Иначе
	//	СостояниеОплаты = Новый ФорматированнаяСтрока(НСтр("ru = 'ФУНКЦИОНАЛ В РАЗРАБОТКЕ!!!'; uk = 'ФУНКЦІОНАЛ В РОЗРОБЦІ!!!'"), Новый Шрифт(,,Истина), Новый Цвет(178,34,34))
	//КонецЕсли;

КонецПроцедуры

