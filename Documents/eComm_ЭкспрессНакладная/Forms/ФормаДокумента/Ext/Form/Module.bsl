&НаСервере
Процедура ОбновитьРеестр()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_Реестры.Реестр КАК Реестр
		|ИЗ
		|	РегистрСведений.eComm_Реестры КАК eComm_Реестры
		|ГДЕ
		|	eComm_Реестры.ЭкспрессНакладная = &ЭкспрессНакладная
		|	И НЕ &ЭкспрессНакладная = ЗНАЧЕНИЕ(Документ.eComm_ЭкспрессНакладная.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ЭкспрессНакладная", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Элементы.ДекорацияРеестр.Заголовок = "" + РезультатЗапроса.Реестр;
	Иначе
		Элементы.ДекорацияРеестр.Заголовок = НСтр("ru = '< Не в реестре >'; uk = '< Не в реєстрі >'");
	КонецЕсли;

