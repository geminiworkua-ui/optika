&НаСервере
Процедура ОбновитьСтатусДокументаНаСервере()

	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Объект.УчетнаяЗапись);
	Если НЕ Объект.НомерТТН = "" Тогда	
		Справочники.eComm_УчетныеЗаписиСлужбДоставки.ОбновитьСтатусы(СтруктураНастроек, Объект.Ссылка);
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатус(Команда)
	ОбновитьСтатусДокументаНаСервере();  
	ЗаполнитьСтатусДокумента();
КонецПроцедуры



