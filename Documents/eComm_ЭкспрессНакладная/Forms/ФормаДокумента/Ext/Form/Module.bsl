КонецФункции

&НаСервере
Функция ПодобратьКонтактноеЛицоНаСервере(СтруктураКонтактногоЛица)

	Результат = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.УчетнаяЗапись) 
		ИЛИ НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Настройки = Настройки(Объект.УчетнаяЗапись);

	Запрос = Новый Запрос;
	Запрос.Текст = ВернутьТекстЗапросаПоКонтактам(Настройки);
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование.Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл 
		
		СтруктураФИО = eCommДоставкаСервер.ФамилияИмяОтчество(РезультатЗапроса.НаименованиеПолное);
		
		СтруктураКонтактногоЛица = Новый Структура();
		СтруктураКонтактногоЛица.Вставить("Фамилия"			, СтруктураФИО.Фамилия);
		СтруктураКонтактногоЛица.Вставить("Имя"				, ?(ЗначениеЗаполнено(СтруктураФИО.Имя), СтруктураФИО.Имя, "БезИмени"));
		СтруктураКонтактногоЛица.Вставить("Отчество"		, СтруктураФИО.Отчество);
		СтруктураКонтактногоЛица.Вставить("Телефон"			, eCommДоставкаСервер.ВернутьМассивНомеровТелефонов(РезультатЗапроса.Телефон));
		СтруктураКонтактногоЛица.Вставить("УчетнаяЗапись"	, Объект.УчетнаяЗапись);
		
		Если РезультатЗапроса.ЭтоФизическоеЛицо = Истина Тогда
			СтруктураКонтактногоЛица.Вставить("ТипКонтрагента"	, eCommДоставкаСервер.ТипКонтрагентаЧастноеЛицо(СлужбаДоставки));
		ИначеЕсли РезультатЗапроса.ЭтоЮридическоеЛицо = Истина Тогда
			СтруктураКонтактногоЛица.Вставить("ТипКонтрагента"	, eCommДоставкаСервер.ТипКонтрагентаОрганизация(СлужбаДоставки));
			СтруктураКонтактногоЛица.Вставить("ЕДРПОУ"			, РезультатЗапроса.КодПоЕДРПОУ);
			СтруктураКонтактногоЛица.Вставить("Наименование"	, РезультатЗапроса.НаименованиеПолное);
		ИначеЕсли РезультатЗапроса.ЭтоИндивидуальныйПредприниматель = Истина Тогда
			СтруктураКонтактногоЛица.Вставить("ТипКонтрагента"	, eCommДоставкаСервер.ТипКонтрагентаФОП(СлужбаДоставки));
			СтруктураКонтактногоЛица.Вставить("ЕДРПОУ"			, РезультатЗапроса.ИНН);
		КонецЕсли;
		
		КонтактноеЛицо = eCommДоставкаСервер.НайтиКонтактноеЛицоКонтрагентаСлужбыДоставки(Настройки, СтруктураКонтактногоЛица);
		Если ЗначениеЗаполнено(КонтактноеЛицо) Тогда
			
			Получатель = КонтактноеЛицо.Владелец;
			
			Объект.ТипПолучателя 			= Получатель.ТипКонтрагента;
			Объект.Получатель 				= Получатель;
			Объект.КонтактноеЛицоПолучателя = КонтактноеЛицо;
			Объект.ТелефонПолучателя		= КонтактноеЛицо.Телефон;
			
			Возврат Истина;
			
		КонецЕсли;
		
		Если Настройки.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
			// Дополнительно поищем в контрагентах
			
			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("УчетнаяЗапись", Объект.УчетнаяЗапись);
			ПараметрыПоиска.Вставить("Наименование"	, РезультатЗапроса.НаименованиеПолное);
			ПараметрыПоиска.Вставить("Телефон"		, eCommДоставкаСервер.ВернутьМассивНомеровТелефонов(РезультатЗапроса.Телефон));

			Контрагент = eCommДоставкаСервер.НайтиКонтрагентаСлужбыДоставки(Настройки, ПараметрыПоиска);
			
			Если ЗначениеЗаполнено(Контрагент) Тогда 
				
				Объект.ТипПолучателя 			= Контрагент.ТипКонтрагента;
				Объект.Получатель 				= Контрагент;
				Объект.КонтактноеЛицоПолучателя = Неопределено;
				Объект.ТелефонПолучателя		= Контрагент.Телефон;
				
				ТипПолучателяПриИзмененииНаСервере();//++
				
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат

КонецФункции

