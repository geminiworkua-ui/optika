&НаКлиенте
Процедура ОтправитьСМС(Команда)
	
	СтруктураНастроек = Настройки(Объект.УчетнаяЗапись);
	
	//ОтправлятьСМСПриСозданииЭН 	= СтруктураНастроек.Настройки.ОтправлятьСМСПриСозданииЭН;
	ШаблонСМС 					= СтруктураНастроек.Настройки.ШаблонСМС;
	
	Если НЕ ЗначениеЗаполнено(ШаблонСМС) Тогда 
		Возврат;
	КонецЕсли;
	
	ИмяДокументаСообщениеSMS 				= eCommДоставкаСервер.ВернутьИмяПрикладногоОбъекта("СообщениеSMS");
	ОтправлятьВТранслите_ВРеквизитахФормы 	= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("СообщениеSMS", "ОтправлятьВТранслите") = "";
	
	СтруктураЭкспрессНакладной = Новый Структура("Ссылка, ДокументОснование, ТелефонПолучателя", Объект.Ссылка, Объект.ДокументОснование, Объект.ТелефонПолучателя);

	Если ИмяДокументаСообщениеSMS = "Событие" Тогда 
		ПутьКФорме = "Документ." + ИмяДокументаСообщениеSMS + ".Форма.ФормаСообщенияSMS";
	Иначе
		ПутьКФорме = "Документ." + ИмяДокументаСообщениеSMS + ".Форма.ФормаДокумента";
	КонецЕсли;
	Форма = ПолучитьФорму(ПутьКФорме);
	
	ДанныеФормы = Форма.Объект;
	eCommДоставкаСервер.ЗаполнитьСМСНаСервере(СтруктураНастроек, ДанныеФормы, СтруктураЭкспрессНакладной, ШаблонСМС, ОтправлятьВТранслите_ВРеквизитахФормы);
	КопироватьДанныеФормы(ДанныеФормы, Форма.Объект);
	
	Если НЕ СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
		Если ОтправлятьВТранслите_ВРеквизитахФормы Тогда 
			Форма["ОтправлятьВТранслите"] = ОтправлятьВТранслите(ШаблонСМС);
		Иначе
			Форма["ВзаимодействиеОснование"] = Объект.ДокументОснование;
		КонецЕсли;
	КонецЕсли;
	
	Форма.Открыть();
	
КонецПроцедуры

