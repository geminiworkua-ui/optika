&НаСервере
Процедура УстановитьДоступность()

	Если ЗначениеЗаполнено(Объект.НомерТТН) Тогда 
		ТолькоПросмотр = Истина;
		Элементы.РазрешитьРедактирование.Видимость = Истина;
	Иначе
		ТолькоПросмотр = Ложь;
		Элементы.РазрешитьРедактирование.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолучатель(ЭтоКомпания)

	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		Элементы.Получатель.Видимость = ЭтоКомпания;
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Элементы.ПолучательУкрпочта.Видимость = ЭтоКомпания;
		Элементы.КонтактноеЛицоПолучателяУкрпочта.Видимость = НЕ ЭтоКомпания;
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		Элементы.ПолучательMeest.Видимость = ЭтоКомпания;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьУлицыПолучателя()

	Если НЕ Элементы.УлицаПолучателяСтрокойНоваяПочта.Видимость = Объект.ИспользоватьУлицаПолучателяСтрокой Тогда 
		Элементы.УлицаПолучателяСтрокойНоваяПочта.Видимость = Объект.ИспользоватьУлицаПолучателяСтрокой;
	КонецЕсли;
	
	Если Элементы.УлицаПолучателяНоваяПочта.Видимость = Объект.ИспользоватьУлицаПолучателяСтрокой Тогда 
		Элементы.УлицаПолучателяНоваяПочта.Видимость = НЕ Объект.ИспользоватьУлицаПолучателяСтрокой;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораТипГруза()

	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		РодительТипГруза = Справочники.eComm_ОбщиеСправочники.ТипыОтправкиУкрпочта;
		ЗаголовокЭлемента = НСтр("ru = 'Тип отправки'; uk = 'Тип відправки'");
	Иначе
		РодительТипГруза = Справочники.eComm_ОбщиеСправочники.ВидыГруза;
		ЗаголовокЭлемента = НСтр("ru = 'Тип груза'; uk = 'Тип вантажу'");
	КонецЕсли;
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Родитель", РодительТипГруза));    

	Элементы.ТипГруза.ПараметрыВыбора 	= Новый ФиксированныйМассив(МассивПараметровВыбора);
	Элементы.ТипГруза.Заголовок 		= ЗаголовокЭлемента;
	
	// Приведем значение
	Если НЕ Объект.ТипГруза.Родитель = РодительТипГруза Тогда 
		Объект.ТипГруза = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаСервере
&НаСервере
Процедура УстановитьПараметрыВыбораОтделениеПолучателя()

	МассивПараметровВыбора = Новый Массив;
	Если Объект.ТехнологияДоставки = Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "WarehousePostomat")
		ИЛИ Объект.ТехнологияДоставки = Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "DoorsPostomat") Тогда 
		МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.ТипОтделения", Справочники.eComm_ОбщиеСправочники.НайтиПоНаименованию("Поштомат")));
	Иначе
		МассивЗн = Новый Массив;
		ДобавитьТипОтделенияВМассив(МассивЗн, "Вантажне відділення");          
		ДобавитьТипОтделенияВМассив(МассивЗн, "Поштове відділення");
		ДобавитьТипОтделенияВМассив(МассивЗн, "Поштове(ий)");
		ДобавитьТипОтделенияВМассив(МассивЗн, "Вантажне(ий)");
		ДобавитьТипОтделенияВМассив(МассивЗн, "Відділення поштове до 10 кг");
		МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.ТипОтделения", МассивЗн));
	КонецЕсли;

	Элементы.ОтделениеПолучателя.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);

КонецПроцедуры

&НаСервере
Процедура ДобавитьТипОтделенияВМассив(МассивТиповОтделений, ТипОтделенияСтрокой)

	ТипОтделения = Справочники.eComm_ОбщиеСправочники.НайтиПоНаименованию(ТипОтделенияСтрокой);
	Если ЗначениеЗаполнено(ТипОтделения) Тогда 
		МассивТиповОтделений.Добавить(ТипОтделения);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТехнологияДоставки(НазваниеТехнологии)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ОбщиеСправочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_ОбщиеСправочники КАК eComm_ОбщиеСправочники
		|ГДЕ
		|	eComm_ОбщиеСправочники.Родитель = ЗНАЧЕНИЕ(Справочник.eComm_ОбщиеСправочники.ТехнологииДоставки)
		|	И eComm_ОбщиеСправочники.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", НазваниеТехнологии);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		Возврат РезультатЗапроса.Ссылка;
	КонецЦикла;

КонецФункции

&НаСервере
Процедура УчетнаяЗаписьПриИзмененииНаСервере()

	Если ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда 
		
		//++
		ДанныеОтправителя = Неопределено;
		Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда 
			ДанныеОтправителя = eCommДоставкаСервер.ДанныеОтправителя(Объект.УчетнаяЗапись, Объект.УчетнаяЗапись.СлужбаДоставки, Объект.ДокументОснование.Организация, Неопределено); 
		КонецЕсли;
		//--
		
		НастройкиУчетнойЗаписи = Настройки(Объект.УчетнаяЗапись, ДанныеОтправителя);
		
		НастройкиУчетнойЗаписи.ДанныеЗаполнения.Свойство("ОбъявленнаяСтоимостьПредоплаченныхЗаказов", ОбъявленнаяСтоимостьПредоплаченныхЗаказов);
		НастройкиУчетнойЗаписи.Настройки.Свойство("ЗаполнятьДополнительнуюИнформациюПоЗаказу", ЗаполнятьДополнительнуюИнформациюПоЗаказу);
		НастройкиУчетнойЗаписи.Настройки.Свойство("ЗаполнятьОбщийВесОбъемПоЗаказу", ЗаполнятьОбщийВесОбъемПоЗаказу);
		Если НастройкиУчетнойЗаписи.Настройки.Свойство("ИспользоватьАдресОтправителяНоваяПочтаСтрокой") Тогда 
			ИспользоватьАдресОтправителяНоваяПочтаСтрокой = НастройкиУчетнойЗаписи.Настройки.ИспользоватьАдресОтправителяНоваяПочтаСтрокой;
		Иначе
			ИспользоватьАдресОтправителяНоваяПочтаСтрокой = Истина;
		КонецЕсли;
		
		Если Параметры.Свойство("ЗначениеКопирования")
			И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда 
			// Ничего не делаем
		ИначеЕсли НастройкиУчетнойЗаписи.Настройки.Свойство("ТипОтправки") 
			И НастройкиУчетнойЗаписи.Настройки.ТипОтправки = "ЗаборПоАдресу" Тогда
			Объект.ТехнологияДоставки 	= ТехнологияДоставки("DoorsWarehouse");
		Иначе
			Объект.ТехнологияДоставки 	= ТехнологияДоставки("WarehouseWarehouse");
		КонецЕсли;
		
		ЗаполнитьСлужбуДоставки(НастройкиУчетнойЗаписи);
		
		ИсключенныеСвойства = "";
		Если ЗаполнятьДополнительнуюИнформациюПоЗаказу = Истина Тогда 
			ИсключенныеСвойства = ИсключенныеСвойства + "ДополнительнаяИнформация";
		КонецЕсли;
		
		Если ЗаполнятьОбщийВесОбъемПоЗаказу = Истина Тогда 
			Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
				ИсключенныеСвойства = ИсключенныеСвойства + ?(ИсключенныеСвойства = "", "", ",") + "Вес, МаксимальнаяСторона";
			Иначе // Новая почта
				ИсключенныеСвойства = ИсключенныеСвойства + ?(ИсключенныеСвойства = "", "", ",") + "Вес, Объем";
			КонецЕсли;
		КонецЕсли;
		
		Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда
			ИсключенныеСвойства = ИсключенныеСвойства + ?(ИсключенныеСвойства = "", "", ",") + "ДополнительныеУслуги";
		КонецЕсли;

		Если ЗначениеЗаполнено(ИсключенныеСвойства) Тогда 
			ЗаполнитьЗначенияСвойств(Объект, НастройкиУчетнойЗаписи.ДанныеЗаполнения, , ИсключенныеСвойства);
		Иначе
			ЗаполнитьЗначенияСвойств(Объект, НастройкиУчетнойЗаписи.ДанныеЗаполнения);
		КонецЕсли;
		
		Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта 
			И НастройкиУчетнойЗаписи.ДанныеЗаполнения.Свойство("ДополнительныеУслуги") 
			И ТипЗнч(НастройкиУчетнойЗаписи.ДанныеЗаполнения.ДополнительныеУслуги) = Тип("Массив") Тогда 
			
			Объект.ДополнительныеУслуги.Очистить();
			Для Каждого ДопУслуга Из НастройкиУчетнойЗаписи.ДанныеЗаполнения.ДополнительныеУслуги Цикл 
				
				НоваяДопУслуга = Объект.ДополнительныеУслуги.Добавить();
				НоваяДопУслуга.Услуга = ДопУслуга;
				
				ИмяРеквизитаФормы = Справочники.eComm_ОбщиеСправочники.ПолучитьИмяПредопределенного(ДопУслуга);
				
				Если ЗначениеЗаполнено(ИмяРеквизитаФормы) Тогда 
					ЭтаФорма[ИмяРеквизитаФормы] = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ТипПолучателяПриИзмененииНаСервере();
		ТипПостОплатыПриИзмененииНаСервере();
		УстановитьПараметрыВыбораТипГруза();
		
	Иначе
		
		ЗаполнитьСлужбуДоставки();
		ПрименитьИспользованиеПостоплаты(Объект);
		ОбъявленнаяСтоимостьПредоплаченныхЗаказов = 0;
		
	КонецЕсли;
	
	ОбновитьСостояниеОплаты();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатусДокумента()

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_СтатусыЭкспрессНакладных.ОписаниеСтатуса КАК ОписаниеСтатуса
		|ИЗ
		|	РегистрСведений.eComm_СтатусыЭкспрессНакладных КАК eComm_СтатусыЭкспрессНакладных
		|ГДЕ
		|	eComm_СтатусыЭкспрессНакладных.ЭкспрессНакладная = &ЭкспрессНакладная";
	
	Запрос.УстановитьПараметр("ЭкспрессНакладная", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Элементы.ДекорацияОписаниеСтатуса.Заголовок = Новый ФорматированнаяСтрока(РезультатЗапроса.ОписаниеСтатуса, Новый Шрифт(,12,Истина), Новый Цвет(51,51,153));
	Иначе
		Элементы.ДекорацияОписаниеСтатуса.Заголовок = Новый ФорматированнаяСтрока(НСтр("ru = 'Черновик'; uk = 'Чернетка'"), Новый Шрифт(,12,Истина), Новый Цвет(51,51,153));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужбуДоставки(Настройки = Неопределено)

	Если ТипЗнч(Настройки) = Тип("Структура")
		И Настройки.Свойство("СлужбаДоставки") Тогда 
		СлужбаДоставки = Настройки.СлужбаДоставки;
	Иначе
		СлужбаДоставки = Неопределено;
	КонецЕсли;
	
	УстановитьЛоготипыКоманды(Элементы.Найти("ФормаДокументeComm_ЭкспрессНакладнаяСоздатьЭН"));
	УстановитьЛоготипыКоманды(Элементы.Найти("ФормаeComm_ПечатьЭН"));

КонецПроцедуры

&НаСервере
Процедура УстановитьЛоготипыКоманды(Команда)

	Если Команда = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		Команда.Картинка = Элементы.eComm_НоваяПочта.Картинка;
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Команда.Картинка = Элементы.eComm_Укрпочта.Картинка;
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		Команда.Картинка = Элементы.eComm_Meest.Картинка;
	Иначе
		Команда.Картинка = Новый Картинка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПрименитьИспользованиеПостоплаты(ЭкспрессНакладная)

	НастройкиДоставки 	= Настройки(ЭкспрессНакладная.УчетнаяЗапись);
	НаложенныйПлатеж 	= eCommДоставкаСервер.ЗначениеНастройки(НастройкиДоставки, "Настройки", "СпособПримененияПостоплаты") = "ИспользоватьПостоплату";
	
	Если НаложенныйПлатеж Тогда 
		// Сумму заказа и доставку оплачивает покупатель
		
		ТипПостОплаты = Неопределено;
		
		Если НастройкиДоставки.Настройки.Свойство("ТипПостОплаты", ТипПостОплаты) Тогда 
			// Это "Новая почта"
			
			Если ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.КонтрольОплаты Тогда
				// Это контроль оплаты
				ЭкспрессНакладная.ТипПостОплаты	= ТипПостОплаты;
			Иначе
				// Это денежный перевод
				ЭкспрессНакладная.ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.ДенежныйПеревод;
				
				ЗначенияПоУмолчанию = НастройкиДоставки.ДанныеЗаполнения;
				
				Если ЗначениеЗаполнено(ЗначенияПоУмолчанию.ОбратнаяДоставкаВидГруза) Тогда 
					ЭкспрессНакладная.ОбратнаяДоставкаВидГруза = ЗначенияПоУмолчанию.ОбратнаяДоставкаВидГруза;
				Иначе
					ЭкспрессНакладная.ОбратнаяДоставкаВидГруза = Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "Money", Справочники.eComm_ОбщиеСправочники.ВидыОбратнойДоставкиГруза);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЗначенияПоУмолчанию.ОбратнаяДоставкаВидПлательщика) Тогда 
					ЭкспрессНакладная.ОбратнаяДоставкаВидПлательщика = ЗначенияПоУмолчанию.ОбратнаяДоставкаВидПлательщика;
				Иначе
					ЭкспрессНакладная.ОбратнаяДоставкаВидПлательщика = Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "Recipient", Справочники.eComm_ОбщиеСправочники.ВидыПлательщиковОбратнойДоставки);
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			// Это "Укрпочта"
			ЭкспрессНакладная.ТипПостОплаты	= Справочники.eComm_ОбщиеСправочники.ПостОплатаУкрПочта;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РедактироватьСписокМест(ПараметрыРедактирования, ДопПараметры) Экспорт

	Если ПараметрыРедактирования = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Объект.Места.Очистить();
	
	Для Каждого СтруктураМеста Из ПараметрыРедактирования.Места Цикл 
		ЗаполнитьЗначенияСвойств(Объект.Места.Добавить(), СтруктураМеста);
	КонецЦикла;
	
	Если ТипЗнч(ПараметрыРедактирования) = Тип("Структура")
		И ПараметрыРедактирования.Свойство("ОбъявленнаяСтоимость")
		И ЗначениеЗаполнено(ПараметрыРедактирования.ОбъявленнаяСтоимость) 
		И НЕ ОбъявленнаяСтоимость = ПараметрыРедактирования.ОбъявленнаяСтоимость Тогда
		// Используется только для Укрпочты, в случае если 
		// при редактировании мест изменили объявленную стоимость
		
		Объект.ОбъявленнаяСтоимость = ПараметрыРедактирования.ОбъявленнаяСтоимость;
		ЗаполнитьОбъявленнуюСтоимость();
		
	КонецЕсли;
	
	ЗаполнитьПредставлениеМест();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВводаЗначения(Значение, ИмяРеквизита) Экспорт

	Если Значение = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Объект[ИмяРеквизита] = Значение;
	
	Модифицированность = Истина;
	
	Если ИмяРеквизита = "ОбъявленнаяСтоимость" Тогда 
		ЗаполнитьОбъявленнуюСтоимость();
	ИначеЕсли ИмяРеквизита = "СуммаПостОплаты" Тогда 
		ЗаполнитьСуммуПостОплаты();
	ИначеЕсли ИмяРеквизита = "ДополнительнаяИнформация" Тогда 
		ОбновитьДополнительнуюИнформацию();
	ИначеЕсли ИмяРеквизита = "Вес" 
		ИЛИ ИмяРеквизита = "Объем" Тогда 
		ОбновитьВесОбъем();
	ИначеЕсли ИмяРеквизита = "НомерТТН" Тогда 
		//ЗаполнитьСтатусДокумента();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеСозданияКонтакта(СтруктураКонтакта, ДопПараметры = Неопределено) Экспорт

	Если СтруктураКонтакта = Неопределено 
		ИЛИ НЕ ТипЗнч(СтруктураКонтакта) = Тип("Структура") Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	СтруктураКонтакта.Свойство("Получатель"					, Объект.Получатель);
	СтруктураКонтакта.Свойство("КонтактноеЛицоПолучателя"	, Объект.КонтактноеЛицоПолучателя);
	СтруктураКонтакта.Свойство("ТипПолучателя"				, Объект.ТипПолучателя);
	СтруктураКонтакта.Свойство("Телефон"					, Объект.ТелефонПолучателя);
	СтруктураКонтакта.Свойство("АдресПолучателя"			, Объект.АдресПолучателя);
	
	ЭтоКомпания = Объект.ТипПолучателя = eCommДоставкаСервер.ТипКонтрагентаОрганизация(СлужбаДоставки);
	УстановитьВидимостьПолучатель(ЭтоКомпания)

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеРазрешенияРедактированиЭН(Ответ, ДопПараметры = Неопределено) Экспорт

	Если Ответ = "Понятно" Тогда 
		ТолькоПросмотр = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ТипПолучателяПриИзмененииНаСервере()

	ЭтоКомпания = Объект.ТипПолучателя = eCommДоставкаСервер.ТипКонтрагентаОрганизация(СлужбаДоставки);
	УстановитьВидимостьПолучатель(ЭтоКомпания);
	
	Если НЕ ЭтоКомпания Тогда
		Если Объект.ТипПолучателя = eCommДоставкаСервер.ТипКонтрагентаЧастноеЛицо(СлужбаДоставки) Тогда 
			Объект.Получатель = Документы.eComm_ЭкспрессНакладная.ПолучательЧастноеЛицо(Объект.УчетнаяЗапись);
		ИначеЕсли Объект.ТипПолучателя = eCommДоставкаСервер.ТипКонтрагентаФОП(СлужбаДоставки) Тогда 
			Объект.Получатель 	= Документы.eComm_ЭкспрессНакладная.ПолучательФОП(Объект.УчетнаяЗапись);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура КонтактноеЛицоОтправителяПриИзмененииНаСервере()

	Объект.ТелефонОтправителя = Объект.КонтактноеЛицоОтправителя.Телефон;

КонецПроцедуры

&НаСервере
Процедура КонтактноеЛицоПолучателяПриИзмененииНаСервере()

	Объект.ТелефонПолучателя = Объект.КонтактноеЛицоПолучателя.Телефон;

КонецПроцедуры

&НаСервере
Процедура ТипПостОплатыПриИзмененииНаСервере()

	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		ТипПостОплатыНоваяПочтаПриИзмененииНаСервереНоваяПочта();
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		ТипПостОплатыПриИзмененииНаСервереУкрПочтаJustinMeest();
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
		ТипПостОплатыПриИзмененииНаСервереУкрПочтаJustinMeest();
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		ТипПостОплатыПриИзмененииНаСервереУкрПочтаJustinMeest();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ТипПостОплатыНоваяПочтаПриИзмененииНаСервереНоваяПочта()

	Элементы.ГруппаКонтрольОплаты.Видимость 	= Объект.ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.КонтрольОплаты;
	Элементы.ГруппаОбратнаяДоставка.Видимость 	= Объект.ТипПостОплаты = Справочники.eComm_ОбщиеСправочники.ДенежныйПеревод;
	Элементы.ГруппаСуммаПостОплаты.Видимость	= ЗначениеЗаполнено(Объект.ТипПостОплаты);
	
	Если ЗначениеЗаполнено(Объект.ТипПостОплаты) 
		И ЗначениеЗаполнено(Объект.ДокументОснование) Тогда 
		СуммаПостОплаты = eCommДоставкаСервер.СуммаЗаказа(Объект.ДокументОснование);
	КонецЕсли;
	
	ДенежныйПеревод 	= Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", "Money", Справочники.eComm_ОбщиеСправочники.ВидыОбратнойДоставкиГруза);
	ЭтоДенежныйПеревод 	= Объект.ОбратнаяДоставкаВидГруза = ДенежныйПеревод;
	
	Элементы.ОбратнаяДоставкаОписание.Видимость = НЕ ЭтоДенежныйПеревод;
	
	ОбновитьСостояниеОплаты();

КонецПроцедуры

