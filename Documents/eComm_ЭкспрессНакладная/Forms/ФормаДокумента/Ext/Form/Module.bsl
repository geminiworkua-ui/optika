&НаКлиенте
Процедура РассчитатьПрогнозируемуюДатуДоставки(Команда)
	
    Успешно = Истина;
	Если НЕ ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		Сообщить(НСтр("ru = 'Не определена учетная запись Новой почты'; uk = 'Не визначено обліковий запис Нової пошти'"));
		Успешно = Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ТехнологияДоставки) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Поле  = "Объект.ТехнологияДоставки";	
		Сообщение.Текст = НСтр("ru = 'Не определена технология доставки Новой почты'; uk = 'Не визначена технологія доставки Нової пошти'");
		Сообщение.Сообщить();
		Успешно = Ложь;
	КонецЕсли;         
	Если НЕ ЗначениеЗаполнено(Объект.НаселенныйПунктОтправителя) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Поле  = "Объект.НаселенныйПунктОтправителя";	
		Сообщение.Текст = НСтр("ru = 'Не определен город отправителя Новой почты'; uk = 'Не визначено місто відправника Нової пошти'");
		Сообщение.Сообщить();
		Успешно = Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.НаселенныйПунктПолучателя) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Поле  = "Объект.НаселенныйПунктПолучателя";	
		Сообщение.Текст = НСтр("ru = 'Не определен город доставки Новой почты'; uk = 'Не визначено місто доставки Нової пошти'");
		Сообщение.Сообщить();
		Успешно = Ложь;
	КонецЕсли;
	
	Если Успешно = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	ПрогнозДата = РассчитатьПрогнозируемуюДатуДоставкиНаСервере();
	
	Если ПрогнозДата > Дата(2020,01,01) Тогда 
		
		ТекДата = ТекДатаСеанса();
		//Год   	= Сред(ПрогнозируемаяДатаДоставкиСтрокой, 1, 4);
		//Месяц 	= Сред(ПрогнозируемаяДатаДоставкиСтрокой, 6, 2);
		//День  	= Сред(ПрогнозируемаяДатаДоставкиСтрокой, 9, 2); 
		
		
		
		Дата = ПрогнозДата; 
		
		Если Дата = НачалоДня(ТекДата+1*24*60*60) Тогда
			
			ПрогнозируемаяДатаДоставки = "Завтра, "+Формат(Дата, "Л=uk_UA; ДЛФ=DD");
			
		ИначеЕсли Дата = НачалоДня(ТекДата+2*24*60*60) Тогда
			
			ПрогнозируемаяДатаДоставки = "Післязавтра, "+Формат(Дата, "Л=uk_UA; ДЛФ=DD");
			
		Иначе	
			
			ПрогнозируемаяДатаДоставки = Формат(Дата, "Л=uk_UA; ДЛФ=DD");
			
		КонецЕсли;
		
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru='Прогнозируемая дата доставки: ';uk='Прогнозована дата доставки: '"), , Новый Цвет(51,51,153)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + ПрогнозируемаяДатаДоставки + "; ", Новый Шрифт(,,Истина), Новый Цвет(178,34,34)));

		ПоказатьПредупреждение(, Новый ФорматированнаяСтрока(МассивСтрок), , НСтр("ru = 'Прогнозируемая дата доставки'; uk = 'Прогнозована дата доставки'"));
		
	Иначе
		
		Сообщить(НСтр("ru = 'Ошибка получения даты доставки'; uk = 'Помилка отримання дати доставки'"));
		
	КонецЕсли;
	
КонецПроцедуры


