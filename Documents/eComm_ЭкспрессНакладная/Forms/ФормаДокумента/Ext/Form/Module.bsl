&НаСервере
Процедура ОбновитьВесОбъем()

	Если Объект.НесколькоМест Тогда
		Возврат;
	КонецЕсли;
		
	Если ЗаполнятьОбщийВесОбъемПоЗаказу = Ложь Тогда
		// При заполнении "Из настроек" мы редактируем непосредственно на форме
		Возврат;
	КонецЕсли;
		
	ВесОбъем = eCommДоставкаСервер.ВесОбъемТоваровЗаказа(Объект.ДокументОснование);
	
	Если ЗначениеЗаполнено(Объект.Вес) Тогда 
		Вес = Объект.Вес;
	Иначе
		Вес = ВесОбъем.Вес;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Объем) Тогда 
		Объем = Объект.Объем;
	Иначе
		Объем = ВесОбъем.Объем;
	КонецЕсли;
		
КонецПроцедуры

