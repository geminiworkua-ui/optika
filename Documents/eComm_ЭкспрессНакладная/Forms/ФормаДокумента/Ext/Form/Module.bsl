Процедура ЗарегистрироватьНаСервере()
	Отказ =Ложь;
	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Объект.УчетнаяЗапись);
	Если Объект.НомерТТН ="" Тогда	
		eCommДоставкаСервер.ЗарегистирироватьЕН(СтруктураНастроек, Объект, Отказ);	
	Иначе
		eCommДоставкаСервер.ИзменитьЕН(СтруктураНастроек, Объект, Отказ);	
	КонецЕсли;	
	Если Отказ Тогда
		Сообщить("Ошибка регистрации ЕН");  
	Иначе
		Записать();
	КонецЕсли;	

