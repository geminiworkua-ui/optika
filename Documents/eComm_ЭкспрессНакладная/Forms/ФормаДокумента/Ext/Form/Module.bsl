&НаСервере
Функция ВернутьТекстЗапросаПоКонтактамУНФ(СтруктураНастроек)

	ТекстЗапроса = "ВЫБРАТЬ
		|	Контрагенты.КодПоЕДРПОУ КАК КодПоЕДРПОУ,
		|	Контрагенты.ИНН КАК ИНН,
		|	ВЫБОР
		|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ФизическоеЛицо)
		|				ИЛИ Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоФизическоеЛицо,
		|	ВЫБОР
		|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ИндивидуальныйПредприниматель)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоИндивидуальныйПредприниматель,
		|	ВЫБОР
		|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ЮридическоеЛицо)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоЮридическоеЛицо,
		|	КонтрагентыКонтактнаяИнформация.Представление КАК Телефон,
		|	ВЫБОР
		|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ФизическоеЛицо)
		|				ИЛИ Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ПустаяСсылка)
		|			ТОГДА ВЫБОР
		|					КОГДА НЕ Контрагенты.ФИО = """"
		|						ТОГДА Контрагенты.ФИО
		|					КОГДА НЕ (ВЫРАЗИТЬ(Контрагенты.НаименованиеПолное КАК СТРОКА(1024))) = """"
		|						ТОГДА Контрагенты.НаименованиеПолное
		|					ИНАЧЕ Контрагенты.Наименование
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА НЕ (ВЫРАЗИТЬ(Контрагенты.НаименованиеПолное КАК СТРОКА(1024))) = """"
		|					ТОГДА Контрагенты.НаименованиеПолное
		|				ИНАЧЕ Контрагенты.Наименование
		|			КОНЕЦ
		|	КОНЕЦ КАК НаименованиеПолное
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
		|		ПО (КонтрагентыКонтактнаяИнформация.Ссылка = Контрагенты.Ссылка)
		|			И (КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
		|			И (НЕ КонтрагентыКонтактнаяИнформация.Представление = """")
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса;

КонецФункции

