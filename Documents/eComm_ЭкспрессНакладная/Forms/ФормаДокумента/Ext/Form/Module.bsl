Функция РассчитатьПрогнозируемуюДатуДоставкиНаСервере()

	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ТехнологияДоставки"			, Объект.ТехнологияДоставки);
    СтруктураДанных.Вставить("ДатаОтправки"					, формат(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()), "ДФ='yyyy-MM-dd hh:mm:ss'"));
	СтруктураДанных.Вставить("НаселенныйПунктОтправителя"	, Объект.НаселенныйПунктОтправителя);
	СтруктураДанных.Вставить("НаселенныйПунктПолучателя"	, Объект.НаселенныйПунктПолучателя);
	
	Настройки = Настройки(Объект.УчетнаяЗапись);
	ПрогнозируемаяДатаДоставки = Справочники.eComm_УчетныеЗаписиСлужбДоставки.РассчитатьПрогнозируемуюДатуДоставки(Настройки, СтруктураДанных);	
	
	Возврат ПрогнозируемаяДатаДоставки;	

