	ТипПостОплатыПриИзмененииНаСервере();
	
	// Вес / объем
	Элементы.ГруппаСписокМест.Видимость 	= Объект.НесколькоМест;
	Элементы.РучнаяОбработка.Видимость		= СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта;
