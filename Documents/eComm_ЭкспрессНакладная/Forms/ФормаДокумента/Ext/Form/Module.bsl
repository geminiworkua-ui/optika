
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) 
		И Параметры.Свойство("ПоРеквизитамДоставки")
		Тогда 
	    // подготовим данные для заполнения накладной
				
		ОБъект.УчетнаяЗапись = Параметры.УчетнаяЗапись;
		Если Не ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда 
			Объект.УчетнаяЗапись = eCommДоставкаСервер.ВернутьУчетнуюЗаписьПоУмолчанию(Перечисления.eComm_СлужбыДоставки.НоваяПочта, ОрганизацияДокумента(), Неопределено);
		КонецЕсли;
		УчетнаяЗаписьПриИзмененииНаСервере();
		ЗаполнитьЗначенияСвойств(ОБъект, Параметры, ,"НаселенныйПунктОтправителя, ОтделениеОтправителя");
		
		Если НЕ Параметры.ОтправительПоУмолчанию тогда
		ЗаполнитьЗначенияСвойств(ОБъект, Параметры, "НаселенныйПунктОтправителя, ОтделениеОтправителя");
		КонецЕсли;
		
		Если НЕ Параметры.ОтправительПоУмолчанию 
			И ЗначениеЗаполнено(Параметры.ФизическоеЛицоОтправитель) тогда
			СтрКонтрагента = Новый Структура;
			СтрКонтрагента.Вставить("НаименованиеПолучателя", Параметры.ФизическоеЛицоОтправитель.Наименование);
			СтрИмени = ФизическиеЛицаКлиентСервер.ЧастиИмени(Параметры.ФизическоеЛицоОтправитель.Наименование);
			СтрКонтрагента.Вставить("Фамилия", СтрИмени.Фамилия);
			СтрКонтрагента.Вставить("Имя", СтрИмени.Имя);
			СтрКонтрагента.Вставить("Отчество", СтрИмени.Отчество);
			Телефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Параметры.ФизическоеЛицоОтправитель, Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица,ТекущаяДата());
			Телефон = ИнфралайнКлиентСервер.НормализованныйНомерТелефона(Телефон, Ложь);
			СтрКонтрагента.Вставить("Телефон", СтрЗаменить(Телефон,"+",""));
			
			Если НЕ Телефон = "" тогда
			ОБъект.ТелефонОтправителя = Телефон;
			ОБъект.Отправитель = eCommЗаполнениеДокументов.НайтиОтправителяЗаказа(ОБъект, СтрКонтрагента);
			Объект.КонтактноеЛицоОтправителя = eCommЗаполнениеДокументов.НайтиСоздатьКонтактноеЛицоКонтрагента(ОБъект.Отправитель, СтрКонтрагента);
            Конецесли;
			
		КонецЕсли;  
		
		Если Не Объект.ОтделениеОтправителя = Справочники.eComm_ОтделенияДоставки.ПустаяСсылка() и 
			    Объект.НаселенныйПунктОтправителя = Справочники.eComm_НаселенныеПунктыДоставки.ПустаяСсылка() Тогда
				Объект.НаселенныйПунктОтправителя = Объект.ОтделениеОтправителя.Владелец;
		КонецЕсли;		
		
		СтрКонтрагента = Новый Структура;
		Если параметры.ПолучательФИО = "" Тогда
			НаименованиеПолучателя = СокрЛП(параметры.ПолучательФамилия + " " + параметры.ПолучательИмя + " " + параметры.ПолучательОтчество);			
		Иначе
			НаименованиеПолучателя = параметры.ПолучательФИО;
		КонецЕсли;
		
		ОБъект.ТипПолучателя = Справочники.eComm_ОбщиеСправочники.НайтиПоНаименованию("Интернет Документ (Новая Почта)");		

		СтрКонтрагента.Вставить("НаименованиеПолучателя", НаименованиеПолучателя);
		СтрКонтрагента.Вставить("Телефон", параметры.ПолучательТелефон);  
		СтрКонтрагента.Вставить("Фамилия", параметры.ПолучательФамилия);
        СтрКонтрагента.Вставить("Имя", параметры.ПолучательИмя);
        СтрКонтрагента.Вставить("Отчество", параметры.ПолучательОтчество);
		
		ОБъект.Получатель = eCommЗаполнениеДокументов.НайтиПолучателяЗаказа(ОБъект, СтрКонтрагента);
		Объект.КонтактноеЛицоПолучателя = eCommЗаполнениеДокументов.НайтиСоздатьКонтактноеЛицоКонтрагента(ОБъект.Получатель, СтрКонтрагента);
	
		
		ОБъект.ТелефонПолучателя = параметры.ПолучательТелефон;
			
		ОБъект.АдресПолучателя = eCommЗаполнениеДокументов.НайтиАдресПолучателяЗаказа(ОБъект, параметры);
		//Если Не ОБъект.АдресПолучателя = Справочники.eComm_АдресаДоставки.ПустаяСсылка() Тогда
				
		Объект.ТипГруза = Справочники.eComm_ОбщиеСправочники.НайтиПоНаименованию("Parcel");
		Объект.КоличествоМест =1;
		Объект.ВидПлательщика = Справочники.eComm_ОбщиеСправочники.Recipient;
		Объект.ФормаОплаты = Справочники.eComm_ОбщиеСправочники.Cash;
		ОБъект.ЗачислятьНаIBAN = Истина;
	    ОБъект.ДокументОснование = Параметры.ОбъектВладелец;
		ОБъект.ДоставкаКурьером = Параметры.ДоставкаКурьером;
		eCommЗаполнениеДокументов.ЗаполнитьСтоимостьТоваров(ОБъект.ДокументОснование, ОБъект);
		
		ЗаполнитьОписание();
			
		ПрименитьИспользованиеПостоплаты(Объект);
		
	//	ЗаполнитьГородОтделениеНаСервере();
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		
		Если Параметры.Свойство("ЗначенияЗаполнения")
			И ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура")
			И Параметры.ЗначенияЗаполнения.Свойство("УчетнаяЗапись", Объект.УчетнаяЗапись)
			И ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда 
			// Учетную запись получили из ЗначенияЗаполнения
		Иначе             
			Объект.УчетнаяЗапись = eCommДоставкаСервер.ВернутьУчетнуюЗаписьПоУмолчанию(Перечисления.eComm_СлужбыДоставки.НоваяПочта, ОрганизацияДокумента(), Неопределено);
		КонецЕсли;
		
		ПрименитьИспользованиеПостоплаты(Объект);
		
		УчетнаяЗаписьПриИзмененииНаСервере();
		
		ЗаполнитьГородОтделениеНаСервере();
		
	Иначе
		
		НастройкиУчетнойЗаписи = Настройки(Объект.УчетнаяЗапись);
		
		ЗаполнитьСлужбуДоставки(НастройкиУчетнойЗаписи);
		УстановитьПараметрыВыбораТипГруза();
		
		НастройкиУчетнойЗаписи.ДанныеЗаполнения.Свойство("ОбъявленнаяСтоимостьПредоплаченныхЗаказов", ОбъявленнаяСтоимостьПредоплаченныхЗаказов);
		НастройкиУчетнойЗаписи.Настройки.Свойство("ЗаполнятьДополнительнуюИнформациюПоЗаказу", ЗаполнятьДополнительнуюИнформациюПоЗаказу);
		НастройкиУчетнойЗаписи.Настройки.Свойство("ЗаполнятьОбщийВесОбъемПоЗаказу", ЗаполнятьОбщийВесОбъемПоЗаказу);
		Если НастройкиУчетнойЗаписи.Настройки.Свойство("ИспользоватьАдресОтправителяНоваяПочтаСтрокой") Тогда 
			ИспользоватьАдресОтправителяНоваяПочтаСтрокой = НастройкиУчетнойЗаписи.Настройки.ИспользоватьАдресОтправителяНоваяПочтаСтрокой;
		Иначе
			ИспользоватьАдресОтправителяНоваяПочтаСтрокой = Истина;
		КонецЕсли;

	КонецЕсли;
	
	УстановитьВидимость();
	
	УстановитьДоступность();
	
	УстановитьПараметрыВыбораОтделениеПолучателя();
	
	ЗаполнитьОбъявленнуюСтоимость();
	
	ЗаполнитьСуммуПостОплаты();
	
	ОбновитьВесОбъем();
	
	ОбновитьСостояниеОтправкиSMS();
	
	ОбновитьДополнительнуюИнформацию();
	
	ОбновитьРеестр();

КонецПроцедуры

Процедура ЗаполнитьОписание()                                 

Если не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
КонецЕсли;
Объект.ДополнительнаяИнформация = "";		
Для каждого СтрТовар  из Объект.ДокументОснование.Товары Цикл;	
	Если СтрТовар.Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
		Продолжить;
	КонецЕсли;	   
	Если Не СтрТовар.Номенклатура.ТипНоменклатуры = перечисления.ТипыНоменклатуры.Товар Или 
		Не СтрТовар.Номенклатура.ТипНоменклатуры = перечисления.ТипыНоменклатуры.Набор
		Тогда
		Продолжить;
	КонецЕсли;	   
	Объект.ДополнительнаяИнформация = ?(Объект.ДополнительнаяИнформация="","",Объект.ДополнительнаяИнформация+"; ")  +СтрТовар.Номенклатура.НаименованиеПолное;
КОнецЦикла;	
Если Объект.ДополнительнаяИнформация="" Тогда
	Объект.ДополнительнаяИнформация="Оптичні товари";
КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьСтатусДокумента();
	
	Для Каждого СтрДопУслуги Из ТекущийОбъект.ДополнительныеУслуги Цикл 
		
		ИмяРеквизитаФормы = Справочники.eComm_ОбщиеСправочники.ПолучитьИмяПредопределенного(СтрДопУслуги.Услуга);
		
		Если ЗначениеЗаполнено(ИмяРеквизитаФормы) Тогда 
			ЭтаФорма[ИмяРеквизитаФормы] = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Модифицированность Тогда 
		
		ТекущийОбъект.ДополнительныеУслуги.Очистить();
		
		МассивДопУслуг = Новый Массив;
		МассивДопУслуг.Добавить("sms");
		МассивДопУслуг.Добавить("documentBack");
		МассивДопУслуг.Добавить("checkOnDelivery");
		//МассивДопУслуг.Добавить("transferPostPayToBankAccount");
		
		Для Каждого ЭлементМассива Из МассивДопУслуг Цикл 
			
			Если ЭтаФорма[ЭлементМассива] = Истина Тогда 
				
				НовСтр = ТекущийОбъект.ДополнительныеУслуги.Добавить();
				НовСтр.Услуга = Справочники.eComm_ОбщиеСправочники[ЭлементМассива];
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТекущийОбъект.УчетнаяЗапись.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		// Для Укрпочты отделение отправителя не используется, но участвует в общем функционале реестров
		// Очистим отделение если оно было заполнено (например для Новой почты)
		ТекущийОбъект.ОтделениеОтправителя = Неопределено;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(Объект.НомерТТН)
		И НЕ ЗначениеЗаполнено(Объект.Идентификатор) Тогда 
		// Номер ТТН введен вручную. Экспресс-накладная 
		// из учетной системы в личный кабинет не выгружалась
		
		УстановитьДоступность();
		
		Справочники.eComm_УчетныеЗаписиСлужбДоставки.ОбновитьСтатусы(eCommДоставкаСервер.Настройки(ТекущийОбъект.УчетнаяЗапись), Объект.Ссылка);
		
		eCommДоставкаСервер.ЗаполнитьСвязьЗаказ_Экспресснакладная(Объект.Ссылка, Объект.ДокументОснование);
		
		ЗаполнитьСтатусДокумента();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЭкспрессНакладнаяСоздана" 
		И Параметр = Объект.Ссылка Тогда 
		
		Прочитать();
		
		УстановитьДоступность();
		
		ЗаполнитьСтатусДокумента();
		
		ОбновитьРеестр();
		
	ИначеЕсли ИмяСобытия = "СообщениеSMSОтправлено" Тогда  
		
		ОбновитьСостояниеОтправкиSMS();
		
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ТехнологияДоставкиПриИзменении(Элемент)
	
	УстановитьВидимость();
	УстановитьПараметрыВыбораОтделениеПолучателя();
	
	Если СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.Justin") Тогда 
		
		НаселенныйПунктОтправителяJustinПриИзменении(Неопределено);
		НаселенныйПунктПолучателяJustinПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	Объект.УчетнаяЗапись = eCommДоставкаСервер.ВернутьУчетнуюЗаписьПоУмолчанию(СлужбаДоставки, ОрганизацияДокумента());
	УчетнаяЗаписьПриИзмененииНаСервере();
	КонтактноеЛицоОтправителяПриИзменении(Неопределено);
	УстановитьВидимость();
	
	ЗаполнитьОбъявленнуюСтоимость();
	ТипПостОплатыПриИзмененииНаСервере();
	ОбновитьСостояниеОтправкиSMS();
	ОбновитьВесОбъем();
	ОбновитьДополнительнуюИнформацию();
	ЗаполнитьГородОтделениеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УчетнаяЗаписьПриИзменении(Элемент)
	
	УчетнаяЗаписьПриИзмененииНаСервере();
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипГрузаПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПолучателяПриИзменении(Элемент)
	
	ТипПолучателяПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура НаселенныйПунктОтправителяJustinПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.НаселенныйПунктОтправителя)
		И eCommДоставкаСервер.ЭтоАдреснаяОтправка(Объект.ТехнологияДоставки) Тогда 
		
		СтруктураРеквизитов = Новый Структура("АдресныйЗабор");
		ЗначенияРеквизитов = eCommДоставкаСервер.ВернутьЗначенияРеквизитовСправочника(Объект.НаселенныйПунктОтправителя, СтруктураРеквизитов);
		Если НЕ ЗначенияРеквизитов.АдресныйЗабор = Истина Тогда 
			ТекстПредупреждения = НСтр("ru = 'Адресный забор не доступен в населенном пункте """ + Объект.НаселенныйПунктОтправителя + """'; 
										|uk = 'Адресний забір не доступний в населеному нункті """ + Объект.НаселенныйПунктОтправителя + """'");
			ПоказатьПредупреждение(, ТекстПредупреждения, , НСтр("ru = 'Адресный забор'; uk = 'Адресний забір'"));
			Объект.НаселенныйПунктОтправителя = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НаселенныйПунктПолучателяJustinПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.НаселенныйПунктПолучателя)
		И eCommДоставкаСервер.ЭтоАдреснаяДоставка(Объект.ТехнологияДоставки) Тогда 
		
		СтруктураРеквизитов = Новый Структура("АдреснаяДоставка");
		ЗначенияРеквизитов = eCommДоставкаСервер.ВернутьЗначенияРеквизитовСправочника(Объект.НаселенныйПунктПолучателя, СтруктураРеквизитов);
		Если НЕ ЗначенияРеквизитов.АдреснаяДоставка = Истина Тогда 
			ТекстПредупреждения = НСтр("ru = 'Адресный доставка не доступена в населенном пункте """ + Объект.НаселенныйПунктПолучателя + """'; 
										|uk = 'Адресна доставка не доступна в населеному нункті """ + Объект.НаселенныйПунктПолучателя + """'");
			ПоказатьПредупреждение(, ТекстПредупреждения, , НСтр("ru = 'Адресная доставка'; uk = 'Адресна доставка'"));
			Объект.НаселенныйПунктПолучателя = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактноеЛицоОтправителяПриИзменении(Элемент)
	
	КонтактноеЛицоОтправителяПриИзмененииНаСервере();
	
	ОтправительУкрПочтаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактноеЛицоПолучателяПриИзменении(Элемент)
	
	КонтактноеЛицоПолучателяПриИзмененииНаСервере();
	
	ПолучательУкрпочтаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура НесколькоМестПриИзменении(Элемент)
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура СписокМестСтрокойНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РедактироватьСписокМест", ЭтаФорма, Неопределено);
	
