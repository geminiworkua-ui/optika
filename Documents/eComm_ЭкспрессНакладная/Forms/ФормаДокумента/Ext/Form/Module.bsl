&НаКлиенте
Процедура ДекорацияЗаполнитьПоОснованиюНажатие(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда 
		Сообщить(НСтр("ru = 'Не выбран документ-основание!!!'; uk = 'Не вибраний документ-підстава!!!'"), СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	СтруктураКонтактногоЛица = Неопределено;
	
	КонтактноеЛицоНайдено = ПодобратьКонтактноеЛицоНаСервере(СтруктураКонтактногоЛица);
	
	Если Не КонтактноеЛицоНайдено Тогда 
		ОповещениеОВыборе = Новый ОписаниеОповещения("ВыполнитьПослеСозданияКонтакта", ЭтаФорма, Неопределено);
		ПараметрыОткрытия = Новый Структура("СтруктураКонтактногоЛица", СтруктураКонтактногоЛица);
		Если СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.НоваяПочта") Тогда 
			ПутьКФорме = "Обработка.eComm_НоваяПочта.Форма.ФормаСозданияКонтакта";
		ИначеЕсли СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.УкрПочта") Тогда 
			ПутьКФорме = "Обработка.eComm_УкрПочта.Форма.ФормаСозданияКонтакта";
			Если НЕ eCommДоставкаСервер.ЭтоАдреснаяДоставка(Объект.ТехнологияДоставки) Тогда 
				// Это доставка в отделение
				ПараметрыОткрытия.Вставить("ЭтоАдресОтделения", Истина);
			КонецЕсли;
		ИначеЕсли СлужбаДоставки = ПредопределенноеЗначение("Перечисление.eComm_СлужбыДоставки.Justin") Тогда	
		     ПутьКФорме = "Обработка.eComm_Justin.Форма.ФормаСозданияКонтакта";
		Иначе
			Возврат;
		КонецЕсли;
		ОткрытьФорму(ПутьКФорме, ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор, , , ОповещениеОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

