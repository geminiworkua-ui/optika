		Элементы.ГруппаУлицаНомерДомаОтправителяJustin.Видимость = ЭтоАдреснаяОтправка;
		
		// Блок получателя
		ЭтоАдреснаяДоставка = eCommДоставкаСервер.ЭтоАдреснаяДоставка(Объект.ТехнологияДоставки);
		Элементы.ОтделениеПолучателяJustin.Видимость 			= НЕ ЭтоАдреснаяДоставка;
		Элементы.ГруппаУлицаНомерДомаПолучателяJustin.Видимость	= ЭтоАдреснаяДоставка;

	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда
		
		Элементы.ГруппаДоставкаНоваяПочта.Видимость 			= Ложь;
		Элементы.ГруппаДоставкаУкрПочта.Видимость 				= Ложь;
		Элементы.ГруппаДоставкаJustin.Видимость 				= Ложь;
		Элементы.ГруппаДоставкаMeest.Видимость 					= Истина;
		Элементы.ГруппаКонтактОтправителяУкрпочта.Видимость		= Истина;
		
		Элементы.ГруппаОплатаНоваяПочта.Видимость 				= Ложь;
		Элементы.ГруппаОплатаУкрпочта.Видимость 				= Ложь;
		Элементы.ГруппаОплатаJustin.Видимость 					= Ложь;
		Элементы.ГруппаОплатаMeest.Видимость 					= Истина;
		
		Элементы.ГруппаДополнительныеУслугиУкрпочта.Видимость 	= Ложь;
		
		Элементы.ГруппаОбъем.Видимость 				= Ложь;
		Элементы.ГруппаДлина.Видимость 				= Истина;
