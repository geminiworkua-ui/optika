		Элементы.ГруппаУлицаНомерДомаПолучателя.Видимость	= ЭтоАдреснаяДоставка;
		
		УстановитьВидимостьУлицыПолучателя();
		
	ИначеЕсли СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда
		
		Элементы.ГруппаДоставкаНоваяПочта.Видимость 			= Ложь;
		Элементы.ГруппаДоставкаУкрПочта.Видимость 				= Ложь;
		Элементы.ГруппаДоставкаJustin.Видимость 				= Истина;
		Элементы.ГруппаДоставкаMeest.Видимость 					= Ложь;
		Элементы.ГруппаКонтактОтправителяУкрпочта.Видимость		= Истина;
		
		Элементы.ГруппаОплатаНоваяПочта.Видимость 				= Ложь;
		Элементы.ГруппаОплатаУкрпочта.Видимость 				= Ложь;
		Элементы.ГруппаОплатаJustin.Видимость 					= Истина;
		Элементы.ГруппаОплатаMeest.Видимость 					= Ложь;
		
		Элементы.ГруппаДополнительныеУслугиУкрпочта.Видимость 	= Ложь;
		
