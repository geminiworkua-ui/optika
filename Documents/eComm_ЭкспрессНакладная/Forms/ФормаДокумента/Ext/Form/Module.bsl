Функция ВернутьТекстЗапросаПоКонтактам(СтруктураНастроек)

	Если СтруктураНастроек.ИмяКонфигурации = "BASSmallBusiness" Тогда 
		ТекстЗапроса = ВернутьТекстЗапросаПоКонтактамУНФ(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ИмяКонфигурации = "BASУправлениеТорговлей" 
		ИЛИ СтруктураНастроек.ИмяКонфигурации = "BASERP" Тогда 
		ТекстЗапроса = ВернутьТекстЗапросаПоКонтактамУТBAS(СтруктураНастроек);
	ИначеЕсли СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда 
		ТекстЗапроса = ВернутьТекстЗапросаПоКонтактамУТП(СтруктураНастроек);
	Иначе
		ТекстЗапроса = "";
	КонецЕсли;
	
	Возврат ТекстЗапроса;

