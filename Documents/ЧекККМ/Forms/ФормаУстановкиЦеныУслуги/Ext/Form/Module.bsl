
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЭтоУслуга")
		Тогда
		Номенклатура = Параметры.Номенклатура;
		Цена = Параметры.Цена;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦену(Команда)
	
	П = Новый Структура("Номенклатура, Цена", Номенклатура, Цена);
	ЭтаФорма.Закрыть(П);
	
КонецПроцедуры
