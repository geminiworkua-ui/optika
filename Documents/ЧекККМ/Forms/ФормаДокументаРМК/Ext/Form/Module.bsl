&НаКлиенте
Процедура СписокЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ТекСтр = Элементы.СписокЗаказов.ТекущиеДанные;
	
	Если Поле.Имя = "СписокЗаказовНомерКартинкиОтгузки" Тогда
		СтандартнаяОбработка = Ложь;
		П = Новый Структура;
		П.Вставить("ЗаказКлиента",ТекСтр.Ссылка);
		П.Вставить("Склад", Объект.Склад);
		ОписаниеОповещения5  = Новый ОписаниеОповещения("ВыполнитьОповещение5",ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ПодборТоваровКОтгрузке", П,,,,,ОписаниеОповещения5,);  	
		
	ИначеЕсли Поле.Имя = "СписокЗаказовНомерКартинкиОплаты" И ТекСтр.ЭтоОсмотрВрача Тогда
		СтандартнаяОбработка = Ложь;
		
		П = Новый Структура ("Ссылка");
		П.Ссылка = ТекСтр.Ссылка;
		
		ПеренестиЗаказВЧек(П);
		
				
		Объект.Партнер = ТекСтр.Партнер;
		Объект.ДокументОснование = ТекСтр.Ссылка;
		
		П = Новый Структура("ДО");
		П.ДО = Объект.ДокументОснование;
		
		Если ЗначениеЗаполнено(Объект.ДокументОснование) И Не КлючКарточкаКлиента(П) = Неопределено Тогда
			Элементы.ГруппаВызовРекомендацииВрача.Видимость = Истина
		Иначе
			Элементы.ГруппаВызовРекомендацииВрача.Видимость = Ложь
		КонецЕсли;
		
		ЭтаФорма.Элементы.ГруппаПродажаИВозврат.ТекущаяСтраница = Элементы.ГруппаПродажа;
		
		ПроверимНаличиеТоваровПодОбеспечение();

		
	ИначеЕсли Поле.Имя = "СписокЗаказовНомерКартинкиОплаты" И НЕ ТекСтр.ЭтоОсмотрВрача Тогда
		СтандартнаяОбработка = Ложь;
		ТекущийДокумент = ТекСтр.Ссылка;
		ПараметрыРасчета = Новый  Структура;
		ПараметрыРасчета.Вставить("ЗаказКлиента",ТекущийДокумент);
		ПараметрыРасчета.Вставить("Склад",ОтборСклад);  
		ОповещениеОПодборе = Новый ОписаниеОповещения("ПолучениеТаблицыЧеков", ЭтотОбъект);
		ОстаткиКОплате.Очистить();
		ОткрытьФорму("ОбщаяФорма.ПодборСуммКОплате", ПараметрыРасчета,	ЭтотОбъект,
		ТекущийДокумент.УникальныйИдентификатор(),,,ОповещениеОПодборе);
		Элементы.ГруппаПродажаИВозврат.ТекущаяСтраница = Элементы.ГруппаПродажа;
		
		//ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение2",ЭтотОбъект);
		//ОткрытьФорму("Документ.ВыполнениеПроцедуры.ФормаОбъекта", П,,,,,ОписаниеОповещения,);  
		
	Иначе 
		
		П = Новый Структура("Ключ", ТекСтр.Ссылка);
		ОткрытьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", П);
		
	КонецЕсли;
	
КонецПроцедуры

