
&НаКлиенте
Перем КэшированныеЗначения;//используется механизмом обработки изменения реквизитов ТЧ

&НаКлиенте
Перем ТекущиеДанныеИдентификатор; //используется для передачи текущей строки в обработчик ожидания

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	Если Не ОбщегоНазначения.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	// СтандартныеПодсистемы.Печать
	УправлениеПечатью.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ПодменюПечать);
	// Конец СтандартныеПодсистемы.Печать
	
	// Обработчик подсистемы "Внешние обработки"
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтотОбъект);
	
	ИспользоватьАвтоматическиеСкидкиВПродажах = ПолучитьФункциональнуюОпцию("ИспользоватьАвтоматическиеСкидкиВПродажах");
	ИспользоватьРучныеСкидкиВПродажах         = ПолучитьФункциональнуюОпцию("ИспользоватьРучныеСкидкиВПродажах");
	НазначатьСкидкиПоКнопкеРасчетВЧекеККМ     = ПолучитьФункциональнуюОпцию("НазначатьСкидкиПоКнопкеРасчетВЧекеККМ");
	ИспользоватьОплатуПлатежнымиКартами       = ПолучитьФункциональнуюОпцию("ИспользоватьОплатуПлатежнымиКартами");
	ИспользоватьПодарочныеСертификаты         = ПолучитьФункциональнуюОпцию("ИспользоватьПодарочныеСертификаты");
	ИспользоватьХарактеристикиНоменклатуры    = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	ИспользоватьНесколькоСкладов              = ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоСкладов");
	ИспользоватьКартыЛояльности               = ПолучитьФункциональнуюОпцию("ИспользоватьКартыЛояльности");
    
	ИспользоватьРасширеннуюФормуПодбораКоличестваИВариантовОбеспечения = ПолучитьФункциональнуюОпцию("ИспользоватьРасширеннуюФормуПодбораКоличестваИВариантовОбеспечения");	
	
	ИспользоватьОграниченияРучныхСкидок       = ПолучитьФункциональнуюОпцию("ИспользоватьОграниченияРучныхСкидокВПродажахПоПользователям") 
	                                            Или ПолучитьФункциональнуюОпцию("ИспользоватьОграниченияРучныхСкидокВПродажахПоСоглашениям");
	
	КонтролироватьАссортимент                 = АссортиментСерверПовтИсп.КонтролироватьАссортимент(Объект.Склад, Объект.Дата);
	
	ПоддерживаемыеТипыПодключаемогоОборудования = "СканерШтрихкода,
	                                              |ДисплейПокупателя,
	                                              |ФискальныйРегистратор,
	                                              |ЭквайринговыйТерминал,
	                                              |ЭлектронныеВесы,
	                                              |СчитывательМагнитныхКарт";
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтотОбъект, "");
	РозничныеПродажи.ЗаполнитьТаблицуОборудование(ЭтотОбъект, ПоддерживаемыеТипыПодключаемогоОборудования);
	
	СчитыватьКартуЛояльности = Истина;
	
	// +y.surai Assino 2026.08.01
	//Если ИспользоватьПодключаемоеОборудование Тогда
	Если Не Параметры.Свойство("ibs_ТекущаформаЧекККМ") И ИспользоватьПодключаемоеОборудование Тогда
	// -y.surai Assino 2026.08.01
		ОборудованиеПодключено = МенеджерОборудованияВызовСервера.ПолучитьСписокОборудования(
			Неопределено,
			Неопределено,
			МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента()).Количество() > 0;
		ЗначениеОткрыватьФормуСПодключеннымОборудованием = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
			"ЧекККМ", "ОткрыватьФормуСПодключеннымОборудованием");
		Если ЗначениеОткрыватьФормуСПодключеннымОборудованием = Неопределено Тогда
			ОткрыватьФормуСПодключеннымОборудованием = ОборудованиеПодключено;
		Иначе
			ОткрыватьФормуСПодключеннымОборудованием = ЗначениеОткрыватьФормуСПодключеннымОборудованием И ОборудованиеПодключено;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ПодакцизныеТоварыДляКоммерческогоИспользования.Пометка = Объект.ПодакцизныеТоварыДляКоммерческогоИспользования;
	
	УстановитьЗначенияПоНастройкам();
	
	ПриСозданииЧека();
	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);   
	
	СменаОткрыта = Перечисления.СтатусыКассовойСмены.Открыта;
	
	Список.Параметры.УстановитьЗначениеПараметра("БезПодключенияОборудования", Не ИспользоватьПодключаемоеОборудование);
    СписокЗаказов.Параметры.УстановитьЗначениеПараметра("ДатаАктуальности", ТекущаяДата());  
    СписокЧековККМ.Параметры.УстановитьЗначениеПараметра("БезПодключенияОборудования", Не ИспользоватьПодключаемоеОборудование); 
	СписокЧековККМНаВозврат.Параметры.УстановитьЗначениеПараметра("БезПодключенияОборудования", Не ИспользоватьПодключаемоеОборудование); 
	
	Список.Отбор.Элементы.Очистить();
    ГруппаОтбораСписка = Список.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
 
    ГруппаОтбораСписка.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
    ЭлементОтбораСписка = ГруппаОтбораСписка.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КассаККМ");
	ЭлементОтбораСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбораСписка.ПравоеЗначение = Объект.КассаККМ;
	 
	
	СписокЧековККМ.Отбор.Элементы.Очистить();
    ГруппаОтбораСпискаЧековККМ = СписокЧековККМ.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
 
    ГруппаОтбораСпискаЧековККМ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
    ЭлементОтбораСпискаЧековККМ = ГруппаОтбораСпискаЧековККМ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораСпискаЧековККМ.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КассаККМ");
	ЭлементОтбораСпискаЧековККМ.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбораСпискаЧековККМ.ПравоеЗначение = Объект.КассаККМ;
	
	СписокЧековККМНаВозврат.Отбор.Элементы.Очистить();
    ГруппаОтбораСпискаЧековККМНаВозврат = СписокЧековККМНаВозврат.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
 
    ГруппаОтбораСпискаЧековККМНаВозврат.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
    ЭлементОтбораСпискаЧековККМНаВозврат = ГруппаОтбораСпискаЧековККМНаВозврат.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораСпискаЧековККМНаВозврат.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КассаККМ");
	ЭлементОтбораСпискаЧековККМНаВозврат.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбораСпискаЧековККМНаВозврат.ПравоеЗначение = Объект.КассаККМ;	
		
	//ВыводКнопок печати на форму РМК    
	// Заказ клиента
    КомандыПечати = ПолучитьИзВременногоХранилища(АдресКомандПечатиВоВременномХранилище);
	
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		
		ИмяКнопки = КомандаПечати.ИмяКоманды;
		Если ЭтаФорма.Команды[ИмяКнопки] =Неопределено Тогда
			НоваяКоманда = ЭтаФорма.Команды.Добавить(ИмяКнопки);
			НоваяКоманда.Действие = "Подключаемый_ОбработатьКомандуПечати";
			НоваяКоманда.Заголовок = КомандаПечати.Заголовок;
			НоваяКоманда.Отображение = ОтображениеКнопки.Текст;
		Иначе 
			НоваяКоманда =ЭтаФорма.Команды[ИмяКнопки];
		КонецЕсли;  
		
		Если НоваяКоманда.Заголовок = НСтр("ru='Товарный чек (термопринтер)';uk='Товарний чек (термопринтер)'") 
		Тогда 
			НоваяКнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы.ГруппаПечать);
		    НоваяКнопка.Высота = 1;
			НоваяКнопка.Ширина = 3;  
		ИначеЕсли НоваяКоманда.Заголовок = НСтр("ru='Заказ клиента (термопринтер)';uk='Замовлення клієнта (термопринтер)'") Тогда
			НоваяКнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы.ГруппаЗаказа);
			НоваяКнопка.Высота = 1;
			НоваяКнопка.Ширина = 3;
		Иначе
			Продолжить;
		КонецЕсли;
		
		НоваяКнопка.ИмяКоманды = НоваяКоманда.Имя;
		НоваяКнопка.Отображение = ОтображениеКнопки.Картинка;
		
		//НоваяКнопка.Картинка = БиблиотекаКартинок.Печать;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяКнопка, "РастягиватьПоГоризонтали") Тогда
			НоваяКнопка.РастягиватьПоГоризонтали = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	ИнициализацияФормы();
	
	// + Боков
	
	ТоварыКОтгрузке.Параметры.УстановитьЗначениеПараметра("СкладОтправитель", Объект.Склад);   
//	СписокПриемаВрачей.Параметры.УстановитьЗначениеПараметра("ДеньПриема", ТекущаяДата());
	СписокЗаказов.Параметры.УстановитьЗначениеПараметра("Склад", Объект.Склад);
	СписокЗаказов.Параметры.УстановитьЗначениеПараметра("СтатусЗакрыт", Перечисления.СтатусыЗаказовКлиентов.Закрыт);
	СписокСогласованияЗамены.Параметры.УстановитьЗначениеПараметра("Склад", Объект.Склад);
	
	МестоПриемаВрача = ОБъект.Склад.Подразделение;
	Регион = МестоПриемаВрача.Регион;
	СписокПриемаВрачей.Параметры.УстановитьЗначениеПараметра("Регион", Регион);
	СписокПриемаВрачей.Параметры.УстановитьЗначениеПараметра("МестоПРиема", МестоПриемаВрача);
	//СписокПриемаВрачей.Параметры.УстановитьЗначениеПараметра("ТекущееВремя", ТекущаяДата());
	//СписокПриемаВрачей.Параметры.УстановитьЗначениеПараметра("ЕстьОтборПоДате", Ложь);
	//СписокПриемаВрачей.Параметры.УстановитьЗначениеПараметра("ДатаПриема", ТекущаяДата());
	
	//СписокПриемаВрачей.Параметры.УстановитьЗначениеПараметра("ДатаПриема", '2023.01.01');
	//СписокПриемаВрачей.Параметры.УстановитьЗначениеПараметра("Врач", Врач);
		// 	
	
	ТоварыКПолучениюТолькоКПолучению = Истина;
	ТоварыКОтгрузкеТолькоКОтгрузке = Истина;  
	
	ТоварыКОтгрузке.Параметры.УстановитьЗначениеПараметра("ТолькоКотгрузке", Истина);
	
	СписокТоварыКПолучению.Параметры.УстановитьЗначениеПараметра("ТолькоКПолучению", Истина);
	СписокТоварыКПолучению.Параметры.УстановитьЗначениеПараметра("СтатусПолучено", Перечисления.СтатусыПеремещенийТоваров.Принято);
	СписокТоварыКПолучению.Параметры.УстановитьЗначениеПараметра("СкладПолучатель", Объект.Склад);
	
	Элементы.ГруппаИнфоПоПартнеру.Видимость = Ложь;
	
	ЗаполнитьПараметрыСписковВыбораРасписания();
	
	СписокТабели.Параметры.УстановитьЗначениеПараметра("Подразделение", ОБъект.Склад.Подразделение);
	
	СписокЗаказов.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗакрытые", ПоказыватьЗакрытыеЗаказы);
	
	
	ПериодЧеков.ДатаНачала = началодня(ТекущаяДата());
	ПериодЧеков.ДатаОкончания = КонецДня(ТекущаяДата());
	
	СписокЧеков.Параметры.УстановитьЗначениеПараметра("Склад", Объект.Склад);
	СПисокЧеков.Параметры.УстановитьЗначениеПараметра("ДатаНач", ПериодЧеков.ДатаНачала);
	СПисокЧеков.Параметры.УстановитьЗначениеПараметра("ДатаКон", КонецДня(ПериодЧеков.ДатаОкончания));
	
	// - БОков
	
	//ЗаполнитьСпискиВыбораЗаписей(Регион, МестоПриемаВрача, Врач, ДатаПриемаОтбор);
	БлокировкаРаботы();
	
КонецПроцедуры

Процедура БлокировкаРаботы()
	КассыРМК = ПолучитьКассыРМК();       
	ЗаблокироватьРаботу = Ложь;  
	Если КассыРМК.Количество()=0 Тогда
		ЗаблокироватьРаботу = Истина;
		СостояниеСмены = "Каса не налаштована";
	КонецЕсли;
	// + Боков
	СписокККМточки.Очистить();  // 
	// - Боков
	Для каждого Касс из КассыРМК Цикл
 //
		
		СостояникКассовойСмены  =Розничныепродажи.ПолучитьСостояниеКассовойСмены(Касс);
		
		
		Если СостояникКассовойСмены.Ошибка24Часа Тогда
			 СостояниеСмены  ="Касова зміна відкрита більше 24 годин!";
			 СостояниеСменыПредставление  ="Касова зміна відкрита більше 24 годин !!!";

			 ЗаблокироватьРаботу = Истина;                                                                                       
			 //Прервать;
		 
		ИначеЕсли  СостояникКассовойСмены.СтатусКассовойСмены = Перечисления.СтатусыКассовойСмены.Закрыта Или  
			СостояникКассовойСмены.СтатусКассовойСмены = Перечисления.СтатусыКассовойСмены.ЗакрытаЧекиЗаархивированы Тогда
			СменаОткрыта = Перечисления.СтатусыКассовойСмены.Закрыта;
			СостояниеСмены ="Касова зміна не відкрита на всіх ФР!";
			СостояниеСменыПредставление ="Касова зміна не відкрита!";
		    ЗаблокироватьРаботу = Истина;
		//	Прервать;
			
			
		Иначе
		// + Боков Выведем результат проверки в отдельную вкладку
			СостояниеСменыПредставление = "Касова зміна відкрита!"; 
		// - Боков
			
		КонецЕсли; 
	
		// + Боков	
		НовСтр = СписокККМточки.Добавить(); //
		НовСтр.КассаККМ = Касс;	           
		НовСтр.СостояниеКассовойСмены = строка(СостояниеСменыПредставление);
	    // - Боков
		
	КонецЦикла;	  
	
	Если Не ЗаблокироватьРаботу Тогда
			СменаОткрыта = Перечисления.СтатусыКассовойСмены.Открыта;
			СостояниеСмены ="Касові зміни відкрити";
			Элементы.СостояниеСмены.ЦветТекста = WebЦвета.ТемноЗеленый;
	Иначе
		СостояниеСмены ="Касові зміни НЕ відкрити";
		Элементы.СостояниеСмены.ЦветТекста = WebЦвета.Красный;
	КонецЕсли;


КОнецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыСписковВыбораРасписания()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КадроваяРасстановкаСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	РегистрСведений.КадроваяРасстановка.СрезПоследних(&ТекДата, ) КАК КадроваяРасстановкаСрезПоследних
	|ГДЕ
	|	КадроваяРасстановкаСрезПоследних.Должность.ЭтоВрач
	|
	|СГРУППИРОВАТЬ ПО
	|	КадроваяРасстановкаСрезПоследних.ФизическоеЛицо";
	Запрос.УстановитьПараметр("Текдата", Текущаядата());
		
	Выборка = Запрос.Выполнить().Выбрать();
	МассивВрачей = новый Массив;
	Пока Выборка.Следующий() цикл
	    МассивВрачей.Добавить(Выборка.ФизическоеЛицо);
	КонецЦикла;
	
	Элементы.врач.СписокВыбора.Очистить();
	Элементы.Врач.СписокВыбора.ЗагрузитьЗначения(МассивВрачей);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КадроваяРасстановкаСрезПоследних.Подразделение.Регион КАК Регион
	|ИЗ
