	Если КПолучению > 0 Тогда
		Текст = "До отримання (" + Строка(КПолучению) + ")";
		Цвет = WebЦвета.Золотой;
	Иначе
		Текст = "До отримання (немає)";
		Цвет = WebЦвета.ЗеленоватоЖелтый;
	КонецЕсли;	

	Элементы.ТоварыКПоступлению.Заголовок = Текст;
    Элементы.ТоварыКПоступлению.ЦветТекстаЗаголовка = Цвет;

