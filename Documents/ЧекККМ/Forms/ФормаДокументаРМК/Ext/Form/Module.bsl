&НаКлиенте
Процедура РаписаниеПриемаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтр = Элементы.СписокПриемаВрачей.ТекущиеДанные;
	
	Если НЕ ТекСтр.ЕстьБронь 
		Тогда
		
		Если ЗначениеЗаполнено(ТекСтр.ЗаписьНаПрием)
			Тогда
			
			П = Новый Структура("Ключ", ТекСтр.ЗаписьНаПрием);
			
			ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
			ОткрытьФорму("Документ.ЗаписьНаПрием.Форма.ФормаДокумента",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
			//	ОткрытьЗначение(ТекСтр.ДокументЗаписи)
			
		Иначе
			//ТекСтр.Актуально = Истина
			//Тогда
			П = Новый Структура;
			П.Вставить("НомСтр",ТекСтр.КодСтроки); 
			П.Вставить("Основание",ТекСтр.Регистратор);
			П.Вставить("ФизическоеЛицо", ТекСтр.Врач);
			П.Вставить("Подразделение", ТекСтр.МестоПриема);
			П.Вставить("ВремяНачала", ТекСтр.НачалоПриема);
			П.Вставить("ВремяОкончания", ТекСтр.ОкончаниеПриема);
			П.Вставить("Должность", ТекСтр.Должность); 
			П.Вставить("ВызовИзЧекаККМ", Истина);
			П.Вставить("Клиент", Объект.Партнер);
					
			
			ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
			ОткрытьФорму("Документ.ЗаписьНаПрием.Форма.ФормаДокумента",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
			//Иначе
			//	Текст = "ru = 'Выбранная строка записи не актуальна ((невозможна дл язаписи) на прием'; uk = 'Обрана строка не актуальна (непридатна для запису на прийом)'";
			//	Сообщить(Нстр(Текст));
		КонецЕсли;
		
	Иначе
		Сообщить("Запис на обраний час неможлива: в дланий час здійснюється запис на обраний час. Спробуйте пізніше");
	КонецЕсли;
	
КонецПроцедуры

