Функция СформироватьЗаказ(Прецепта)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Заказ = Документы.ЗаказКлиента.СоздатьДокумент();
	Заказ.Менеджер = ПараметрыСеанса.АвторизованныйПользователь; 
	Заказ.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();     
	Заказ.Валюта = объект.Валюта;
	Заказ.Склад = Объект.Склад;  
	Заказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Заказ.Партнер = Объект.Партнер;                   
	Заказ.КартаЛояльности = Объект.КартаЛояльности;
	
	Объект.ИспользоватьОплатуБонуснымиБаллами = ЗначениеЗаполнено(Заказ.КартаЛояльности);   //Olga
	
	Заказ.Контрагент = ?(Заказ.КартаЛояльности.Контрагент = Справочники.Контрагенты.ПустаяСсылка(), бит_сервер.НайтиКонтрагента(Объект.Партнер),Заказ.КартаЛояльности.Контрагент);
	Заказ.Подразделение = Объект.Склад.Подразделение;
	Заказ.Касса = КассаПодразделения(Заказ.Подразделение);
	Заказ.БанковскийСчет = СчетПодразделения(Заказ.Подразделение);
	Заказ.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным;
	Заказ.Дата = ТекущаяДата();
	Заказ.Номер = "";
	Заказ.ДатаОтгрузки = бит_сервер.ДатаОтгрузки(Заказ);
	Заказ.ЖелаемаяДатаОтгрузки = бит_сервер.ЖелаемаяДатаОтгрузки(Заказ);
	Заказ.Статус = бит_Сервер.СтатусЗаказа(Заказ);   
	Заказ.Приоритет = Справочники.Приоритеты.ПолучитьПриоритетПоУмолчанию(Неопределено );
	Заказ.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	// +y.surai Assino 2026.08.01
	//Заказ.Врач = ОБъект.Врач;
	Заказ.ibs_ПостороннийВрач = Объект.Врач;
	
	М = Новый Массив;
	Для каждого Стр из Объект.Товары цикл
		М.Добавить(Стр.Номенклатура);
	КонецЦикла;
	Заказ.ibs_Мастер = ?(ЕстьРаботаМастера(М), ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо, Справочники.ФизическиеЛица.ПустаяСсылка());
	// -y.surai Assino 2026.08.01
	
	// заполним данные по рецепту на очки
	Если НЕ Прецепта = Неопределено
		Тогда
		ЗаполнитьЗначенияСвойств(Заказ, Прецепта);
	КонецЕсли;
	//
	
	Для каждого Стр из объект.Товары Цикл
		
		// Анализируем остатки попозиционно.
		// логика.
		// есть весь товар есть на своб обстатке - все резервируем.
		// если есть частично - делим строки. Что есть - резервируем, чего нет - заказываем.
		// Если ничего - всё заказываем
		
		Запрос = новый Запрос;
		Запрос.Текст = ("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0) КАК ЕстьСвобОстаток
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки КАК СвободныеОстаткиОстатки
		|ГДЕ
		|	СвободныеОстаткиОстатки.Номенклатура = &Номенклатура
		|	И СвободныеОстаткиОстатки.Характеристика = &Характеристика
		|	И СвободныеОстаткиОстатки.Склад = &Склад");
		Запрос.УстановитьПараметр("Номенклатура",Стр.Номенклатура);
		Запрос.УстановитьПараметр("Характеристика",Стр.Характеристика);
		Запрос.УстановитьПараметр("Склад",Объект.Склад);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() тогда
			ЕстьСвобОстаток = Выборка.ЕстьСвобОстаток;
		Иначе
			ЕстьСвобОстаток = 0;
		КонецЕсли;
		
		Если 
			Стр.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга 
			ИЛИ
			Стр.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа
			Тогда
			СтрЗаказа = Заказ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрЗаказа, Стр);
			СтрЗаказа.Склад = Объект.склад;
			СтрЗаказа.ДатаОтгрузки = бит_сервер.ДатаОтгрузки(Заказ);
			СтрЗаказа.СрокПоставки =1;     
			СтрЗаказа.ВидЦены = Объект.ВидЦены;    
			СтрЗаказа.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется;
			СтрЗаказа.СуммаСНДС = СтрЗаказа.Сумма; 
									
		Иначе 
			СтрЗаказа = Заказ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрЗаказа, Стр);
			СтрЗаказа.ВариантИсточникаОбеспечения = Стр.СкладИсточник;
			СтрЗаказа.Склад = Объект.склад;
			СтрЗаказа.ДатаОтгрузки = бит_сервер.ДатаОтгрузки(Заказ);
			СтрЗаказа.СрокПоставки =1;     
			СтрЗаказа.ВидЦены = Объект.ВидЦены;    
			СтрЗаказа.СуммаСНДС = СтрЗаказа.Сумма;
			
			Если 
				Стр.СкладИсточник = справочники.ВариантыИсточниковОбеспечения.ИзНаличия
				Тогда
				СтрЗаказа.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
			Иначе			
				СтрЗаказа.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно
			КонецЕсли;	
			
		КонецЕсли;

		СтрЗаказа.Продавец = ТекущийПродавец;
		СтрЗаказа.КлючСвязи = Стр.Ключсвязи;
		СтрЗаказа.СуммаАвтоматическойСкидки = Стр.СуммаАвтоматическойСкидки;
		СтрЗаказа.ПроцентАвтоматическойСкидки = Стр.ПроцентАвтоматическойСкидки;
		 
	КонецЦикла; 
	
	Заказ.Менеджер = ТекущийПродавец;
	
	Для каждого стр из Объект.СкидкиНаценки Цикл 
		СтрСк = Заказ.СкидкиНаценки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрСк, Стр);
	КонецЦикла;	    
	Заказ.СкидкиРассчитаны =  Объект.СкидкиРассчитаны;
	
	Заказ.СуммаДокумента = Заказ.Товары.Итог("Сумма") - Заказ.Товары.Итог("СуммаАвтоматическойСкидки") - Заказ.Товары.Итог("СуммаРучнойСкидки");
	
	//
	СтрГрафика = Заказ.ЭтапыГрафикаОплаты.Добавить();
	СтрГрафика.ВариантОплаты  = Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки;
	СтрГрафика.ДатаПлатежа = ТекущаяДата();
	СтрГрафика.ПроцентПлатежа = 100.0;
	СтрГрафика.СуммаПлатежа = Заказ.СуммаДокумента;
	// Боков
	Заказ.Номер ="";
	Попытка
		Заказ.Записать(РежимЗаписиДокумента.Проведение);
		
		//Сформируем ЗаказыНаПеремещение, под которые надо сформировать.
		
		ПП = Новый Структура;
		ПП.Вставить("Склад", Объект.Склад);
		ПП.Вставить("ЗаказКлиента", Заказ); 
		ПП.Вставить("Автор", Заказ.Менеджер);
		
		М = Новый Массив;
		
		НеобходимоФормировать = Ложь;
		Для каждого Стр из Заказ.Товары Цикл
			Если 
				Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно
				Тогда
				П = Новый Структура;
				П.Вставить("Номенклатура",Стр.Номенклатура);
				П.Вставить("Характеристика",Стр.Характеристика);
				П.Вставить("Количество",Стр.Количество);
				П.Вставить("КоличествоУпаковок",Стр.КоличествоУпаковок);
				П.Вставить("ВариантИсточникаОбеспечения", Стр.ВариантИсточникаОбеспечения);
				П.Вставить("Упаковка", Стр.Упаковка);				
				М.Добавить(П);
				НеобходимоФормировать = Истина;
			КонецЕсли;
		КонецЦикла;
		
		ПП.Вставить("М", М);
		
		Если НеобходимоФормировать = Истина
			Тогда
			Рез = Инфра_ОбщиеМодули.СоздатьЗаказНаПеремещениеПодОбеспечениеПодПараметры(ПП);
			Если НЕ Рез =  Истина
				Тогда
				Заказ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Сообщить("Формування замовлення клієнта скасовано");			
				Возврат Документы.ЗаказКлиента.ПустаяСсылка(); 
			КонецЕсли;
			КонецЕсли;

		Исключение 
		Заказ.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);    	
	
	Возврат Заказ.Ссылка; 

КонецФункции	


&НаСервере
Функция СформироватьРеализация(ЗаказКлиента)
	
	ЗаказКлиента = Неопределено;
	Номенклатура = Неопределено;
	Характеристика = Неопределено;
	Отгружаем =  Неопределено;
	М = Неопределено;
    М = Новый Массив;
	
	//Для Инд = 0 по М.Количество();
		
		
	Реализация = документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Реализация.Менеджер = ПараметрыСеанса.АвторизованныйПользователь; 
	Реализация.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();     
	Реализация.Валюта = объект.Валюта;
	Реализация.Склад = Объект.Склад;  
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Партнер = Объект.Партнер;                   
	Реализация.КартаЛояльности = ЗаказКлиента.КартаЛояльности;
	Реализация.Контрагент = ?(ЗаказКлиента.КартаЛояльности.Контрагент = Справочники.Контрагенты.ПустаяСсылка(), бит_сервер.НайтиКонтрагента(Объект.Партнер),ЗаказКлиента.КартаЛояльности.Контрагент);
	Реализация.Подразделение = Объект.Склад.Подразделение;
	Реализация.Касса = КассаПодразделения(ЗаказКлиента.Подразделение);
	Реализация.БанковскийСчет = СчетПодразделения(ЗаказКлиента.Подразделение);
	Реализация.ПорядокРасчетов = перечисления.ПорядокРасчетов.ПоЗаказамНакладным;
	Реализация.Дата = ТекущаяДата();
	Реализация.ДатаОтгрузки = бит_сервер.ДатаОтгрузки(ЗаказКлиента);
	Реализация.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
	Реализация.ЗаказКлиента = ЗаказКлиента;
	Реализация.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	
	Док = ЗаказКлиента.ПолучитьДокумент();
	//  Утсновим Статус отгрузки по товарам к отгрузке
	Для каждого Стр из Док.Товары Цикл
		Если Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада
			И
			НЕ Стр.ОТменено
			Тогда
			Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Док.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
	СуммаДокумента = 0;
	Для каждого СтрЗаказа из Док.Товары Цикл
		Если СтрЗаказа.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить
			И
			НЕ СтрЗаказа.ОТменено
			Тогда
			СтрРеализации = Реализация.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрРеализации, СтрЗаказа);
			СуммаДокумента = СуммаДокумента + СтрЗаказа.Сумма;
		КонецЕсли;			
	КонецЦикла;
	
	Реализация.СуммаДокумента = СуммаДокумента;
	Реализация.СуммаВзаиморасчетов = СуммаДокумента;
	
	Попытка
		Реализация.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Реализация.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
	Возврат Реализация.Ссылка;
КонецФункции

&НаСервере
Функция КассаПодразделения(Подразделение)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Кассы.Ссылка
	|ИЗ
	|	Справочник.Кассы КАК Кассы
	|ГДЕ
	|	НЕ Кассы.ПометкаУдаления
	|	И Кассы.Владелец = &Владелец
	|	И Кассы.Подразделение = &Подразделение");
Запрос.УстановитьПараметр("Владелец", Справочники.Организации.ОрганизацияПоУмолчанию());
Запрос.УстановитьПараметр("Подразделение", Подразделение);
Результат = Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	Возврат Результат.ссылка;
КонецЕсли;	
КонецФункции	

&НаСервере
Функция СчетПодразделения(Подразделение)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	БанковскиеСчетаОрганизаций.Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
	|ГДЕ
	|	НЕ БанковскиеСчетаОрганизаций.ПометкаУдаления
	|	И БанковскиеСчетаОрганизаций.Владелец = &Владелец
	|	И БанковскиеСчетаОрганизаций.Подразделение = &Подразделение");
Запрос.УстановитьПараметр("Владелец", Справочники.Организации.ОрганизацияПоУмолчанию());
Запрос.УстановитьПараметр("Подразделение", Подразделение);
Результат = Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	Возврат Результат.ссылка;
КонецЕсли;
КонецФункции	

&НаКлиенте
Процедура ОплатитьНаличными(Команда)
	
	Объект.Дата = ТекущаяДата();
	
	ВыбраннаяФормаОплаты = Новый Структура;
	ВыбраннаяФормаОплаты.Вставить("Наличные",              Истина);
	ВыбраннаяФормаОплаты.Вставить("БонусныеБаллы",         Ложь);
	ВыбраннаяФормаОплаты.Вставить("ПлатежныеКарты",        Ложь);
