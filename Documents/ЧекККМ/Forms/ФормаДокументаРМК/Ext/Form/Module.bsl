 	ПараметрыОткрытия = Новый Структура(
		"НеИспользоватьРучнойВвод, НеПодключатьОборудование",
		Не ПраваДоступа.ИзменениеКартЛояльности, Истина);
	
	ОткрытьФорму(
		"Справочник.КартыЛояльности.Форма.СчитываниеКартыЛояльности",
		ПараметрыОткрытия,
		ЭтотОбъект,
