&НаКлиенте
Процедура ПроверимНаличиеТоваровПодОбеспечение()
	
	М = Новый Массив;
	Для каждого Стр из Объект.Товары цикл
		
		П = Новый структура;
		П.Вставить("НомерСтроки", Стр.НомерСтроки);
		П.Вставить("Номенклатура", Стр.Номенклатура);
		П.Вставить("Характеристика", Стр.Характеристика);
		П.Вставить("КоличествоУпаковок", Стр.КоличествоУпаковок);
		П.Вставить("СкладИсточник", Стр.СкладИсточник);
		М.Добавить(П); 
	КонецЦикла;
	
	МР = ПроверимНаличиеТоваровПодОбеспечениеНаСервере(М);
	
	Для каждого Стр из Объект.Товары цикл
		Стр.НарушеноОбеспечение = ложь;
	КонецЦикла;
	
	Для Инд = 0 по МР.Количество()-1 цикл
		НомерСтроки = Неопределено;
		П = М[Инд];
		
		Номенклатура 			= неопределено;	
		Характеристика			= неопределено;	
		СкладИсточник           = неопределено;
		П.Свойство("Номенклатура", Номенклатура);
		П.Свойство("Характеристика", Характеристика);
		П.Свойство("СкладИсточник", СкладИсточник);
		
		Для каждого Стр из Объект.Товары цикл
			Если 
				Номенклатура = Стр.Номенклатура
				И
				Характеристика = Стр.Характеристика
				И
				СкладИсточник = Стр.СкладИсточник
				Тогда
				Стр.НарушеноОбеспечение = Истина;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

