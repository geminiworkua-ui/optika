// Функция возвращает остатков денежных средств в кассе в валюте кассы.
//
Функция ПолучитьОстатокДенежныхСредствВКассеККМНаСервере(КассаККМ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваВКассахККМОстатки.СуммаОстаток КАК НаличностьВКассе
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКассахККМ.Остатки(&Дата, КассаККМ = &КассаККМ) КАК ДенежныеСредстваВКассахККМОстатки";
	
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НаличностьВКассе;
	Иначе
		Возврат 0;
	КонецЕсли;
	
