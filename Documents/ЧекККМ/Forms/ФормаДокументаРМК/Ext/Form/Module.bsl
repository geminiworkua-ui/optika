&НаСервере
Процедура ЗаписатьКИПартнеруКЛ(Результат, ДополнительныеПараметры)
	ПартнерОбъект = ДополнительныеПараметры.Партнер.ПолучитьОбъект(); 
	
	ТЧКИтелефон = ПартнерОбъект.КонтактнаяИнформация;
	Выборка =  ТЧКИтелефон.НайтиСтроки(Новый Структура("Тип,Вид"
			,Перечисления.ТипыКонтактнойИнформации.Телефон
			,Справочники.ВидыКонтактнойИнформации.ТелефонПартнера));
			
	Для каждого СтрВыборки ИЗ Выборка Цикл
		ТЧКИтелефон.Удалить(СтрВыборки);	
	КонецЦикла;
	
	УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(ПартнерОбъект,
			Результат.КонтактнаяИнформация,
			Справочники.ВидыКонтактнойИнформации.ТелефонПартнера,
			Перечисления.ТипыКонтактнойИнформации.Телефон);
	ПартнерОбъект.Записать();	
	
