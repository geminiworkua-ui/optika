КонецФункции	

Процедура СоздатьДокументыВозвратаОплаты(Заказ)

	ТаблицаТоваров = ПолучитьТаблицуТоваровПоОплате(Заказ); 

	МассивЧеков =Новый Массив;
	
	Для каждого Стр Из ТаблицаТоваров Цикл      
	    Индекс = МассивЧеков.Найти(Стр.ЧекККМ);     
		Если Не Индекс = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивЧеков.Добавить(Стр.ЧекККМ);
	КонецЦикла;		                          
	
	Для каждого Стр из МассивЧеков Цикл
	
		СтрПоиска = Новый  Структура;
		СтрПоиска.Вставить("ЧекККМ",Стр); 
		Строки = ТаблицаТоваров.НайтиСтроки(СтрПоиска);    
		Док = Документы.ЧекККМВозврат.СоздатьДокумент(); 
		ЗаполнитьЗначенияСвойств(Док, Стр);
		Док.Дата = ТекущаяДата();   
		ПолучитьЗначениеКассовойСмены(Док);  
		Док.Статус = Перечисления.СтатусыЧековККМ.Отложен;
		
		Если Док.КассоваяСмена = Документы.КассоваяСмена.ПустаяСсылка() Тогда
			Продолжить;   
			Сообщить("За касою " + Строка(Док.КассаККМ) + " не відкрито косової зміни. Оформлити документи поверння оплати не можливо");
		КонецЕсли;	
		
		Для каждого Строка из Строки Цикл     
			СтрТов = Док.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТов, Строка);  
			СтавкаНДСЧИслом = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(СтрТов.СтавкаНДС);
			ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрТов.Сумма, СтавкаНДСЧИслом ,Док.ЦенаВключаетНДС);
		КонецЦикла; 
			
		Если Не Док.Товары.Количество() = 0	 Тогда
			Док.СуммаДокумента = ЦенообразованиеКлиентСервер.ПолучитьСуммуДокумента(Док.Товары, Док.ЦенаВключаетНДС);	
			Док.Записать(РежимЗаписиДокумента.Проведение);
			Сообщить("За чеком " + Строка(Стр) + " оформлено чек поверненя " +Строка(Док.Ссылка)); 
		Иначе
			Сообщить("За чеком " + Строка(Стр) + " не оформлено чека поверненя"); 	
		КонецЕсли;		
	КонецЦикла;	
		
КонецПроцедуры

Процедура ПолучитьЗначениеКассовойСмены(ЧекВозврат)
	Запрос  = Новый Запрос(
	 "ВЫБРАТЬ
	 |	КассоваяСмена.Ссылка
	 |ИЗ
	 |	Документ.КассоваяСмена КАК КассоваяСмена
	 |ГДЕ
	 |	КассоваяСмена.КассаККМ = &КассаККМ
	 |	И КассоваяСмена.СтатусКассовойСмены = Значение(Перечисление.СтатусыКассовойСмены.Открыта)
	 |	И КассоваяСмена.Дата > &Дата");   
	Запрос.УстановитьПараметр("КассаККМ", ЧекВозврат.КассаККМ);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		ЧекВозврат.КассоваяСмена = Результат.КассоваяСмена;
	КонецЕсли;
	
КонецПроцедуры	 
		   
	
&НаКлиенте
Процедура СоздатьВозвратПоЗаказуОплаты(Команда)
	ТекСтр = Элементы.СписокЗаказов.ТекущиеДанные;

	Если Не ТекСтр = неопределено
		ТОгда
		
		ТекущийДокумент = ТекСтр.Ссылка;
		ПараметрыРасчета = Новый  Структура;
		ПараметрыРасчета.Вставить("ЗаказКлиента",ТекущийДокумент);
		ПараметрыРасчета.Вставить("ТипВозврата","ВозвратОплаты");  
		ОповещениеОПодборе = Новый ОписаниеОповещения("ПолучениеТаблицыЧековВозврат", ЭтотОбъект);
		ДокументыВозврата.Очистить();
		СообщенияОбработки.Очистить();
		ОткрытьФорму("ОбщаяФорма.ПодборТоваровКВозврату", ПараметрыРасчета,	ЭтотОбъект,
		ТекущийДокумент.УникальныйИдентификатор(),,,ОповещениеОПодборе);
		Элементы.ГруппаПродажаИВозврат.ТекущаяСтраница = Элементы.ГруппаВозврат;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеТаблицыЧековВозврат(РезультатВыполнения, Параметры) Экспорт
		
	Если РезультатВыполнения = Неопределено Тогда
		Возврат
	
	ИначеЕсли  РезультатВыполнения.ТаблицаДокументов.Количество()>0 Тогда
		
		
		//ПолучитьДанныеРаспределения(РезультатВыполнения.ТаблицаОплат);	
		МассивЧеков = РезультатВыполнения.ТаблицаДокументов;     
		Если МассивЧеков =Неопределено Тогда
			Возврат; 		
		КонецЕсли;	
		
		Если МассивЧеков.количество()=0 Тогда  
			Возврат;
		КонецЕсли; 
	
		Для каждого Чек из МассивЧеков Цикл 
			Если Не чек =Неопределено  Тогда
				СтрТаб = ДокументыВозврата.Добавить();
				СтрТаб.ДокументВозврата =Чек; 
				
				
			Конецесли;	
		КонецЦикла;
		
		Если ДокументыВозврата.Количество()=0 Тогда
			Возврат;
		КонецЕсли;
				
		ПробитьСледующийЧекВозврат();
	КонецЕсли;

КонецПроцедуры	

