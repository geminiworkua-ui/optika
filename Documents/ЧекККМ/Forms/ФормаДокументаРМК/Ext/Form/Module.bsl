&НаКлиенте
Процедура ВыполнитьОповещение8(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено
		Тогда 
		// получим параметрі для удаления строк
		ПП 						= неопределено;
		Номенклатура 			= неопределено;	
		Характеристика			= неопределено;	
		М                       = неопределено;	

		ПП = Результат;
		ПП.Свойство("Номенклатура", Номенклатура);
		ПП.Свойство("Характеристика", Характеристика); 
		ПП.Свойство("М",М);
		
		ВсегоОбходим = Объект.Товары.Количество(); 
		
		СуммаУдаляемых = 0;
				
		// удалим все строки с подбираемой номенклатурой
		
		Для Инд = 1 по Объект.Товары.Количество()  цикл
			Стр = Объект.Товары[ВсегоОбходим - Инд];
			Если
				Стр.Номенклатура     = Номенклатура
				И
				Стр.Характеристика   = Характеристика
				Тогда
				СуммаУдаляемых = СуммаУдаляемых  + Стр.Сумма;
				Штрихкод = Стр.Штрихкод;
				Продавец = Стр.Продавец;
				Строка = Стр.НомерСтроки;
				Цена = Стр.Цена;
				Идент = ВсегоОбходим - Инд;				
				
				Объект.Товары.Удалить(Идент);
				
			КонецЕсли;	
		КонецЦикла;	
		
		Для Инд = 0 по М.КОличество() - 1 цикл
			
		П = М[Инд];	
		
		НовСтр = Объект.Товары.Вставить(Идент + Инд);
			
		НовСтр.Номенклатура 			= Номенклатура;
		НовСтр.Характеристика 			= Характеристика;
		П.Свойство("Количество", 		НовСтр.КоличествоУпаковок);
		П.Свойство("Количество", 		НовСтр.Количество);
        П.Свойство("Склад", 			НовСтр.СкладИсточник);
					
		// заполним из данных удаленных строк	
		НовСтр.Штрихкод 				= Штрихкод;
		НовСтр.Продавец 				= Продавец;
		НовСтр.Упаковка 				= УпаковкаПоНоменклатуре(НовСтр.Номенклатура);
		НовСтр.Цена   					= Цена;
		НовСтр.СтавкаНДС 				= НДСбезНДС();	
		НовСтр.СуммаНДС 				= 0;
		НовСтр.Сумма  					= Стр.Количество * Стр.Цена;
		
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

