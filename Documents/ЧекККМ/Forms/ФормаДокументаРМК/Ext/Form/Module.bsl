&НаКлиенте
Процедура ЗаполнитьЗаказЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Результат = РезультатВопроса;
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
    
	Описание = Новый ОписаниеОповещения("ПослеЗаполненияЗаказа", ЭтотОбъект);
	
	ЗаказКлиента = СформироватьЗакрытыйЗаказ();
	ПараметрыРасчета = Новый  Структура;
	ПараметрыРасчета.Вставить("ЗаказКлиента",ЗаказКлиента);
	ПараметрыРасчета.Вставить("Склад",объект.Склад);  
	ОповещениеОПодборе = Новый ОписаниеОповещения("ПолучениеТаблицыЧеков", ЭтотОбъект);
	ОстаткиКОплате.Очистить();                                                      
	Объект.Товары.Очистить();
	ОткрытьФорму("ОбщаяФорма.ПодборСуммКОплате", ПараметрыРасчета,	ЭтотОбъект,
					ЭтотОбъект.УникальныйИдентификатор(),,,ОповещениеОПодборе);

	Элементы.ГруппаПродажаИВозврат.ТекущаяСтраница = Элементы.ГруппаПродажа;

КонецПроцедуры

&НаКлиенте
Функция ЕстьТовары() 
Возврат ЕстьТоварыНаСервере();	 
КонецФункции	

&НаСервере
Функция ЕстьТоварыНаСервере() 
	 
	Для Каждого Стр из Объект.Товары Цикл 
		Входящиепараметры = СформироватьПараметрыЗапросаОбеспечения(Стр, Объект.Склад);

		Если Не ЕстьОстаток(Входящиепараметры) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции	


&НаСервере
Функция ЕстьОстаток(ВходящиеПараметры) 
	Возврат Бит_сервер.ЕстьОстаток(ВходящиеПараметры);
КонецФункции

&НаСервере
Функция СформироватьПараметрыЗапросаОбеспечения(Стр, Склад)
ВходящиеПараметры = Новый Структура;
ВходящиеПараметры.Вставить("Номенклатура", Стр.Номенклатура);
ВходящиеПараметры.Вставить("Характеристика", Стр.Характеристика);  
ВходящиеПараметры.Вставить("Количество", Стр.КоличествоУпаковок);  
