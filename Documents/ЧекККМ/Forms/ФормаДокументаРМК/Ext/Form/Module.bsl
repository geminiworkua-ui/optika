&НаКлиенте
Процедура ОформитьВидимостьДопПолейФормы()
	
	Если ЗначениеЗаполнено(ЭтаФорма.КомментарийКлиента)
		ТОгда
		Элементы.КомментарийКлиента.Видимость = Истина;
	Иначе
		Элементы.КомментарийКлиента.Видимость = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.ИнформационнаяПанельПрочиеПараметрыИмя)
		и
		ЗначениеЗаполнено(ЭтаФорма.ИнформационнаяПанельПрочиеПараметрыЗначение)
		Тогда
		Элементы.ГруппаПрочиеПараметры.Видимость = Истина;
	Иначе
		Элементы.ГруппаПрочиеПараметры.Видимость = Ложь;
	КонецЕсли;
    
	Если ЗаблокироватьРаботу Тогда                           
		
		Для каждого Элемент из Элементы.ГруппаВерхняяКоманднаяПанель.ПодчиненныеЭлементы Цикл    
			 	Элемент.Доступность =Ложь;
		КонецЦикла;
		
		Элементы.Товары.Доступность = Ложь;
		
		Для каждого Элемент из Элементы.ГруппаВозврат.ПодчиненныеЭлементы Цикл
			Элемент.Доступность =Ложь;
		КонецЦикла;
		
		Для каждого Элемент из Элементы.ПродажаПоЗаказам.ПодчиненныеЭлементы Цикл
			Элемент.Доступность =Ложь;
		КонецЦикла;


		Элементы.ГруппаКоманднаяПанельИБоковаяПанель.Доступность = Истина;       
		
		Для каждого Элемент из Элементы.ГруппаКоманднаяПанельИБоковаяПанель.ПодчиненныеЭлементы Цикл
			  Элемент.Доступность =Истина;
		КонецЦикла;	 
	Иначе
		
		Для каждого Элемент из Элементы.ГруппаВерхняяКоманднаяПанель.ПодчиненныеЭлементы Цикл
			Элемент.Доступность =Истина;
		КонецЦикла;                        
		
		Элементы.Товары.Доступность = Истина;
		
		Для каждого Элемент из Элементы.ГруппаВозврат.ПодчиненныеЭлементы Цикл
			Элемент.Доступность =Истина;
		КонецЦикла;
		
		Для каждого Элемент из Элементы.ПродажаПоЗаказам.ПодчиненныеЭлементы Цикл
			Элемент.Доступность =Истина;
		КонецЦикла;
		
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ОформитьИнфСообщениеОплатыУслугВрача()
	
	НужноОформить = КоличествоУслугВрачаКоформлениюНаСервере();
	
	Если НужноОформить > 0
		Тогда
		Элементы.ИнфСообщениеУслугиВрача.Видимость = Истина;
		Элементы.ИнфСообщениеУслугиВрача.Заголовок = "Треба прийняти оплату за послуги лікаря (" + строка(НужноОформить) + ")";
	Иначе
		Элементы.ИнфСообщениеУслугиВрача.Видимость = Ложь;
		Элементы.ИнфСообщениеУслугиВрача.Заголовок = "";
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Функция  КоличествоУслугВрачаКоформлениюНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента КАК ЗаказКлиента,
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента.Склад КАК ЗаказКлиентаСклад,
		|	СУММА(РасчетыСКлиентамиОстатки.КОплатеОстаток) КАК КОплатеОстаток
		|ПОМЕСТИТЬ вт_срез
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами.Остатки(
		|			&Дата,
		|			ЗаказКлиента.ЭтоОсмотрВрача = ИСТИНА
		|				И ЗаказКлиента.Склад = &Склад) КАК РасчетыСКлиентамиОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента.Склад,
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вт_срез.ЗаказКлиента) КАК ЗаказКлиента,
		|	вт_срез.ЗаказКлиентаСклад
		|ИЗ
		|	вт_срез КАК вт_срез
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_срез.ЗаказКлиентаСклад";
	
	Запрос.УстановитьПараметр("Дата", конецДня(ТекущаяДата())+1);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗаказКлиента;
	Иначе
		Возврат 0;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции	

&НаКлиенте
Процедура ЕстьРекомендацииНажатие(Элемент)
	
	П = Новый Структура("ДО");
	П.ДО = Объект.ДокументОснование;
	 	
	К =  КлючКарточкаКлиента(П);	
	
	Если Не К = неопределено Тогда
		ПараметрыОткрытия= Новый Структура("Ключ", К);
		ОткрытьФорму("Документ.КарточкаПациента.Форма.ФормаДокумента", ПараметрыОткрытия);
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Функция КлючКарточкаКлиента(П)
	ДокументОснование = Неопределено;
	ДО = Неопределено;
	П.свойство("ДО", ДО);
	П = неопределено;
	
	Если ЗначениеЗаполнено(ДО)
		И
		ТипЗнч(ДО) = тип("ДокументСсылка.ЗаказКлиента")
		И
		ЗначениеЗаполнено(ДО.ДокументОснование)
		
		Тогда
		Если 
			ТипЗнч(ДО.ДокументОснование) = тип("ДокументСсылка.КарточкаПациента")
			И
			(
			ДО.ДокументОснование.НазначениеЛС.Количество() > 0
			ИЛИ 
			ДО.ДокументОснование.НазначеноОчки
			ИЛИ 
			ДО.ДокументОснование.НазначеноМКЛ
			ИЛИ
			ДО.ДокументОснование.НазначеноНЛ 
			)
			Тогда
			П = Новый Структура ("Ф, К");
			П.Ф = "Документ.КарточкаПациента.Форма.ФормаДокумента";
			П.К = ДО.ДокументОснование;
			
		ИначеЕсли
			ТипЗнч(ДО.ДокументОснование) = тип("ДокументСсылка.ВыполнениеПроцедуры")
			И
			(
			ДО.ДокументОснование.Товары.Количество() > 0
			ИЛИ 
			НЕ ДО.ДокументОснование.Рекомендации = ""
			)
			Тогда
			П = Новый Структура ("Ф, К");
			П.Ф = "Документ.ВыполнениеПроцедуры.Форма.ФормаДокумента";
			П.К = ДО.ДокументОснование;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат П;
	
КонецФункции

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	
	П = Новый Структура("ДО");
	П.ДО = Объект.ДокументОснование;
    	
	Если ЗначениеЗаполнено(Объект.ДокументОснование)
