	Элементы.ВидПериодаЖурнала.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаВчерашнийДень);
	Элементы.ВидПериодаЖурнала.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаПроизвольныйПериод);
	
	Элементы.ВидПериодаЧековККМ.СписокВыбора.Очистить();
	Элементы.ВидПериодаЧековККМ.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаТекущуюСмену);
	Элементы.ВидПериодаЧековККМ.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаПрошлуюСмену);
	Элементы.ВидПериодаЖурнала.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаВчерашнийДень);
	Элементы.ВидПериодаЧековККМ.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаПроизвольныйПериод);
	
	Элементы.ВидПериодаЧековККМНаВозврат.СписокВыбора.Очистить();
	Элементы.ВидПериодаЧековККМНаВозврат.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаТекущуюСмену);
	Элементы.ВидПериодаЧековККМНаВозврат.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаПрошлуюСмену);
	Элементы.ВидПериодаЖурнала.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаВчерашнийДень);
	Элементы.ВидПериодаЧековККМНаВозврат.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаПроизвольныйПериод);
	
	Элементы.ВидПериодаЗаказов.СписокВыбора.Очистить();
	Элементы.ВидПериодаЗаказов.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаТекущуюСмену); 
	Элементы.ВидПериодаЖурнала.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаВчерашнийДень);
	Элементы.ВидПериодаЗаказов.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаПроизвольныйПериод);
	Элементы.ВидПериодаЗаказов.СписокВыбора.Добавить(Перечисления.ВидыПериодовРМК.ЗаВесьПериод);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ИспользоватьПодключаемоеОборудование Тогда
		
		Если ОткрыватьФормуСПодключеннымОборудованием Тогда
			
			ПодключитьОбработчикОжидания("ОткрытьФормуПодключенноеОборудованиеОбработчикОжидания", 0.5, Истина);
			
		Иначе
			
			Для Каждого СтрокаТЧ Из Оборудование Цикл
				
				МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоИдентификатору(
					Новый ОписаниеОповещения("НачатьПодключениеОборудованиеПоИдентификаторуЗавершение", ЭтотОбъект, СтрокаТЧ),
					ЭтотОбъект.УникальныйИдентификатор,
					СтрокаТЧ.Ссылка);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПересчитатьДокументНаКлиенте();
	
	//DVL +++
	// Установим отбор заказов по складу магазина
	ОтборСклад = Объект.Склад;             
	// Откроем форму оплаты если товар в резерве
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Если ТоварЗарезервирован(Объект.Ссылка) Тогда
			РозничныеПродажиКлиент.ОбработатьСостояниеСмены(
					ЭтотОбъект,
					Новый ОписаниеОповещения("СмешаннаяОплатаОбработкаОповещения", ЭтотОбъект));    			
		КонецЕсли;
	Иначе       
		//Авторизация Пользователя при открытии пустого чека ККМ для подбора товара	
		Если ПринудительнаяАвторизация Тогда   
			//Проверяем если оборудование по считыванию данных о пользователе
			Если ЕстьОборудованиеСчитывания () Тогда
					  ПодключитьОбработчикОжидания("ОткрытьОкноАвторизации", 0.5, Истина); 
				Иначе ПодключитьОбработчикОжидания("ОткрытьОкноВыбораПродавца", 0.5, Истина);
            КонецЕсли; 
		КонецЕсли;			
	КонецЕсли;
	//DVL ---  
	
	// + Боков

	//ПериодическоеОбновлениеДанныхФормы();
	
	// каждые ___ секунд будем обновлять данные: сообщения пользователям и оформение кнопки
	ПодключитьОбработчикОжидания("ПериодическоеОбновлениеДанныхФормы", 25, Ложь);
	
	ОформитьВидимостьДопПолейФормы();
	
	// НАстроим отбор заказов
	ОтборСклад = ОБъект.Склад;
	ФильтрЗаказов();

	//
	ОбновитьУсловияОтбораРасписанияВрача();
	
	// - Боков
    //
	Элементы.ТоварыСуммаРучнойСкидки.Видимость = Истина;
	Элементы.ТоварыПроцентРучнойСкидки.Видимость = Истина;
	//

КонецПроцедуры

Функция ЕстьОборудованиеСчитывания()
	Для каждого Устройство из Оборудование Цикл
		Если Устройство.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.СканерШтрихкода Или 
			 Устройство.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.СчитывательМагнитныхКарт Тогда
			 Если Устройство.Ссылка.УстройствоИспользуется Тогда
				 Возврат Истина
			 КонецЕсли;
		КонецЕсли;	 
	КонецЦикла;	  
	Возврат Ложь;
КонецФункции	

