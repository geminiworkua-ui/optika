&НаКлиенте
Процедура ПолучениеТаблицыДокументовВозврат(РезультатВыполнения, Параметры) Экспорт
		
	Если РезультатВыполнения = Неопределено Тогда
		Возврат
	
	ИначеЕсли  РезультатВыполнения.ТаблицаДокументов.Количество()>0 Тогда
		
		МассивДокументов = РезультатВыполнения.ТаблицаДокументов;     
		
		Если МассивДокументов =Неопределено Тогда
			Возврат; 		
		КонецЕсли;	
		
		Если МассивДокументов.количество()=0 Тогда  
			Возврат;
		КонецЕсли; 
		
		Для каждого Док из РезультатВыполнения.ТаблицаДокументов Цикл
			Если Не Док = Неопределено Тогда
				НовСтр =  ДокументыВозврата.Добавить();     
				НовСтр.ДокументВозврата = Док;
			КонецЕсли;
		КонецЦикла;	 
		
		Если ДокументыВозврата.Количество()=0 Тогда
			Возврат;
		КонецЕсли;

		
		ОчиститьТаблицуДок(); 
		
		// ++ Боков Запустим сразу возврат денег
		ТекСтр = Элементы.СписокЗаказов.ТекущиеДанные;
		Если Не ТекСтр = неопределено
			ТОгда
			
			ТекущийДокумент = ТекСтр.Ссылка;
			ПараметрыРасчета = Новый  Структура;
			ПараметрыРасчета.Вставить("ЗаказКлиента",ТекущийДокумент);
			ПараметрыРасчета.Вставить("ТипВозврата","ВозвратОплаты");  
			ОповещениеОПодборе = Новый ОписаниеОповещения("ПолучениеТаблицыЧековВозврат", ЭтотОбъект);
			ДокументыВозврата.Очистить();
			СообщенияОбработки.Очистить();
			ОткрытьФорму("ОбщаяФорма.ПодборТоваровКВозврату", ПараметрыРасчета,	ЭтотОбъект,
			ТекущийДокумент.УникальныйИдентификатор(),,,ОповещениеОПодборе);
			Элементы.ГруппаПродажаИВозврат.ТекущаяСтраница = Элементы.ГруппаВозврат;
			
		КонецЕсли;
		// - Боков
		
	КонецЕсли;

КонецПроцедуры	

Процедура ОчиститьТаблицуДок() 
	
	Для каждого Стр из сообщенияОбработки Цикл
		Сообщить(Стр.сообщениеОбработки);
	КонецЦикла;
	
	Для каждого Стр из ДокументыВозврата Цикл  
		Если Не Стр.ДокументВозврата.Проведен  Тогда
			ДокОб = Стр.ДокументВозврата.ПолучитьОбъект();
			Если Не ДокОб = Неопределено Тогда  
				ДокОб.удалить();
			Конецесли	
		КонецЕсли;	
	КонецЦикла;	
ДокументыВозврата.Очистить();
КонецПроцедуры	

