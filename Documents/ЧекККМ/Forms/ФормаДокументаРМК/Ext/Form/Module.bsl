&НаКлиенте
Процедура ЗаполнитьСообщенияПользователям()
	мРез = ЗаполнитьСообщенияПользователямНаСервере(ЭтаФорма.ПоказыватьИсториюСообщений);
	ОформитьЗаголовокСообщений();
	
	Если мРез.Количество() > 0 Тогда
		Для Каждого ТекСообщение Из мРез Цикл 
			
			Если НЕ ТекСообщение.НавигационнаяСсылка = "" Тогда	 	
				ПоказатьОповещениеПользователя(ТекСообщение.Сообщение
				,ТекСообщение.НавигационнаяСсылка
				,?(ТекСообщение.Свойство("Отправитель"),ТекСообщение.Отправитель,""),
				,СтатусОповещенияПользователя.Важное
				,ТекСообщение.ИДсообщенияОповещения);
				
			Иначе	
				ПоказатьОповещениеПользователя(ТекСообщение.Сообщение,
				,?(ТекСообщение.Свойство("Отправитель"),ТекСообщение.Отправитель,""),
				,СтатусОповещенияПользователя.Важное
				,ТекСообщение.ИДсообщенияОповещения);
			КонецЕсли;			
			
			//МассивСообщений.Удалить(ТекСообщение);
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСообщенияПользователямНаСервере(ПоказыватьИсторию)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СообщенияПользователям.ДокументСобытия КАК Документ,
		|	СообщенияПользователям.Подразделение,
		|	СообщенияПользователям.Сообщение,
		|	СообщенияПользователям.Инициатор,
		|	СообщенияПользователям.Важное КАК Важно,
		|	СообщенияПользователям.ДатаСоздания КАК Дата,
		|	СообщенияПользователям.Идентификатор,
		|	СообщенияПользователям.Читатель,
		|	СообщенияПользователям.ДатаЧтения,
		|	СообщенияПользователям.Прочитано,
		|	СообщенияПользователям.ОтраженоКолокольчик
		|ИЗ
		|	РегистрСведений.СообщенияПользователям КАК СообщенияПользователям
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ПоказыватьИсторию = ЛОЖЬ
		|					И НЕ СообщенияПользователям.Прочитано = ИСТИНА
		|				ТОГДА ИСТИНА
		|			КОГДА &ПоказыватьИсторию = ИСТИНА
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Подразделение", ОБъект.Склад.Подразделение);
	Запрос.УстановитьПараметр("ПоказыватьИсторию", ПоказыватьИсторию);
	
	
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ЭтаФорма.СообщенияПользователям.Загрузить(ТЗ);
	
	ЭтаФорма.Элементы.СообщенияПользователямГруппаИстория.Видимость = ПоказыватьИсторию;
	
	мРез = Новый Массив;
	
	Если НЕ ТЗ = Неопределено и ТЗ.Количество() тогда
	Для каждого Стр из ТЗ цикл 
		
		если Не Стр.ОтраженоКолокольчик
			Тогда
			П = Новый структура("ИДсообщения,  ИДсообщенияОповещения, Получатель, Сообщение,  Отправитель, НавигационнаяСсылка, ТекстСообщения, Дата, Автор");
			
			Попытка
				п.НавигационнаяСсылка = ПОлучитьНАвигационнуюСсылку(Стр.Документ);
			Исключение  
				п.НавигационнаяСсылка = "";
			КонецПопытки;
		
			п.ИДсообщения = Стр.Идентификатор;
			п.ИДсообщенияОповещения = Новый УникальныйИдентификатор();
			п.ПОлучатель = ПараметрыСеанса.ТекущийПользователь;
			п.Сообщение = Стр.Сообщение;
			п.Отправитель = Стр.Инициатор;
			п.Дата= Стр.Дата;
			п.Автор = Стр.Инициатор;
            
			мРез.Добавить(П);
			
			НаборЗаписей = РегистрыСведений.СообщенияПользователям.СоздатьНаборЗаписей();
			наборЗаписей.Отбор.Идентификатор.Установить(Стр.Идентификатор);
			НаборЗаписей.Прочитать();
			Для каждого Запись из НаборЗаписей цикл
				Запись.ОтраженоКолокольчик = Истина;
			КонецЦикла;
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли;
	КонецЦикла; 
	КонецЕсли;
	Возврат мРез;
КонецФункции
&НаСервере
Процедура СообщенияПользователямВыборНаСервере(П)
	
Идентификатор = Неопределено;
   П.Свойство("Идентификатор", Идентификатор);
   
   	Запись = РегистрыСведений.СообщенияПользователям.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Идентификатор;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Запись.Прочитано = Истина;
		Запись.Читатель = ПараметрыСеанса.ТекущийПользователь;
		Запись.ДатаЧтения = ТекущаяДата();
	Запись.Записать(Истина);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщенияПользователямВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	
	Если Поле.Имя = "СообщенияПользователямПрочитаноКартинка"
		Тогда
		
		ТекСтр = Элементы.СообщенияПользователям.ТекущиеДанные;
        
		СтандартнаяОбработка = Ложь;
		П = Новый Структура;
		П.Вставить("Идентификатор", ТекСтр.Идентификатор);
		СообщенияПользователямВыборНаСервере(П);  
		ЗаполнитьСообщенияПользователям();
		ОформитьЗаголовокСообщений() 
		
		
	ИначеЕсли Поле.Имя = "СообщенияПользователямДокумент"
			Тогда
			ТекСтр = Элементы.СообщенияПользователям.ТекущиеДанные;
            СтандартнаяОбработка = Ложь;
		    ПоказатьЗначение(, ТекСтр.Документ);
		
	КонецЕсли;
 
КонецПроцедуры

