&НаКлиенте
Процедура СмешаннаяОплата(Команда)
	
	Если Объект.Товары.Количество() =0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДокументОснование = ПредопределенноеЗначение("Документ.ЗаказКлиента.ПустаяСсылка") Тогда
		ЗаполнитьЗначениеЗаказа(); 
		Возврат;
	КонецЕсли;
	
	// +y.surai Assino 2026.08.01
	ibs_ЗаполнитьПостороннегоВрачаВЗаказе();
	// -y.surai Assino 2026.08.01
	
	Объект.Дата = ТекущаяДата();
	
	ВыбраннаяФормаОплаты = Новый Структура;
	ВыбраннаяФормаОплаты.Вставить("Наличные",              Истина);
	ВыбраннаяФормаОплаты.Вставить("БонусныеБаллы",         Истина);
	ВыбраннаяФормаОплаты.Вставить("ПлатежныеКарты",        Истина);
	ВыбраннаяФормаОплаты.Вставить("ПодарочныеСертификаты", Ложь);

	
	РозничныеПродажиКлиент.ОбработатьСостояниеСмены(
		ЭтотОбъект,
		Новый ОписаниеОповещения("СмешаннаяОплатаОбработкаОповещения", ЭтотОбъект));
	
КонецПроцедуры
	
Процедура ibs_ЗаполнитьПостороннегоВрачаВЗаказе()
	// +y.surai Assino 2026.08.01
	Если ЗначениеЗаполнено(Объект.Врач) Тогда
		Заказ = Объект.ДокументОснование.ПолучитьОбъект();
		Заказ.ibs_ПостороннийВрач = Объект.Врач;
		Попытка
			Заказ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить(НСтр("ru='Не удалось добавить в заказ стороннего врача!';uk='Не вдалося додати в замовлення стороннього лікаря!'"));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	// -y.surai Assino 2026.08.01
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначениеЗаказа()
	
	ЕстьТоварыВНаличии = Ложь;	
	ЕстьТоварыВНаличии = ЕстьТовары(); 
	Если ЕстьТоварыВНаличии и Не РозничныйКлиент() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьЗаказЗавершение", ЭтотОбъект),
		НСтр("ru='Есть товары требующие заказа. Заполнить значение покупателя?';uk='Існують товари під замовлення. Заповнити значення покупця?'"), РежимДиалогаВопрос.ДаНет);	
		
	Иначе 
		СформироватьПокупателя(); 	
	КонецЕсли;   
	
КонецПроцедуры	

