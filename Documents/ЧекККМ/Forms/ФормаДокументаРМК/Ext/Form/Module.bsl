Функция НазваниеТипДокументаСервере(Док)

	Если ТипЗнч(Док) = Тип("ДокументСсылка.РеализацияТоваровУслуг")	
		Тогда Форм = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента"
		
	ИначеЕсли
