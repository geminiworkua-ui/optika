&НаКлиенте
Процедура ПродолжитьОбновлениеЗаказа(Прецепта)     Экспорт

   	ЗаказКлиента = ОбновитьЗаказНаСервере(Прецепта);
	ПараметрыРасчета = Новый  Структура;
	ПараметрыРасчета.Вставить("ЗаказКлиента",ЗаказКлиента);
    ПараметрыРасчета.Вставить("Склад", Объект.Склад);  
    ОповещениеОПодборе2 = Новый ОписаниеОповещения("ПолучениеТаблицыЧеков", ЭтотОбъект);
    ОстаткиКОплате.Очистить();                                                      
    Объект.Товары.Очистить();
	Элементы.ГруппаВызовРекомендацииВрача.Видимость = Ложь;
