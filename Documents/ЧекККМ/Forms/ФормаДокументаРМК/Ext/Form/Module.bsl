&НаСервере
 Функция СоздатьЧекПоОтбору(СтрокиЗаказа, Заказ)
 НовыйЧек = Документы.ЧекККМ.СоздатьДокумент();  
 Если СтрокиЗаказа.Количество()=0 Тогда
	 Возврат Неопределено;
 КОнецЕсли;	 
 КассаККМ = СтрокиЗаказа[0].КассаККМ;
 НовыйЧек.ДокументОснование = Заказ;
 НовыйЧек.НомерЧекаККМ = "";
 НовыйЧек.Архивный = Ложь;
 НовыйЧек.Статус = Неопределено;
	
 НовыйЧек.ПолученоНаличными = 0;
 
 СостояниеКассовойСмены = РозничныеПродажи.ПолучитьСостояниеКассовойСмены(КассаККМ);
 ЗаполнитьЗначенияСвойств(НовыйЧек, СостояниеКассовойСмены);

  
 Для каждого Стр из СтрокиЗаказа Цикл
	 СтрТЧ =НовыйЧек.Товары.Добавить();
	 ЗаполнитьЗначенияСвойств(СтрТЧ, Стр);  
	 СтрТЧ.Количество = Стр.КоличествоЧек;
	 СтрТЧ.КоличествоУпаковок = Стр.КоличествоЧек;
	 СтрТЧ.Цена = Стр.Цена;
	 СтрТЧ.Сумма = Стр.СуммаЧек;
	 СтрТЧ.Штрихкод = ЗаполнитьШтрихкод(Стр.Номенклатура, Стр.Характеристика);
	 СтрТЧ.СуммаБонусныхБалловКСписанию = 0;
	 СтрТЧ.СуммаБонусныхБалловКСписаниюВВалюте = 0; 
	 СтрТЧ.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	 Если СтрТЧ.продавец = Справочники.Пользователи.ПустаяСсылка() Тогда
		 СтрТЧ.продавец = Заказ.Менеджер;
	КонецЕсли;	 
 КонецЦикла;	 
 
 Для каждого Стр из Заказ.скидкиНаценки Цикл
	 СтрТЧ =НовыйЧек.СкидкиНаценки.Добавить();
	 ЗаполнитьЗначенияСвойств(СтрТЧ, Стр);
 КонецЦикла;	 

 если НовыйЧек.СкидкиНаценки.Количество()=0
	 Тогда
	 НовыйЧек.СкидкиРассчитаны = Ложь;
	 Иначе
     НовыйЧек.СкидкиРассчитаны = Истина;
 КонецЕсли;	 
 НовыйЧек.ДокументОснование = Заказ;
 НовыйЧек.Партнер = Заказ.Партнер;                
 НовыйЧек.Организация = КассаККМ.Владелец;
 НовыйЧек.КартаЛояльности = Заказ.КартаЛояльности;
 НовыйЧек.СуммаДокумента = Заказ.СуммаДокумента;  
 НовыйЧек.Статус = Перечисления.СтатусыЧековККМ.ТоварЗарезервирован;
 НовыйЧек.Дата = ТекущаяДата();
 НовыйЧек.Записать(РежимЗаписиДокумента.Проведение);
 Возврат НовыйЧек.Ссылка;
 КонецФункции
 
&НаСервере
Функция ЗаполнитьШтрихкод(Номенклатура, Характеристика)
	 Если Характеристика = справочники.ХарактеристикиНоменклатуры.ПустаяСсылка() Или
		  Характеристика = Неопределено Тогда
					  
			 Запрос	= Новый Запрос(
			  "ВЫБРАТЬ
			  |	ШтрихкодыНоменклатуры.Штрихкод
			  |ИЗ
			  |	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
			  |ГДЕ
			  |	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура");
			 Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
			 Рез =Запрос.Выполнить().Выбрать();
			 Если Рез.Следующий() Тогда
				 Возврат Рез.Штрихкод;
			 Иначе
				  Возврат "";
			 КонецЕсли;	  
		  Иначе	              
			  Запрос	= Новый Запрос(
			  "ВЫБРАТЬ
			  |	ШтрихкодыНоменклатуры.Штрихкод
			  |ИЗ
			  |	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
			  |ГДЕ
			  |	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура
			  |	И ШтрихкодыНоменклатуры.Характеристика = &Характеристика");
			 Запрос.УстановитьПараметр("Номенклатура", Номенклатура);       
			 Запрос.УстановитьПараметр("Характеристика", Характеристика);

			 Рез =Запрос.Выполнить().Выбрать();
			 Если Рез.Следующий() Тогда
				 Возврат Рез.Штрихкод;
			 Иначе
				  Возврат "";
			  КонецЕсли;	  
		КонецЕсли;	  
 КонецФункции	 

