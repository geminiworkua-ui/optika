&НаСервере
Функция ЗначениеСкладаИсточникаПоУмолчанию(П)
	
	ВариантИсточникаОбеспечения     = неопределено;	
	Номенклатура 					= неопределено;	
	Количество 						= неопределено;
	П.Свойство("ВариантИсточникаОбеспечения", ВариантИсточникаОбеспечения);
	П.Свойство("Номенклатура", Номенклатура);      
	П.Свойство("Количество", Количество);
	
	Искать = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.ВидНоменклатуры.ПроизводитьПоискПоСкладам КАК  ПроизводитьПоискПоСкладам
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Искать = Выборка.ПроизводитьПоискПоСкладам;	
	КонецЕсли;
	
	Если НЕ Искать
		Тогда
		Рез = Справочники.ВариантыИсточниковОбеспечения.ПодЗаказПоставщику;
	Иначе
		Если 
			ВариантИсточникаОбеспечения = Справочники.ВариантыИсточниковОбеспечения.ПодЗаказПоставщику
			ИЛИ 
			ВариантИсточникаОбеспечения =  Справочники.ВариантыИсточниковОбеспечения.ПустаяСсылка()
			Тогда
			Рез = Справочники.ВариантыИсточниковОбеспечения.ПустаяСсылка();
		Иначе
			Рез = ВариантИсточникаОбеспечения;
			
		КонецЕсли;
	КонецЕсли;
	Возврат Рез;
	
КонецФункции

&НаСервере
Функция ЗначениеСкладаИсточникаПоУмолчаниюНов(Номенклатура, Характеристика)
	
	//	Номенклатура 					= неопределено;	
	//П.Свойство("Номенклатура", Номенклатура);      
		
	Если Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга
		Тогда
		Возврат Справочники.ВариантыИсточниковОбеспечения.ИзНаличия
		
	Иначе	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВариантыИсточниковОбеспечения.Ссылка КАК ВариантОбеспечения
	|ИЗ
	|	Справочник.ВариантыИсточниковОбеспечения КАК ВариантыИсточниковОбеспечения
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ПараметрСхемыОбеспечения.СпособОбеспеченияПотребностейИсточникОбеспеченияПотребностей КАК ИсточникОбеспеченияПотребностей,
	|			ВыборСхемыОбеспеченияПоНоменклатуре.Номенклатура КАК Номенклатура,
	|			ВыборСхемыОбеспеченияПоНоменклатуре.ПринятаяСхемаОбеспечения КАК ПринятаяСхемаОбеспечения,
	|			ВыборСхемыОбеспеченияПоНоменклатуре.Характеристика КАК Характеристика
	|		ИЗ
	|			(ВЫБРАТЬ
	|				Номенклатура.Ссылка КАК Номенклатура,
	|				ВЫБОР
	|					КОГДА Номенклатура.СхемаОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)
	|						ТОГДА Номенклатура.СхемаОбеспечения
	|					ИНАЧЕ Номенклатура.ВидНоменклатуры.СхемаОбеспечения
	|				КОНЕЦ КАК ПринятаяСхемаОбеспечения,
	|				NULL КАК Характеристика
	|			ИЗ
	|				Справочник.Номенклатура КАК Номенклатура
	|			ГДЕ
	|				Номенклатура.Ссылка = &НоменклатураСсылка
	|				И НЕ Номенклатура.ИспользованиеХарактеристик = &ИспользованиеХарактеристик
	|			
	|			ОБЪЕДИНИТЬ ВСЕ
	|			
	|			ВЫБРАТЬ
	|				NULL,
	|				ВЫБОР
	|					КОГДА НЕ ХарактеристикиНоменклатуры.СхемаОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)
	|						ТОГДА ХарактеристикиНоменклатуры.СхемаОбеспечения
	|					ИНАЧЕ ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры.СхемаОбеспечения
	|				КОНЕЦ,
	|				ХарактеристикиНоменклатуры.Ссылка
	|			ИЗ
	|				Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|			ГДЕ
	|				ХарактеристикиНоменклатуры.Ссылка = &ХарактеристикаСсылка) КАК ВыборСхемыОбеспеченияПоНоменклатуре
	|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					СхемыОбеспечения.СхемаОбеспечения КАК СхемаОбеспечения,
	|					СхемыОбеспечения.СпособОбеспеченияПотребностей.Ссылка КАК СпособОбеспеченияПотребностейСсылка,
	|					СхемыОбеспечения.СпособОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей КАК СпособОбеспеченияПотребностейИсточникОбеспеченияПотребностей
	|				ИЗ
	|					РегистрСведений.СхемыОбеспечения КАК СхемыОбеспечения
	|				ГДЕ
	|					СхемыОбеспечения.Склад = &Склад
	|					И СхемыОбеспечения.СпособОбеспеченияПотребностей.ТипОбеспечения = &ТипОбеспечения) КАК ПараметрСхемыОбеспечения
	|				ПО ВыборСхемыОбеспеченияПоНоменклатуре.ПринятаяСхемаОбеспечения = ПараметрСхемыОбеспечения.СхемаОбеспечения) КАК ВложенныйЗапрос
	|		ПО ВложенныйЗапрос.ИсточникОбеспеченияПотребностей.Ссылка = ВариантыИсточниковОбеспечения.СкладИсточник
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВариантыИсточниковОбеспечения.Иерархия УБЫВ";
	Запрос.УстановитьПараметр("НоменклатураСсылка", Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаСсылка", Характеристика);
	Запрос.УстановитьПараметр("ИспользованиеХарактеристик", Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	Запрос.УстановитьПараметр("ТипОбеспечения", Перечисления.ТипыОбеспечения.Перемещение);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Рез = Выборка.ВариантОбеспечения;	
	КонецЕсли;
	
	Возврат Рез;
	КонецЕсли;
	
КонецФункции

 &НаСервере
Функция ПроверимНаличиеТоваровПодОбеспечениеНаСервере(М)
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Характеристика",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("СкладИсточник", Новый ОписаниеТипов("СправочникСсылка.ВариантыИсточниковОбеспечения"));
	//ТЗ.Колонки.Добавить("ТипНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"); 
	
	Для Инд = 0 по М.Количество()-1 цикл
		П = М[Инд];
		Номенклатура 			= неопределено;	
		//Характеристика			= неопределено;	
		//Количество     			= неопределено;
		//СкладИсточник           = неопределено;
		П.Свойство("Номенклатура", Номенклатура);
		
		Если Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар
			Тогда
			НовСтр = ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, П);
			//
			//
			//П.Свойство("Номенклатура", НовСтр.Номенклатура);
			//П.Свойство("Характеристика", НовСтр.Характеристика);
			//П.Свойство("Количество", НовСтр.Количество);
			//П.Свойство("СкладИсточник", НовСтр.СкладИсточник);  
		КонецЕсли;
		
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Номенклатура,
	|	ТЗ.Характеристика,
	|	ТЗ.Количество,
	|	ТЗ.СкладИсточник
	|ПОМЕСТИТЬ вт_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	СУММА(вт_ТЗ.Количество) КАК Количество,
	|	ВложенныйЗапрос.СкладОбеспечения,
	|	вт_ТЗ.СкладИсточник
	|ПОМЕСТИТЬ вт_ТолькоИзОстатков
	|ИЗ
	|	вт_ТЗ КАК вт_ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВариантыИсточниковОбеспечения.Ссылка КАК Ссылка,
	|			ВЫБОР
	|				КОГДА ВариантыИсточниковОбеспечения.СкладИсточник = ЗНАЧЕНИЕ(Справочник.ВариантыИсточниковОбеспечения.ИзНаличия)
	|					ТОГДА &Склад
	|				ИНАЧЕ ВариантыИсточниковОбеспечения.СкладИсточник
	|			КОНЕЦ КАК СкладОбеспечения
	|		ИЗ
	|			Справочник.ВариантыИсточниковОбеспечения КАК ВариантыИсточниковОбеспечения) КАК ВложенныйЗапрос
	|		ПО вт_ТЗ.СкладИсточник = ВложенныйЗапрос.Ссылка
	|ГДЕ
	|	НЕ вт_ТЗ.СкладИсточник = ЗНАЧЕНИЕ(Справочник.ВариантыИсточниковОбеспечения.ПодЗаказ)
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	ВложенныйЗапрос.СкладОбеспечения,
	|	вт_ТЗ.СкладИсточник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТолькоИзОстатков.Номенклатура,
	|	вт_ТолькоИзОстатков.Характеристика,
	|	вт_ТолькоИзОстатков.СкладОбеспечения,
	|	вт_ТолькоИзОстатков.СкладИсточник,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(вт_ТолькоИзОстатков.Количество, 0) <= ЕСТЬNULL(РасчетСвобОстатка.СвобОстаток, 0)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНарушение
	|ПОМЕСТИТЬ вт_СлучаиОшибки
	|ИЗ
	|	вт_ТолькоИзОстатков КАК вт_ТолькоИзОстатков
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
	|			СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
	|			СвободныеОстаткиОстатки.Склад КАК Склад,
	|			СУММА(ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0)) КАК СвобОстаток
	|		ИЗ
	|			РегистрНакопления.СвободныеОстатки.Остатки(&Дата, ) КАК СвободныеОстаткиОстатки
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СвободныеОстаткиОстатки.Номенклатура,
	|			СвободныеОстаткиОстатки.Характеристика,
	|			СвободныеОстаткиОстатки.Склад) КАК РасчетСвобОстатка
	|		ПО вт_ТолькоИзОстатков.Номенклатура = РасчетСвобОстатка.Номенклатура
	|			И вт_ТолькоИзОстатков.Характеристика = РасчетСвобОстатка.Характеристика
	|			И вт_ТолькоИзОстатков.СкладОбеспечения = РасчетСвобОстатка.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_СлучаиОшибки.Номенклатура,
	|	вт_СлучаиОшибки.Характеристика,
	|	вт_СлучаиОшибки.СкладИсточник,
	|	вт_СлучаиОшибки.ЕстьНарушение
	|ИЗ
	|	вт_СлучаиОшибки КАК вт_СлучаиОшибки
	|ГДЕ
	|	вт_СлучаиОшибки.ЕстьНарушение";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
//	Выборка = Запрос.Выполнить().Выбрать();
	
	МР = Новый Массив;
	Для каждого Выборка из ТЗ цикл
		П = Новый Структура;
		П.Вставить("Номенклатура", Выборка.Номенклатура);
		П.Вставить("Характеристика", Выборка.Характеристика);
		П.Вставить("СкладИсточник", Выборка.СкладИсточник);
		П.Вставить("ЕстьНарушение",Выборка.ЕстьНарушение);
		МР.Добавить(П);
	КонецЦикла;	
	
	Возврат МР;	

КонецФункции

&НаКлиенте
Процедура ПроверимОбеспечение(Команда)
	ПроверимНаличиеТоваровПодОбеспечение();
КонецПроцедуры

&НаСервере
Функция ПоискПоСкладамНоменклатурыНаСервере(Номенклатура)
	
	Если 
		ЗначениеЗаполнено(Номенклатура.ВидНоменклатуры)
		И		
		ЗначениеЗаполнено(Номенклатура.ВидНоменклатуры.ПроизводитьПоискПоСкладам)
		Тогда
		ПоискПоСкладам = Номенклатура.ВидНоменклатуры.ПроизводитьПоискПоСкладам
	Иначе
		ПоискПоСкладам = Ложь
	КонецЕсли;
	
	Возврат ПоискПоСкладам;
	
КонецФункции

&НаСервере
Функция ЭтоУслуга(Номенклатура)
	
	Если Номенклатура.ТипНоменклатуры =  Перечисления.ТипыНоменклатуры.Услуга
		ТОгда
		возврат Истина
	Иначе Возврат Ложь
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьИсточникиОбеспеченияПоНеобеспечиваемымТоварам()
	
	М = новый Массив;
	
	ИзНаличия = ВариантОбеспеченияИзНаличия();
	ПодЗаказ = ВариантОбеспеченияПодЗаказ();
	Пустая = ВариантОбеспеченияПустаяСсылка();
	
	Для каждого Стр из Объект.Товары Цикл
			П = Новый Структура;
			П.Вставить("Номенклатура", Стр.Номенклатура);
			П.Вставить("Характеристика", Стр.Характеристика);
			П.Вставить("Количество", Стр.Количество);
			П.Вставить("КоличествоУпаковок", Стр.КоличествоУпаковок);			
			П.Вставить("Упаковка", Стр.Упаковка);
			П.Вставить("СкладИсточник", Стр.СкладИсточник);
			М.Добавить(П);
		
		    // проверим что єто услуги
			Если ЭтоУслуга(Стр.Номенклатура)
				Тогда
				стр.СкладИсточник = ИзНаличия;
			Конецесли;
					
	КонецЦикла;
	
		
	// получим массив со строками, которые надо переформировать
	МР = ОстаткиНаСкладеМагазинаНаСервере(М, Объект.Склад);
		
		Для ИндМ = 0 по МР.КОличество() - 1 цикл
			
			П = МР[ИндМ];
			Номенклатура 				= неопределено;	
			Характеристика				= неопределено;	
			Количество     				= неопределено; 
			КоличествоУпаковок 			= неопределено; 			
			Упаковка		 			= неопределено; 						
			СвобОстатокМагазин 			= неопределено;	
			СвобОстатокСклад			= неопределено;	
			СкладИсточник     			= неопределено;
			ВариантОбеспечения          = неопределено;
			СуммаУдаляемых				= неопределено;
			ПоискПоСкладам				= неопределено;

			// получили данные для заполнения обеспечения по строке, где нет подбора товара
			П.Свойство("Номенклатура", Номенклатура);
			П.Свойство("Характеристика", Характеристика);
			П.Свойство("СвобОстатокМагазин",СвобОстатокМагазин);
			П.Свойство("СвобОстатокСклад",СвобОстатокСклад);
			П.Свойство("Количество",Количество); 
			П.Свойство("КоличествоУпаковок",КоличествоУпаковок); 
			П.Свойство("Упаковка",Упаковка); 
			Кратность = п.Кратность;
			//П.Свойство("ПоискПоСкладам", );
			ПоискПоСкладам = ПоискПоСкладамНоменклатурыНаСервере(Номенклатура);
			
			// + БА исправляем алгоритм
			Стр.ПоискПоСкладам = ПоискПоСкладам;
			ПоискПоСкладам = Ложь;
			// - исправляем алгоритм
			
			//Упак = УпаковкаПоНоменклатуре(Номенклатура);			
			//Если Упаковка.Числитель > 0 Тогда
			//	Знам  = ?(Упаковка.Знаменатель > 0, Упаковка.Знаменатель, 1);
			//	Кратность = Упаковка.Числитель / Знам;
			//ИНаче
			//	Кратность = 1;	
			//КонецЕсли;
						
			ВариантОбеспечения = ЗначениеСкладаИсточникаПоУмолчаниюНов(Номенклатура, Характеристика);
			
			// обработаем если это товар без ручного подбора
			Если ПоискПоСкладам = Ложь
				Тогда
				
			// Удалим все строки, подпадающие под зачистку
	
			СуммаУдаляемых = 0;
			ВсегоОбходим =  Объект.Товары.Количество();
			Для Инд = 1 по ВсегоОбходим  цикл
				Стр = Объект.Товары[ВсегоОбходим - Инд];
				Если
					Стр.Номенклатура     = Номенклатура
					И
					Стр.Характеристика   = Характеристика
									
					Тогда
					СуммаУдаляемых = СуммаУдаляемых + Стр.Сумма;
					Штрихкод = Стр.Штрихкод;
					Продавец = Стр.Продавец;
					Цена = Стр.Цена;
					Идент = ВсегоОбходим - Инд;				
					Объект.Товары.Удалить(Идент);
				
					КонецЕсли;	
			КонецЦикла;	 
			Сдвиг = -1;
			// вставим строки исходя из условий обеспечения
			КоличИзНаличия = 0;
			КоличСоСклада = 0;
			Если число(СвобОстатокМагазин) > 0 
				Тогда
				Сдвиг = Сдвиг + 1;
				КоличИзНаличия = Мин(окр(СвобОстатокМагазин/кратность,0, режимОкругления.Окр15как10),КоличествоУпаковок);  
				
				НовСтр = Объект.Товары.Вставить(Идент + Сдвиг);
				НовСтр.Номенклатура 			= Номенклатура;
				НовСтр.Характеристика 			= Характеристика;
				НовСтр.КоличествоУпаковок 		= КоличИзНаличия;
				НовСтр.Количество 				= КоличИзНаличия * Кратность;
				НовСтр.СкладИсточник 			= ИзНаличия;
				// заполним из данных удаленных строк	
				НовСтр.Штрихкод 				= Штрихкод;
				НовСтр.Продавец 				= Продавец;
				НовСтр.Упаковка 				= Упаковка;
				НовСтр.Цена   					= Цена;
				НовСтр.СтавкаНДС 				= НДСбезНДС();	
				НовСтр.СуммаНДС 				= 0;
				НовСтр.Сумма  					= Стр.КоличествоУпаковок * Стр.Цена;
			КонецЕсли;
			
			Если (КоличествоУпаковок - КоличИзНаличия) > 0
				И	
				число(СвобОстатокСклад) > 0
				Тогда
				Сдвиг = Сдвиг + 1;
				КоличСоСклада = Мин(Окр(СвобОстатокСклад/кратность, 0, режимОкругления.Окр15как10),(КоличествоУпаковок - КоличИзНаличия)); 
				НовСтр = Объект.Товары.Вставить(Идент + Сдвиг);
				НовСтр.Номенклатура 			= Номенклатура;
				НовСтр.Характеристика 			= Характеристика;
				НовСтр.КоличествоУпаковок 		= КоличСоСклада;
				НовСтр.Количество 				= КоличСоСклада * Кратность;
				НовСтр.СкладИсточник 			= ВариантОбеспечения;
				// заполним из данных удаленных строк	
				НовСтр.Штрихкод 				= Штрихкод;
				НовСтр.Продавец 				= Продавец;
				НовСтр.Упаковка 				= Упаковка;
				НовСтр.Цена   					= Цена;
				НовСтр.СтавкаНДС 				= НДСбезНДС();	
				НовСтр.СуммаНДС 				= 0;
				НовСтр.Сумма  					= Стр.КоличествоУпаковок * Стр.Цена;
			КонецЕсли;
			
			Если (КоличествоУпаковок - КоличИзНаличия - КоличСоСклада) > 0
				Тогда
				Сдвиг = Сдвиг + 1;	
				КоличПодЗаказ = КоличествоУпаковок - КоличИзНаличия - КоличСоСклада; 
				НовСтр = Объект.Товары.Вставить(Идент + Сдвиг);
				НовСтр.Номенклатура 			= Номенклатура;
				НовСтр.Характеристика 			= Характеристика;
				НовСтр.КоличествоУпаковок 		= КоличПодЗаказ;
				НовСтр.Количество 				= КоличПодЗаказ * кратность;
				НовСтр.СкладИсточник 			= ПодЗаказ;
				// заполним из данных удаленных строк	
				НовСтр.Штрихкод 				= Штрихкод;
				НовСтр.Продавец 				= Продавец;
				НовСтр.Упаковка 				= Упаковка;
				НовСтр.Цена   					= Цена;
				НовСтр.СтавкаНДС 				= НДСбезНДС();	
				НовСтр.СуммаНДС 				= 0;
				НовСтр.Сумма  					= Стр.КоличествоУпаковок * Стр.Цена;
			КонецЕсли;
			
			
		Иначе
		// обойдем ситуации с поиском складов
		// определим в системе сколько товара по разныма категориям поставки
		
		
		КоличПустых = 0;
		КоличПодЗаказ = 0;
		КоличСборПоМагазинам = 0;
		
		ВсегоОбходим =  Объект.Товары.Количество();
			Для Инд = 1 по ВсегоОбходим  цикл
				Стр = Объект.Товары[ВсегоОбходим - Инд];
				Если
					Стр.Номенклатура     = Номенклатура
					И
					Стр.Характеристика   = Характеристика
					И
					(Стр.СкладИсточник = ИзНаличия
					или 
					Стр.СкладИсточник = Пустая)
					Тогда
					КоличПустых = КоличПустых + Стр.КоличествоУпаковок;
					
				ИначеЕсли	
					Стр.Номенклатура     = Номенклатура
					И
					Стр.Характеристика   = Характеристика
					И
					Стр.СкладИсточник = ПодЗаказ
					Тогда
					КоличПодЗаказ = КоличПодЗаказ + Стр.КоличествоУпаковок;
						
				ИначеЕсли	
					Стр.Номенклатура     = Номенклатура
					И
					Стр.Характеристика   = Характеристика
					И
					НЕ Стр.СкладИсточник = ПодЗаказ
					И
					НЕ Стр.СкладИсточник = ИзНаличия
                    И
					НЕ Стр.СкладИсточник = Пустая
					Тогда
					КоличСборПоМагазинам = КоличСборПоМагазинам + Стр.КоличествоУпаковок;	
					
				КонецЕсли;	
			КонецЦикла;	
			
			// если есть остаток в магазине, то применим его для обеспечения
			// заполненные значения про поставщика или другие магазины не трогам
			
			Если 
				СвобОстатокМагазин > 0
                и 
				КоличПустых > 0
				Тогда 
				Для Инд = 1 по ВсегоОбходим  цикл
				Стр = Объект.Товары[ВсегоОбходим - Инд];
				Если
					Стр.Номенклатура     = Номенклатура
					И
					Стр.Характеристика   = Характеристика
					И
					(Стр.СкладИсточник = ИзНаличия
					или 
					Стр.СкладИсточник = Пустая)
					Тогда
                    // удалим все строки
					Штрихкод = Стр.Штрихкод;
					Продавец = Стр.Продавец;
					Цена = Стр.Цена;
					Идент = ВсегоОбходим - Инд;				
					Объект.Товары.Удалить(Идент);
                	КонецЕсли
				КонецЦикла;	
					
				КоличИзНаличия = мин(КоличПустых, окр(СвобОстатокМагазин/кратность,0, режимОкругления.Окр15как10)); 
				НовСтр = Объект.Товары.Вставить(Идент);
				НовСтр.Номенклатура 			= Номенклатура;
				НовСтр.Характеристика 			= Характеристика;
				НовСтр.КоличествоУпаковок 		= КоличИзНаличия;
				НовСтр.Количество 				= КоличИзНаличия * кратность;
				НовСтр.СкладИсточник 			= ИзНаличия;
				// заполним из данных удаленных строк	
				НовСтр.Штрихкод 				= Штрихкод;
				НовСтр.Продавец 				= Продавец;
				НовСтр.Упаковка 				= Упаковка;
				НовСтр.Цена   					= Цена;
				НовСтр.СтавкаНДС 				= НДСбезНДС();	
				НовСтр.СуммаНДС 				= 0;
				НовСтр.Сумма  					= Стр.Количество * Стр.Цена;  
				
				Если 
				КоличПустых > окр(СвобОстатокМагазин/кратность,0, режимОкругления.Окр15как10)
				Тогда
				КоличИзНаличия = КоличПустых - окр(СвобОстатокМагазин/кратность,0, режимОкругления.Окр15как10); 
				НовСтр = Объект.Товары.Вставить(Идент);
				НовСтр.Номенклатура 			= Номенклатура;
				НовСтр.Характеристика 			= Характеристика;
				НовСтр.КоличествоУпаковок 		= КоличИзНаличия;
				НовСтр.Количество 				= КоличИзНаличия * кратность;
				НовСтр.СкладИсточник 			= Пустая;
				// заполним из данных удаленных строк	
				НовСтр.Штрихкод 				= Штрихкод;
				НовСтр.Продавец 				= Продавец;
				НовСтр.Упаковка 				= Упаковка;
				НовСтр.Цена   					= Цена;
				НовСтр.СтавкаНДС 				= НДСбезНДС();	
				НовСтр.СуммаНДС 				= 0;
				НовСтр.Сумма  					= Стр.Количество * Стр.Цена; 
				КонецЕсли;

			 КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// Боков добавим пересчет суммы
		СуммаВсего = 0;
		Для каждого Стр из ОБъект.Товары цикл
			Стр.Сумма = Стр.КоличествоУпаковок * Стр.Цена;
			СуммаВсего = СуммаВсего + Стр.Сумма;
		КонецЦикла;
		СуммаДокумента = СуммаВсего;
		// 
		
		
		
		БылоПерезаполнениеТЧ = Истина;
		
КонецПроцедуры

