&НаСервере 
Функция ПроверкаОКштрихкодыКЛ(П) 
	Запрос = Новый Запрос;
	
	//1. Номер телефона есть в партнере
	Запрос.Текст =  "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПартнерыКонтактнаяИнформация.НомерТелефона КАК НомерТелефона
	               |ИЗ
	               |	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
	               |ГДЕ
	               |	ПартнерыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон) 
	               |	И ПартнерыКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПартнера)
	               |	И ПартнерыКонтактнаяИнформация.ВидДляСписка = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПартнера)
	               |	И ПартнерыКонтактнаяИнформация.Ссылка = &Партнер";
	Запрос.УстановитьПараметр("Партнер", П.Партнер);
	
	Выборка = Запрос.Выполнить();
	Если Выборка.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//2.Не заполнен штрихкод
	Если НЕ ЗначениеЗаполнено(П.КартаЛояльности.Штрихкод) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Привести Номер телефона и штрихкод к стандарту
	НомерТелефонаПреобр = Выборка.Выгрузить()[0].НомерТелефона;
	НомерТелефонаПреобр = Прав(бит_Сервер.ПреобразоватьНомерТелефона(НомерТелефонаПреобр),10); 
	 
	ВидКЛ = П.КартаЛояльности.Владелец;
	
	ПрефиксШК = бит_Сервер.ПолучитьПрефиксВидаКартыЛояльности(ВидКЛ);
	
	ВидКЛНаименование = ВидКЛ.Наименование;
	
	//3. Штрихкод не равен приведенному номеру телефона в Партнере
	Если НЕ П.КартаЛояльности.Штрихкод = ПрефиксШК + НомерТелефонаПреобр Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//4. Наименование не отформатировано 	
	Если НЕ П.КартаЛояльности.Наименование = Строка(ВидКЛНаименование) + " " + Строка(ПрефиксШК + НомерТелефонаПреобр) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;	
КонецФункции

