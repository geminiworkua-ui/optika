Процедура ПечатьЗаказа(Команда)
	
	СтрПечати = СформироватьТДНаСервере();
	ТабличныйДокумент = СтрПечати.ПечатнаяФормаДокумента.Получить();
	Если ТабличныйДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
