|	СУММА(ОтгруженыеТовары.Сумма) КАК Сумма,
|	СУММА(ОтгруженыеТовары.СуммаНДС) КАК СуммаНДС,
|	СУММА(ОтгруженыеТовары.СуммаСНДС) КАК СуммаСНДС,
|	ОтгруженыеТовары.СтавкаНДС
|ПОМЕСТИТЬ Товары
|ИЗ
|	ОтгруженыеТовары КАК ОтгруженыеТовары
|
|СГРУППИРОВАТЬ ПО
|	ОтгруженыеТовары.Номенклатура,
|	ОтгруженыеТовары.Характеристика,
|	ОтгруженыеТовары.Упаковка,
|	ОтгруженыеТовары.Цена,
|	ОтгруженыеТовары.СтавкаНДС
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	Товары.Номенклатура,
|	Товары.Характеристика,
|	Товары.Упаковка,
|	Товары.КоличествоУпаковок,
|	Товары.Количество,
|	Товары.Цена,
|	Товары.Сумма,
|	Товары.СтавкаНДС,
|	Товары.СуммаНДС,
|	Товары.СуммаСНДС
|ИЗ
|	Товары КАК Товары
|ГДЕ
|	Товары.Количество > 0");
Запрос.УстановитьПараметр("ДокументРеализации", ДокументРеализации);
