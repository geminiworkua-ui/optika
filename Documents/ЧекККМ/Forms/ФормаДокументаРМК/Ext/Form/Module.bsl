	РекомендацияДобавлена = Ложь;
	ibs_РекомендацияНаСервере(РекомендацияДобавлена);
	Если РекомендацияДобавлена Тогда
		ibs_ЧекККМ(Неопределено);	
	КонецЕсли;	
	// -y.surai Assino 2026.08.01
КонецПроцедуры

&НаСервере
Процедура ibs_РекомендацияНаСервере(РекомендацияДобавлена)
	// +y.surai Assino 2026.08.01	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		СтрокиРекомендации = Объект.Товары.НайтиСтроки(Новый Структура("ibs_Рекомендация", Истина));
		Для каждого СтрРек Из СтрокиРекомендации Цикл
			Объект.Товары.Удалить(СтрРек);	
		КонецЦикла;	
		
		П = Новый Структура("ДО");
		П.ДО = Объект.ДокументОснование;
		Рез = КлючКарточкаКлиента(П);
		
		Если Не П = Неопределено Тогда
			Для каждого Стр Из Рез.К.НазначениеЛС Цикл
				НовСтрока 					 = Объект.Товары.Добавить();
				НовСтрока.Номенклатура 		 = Стр.Номенклатура;
				НовСтрока.Количество         = Стр.Количество;
				НовСтрока.КоличествоУпаковок = Стр.Количество;
				НовСтрока.Упаковка 			 = Стр.ЕдИзм;
				НовСтрока.СтавкаНДС 		 = Перечисления.СтавкиНДС.БезНДС;
				НовСтрока.Цена               = ЦенаУслуги(НовСтрока.Номенклатура, Справочники.ВидыЦен.НайтиПоНаименованию("Роздрібна"));
				НовСтрока.Сумма 			 = Число(НовСтрока.Количество) * Число(НовСтрока.Цена);
				НовСтрока.СуммаНДС 			 = 0;
				НовСтрока.ЦенаС              = НовСтрока.Цена;
				НовСтрока.СуммаС             = НовСтрока.Сумма;
				НовСтрока.Продавец 			 = ТекущийПродавец;
				НовСтрока.ibs_Рекомендация 	 = Истина;;
			КонецЦикла;	
		КонецЕсли;
		
		////////// Заказ //////////
		
		Заказ = Объект.ДокументОснование.ПолучитьОбъект();
		
		СтрокиРекомендации = Заказ.Товары.НайтиСтроки(Новый Структура("ibs_Рекомендация", Истина));
		Для каждого СтрРек Из СтрокиРекомендации Цикл
			Заказ.Товары.Удалить(СтрРек);	
		КонецЦикла;
		
		СтрокиРекомендации = Объект.Товары.НайтиСтроки(Новый Структура("ibs_Рекомендация", Истина));
		Для каждого Стр Из СтрокиРекомендации цикл
			СтрЗаказа 					 = Заказ.Товары.Добавить();
			СтрЗаказа.Номенклатура 		 = Стр.Номенклатура;
			СтрЗаказа.Характеристика 	 = Стр.Характеристика;
			СтрЗаказа.Количество         = Стр.Количество;
			СтрЗаказа.КоличествоУпаковок = Стр.Количество;
			СтрЗаказа.Упаковка 			 = Стр.Упаковка;
			СтрЗаказа.СтавкаНДС 		 = Стр.СтавкаНДС;
			СтрЗаказа.Цена 				 = Стр.Цена;
			СтрЗаказа.Сумма 			 = Стр.Сумма;
			СтрЗаказа.СуммаНДС 			 = Стр.СуммаНДС;
			СтрЗаказа.СуммаСНДС 		 = Стр.Сумма; 
			// +y.surai Assino 2026.08.01
			//СтрЗаказа.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется;
			ЭтоУслуга = СтрЗаказа.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
			СтрЗаказа.ВариантОбеспечения = ?(ЭтоУслуга, Перечисления.ВариантыОбеспечения.НеТребуется, Перечисления.ВариантыОбеспечения.Отгрузить);
			// -y.surai Assino 2026.08.01
			СтрЗаказа.ВидЦены 			 = Справочники.ВидыЦен.НайтиПоНаименованию("Роздрібна");
			СтрЗаказа.ДатаОтгрузки 		 = Заказ.ДатаОтгрузки; 
			СтрЗаказа.Склад 			 = Заказ.Склад;
			СтрЗаказа.ibs_Рекомендация 	 = Истина;
		КонецЦикла;
		
		Заказ.СуммаДокумента = Заказ.Товары.Итог("Сумма");
		
		ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(Заказ, Документы.ЗаказКлиента);
		НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Заказ, ПараметрыУказанияСерий);
		
		Попытка
			Заказ.Записать(РежимЗаписиДокумента.Проведение);
			РекомендацияДобавлена = Истина;
		Исключение
			Сообщить(НСтр("ru='Не удалось добавить рекомендации в заказ!';uk='Не вдалося додати рекомендації до замовлення!'"));	
		КонецПопытки;
	КонецЕсли;
	// -y.surai Assino 2026.08.01	
КонецПроцедуры

Функция ЦенаУслуги(Номенклатура, ВидЦены)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
		|ГДЕ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура = &Номенклатура
		|	И ЦеныНоменклатурыСрезПоследних.ВидЦены = &ВидЦены";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Цена;
	КонецЕсли;	
	
КонецФункции

#КонецОбласти




