Процедура СоздатьЧекККМНаОснованииЗаказа(Команда)              
     ТекущийДокумент = Элементы.СписокЗаказов.ТекущаяСтрока;
     ПараметрыРасчета = Новый  Структура;
	 ПараметрыРасчета.Вставить("ЗаказКлиента",ТекущийДокумент);
	 ПараметрыРасчета.Вставить("Склад",ОтборСклад);  
	 ОповещениеОПодборе = Новый ОписаниеОповещения("ПолучениеТаблицыЧеков", ЭтотОбъект);
	 ОстаткиКОплате.Очистить();
	 ОткрытьФорму("ОбщаяФорма.ПодборСуммКОплате", ПараметрыРасчета,	ЭтотОбъект,
					ТекущийДокумент.УникальныйИдентификатор(),,,ОповещениеОПодборе);
	 Элементы.ГруппаПродажаИВозврат.ТекущаяСтраница = Элементы.ГруппаПродажа;
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеТаблицыЧеков(РезультатВыполнения, Параметры) Экспорт
		
	Если РезультатВыполнения = Неопределено Тогда 
		Сообщить("Не обрані товари для оплати"); 
		ЗаполнитьТоварыПоЗаказу();
		Возврат;
	КонецЕсли;
	
	МассивЧеков = РезультатВыполнения.ТаблицаЧеков;     
	Если МассивЧеков =Неопределено Тогда             
		 Сообщить("Не обрані товари для оплати");    
		 ЗаполнитьТоварыПоЗаказу();
         Возврат; 		
	КонецЕсли;	
	
	Если  МассивЧеков.Количество()=0 Тогда 
	    Сообщить("Не обрані товари для оплати"); 
		ЗаполнитьТоварыПоЗаказу();
		Возврат;
	КонецЕсли;	
		
		//ПолучитьДанныеРаспределения(РезультатВыполнения.ТаблицаОплат);	
			
	Для каждого Чек из МассивЧеков Цикл  
		СтрТаб = МассивЧековДляПробития.Добавить();
		СтрТаб.Чек =Чек;
	КонецЦикла;
		
	ПробитьСледующийЧек();

КонецПроцедуры   

