&НаСервере
Функция ПолучитьШтрихкод(Номенклатура, Характеристика, Упаковка);
	Запрос =Новый Запрос(
	"ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура
	|	И ШтрихкодыНоменклатуры.Характеристика = &Характеристика
	|	И ШтрихкодыНоменклатуры.Упаковка = &Упаковка");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("Упаковка", Упаковка);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Штрихкод;
	Иначе Возврат "";
	КонецЕсли;	
КонецФункции

&НаКлиенте
Процедура ОткрытьРекомендацииВрача(Команда)
	
	П = Новый Структура("ДО");
	П.ДО = Объект.ДокументОснование;
	
	
	Рез = КлючКарточкаКлиента(П);
	
	Если Не Рез = неопределено Тогда
		Ф = Неопределено;
		К = Неопределено;
		Рез.Свойство("Ф", Ф);
		Рез.Свойство("К", К);
		
		ПараметрыОткрытия = Новый Структура("Ключ", К);
		ОткрытьФорму(Ф, ПараметрыОткрытия);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаказ(Команда)
	М = Новый Массив;
	Для каждого Стр из Объект.Товары цикл
		М.Добавить(Стр.Номенклатура);
	КонецЦикла;
	
	Если ЕстьРаботаМастера(М)
		Тогда
		П = Новый Структура;
		П.Вставить("Пациент", Объект.Партнер);
		ОповещениеОВыбореРецепта2 = Новый ОписаниеОповещения("ОповещениеОВыбореРецепта2", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ФормаЗаполненияРецепта",П,ЭтаФорма,,,,ОповещениеОВыбореРецепта2,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		П = неопределено;
		ПродолжитьОбновлениеЗаказа(П);
	КонецЕсли;
КонецПроцедуры  

