Процедура СоздатьДокументыВозвратаТовара(Заказ)
ЗапросРеализации = Новый Запрос(
"ВЫБРАТЬ
|	РеализацияТоваровУслуг.Ссылка
|ИЗ
|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
|ГДЕ
|	РеализацияТоваровУслуг.ЗаказКлиента = &ЗаказКлиента
|	И РеализацияТоваровУслуг.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРеализацийТоваровУслуг.Отгружено)
|	И РеализацияТоваровУслуг.Проведен");
ЗапросРеализации.УстановитьПараметр("ЗаказКлиента", Заказ);
Результат = Запросреализации.Выполнить().Выбрать();

Пока Результат.Следующий() Цикл
	ДокВозврат = Документы.ВозвратТоваровОтКлиента.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ДокВозврат, Результат.ссылка);
	ДокВозврат.Дата = ТекущаяДата();
	ДокВозврат.ДокументРеализации = Результат.ссылка;
	ДокВозврат.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	ДокВозврат.ПричинаВозврата = "Отказ клиента";
	ДокВозврат.ДокументРеализации = Результат.ссылка;
	МассивТоваровВозврата = ПолучитьМассивТоваровНаВозврат(Результат.ссылка);

	Для каждого Стр Из МассивТоваровВозврата Цикл
	 СтрТов = ДокВозврат.Товары.Добавить();
	 ЗаполнитьЗначенияСвойств(СтрТов, Стр); 
	 СтрТов.АналитикаУчетаНоменклатуры = РегистрыСведений.АналитикаУчетаНоменклатуры.ЗначениеКлючаАналитики(ПараметрыАналитики(Стр, ДокВозврат.Склад));
	 СтавкаНДСЧИслом = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(СтрТов.СтавкаНДС);
	 ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрТов.Сумма, СтавкаНДСЧИслом ,ДокВозврат.ЦенаВключаетНДС);
	КонецЦикла; 
			
		Если Не ДокВозврат.Товары.Количество() = 0	 Тогда
			ДокВозврат.СуммаДокумента = ЦенообразованиеКлиентСервер.ПолучитьСуммуДокумента(ДокВозврат.Товары, ДокВозврат.ЦенаВключаетНДС);	
			ДокВозврат.Записать(РежимЗаписиДокумента.Проведение);                         
			Сообщить("За документом "+Строка(Результат.ссылка) + " оформлено повернення товарів " +Строка(ДокВозврат.Ссылка)); 
		Иначе
			Сообщить("За документом "+Строка(Результат.ссылка) + " не оформлено поверненя"); 
		КонецЕсли;		
 
КонецЦикла;
 
КонецПроцедуры	

Функция ПараметрыАналитики(Стр, Склад)
ПараметрыАналитики = Новый Структура;
ПараметрыАналитики.Вставить("Номенклатура", Стр.Номенклатура);
ПараметрыАналитики.Вставить("Характеристика", Стр.Характеристика); 
ПараметрыАналитики.Вставить("Склад", Склад);
Возврат ПараметрыАналитики; 
