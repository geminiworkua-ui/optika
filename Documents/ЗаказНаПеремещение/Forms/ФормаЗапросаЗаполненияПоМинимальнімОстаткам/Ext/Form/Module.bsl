
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВидыНоменклатуры.Ссылка как ВидНоменклатуры
	                      |ИЗ
	                      |	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	                      |ГДЕ
	                      |	ВидыНоменклатуры.ТипНоменклатуры = &ТипНоменклатуры
	                      |	И НЕ ВидыНоменклатуры.ПометкаУдаления"); 
	
	Запрос.УстановитьПараметр("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Товар);
	Выборка = Запрос.Выполнить().Выгрузить();
	ВидыНоменклатуры.Загрузить(Выборка);
		
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	М = Новый массив;
	Для каждого Стр из ВидыНоменклатуры цикл
		Если Стр.МЕтка
			ТОгда
			М.Добавить(СТр.ВидНоменклатуры);
		КонецЕсли;
	КонецЦикла;
	П= новый Структура("м, ГруппаНоменклатуры", М, ГруппаНоменклатуры);
	ЭтаФорма.Закрыть(П);
	
КонецПроцедуры
