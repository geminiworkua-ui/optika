	|	ХарактеристикиНоменклатуры.Контрагент,
	|	ХарактеристикиНоменклатуры.Описание,
	|	ХарактеристикиНоменклатуры.Срок,
	|	ХарактеристикиНоменклатуры.КвоВЯщике,
	|	ХарактеристикиНоменклатуры.ИмеетСостав,
	|	ХарактеристикиНоменклатуры.Регистрация,
	|	ХарактеристикиНоменклатуры.Сертификат,
	|	ХарактеристикиНоменклатуры.Артикул,
	|	ХарактеристикиНоменклатуры.АртикулБР,
	|	ХарактеристикиНоменклатуры.ЕдиницаИзмерения,
	|	ХарактеристикиНоменклатуры.ЕдиницаИзмеренияМин,
	|	ХарактеристикиНоменклатуры.ЕдиницаИзмеренияЯщик,
	|	ХарактеристикиНоменклатуры.КФФЦены,
	|	ХарактеристикиНоменклатуры.Объем,
	|	ХарактеристикиНоменклатуры.СвоиЦены,
	|	ХарактеристикиНоменклатуры.Вес,
	|	ХарактеристикиНоменклатуры._Сфера,
	|	ХарактеристикиНоменклатуры._Аддідація,
	|	ХарактеристикиНоменклатуры._Циліндр,
	|	ХарактеристикиНоменклатуры._Диаметр,
	|	ХарактеристикиНоменклатуры._Радіус,
	|	ХарактеристикиНоменклатуры._Вісь,
	|	ХарактеристикиНоменклатуры._Дегресія,
	|	ХарактеристикиНоменклатуры._Цвет
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	(ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры = &ВидНоменклатуры
	|			ИЛИ &ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка))
	|	И (ХарактеристикиНоменклатуры.Владелец.Родитель В ИЕРАРХИИ (&ГруппаНоменклатуры)
	|			ИЛИ &ГруппаНоменклатуры = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|	И НЕ ХарактеристикиНоменклатуры.Владелец.ПометкаУдаления
	|	И НЕ ХарактеристикиНоменклатуры.ПометкаУдаления"
	);
	
	Индекс =0;
	
	ЗапросХар.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
	ЗапросХар.УстановитьПараметр("ГруппаНоменклатуры", ГруппаНоменклатуры);

	
	Для каждого Свойство из ВидНоменклатуры.РеквизитыДляКонтроляХарактеристик Цикл
		
		Если Свойство.ТребоватьЗаполнения и ВыводитьТолькоНезаполненные Тогда
			ПД = Свойство.ИмяРеквизита;
			СВ = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()[ПД];
			Значение = ЗначениеДляСравнения(СВ);
			
			Если Значение =Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Индекс =0 Тогда
				Запрос.Текст = Запрос.Текст + " И ( ХарактеристикиНоменклатуры." + ПД + "="+ Значение;
			Иначе
				Запрос.Текст = Запрос.Текст + " Или ХарактеристикиНоменклатуры." + ПД + "=" + Значение;
			КонецЕсли; 
			
			Индекс = Индекс +1;
			
		КонецЕсли;
		
	КонецЦикла;  
	
	Если Не Индекс=0 Тогда
		ЗапросХар.Текст = Запрос.Текст + " )";
	КонецЕсли;
	Результат = ЗапросХар.Выполнить().Выгрузить();
	Объект.Характеристики.Загрузить(Результат);
		
КонецПроцедуры

Функция ЗначениеДляСравнения(Свойство)
Если ТипЗнч(Свойство) = Тип("Строка") Тогда
		Возврат Символ(34) + Символ(34);
ИначеЕсли ТипЗнч(Свойство) = Тип("Булево") Тогда
		Возврат Неопределено;	                          
ИначеЕсли ТипЗнч(Свойство) = Тип("Число") Тогда
		Возврат "0";	 		
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.Марки") 					Тогда
		Возврат "Значение(Справочник.Марки.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.Производители") 			Тогда
		Возврат "Значение(справочник.Производители.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.КоллекцииНоменклатуры") 	Тогда
		Возврат "Значение(справочник.КоллекцииНоменклатуры.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.ТоварныеКатегории") 		Тогда
		Возврат "Значение(справочник.ТоварныеКатегории.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.Модели") 				Тогда
		Возврат "Значение(справочник.Модели.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.СтраныМира") 			Тогда
		Возврат "Значение(справочник.СтраныМира.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.КодыМариона") 			Тогда
		Возврат "Значение(справочник.КодыМариона.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.НазначениеКонтКоррекции")Тогда
		Возврат "Значение(справочник.НазначениеКонтКоррекции.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.РежимЗамены")            Тогда
		Возврат "Значение(справочник.РежимЗамены.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.Категория")              Тогда
		Возврат "Значение(справочник.Категория.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.ТипРаствора")            Тогда
		Возврат "Значение(справочник.ТипРаствора.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.ВидАксессуара")          Тогда
		Возврат "Значение(справочник.ВидАксессуара.ПустаяСсылка)";
ИначеЕсли ТипЗнч(Свойство) = Тип("СправочникСсылка.ВидАксессуараОчки")      Тогда
		Возврат "Значение(справочник.ВидАксессуараОчки.ПустаяСсылка)";
