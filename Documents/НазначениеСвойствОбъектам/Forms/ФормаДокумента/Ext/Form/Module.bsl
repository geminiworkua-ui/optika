Процедура НастройкаСвойств()
	
	Если объект.ВидНоменклатуры = справочники.ВидыНоменклатуры.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Свойство из объект.ВидНоменклатуры.РеквизитыДляКонтроляНоменклатуры Цикл  
		  ДопСвойство = "Товары"+Свойство.ИмяРеквизита;

		Если Свойство.ОбязателенДляЗаполнения Тогда
			Попытка  
				Элементы.Товары.ПодчиненныеЭлементы[ДопСвойство].Видимость = Истина;  
				Элементы.Товары.ПодчиненныеЭлементы[ДопСвойство].АвтоОтметкаНезаполненного = Истина;
			Исключение

			КонецПопытки;	
		Иначе
			Попытка  
				Элементы.Товары.ПодчиненныеЭлементы[ДопСвойство].Видимость = Ложь;
			Исключение

			КонецПопытки;
		КонецЕсли;	
	КонецЦикла; 
	
	Если Не объект.ВидНоменклатуры.ИспользованиеХарактеристик = перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
		Элементы.Характеристики.Видимость = Ложь;
		Возврат;
	КонецЕсли;	
	
	Для каждого Свойство из объект.ВидНоменклатуры.РеквизитыДляКонтроляХарактеристик Цикл  
		  ДопСвойство = "Характеристики"+Свойство.ИмяРеквизита;

		Если Свойство.ТребоватьЗаполнения Тогда
			Попытка  
				Элементы.Характеристики.ПодчиненныеЭлементы[ДопСвойство].Видимость = Истина;
			Исключение

			КонецПопытки;	
		Иначе
			Попытка  
				Элементы.Характеристики.ПодчиненныеЭлементы[ДопСвойство].Видимость = Ложь;
			Исключение

			КонецПопытки;
		КонецЕсли;	
	КонецЦикла; 

	
	//Для каждого Свойство из Объект.ВидНоменклатуры.РеквизитыБыстрогоОтбораНоменклатуры Цикл
	//   		  ДопСвойство = "Товары"+Свойство.ИмяРеквизита;
	//		Попытка  
	//			Элементы.Товары.ПодчиненныеЭлементы[ДопСвойство].Видимость = Истина;
	//		Исключение

	//		КонецПопытки;	
	//КонецЦикла;
	//
	//Для каждого Свойство из Объект.ВидНоменклатуры.РеквизитыБыстрогоОтбораХарактеристик Цикл
	//   		  ДопСвойство = "Характеристики"+Свойство.ИмяРеквизита;
	//		Попытка  
	//			Элементы.Характеристики.ПодчиненныеЭлементы[ДопСвойство].Видимость = Истина;
	//		Исключение

	//		КонецПопытки;	
	//КонецЦикла;
	//
	Элементы.ТоварыСайтLuxor.Видимость = Истина;
	Элементы.ТоварыСайтPolaroid.Видимость = Истина;
КонецПроцедуры	

