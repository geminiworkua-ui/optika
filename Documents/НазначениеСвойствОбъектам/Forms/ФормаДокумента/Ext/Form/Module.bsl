	|			ИЛИ &ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка))
	|	И (Номенклатура.Родитель В ИЕРАРХИИ (&ГруппаНоменклатуры)
	|			ИЛИ &ГруппаНоменклатуры = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|	И НЕ Номенклатура.ПометкаУдаления");
	
	Индекс =0;
	
