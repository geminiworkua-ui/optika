	Запрос.УстановитьПараметр("ГруппаНоменклатуры", ГруппаНоменклатуры);
    
	Для каждого Свойство из Объект.ВидНоменклатуры.РеквизитыДляКонтроляНоменклатуры Цикл
		
		Если Свойство.ТребоватьЗаполнения и ОБъект.ВыводитьТолькоНезаполненные ТОгда
			ПД = Свойство.ИмяРеквизита;
			
			Если ПД ="Номенклатура" Тогда
				Продолжить;
			КонецЕсли;
			
			СВ = Справочники.Номенклатура.ПустаяСсылка()[ПД];
			Значение = ЗначениеДляСравнения(СВ);
			
			Если Значение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Индекс =0 Тогда
				Запрос.Текст = Запрос.Текст + " И ( Номенклатура." + ПД + "="+ Значение;
			Иначе
				Запрос.Текст = Запрос.Текст + " Или Номенклатура." + ПД + "=" + Значение;
			КонецЕсли; 
			
			Индекс = Индекс +1;
		КонецЕсли;
	КонецЦикла;  
	
	Если Не Индекс=0 Тогда
		Запрос.Текст = Запрос.Текст + " )";
	КонецЕсли;
	Результат = Запрос.Выполнить().Выгрузить();
	Объект.Товары.Загрузить(Результат);
	
	//Для каждого Стр из Товары цикл
	//	ЗаполнитьЗначенияСвойств(Стр, Стр.Номенклатура)
	//КонецЦикла;
