Процедура ТоварыНоменклатураПриИзменении(Элемент)
		// нужно перезаполнить данные по текущей пощиции номенклатуры
	ТекСтр = Элементы.Товары.ТекущиеДанные;
	Если Не ТекСтр = неопределено
		И ЗначениеЗаполнено(ТекСтр.Номенклатура)
	Тогда	
	Рез = СтруктураданныхПоПозицииНоменклатуре(ТекСтр.Номенклатура);
	ЗаполнитьЗначенияСвойств(ТекСтр, Рез, ,"Номенклатура");
	КонецЕсли;
