	ЗаполнитьЗначенияСвойств(НовСтр, Стр);
КонецЦикла;	

КонецПроцедуры	
	
Функция ПолучитьУзлы()
Запрос =Новый Запрос(
"ВЫБРАТЬ
|	ОбменССайтомНовый.Ссылка
|ИЗ
|	ПланОбмена.ОбменССайтомНовый КАК ОбменССайтомНовый
|ГДЕ
|	НЕ ОбменССайтомНовый.ПометкаУдаления
|	И НЕ ОбменССайтомНовый.ЭтотУзел");

Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
Возврат Результат;
КонецФункции

Функция ПолучитьУзлыОбмена(Номенклатура, Характеристика)
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	СвойстваОбъектовСайт.Сайт
|ИЗ
|	РегистрСведений.СвойстваОбъектовСайт КАК СвойстваОбъектовСайт
|ГДЕ
|	СвойстваОбъектовСайт.Номенклатура = &Номенклатура
|	И СвойстваОбъектовСайт.Характеристика = &Характеристика");

Запрос.УстановитьПараметр("номенклатура", Номенклатура);
Запрос.УстановитьПараметр("Характеристика", Характеристика);
Результат = Запрос.Выполнить().Выгрузить();
Если Результат.Количество()=0 Тогда
	Возврат Новый Массив;
Иначе Возврат Результат.ВыгрузитьКолонку("сайт");
КОнецЕсли;	
КОнецФункции	