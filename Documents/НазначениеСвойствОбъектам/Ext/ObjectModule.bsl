Функция СвойствоОбъекта(Наименование) 
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СвойстваОбъектов.Ссылка
	|ИЗ
	|	Справочник.СвойстваОбъектов КАК СвойстваОбъектов
	|ГДЕ
	|	СвойстваОбъектов.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.ссылка;
	КонецЕсли;	
	ЭлСпр = справочники.СвойстваОбъектов.СоздатьЭлемент();
	ЭлСпр.Наименование = Наименование;
	ЭлСпр.НаименованиеРеквизита = Наименование;
	ЭлСпр.Записать();
	Возврат ЭлСпр.Ссылка;
КонецФункции
	
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.ПеремещениеТоваров") или ТипДанныхЗаполнения = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		  ЗаполнитьТЧПоПеремещению(ДанныеЗаполнения)
	КонецЕсли;
	
	
