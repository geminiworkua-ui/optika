	НаборСС.Отбор.Номенклатура.Установить(Стр.Номенклатура);
	НаборСС.Отбор.Характеристика.Установить(Стр.Характеристика);
	НаборСС.Отбор.Направление.Установить(Перечисления.НаправлениеДляПередачи.Описание); 
	НаборСС.Записать();
	Если НаборСС.Количество()=0 Тогда   
	 	Запись = наборСС.Добавить();
	 	Запись.Номенклатура = Стр.Номенклатура;
		Запись.Характеристика = Стр.Характеристика;
	 	Запись.Направление = Перечисления.НаправлениеДляПередачи.Описание;
	 	НаборСС.Записать(Истина);		
	КонецЕсли;                   
	
	//Узлы =ПолучитьУзлыОбмена(Стр.Номенклатура, Стр.Характеристика);
	//ПланыОбмена.ЗарегистрироватьИзменения(Узлы,НаборСС);		
	//
	Если НЕ Узлы.КОличество() = 0 тогда
		  ПланыОбмена.ЗарегистрироватьИзменения(Узлы,НаборСС);		
	КонецЕсли;

	
КонецЦикла;	      


