

Процедура ОбработкаПроведения(Отказ, Режим)
		
    узлы = сайты.ВыгрузитьКолонку("Сайт");

	
Для Каждого Стр ИЗ Товары Цикл
	Товар = Стр.Номенклатура.ПолучитьОбъект();
	ЗаполнитьЗначенияСвойств(Товар, Стр,);  
	
	Для каждого Узел из Узлы Цикл 
		Если Узел.СайтLuxor Тогда 	
			Товар.СайтLuxor  = Истина;
		КонецЕсли;
	    Если Узел.СайтPolaroid Тогда 	
			Товар.СайтPolaroid  = Истина;
		КонецЕсли;
    	
		НаборСС = РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
		НаборСС.Отбор.Номенклатура.Установить(Стр.Номенклатура);
		НаборСС.Отбор.Направление.Установить(Перечисления.НаправлениеДляПередачи.Описание); 
		НаборСС.Отбор.УзелРегистрации.Установить(Узел);
		НаборСС.Прочитать();
		Если НаборСС.Количество() = 0 Тогда 
		 	Запись = наборСС.Добавить();
		 	Запись.Номенклатура = Стр.Номенклатура;
		 	Запись.Направление = Перечисления.НаправлениеДляПередачи.Описание;
			Запись.УзелРегистрации = Узел;
		 	НаборСС.Записать(Истина);		
		КонецЕсли;                   
			
		ПланыОбмена.ЗарегистрироватьИзменения(Узел,НаборСС);		
		
		НаборСС = РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
		НаборСС.Отбор.Номенклатура.Установить(Стр.Номенклатура);
		НаборСС.Отбор.Направление.Установить(Перечисления.НаправлениеДляПередачи.ДопРеквизиты); 
		НаборСС.Отбор.УзелРегистрации.Установить(Узел);
		НаборСС.Прочитать();
		Если НаборСС.Количество() = 0 Тогда 
		 	Запись = наборСС.Добавить();
		 	Запись.Номенклатура = Стр.Номенклатура;
		 	Запись.Направление = Перечисления.НаправлениеДляПередачи.ДопРеквизиты;
			Запись.УзелРегистрации = Узел;
		 	НаборСС.Записать(Истина);		
		КонецЕсли;              
		
		ПланыОбмена.ЗарегистрироватьИзменения(Узел,НаборСС);	
КонецЦикла; 
	
	Товар.Записать();
	
КонецЦикла;	      

