
&НаСервере
Процедура ЗаменаСогласованаПриИзмененииНаСервере()
    	
	Объект.КтоСогласовал = ПараметрыСеанса.ТекущийПользователь;
	Объект.ДатаСогласованияЗамены = Текущаядата();
	Элементы.ЗаменаСогласована.ТолькоПросмотр = Истина;
	Элементы.КомментарийСогласования.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменаСогласованаПриИзменении(Элемент)
	ЗаменаСогласованаПриИзмененииНаСервере();      
	//Элементы.ЗаменаСогласована.ТолькоПросмотр = Объект.ЗаменаСогласована;
	//Элементы.КомментарийСогласования.ТолькоПросмотр = Объект.ЗаменаСогласована;  
	Объект.ЗаменаОтменена = Ложь;
	ЗаполнитьСтатусЗамены();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЭтоНовыйДокумент")
		ТОгда
		Объект.Автор = Параметры.Автор;
		Объект.Дата = Текущаядата();
		Объект.Назначение = Параметры.Назначение;
		Объект.ЗаказКлиента= Объект.Назначение.Заказ;
		Если ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда
			Объект.Подразделение = Объект.ЗаказКлиента.Подразделение;
			Объект.Склад = Объект.ЗаказКлиента.Склад;
			Покупатель = Объект.ЗаказКлиента.Партнер;
		КонецЕсли;
		Объект.СхемаОбеспечения = Объект.Номенклатура.СхемаОбеспечения;
		Объект.Номенклатура = Параметры.Номенклатура;
		Объект.Характеристика = Параметры.Характеристика;
		Объект.Количество = Параметры.Количество;
		Объект.ЗаказПоставщику = Параметры.ЗаказПоставщику;
		
	КонецЕсли;
	
	Если НЕ РОльДоступна("ПолныеПрава")
		Тогда
		
		Если 
			РольДоступна("ПравоИнициироватьЗаменуНоменклатуры")
			Тогда
			ПравоИнициировать = Истина
		Иначе
			ПравоИнициировать = Ложь
		КонецЕсли;
		
		Если 
			РольДоступна("ПравоСогласоватьЗаменуНоменклатуры")
			Тогда
			ПравоСогласовать = Истина
		Иначе
			ПравоСогласовать = Ложь
		КонецЕсли;
		
		Элементы.ГруппаИнициирование.ТолькоПросмотр =  НЕ ПравоИнициировать;
		Элементы.КомментарийИнициатора.ТолькоПросмотр = НЕ ПравоИнициировать;
		Элементы.ГруппаСогласование.ТолькоПросмотр = НЕ ПравоСогласовать;
		Элементы.ДатаВыполненияЗамены.ТолькоПросмотр = НЕ ПравоИнициировать;
		Элементы.ВыполнитьЗамену.Доступность = ((ПравоИнициировать И Не Объект.ЗаменаВыполнена и Объект.ЗаменаСогласована) ИЛИ РОльДоступна("ПолныеПрава"));
		Элементы.ГруппаОписаниеЗамены.ТолькоПросмотр = НЕ ПравоИнициировать;
		
	КонецЕсли;
	
	Если Не значениезаполнено(Объект.Автор) 
		ТОгда
		Объект.Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда
		Покупатель = Объект.ЗаказКлиента.Партнер;
	КонецЕсли;
	
	СписокЗамен.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	
	Если ЕстьЗамены(Объект.Ссылка)
		Тогда 
		  Элементы.ВыполнитьЗамену.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьЗамены(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеестрЗаменНоменклатуры.ДокументЗамены
		|ИЗ
		|	РегистрСведений.РеестрЗаменНоменклатуры КАК РеестрЗаменНоменклатуры
		|ГДЕ
		|	РеестрЗаменНоменклатуры.ДокументРегистратор = &ДокументРегистратор
		|
		|СГРУППИРОВАТЬ ПО
		|	РеестрЗаменНоменклатуры.ДокументЗамены";
	
	Запрос.УстановитьПараметр("ДокументРегистратор", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Истина
	Иначе
		Возврат Ложь
	КонецЕсли;
	
КонецФункции	



&НаКлиенте
Процедура ВыполнитьЗамену(Команда)
	
	Если Объект.ЗаменаСогласована
		И ЗначениеЗаполнено(Объект.НоменклатураНов)
		И (НЕ ХарактеристикаНужна(Объект.НоменклатураНов) и НЕ ЗначениеЗаполнено(Объект.ХарактеристикаНов))

		Тогда
		П = Новый Структура;
		П.Вставить("НоменклатураСтар", Объект.Номенклатура);
		П.Вставить("ХарактеристикаСтар", Объект.Характеристика);
		П.Вставить("НоменклатураНов", Объект.НоменклатураНов);
		П.Вставить("ХарактеристикаНов", Объект.ХарактеристикаНов);
		П.Вставить("Назначение", Объект.Назначение);
		П.Вставить("Количество", Объект.Количество);
		П.Вставить("ДокументСсылка", Объект.Ссылка);
		
		ОповещениеЗамена = Новый ОписаниеОповещения("ОповещениеЗамена", ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ОформлениеЗаменыНоменклатуры",П,ЭтаФорма,,,,ОповещениеЗамена,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		Сообщить("По обраній позиції не визнечени документи замовлень. Реєстрація зміни номенклатури неможлива");
	КонецЕсли;
	
	 
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеЗамена(Результат, ДополнительныеПараметры) экспорт
	
	Если 
		Не Результат = Неопределено 
		И 
		Результат.Свойство("Успешно")
		тогда 
		Объект.ЗаменаВыполнена = Истина;
		Объект.ДатаВыполненияЗамены = ТекущаяДата();
		Объект.СтадияЗапросаНаЗамену = ПредопределенноеЗначение("Перечисление.СтадииЗапросовНаЗамену.ЗаменаВыполнена");
		Элементы.ВыполнитьЗамену.Доступность = Ложь;
		Записать();                     
		
		Элементы.СписокЗамен.Обновить();
		
	КонецЕсли;
	              	
КонецПроцедуры	
              
&НаСервере
Функция ХарактеристикаНужна(Номенклатура)
	Возврат Инфра_ОбщиеМодули.ХарактеристикаНужна(Номенклатура);
КонецФункции	

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	П = Новый Структура("Ссылка", ОБъект.Ссылка);
	Оповестить("ЗаписьЗапросаНаЗамену", П);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтатусЗамены()
	 
	 Если Объект.ЗаменаВыполнена  
		 Тогда 
		 Объект.СтадияЗапросаНаЗамену = ПредопределенноеЗначение("Перечисление.СтадииЗапросовНаЗамену.ЗаменаВыполнена");
	 ИначеЕсли Объект.ИсключенАвтором 
		 Тогда 
		 Объект.СтадияЗапросаНаЗамену = ПредопределенноеЗначение("Перечисление.СтадииЗапросовНаЗамену.ОтмененАвтором");
	 ИначеЕсли 
		 Объект.ЗаменаСогласована 
		 Тогда 
		 Объект.СтадияЗапросаНаЗамену = ПредопределенноеЗначение("Перечисление.СтадииЗапросовНаЗамену.СогласованПокупателем");
	 ИначеЕсли 
		 Объект.ЗаменаОтменена 
		 Тогда 
		 Объект.СтадияЗапросаНаЗамену = ПредопределенноеЗначение("Перечисление.СтадииЗапросовНаЗамену.ОтмененПокупателем");
	 Иначе
		 Объект.СтадияЗапросаНаЗамену = ПредопределенноеЗначение("Перечисление.СтадииЗапросовНаЗамену.Инициирован");
	 КонецЕсли;
	 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаполнитьСтатусЗамены();
КонецПроцедуры

&НаКлиенте
Процедура ИсключенАвторомПриИзменении(Элемент)
	ЗаполнитьСтатусЗамены();
КонецПроцедуры

&НаКлиенте
Процедура ЗаменаОтмененаПриИзменении(Элемент)
	Объект.ЗаменаСогласована = Ложь;
	ЗаполнитьСтатусЗамены();
КонецПроцедуры

&НаКлиенте
Процедура ЗаменаВыполненаПриИзменении(Элемент)
	ЗаполнитьСтатусЗамены();
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаменВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтр = Элементы.СписокЗамен.ТекущиеДанные;
	Если Не ТекСтр = Неопределено
		Тогда
		СтандартнаяОбработка = Ложь;
		П = Новый Структура("Ключ",ТекСтр.ДокументЗамены); 
		Если ТипЗнч(ТекСтр.ДокументЗамены) = Тип("ДокументСсылка.ЗаказКлиента")
			Тогда ФормаДок = "Документ.ЗаказКлиента.Форма.ФормаДокумента"
		ИНАче
			ФормаДок = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента"
		КонецЕсли;
			
		ОткрытьФорму(ФормаДок, П, ЭтаФорма, ,,,,РежимОТкрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;

КонецПроцедуры
