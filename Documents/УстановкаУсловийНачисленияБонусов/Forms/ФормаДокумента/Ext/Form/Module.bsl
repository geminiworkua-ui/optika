КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеПриОткрытии()
	
	 // заполним основную таблицу
 	ЭтаФорма.ПовременноеНачисчениеНаФорме.Очистить();
		
	Для каждого Стр из Объект.ПовременноеНачисление цикл
		НовСтр =  ЭтаФорма.ПовременноеНачисчениеНаФорме.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
	КонецЦикла;
	
	// заполним уровни ставок
	
	ЗаполнитьПереченьУсловийПрименения();	
	
	Если ЭтаФорма.ПовременноеНачисчениеНаФорме.Количество() > 0 Тогда
		
		ЭтаФорма.ТекущееЗначениеСтавки = ЭтаФорма.УровниСтавок[0].Ставка;
		ЭтаФорма.ТекущийУровеньСтавки = ЭтаФорма.УровниСтавок[0].УровеньСтавки;
		
	Для каждого Стр из ЭтаФорма.ПовременноеНачисчениеНаФорме цикл
		Если Стр.Ставка = ЭтаФорма.ТекущееЗначениеСтавки тогда
			НовСтр = ЭтаФорма.УсловияВыполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		КонецЕсли;
	КонецЦикла;	 
		
	КонецЕсли;	

	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПереченьУсловийПрименения()	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаУсловийНачисленияБонусовПовременноеНачисление.Ставка,
		|	СУММА(0) КАК УровеньСтавки
		|ИЗ
		|	Документ.УстановкаУсловийНачисленияБонусов.ПовременноеНачисление КАК УстановкаУсловийНачисленияБонусовПовременноеНачисление
		|ГДЕ
		|	УстановкаУсловийНачисленияБонусовПовременноеНачисление.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаУсловийНачисленияБонусовПовременноеНачисление.Ставка";
	
	Запрос.УстановитьПараметр("Ссылка", ОБъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТЗ = Новый  ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить(); 
	
	Ном = 1;
	Для каждого Стр из ТЗ цикл
		Стр.УровеньСтавки = Ном;
		Ном = Ном + 1;
	КонецЦикла;
	
	ЭтаФорма.УровниСтавок.Загрузить(ТЗ);	
	
КонецПроцедуры

&НаКлиенте
Процедура УровниСтавокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
//	ПеренестиДанныеВСводнуюФорму();
	ТекСтр = Элементы.УровниСтавок.ТекущиеДанные;
	ЭтаФорма.ТекущийУровеньСтавки = ТекСтр.УровеньСтавки;
	ЭтаФорма.ТекущееЗначениеСтавки = ТекСтр.Ставка;
	
	ЭтаФорма.УсловияВыполнения.Очистить();
	Для каждого Стр из ЭтаФорма.ПовременноеНачисчениеНаФорме цикл
		Если Стр.Ставка = ЭтаФорма.ТекущееЗначениеСтавки тогда
			НовСтр = ЭтаФорма.УсловияВыполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

