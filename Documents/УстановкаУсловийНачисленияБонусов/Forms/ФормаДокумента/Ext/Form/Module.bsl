&НаСервере
Процедура ПеренестиДанныеВСводнуюФорму()

	ТЧ = ЭтаФорма.ПовременноеНачисчениеНаФорме;
	Ин = ТЧ.Количество();
	
	Для Инд = 1 по Ин цикл
		НомСтр = Ин - Инд;
		Если ТЧ[НомСтр].УровеньБонуса = ЭтаФорма.ТекущийУровеньСтавки
			Тогда
			Индекс = ТЧ.Индекс(ТЧ[Инд]);
			ТЧ.Удалить(ИНдекс);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Запись из ЭтаФорма.УсловияВыполнения цикл
		
		НовСтр = ЭтаФорма.ПовременноеНачисчениеНаФорме.Добавить();
		НовСтр.УровеньСтавки =  ЭтаФорма.ТекущийУровеньСтавки;
		НовСтр.УсловиеПрименения = Запись.УсловиеПрименения;
		НовСтр.ПороговоеЗначение = Запись.ТекущееЗначениеСтавки;
		НовСтр.Ставка = ЭтаФорма.ТекущееЗначениеСтавки;
		
	КонецЦикла;
	

КонецПроцедуры

&НаКлиенте
Процедура УровниСтавокСтавкаПриИзменении(Элемент)
	 
	ЭтаФорма.ТекущееЗначениеСтавки = Элементы.УровниСтавок.ТекущиеДанные.Ставка;
	
	ЭтаФорма.УровниСтавок.Сортировать("Ставка");
	
	НомСтавки = 1; 
	Для каждого Стр из ЭтаФорма.УровниСтавок цикл
		
		Стр.УровеньСтавки =НомСтавки;
		НомСтавки = НомСтавки + 1;
		
		Если Стр.Ставка = ЭтаФорма.ТекущийУровеньСтавки
			Тогда
			Элементы.УровниСтавок.ТекущаяСтрока = Стр;
			ЭтаФорма.ТекущийУровеньСтавки = Стр.УровеньСтавки;
		КонецЕсли;   
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияВыполненияПриИзменении(Элемент)
	
	ТекСтр = Элементы.УсловияВыполнения.ТекущиеДанные;
	
	ОчиститьЗаписатьТаблицуСДаннымиСтавки(ЭтаФорма.ТекущееЗначениеСтавки);
		
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗаписатьТаблицуСДаннымиСтавки(Ставка)	
	
	// очистим с этим укровнем ставки
	ТЧ = ЭтаФорма.ПовременноеНачисчениеНаФорме;
	Ин = ТЧ.Количество();
	Для Инд = 1 по Ин цикл
		НомСтр = Ин - Инд;
		Если ТЧ[НомСтр].Ставка = Ставка			
			Тогда
			Индекс = ТЧ.Индекс(ТЧ[НомСтр]);
			ТЧ.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла; 
	
	Для каждого Запись из ЭтаФорма.УсловияВыполнения цикл
		
		НовСтр = ЭтаФорма.ПовременноеНачисчениеНаФорме.Добавить();
		НовСтр.УровеньСтавки =  ЭтаФорма.ТекущийУровеньСтавки;
		НовСтр.УсловиеПрименения = Запись.УсловиеПрименения;
		НовСтр.ПороговоеЗначение = Запись.ПороговоеЗначение;
		НовСтр.Ставка = ЭтаФорма.ТекущееЗначениеСтавки;
		
	КонецЦикла
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУсловие(Команда)
	
	ТекСтр = Элементы.УсловияВыполнения.ТекущиеДанные;
	ТЧ = ЭтаФорма.УсловияВыполнения;
	Инд = ТЧ.Индекс(ТекСтр);
	ТЧ.Удалить(Инд);
	
    ОчиститьЗаписатьТаблицуСДаннымиСтавки(ЭтаФорма.ТекущееЗначениеСтавки);

КонецПроцедуры

&НаКлиенте
Процедура УровниСтавокПриАктивизацииСтроки(Элемент)
	
	ТекСтр = Элементы.УровниСтавок.ТекущиеДанные;
	ЭтаФорма.ТекущийУровеньСтавки = ТекСтр.УровеньСтавки;
	ЭтаФорма.ТекущееЗначениеСтавки = ТекСтр.Ставка;
	
	ЭтаФорма.УсловияВыполнения.Очистить();
	Для каждого Стр из ЭтаФорма.ПовременноеНачисчениеНаФорме цикл
		Если Стр.Ставка = ЭтаФорма.ТекущееЗначениеСтавки тогда
			НовСтр = ЭтаФорма.УсловияВыполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		КонецЕсли;
	КонецЦикла;	 
	
КонецПроцедуры

