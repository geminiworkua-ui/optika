

Функция ВыполнитьЗаполнениеДлокументаНачисленияЗарплаты(Документ, Сотрудник, Подразделение, ПериодМесяц)  Экспорт
	
	Запрос = Новый запрос("ВЫБРАТЬ
	                       |	ПродажиСотрудниковОбороты.ЗаказКлиента КАК ЗаказПокупателя,
	                       |	ПродажиСотрудниковОбороты.Должность,
	                       |	ПродажиСотрудниковОбороты.Сотрудник,
	                       |	ПродажиСотрудниковОбороты.Подразделение,
	                       |	ПродажиСотрудниковОбороты.ВидНоменклатуры,
	                       |	ПродажиСотрудниковОбороты.Номенклатура,
	                       |	ПродажиСотрудниковОбороты.Характеристика,
	                       |	ПродажиСотрудниковОбороты.ВидНачисления,
	                       |	СУММА(ПродажиСотрудниковОбороты.СуммаОборот) КАК СуммаРеализации,
	                       |	СУММА(ПродажиСотрудниковОбороты.КоличествоОборот) КАК КоличествоОборот,
	                       |	СУММА(ПродажиСотрудниковОбороты.БазаНачисленияОборот) КАК БазаНачисленияОборот,
	                       |	СУММА(ПродажиСотрудниковОбороты.НачислениеОборот) КАК СуммаНачисления,
	                       |	ПродажиСотрудниковОбороты.Регистратор КАК Реализация
	                       |ИЗ
	                       |	РегистрНакопления.ПродажиСотрудников.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, Сотрудник = &Сотрудник) КАК ПродажиСотрудниковОбороты
	                       |
	                       |СГРУППИРОВАТЬ ПО
	                       |	ПродажиСотрудниковОбороты.ЗаказКлиента,
	                       |	ПродажиСотрудниковОбороты.Должность,
	                       |	ПродажиСотрудниковОбороты.Сотрудник,
	                       |	ПродажиСотрудниковОбороты.Подразделение,
	                       |	ПродажиСотрудниковОбороты.ВидНоменклатуры,
	                       |	ПродажиСотрудниковОбороты.Номенклатура,
	                       |	ПродажиСотрудниковОбороты.Характеристика,
	                       |	ПродажиСотрудниковОбороты.ВидНачисления,
	                       |	ПродажиСотрудниковОбороты.Регистратор");
	  Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ПериодМесяц));
	  Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(ПериодМесяц)); 
	  Запрос.УстановитьПараметр("Сотрудник", Сотрудник); 
	//  Выборка = Запрос.Выполнить().Выбрать();
	  
	  //Документ.СдельнаяЗарплата.Очистить();
	  //Пока Выборка.Следующий() Цикл
	  //    НовСтр = Документ.СдельнаяЗарплата.Добавить();
	  //    ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
	  //КонецЦикла;  
	  мСдельная = ОбщегоНазначения.ТаблицаЗначенийВМассив(Запрос.Выполнить().Выгрузить());
	  
	  
	  
	
	  // Повременка
	  
	  ТЗ = НОвый ТаблицаЗначений;
	  ТЗ.Колонки.Добавить("Дата", новый описаниеТипов("Дата"));
	  ТЗ.Колонки.Добавить("Подразделеление", новый описаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	  ТЗ.Колонки.Добавить("Должность", новый описаниеТипов("СправочникСсылка.Должности"));
	  ТЗ.Колонки.Добавить("Ставка", новый описаниеТипов("Число"));
	  
	  Для ДатаДня = 1 по День(КонецМесяца(ПериодМесяц)) цикл
		  Запрос = Новый Запрос("ВЫБРАТЬ
		                        |	КадроваяРасстановкаСрезПоследних.Подразделение,
		                        |	КадроваяРасстановкаСрезПоследних.Должность,
		                        |	МАКСИМУМ(КадроваяРасстановкаСрезПоследних.БазоваяСтавка) КАК Ставка,
		                        |	&Дата
		                        |ИЗ
		                        |	РегистрСведений.КадроваяРасстановка.СрезПоследних(
		                        |			&Дата,
		                        |			ФизическоеЛицо = &Сотрудник
		                        |				И НЕ ВидКадровогоДвижения = &ВидКадровогоДвижения) КАК КадроваяРасстановкаСрезПоследних
		                        |
		                        |СГРУППИРОВАТЬ ПО
		                        |	КадроваяРасстановкаСрезПоследних.Подразделение,
		                        |	КадроваяРасстановкаСрезПоследних.Должность"); 
		  
		  Запрос.УстановитьПараметр("Дата", НачалоМесяца(ПериодМесяц) + ДатаДня*60*60*24);
		  Запрос.УстановитьПараметр("Сотрудник", Сотрудник); 
		  Запрос.УстановитьПараметр("ВидКадровогоДвижения", Перечисления.ВидыКадровыхДвижений.Увольнение); 
		  ТЗ = Запрос.Выполнить().Выгрузить();
		  //Выборка = Запрос.Выполнить().Выбрать();
		  //Пока Выборка.Следующий() Цикл
		  //    НовСтр = ТЗ.Добавить();
		  //    ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
		  //    
		  //КонецЦикла;
	  КонецЦикла; 
	  	  
	  запрос = Новый запрос("ВЫБРАТЬ
	                        |	ТЗ.Подразделение,
	                        |	ТЗ.Должность,
	                        |	ТЗ.Ставка,
	                        |	ТЗ.Дата
	                        |ПОМЕСТИТЬ вт
	                        |ИЗ
	                        |	&ТЗ КАК ТЗ
	                        |;
	                        |
	                        |////////////////////////////////////////////////////////////////////////////////
	                        |ВЫБРАТЬ
	                        |	ОтработанноеВремяСотрудников.Регистратор,
	                        |	ОтработанноеВремяСотрудников.НомерСтроки,
	                        |	ОтработанноеВремяСотрудников.Активность,
	                        |	ОтработанноеВремяСотрудников.ФизическоеЛицо,
	                        |	ОтработанноеВремяСотрудников.Подразделение,
	                        |	ОтработанноеВремяСотрудников.Дата,
	                        |	ОтработанноеВремяСотрудников.Должность,
	                        |	ОтработанноеВремяСотрудников.ОтработанноеВремя,
	                        |	ВложенныйЗапрос.Ставка,
	                        |	0 КАК Начислено
	                        |ИЗ
	                        |	РегистрСведений.ОтработанноеВремяСотрудников КАК ОтработанноеВремяСотрудников
	                        |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                        |			вт.Подразделение КАК Подразделение,
	                        |			вт.Должность КАК Должность,
	                        |			МАКСИМУМ(ВЫРАЗИТЬ(вт.Ставка КАК ЧИСЛО(10, 2))) КАК Ставка,
	                        |			НАЧАЛОПЕРИОДА(вт.Дата, ДЕНЬ) КАК Дата
	                        |		ИЗ
	                        |			вт КАК вт
	                        |		
	                        |		СГРУППИРОВАТЬ ПО
	                        |			вт.Подразделение,
	                        |			вт.Должность,
	                        |			НАЧАЛОПЕРИОДА(вт.Дата, ДЕНЬ)) КАК ВложенныйЗапрос
	                        |		ПО ОтработанноеВремяСотрудников.Подразделение = ВложенныйЗапрос.Подразделение
	                        |			И ОтработанноеВремяСотрудников.Должность = ВложенныйЗапрос.Должность
	                        |			И (НАЧАЛОПЕРИОДА(ОтработанноеВремяСотрудников.Дата, ДЕНЬ) = ВложенныйЗапрос.Дата)
	                        |ГДЕ
	                        |	ОтработанноеВремяСотрудников.Регистратор.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	                        |	И ОтработанноеВремяСотрудников.ФизическоеЛицо = &Сотрудник");
	  
	
	  Запрос.УстановитьПараметр("ТЗ", ТЗ);
	  Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ПериодМесяц));
	  Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(ПериодМесяц)); 
	  Запрос.УстановитьПараметр("Сотрудник", Сотрудник); 
      ТЗЗнач = Запрос.Выполнить().Выгрузить();
	//  Документ.ПовременноеНачисление.Очистить();
	
	  Для Каждого НовСтр Из ТЗЗнач Цикл
		 НовСтр.Начислено = НовСтр.Ставка * НовСтр.ОТработано;
	  КонецЦикла;
	
	  мПовременная = ОбщегоНазначения.ТаблицаЗначенийВМассив(тзЗнач);
	//
	//	Пока Выборка.Следующий() Цикл
	//	  НовСтр = Документ.ПовременноеНачисление.Добавить();
	//	  ЗаполнитьЗначенияСвойств(НовСтр, Выборка); 
	//	  НовСтр.Начислено = НовСтр.Ставка * НовСтр.ОТработано;
	//  КонецЦикла;
//	  ДО.Записать();	

    Возврат Новый Структура("мСдельная, мПовременная", мСдельная, мПовременная);

КонецФункции	


Процедура СформироватьДокументыНачисленияЗарплатыЗаПериод(Период, Подразделение = Неопределено) экспорт
	
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПродажиСотрудниковОбороты.Сотрудник,
	                      |	ПродажиСотрудниковОбороты.Подразделение
	                      |ПОМЕСТИТЬ вт_сбор1
	                      |ИЗ
	                      |	РегистрНакопления.ПродажиСотрудников.Обороты(
	                      |			&ДатаНач,
	                      |			&ДатаКон,
	                      |			Период,
	                      |			Подразделение = &Подразделение
	                      |				ИЛИ &Подразделение = НЕОПРЕДЕЛЕНО
	                      |				ИЛИ &Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК ПродажиСотрудниковОбороты
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ПродажиСотрудниковОбороты.Сотрудник,
	                      |	ПродажиСотрудниковОбороты.Подразделение
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ОтработанноеВремяСотрудников.ФизическоеЛицо,
	                      |	ОтработанноеВремяСотрудников.Подразделение
	                      |ИЗ
	                      |	РегистрСведений.ОтработанноеВремяСотрудников КАК ОтработанноеВремяСотрудников
	                      |ГДЕ
	                      |	ОтработанноеВремяСотрудников.Дата МЕЖДУ &ДатаНач И &ДатаКон
	                      |	И (ОтработанноеВремяСотрудников.Подразделение = &Подразделение
	                      |			ИЛИ &Подразделение = НЕОПРЕДЕЛЕНО
	                      |			ИЛИ &Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка))
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ОтработанноеВремяСотрудников.Подразделение,
	                      |	ОтработанноеВремяСотрудников.ФизическоеЛицо
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	вт_сбор1.Сотрудник КАК Сотрудник,
	                      |	вт_сбор1.Подразделение КАК Подразделение,
	                      |	ЕСТЬNULL(ВложенныйЗапрос.Ссылка, ЗНАЧЕНИЕ(Документ.НачислениеЗарплаты.ПустаяСсылка)) КАК ДокументНачислениеЗарплаты
	                      |ИЗ
	                      |	вт_сбор1 КАК вт_сбор1
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ВложенныйЗапрос.Сотрудник КАК Сотрудник,
	                      |			ВложенныйЗапрос.Подразделение КАК Подразделение,
	                      |			НачислениеЗарплаты.Ссылка КАК Ссылка
	                      |		ИЗ
	                      |			(ВЫБРАТЬ
	                      |				НачислениеЗарплаты.Сотрудник КАК Сотрудник,
	                      |				НачислениеЗарплаты.Подразделение КАК Подразделение,
	                      |				МИНИМУМ(НачислениеЗарплаты.Номер) КАК Номер
	                      |			ИЗ
	                      |				Документ.НачислениеЗарплаты КАК НачислениеЗарплаты
	                      |			ГДЕ
	                      |				НЕ НачислениеЗарплаты.ПометкаУдаления
	                      |				И НачислениеЗарплаты.Дата МЕЖДУ &ДатаНач И &ДатаКон
	                      |			
	                      |			СГРУППИРОВАТЬ ПО
	                      |				НачислениеЗарплаты.Сотрудник,
	                      |				НачислениеЗарплаты.Подразделение) КАК ВложенныйЗапрос
	                      |				ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗарплаты КАК НачислениеЗарплаты
	                      |				ПО ВложенныйЗапрос.Сотрудник = НачислениеЗарплаты.Сотрудник
	                      |					И ВложенныйЗапрос.Подразделение = НачислениеЗарплаты.Подразделение
	                      |					И ВложенныйЗапрос.Номер = НачислениеЗарплаты.Номер) КАК ВложенныйЗапрос
	                      |		ПО вт_сбор1.Сотрудник = ВложенныйЗапрос.Сотрудник
	                      |			И вт_сбор1.Подразделение = ВложенныйЗапрос.Подразделение
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Подразделение,
	                      |	Сотрудник");	
	
	Запрос.УстановитьПараметр("ДатаНач", НАчалоМесяца(Период));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(Период));	
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	Выборка = Запрос.Выполнить().Выбрать();
	мНужных = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Сотрудник)
			И ЗначениеЗаполнено(Выборка.Подразделение)
			Тогда
			Если ЗначениеЗаполнено(Выборка.ДокументНачислениеЗарплаты) Тогда
				ДО = Выборка.ДокументНачислениеЗарплаты.ПолучитьОБъект();
			ИНаче
				ДО = Документы.НачислениеЗарплаты.СоздатьДокумент(); 
				ДО.Дата = НачалоМесяца(Период);
			КонецЕсли; 
			ДО.ДатаНачала = НачалоМесяца(Период);
			ДО.ДатаОкончания = КонецМесяца(Период);
			ДО.Месяц = НачалоМесяца(Период); 
			
			ДО.ВидОперации = Перечисления.ВидыОперацийНачислениеЗП.НачислениеЗП;
			ДО.Сотрудник = Выборка.Сотрудник;
			ДО.Подразделение = Выборка.Подразделение;
			//	ДО.Записать();
			ДО.ПометкаУдаления = Ложь;
			ДО.Дата = НачалоМесяца(Период);
			Рез = Документы.НачислениеЗарплаты.ВыполнитьЗаполнениеДлокументаНачисленияЗарплаты(ДО.Ссылка, Выборка.Сотрудник, Выборка.Подразделение, НачалоМесяца(Период));
			
			ДО.СдельнаяЗарплата.Очистить();
			Если Не Рез.мСдельная = Неопределено И Рез.мСдельная.Количество() > 0  Тогда
				Для Каждого Запись Из Рез.мСдельная Цикл
					ЗаполнитьЗначенияСвойств(ДО.СдельнаяЗарплата.Добавить(), Запись);
				КонецЦикла;
			КонецЕсли;
			
			ДО.ПовременноеНачисление.Очистить();
			Если Не Рез.мПовременная = Неопределено И Рез.мПовременная.Количество() > 0  Тогда
				Для Каждого Запись Из Рез.мПовременная Цикл
					ЗаполнитьЗначенияСвойств(ДО.ПовременноеНачисление.Добавить(), Запись);
				КонецЦикла;
			КонецЕсли;
			
			Попытка
				ДО.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ДО.Записать(РежимЗаписиДокумента.Запись);
				Сообщить("Помилка проведення " + Строка(ДО.Ссылка));
			КонецПопытки;
			мНужных.Добавить(ДО.Ссылка);
		Конецесли;	
	КонецЦикла;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	НачислениеЗарплаты.Ссылка
	                      |ИЗ
	                      |	Документ.НачислениеЗарплаты КАК НачислениеЗарплаты
	                      |ГДЕ
	                      |	НЕ НачислениеЗарплаты.ПометкаУдаления
	                      |	И НачислениеЗарплаты.Дата МЕЖДУ &ДатаНач И &ДатаКон
	                      |	И НЕ НачислениеЗарплаты.Ссылка В (&мНужных)
	                      |	И (НачислениеЗарплаты.Подразделение = &Подразделение
	                      |			ИЛИ &Подразделение = НЕОПРЕДЕЛЕНО)");
	
	Запрос.УстановитьПараметр("ДатаНач", НАчалоМесяца(Период));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(Период));	
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	Запрос.УстановитьПараметр("мНужных",мНужных);
    Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДО = Выборка.Ссылка.ПолучитьОБъект();
		ДО.ПОметкаУдаления = Истина;
		//Попытка
		ДО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		//Исключение
		//	ДО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		//	Сообщить("Помилка проведення " + Строка(ДО.Ссылка));
		//КонецПопытки;
	КонецЦикла;
	
	Сообщить("Створено " + Строка(мНужных.Количество()) + ", Вилучено зайвих " + Строка(Выборка.Количество()));
	
КонецПроцедуры	

