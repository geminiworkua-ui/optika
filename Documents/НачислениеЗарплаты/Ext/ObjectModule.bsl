
Процедура ПередЗаписью(Отказ)

	СуммаПовременная  = ПовременноеНачисление.Итог("Начислено");
	СуммаСдельная     = СдельнаяЗарплата.Итог("СуммаНачисления");
	СуммаБонусов     =  Бонусы.Итог("СуммаБонуса");
    СуммаПрочихВыплат = ДопНачисления.Итог("Сумма");
	СуммаЗарплатыВсего =  ПовременноеНачисление.Итог("Начислено") 
				+ СдельнаяЗарплата.Итог("СуммаНачисления")
				+ Бонусы.Итог("СуммаБонуса")
				+ ДопНачисления.Итог("Сумма");
	
КонецПроцедуры	

Процедура ОбработкаПроведения(Отказ, Режим)
	ОтразитьНачислениеЗарплаты()
КонецПроцедуры

Процедура ОтразитьНачислениеЗарплаты()
	Движения.РасчетыПоЗаработнойПлате.Записывать = Истина;
	Движение = Движения.РасчетыПоЗаработнойПлате.ДобавитьПриход();
	Движение.Регистратор = Ссылка;
	Движение.Период = Месяц;
	Движение.ПериодНачисления = НачалоМесяца(Дата);
	Движение.Сотрудник = Сотрудник;
	Движение.Сумма = СуммаЗарплатыВсего;		
КонецПроцедуры