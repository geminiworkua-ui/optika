&НаСервере
Функция СреднийЧек(П, УсловиеПрименения)

	Сотрудник 								= Неопределено;
    Должность                               = Неопределено; 
	Подразделение                           = Неопределено;
  	ДатаНач 								= Неопределено;
	ДатаКон 								= Неопределено; 
	
	П.Свойство("Сотрудник", Сотрудник);
	П.Свойство("ДатаНач", ДатаНач);
	П.Свойство("ДатаКон", ДатаКон);
    П.Свойство("Должность", Должность);
	П.Свойство("Подразделение", Подразделение);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ПродажиСотрудниковОбороты.СуммаОборот) КАК СуммаОборот,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПродажиСотрудниковОбороты.Регистратор.ЗаказКлиента) КАК КоличЧеков
	|ИЗ
	|	РегистрНакопления.ПродажиСотрудников.Обороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			Регистратор,
	|			Сотрудник = &Сотрудник
	|				И Должность = &Должность
	|				И Подразделение = &Подразделение) КАК ПродажиСотрудниковОбороты";
	
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник); 
	Запрос.УстановитьПараметр("Должность", Должность);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И 
		Выборка.КоличЧеков > 0
		Тогда
		СреднийЧек = Выборка.СуммаОборот / Выборка.КоличЧеков;
	Иначе
		СреднийЧек = 0;
	КонецЕсли;
     	
    Возврат СреднийЧек;

КОнецФункции

&НаСервере
Функция РезультатПродажиГруппыТоваров(П, КомплектПродаж)

	Сотрудник 								= Неопределено;
	Должность                               = Неопределено; 
	Подразделение                           = Неопределено;
	ДатаНач 								= Неопределено;
	ДатаКон 								= Неопределено; 
	
	П.Свойство("Сотрудник", Сотрудник);
	П.Свойство("ДатаНач", ДатаНач);
	П.Свойство("ДатаКон", ДатаКон);
	П.Свойство("Должность", Должность);
	П.Свойство("Подразделение", Подразделение);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МИНИМУМ(ВЫБОР
	|			КОГДА КомплектыПродажТоварыКомплекта.Количество > 0
	|				ТОГДА ЕСТЬNULL(РезультатПоСегменту.КоличествоОборот, 0) / КомплектыПродажТоварыКомплекта.Количество
	|			ИНАЧЕ ЕСТЬNULL(РезультатПоСегменту.КоличествоОборот, 0)
	|		КОНЕЦ) КАК КоличествоЗачетное
	|ИЗ
	|	Справочник.КомплектыПродаж.ТоварыКомплекта КАК КомплектыПродажТоварыКомплекта
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СУММА(ПродажиСотрудниковОбороты.КоличествоОборот) КАК КоличествоОборот,
	|			СУММА(ПродажиСотрудниковОбороты.СуммаОборот) КАК СуммаОборот,
	|			НоменклатураСегмента.Сегмент КАК Сегмент
	|		ИЗ
	|			РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПродажиСотрудников.Обороты(
	|						&ДатаНач,
	|						&ДатаКон,
	|						Регистратор,
	|						Сотрудник = &Сотрудник
	|							И Подразделение = &Подразделение
	|							И Должность = &Должность) КАК ПродажиСотрудниковОбороты
	|				ПО НоменклатураСегмента.Номенклатура = ПродажиСотрудниковОбороты.Номенклатура
	|					И НоменклатураСегмента.Характеристика = ПродажиСотрудниковОбороты.Характеристика
	|		ГДЕ
	|			ПродажиСотрудниковОбороты.Должность = &Должность
	|			И ПродажиСотрудниковОбороты.Сотрудник = &Сотрудник
	|			И ПродажиСотрудниковОбороты.Подразделение = &Подразделение
	|		
	|		СГРУППИРОВАТЬ ПО
	|			НоменклатураСегмента.Сегмент) КАК РезультатПоСегменту
	|		ПО КомплектыПродажТоварыКомплекта.СегментНоменклатуры = РезультатПоСегменту.Сегмент
	|ГДЕ
	|	КомплектыПродажТоварыКомплекта.Ссылка = &СсылкаКомплектНоменклатуры";
	
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Должность", Должность);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("СсылкаКомплектНоменклатуры", КомплектПродаж);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() 
		И 
		Число(Выборка.КоличествоЗачетное) > 0
		Тогда
		КоличествоЗачетное = Выборка.КоличествоЗачетное;
	Иначе
		КоличествоЗачетное = 0;
	КонецЕсли;
	
	Возврат КоличествоЗачетное;

