&НаСервере
Процедура ЗаполнитьИсториюСреднейЗарплаты()
	Если ЗначениеЗаполнено(Объект.Дата)
		И ЗначениеЗаполнено(Объект.ДатаНачала)
		
		Тогда
		
		// Опреелим месяц нчала исчисления
		КонПериода = НачалоМесяца(Мин(Объект.Дата, Объект.ДатаНачала)-1); 
		НачПериода = НачалоМесяца(ДобавитьМесяц(КонПериода, -12));
		
		// Выбираем историю и считаем среднюю 
		
		СуммаНачислений = 0;
		
		Запрос = новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИсторияВыплатыЗарплаты.Период как Дата,
		|	ИсторияВыплатыЗарплаты.Сумма Как СуммаНачисления,
		|	ИсторияВыплатыЗарплаты.Регистратор как ДокументНачисления,
		|	ИсторияВыплатыЗарплаты.Должность КАК Должность,
		|	ИсторияВыплатыЗарплаты.Подразделение  КАК Подразделение
		|ИЗ
		|	РегистрСведений.ИсторияВыплатыЗарплаты КАК ИсторияВыплатыЗарплаты
		|ГДЕ
		|	ИсторияВыплатыЗарплаты.Сотрудник = &Сотрудник
		|	И ИсторияВыплатыЗарплаты.Период МЕЖДУ &ДатаНачала И &ДатаОкончания";
		
		Запрос.УстановитьПараметр("Сотрудник",ОБъект.Сотрудник);
		Запрос.УстановитьПараметр("ДатаНачала",НачПериода);
		Запрос.УстановитьПараметр("ДатаОкончания",КонПериода);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() цикл
			НовСтр = ОБъект.ИсторияВыплатДляРасчетаСредней.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Выборка);
			СуммаНачислений = СуммаНачислений + Выборка.СуммаНачисления;
		КонецЦикла; 
		
		Объект.СредняяЗарплата = СуммаНачислений / 12;
	КонецЕсли; 
КонецПроцедуры	 

