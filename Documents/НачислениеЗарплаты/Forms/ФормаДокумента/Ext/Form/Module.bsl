Процедура СформироватьНачислениеБольничныхНаСервере()
	
	ЗаполнитьИсториюСреднейЗарплаты();
	
	Если ЗначениеЗаполнено(Объект.ДатаНачала)
		И
		ЗначениеЗаполнено(Объект.ДатаОкончания)
	Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, ДЕНЬ) КАК Разница");
		Запрос.УстановитьПараметр("МеньшаяДата", Началомесяца(Объект.ДатаНачала));
		Запрос.УстановитьПараметр("БольшаяДата", КонецМесяца(Объект.ДатаОкончания));
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		Если РезультатЗапроса.Следующий() тогда 
			Разница = РезультатЗапроса.Разница+1;
		КонецЕсли;
		
		// В подсчет больничных принимаеются только первые 5 дней
		Разница = Мин(Разница, 5);
		
	Объект.СуммаБольничных = Объект.СредняяЗарплата * Разница / 30; 
	
	КонецЕсли;
	
КонецПроцедуры

