&НаСервере
Процедура ЗаполнитьОценкуВыполненияУсловийСтавкиПовременной()

	П = Новый Структура;
	П.Вставить("Сотрудник", Объект.Сотрудник);
	П.Вставить("Должность", Объект.Должность);
	П.Вставить("Подразделение", Объект.Подразделение);
	П.Вставить("ДатаНач", НачалоМесяца(Объект.Месяц));
	П.Вставить("ДатаКон", КонецМесяца(Объект.Месяц));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	УстановкаУсловийНачисленияБонусов.Ссылка
	|ПОМЕСТИТЬ вт_док
	|ИЗ
	|	Документ.УстановкаУсловийНачисленияБонусов КАК УстановкаУсловийНачисленияБонусов
	|ГДЕ
	|	УстановкаУсловийНачисленияБонусов.УсловияПрименения.Должность = &Должность
	|	И УстановкаУсловийНачисленияБонусов.УсловияПрименения.Подразделение = &Подразделение
	|	И УстановкаУсловийНачисленияБонусов.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	УстановкаУсловийНачисленияБонусов.Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УстановкаУсловийНачисленияБонусовПовременноеНачисление.НомерСтроки,
	|	УстановкаУсловийНачисленияБонусовПовременноеНачисление.УровеньСтавки,
	|	УстановкаУсловийНачисленияБонусовПовременноеНачисление.УсловиеПрименения,
	|	УстановкаУсловийНачисленияБонусовПовременноеНачисление.ПороговоеЗначение,
	|	УстановкаУсловийНачисленияБонусовПовременноеНачисление.Ставка
	|ИЗ
	|	вт_док КАК вт_док
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстановкаУсловийНачисленияБонусов.ПовременноеНачисление КАК УстановкаУсловийНачисленияБонусовПовременноеНачисление
	|		ПО вт_док.Ссылка = УстановкаУсловийНачисленияБонусовПовременноеНачисление.Ссылка";
	
	Запрос.УстановитьПараметр("Должность", Объект.Должность);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НовСтр = Объект.ТаблицаОпределениеУровняСтавки.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Выборка);		
		
		УсловиеПрименения = Выборка.УсловиеПрименения.КомплектПродаж;
		
		Если  Выборка.УсловиеПрименения.КонтрольСуммыСреднегоЧека = Истина
			Тогда
			НовСтр.Результат = СреднийЧек(П, УсловиеПрименения);
			
		ИначеЕсли
			ТипЗнч(УсловиеПрименения) = Тип("СправочникСсылка.КомплектыПродаж")
			Тогда
			НовСтр.Результат = РезультатПродажиГруппыТоваров(П, УсловиеПрименения);
			
		ИначеЕсли
			ТипЗнч(УсловиеПрименения) = Тип("СправочникСсылка.КомплексныеПродажи")
			Тогда
			НовСтр.Результат = РезультатПродажиКомплексныеПродажи(П, УсловиеПрименения);
			
		КонецЕсли;	
		
		Если НовСтр.Результат >= НовСтр.ПороговоеЗначение
			Тогда
			НовСтр.Выполнено = Истина;
		Иначе
			НовСтр.Выполнено = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	ТЧ = Объект.ТаблицаОпределениеУровняСтавки;
	ТЧ.Сортировать("Ставка");
	
    // выполним анализ выполнения ставки
	
	ТЧ2 = Новый ТаблицаЗначений;
	ТЧ2.Колонки.Добавить("Ставка", 		новый ОписаниеТипов("Число"));
	ТЧ2.Колонки.Добавить("Выполнено", 	новый ОписаниеТипов("Булево"));

	Для каждого Стр из ТЧ Цикл
		НовСтр = ТЧ2.Добавить();
		НовСтр.Ставка = Стр.Ставка;
	КонецЦикла;
	
	ТЧ2.Свернуть("Ставка, Выполнено");
	
	ПринятаяСтавка = 0;
	Для каждого Стр из ТЧ2 Цикл
		ЕстьНеВыполнение = Ложь;
		Для каждого Запись из ТЧ цикл
			Если Запись.Ставка = Стр.Ставка
				И Запись.Выполнено = Ложь
				Тогда ЕстьНеВыполнение = Истина;
			КонецЕсли;
		КонецЦикла;
		Стр.Выполнено = НЕ ЕстьНеВыполнение;
	КонецЦикла;	

	// Выберем принятую ставку - как максимум из таблицы
	
	Объект.РезСтавка = 0;
	Колич = ТЧ2.Количество();
	Для Инд = 1 по Колич Цикл
		НомСтр = Колич - Инд;
		
		Если ТЧ2[НомСтр].Выполнено = Истина
			Тогда
			Объект.РезСтавка = ТЧ2[НомСтр].Ставка;
			Продолжить;
		КонецЕсли;
	КонецЦикла;	
	
		
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНачислениеПовременкиНаСервереСтар()
	
	// Определим уровень ставки
	ЗаполнитьОценкуВыполненияУсловийСтавкиПовременной();
	
	// 
	Объект.ПовременноеНачисление.Очистить();
	Объект.СуммаПовременная = 0;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, ДЕНЬ) КАК Разница");
	Запрос.УстановитьПараметр("МеньшаяДата", Началомесяца(Объект.Месяц));
	Запрос.УстановитьПараметр("БольшаяДата", КонецМесяца(Объект.Месяц));
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() тогда 
		Разница = РезультатЗапроса.Разница+1;
	КонецЕсли; 
	
	ДатаНачала = Началомесяца(Объект.Месяц);

	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановкаПланаПродажНаМесяц.ПланРабочихДней
	|ИЗ
	|	Документ.УстановкаПланаПродажНаМесяц КАК УстановкаПланаПродажНаМесяц
	|ГДЕ
	|	УстановкаПланаПродажНаМесяц.МесяцПлана = &МесяцПлана";
	Запрос.УстановитьПараметр("МесяцПлана",ДатаНачала);
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		ПланРабочихДней = Выборка.ПланРабочихДней
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПланРабочихДней)
		ТОгда
		Текст = "Для данногог периода не сформирован документ План на месяц или в нем не указан план рабочих дней.";
		Сообщить(Текст);
		Возврат;
	КонецЕсли;	
	
	Для Д = 1 По Разница цикл
		
		ДатаСборки = ДатаНачала + (Д - 1) * 24*60*60;
		
		Запрос = новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтработанноеВремяСотрудников.Подразделение,
		|	ОтработанноеВремяСотрудников.ОтработанноеВремя КАК Отработано,
		|	ОтработанноеВремяСотрудников.Должность,
		|	КадроваяРасстановкаСрезПоследних.БазоваяСтавка,
		|	КадроваяРасстановкаСрезПоследних.СпособНачисленияСтавки
		|ИЗ
		|	РегистрСведений.ОтработанноеВремяСотрудников КАК ОтработанноеВремяСотрудников
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяРасстановка.СрезПоследних(&ДатаНачала, ) КАК КадроваяРасстановкаСрезПоследних
		|		ПО ОтработанноеВремяСотрудников.ФизическоеЛицо = КадроваяРасстановкаСрезПоследних.ФизическоеЛицо
		|			И ОтработанноеВремяСотрудников.Должность = КадроваяРасстановкаСрезПоследних.Должность
		|			И ОтработанноеВремяСотрудников.Подразделение = КадроваяРасстановкаСрезПоследних.Подразделение
		|ГДЕ
		|	ОтработанноеВремяСотрудников.ФизическоеЛицо = &ФизическоеЛицо
		|	И ОтработанноеВремяСотрудников.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
		
		Запрос.УстановитьПараметр("ФизическоеЛицо",ОБъект.Сотрудник);
		Запрос.УстановитьПараметр("МесяцПлана",ДатаНачала);
		Запрос.УстановитьПараметр("ДатаНачала",НачалоДня(ДатаСборки));
		Запрос.УстановитьПараметр("ДатаОкончания",КонецДня(ДатаСборки));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() цикл
			
			Если Выборка.СпособНачисленияСтавки = Перечисления.СпособыНачисленияСтавки.СтавкаЗаМесяц
				Тогда
				Начислено = Выборка.БазоваяСтавка / ПланРабочихДней;
			ИначеЕсли
				Выборка.СпособНачисленияСтавки = Перечисления.СпособыНачисленияСтавки.СтавкаЗаЧас
				Тогда
				Отр = число(Час(Выборка.Отработано)) + число(минута(Выборка.Отработано)/60);
				Начислено = число(Выборка.БазоваяСтавка) * число(Отр);
			КонецЕсли;
			
				НовСтр = ОБъект.ПовременноеНачисление.Добавить();
				НовСтр.Подразделение = Выборка.Подразделение;
				НовСтр.Должность = Выборка.Должность;
				НовСтр.Дата = ДатаСборки;
				НовСтр.Отработано = Выборка.Отработано;
				НовСтр.Ставка = Выборка.БазоваяСтавка;
				НовСтр.Начислено = Начислено;
				Объект.СуммаПовременная = Объект.СуммаПовременная + Начислено;
			
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СформироватьНачислениеПовременкиНаСервере()

	ЗаполнитьОценкуВыполненияУсловийСтавкиПовременной();
	
	// сформируем поденный реестр отработанного времени
	
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтработанноеВремяСотрудников.Подразделение,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОтработанноеВремяСотрудников.ОтработанноеВремя) КАК Отработано,
	|	ОтработанноеВремяСотрудников.Должность,
	|	НАЧАЛОПЕРИОДА(ОтработанноеВремяСотрудников.Дата, ДЕНЬ) КАК Дата,
	|	ОтработанноеВремяСотрудников.ФизическоеЛицо
	|ИЗ
	|	РегистрСведений.ОтработанноеВремяСотрудников КАК ОтработанноеВремяСотрудников
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяРасстановка.СрезПоследних(&ДатаНачала, ) КАК КадроваяРасстановкаСрезПоследних
	|		ПО ОтработанноеВремяСотрудников.ФизическоеЛицо = КадроваяРасстановкаСрезПоследних.ФизическоеЛицо
	|			И ОтработанноеВремяСотрудников.Должность = КадроваяРасстановкаСрезПоследних.Должность
	|			И ОтработанноеВремяСотрудников.Подразделение = КадроваяРасстановкаСрезПоследних.Подразделение
	|ГДЕ
	|	ОтработанноеВремяСотрудников.ФизическоеЛицо = &ФизическоеЛицо
	|	И ОтработанноеВремяСотрудников.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И КадроваяРасстановкаСрезПоследних.Подразделение = &Подразделение
	|	И КадроваяРасстановкаСрезПоследних.Должность = &Должность
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтработанноеВремяСотрудников.Подразделение,
	|	ОтработанноеВремяСотрудников.Должность,
	|	ОтработанноеВремяСотрудников.ФизическоеЛицо,
	|	НАЧАЛОПЕРИОДА(ОтработанноеВремяСотрудников.Дата, ДЕНЬ)";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо",	Объект.Сотрудник);
	Запрос.УстановитьПараметр("МесяцПлана",		Объект.Месяц);
	Запрос.УстановитьПараметр("ДатаНачала",		НачалоМесяца(Объект.Месяц));
	Запрос.УстановитьПараметр("ДатаОкончания",	КонецМесяца(Объект.Месяц));
	Запрос.УстановитьПараметр("Должность", 		Объект.Должность);
	Запрос.УстановитьПараметр("Подразделение", 	Объект.Подразделение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() цикл
		
		НовСтр = ОБъект.ПовременноеНачисление.Добавить();
		НовСтр.Подразделение = Выборка.Подразделение;
		НовСтр.Должность = Выборка.Должность;
		НовСтр.Дата = Выборка.Дата;
		НовСтр.Отработано = Выборка.Отработано;
		НовСтр.Ставка = Объект.РезСтавка;
		НовСтр.Начислено = число(Объект.РезСтавка) * число(Выборка.Отработано);
		
		Объект.СуммаПовременная = Объект.СуммаПовременная + НовСтр.Начислено;
		
	КонецЦикла;
        	
КонецПроцедуры	


&НаСервере
Процедура СформироватьСдельноеНачислениеНаСервере()
	
	Объект.СдельнаяЗарплата.Очистить();
	Объект.СуммаСдельная = 0;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, ДЕНЬ) КАК Разница");
	Запрос.УстановитьПараметр("МеньшаяДата", Началомесяца(Объект.Месяц));
	Запрос.УстановитьПараметр("БольшаяДата", КонецМесяца(Объект.Месяц));
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() тогда 
		Разница = РезультатЗапроса.Разница+1;
	КонецЕсли; 
	
	ДатаНачала = Началомесяца(Объект.Месяц);
	
	//
	
	Для Д = 1 По Разница цикл
		
		ДатаСборки = ДатаНачала + (Д - 1) * 24*60*60;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПродажиСотрудниковОбороты.Подразделение,
		|	ПродажиСотрудниковОбороты.Должность,
		|	ПродажиСотрудниковОбороты.ВидНоменклатуры,
		|	ПродажиСотрудниковОбороты.СуммаПриход
		|ИЗ
		|	РегистрСведений.КадроваяРасстановка.СрезПоследних(&ДатаНачала, ) КАК КадроваяРасстановкаСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияНачислений.СрезПоследних(&ДатаНачала, ) КАК УсловияНачисленийСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПродажиСотрудников.Обороты(&ДатаНачала, &ДатаОкончания, , ) КАК ПродажиСотрудниковОбороты
		|			ПО УсловияНачисленийСрезПоследних.Должность = ПродажиСотрудниковОбороты.Должность
		|		ПО КадроваяРасстановкаСрезПоследних.Должность = УсловияНачисленийСрезПоследних.Должность
		|ГДЕ
		|	ПродажиСотрудниковОбороты.Сотрудник = &Сотрудник
		|	И УсловияНачисленийСрезПоследних.ВидНачисленияСдельнойЗарплаты.ВидПроцентБонус = &ВидПроцентБонус
		|	И КадроваяРасстановкаСрезПоследних.ФизическоеЛицо = &Сотрудник";
		Запрос.УстановитьПараметр("Сотрудник",ОБъект.Сотрудник); 
		Запрос.УстановитьПараметр("ВидПроцентБонус",Перечисления.ВидыПроцентБонус.Процент);
		Запрос.УстановитьПараметр("ДатаНачала",НачалоДня(ДатаСборки)); 
		Запрос.УстановитьПараметр("ДатаОкончания",КонецДня(ДатаСборки));		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() цикл
				НовСтр = ОБъект.СдельнаяЗарплата.Добавить();
				Начислено = Выборка.СтавкаНачисления * Выборка.Сумма;
				НовСтр.Подразделение = Выборка.Подразделение;
				НовСтр.Должность = Выборка.Должность;
				НовСтр.Дата = ДатаСборки;
				НовСтр.Ставка = Выборка.БазоваяСтавка;
				НовСтр.СуммаРеализации = Выборка.Сумма;
				НовСтр.СуммаНачисления = Начислено;
				Объект.СуммаСдельная = Объект.СуммаСдельная + Начислено;
			
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СформироватьНачислениеБонусовНаСервере()
	
	Объект.Бонусы.Очистить();
	Объект.СуммаБонусов = 0;
	
	П = Новый Структура;
	П.Вставить("Сотрудник", Объект.Сотрудник);
	П.Вставить("Должность", Объект.Должность);
	П.Вставить("Подразделение", Объект.Подразделение);
	П.Вставить("ДатаНач", НачалоМесяца(Объект.Месяц));
	П.Вставить("ДатаКон", КонецМесяца(Объект.Месяц));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	УстановкаУсловийНачисленияБонусов.Ссылка
	|ПОМЕСТИТЬ вт_док
	|ИЗ
	|	Документ.УстановкаУсловийНачисленияБонусов КАК УстановкаУсловийНачисленияБонусов
	|ГДЕ
	|	УстановкаУсловийНачисленияБонусов.УсловияПрименения.Должность = &Должность
	|	И УстановкаУсловийНачисленияБонусов.УсловияПрименения.Подразделение = &Подразделение
	|	И УстановкаУсловийНачисленияБонусов.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	УстановкаУсловийНачисленияБонусов.Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УстановкаУсловийНачисленияБонусовУстановкаБонусов.НомерСтроки,
	|	УстановкаУсловийНачисленияБонусовУстановкаБонусов.Бонус,
	|	УстановкаУсловийНачисленияБонусовУстановкаБонусов.МинКоличество,
	|	УстановкаУсловийНачисленияБонусовУстановкаБонусов.МаксКоличество,
	|	УстановкаУсловийНачисленияБонусовУстановкаБонусов.СуммаПроцентов,
	|	УстановкаУсловийНачисленияБонусовУстановкаБонусов.СуммаНачисления,
	|	УстановкаУсловийНачисленияБонусовУстановкаБонусов.Бонус.ТипНачисления КАК ТипНачисления,
	|	УстановкаУсловийНачисленияБонусовУстановкаБонусов.Бонус.КомплекснаяПродажа,
	|	УстановкаУсловийНачисленияБонусовУстановкаБонусов.Бонус.Наименование
	|ИЗ
	|	вт_док КАК вт_док
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстановкаУсловийНачисленияБонусов.УстановкаБонусов КАК УстановкаУсловийНачисленияБонусовУстановкаБонусов
	|		ПО вт_док.Ссылка = УстановкаУсловийНачисленияБонусовУстановкаБонусов.Ссылка";
	
	Запрос.УстановитьПараметр("Должность", Объект.Должность);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Выборка = Запрос.Выполнить().Выбрать();
	
	М = Новый Массив;
	
	Пока Выборка.Следующий() Цикл

		Если Выборка.ТипНачисоления = Перечисления.ТипыНачисленияБонусов.ПремияЗаПеревыполнениеПлана
			Тогда
			Рез =  ЗаполнитьНачислениеПоВидуБонусаПеревыполнениеПлана(П, Выборка.Бонус, Выборка.СуммаПроцентов);		
		
		ИначеЕсли
			Выборка.ТипНачисоления = Перечисления.ТипыНачисленияБонусов.ПремияЗаВыручкуМагазина
			Тогда
			Рез =  ЗаполнитьНачислениеПоВидуБонусаПремияЗаВыручкуМагазина(П, Выборка.Бонус, Выборка.СуммаПроцентов);		
			
		ИначеЕсли
			Выборка.ТипНачисоления = Перечисления.ТипыНачисленияБонусов.БонусЗаКаждуюИндивидуальнуюПродажу
			Тогда
			Рез =  ЗаполнитьНачислениеПоВидуБонусаЗаИндивидуальнуюПродажу(П, Выборка.Бонус, Выборка.СуммаПроцентов, Выборка.СуммаНачисления);		
			
			
	
			
			
			
			
		КонецЕсли;
		
		
	
	Для каждого Запись из Рез цикл
		НовСтр = Объект.Бонусы.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Запись);
	КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Функция ЗаполнитьНачислениеПоВидуБонусаПеревыполнениеПлана(П, Бонус, СуммаПроцентов)
	
	Сотрудник 								= Неопределено;
    Должность                               = Неопределено; 
	Подразделение                           = Неопределено;
  	ДатаНач 								= Неопределено;
	ДатаКон 								= Неопределено; 
	
	П.Свойство("Сотрудник", Сотрудник);
	П.Свойство("ДатаНач", ДатаНач);
	П.Свойство("ДатаКон", ДатаКон);
    П.Свойство("Должность", Должность);
	П.Свойство("Подразделение", Подразделение);
	
   //определим план магазина
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(УстановкаПланаПродажНаМесяцПараметрыПлановПодразделений.ПланПродаж) КАК ПланПродаж,
		|	СУММА(УстановкаПланаПродажНаМесяцПараметрыПлановПодразделений.Ссылка.ПланРабочихДней) КАК ПланРабочихДней
		|ИЗ
		|	Документ.УстановкаПланаПродажНаМесяц.ПараметрыПлановПодразделений КАК УстановкаПланаПродажНаМесяцПараметрыПлановПодразделений
		|ГДЕ
		|	УстановкаПланаПродажНаМесяцПараметрыПлановПодразделений.Ссылка.МесяцПлана МЕЖДУ НАЧАЛОПЕРИОДА(&МесяцПлана, МЕСЯЦ) И КОНЕЦПЕРИОДА(&МесяцПлана, МЕСЯЦ)
		|	И УстановкаПланаПродажНаМесяцПараметрыПлановПодразделений.Ссылка.Проведен
		|	И УстановкаПланаПродажНаМесяцПараметрыПлановПодразделений.Подразделение = &Подразделение";
	
	Запрос.УстановитьПараметр("МесяцПлана", Объект.Месяц);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда
        ПланДней = Выборка.ПланРабочихДней;
        ПланПродаж = Выборка.ПланПродаж; 
	Иначе
		ПланДней = 0;
		ПланПродаж = 0;
	КонецЕсли;
	

	// ПродажиПодразделения
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ПродажиСотрудниковОбороты.СуммаОборот) КАК ПродажиПодразделения
		|ИЗ
		|	РегистрНакопления.ПродажиСотрудников.Обороты(
		|			&ДатаНач,
		|			&ДатаКон,
		|			Месяц,
		|			Подразделение = &Подразделение
		|				И Должность.ЭтоВрач = ЛОЖЬ) КАК ПродажиСотрудниковОбороты";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Объект.Месяц));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(Объект.Месяц));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда
		ПродажиПодразделения = Выборка.ПродажиПодразделения;
	Иначе
		ПродажиПодразделения = 0;
	КонецЕсли;

	// Отработано дней сотрдуником
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОтработанноеВремяСотрудников.Дата) КАК КоличествоДней
		|ИЗ
		|	РегистрСведений.ОтработанноеВремяСотрудников КАК ОтработанноеВремяСотрудников
		|ГДЕ
		|	ОтработанноеВремяСотрудников.Подразделение = &Подразделение
		|	И ОтработанноеВремяСотрудников.Должность = &Должность
		|	И ОтработанноеВремяСотрудников.ФизическоеЛицо = &ФизическоеЛицо
		|	И ОтработанноеВремяСотрудников.Дата МЕЖДУ &ДатаНач И &ДатаКон";
	
	Запрос.УстановитьПараметр("ДатаНач", 			НачалоМесяца(Объект.Месяц));
	Запрос.УстановитьПараметр("ДатаКон", 			КонецМесяца(Объект.Месяц));
	Запрос.УстановитьПараметр("Подразделение", 		Объект.Подразделение);
	Запрос.УстановитьПараметр("ФизическоеЛицо", 	Объект.Сотрудник);
    Запрос.УстановитьПараметр("Подразделение", 		Объект.Подразделение);
		
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда
		КоличествоДней = Выборка.КоличествоДней;
	Иначе
		КоличествоДней = 0;
	КонецЕсли;
	
	Если (ПродажиПодразделения - ПланПродаж) > 0
		Тогда 
		СуммаПревышенияПланаМагазина = ПродажиПодразделения - ПланПродаж;
	Иначе СуммаПревышенияПланаМагазина = 0;
	КонецЕсли;
	
	// вычислим %% отработанных дней
	Если   КоличествоДней > ПланДней
		Тогда
		Котр = 1
	Иначе
		Котр = КоличествоДней / ПланДней
	КонецЕсли;
	
	// Расчитатем сумму премии
	
	Премия =  число(СуммаПревышенияПланаМагазина) *  Котр *  СуммаПроцентов / 100;
	
	ПП = Новый Структура;
	ПП.Вставить("ВидБонуса", Бонус);
	ПП.Вставить("Подразделение", Подразделение);
	ПП.Вставить("Должность", Должность );
	ПП.Вставить("СуммаБонуса",Премия); 
	
	ММ = Новый Массив;
	ММ.Добавить(ПП);
	
	Возврат ММ;

КонецФункции

