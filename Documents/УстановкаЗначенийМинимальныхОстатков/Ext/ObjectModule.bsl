

Процедура ОбработкаПроведения(Отказ, Режим)
		
	Попытка
		
	НачатьТранзакцию();	
	ТЗ = Новый таблицаЗначений;
	ТЗ = ТОвары.Выгрузить(,"Номенклатура, Характеристика");
	ТЗ.Свернуть("Номенклатура, Характеристика");
	Для Каждого Стр Из ТЗ Цикл
		НаборЗаписей = РегистрыСведений.ТоварныеОграничения.СоздатьНаборЗаписей();	
		НаборЗаписей.Отбор.Номенклатура.Установить(Стр.Номенклатура);
		НаборЗаписей.Отбор.Характеристика.Установить(Стр.Характеристика);
		НаборЗаписей.Записать();
	КонецЦикла;
		
	НаборЗаписей = РегистрыСведений.ТоварныеОграничения.СоздатьНаборЗаписей();
	Для каждого Стр из Товары цикл
		Если Стр.Количество > 0 Тогда
			НовСтр = НаборЗаписей.Добавить();
			НовСтр.Номенклатура = Стр.Номенклатура;
			НовСтр.Характеристика = Стр.Характеристика;
			НовСтр.МинимальноеКоличествоЗапаса = Стр.Количество * СТр.Кратность; 
			Если ЗначениеЗаполнено(Стр.Склад) Тогда
				НовСтр.Склад  = Стр.Склад;
			Иначе 
				НовСтр.Группировка = Стр.ФорматМагазина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	НаборЗаписей.Записать(Истина);
		
	ЗафиксироватьТранзакцию();	
		
	Исключение
		//ОписаниеОшибки()
	КонецПопытки;

КонецПроцедуры	