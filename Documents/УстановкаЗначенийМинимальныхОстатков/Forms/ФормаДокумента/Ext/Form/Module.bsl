&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Выгрузим данные
	Объект.Товары.Очистить();
	//сСклады = Новый Соответствие;
	//Для каждого СТр из ТабКолонки цикл
	//	Ссклады.Вставить(Стр.Ключ, Стр.Значение);
	//КонецЦикла;
		
	Для каждого Стр из Товары цикл
		Для каждого пСтр из ТабКолонки цикл
			ИмяКолонки = "Склад" + пСтр.Значение; 
			Колич = Стр[ИмяКолонки] * Стр.Кратность;
			НовСтр = Объект.Товары.Добавить();
			НовСтр.Номенклатура = Стр.Номенклатура;
			НовСтр.Характеристика = Стр.Характеристика;
			НовСтр.Упаковка	= Стр.Упаковка;
			НовСтр.Кратность = Стр.Кратность;
			НовСтр.Склад = пСтр.Ключ;
			НовСтр.Количество = Колич;
			НовСтр.ФорматМагазина =  пСтр.ФорматМагазина
		КонецЦикла;
	КонецЦикла;
	
	Объект.ТабКолонки.Очистить();
	Для Каждого Стр Из ТабКолонки Цикл
		НовСтр = ОБъект.ТабКолонки.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтр = Элементы.Товары.ТекущиеДанные;
	Если Не ТекСтр = Неопределено 
		и Поле.Имя = "ТоварыНоменклатура" 
		Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, ТекСтр.Номенклатура);

	ИначеЕсли 	
		Не ТекСтр = Неопределено 
		и Поле.Имя = "ТоварыУпаковка" 
		Тогда
		П = Новый Структура("Инд", Товары.Индекс(ТекСтр));
		Оповещение  = Новый ОписаниеОповещения("ПослеВводаОбщегоЗначения",ЭтотОбъект, П);
		ПоказатьВводЗначения(Оповещение, 0,"Общее значение по строке");
	КонецЕсли;
		
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВводаОбщегоЗначения(Результат, ДопПараметры)  Экспорт
	
	Строка = Товары[ДопПараметры.Инд];
	
	Если НЕ Результат = Неопределено Тогда
		Для каждого Стр из ТабКолонки цикл
			ИмяКолонки = "Склад" + Стр.Значение;
			Строка[ИмяКолонки] = Результат;
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры   

&НаКлиенте
Процедура ТабКолонкиВидимостьПриИзменении(Элемент)
	
	ТабКолонкиВидимостьПриИзмененииНаКлиенте();
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТабКолонкиВидимостьПриИзмененииНаКлиенте()
	
	Для Каждого Стр Из ТабКолонки Цикл
		ИмяКОлонки = "ТоварыСклад" + Стр.Значение; 
		Элементы[ИмяКолонки].Видимость = Стр.Видимость;
	КонецЦикла;	
	    
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для каждого Стр из ТабКолонки цикл
		Стр.Видимость = Истина;
	КонецЦикла;
	ТабКолонкиВидимостьПриИзмененииНаКлиенте();
		
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	Для каждого Стр из ТабКолонки цикл
		Стр.Видимость = Ложь;
	КонецЦикла;
	ТабКолонкиВидимостьПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТабКолонкиВидимостьПриИзмененииНаКлиенте();
