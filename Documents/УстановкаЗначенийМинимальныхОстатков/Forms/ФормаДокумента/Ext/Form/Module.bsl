		Выборка2 = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Характеристика");  
		Пока выборка2.Следующий() цикл
			ЗаполнитьЗначенияСвойств(НовСтр, Выборка2);
			
			Выборка3 = Выборка2.Выбрать();
			Пока Выборка3.Следующий() цикл
				Если Выборка3.Количество > 0 ТОгда
					если ЗначениеЗаполнено(Выборка3.Склад)
						и НЕ ссклады.Получить(Выборка3.Склад) = Неопределено
						Тогда
						ИмяКолонки = "Склад" + ссклады.Получить(Выборка3.Склад);
						НовСтр.Кратность = Выборка3.Кратность;
						НовСтр.Упаковка = Выборка3.Упаковка;				
						НовСтр[ИмяКолонки] = Выборка3.Количество / Выборка3.Кратность;
					Иначеесли
						ЗначениеЗаполнено(Выборка3.ФорматМагазина) 
						И НЕ ссклады.Получить(Выборка3.ФорматМагазина) = Неопределено
						Тогда
						ИмяКолонки = "Склад" + ссклады.Получить(Выборка3.ФорматМагазина);
						НовСтр.Кратность = Выборка3.Кратность;
						НовСтр.Упаковка = Выборка3.Упаковка;				
						НовСтр[ИмяКолонки] = Выборка3.Количество / Выборка3.Кратность;
					Конецесли;
				Конецесли;
			КонецЦикла; 
		КонецЦикла;
	КонецЦикла;
		
