&НаКлиенте
Перем сСклады; // соответствие

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ОБъект.Автор)
		ТОгда ОБъект.Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОБъект.Ссылка)
		Тогда
		сСклады = ЗаполнитьКолонкиДокумента("Старый", Объект.Дата);
		ЗаполнитьСохраненнымиДаннымиНаСервере(сСклады);
	ИНаче
		сСклады = ЗаполнитьКолонкиДокумента("Новый", Объект.дата);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ПерезаполнитьДаннымиНаСервере(ОБъект.ВидНоменклатуры, ОБъект.ГруппаНоменклатуры, сСклады);
КонецПроцедуры

&НаСервере
Функция ЗаполнитьКолонкиДокумента(РежимЗаполнения, Дата)
	
	Если РежимЗаполнения = "Новый" Тогда
		
		ЗапросСклады = Новый Запрос("ВЫБРАТЬ
		|	ИсторияИзмененияФорматовМагазиновСрезПоследних.Склад,
		|	ИсторияИзмененияФорматовМагазиновСрезПоследних.ФорматМагазина
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	РегистрСведений.ИсторияИзмененияФорматовМагазинов.СрезПоследних(&Дата, ) КАК ИсторияИзмененияФорматовМагазиновСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	ИсторияИзмененияФорматовМагазиновСрезПоследних.Склад,
		|	ИсторияИзмененияФорматовМагазиновСрезПоследних.ФорматМагазина
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Склады.Ссылка КАК Склад,
		|	Склады.Наименование,
		|	ЕСТЬNULL(ВложенныйЗапрос.ФорматМагазина, """") КАК ФорматМагазина
		|ПОМЕСТИТЬ вт2
		|ИЗ
		|	Справочник.Склады КАК Склады
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт.Склад КАК Склад,
		|			вт.ФорматМагазина КАК ФорматМагазина
		|		ИЗ
		|			вт КАК вт) КАК ВложенныйЗапрос
		|		ПО Склады.Ссылка = ВложенныйЗапрос.Склад
		|ГДЕ
		|	НЕ Склады.ЭтоГруппа
		|	И Склады.ТипСклада = &ТипСклада
		|	И НЕ Склады.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт2.Склад,
		|	вт2.Наименование,
		|	вт2.ФорматМагазина КАК ФорматМагазина
		|ИЗ
		|	вт2 КАК вт2
		|ИТОГИ ПО
		|	ФорматМагазина");
		ЗапросСклады.УстановитьПараметр("ТипСклада", Перечисления.ТипыСкладов.РозничныйМагазин);
		ЗапросСклады.УстановитьПараметр("Дата", Дата);	
		Выборка = ЗапросСклады.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ФорматМагазина");
		
		ТабКолонки.Очистить();
		Ном = 0;
		Пока Выборка.Следующий() Цикл
			НОм = Ном + 1;
			НовСтр = ТабКолонки.Добавить();
			НовСтр.ФорматМагазина = ?(ЗначениеЗаполнено(Выборка.ФорматМагазина) и НЕ Строка(Выборка.ФорматМагазина) = "", Выборка.ФорматМагазина, "Без формату"); 
			НовСтр.Ключ = НовСтр.ФорматМагазина;
			НовСтр.Видимость = Истина;
			НовСтр.Номер = НОм;
			НовСтр.Значение = Строка(формат(НОм, "ЧГ=0"));
			НовСтр.ЭтоФорматМагазина = Истина;
			Выборка2 = Выборка.Выбрать();
			Пока выборка2.Следующий() Цикл
				НОм = Ном + 1;
				НовСтр = ТабКолонки.Добавить();
				НовСтр.НОмер = Ном;
				НовСтр.Значение = Строка(формат(НОм, "ЧГ=0"));
				НовСтр.Ключ = Выборка2.Склад;
				НовСтр.ФорматМагазина = Выборка2.ФорматМагазина;
				НовСтр.Склад = Выборка2.Склад;
				НовСтр.Видимость = Истина;  
				НовСтр.ЭтоФорматМагазина = Ложь;
			КонецЦикла;
		КонецЦикла;
	Иначе
		ТабКолонки.Очистить();
		ТабКолонки.Загрузить(ОБъект.ТабКолонки.Выгрузить());
	КонецЕсли;	
	//	
	сСклады = Новый Соответствие;
	Ном = 0;
	
	Для Каждого Стр Из ТабКолонки Цикл
		//Ном = Стр.Номер;
		//НовСтр = сСклады.Вставить();
		//НовСтр.Ключ = Стр.Ключ;
		//	НовСтр.Значение =  Строка(формат(НОм, "ЧГ=0"));
		ссклады.Вставить(Стр.склад, Стр.Значение);
	КонецЦикла; 
	// Заполним колонки
	Для каждого Стр из ТабКолонки цикл
		ИмяСклада = Строка(Стр.Ключ);
		НомерСклада = Стр.Значение;
		ИмяПоля = "Склад"+НомерСклада;
		
		нРеквизиты = Новый Массив;
		КвалификаторыЧисла = Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой);
		нРеквизиты.Добавить(Новый РеквизитФормы(ИмяПоля, Новый ОписаниеТипов("Число", КвалификаторыЧисла), "Товары", ИмяПоля , Истина));
		ИзменитьРеквизиты(нРеквизиты);
		
		НовыйЭлемент  = Элементы.Добавить("Товары"+ИмяПоля, Тип("ПолеФормы"), Элементы.Товары);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;      
		НовыйЭлемент.ПутьКДанным = "Товары."+ИмяПоля;
		НовыйЭлемент.Заголовок = ИмяСклада;
		НовыйЭлемент.МаксимальнаяШирина = 7;
		
		Если Стр.ЭтоФорматМагазина
			Тогда НовыйЭлемент.ЦветТекстаЗаголовка = WebЦвета.Синий;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ссклады;
	
КонецФункции

&НаСервере
Процедура ПерезаполнитьДаннымиНаСервереСтар(ВидНоменклатуры, ГруппаНоменклатуры, сСклады)
	
	ЗапросСписок = Новый Запрос("ВЫБРАТЬ
	                            |	Номенклатура.Ссылка КАК Номенклатура,
	                            |	ВложенныйЗапрос.Ссылка КАК Характеристика,
	                            |	ВЫБОР
	                            |		КОГДА НЕ Номенклатура.ОсновнаяУпаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	                            |			ТОГДА Номенклатура.ОсновнаяУпаковка
	                            |		ИНАЧЕ Номенклатура.ЕдиницаИзмерения
	                            |	КОНЕЦ КАК Упаковка,
	                            |	ВЫБОР
	                            |		КОГДА НЕ Номенклатура.ОсновнаяУпаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	                            |				И Номенклатура.ОсновнаяУпаковка.Числитель > 0
	                            |			ТОГДА Номенклатура.ОсновнаяУпаковка.Числитель
	                            |		ИНАЧЕ 1
	                            |	КОНЕЦ КАК Кратность
	                            |ИЗ
	                            |	Справочник.Номенклатура КАК Номенклатура
	                            |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                            |			ХарактеристикиНоменклатуры.Ссылка КАК Ссылка,
	                            |			ХарактеристикиНоменклатуры.Владелец КАК Владелец
	                            |		ИЗ
	                            |			Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры) КАК ВложенныйЗапрос
	                            |		ПО Номенклатура.Ссылка = ВложенныйЗапрос.Владелец
	                            |ГДЕ
	                            |	(Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
	                            |			ИЛИ &ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка))
	                            |	И (Номенклатура.Родитель В ИЕРАРХИИ (&Родитель)
	                            |			ИЛИ &Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	                            |
	                            |УПОРЯДОЧИТЬ ПО
	                            |	Номенклатура,
	                            |	Характеристика");
	ЗапросСписок.УстановитьПараметр("Родитель",ГруппаНоменклатуры); 
	ЗапросСписок.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры); 
	ТЗсписок = ЗапросСписок.Выполнить().Выгрузить();
	
	Товары.Очистить();
	Товары.Загрузить(ТЗСписок);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Товары.Номенклатура,
	                      |	Товары.Характеристика,
	                      |	Товары.Упаковка,
	                      |	Товары.Кратность
	                      |ПОМЕСТИТЬ вт
	                      |ИЗ
	                      |	&Товары КАК Товары
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВложенныйЗапрос.Склад,
	                      |	ЕСТЬNULL(ВложенныйЗапрос.МинимальноеКоличествоЗапаса, 0) КАК МинимальноеКоличествоЗапаса,
	                      |	вт.Номенклатура,
	                      |	вт.Характеристика,
	                      |	вт.Упаковка,
	                      |	вт.Кратность
	                      |ПОМЕСТИТЬ вт_сбор2
	                      |ИЗ
	                      |	вт КАК вт
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ТоварныеОграничения.Номенклатура КАК Номенклатура,
	                      |			ТоварныеОграничения.Характеристика КАК Характеристика,
	                      |			ТоварныеОграничения.Склад КАК Склад,
	                      |			ТоварныеОграничения.МинимальноеКоличествоЗапаса КАК МинимальноеКоличествоЗапаса,
	                      |			ТоварныеОграничения.Склад.Наименование КАК СкладНаименование
	                      |		ИЗ
	                      |			РегистрСведений.ТоварныеОграничения КАК ТоварныеОграничения) КАК ВложенныйЗапрос
	                      |		ПО вт.Номенклатура = ВложенныйЗапрос.Номенклатура
	                      |			И вт.Характеристика = ВложенныйЗапрос.Характеристика
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	вт_сбор2.Склад,
	                      |	вт_сбор2.МинимальноеКоличествоЗапаса,
	                      |	вт_сбор2.Номенклатура,
	                      |	вт_сбор2.Характеристика,
	                      |	вт_сбор2.Упаковка,
	                      |	вт_сбор2.Кратность
	                      |ИЗ
	                      |	вт_сбор2 КАК вт_сбор2
	                      |ГДЕ
	                      |	вт_сбор2.МинимальноеКоличествоЗапаса > 0");
	Запрос.УстановитьПараметр("Товары",Товары.Выгрузить()); 
	
	сСклады = Новый Соответствие;
	Для каждого СТр из ТабКолонки цикл
		Ссклады.Вставить(Стр.Ключ, Стр.Значение);
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока выборка.Следующий() цикл
		Для каждого Стр из Товары цикл
			Если  
				Выборка.Номенклатура = Стр.Номенклатура
				И Выборка.Характеристика = Стр.Характеристика
				И Выборка.Упаковка	= Стр.Упаковка
				Тогда
				НОмерок = ссклады.Получить(Выборка.Склад);
				Если НЕ НОмерок = Неопределено 
					Тогда
					ИмяКолонки = "Склад" + НОмерок;
					Стр[ИмяКолонки] = Выборка.МинимальноеКоличествоЗапаса / Выборка.Кратность; 
				КонецЕсли;
			конецЕсли; 
		КонецЦикла;
	КонецЦикла;
	    	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьДаннымиНаСервере(ВидНоменклатуры, ГруппаНоменклатуры, сСклады)
	
	ЗапросСписок = Новый Запрос("ВЫБРАТЬ
	                            |	Номенклатура.Ссылка КАК Номенклатура,
	                            |	ВложенныйЗапрос.Ссылка КАК Характеристика,
	                            |	ВЫБОР
	                            |		КОГДА НЕ Номенклатура.ОсновнаяУпаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	                            |			ТОГДА Номенклатура.ОсновнаяУпаковка
	                            |		ИНАЧЕ Номенклатура.ЕдиницаИзмерения
	                            |	КОНЕЦ КАК Упаковка,
	                            |	ВЫБОР
	                            |		КОГДА НЕ Номенклатура.ОсновнаяУпаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	                            |				И Номенклатура.ОсновнаяУпаковка.Числитель > 0
	                            |			ТОГДА Номенклатура.ОсновнаяУпаковка.Числитель
	                            |		ИНАЧЕ 1
	                            |	КОНЕЦ КАК Кратность
	                            |ИЗ
	                            |	Справочник.Номенклатура КАК Номенклатура
	                            |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                            |			ХарактеристикиНоменклатуры.Ссылка КАК Ссылка,
	                            |			ХарактеристикиНоменклатуры.Владелец КАК Владелец
	                            |		ИЗ
	                            |			Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры) КАК ВложенныйЗапрос
	                            |		ПО Номенклатура.Ссылка = ВложенныйЗапрос.Владелец
	                            |ГДЕ
	                            |	(Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
	                            |			ИЛИ &ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка))
	                            |	И (Номенклатура.Родитель В ИЕРАРХИИ (&Родитель)
	                            |			ИЛИ &Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	                            |
	                            |УПОРЯДОЧИТЬ ПО
	                            |	Номенклатура,
	                            |	Характеристика");
	ЗапросСписок.УстановитьПараметр("Родитель",ГруппаНоменклатуры); 
	ЗапросСписок.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры); 
	ТЗсписок = ЗапросСписок.Выполнить().Выгрузить();
	
	Товары.Очистить();
	Товары.Загрузить(ТЗСписок);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Товары.Номенклатура,
	                      |	Товары.Характеристика,
	                      |	Товары.Упаковка,
	                      |	Товары.Кратность
	                      |ПОМЕСТИТЬ вт
	                      |ИЗ
	                      |	&Товары КАК Товары
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВложенныйЗапрос.Склад,
	                      |	ЕСТЬNULL(ВложенныйЗапрос.МинимальноеКоличествоЗапаса, 0) КАК МинимальноеКоличествоЗапаса,
	                      |	вт.Номенклатура,
	                      |	вт.Характеристика,
	                      |	вт.Упаковка,
	                      |	вт.Кратность
	                      |ПОМЕСТИТЬ вт_сбор2
	                      |ИЗ
	                      |	вт КАК вт
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ТоварныеОграничения.Номенклатура КАК Номенклатура,
	                      |			ТоварныеОграничения.Характеристика КАК Характеристика,
	                      |			ТоварныеОграничения.Склад КАК Склад,
	                      |			ТоварныеОграничения.МинимальноеКоличествоЗапаса КАК МинимальноеКоличествоЗапаса,
	                      |			ТоварныеОграничения.Склад.Наименование КАК СкладНаименование
	                      |		ИЗ
	                      |			РегистрСведений.ТоварныеОграничения КАК ТоварныеОграничения) КАК ВложенныйЗапрос
	                      |		ПО вт.Номенклатура = ВложенныйЗапрос.Номенклатура
	                      |			И вт.Характеристика = ВложенныйЗапрос.Характеристика
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	вт_сбор2.Склад,
	                      |	вт_сбор2.МинимальноеКоличествоЗапаса,
	                      |	вт_сбор2.Номенклатура,
	                      |	вт_сбор2.Характеристика,
	                      |	вт_сбор2.Упаковка,
	                      |	вт_сбор2.Кратность
	                      |ИЗ
	                      |	вт_сбор2 КАК вт_сбор2
	                      |ГДЕ
	                      |	вт_сбор2.МинимальноеКоличествоЗапаса > 0");
	Запрос.УстановитьПараметр("Товары",Товары.Выгрузить()); 
	
	сСклады = Новый Соответствие;
	Для каждого СТр из ТабКолонки цикл
		Ссклады.Вставить(Стр.Ключ, Стр.Значение);
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока выборка.Следующий() цикл
		Для каждого Стр из Товары цикл
			Если  
				Выборка.Номенклатура = Стр.Номенклатура
				И Выборка.Характеристика = Стр.Характеристика
				И Выборка.Упаковка	= Стр.Упаковка
				Тогда
				НОмерок = ссклады.Получить(Выборка.Склад);
				Если НЕ НОмерок = Неопределено 
					Тогда
					ИмяКолонки = "Склад" + НОмерок;
					Стр[ИмяКолонки] = Выборка.МинимальноеКоличествоЗапаса / Выборка.Кратность; 
				КонецЕсли;
			конецЕсли; 
		КонецЦикла;
	КонецЦикла;
	    	
КонецПроцедуры













