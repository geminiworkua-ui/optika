&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка)
		Тогда 
		Если Параметры.Свойство("ВидНачисленияСдельнойЗП") Тогда
		Объект.Автор = ПользователиКлиентСервер.ТекущийПользователь();
		Объект.ВидНачисленияСдельнойЗП = Параметры.ВидНачисленияСдельнойЗП;
		ОБъект.ВидПроцентБонус = Объект.ВидНачисленияСдельнойЗП.ВидПроцентБонус;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОБъект.ВидПроцентБонус = перечисления.ВидыПроцентБонус.Бонус
		Тогда
		ЭтаФорма.Элементы.ГруппБазаНачисления.Видимость = Ложь;
	Иначе 
		ЭтаФорма.Элементы.ГруппБазаНачисления.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьСводнуюТаблицу();
    //Объект.ДатаНачалаДействияНовыхУсловий = НачалоМесяца(Объект.ДатаНачалаДействияНовыхУсловий);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСводнуюТаблицу();
	
	Объект.СводнаяТаблицаУсловий.Очистить();
	Если ОБъект.ВидПроцентБонус = Перечисления.ВидыПроцентБонус.Процент
		ТОгда
		Для Каждого Применимость из Объект.ПрименимостьУсловий Цикл
			Для каждого Начисление из Объект.БазаНачисления цикл
				
				Если ЗначениеЗаполнено(Применимость.Должность)
					И 
					ЗначениеЗаполнено(Начисление.ВидНоменклатуры) 
					И
					ЗначениеЗаполнено(Начисление.Ставка)
					Тогда
					НовСтр = Объект.СводнаяТаблицаУсловий.Добавить();
					НовСтр.ВидНоменклатуры = Начисление.ВидНоменклатуры;
					НовСтр.Ставка = Начисление.Ставка;
					НовСтр.Должность = Применимость.Должность;
				КонецЕсли;	
			КонецЦикла;
		КонецЦикла;  
	Иначе
		Для Каждого Применимость из Объект.ПрименимостьУсловий Цикл
			Для каждого Начисление из Объект.БазаНачисления цикл
				НовСтр = Объект.СводнаяТаблицаУсловий.Добавить();
				НовСтр.ВидНоменклатуры = Начисление.ВидНоменклатуры;
				НовСтр.Ставка = Начисление.Ставка;
				НовСтр.Должность = Применимость.Должность; 
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаУсловийНачисленияПриИзменении(Элемент)
	ЗаполнитьСводнуюТаблицу();
КонецПроцедуры

&НаКлиенте
Процедура ПрименимостьУсловийПриИзменении(Элемент)
	ЗаполнитьСводнуюТаблицу();
КонецПроцедуры


