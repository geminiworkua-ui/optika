&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если Не ЗначениеЗаполнено(Объект.Подразделение) 
		Тогда
		Сообщить("Необхідно вказати підрозділ");
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Пациент) 
		Тогда
		Сообщить("Необхідно вказати Пацієнта");
		Отказ = Истина;
	КонецЕсли;

	Для каждого Стр из ОБъект.НазначенияОчки цикл 
		
        Стр.Представление = сокрЛП(строка(Стр.ВидНазначения) + " " + 
		Символы.ПС + 
		?(ЗначениеЗаполнено(Стр.OD_sph),"OD_sph:" + строка(Стр.OD_sph),"") +  
		?(ЗначениеЗаполнено(Стр.OD_cyl)," OD_cyl:" + строка(Стр.OD_cyl),"") + 		
		?(ЗначениеЗаполнено(Стр.OD_ax)," OD_ax:" + строка(Стр.OD_ax),"") + 		
		?(ЗначениеЗаполнено(Стр.OD_ADD)," OD_ADD:" + строка(Стр.OD_ax),"") + 
		?(ЗначениеЗаполнено(Стр.OD_PDR)," OD_PDR:" + строка(Стр.OD_PDR),"") +
		?(ЗначениеЗаполнено(Стр.OD_инсет)," OD_інсет:" + строка(Стр.OD_инсет),"") + 
		?(ЗначениеЗаполнено(Стр.OD_ВС)," OD_ВС:" + строка(Стр.OD_ВС),"") + 
		Символы.ПС +		
		?(ЗначениеЗаполнено(Стр.OS_sph),"OS_sph:" + строка(Стр.OS_sph),"") + 	
		?(ЗначениеЗаполнено(Стр.OS_cyl)," OS_cyl:" + строка(Стр.OS_cyl),"") + 		
		?(ЗначениеЗаполнено(Стр.OS_ax)," OS_ax:" + строка(Стр.OS_ax),"") +
		?(ЗначениеЗаполнено(Стр.OS_ADD)," OS_ADD:" + строка(Стр.OS_ax),"") + 
		?(ЗначениеЗаполнено(Стр.OS_PDL)," OS_PDL:" + строка(Стр.OS_PDL),"") +
		?(ЗначениеЗаполнено(Стр.OS_инсет)," OS_інсет:" + строка(Стр.OS_инсет),"") + 
		?(ЗначениеЗаполнено(Стр.OS_ВС)," OS_ВС:" + строка(Стр.OS_ВС),"") + 
		Символы.ПС +	
		?(ЗначениеЗаполнено(Стр.Комментарий),строка(Стр.Комментарий),""));
				
	КонецЦикла;
	
КонецПроцедуры

