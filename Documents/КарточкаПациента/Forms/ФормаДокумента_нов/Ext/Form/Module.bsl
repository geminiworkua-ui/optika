&НаКлиенте
Процедура ПеренестиВНазначение(Команда)
	
	НовСтр = ОБъект.НазначенияОчки.Добавить(); 
	
	НовСтр.OD_sph =Объект.ОстротаЗренияODск_sph;
	НовСтр.OS_sph =Объект.ОстротаЗренияOSск_sph; 
	
	НовСтр.OD_cyl =Объект.ОстротаЗренияODск_cyl;
	НовСтр.OS_cyl =Объект.ОстротаЗренияOSск_cyl; 

	НовСтр.OD_ax =Объект.ОстротаЗренияODск_ax;
	НовСтр.OS_ax =Объект.ОстротаЗренияOSск_ax; 

    НовСтр.OD_ax =Объект.ОстротаЗренияODск_ax;
	НовСтр.OS_ax =Объект.ОстротаЗренияOSск_ax; 
	
	НовСтр.OD_ADD = Объект.РезервАккомодацииOD;
	НовСтр.OS_ADD = Объект.РезервАккомодацииOS;                     	
	НовСтр.OD_PDR = Объект.АмплитудаАккомодацииOS;
	НовСтр.OS_PDL = Объект.АмплитудаАккомодацииOD;
	
	Элементы.ГруппаОбщееНазначения.ТекущаяСтраница = Элементы.ГруппаПризначенняОкулярів;
	
КонецПроцедуры

