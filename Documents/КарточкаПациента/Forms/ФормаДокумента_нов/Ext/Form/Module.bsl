
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Пациент") Тогда
		Объект.Пациент = Параметры.Пациент;  
	КонецЕсли;  
	
	Если Параметры.Свойство("Подразделение") Тогда
		Объект.Подразделение = Параметры.Подразделение;  
	КонецЕсли;
	
	Если Параметры.Свойство("Номенклатура") 
		И значениеЗаполнено(Параметры.Номенклатура)
		Тогда
		//
		НовСтр = ОБъект.Товары.Добавить();
		НовСтр.Номенклатура = Параметры.Номенклатура;
		НовСтр.ЕдИзм = Параметры.Номенклатура.ЕдиницаИзмерения;
		НовСтр.Количество = 1;
		
	КонецЕсли;
     	
	Если НЕ ЗначениеЗаполнено(ОБъект.Ссылка)
		Тогда
		 Объект.Исполнитель = ПараметрыСеанса.ТекущийПользователь;
;
    КонецЕсли;
     	
	если Не ЗначениеЗаполнено(Объект.Автор) Тогда
		ОБъект.Автор = ПараметрыСеанса.ТекущийПользователь
	КонецЕсли;
	
	УстановитьВидимостьНазначений();
	
	// проверим достпность для редактирования
	// в течение 48 часов может только автор
	
	
	Если Объект.Дата < Дата(2020,01,01) 
		ИЛи Объект.Ссылка = неопределено
		Тогда
		ЭтаФорма.ТолькоПросмотр = Ложь;
		
	ИначеЕсли ПараметрыСеанса.ТекущийПользователь = Объект.Автор
		ТОгда
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	РАЗНОСТЬДАТ(&ДатаНач, &ДатаКон, ЧАС) КАК Разность");
		
		Запрос.УстановитьПараметр("ДатаНач", Объект.Дата);
		Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() тогда
			Разность = Выборка.Разность;
		Иначе Разность = 100;	
		КонецЕсли;
		
		Если Разность > 48 тогда
			
			ЭтаФорма.ТолькоПросмотр = Истина;
		ИНаче
			ЭтаФорма.ТолькоПросмотр = Ложь;
		КонецЕсли;
	Иначе
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	
	// попытка заполнить состав услуг теми, которые назначены на этот день
	
	// +y.surai IBS 2026.10.0
	ibs_ПроверитьНаличиеДанныхВHelsi();
	ibs_ВыполнитьИдентификациюПациента();
	// -y.surai IBS 2026.10.0
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.Группа21.Видимость = ОБъект.ОпытНошенияОчков;
	Элементы.ГруппаКоррекцияПредшествующихМКЛ.Видимость = Объект.ОпытНошенияМКЛ;


КонецПроцедуры


&НаСервере
Процедура УстановитьВидимостьНазначений()
	Если Объект.НазначеноОчки = Истина
		Тогда
		ЭтаФорма.Элементы.ГруппаНазначениеОчки.Видимость = Истина
	Иначе
		ЭтаФорма.Элементы.ГруппаНазначениеОчки.Видимость = Ложь
	КонецЕсли;
	
	
    Если Объект.НазначеноМКЛ = Истина
		Тогда
		ЭтаФорма.Элементы.ГруппаНазначениеМКЛ.Видимость = Истина
	Иначе
		ЭтаФорма.Элементы.ГруппаНазначениеМКЛ.Видимость = Ложь
	КонецЕсли;

	
	Если Объект.НазначеноНЛ = Истина
		Тогда
		ЭтаФорма.Элементы.ГруппаНазначениеНЛ.Видимость = Истина
	Иначе
		ЭтаФорма.Элементы.ГруппаНазначениеНЛ.Видимость = Ложь
	КонецЕсли;

	если Объект.ЭтоРецептурнаяЛинза = Истина
		Тогда
		ЭтаФорма.Элементы.ГруппаПараметрыРецептурнойЛинзы.Видимость = Истина
	ИНаче
		ЭтаФорма.Элементы.ГруппаПараметрыРецептурнойЛинзы.Видимость = Ложь
	КонецЕсли;

	
КонецПроцедуры	

