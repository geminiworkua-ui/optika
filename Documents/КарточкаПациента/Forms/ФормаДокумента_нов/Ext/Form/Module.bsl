&НаКлиенте
Процедура ibs_ПроверитьИдентификациюПациента(Команда)
	// +y.surai IBS 2026.10.01	
	ibs_ВыполнитьИдентификациюПациента();
	// -y.surai IBS 2026.10.01	
КонецПроцедуры

&НаСервере
Процедура ibs_ВыполнитьИдентификациюПациента()
	// +y.surai IBS 2026.10.01
	HelsiКонтрагент = НСтр("ru='Пациента не идентифицировано';uk='Пацієнта не ідентифіковано'");
	HelsiКонтрагентИдентифицирован = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Пациент) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеПартнера = Документы.КарточкаПациента.ibs_ДанныеПартнераДляПанелиИнформации(Объект.Пациент);
	Для каждого Стр Из ДанныеПартнера.КонтактнаяИнформацияТаблица Цикл
		Если Стр.СсылкаВидКИ = Справочники.ВидыКонтактнойИнформации.АдресПартнера Тогда
			АдресКонтрагента = Стр.ПредставлениеКИ;
		ИначеЕсли Стр.СсылкаВидКИ = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера Тогда
			ТелефонКонтрагента = Стр.ПредставлениеКИ;
		ИначеЕсли Стр.СсылкаВидКИ = Справочники.ВидыКонтактнойИнформации.EmailПартнера Тогда	
			ЭлектроннаяПочтаКонтрагента = Стр.ПредставлениеКИ;
		КонецЕсли;	
	КонецЦикла;	
	
	Документы.КарточкаПациента.ibs_ВыполнитьИдентификациюПациента(Объект, HelsiКонтрагент, HelsiКонтрагентИдентифицирован);
	Если Не HelsiКонтрагентИдентифицирован Тогда
		Элементы.HelsiКонтрагент.ЦветФона = WebЦвета.ГолубойСКраснымОттенком;
	Иначе
		Элементы.HelsiКонтрагент.ЦветФона = WebЦвета.МятныйКрем;
	КонецЕсли;	
	// -y.surai IBS 2026.10.01	
КонецПроцедуры	




