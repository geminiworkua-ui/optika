&НаКлиенте
Процедура ibs_ВыгрузитьВHelsi(Команда)
	// +y.surai IBS 2026.10.01
	Если Объект.Ссылка.Пустая() Тогда
		Сообщить(НСтр("ru='Необходимо записать документ!';uk='Необхідно записати документ!'"));
		Возврат;
	КонецЕсли;
	
	Если Не HelsiКонтрагентИдентифицирован Тогда
		Сообщить(НСтр("ru='Пациента не идентифицировано, данные не переданы до Helsi!';uk='Пацієнта не ідентифіковано, дані не передано до Helsi'"));
		Возврат;
	КонецЕсли;	
	
	ibs_ВыгрузитьВHelsiНаСервере();
	ibs_ПроверитьНаличиеДанныхВHelsi();
	// -y.surai IBS 2026.10.01
КонецПроцедуры

&НаСервере
Процедура ibs_ПроверитьНаличиеДанныхВHelsi()
	// +y.surai IBS 2026.10.01
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	НЗ = РегистрыСведений.ibs_ДиагностическиеОтчетыHelsi.СоздатьНаборЗаписей();
	НЗ.Отбор.КарточкаПациента.Установить(Объект.Ссылка);
	НЗ.Прочитать();
	
	Если НЗ.Количество() Тогда
		Элементы.ibs_ВыгрузитьВHelsi.ЦветФона = Новый Цвет(204, 255, 204);
	Иначе
		Элементы.ibs_ВыгрузитьВHelsi.ЦветФона = Новый Цвет(255, 255, 255);
	КонецЕсли;	
	// -y.surai IBS 2026.10.01
КонецПроцедуры	

&НаСервере
Процедура ibs_ВыгрузитьВHelsiНаСервере()
	// +y.surai IBS 2026.10.01
	Если Объект.Ссылка.Пустая() Тогда
		Сообщить(НСтр("ru='Необходимо записать документ!';uk='Потрібно записати документ!'"), СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	Документы.КарточкаПациента.ВыгрузитьВHelsi(Объект.Ссылка);	
	// -y.surai IBS 2026.10.01
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// +y.surai IBS 2026.10.01
	ibs_ПроверитьНаличиеДанныхВHelsi();
	// -y.surai IBS 2026.10.01
