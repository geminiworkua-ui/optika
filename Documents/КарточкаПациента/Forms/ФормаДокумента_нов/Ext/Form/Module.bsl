&НаКлиенте
Процедура КоррекцияЗнака(Элемент)
	
	ПОпытка
		Если Число(Элемент.ТекстРедактирования) > 0 тогда
			ИмяПоля = Элемент.Имя;
			ОБъект[ИмяПоля] = -1 * Число(Элемент.ТекстРедактирования);
		КонецЕсли;
	Исключение;
	КонецПОпытки;
	
КонецПроцедуры

