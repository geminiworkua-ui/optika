&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если Не ЗначениеЗаполнено(Объект.Подразделение) 
		Тогда
		Сообщить("Необхідно вказати підрозділ");
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Пациент) 
		Тогда
		Сообщить("Необхідно вказати Пацієнта");
		Отказ = Истина;
	КонецЕсли;

	
	
	Если Объект.НазначеноОчки
		Тогда	
		Объект.НазначениеОчкиПредставление = сокрЛП("Окуляри " + 
		?(ЗначениеЗаполнено(Объект.НазначениеОчкиOD_sph),"OD_sph:" + строка(Объект.НазначениеОчкиOD_sph),"") +  
		?(ЗначениеЗаполнено(Объект.НазначениеОчкиOD_cyl)," OD_cyl:" + строка(Объект.НазначениеОчкиOD_cyl),"") + 		
		?(ЗначениеЗаполнено(Объект.НазначениеОчкиOD_ax)," OD_ax:" + строка(Объект.НазначениеОчкиOD_ax),"") + 		
		?(ЗначениеЗаполнено(Объект.НазначениеОчкиOD_ADD)," OD_ADD:" + строка(Объект.НазначениеОчкиOD_ax),"") + 
		
		?(ЗначениеЗаполнено(Объект.НазначениеОчкиOS_sph)," OS_sph:" + строка(Объект.НазначениеОчкиOS_sph),"") + 	
		?(ЗначениеЗаполнено(Объект.НазначениеОчкиOS_cyl)," OS_cyl:" + строка(Объект.НазначениеОчкиOS_cyl),"") + 		
		?(ЗначениеЗаполнено(Объект.НазначениеОчкиOS_ax)," OS_ax:" + строка(Объект.НазначениеОчкиOS_ax),"") +
		?(ЗначениеЗаполнено(Объект.НазначениеОчкиOS_ADD)," OS_ADD:" + строка(Объект.НазначениеОчкиOD_ax),"") + 
		
		?(ЗначениеЗаполнено(Объект.НазначениеОчки_DP)," DP:" + строка(Объект.НазначениеОчки_DP),"") + 
		?(ЗначениеЗаполнено(Объект.НазначениеОчки_CVD)," CVD:" + строка(Объект.НазначениеОчки_CVD),"") +
		?(ЗначениеЗаполнено(Объект.НазначениеОчки_PT)," PT:" + строка(Объект.НазначениеОчки_PT),"") +
		?(ЗначениеЗаполнено(Объект.НазначениеОчки_FFA)," FFA:" + строка(Объект.НазначениеОчки_FFA),"") +
		?(ЗначениеЗаполнено(Объект.НазначениеОчкиКомментарий),строка(Объект.НазначениеОчкиКомментарий),""));
				
	Иначе
		Объект.НазначениеОчкиПредставление = Неопределено;
	КонецЕсли;
	
	// МКЛ
	Если Объект.НазначеноМКЛ
		Тогда	
		Объект.НазначениеМКЛпредставление = сокрЛП(
		"МКЛ " + 
		"OD_sph:" + строка(Объект.НазначениеМКЛ_OD_sph) +  
		" OD_cyl:" + строка(Объект.НазначениеМКЛ_OD_cyl) + 	
		" OD_ax:" + строка(Объект.НазначеноМКЛ_OD_ax) + 
		
		" OS_sph:" + строка(Объект.НазначениеМКЛ_OS_sph) + 
		" OS_cyl:" + строка(Объект.НазначениеМКЛ_OS_cyl) + 		
		" OS_ax:" + строка(Объект.НазначеноМКЛ_OS_ax) + 
		строка(Объект.НазначеноМКЛ_Комментарий)); 
		Иначе
		Объект.НазначениеМКЛпредставление = Неопределено;
	КонецЕсли;

	// НЛ
	Если Объект.НазначеноНЛ	
		Тогда	
		Объект.НазначениеНЛпредставление = сокрЛП(
		"НЛ " + 
		"OD" + строка(Объект.НазначеноНЛ_OD) +  
		" OS:" + строка(Объект.НазначеноНЛ_OS) + 
		Строка(Объект.НазначеноНЛ_Комментарий)
		);  
		Иначе
		Объект.НазначениеНЛпредставление = Неопределено;
	КонецЕсли;
КонецПроцедуры
