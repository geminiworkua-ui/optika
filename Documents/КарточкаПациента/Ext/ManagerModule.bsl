Процедура ВыполнитьЗапросHelsi(КарточкаПациента)
	
	// 1. Разделяем URL на хост и путь к ресурсу
	Сервер = "studyid.helsi.pro";
	Ресурс = "/connect/token";
	
	// 2. Формируем тело запроса в формате x-www-form-urlencoded
	ПараметрыТела = Новый Соответствие;
	ПараметрыТела.Вставить("client_id", "goodvision_client");
	ПараметрыТела.Вставить("grant_type", "client_credentials");
	ПараметрыТела.Вставить("client_secret", "c95f31b7e84a4d6290f56a2bc7d3e0185f6a9b4c");
	
	СтрокаТела = "";
	Для Каждого Параметр Из ПараметрыТела Цикл
		Если ЗначениеЗаполнено(СтрокаТела) Тогда
			СтрокаТела = СтрокаТела + "&";
		КонецЕсли;
		// Кодируем спецсимволы в URL-формат
		СтрокаТела = СтрокаТела + КодироватьСтроку(Параметр.Ключ, СпособКодированияСтроки.КодировкаURL) + "=" + 
		КодироватьСтроку(Параметр.Значение, СпособКодированияСтроки.КодировкаURL);
	КонецЦикла;
	
	// 3. Создаем HTTP-запрос
	Запрос = Новый HTTPЗапрос(Ресурс);
	Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Запрос.УстановитьТелоИзСтроки(СтрокаТела, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	// 4. Отправляем запрос через защищенное соединение (HTTPS)
	НТТРСоединение = Новый HTTPСоединение(Сервер,,,,,, Новый ЗащищенноеСоединениеOpenSSL());
	
	ОтветHTTP = НТТРСоединение.ВызватьHTTPМетод("POST", Запрос);
	
	Если ОтветHTTP.КодСостояния = 200 Тогда
		СтрокаJSON = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
		Данные = ibs_Прочитать(СтрокаJSON); 
		
		Если ТипЗнч(Данные) = Тип("Структура") И Не Данные["access_token"] = Неопределено Тогда
			ibs_КодHelsi_Исполнитель = КарточкаПациента.Исполнитель.ФизическоеЛицо.ibs_КодHelsi;
			ibs_КлассМедУслугHelsi = КарточкаПациента.ibs_КлассификаторМедицинскихУслугHelsi;
			
			// 1. Разделяем URL на хост и путь к ресурсу
			access_token = Данные["access_token"];
			Сервер = "studyapi.helsi.pro";
			Ресурс = "/api/v3/patients";
			
			//------------------------------------------------------
			
			// 1. Подготовка обязательных параметров поиска
			КонтрагентПартнера = ПартнерыИКонтрагенты.ПолучитьКонтрагентаПартнераПоУмолчанию(КарточкаПациента.Пациент);
			Если КонтрагентПартнера.Пустая() Тогда
				ТекстСообщения = НСтр("ru='Не найден основной контрагент по партнеру!';uk='Не знайдено основного контрагента по партнеру!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли;	
			ФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(КонтрагентПартнера.НаименованиеПолное);
			
			//Параметр_birthDate = "16.02.1998";
			Параметр_lastName  = КодироватьСтроку(ФИО.Фамилия, СпособКодированияСтроки.URLВКодировкеURL);
			Параметр_firstName = КодироватьСтроку(ФИО.Имя,     СпособКодированияСтроки.URLВКодировкеURL);
			Параметр_birthDate = Формат(КонтрагентПартнера.ДатаРождения, "ДФ=dd.MM.yyyy");
			//Параметр_lastName  = КодироватьСтроку("Прізвище", СпособКодированияСтроки.URLВКодировкеURL);
			//Параметр_firstName = КодироватьСтроку("Пеномоп",  СпособКодированияСтроки.URLВКодировкеURL);
			
			// 2. Формирование строки URL с Query-параметрами
			ШаблонПути = "/api/v3/patients/?lastName=%1&firstName=%2&birthDate=%3";
			Ресурс = СтрШаблон(ШаблонПути, Параметр_lastName, Параметр_firstName, Параметр_birthDate);
			//Ресурс = "/api/v3/patients?lastName=Прізвище&firstName=Пеномоп&birthDate=16-02-1998";
			
			// 3. Настройка HTTPS соединения
			НТТРСоединение = Новый HTTPСоединение(Сервер,,,,,, Новый ЗащищенноеСоединениеOpenSSL());
			
			// 4. Создание HTTP-запроса и установка обязательного заголовка x-resource
			HTTPЗапрос = Новый HTTPЗапрос(Ресурс);
			HTTPЗапрос.Заголовки.Вставить("x-resource", ibs_КодHelsi_Исполнитель);
			//HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
			HTTPЗапрос.Заголовки.Вставить("Host", 		"studyapi.helsi.pro");
			//HTTPЗапрос.Заголовки.Вставить("Accept",     "application/json");
			//HTTPЗапрос.Заголовки.Вставить("User-Agent", "1C Enterprise 8.3");
			
			// Если используется авторизация (зеленый маркер на прошлых скринах), раскомментируйте:
			HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + access_token);
			
			// 5. Отправка GET-запроса
			Попытка
				HTTPОтвет = НТТРСоединение.Получить(HTTPЗапрос);
				КодСостояния = HTTPОтвет.КодСостояния;
				СтрокаJSON = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			Исключение
				ВызватьИсключение "Ошибка соединения с API: " + ОписаниеОшибки();
			КонецПопытки;
			
			// 6. Разбор полученного ответа
			Если КодСостояния = 200 Тогда
				Результат = ibs_Прочитать(СтрокаJSON);
			Иначе
				Сообщить(СтрШаблон("Ошибка API (%1): %2", КодСостояния, СтрокаJSON));
			КонецЕсли;
			
			Если Результат = Неопределено ИЛИ Не Результат.Количество() Тогда
				Возврат;
			КонецЕсли;	
			
			//------------------------------------------------------
			
			// Создаем основную структуру документа
			ДанныеДокумента = Новый Структура;
			ДанныеДокумента.Вставить("issuedAt", Формат(КарточкаПациента.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss")); // Дата та час формування діагностичного звіту (не пізніше поточної): Так
			ДанныеДокумента.Вставить("patientId", Результат[0].id); // Ідентифікатор пацієнта в Helsi Pro: Так
			ДанныеДокумента.Вставить("performerId", ibs_КодHelsi_Исполнитель); // Ідентифікатор ресурсу співробітника в Helsi Pro (виконавець): Так
			ДанныеДокумента.Вставить("serviceLocationId", "d5458431-4366-13c9-38af-7521d313044e"); // Ідентифікатор місця надання послуг: Так
			ДанныеДокумента.Вставить("interpreterId", ibs_КодHelsi_Исполнитель);
			//ДанныеДокумента.Вставить("conclusionCode", "МКХ-10");//ibs_КлассМедУслугHelsi.Код);
			ДанныеДокумента.Вставить("category", 1); // Число
			ДанныеДокумента.Вставить("diagnosticResult", "");
			ДанныеДокумента.Вставить("conclusion", КарточкаПациента.ibs_ЗаключениеHelsi);
			ДанныеДокумента.Вставить("isReadyToSign", КарточкаПациента.ibs_ГотовыйДоПодписания);
			
			// Вложенная структура "service"
			СтруктураService = Новый Структура;
			СтруктураService.Вставить("achiId", КарточкаПациента.ibs_КлассификаторМедицинскихУслугHelsi.ID);
			СтруктураService.Вставить("text", ibs_КлассМедУслугHelsi.Наименование);
			ДанныеДокумента.Вставить("service", СтруктураService);
			
			НЗ = РегистрыСведений.ibs_ДиагностическиеОтчетыHelsi.СоздатьНаборЗаписей();
			НЗ.Отбор.КарточкаПациента.Установить(КарточкаПациента);
			НЗ.Прочитать();
			
			Если НЗ.Количество() Тогда
				// Редактируем существующий диагностический отчет
				ВызватМетод = "PUT";
				Ресурс = "/api/v1/diagnosticReports/" + НЗ[0].IDHelsi;
				ДанныеДокумента.Вставить("helsiId", НЗ[0].IDHelsi);
			Иначе
				// Создаем новый диагностический отчет
				ВызватМетод = "POST";
				Ресурс = "/api/v1/diagnosticReports";
			КонецЕсли;
			
			СтрокаJSON = ibs_ЗаписатьJSON(ДанныеДокумента);
			
			// 1. Инициализация запроса и заголовков
			НТТРЗапрос = Новый HTTPЗапрос(Ресурс);
			НТТРЗапрос.Заголовки.Вставить("x-resource",    ibs_КодHelsi_Исполнитель);
			НТТРЗапрос.Заголовки.Вставить("Host",          "studyapi.helsi.pro");
			НТТРЗапрос.Заголовки.Вставить("Accept",        "application/json");
			НТТРЗапрос.Заголовки.Вставить("Content-Type",  "application/json; charset=utf-8"); // Обязательно для POST JSON
			НТТРЗапрос.Заголовки.Вставить("User-Agent",    "1C Enterprise 8.3");
			
			// Если используется авторизация, раскомментируйте строку ниже:
			НТТРЗапрос.Заголовки.Вставить("Authorization", "Bearer " + access_token);
			
			// 2. Установка сформированной ранее строки JSON в тело POST-запроса
			НТТРЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			
			// 3. Отправка POST-запроса
			Попытка
				// Используем метод ВызватьHTTPМетод вместо ОтправитьДляОбработки, чтобы явно указать "POST"
				НТТРОтвет = НТТРСоединение.ВызватьHTTPМетод(ВызватМетод, НТТРЗапрос);
				
				КодСостояния = НТТРОтвет.КодСостояния;
				СтрокаJSON = НТТРОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				Если КодСостояния = 200 Тогда
					Результат = ibs_Прочитать(СтрокаJSON);
					МЗ = РегистрыСведений.ibs_ДиагностическиеОтчетыHelsi.СоздатьМенеджерЗаписи();
					МЗ.КарточкаПациента = КарточкаПациента;
					МЗ.Прочитать(); // Считываем только по измерению КарточкаПациента
					МЗ.КарточкаПациента = КарточкаПациента;
					МЗ.IDHelsi = Результат.helsiId;
					МЗ.Записать();
				Иначе
					Сообщить(СтрШаблон("Ошибка API (%1): %2", КодСостояния, СтрокаJSON));
				КонецЕсли;
			Исключение
				ВызватьИсключение "Ошибка соединения с API: " + ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Функция ibs_ЗаписатьJSON(СтруктураJSON)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();  
	ЗаписатьJSON(ЗаписьJSON, СтруктураJSON);            
	Результат = ЗаписьJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция ibs_Прочитать(СтрокаJSON) 

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(Чтение);
	Возврат Результат;
	
КонецФункции

