
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	
	
	Если Параметры.Свойство("НомерПроцедуры") Тогда
		Объект.Пациент = Параметры.Пациент;  
		Объект.НазначениеКурсаЛечения = Параметры.КурсЛечения;
		Объект.ПорядковыйНомер = Параметры.НомерПроцедуры;
		Объект.Подразделение = Параметры.Подразделение;
		
	ОбъектД = Объект.НазначениеКурсаЛечения.ПолучитьОбъект();
	
	Для каждого Стр из ОбъектД.НазначениеЛечебныхПроцедур цикл
		НовСтр = Объект.ВыполненныеПроцедуры.Добавить();
		НовСтр.ЛечебнаяПроцедура = Стр.ЛечебнаяПроцедура;
	КонецЦикла;
	
	 //   ЭтаФорма.ФормаИсточник = Параметры.ФормаИсточник;
	
 КонецЕсли;   
 
 	Если НЕ ЗначениеЗаполнено(ОБъект.Ссылка)
		Тогда
		 Объект.Исполнитель = ПользователиКлиентСервер.ТекущийПользователь();
    КонецЕсли

 
 
	
КонецПроцедуры
