Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	 
	 ДокументОбъект = ссылка.НазначениеКурсаЛечения.ПолучитьОбъект();
	 
	 ДокументОбъект.РасписаниеКурсаЛечений[Ссылка.ПорядковыйНомер-1].Дата = Ссылка.Дата;
	 ДокументОбъект.РасписаниеКурсаЛечений[Ссылка.ПорядковыйНомер-1].Выполнено = Ссылка.Ссылка;
	 
	 Колич = 0;
	 Для каждого Стр из Ссылка.ВыполненныеПроцедуры цикл
		 Если Стр.ОтметкаВыполнениеПроцедуры = Истина тогда КОлич = КОлич +1 КонецЕсли;
		 КонецЦикла;
		 
	 ДокументОбъект.РасписаниеКурсаЛечений[Ссылка.ПорядковыйНомер-1].КоличествоПроцедур = Колич;
		 
     ДокументОбъект.Записать();
	 
	 ЗаполнитьСвязанныйЗаказ();

КонецПроцедуры	     
 
Процедура ОбработкаУдаленияПроведения(Отказ)

	 ДокументОбъект = ссылка.НазначениеКурсаЛечения.ПолучитьОбъект();
	 
	 ДокументОбъект.РасписаниеКурсаЛечений[Ссылка.ПорядковыйНомер-1].Дата = неопределено;
	 ДокументОбъект.РасписаниеКурсаЛечений[Ссылка.ПорядковыйНомер-1].Выполнено = неопределено;
	 ДокументОбъект.РасписаниеКурсаЛечений[Ссылка.ПорядковыйНомер-1].КоличествоПроцедур = неопределено;
		 
     ДокументОбъект.Записать();
	 
	 УдалитьСвязанныеДокументыРеализации()
	 
КонецПроцедуры	 
 
Процедура УдалитьСвязанныеДокументыРеализации()
	// проверим есть ли оплаты по карточке	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЧекККМ.Ссылка
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.ДокументОснование = &ДокументОснование";
	Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщить("Неможливо відмінпити проведення тому що є проведені оплати по вказаному заммовленню");
		Отказ = Истина;
	Иначе	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.ЗаказКлиента.ДокументОснование = &ДокументОснование";
		Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() цикл
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Комментарий = ДокОбъект.Комментарий + " помічено на видалення " + Строка(ТекущаяДата()) + " користувачем " + 	Строка(ПараметрыСеанса.АвторизованныйПользователь);
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.ДокументОснование = &ДокументОснование";
		Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() цикл
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Комментарий = ДокОбъект.Комментарий + " помічено на видалення " + Строка(ТекущаяДата()) + " користувачем " + 	Строка(ПараметрыСеанса.АвторизованныйПользователь);
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
 КонецПроцедуры	  	
	
Процедура ЗаполнитьСвязанныйЗаказ()
	
	УстановитьПривилегированныйРежим(Истина);
	
	
	// отменим проведение связанных реализаций
	Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.ЗаказКлиента.ДокументОснование = &ДокументОснование";
		Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() цикл
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Комментарий = ДокОбъект.Комментарий + " помічено на видалення " + Строка(ТекущаяДата()) + " користувачем " + 	Строка(ПараметрыСеанса.АвторизованныйПользователь);
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЦикла;

	//	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК ЗаказКлиента
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.ДокументОснование = &ДокументОснование";
	Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Заказ = Выборка.ЗаказКлиента.получитьОбъект();
	Иначе
		Заказ = Документы.ЗаказКлиента.СоздатьДокумент();
		Заказ.Номер = "";
    КонецЕсли;
		 
	Заказ.Менеджер = ПараметрыСеанса.АвторизованныйПользователь; 
	Заказ.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();     
	Заказ.Валюта = Справочники.Валюты.НайтиПоКоду("980");
	
		Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Склады.Ссылка  КАК Склад
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	Склады.Подразделение = &Подразделение";
	Запрос.УстановитьПараметр("Подразделение", Ссылка.Подразделение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Заказ.Склад = Выборка.Склад;
	КонецЕсли;
	Заказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Заказ.Партнер = Ссылка.Пациент;                   
	//Заказ.КартаЛояльности = Заказ.КартаЛояльности;
	//Заказ.Контрагент = ?(Заказ.КартаЛояльности.Контрагент = Справочники.Контрагенты.ПустаяСсылка(), бит_сервер.НайтиКонтрагента(Объект.Партнер),Заказ.КартаЛояльности.Контрагент);
	Заказ.Подразделение = Ссылка.Подразделение;
	Заказ.Касса = КассаПодразделения(Ссылка.Подразделение);
	Заказ.БанковскийСчет = СчетПодразделения(Ссылка.Подразделение);
	Заказ.ПорядокРасчетов = перечисления.ПорядокРасчетов.ПоЗаказамНакладным;
	Заказ.Дата = Ссылка.Дата;
	Заказ.ДатаОтгрузки = Ссылка.Дата;
	Заказ.ЖелаемаяДатаОтгрузки = Ссылка.Дата;
	Заказ.Приоритет = Справочники.Приоритеты.ПолучитьПриоритетПоУмолчанию(Неопределено );
	Заказ.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	Заказ.ДокументОснование = Ссылка;
	Заказ.ЭтоОсмотрВрача = Истина;
	Заказ.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению;
	
	// заполним ТЧ
	
	Текст = "Сформовано автоматично на підставі документу " + Строка(Ссылка) + " користувачем " + Строка(ПараметрыСеанса.АвторизованныйПользователь);
	Заказ.Комментарий = Текст;
	
	Заказ.Товары.Очистить();
	
	Для каждого Стр из ЭтотОбъект.ВыполненныеПроцедуры цикл
			СтрЗаказа = Заказ.Товары.Добавить();
			СтрЗаказа.Номенклатура = Стр.ЛечебнаяПроцедура;
			СтрЗаказа.Характеристика = Неопределено;
            СтрЗаказа.Упаковка = Стр.ЛечебнаяПроцедура.ЕдиницаИзмерения;
			СтрЗаказа.Количество = 1;
			СтрЗаказа.КоличествоУпаковок = 1;
			СтрЗаказа.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
			СтрЗаказа.Цена = ЦенаУслуги(Стр.ЛечебнаяПроцедура, Справочники.ВидыЦен.НайтиПоНаименованию("Роздрібна"));
			СтрЗаказа.Сумма = Число(СтрЗаказа.Цена) * число(СтрЗаказа.Количество);
			СтрЗаказа.СуммаНДС = 0;
			СтрЗаказа.СуммаСНДС = Число(СтрЗаказа.Цена) * число(СтрЗаказа.Количество);
			СтрЗаказа.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется;
			СтрЗаказа.ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Роздрібна");
			СтрЗаказа.ДатаОтгрузки = Ссылка.Дата; 
			СтрЗаказа.Склад = Заказ.Склад;
			 
	КонецЦикла;
			
	Заказ.СуммаДокумента = Заказ.Товары.Итог("Сумма");
	
	//
	Заказ.ЭтапыГрафикаОплаты.Очистить();
	СтрГрафика = Заказ.ЭтапыГрафикаОплаты.Добавить();
	СтрГрафика.ВариантОплаты  = Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки;
	СтрГрафика.ДатаПлатежа =  Ссылка.Дата;
	СтрГрафика.ПроцентПлатежа = 100.0;
	СтрГрафика.СуммаПлатежа = Заказ.СуммаДокумента;
	// Боков
		
	Заказ.Записать(РежимЗаписиДокумента.Проведение);
	
	//СоздатьСвязаннуюРеализацию(Заказ.Ссылка);

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры	

Процедура СоздатьСвязаннуюРеализацию(ЗаказКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка КАК Реализация
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.ЗаказКлиента = &ЗаказКлиента";
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Реализация = Выборка.Реализация.получитьОбъект();
	Иначе
		Реализация = документы.РеализацияТоваровУслуг.СоздатьДокумент();
	КонецЕсли;
	
	Реализация.Менеджер = ПараметрыСеанса.АвторизованныйПользователь; 
	Реализация.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();     
	Реализация.Валюта = ЗаказКлиента.Валюта;
	Реализация.ВалютаВзаиморасчетов = ЗаказКлиента.Валюта;
    Реализация.РеализацияПоЗаказам = Истина;
	Реализация.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
	Реализация.ЗаказКлиента = ЗаказКлиента;
	Реализация.Склад = ЗаказКлиента.Склад;  
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Партнер = ЗаказКлиента.Партнер;                   
	Реализация.КартаЛояльности = ЗаказКлиента.КартаЛояльности;
	Реализация.Контрагент = ?(ЗаказКлиента.КартаЛояльности.Контрагент = Справочники.Контрагенты.ПустаяСсылка(), бит_сервер.НайтиКонтрагента(ЗаказКлиента.Партнер),ЗаказКлиента.КартаЛояльности.Контрагент);
	Реализация.Подразделение = ЗаказКлиента.Склад.Подразделение;
	Реализация.Касса = ЗаказКлиента.Касса;      
	Реализация.Валюта = ЗаказКлиента.Валюта;
	//	Реализация.БанковскийСчет = ЗаказКлиента.БанковскийСчет;
	Реализация.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным;
	Реализация.Дата = ЗаказКлиента.Дата + 1;
	//	Реализация.ДатаОтгрузки = бит_сервер.ДатаОтгрузки(ЗаказКлиента);
	Реализация.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	
	Реализация.Товары.Очистить();
	
	Для каждого Стр из ЗаказКлиента.Товары цикл
		НовСтр = Реализация.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
				
	КонецЦикла;
	
	Реализация.СуммаДокумента = Реализация.Товары.Итог("Сумма");
	Реализация.СуммаВзаиморасчетов = Реализация.СуммаДокумента;

	ПОпытка
	
	Реализация.Записать(РежимЗаписиДокумента.Проведение);
Исключение
//	Реализация.Записать(РежимЗаписиДокумента.Запись);
	Сообщить("Не удалось провести реализацию. Необходимо проврить корректность заполнения цепочки документов");
	КонецПопытки


КонецПроцедуры

Функция ЦенаУслуги(Номенклатура, ВидЦены)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	|ГДЕ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура = &Номенклатура
	|	И ЦеныНоменклатурыСрезПоследних.ВидЦены = &ВидЦены");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
	Возврат Результат.Цена;
	КонецЕсли;	

КонецФункции

Функция КассаПодразделения(Подразделение)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Кассы.Ссылка
	|ИЗ
	|	Справочник.Кассы КАК Кассы
	|ГДЕ
	|	НЕ Кассы.ПометкаУдаления
	|	И Кассы.Владелец = &Владелец
	|	И Кассы.Подразделение = &Подразделение");
Запрос.УстановитьПараметр("Владелец", Справочники.Организации.ОрганизацияПоУмолчанию());
Запрос.УстановитьПараметр("Подразделение", Подразделение);
Результат = Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	Возврат Результат.ссылка;
КонецЕсли;	
КонецФункции	

