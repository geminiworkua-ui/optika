
Процедура ОбработкаПроведения(Отказ, Режим)
	// регистр БроньЗаписиКВрачу
	
ВыполнитьЗаписьВРегистр();

КонецПроцедуры


Процедура ВыполнитьЗаписьВРегистр()
	
	
	НовыйНаборЗаписей = РегистрыСведений.БроньЗаписиКВрачу.СоздатьНаборЗаписей();
	НовыйНаборЗаписей.Отбор.Регистратор.Установить(Ссылка, Истина);
	
	Запись = НовыйНаборЗаписей.Добавить();
	Запись.Регистратор = Ссылка;
	Запись.ВремяНачала = ВремяПриема;
	Запись.Врач = Врач;
	Запись.МестоПриема = МестоПриема;
	Запись.Должность = Должность;
	Запись.Услуга = Услуга;
	Запись.ВремяБронирования = Дата + 5*60;
	Запись.Записать();

КонецПроцедуры