
Процедура ОбработкаПроведения(Отказ, Режим)

	// регистр ПривязкаСПД
	Движения.ПривязкаСПД.Записывать = Истина;
	Для Каждого ТекСтрокаРаспределение Из Распределение Цикл
		Движение = Движения.ПривязкаСПД.Добавить();
		Движение.Период = ДатаНачалаДействия;
		Движение.Магазин = Магазин;
		Движение.СПД = ТекСтрокаРаспределение.СПД;
		Движение.КассаККМ = ТекСтрокаРаспределение.КассаККМ;
		Движение.ГруппаНоменклатурыДляРРО = ТекСтрокаРаспределение.ГруппаНоменклатуры;
		Движение.КассирПоУмолчанию = ТекСтрокаРаспределение.КассирПоУмолчанию; 
		Движение.Фискализация = Истина;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КассаБезФискализации)
		ТОгда
		Движение = Движения.ПривязкаСПД.Добавить();
		Движение.Период = ДатаНачалаДействия;
		Движение.Магазин = Магазин;
		Движение.КассаККМ = КассаБезФискализации;
		Движение.КассирПоУмолчанию = справочники.ФизическиеЛица.ПустаяСсылка(); 
		Движение.Фискализация = Ложь;
	КонецЕсли;
	
КонецПроцедуры
