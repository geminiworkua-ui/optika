
&НаСервере
Функция ПодразделениеМагазина()
	Возврат ОБъект.Магазин.Подразделение;
КонецФункции

&НаКлиенте
Процедура МагазинПриИзменении(Элемент)
	
	Подразделение = ПодразделениеМагазина()
		
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		Если 
		НЕ ЗначениеЗаполнено(ОБъект.Ссылка)
		Тогда
		Объект.Автор = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАктуальнымиНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Магазин)
		И
		 ЗначениеЗаполнено(Объект.ДатаНачалаДействия)
		
		Тогда
		Объект.Распределение.Очистить();
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГруппаНоменклатурыДляРРО.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппаНоменклатурыДляРРО КАК ГруппаНоменклатурыДляРРО
		|ГДЕ
		|	НЕ ГруппаНоменклатурыДляРРО.ПометкаУдаления";
		
		РезультатЗапросаСправочник = Запрос.Выполнить().Выбрать();
		Пока РезультатЗапросаСправочник.Следующий() цикл
			
			Стр = Объект.Распределение.Добавить();
			
			Стр.ГруппаНоменклатуры  = РезультатЗапросаСправочник.Ссылка;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПривязкаСПДСрезПоследних.СПД КАК СПД,
			|	ПривязкаСПДСрезПоследних.КассирПоУмолчанию КАК КассирПоУмолчанию,
			|	ПривязкаСПДСрезПоследних.КассаККМ КАК КассаККМ
			|ИЗ
			|	РегистрСведений.ПривязкаСПД.СрезПоследних(&Период, ) КАК ПривязкаСПДСрезПоследних
			|ГДЕ
			|	ПривязкаСПДСрезПоследних.Магазин = &Магазин
			|	И ПривязкаСПДСрезПоследних.ГруппаНоменклатурыДляРРО = &ГруппаНоменклатурыДляРРО";
			Запрос.УстановитьПараметр("Период", Объект.ДатаНачалаДействия);
			Запрос.УстановитьПараметр("Магазин", Объект.Магазин);			
			Запрос.УстановитьПараметр("ГруппаНоменклатурыДляРРО", РезультатЗапросаСправочник.Ссылка);	
			
			РезультатЗапроса = Запрос.Выполнить().Выбрать();
			Если РезультатЗапроса.Следующий() тогда 
				Стр.СПД =  РезультатЗапроса.СПД;	
				Стр.КассирПоУмолчанию  =  РезультатЗапроса.КассирПоУмолчанию;
				Стр.КассаККМ = РезультатЗапроса.КассаККМ;
			КонецЕсли;    
			
		КонецЦикла;
		
	Иначе
		Текст ="ru = 'Автозаполнение невозможно: не выбран магазин и/или дата начала.'; uk = 'Автозаповнення неможливо: не обран магазин та або дата початку.'";
		Сообщить(Нстр(Текст));
	КонецЕсли;	  
	  
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАктуальными(Команда)
	ЗаполнитьАктуальнымиНаСервере();
	ПроверитьФактИзмененияОтПрошлого();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФактИзмененияОтПрошлого()
	
	Для каждого Стр из Объект.Распределение цикл
		
		П = Новый Структура;
		П.Вставить("ГруппаНоменклатуры",Стр.ГруппаНоменклатуры);
		П.Вставить("СПД",Стр.СПД);
		П.Вставить("КассирПоУмолчанию",Стр.КассирПоУмолчанию);
		
		Пответ = ПроверитьИзменение(П);
		ЕстьИзмСПД = неопределено;
		ЕстьИзмНом = неопределено;
		ЕстьИзмКассир = Неопределено;
		
		Пответ.Свойство("ЕстьИзмСПД",ЕстьИзмСПД);
		Пответ.Свойство("ЕстьИзмНом",ЕстьИзмНом);
		Пответ.Свойство("ЕстьИзмКассир",ЕстьИзмКассир);
		
		Стр.ЕстьИзменение = ЕстьИзмСПД;
		Стр.ЕстьИзменениеКассира = ЕстьИзмКассир;
		Стр.ЕстьИзменениеНоменклатуры = ЕстьИзмНом;
		
	КонецЦикла;

КонецПроцедуры	

&НаСервере
Функция ПроверитьИзменение(П);
	ГруппаНоменклатуры = Неопределено;
	СПД = Неопределено;
	КассирПоУмолчанию = Неопределено;
	П.Свойство("ГруппаНоменклатуры",ГруппаНоменклатуры);
	П.Свойство("СПД",СПД);
	П.Свойство("КассирПоУмолчанию",КассирПоУмолчанию);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПривязкаСПДСрезПоследних.СПД КАК СПД,
	|	ПривязкаСПДСрезПоследних.КассирПоУмолчанию КАК КассирПоУмолчанию
	|ИЗ
	|	РегистрСведений.ПривязкаСПД.СрезПоследних(&Период, ) КАК ПривязкаСПДСрезПоследних
	|ГДЕ
	|	ПривязкаСПДСрезПоследних.Магазин = &Магазин
	|	И ПривязкаСПДСрезПоследних.ГруппаНоменклатурыДляРРО = &ГруппаНоменклатурыДляРРО";
	Запрос.УстановитьПараметр("Период", Объект.ДатаНачалаДействия - 60*60*24);
	Запрос.УстановитьПараметр("Магазин", Объект.Магазин);			
	Запрос.УстановитьПараметр("ГруппаНоменклатурыДляРРО", ГруппаНоменклатуры);	
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() тогда 
		СПДнов =  РезультатЗапроса.СПД;	
		КассирПоУмолчаниюНов  =  РезультатЗапроса.КассирПоУмолчанию;
		ЕстьИзмНом = Ложь;
	Иначе
		ЕстьИзмНом = Истина
	КонецЕсли; 		
	
	ЕстьИзмСПД = ?(	НЕ СПДнов = СПД,Истина,Ложь);
    ЕстьИзмКассир = ?(НЕ КассирПоУмолчаниюНов = КассирПоУмолчанию,Истина,Ложь);

    Пответ = Новый Структура;
	Пответ.Вставить("ЕстьИзмСПД",ЕстьИзмСПД);
	Пответ.Вставить("ЕстьИзмНом",ЕстьИзмНом);
    Пответ.Вставить("ЕстьИзмКассир",ЕстьИзмКассир);

	Возврат Пответ;
	
	КонецФункции			
	
&НаКлиенте
Процедура РаспределениеПриИзменении(Элемент)
		ПроверитьФактИзмененияОтПрошлого();
КонецПроцедуры
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
		ПроверитьФактИзмененияОтПрошлого();
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ЕстьОшибка = Ложь;
	Если
		НЕ ЗначениеЗаполнено(Объект.ДатаНачалаДействия)
		ИЛИ 
		НЕ ЗначениеЗаполнено(Объект.Магазин)
		Тогда
		ЕстьОшибка = Истина
	КонецЕсли;
	
	Для каждого Стр из Объект.Распределение цикл
		Если 
			НЕ ЗначениеЗаполнено(Стр.ГруппаНоменклатуры)
			ИЛИ 
			НЕ ЗначениеЗаполнено(Стр.СПД)
			ИЛИ 
			НЕ ЗначениеЗаполнено(Стр.КассирПоУмолчанию)
			
			Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если  ЕстьОшибка = Истина
		Тогда
		Отказ = Истина; 
		Текст = "ru = 'Ошибка! Не заполнены все реквизиты документа.'; uk = 'Помилка! Не заповнени усі реквізити документа.'";
		Сообщить(Нстр(Текст));
		
	КонецЕсли;
	
КонецПроцедуры
	
	