
&НаСервере
Процедура ЗаполнитьНаСервере()
	
Если  
		Объект.ДатаНачалаПериода > '00010101000000'
		И
		Объект.ДатаОкончанияПериода > '00010101000000'
		И
		Объект.ДатаОкончанияПериода > Объект.ДатаНачалаПериода
		Тогда
	
	Объект.ФормированиеГрафика.Очистить();	
	ДатаЗаполнения = Объект.ДатаНачалаПериода;
	Пока ДатаЗаполнения <= Объект.ДатаОкончанияПериода  цикл
		
		НовСтр = Объект.ФормированиеГрафика.Добавить();
		НовСтр.Дата = ДатаЗаполнения;
		НовСтр.ДеньНедели = ДатаЗаполнения;  
		ДН = деньнедели(ДатаЗаполнения);
		Если
			ДН = 1 Тогда
			НовСтр.ВремяНачала = Объект.ПнНач;
			НовСтр.ВремяОкончания = ОБъект.ПнКон;
		ИначеЕсли	
		   	ДН = 2 Тогда
			НовСтр.ВремяНачала = Объект.ВтНач;
			НовСтр.ВремяОкончания = ОБъект.ВтКон;
		ИначеЕсли	
		   	ДН = 3 Тогда
			НовСтр.ВремяНачала = Объект.СрНач;
			НовСтр.ВремяОкончания = Объект.СрКон;
		ИначеЕсли	
		   	ДН = 4 Тогда
			НовСтр.ВремяНачала = Объект.ЧтНач;
			НовСтр.ВремяОкончания = Объект.ЧтКон;
 		ИначеЕсли	
		   	ДН = 5 Тогда
			НовСтр.ВремяНачала = Объект.ПтНач;
			НовСтр.ВремяОкончания = Объект.ПтКон;
 		ИначеЕсли	
		   	ДН = 6 Тогда
			НовСтр.ВремяНачала = Объект.СбНач;
			НовСтр.ВремяОкончания = Объект.СбКон;
 		ИначеЕсли	
		   	ДН = 7 Тогда
			НовСтр.ВремяНачала = Объект.ВсНач;
			НовСтр.ВремяОкончания = Объект.ВсКон;
		КонецЕсли;
		
		ДатаЗаполнения = ДатаЗаполнения + (60*60*24);
				
	КонецЦикла	
	Иначе
		Текст = "ru = 'Не заполнены даты начала и окончания периода.'; uk = 'Не заповнени дати початку і закінчення періоду.'";
		
   КонецЕсли;
	

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

