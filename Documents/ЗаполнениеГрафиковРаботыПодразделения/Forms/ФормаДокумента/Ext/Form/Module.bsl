&НаКлиенте
Процедура ЗаполнитьДатуНачПоАналогии(Команда)
	
	Если 
		ЗначениеЗаполнено(Объект.ПнНач)
		Тогда
		Объект.ВтНач = Объект.ПнНач;
		Объект.СрНач = Объект.ПнНач;
		Объект.ЧтНач = Объект.ПнНач;
		Объект.ПтНач = Объект.ПнНач;
		Объект.СбНач = Объект.ПнНач;
		Объект.ВсНач = Объект.ПнНач;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДатуОконПоАналогии(Команда)
	Если 
		ЗначениеЗаполнено(Объект.ПнКон)
		Тогда
		Объект.ВтКон = Объект.ПнКон;
		Объект.СрКон = Объект.ПнКон;
		Объект.ЧтКон = Объект.ПнКон;
		Объект.ПтКон = Объект.ПнКон;
		Объект.СбКон = Объект.ПнКон;
		Объект.ВсКон = Объект.ПнКон;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если 
		НЕ ЗначениеЗаполнено(ОБъект.Ссылка)
		Тогда
		Объект.Автор = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;


КонецПроцедуры
