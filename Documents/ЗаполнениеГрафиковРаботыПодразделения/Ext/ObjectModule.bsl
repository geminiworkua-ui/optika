
Процедура ОбработкаПроведения(Отказ, Режим)
	// регистр ГрафикиРаботы
	Движения.ГрафикиРаботы.Записывать = Истина;
	Для Каждого ТекСтрокаФормированиеГрафика Из ФормированиеГрафика Цикл
		Движение = Движения.ГрафикиРаботы.Добавить();
		Движение.Период = ТекСтрокаФормированиеГрафика.Дата;
		Движение.ВидГрафика = ВидГрафика;
		Движение.ВремяНачалаРаботы = ТекСтрокаФормированиеГрафика.ВремяНачала;
		Движение.ВремяОкончанияРаботы = ТекСтрокаФормированиеГрафика.ВремяОкончания;
		
		Если
			ТекСтрокаФормированиеГрафика.ВремяНачала > '00010101000000'
			И
			ТекСтрокаФормированиеГрафика.ВремяОкончания	> '00010101000000'
			Тогда
			Движение.РабочийДень = Истина
		Иначе
			Движение.РабочийДень = Ложь
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры
