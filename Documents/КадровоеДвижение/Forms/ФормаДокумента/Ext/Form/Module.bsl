	ЭтаФорма.Прочитать();

	
КонецПроцедуры

&НаКлиенте
Процедура КадровыеДвиженияФизическоеЛицоПриИзменении(Элемент)
	
   ТекСтр =Элементы.КадровыеДвижения.ТекущиеДанные;
   
   Если ТекСтр.ЕстьИндГрафик = Истина
	   Тогда
	   
		П = Новый Структура;
		П.Вставить("ФизическоеЛицо", ТекСтр.ФизическоеЛицо);
        П.Вставить("НоваяДолжность", ТекСтр.НоваяДолжность);
        П.Вставить("НовоеПодразделение", ТекСтр.НовоеПодразделение);
		П.Вставить("Документ",ТекСтр.УстановкаИндивидуальногоГрафикаРаботы);
	   
	    ОтразитьИзмененияИндРасписанияНаСервере(П);
		
		Текст = "ru = 'Было изменено индивидуальное расписание сотрудника.'; uk = 'Був змінений індивідуальний розклад працівника.'";
	    Сообщить(Нстр(Текст));
		
   КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтразитьИзмененияИндРасписанияНаСервере(П); 
    ФизическоеЛицо = неопределено;
	НоваяДолжность = неопределено;
	НовоеПодразделение = неопределено;
	УстановкаИндивидуальногоГрафикаРаботы = неопределено;
	
	П.Свойство("ФизическоеЛицо", ФизическоеЛицо);
    П.Свойство("НоваяДолжность", НоваяДолжность);
    П.Свойство("НовоеПодразделение", НовоеПодразделение);
    П.Свойство("Документ", УстановкаИндивидуальногоГрафикаРаботы);
	
