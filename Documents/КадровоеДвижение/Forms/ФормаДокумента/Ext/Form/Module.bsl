
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если 
		НЕ ЗначениеЗаполнено(ОБъект.Ссылка)
		Тогда
		Объект.Автор = ПользователиКлиентСервер.ТекущийПользователь();
		СоздатьКопииИндРасписаний();

	КонецЕсли;

КонецПроцедуры

 &НаСервере
 Процедура СоздатьКопииИндРасписаний()
	 
	 Для каждого Стр из Объект.КадровыеДвижения цикл
		 Если ЗначениеЗаполнено(Стр.УстановкаИндивидуальногоГрафикаРаботы)
			 Тогда 
			 НовДок = Стр.УстановкаИндивидуальногоГрафикаРаботы.Скопировать();
			 НовДок.Записать();
			 Стр.УстановкаИндивидуальногоГрафикаРаботы = НовДок;
		     КонецЕсли;
	  КонецЦикла;
	 
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьИндивидуальныйГрафик(Команда)

	ТекСтр = Элементы.КадровыеДвижения.ТекущиеДанные;
	Ссыль =  ТекСтр.УстановкаИндивидуальногоГрафикаРаботы;	
	Идент = Элементы.КадровыеДвижения.ТекущиеДанные.ПолучитьИдентификатор();
	
	ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
	
	Если ЗначениеЗаполнено(ТекСтр.УстановкаИндивидуальногоГрафикаРаботы) тогда
		П = Новый Структура;
		П.Вставить("Ключ", ТекСтр.УстановкаИндивидуальногоГрафикаРаботы); 
		//П.Вставить("Идент",Идент); 
		П.Вставить("Дата",Объект.Дата);
		П.Вставить("Основание", Объект.Ссылка);
		П.Вставить("ФизическоеЛицо", ТекСтр.ФизическоеЛицо);
		П.Вставить("НоваяДолжность", ТекСтр.НоваяДолжность);
		П.Вставить("НовоеПодразделение", ТекСтр.НовоеПодразделение);

		ОткрытьФорму("Документ.РегистрацияИндивидуальногоГрафикаРаботыСотрудника.Форма.ФормаДокумента",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе  
		П = Новый Структура;
		П.Вставить("Идент",Идент); 
		П.Вставить("Дата",Объект.Дата);
		П.Вставить("Основание", Объект.Ссылка);
		П.Вставить("ФизическоеЛицо", ТекСтр.ФизическоеЛицо);
		П.Вставить("НоваяДолжность", ТекСтр.НоваяДолжность);
		П.Вставить("НовоеПодразделение", ТекСтр.НовоеПодразделение);
		ОткрытьФорму("Документ.РегистрацияИндивидуальногоГрафикаРаботыСотрудника.Форма.ФормаДокумента",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
//		ОткрытьФорму("Документ.РегистрацияРасписанияРаботыСотрудников.Форма.ВыборРасписания",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	КонецЕсли
	
КонецПроцедуры
 
