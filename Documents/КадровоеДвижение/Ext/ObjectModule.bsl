
Процедура ОбработкаПроведения(Отказ, Режим)

	// регистр КадроваяРасстановка
	Движения.КадроваяРасстановка.Записывать = Истина;
	Для Каждого ТекСтрокаКадровыеДвижения Из КадровыеДвижения Цикл
		Движение = Движения.КадроваяРасстановка.Добавить();
		Движение.Период = Дата;
		Движение.ФизическоеЛицо = ТекСтрокаКадровыеДвижения.ФизическоеЛицо;
		Движение.Подразделение = ТекСтрокаКадровыеДвижения.НовоеПодразделение;
		Движение.Должность = ТекСтрокаКадровыеДвижения.НоваяДолжность;
		Движение.ВидКадровогоДвижения = ТекСтрокаКадровыеДвижения.ВидКадровогоДвижения;
		Движение.СпособНачисленияСтавки = ТекСтрокаКадровыеДвижения.СпособНачисленияСтавки;
		
		Если  НЕ ТекСтрокаКадровыеДвижения.ВидКадровогоДвижения = Перечисления.ВидыКадровыхДвижений.Увольнение
			Тогда
			Движение.Актуальность = Перечисления.СтатусыСотрудников.Актуальний
		Иначе
			Движение.Актуальность = Перечисления.СтатусыСотрудников.НеАктуальный
		КонецЕсли;

		Движение.БазоваяСтавка = ТекСтрокаКадровыеДвижения.БазоваяСтавка;
		
		Если  ЗначениеЗаполнено(ТекСтрокаКадровыеДвижения.УстановкаИндивидуальногоГрафикаРаботы)
			Тогда
			Движение.ЕстьИндивидуальныйГрафик = Истина
		Иначе
			Движение.ЕстьИндивидуальныйГрафик = Ложь
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры
