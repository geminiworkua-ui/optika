
&НаКлиенте
Процедура ОтработанноеВремяВремяНачалаРаботыПриИзменении(Элемент)
	ОтработанноеВремяВремяНачалаРаботыПриИзмененииНаСервере();

	
		
		
	
КонецПроцедуры

&НаСервере
Процедура ОтработанноеВремяВремяНачалаРаботыПриИзмененииНаСервере()
	
	Для каждого ТекСтр из Объект.ОтработанноеВремя цикл	
		
		Если ТекСтр.ВремяНачалаРаботы > '00010101000000'
			И
			ТекСтр.ВремяОкончанияРаботы  > '00010101000000'
			
			Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, СЕКУНДА) КАК Разница");
			Запрос.УстановитьПараметр("МеньшаяДата", ТекСтр.ВремяНачалаРаботы);
			Запрос.УстановитьПараметр("БольшаяДата", ТекСтр.ВремяОкончанияРаботы);
			РезультатЗапроса = Запрос.Выполнить().Выбрать();
			Если РезультатЗапроса.Следующий() тогда 
				Разница = РезультатЗапроса.Разница;
			КонецЕсли;    		
			
		КонецЕсли;
		
		Если 
			ТекСтр.ВычетыВремени > '00010101000000'
			Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, СЕКУНДА) КАК Разница");
			Запрос.УстановитьПараметр("МеньшаяДата", '00010101000000');
			Запрос.УстановитьПараметр("БольшаяДата", ТекСтр.ВычетыВремени);
			РезультатЗапроса = Запрос.Выполнить().Выбрать();
			Если РезультатЗапроса.Следующий() тогда 
				Вычет = РезультатЗапроса.Разница;
			КонецЕсли;   
			
			Разница = Разница - Вычет;
			
		КонецЕсли;
			
		ТекСтр.ОтработаноВремени = ПериодЧасыМинутыСекунды(Разница);	
		
	КонецЦикла;
	
	
	
	
	
КонецПроцедуры


Функция ПериодЧасыМинутыСекунды(Знач КоличествоСекунд)
	
	Перем Часы, Минуты, Секунды;
	
	//получаем часы
	Часы = Цел(КоличествоСекунд / 3600);
	//считаем остаток
	КоличествоСекунд = КоличествоСекунд % 3600;
	//получаем минуты
	Минуты = Цел(КоличествоСекунд / 60);//в минуте 60 сек
	//остались секунды
	Секунды = КоличествоСекунд % 60;
	
	
	Время = Дата(0001,01,01,Часы,Минуты,Секунды);
	
	
	Возврат Время;	
КонецФункции

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если Объект.Дата > '00010101000000' 
		И 
		ЗначениеЗаполнено(Объект.Подразделение)
		
		Тогда
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		|	ГрафикиРаботыСрезПоследних.ВремяНачалаРаботы,
		|	ГрафикиРаботыСрезПоследних.ВремяОкончанияРаботы
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиРаботы.СрезПоследних(&Период, ) КАК ГрафикиРаботыСрезПоследних
		|		ПО СтруктураПредприятия.ГрафикРаботыПодразделения = ГрафикиРаботыСрезПоследних.ВидГрафика
		|ГДЕ
		|	СтруктураПредприятия.Ссылка = &Подразделение";
		Запрос.УстановитьПараметр("Подразделение",Объект.Подразделение);
		Запрос.УстановитьПараметр("Период",Началодня(Объект.Дата));
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Объект.ВремяНачалаРаботыПоГрафику = Выборка.ВремяНачалаРаботы;
			Объект.ВремяОкончанияРаботыПоГрафику = Выборка.ВремяОкончанияРаботы;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ДатаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАктуальнымиНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОБъект.ОтработанноеВремя.Очистить();
	Если Объект.Дата > '00010101000000'  
		И
		ЗначениеЗаполнено(Объект.Подразделение)
		Тогда
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		               |	РасписаниеРаботыСотрудниковСрезПоследних.Подразделение,
		               |	РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник,
		               |	РасписаниеРаботыСотрудниковСрезПоследних.Должность,
		               |	РасписаниеРаботыСотрудниковСрезПоследних.ВремяНачалаРаботы,
		               |	РасписаниеРаботыСотрудниковСрезПоследних.ВремяОкончанияРаботы
		               |ИЗ
		               |	РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(&Период, ) КАК РасписаниеРаботыСотрудниковСрезПоследних
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяРасстановка.СрезПоследних(&Период, ) КАК КадроваяРасстановкаСрезПоследних
		               |		ПО РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник = КадроваяРасстановкаСрезПоследних.ФизическоеЛицо
		               |			И РасписаниеРаботыСотрудниковСрезПоследних.Подразделение = КадроваяРасстановкаСрезПоследних.Подразделение
		               |			И РасписаниеРаботыСотрудниковСрезПоследних.Должность = КадроваяРасстановкаСрезПоследних.Должность
		               |ГДЕ
		               |	РасписаниеРаботыСотрудниковСрезПоследних.Подразделение = &Подразделение
		               |	И РасписаниеРаботыСотрудниковСрезПоследних.СтатусЗанятости = &СтатусЗанятости
		               |	И КадроваяРасстановкаСрезПоследних.Актуальность = &Актуальность";
		
		Запрос.УстановитьПараметр("Подразделение", 		Объект.Подразделение);
		Запрос.УстановитьПараметр("Период", 			Началодня(Объект.Дата));
		Запрос.УстановитьПараметр("СтатусЗанятости", 	Перечисления.СтатусыЗанятости.Работа);
		Запрос.УстановитьПараметр("Актуальность",	 	Перечисления.СтатусыСотрудников.Актуальний);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НовСтр = Объект.ОтработанноеВремя.Добавить();
			НовСтр.Сотрудник = Выборка.Сотрудник;
			НовСтр.Должность = Выборка.Должность;
		КонецЦикла;
	КонецЕсли
КонецПроцедуры

