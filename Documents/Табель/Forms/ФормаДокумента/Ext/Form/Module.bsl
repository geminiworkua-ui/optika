&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Новый")
		Тогда
		объект.Подразделение = Параметры.Склад.Подразделение;
		Объект.Дата = ТекущаяДата();
		Объект.Автор = ПользователиКлиентСервер.ТекущийПользователь();
		ДатаПриИзмененииНаСервере();  
	
	ИНачеЕсли 
		НЕ ЗначениеЗаполнено(ОБъект.Ссылка)
		Тогда
		Объект.Дата = ТекущаяДата();
		Объект.Автор = ПользователиКлиентСервер.ТекущийПользователь();
		ПопыткаАвтозаполненияПодразделения();
		ДатаПриИзмененииНаСервере();
	Иначе
		
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПопыткаАвтозаполненияПодразделения()
	Если ЗначениеЗаполнено(Объект.Автор)
		И
		Объект.Дата > '00010101000000'
		
		Тогда
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		|	КадроваяРасстановкаСрезПоследних.Подразделение КАК Подразделение
		|ИЗ
		|	РегистрСведений.КадроваяРасстановка.СрезПоследних(&Период, ) КАК КадроваяРасстановкаСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО КадроваяРасстановкаСрезПоследних.ФизическоеЛицо = Пользователи.ФизическоеЛицо
		|ГДЕ
		|	КадроваяРасстановкаСрезПоследних.Актуальность = &Актуальность
		|	И Пользователи.Ссылка = &Автор";
		Запрос.УстановитьПараметр("Автор",Объект.Автор);
		Запрос.УстановитьПараметр("Актуальность",Перечисления.СтатусыСотрудников.Актуальний);
		Запрос.УстановитьПараметр("Период",началодня(ОБъект.Дата));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Объект.Подразделение = Выборка.Подразделение;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
