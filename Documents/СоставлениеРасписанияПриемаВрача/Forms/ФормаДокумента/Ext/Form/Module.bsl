&НаКлиенте
Процедура РаписаниеПриемаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтр = Элементы.РаписаниеПриема.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекСтр.ДокументЗаписи)
		Тогда
		
		П = Новый Структура("Ключ", ТекСтр.ДокументЗаписи);
		
		ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
		ОткрытьФорму("Документ.ЗаписьНаПрием.Форма.ФормаДокумента",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	//	ОткрытьЗначение(ТекСтр.ДокументЗаписи)
		
	ИначеЕсли
		ТекСтр.Актуально = Истина
		Тогда
		П = Новый Структура;
		П.Вставить("Идент",ТекСтр.ПолучитьИдентификатор()); 
		П.Вставить("НомСтр",ТекСтр.НомерСтроки); 
		П.Вставить("Дата",Объект.Дата);
		П.Вставить("Основание", Объект.Ссылка);
		П.Вставить("ФизическоеЛицо", ТекСтр.Сотрудник);
		П.Вставить("Должность", ТекСтр.Должность);
		П.Вставить("Подразделение", ТекСтр.Подразделение);
		П.Вставить("ВремяНачала", ТекСтр.ВремяНачала);
		П.Вставить("ВремяОкончания", ТекСтр.ВремяОкончания); 
		П.Вставить("ВызовИзЧекаККМ", Ложь);
		
		ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
		ОткрытьФорму("Документ.ЗаписьНаПрием.Форма.ФормаДокумента",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	Иначе
		Текст = "ru = 'Выбранная строка записи не актуальна ((невозможна дл язаписи) на прием'; uk = 'Обрана строка не актуальна (непридатна для запису на прийом)'";
		Сообщить(Нстр(Текст));
	КонецЕсли
КонецПроцедуры


