&НаСервере
Функция ЗаполнитьТаблицуАкутальногоРасписания()
	
	М = Новый Массив;
	
	Если ОБъект.Месяц > '00010101000000'
		
		Тогда
		
		Объект.РасписаниеПриема.Очистить();
		
		НачалоПериодаЗаполнения = Началомесяца(Объект.Месяц);
		КонецПериодаЗаполнения = КонецМесяца(Объект.Месяц);
		
		//МаксНомерСтроки = 0;
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, ДЕНЬ) КАК Разница");
		Запрос.УстановитьПараметр("МеньшаяДата", НачалоПериодаЗаполнения);
		Запрос.УстановитьПараметр("БольшаяДата", КонецПериодаЗаполнения);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		Если РезультатЗапроса.Следующий() тогда 
			Разница = РезультатЗапроса.Разница+1;
		КонецЕсли; 
		
		Для День = 1 По Разница Цикл     
			
			ДатаТабеля = НачалоПериодаЗаполнения + (День-1) * 24*60*60;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РасписаниеРаботыСотрудниковСрезПоследних.Подразделение,
			|	РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник,
			|	РасписаниеРаботыСотрудниковСрезПоследних.Должность
			|ИЗ
			|	РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(&Период, ) КАК РасписаниеРаботыСотрудниковСрезПоследних
			|ГДЕ
			|	РасписаниеРаботыСотрудниковСрезПоследних.СтатусЗанятости = &СтатусЗанятости
			|	И РасписаниеРаботыСотрудниковСрезПоследних.Должность.ЭтоВрач";
			Запрос.УстановитьПараметр("Период",ДатаТабеля);   
			Запрос.УстановитьПараметр("СтатусЗанятости",Перечисления.СтатусыЗанятости.Работа);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() цикл
				
				
				ШагЗаписиВрача = 30;
				
				ЗапросСотрудник = Новый Запрос;
				ЗапросСотрудник.Текст = 
				"ВЫБРАТЬ
				|	РасписаниеРаботыСотрудниковСрезПоследних.ВремяНачалаРаботы,
				|	РасписаниеРаботыСотрудниковСрезПоследних.ВремяОкончанияРаботы,
				|	РАЗНОСТЬДАТ(РасписаниеРаботыСотрудниковСрезПоследних.ВремяНачалаРаботы, РасписаниеРаботыСотрудниковСрезПоследних.ВремяОкончанияРаботы, МИНУТА) КАК Разность
				|ИЗ
				|	РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(&Период, ) КАК РасписаниеРаботыСотрудниковСрезПоследних
				|ГДЕ
				|	РасписаниеРаботыСотрудниковСрезПоследних.Подразделение = &Подразделение
				|	И РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник = &Сотрудник
				|	И РасписаниеРаботыСотрудниковСрезПоследних.Должность = &Должность";
				ЗапросСотрудник.УстановитьПараметр("Подразделение",Выборка.Подразделение);
				ЗапросСотрудник.УстановитьПараметр("Сотрудник",Выборка.Сотрудник);
				ЗапросСотрудник.УстановитьПараметр("Должность",Выборка.Должность);
				ЗапросСотрудник.УстановитьПараметр("Период",ДатаТабеля);   
				
				ВыборкаСотрудник = ЗапросСотрудник.Выполнить().Выбрать();
				Если ВыборкаСотрудник.Следующий() Тогда
					ВремяНачЗаписи =  ВыборкаСотрудник.ВремяНачалаРаботы;
					ВремяОкончанияЗаписи = ВыборкаСотрудник.ВремяНачалаРаботы;
					ИнтервалВремени = ВыборкаСотрудник.Разность; 
					КоличПриемов = окр(ИнтервалВремени / ШагЗаписиВрача,0,0);				
					
					Если КоличПриемов > 0 тогда	
						Для сч = 0 по КоличПриемов-1 Цикл	
							
							НовСтр = Новый Структура ("ВремяНачала, ВремяОкончания, Подразделение, Сотрудник, Должность, Актуально");
							ВремяСтарта = Час(ВремяНачЗаписи)*(60*60) + минута(ВремяНачЗаписи)*60 ;
							НовСтр.ВремяНачала = ДатаТабеля + ВремяСтарта + ШагЗаписиВрача*60 * Сч;
							НовСтр.ВремяОкончания = ДатаТабеля + ВремяСтарта + ШагЗаписиВрача*60 * (Сч + 1) - 1;
							НовСтр.Подразделение = Выборка.Подразделение;
							НовСтр.Сотрудник = Выборка.Сотрудник;
							НовСтр.Должность = Выборка.Должность;
							НовСтр.Актуально = Истина;
							М.Добавить(НовСтр);
						КонецЦикла	
					КонецЕсли;	
				КонецЕсли; 
			КонецЦикла
		КонецЦикла;
	КонецЕсли;

	Возврат М;

КонецФункции


&НаКлиенте
Процедура ОбновитьРасписание(Команда)
	
	// отменим актуальность
	МТ = Новый Массив;
	Для каждого Стр из ОБъект.РасписаниеПриема цикл
		НовСтр = Новый Структура ("ВремяНачала, ВремяОкончания, Подразделение, Сотрудник, Должность, Актуально, НомерСтроки, Акутуально");
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		Инд = ОБъект.РасписаниеПриема.Индекс(Стр);
		НовСтр.НомерСтроки = Число(Инд) + 1;
		МТ.Добавить(НовСтр);
	КонецЦикла;
	ОбновитьРасписаниеНаСервере(МТ);
	
   
КонецПроцедуры

&НаСервере
Процедура ОбновитьРасписаниеНаСервере(МТ)
	
	
	Для каждого Стр из ОБъект.РасписаниеПриема цикл
		Стр.Актуально = Ложь;
	КонецЦикла;
	
	М = ЗаполнитьТаблицуАкутальногоРасписания();
		ТЗ = новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
		ТЗ.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
		ТЗ.Колонки.Добавить("Должность", Новый ОписаниеТипов("СправочникСсылка.Должности"));
		ТЗ.Колонки.Добавить("ВремяНачала", Новый ОписаниеТипов("Дата"));
		ТЗ.Колонки.Добавить("ВремяОкончания", Новый ОписаниеТипов("Дата"));
	
	Для каждого Запись из М цикл
		
		//Подразделение = Неопределено;
		//Сотрудник     = Неопределено;
		//ВремяНачала   = Неопределено;
		//ВремяОкончания = Неопределено;
		//Должность      = Неопределено;
		//
		//Запись.Свойство("Подразделение", Подразделение);
		//Запись.Свойство("Сотрудник", Сотрудник);
		//Запись.Свойство("ВремяНачала", ВремяНачала); 
		//Запись.Свойство("ВремяОкончания", ВремяОкончания);
		//Запись.Свойство("Должность", Должность);
		
		
		НовСтр = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Запись);
		
	КонецЦикла;
	
	ТЗТ = новый ТаблицаЗначений;
	ТЗТ.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТЗТ.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТЗТ.Колонки.Добавить("Должность", Новый ОписаниеТипов("СправочникСсылка.Должности"));
	ТЗТ.Колонки.Добавить("ВремяНачала", Новый ОписаниеТипов("Дата"));
	ТЗТ.Колонки.Добавить("ВремяОкончания", Новый ОписаниеТипов("Дата"));  	   
	ТЗТ.Колонки.Добавить("Актуально", Новый ОписаниеТипов("Булево"));  
	ТЗТ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));  
	
	Для каждого Стр из МТ цикл
		НовСтр = ТЗТ.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗТ.НомерСтроки,
	|	ТЗТ.Подразделение,
	|	ТЗТ.Сотрудник,
	|	ТЗТ.Должность,
	|	ТЗТ.ВремяНачала,
	|	ТЗТ.ВремяОкончания,
	|	ТЗТ.Актуально
	|ПОМЕСТИТЬ вт_ТЗТ
	|ИЗ
	|	&ТЗТ КАК ТЗТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК Актуально,
	|	ТЗ.Подразделение,
	|	ТЗ.Сотрудник,
	|	ТЗ.Должность,
	|	ТЗ.ВремяНачала,
	|	ТЗ.ВремяОкончания
	|ПОМЕСТИТЬ вт_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗТ.НомерСтроки,
	|	вт_ТЗТ.Подразделение,
	|	вт_ТЗТ.Сотрудник,
	|	вт_ТЗТ.Должность,
	|	вт_ТЗТ.ВремяНачала,
	|	вт_ТЗТ.ВремяОкончания,
	|	вт_ТЗ.Актуально
	|ПОМЕСТИТЬ вт_сбор
	|ИЗ
	|	вт_ТЗТ КАК вт_ТЗТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ТЗ КАК вт_ТЗ
	|		ПО вт_ТЗТ.Подразделение = вт_ТЗ.Подразделение
	|			И вт_ТЗТ.Сотрудник = вт_ТЗ.Сотрудник
	|			И вт_ТЗТ.Должность = вт_ТЗ.Должность
	|			И вт_ТЗТ.ВремяНачала = вт_ТЗ.ВремяНачала
	|			И вт_ТЗТ.ВремяОкончания = вт_ТЗ.ВремяОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_сбор.НомерСтроки,
	|	вт_сбор.Подразделение,
	|	вт_сбор.Сотрудник,
	|	вт_сбор.Должность,
	|	вт_сбор.ВремяНачала,
	|	вт_сбор.ВремяОкончания,
	|	вт_сбор.Актуально
	|ИЗ
	|	вт_сбор КАК вт_сбор
	|ГДЕ
	|	вт_сбор.Актуально = ИСТИНА";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("ТЗТ", ТЗТ);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НомСтроки = число(ВыборкаДетальныеЗаписи.НомерСтроки)-1;
		ОБъект.РасписаниеПриема[НомСтроки].Актуально = Истина;
	КонецЦикла;
	
	
	// найдем что добавить
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗТ.НомерСтроки,
	|	ТЗТ.Подразделение,
	|	ТЗТ.Сотрудник,
	|	ТЗТ.Должность,
	|	ТЗТ.ВремяНачала,
	|	ТЗТ.ВремяОкончания,
	|	ТЗТ.Актуально
	|ПОМЕСТИТЬ вт_ТЗТ
	|ИЗ
	|	&ТЗТ КАК ТЗТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК Актуально,
	|	ТЗ.Подразделение,
	|	ТЗ.Сотрудник,
	|	ТЗ.Должность,
	|	ТЗ.ВремяНачала,
	|	ТЗ.ВремяОкончания
	|ПОМЕСТИТЬ вт_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗ.Подразделение,
	|	вт_ТЗ.Сотрудник,
	|	вт_ТЗ.Должность,
	|	вт_ТЗ.ВремяНачала,
	|	вт_ТЗ.ВремяОкончания,
	|	вт_ТЗТ.Актуально КАК Актуально1
	|ПОМЕСТИТЬ вт_сбор
	|ИЗ
	|	вт_ТЗ КАК вт_ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ТЗТ КАК вт_ТЗТ
	|		ПО (вт_ТЗТ.Подразделение = вт_ТЗ.Подразделение)
	|			И (вт_ТЗТ.Сотрудник = вт_ТЗ.Сотрудник)
	|			И (вт_ТЗТ.Должность = вт_ТЗ.Должность)
	|			И (вт_ТЗТ.ВремяНачала = вт_ТЗ.ВремяНачала)
	|			И (вт_ТЗТ.ВремяОкончания = вт_ТЗ.ВремяОкончания)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_сбор.Подразделение,
	|	вт_сбор.Сотрудник,
	|	вт_сбор.Должность,
	|	вт_сбор.ВремяНачала,
	|	вт_сбор.ВремяОкончания,
	|	ИСТИНА КАК Актуально
	|ИЗ
	|	вт_сбор КАК вт_сбор";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("ТЗТ", ТЗТ);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НовСтр = ОБъект.РасписаниеПриема.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ВыборкаДетальныеЗаписи);
		
		
	КонецЦикла;

       
	 
	
КонецПроцедуры


