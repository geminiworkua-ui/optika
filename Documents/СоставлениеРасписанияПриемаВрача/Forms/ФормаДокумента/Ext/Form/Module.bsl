	ОБъект.Месяц = НачалоМесяца(Объект.Дата);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Запись_РасписаниеПриемаВрача"
		ТОгда
		Элементы.РаписаниеПриема.Обновить();
	КонецЕсли;
	
КонецПроцедуры

