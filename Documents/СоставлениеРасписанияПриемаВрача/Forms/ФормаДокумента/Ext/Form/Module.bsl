&НаСервере
Процедура ЗаполнитьРасписаниеНаСервере()
	
	Если ОБъект.Месяц > '00010101000000'
		
		Тогда
		ШагЗаписиВрача = 30;
		Объект.РасписаниеПриема.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасписаниеРаботыСотрудниковСрезПоследних.Подразделение,
		|	РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник,
		|	РасписаниеРаботыСотрудниковСрезПоследних.Должность,
		|	РасписаниеРаботыСотрудниковСрезПоследних.ВремяНачалаРаботы,
		|	РасписаниеРаботыСотрудниковСрезПоследних.ВремяОкончанияРаботы,
		|	РасписаниеРаботыСотрудниковСрезПоследних.РабочийДень,
		|	РАЗНОСТЬДАТ(РасписаниеРаботыСотрудниковСрезПоследних.ВремяНачалаРаботы, РасписаниеРаботыСотрудниковСрезПоследних.ВремяОкончанияРаботы, МИНУТА) КАК Разность
		|ИЗ
		|	РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(
		|			&Период,
		|			Должность.ЭтоВрач
		|				И СтатусЗанятости = &СтатусЗанятости
		|				И (РабочийДень МЕЖДУ НАЧАЛОПЕРИОДА(&Месяц, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Месяц, МЕСЯЦ))) КАК РасписаниеРаботыСотрудниковСрезПоследних";
		Запрос.УстановитьПараметр("Период",ТекущаяДата()); 
		Запрос.УстановитьПараметр("Месяц",ОБъект.Месяц);   
		Запрос.УстановитьПараметр("СтатусЗанятости",Перечисления.СтатусыЗанятости.Работа);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() цикл
			
			ВремяНачЗаписи =  Выборка.ВремяНачалаРаботы;
			ВремяОкончанияЗаписи = Выборка.ВремяНачалаРаботы;
			ИнтервалВремени = Выборка.Разность; 
			КоличПриемов = окр(ИнтервалВремени / ШагЗаписиВрача,0,РежимОкругления.Окр15как10);				
			
			Если КоличПриемов > 0 тогда	
				Для сч = 0 по КоличПриемов-1 Цикл	
					
					НовСтр = Объект.РасписаниеПриема.Добавить();
					ВремяСтарта = Час(ВремяНачЗаписи)*(60*60) + минута(ВремяНачЗаписи)*60 ;
					НовСтр.ВремяНачала = Выборка.РабочийДень + ВремяСтарта + ШагЗаписиВрача*60 * Сч;
					НовСтр.ВремяОкончания = Выборка.РабочийДень + ВремяСтарта + ШагЗаписиВрача*60 * (Сч + 1) - 1;
					НовСтр.Подразделение = Выборка.Подразделение;
					НовСтр.Сотрудник = Выборка.Сотрудник;
					НовСтр.Должность = Выборка.Должность;
					НовСтр.Актуально = Истина;
					
				КонецЦикла	
			КонецЕсли;	
		КонецЦикла
	КонецЕсли;
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьРасписаниеНаСервереСтар()
	
	Если ОБъект.Месяц > '00010101000000'
		
		Тогда
		
		Объект.РасписаниеПриема.Очистить();
		
		НачалоПериодаЗаполнения = Началомесяца(Объект.Месяц);
		КонецПериодаЗаполнения = КонецМесяца(Объект.Месяц);
		
		//МаксНомерСтроки = 0;
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, ДЕНЬ) КАК Разница");
		Запрос.УстановитьПараметр("МеньшаяДата", НачалоПериодаЗаполнения);
		Запрос.УстановитьПараметр("БольшаяДата", КонецПериодаЗаполнения);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		Если РезультатЗапроса.Следующий() тогда 
			Разница = РезультатЗапроса.Разница+1;
		КонецЕсли; 
		
		Для День = 1 По Разница Цикл     
			
			ДатаТабеля = НачалоДня(НачалоПериодаЗаполнения + (День-1) * 24*60*60);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РасписаниеРаботыСотрудниковСрезПоследних.Подразделение,
			|	РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник,
			|	РасписаниеРаботыСотрудниковСрезПоследних.Должность
			|ИЗ
			|	РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(
			|			&Период,
			|			Должность.ЭтоВрач
			|				И СтатусЗанятости = &СтатусЗанятости
			|				И РабочийДень = &РабочийДень) КАК РасписаниеРаботыСотрудниковСрезПоследних
			|ГДЕ
			|	РасписаниеРаботыСотрудниковСрезПоследних.СтатусЗанятости = &СтатусЗанятости
			|	И РасписаниеРаботыСотрудниковСрезПоследних.Должность.ЭтоВрач
			|
			|СГРУППИРОВАТЬ ПО
			|	РасписаниеРаботыСотрудниковСрезПоследних.Подразделение,
			|	РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник,
			|	РасписаниеРаботыСотрудниковСрезПоследних.Должность";
			Запрос.УстановитьПараметр("Период",ТекущаяДата()); 
			Запрос.УстановитьПараметр("РабочийДень",ДатаТабеля);   
			Запрос.УстановитьПараметр("СтатусЗанятости",Перечисления.СтатусыЗанятости.Работа);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() цикл
				ЗаполнитьРасписаниеСотрудникаНаСервере(Выборка.Подразделение,Выборка.Сотрудник, Выборка.Должность, ДатаТабеля); 
			КонецЦикла
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасписаниеСотрудникаНаСервере(Подразделение,Сотрудник, Должность, ДатаТабеля )
	
	ШагЗаписиВрача = 30;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасписаниеРаботыСотрудниковСрезПоследних.ВремяНачалаРаботы,
	|	РасписаниеРаботыСотрудниковСрезПоследних.ВремяОкончанияРаботы,
	|	РАЗНОСТЬДАТ(РасписаниеРаботыСотрудниковСрезПоследних.ВремяНачалаРаботы, РасписаниеРаботыСотрудниковСрезПоследних.ВремяОкончанияРаботы, МИНУТА) КАК Разность
	|ИЗ
	|	РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(
	|			&Период,
	|			Подразделение = &Подразделение
	|				И Сотрудник = &Сотрудник
	|				И Должность = &Должность
	|				И РабочийДень = &РабочийДень) КАК РасписаниеРаботыСотрудниковСрезПоследних";
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	Запрос.УстановитьПараметр("Сотрудник",Сотрудник);
	Запрос.УстановитьПараметр("Должность",Должность);
	Запрос.УстановитьПараметр("Период", текущаяДата()); 
	Запрос.УстановитьПараметр("РабочийДень",ДатаТабеля); 

	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВремяНачЗаписи =  Выборка.ВремяНачалаРаботы;
		ВремяОкончанияЗаписи = Выборка.ВремяНачалаРаботы;
		ИнтервалВремени = Выборка.Разность; 
		КоличПриемов = окр(ИнтервалВремени / ШагЗаписиВрача,0,0);				
		
		Если КоличПриемов > 0 тогда	
			Для сч = 0 по КоличПриемов-1 Цикл	
				
				НовСтр = Объект.РасписаниеПриема.Добавить();
				ВремяСтарта = Час(ВремяНачЗаписи)*(60*60) + минута(ВремяНачЗаписи)*60 ;
				НовСтр.ВремяНачала = ДатаТабеля + ВремяСтарта + ШагЗаписиВрача*60 * Сч;
				НовСтр.ВремяОкончания = ДатаТабеля + ВремяСтарта + ШагЗаписиВрача*60 * (Сч + 1) - 1;
				НовСтр.Подразделение = Подразделение;
				НовСтр.Сотрудник = Сотрудник;
				НовСтр.Должность = Должность;
				НовСтр.Актуально = Истина;
				
			КонецЦикла	
		КонецЕсли;	
	КонецЕсли; 
КонецПроцедуры
  //
