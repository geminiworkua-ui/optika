
Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!

	// регистр РасписаниеПриемаВрача
	Движения.РасписаниеПриемаВрача.Записывать = Истина;
	Для Каждого ТекСтрокаРасписаниеПриема Из РасписаниеПриема Цикл
		Движение = Движения.РасписаниеПриемаВрача.Добавить();
		Движение.ВремяНачалаПриема = ТекСтрокаРасписаниеПриема.ВремяНачала;
		Движение.ВремяОкончанияПриема = ТекСтрокаРасписаниеПриема.ВремяОкончания;
		Движение.Врач = ТекСтрокаРасписаниеПриема.Сотрудник;
		Движение.МестоПриема = ТекСтрокаРасписаниеПриема.Подразделение;
		Движение.КодСтроки = ТекСтрокаРасписаниеПриема.НомерСтроки;
		Движение.Должность = ТекСтрокаРасписаниеПриема.Должность;
		Движение.ЕстьЗапись = ТекСтрокаРасписаниеПриема.ЕстьЗапись;
		Движение.ЗаписьНаПрием = ТекСтрокаРасписаниеПриема.ДокументЗаписи; 
		Движение.Номенклатура = ТекСтрокаРасписаниеПриема.Номенклатура;
		
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Склады.БизнесРегион КАК Регион
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	Склады.Подразделение = &Подразделение";
		
		Запрос.УстановитьПараметр("Подразделение", ТекСтрокаРасписаниеПриема.Подразделение);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
		Если ВыборкаДетальныеЗаписи.Следующий() ТОгда
			Рег = ВыборкаДетальныеЗаписи.Регион;
		Иначе
			Рег = Справочники.БизнесРегионы.ПустаяСсылка();
		Конецесли;
		
		Движение.регион = Рег;
		
		
	КонецЦикла;

	Узлы =ПолучитьУзлы();                               
	Если Не Узлы.Количество() =0 Тогда
		Планыобмена.ЗарегистрироватьИзменения(Узлы, Ссылка);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьУзлы()

Запрос = Новый Запрос(
   "ВЫБРАТЬ
 |	ОбменССайтомНовый.Ссылка
 |ИЗ
 |	ПланОбмена.ОбменССайтомНовый КАК ОбменССайтомНовый
 |ГДЕ
 |	НЕ ОбменССайтомНовый.ЭтотУзел");
Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

Возврат Результат;
	
КонецФункции