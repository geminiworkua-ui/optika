
Процедура Печать(ТабДок, Ссылка) Экспорт
	//{{_КОНСТРУКТОР_ПЕЧАТИ(Печать)
	Макет = Документы.СоставлениеРасписанияПриемаВрача.ПолучитьМакет("Печать");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставлениеРасписанияПриемаВрача.Автор,
	|	СоставлениеРасписанияПриемаВрача.Дата,
	|	СоставлениеРасписанияПриемаВрача.Должность,
	|	СоставлениеРасписанияПриемаВрача.Комментарий,
	|	СоставлениеРасписанияПриемаВрача.Месяц,
	|	СоставлениеРасписанияПриемаВрача.Номер,
	|	СоставлениеРасписанияПриемаВрача.Подразделение,
	|	СоставлениеРасписанияПриемаВрача.Сотрудник,
	|	СоставлениеРасписанияПриемаВрача.РасписаниеПриема.(
	|		НомерСтроки,
	|		ВремяНачала,
	|		ВремяОкончания,
	|		Актуально,
	|		ДокументЗаписи,
	|		ЕстьЗапись
	|	)
	|ИЗ
	|	Документ.СоставлениеРасписанияПриемаВрача КАК СоставлениеРасписанияПриемаВрача
	|ГДЕ
	|	СоставлениеРасписанияПриемаВрача.Ссылка В (&Ссылка)";
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьРасписаниеПриемаШапка = Макет.ПолучитьОбласть("РасписаниеПриемаШапка");
	ОбластьРасписаниеПриема = Макет.ПолучитьОбласть("РасписаниеПриема");
	Подвал = Макет.ПолучитьОбласть("Подвал");

	ТабДок.Очистить();

	ВставлятьРазделительСтраниц = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		ТабДок.Вывести(ОбластьЗаголовок);

		Шапка.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Шапка, Выборка.Уровень());

		ТабДок.Вывести(ОбластьРасписаниеПриемаШапка);
		ВыборкаРасписаниеПриема = Выборка.РасписаниеПриема.Выбрать();
		Пока ВыборкаРасписаниеПриема.Следующий() Цикл
			ОбластьРасписаниеПриема.Параметры.Заполнить(ВыборкаРасписаниеПриема);
			ТабДок.Вывести(ОбластьРасписаниеПриема, ВыборкаРасписаниеПриема.Уровень());
		КонецЦикла;

		Подвал.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Подвал);

		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;
	//}}
КонецПроцедуры
