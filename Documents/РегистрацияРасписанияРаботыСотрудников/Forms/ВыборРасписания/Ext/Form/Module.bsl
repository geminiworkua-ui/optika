
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Идентификатор = Параметры.Идентификатор;  
	ЭтаФорма.СтатусЗанятости = Параметры.СтатусЗанятости;
	ЭтаФорма.ВремяНачала = Параметры.ВремяНачала;
	ЭтаФорма.ВремяОкончания  = Параметры.ВремяОкончания;
	ЭтаФорма.ВремяНачалаРаботыПодразделения  = Параметры.ВремяНачалаРаботыПодразделения;
    ЭтаФорма.ВремяОкончанияРаботыПодразделения  = Параметры.ВремяОкончанияРаботыПодразделения;
	ЭтаФорма.ПояснениеНеявки  = Параметры.ПояснениеНеявки;
	ЭтаФорма.ДокументОбъект  = Параметры.ДокументОбъект;
    	
КонецПроцедуры

 &НаКлиенте
Процедура УстановитьВидимость()
	Если ЭтаФорма.СтатусЗанятости = СтатусЗанятостиРабота ()
		Тогда 
		ЭтаФорма.Элементы.ГруппаРабочееВремя.Видимость = Истина;
		
	Иначе 
		ЭтаФорма.Элементы.ГруппаРабочееВремя.Видимость = Ложь
	КонецЕсли;
	
	Если  ЭтаФорма.СтатусЗанятости = СтатусЗанятостиПрочееОтсутствие()
        Тогда
		ЭтаФорма.Элементы.ПояснениеНеявки.Видимость = Истина
	Иначе
		ЭтаФорма.Элементы.ПояснениеНеявки.Видимость = Ложь
	КонецЕсли;
	
КонецПроцедуры
 
&НаКлиенте
Процедура СтатусЗанятостиПриИзменении(Элемент)

УстановитьВидимость();
		Если 
			ЭтаФорма.ВремяНачала <  '00010101000001' 
			или  НЕ ЗначениеЗаполнено(ЭтаФорма.ВремяНачала)
			Тогда ЭтаФорма.ВремяНачала = ЭтаФорма.ВремяНачалаРаботыПодразделения
		КонецЕсли;
		
			Если 
			ЭтаФорма.ВремяОкончания < '00010101000001' 
			или  НЕ ЗначениеЗаполнено(ЭтаФорма.ВремяОкончания)

			Тогда ЭтаФорма.ВремяОкончания = ЭтаФорма.ВремяОкончанияРаботыПодразделения
			КонецЕсли;

	ПриИзмененииЗначенийРеквизитов();
	
КонецПроцедуры

 &НаСервере
 Функция СтатусЗанятостиРабота ()
	 Возврат  Перечисления.СтатусыЗанятости.Работа
 КонецФункции
	 
 &НаСервере
 Функция СтатусЗанятостиПрочееОтсутствие()
	 Возврат  Перечисления.СтатусыЗанятости.ПрочееОтсутствие
 КонецФункции

&НаКлиенте
Процедура ПриИзмененииЗначенийРеквизитов()
	ПР = новый Структура;
	ПР.Вставить("Идентификатор", ЭтаФорма.Идентификатор);
	ПР.Вставить("ВремяНачала", ЭтаФорма.ВремяНачала);
    ПР.Вставить("ВремяОкончания", ЭтаФорма.ВремяОкончания);
    ПР.Вставить("ПояснениеНеявки", ЭтаФорма.ПояснениеНеявки);
    ПР.Вставить("СтатусЗанятости", ЭтаФорма.СтатусЗанятости);
	ПР.Вставить("ДокументОбъект", ЭтаФорма.ДокументОбъект);

	ОтразитьИзмененияНаСервере(ПР); 
	УстановитьВидимость();
	
КонецПроцедуры
 
&НаСервере
Процедура ОтразитьИзмененияНаСервере(ПР);   
	
	НомерСтроки  	= неопределено;
	ВремяНачала  	= неопределено;
	ВремяОкончания  = неопределено;
	Примечание      = неопределено;
	СтатусЗанятости = неопределено;
	ДокументОбъект  = неопределено;
	
	
	ПР.Свойство("Идентификатор", 	НомерСтроки);
	ПР.Свойство("ВремяНачала", 		ВремяНачала);
	ПР.Свойство("ВремяОкончания",	ВремяОкончания);
	ПР.Свойство("ПояснениеНеявки", 	Примечание);
	ПР.Свойство("СтатусЗанятости", 	СтатусЗанятости);
	ПР.Свойство("ДокументОбъект", 	ДокументОбъект);
	
	ДО = ДокументОбъект.ПолучитьОбъект();
	ДО.ДанныеДляРегистрацииРасписания[НомерСтроки-1].СтатусЗанятости = СтатусЗанятости;	
	
	Если СтатусЗанятости = Перечисления.статусыЗанятости.Работа
		Тогда
		ДО.ДанныеДляРегистрацииРасписания[НомерСтроки-1].ВремяНачала = ВремяНачала;
		ДО.ДанныеДляРегистрацииРасписания[НомерСтроки-1].ВремяОкончания = ВремяОкончания;
	ИначеЕсли
		СтатусЗанятости = Перечисления.статусыЗанятости.ПрочееОтсутствие
		Тогда
		ДО.ДанныеДляРегистрацииРасписания[НомерСтроки-1].Примечание = Примечание;
	КонецЕсли;
	
	ДО.Записать();
//	ДокументОбъект.ДанныеДляРегистрацииРасписания[НомерСтроки-1].ВремяНачала = Неопределено;
	//    ДокументОбъект.ДанныеДляРегистрацииРасписания[НомерСтроки-1].ВремяОкончания = Неопределено;
КонецПроцедуры	

&НаКлиенте
Процедура ВремяНачалаПриИзменении(Элемент)
	ПриИзмененииЗначенийРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура ВремяОкончанияПриИзменении(Элемент)
	ПриИзмененииЗначенийРеквизитов();

КонецПроцедуры

&НаКлиенте
Процедура ПояснениеНеявкиПриИзменении(Элемент)
	ПриИзмененииЗначенийРеквизитов();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимость();
КонецПроцедуры
