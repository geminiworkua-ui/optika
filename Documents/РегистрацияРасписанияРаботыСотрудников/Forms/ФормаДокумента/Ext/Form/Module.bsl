&НаКлиенте
Процедура РасписаниеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
 
КонецПроцедуры
    
&НаСервере
Процедура ЗаполнитьПервичныеДанные()
	
	Если ОБъект.Месяц > '00010101000000'
		
		Тогда

		ТЗ = новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
        ТЗ.Колонки.Добавить("Физлицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
		ТЗ.Колонки.Добавить("Должность", Новый ОписаниеТипов("СправочникСсылка.Должности"));
		ТЗ.Очистить();
		
		Объект.ДанныеДляРегистрацииРасписания.Очистить();
		Объект.АктуальныеСотрудники.Очистить();    
		Объект.Расписание.Очистить();
		
		НачалоПериодаЗаполнения = Началомесяца(Объект.Месяц);
		КонецПериодаЗаполнения = КонецМесяца(Объект.Месяц);
		
		МаксНомерСтроки = 0;
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, ДЕНЬ) КАК Разница");
		Запрос.УстановитьПараметр("МеньшаяДата", НачалоПериодаЗаполнения);
		Запрос.УстановитьПараметр("БольшаяДата", КонецПериодаЗаполнения);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		Если РезультатЗапроса.Следующий() тогда 
			Разница = РезультатЗапроса.Разница+1;
		КонецЕсли; 
		
		
		Для День = 1 По Разница Цикл     
			
			ДатаТабеля = НачалоПериодаЗаполнения + (День-1) * 24*60*60;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 			"ВЫБРАТЬ
			|	КадроваяРасстановкаСрезПоследних.ФизическоеЛицо,
			|	КадроваяРасстановкаСрезПоследних.Должность,
			|	ИндВремяРаботыСотрудников.ВремяНачала КАК ВремяНачалаРаботыСотрудника,
			|	ИндВремяРаботыСотрудников.ВремяОкончания КАК ВремяОкончанияРаботыСотрудника,
			|	КадроваяРасстановкаСрезПоследних.Подразделение,
			|	ВремяРаботыПодразделения.РабочийДень,
			|	ИндВремяРаботыСотрудников.СтатусЗанятости КАК СтатусЗанятостиСотрудника,
			|	КадроваяРасстановкаСрезПоследних.ЕстьИндивидуальныйГрафик,
			|	ВремяРаботыПодразделения.ВремяНачалаРаботыПодразделения,
			|	ВремяРаботыПодразделения.ВремяОкончанияРаботыПодразделения
			|ИЗ
			|	РегистрСведений.КадроваяРасстановка.СрезПоследних(&Период, ) КАК КадроваяРасстановкаСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ГрафикиРаботы.ВремяНачалаРаботы КАК ВремяНачалаРаботыПодразделения,
			|			ГрафикиРаботы.ВремяОкончанияРаботы КАК ВремяОкончанияРаботыПодразделения,
			|			СтруктураПредприятия.Ссылка КАК Подразделение,
			|			ГрафикиРаботы.РабочийДень КАК РабочийДень
			|		ИЗ
			|			Справочник.СтруктураПредприятия КАК СтруктураПредприятия
			|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыГрафиковРаботы КАК ВидыГрафиковРаботы
			|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиРаботы КАК ГрафикиРаботы
			|					ПО ВидыГрафиковРаботы.Ссылка = ГрафикиРаботы.ВидГрафика
			|				ПО СтруктураПредприятия.ГрафикРаботыПодразделения = ВидыГрафиковРаботы.Ссылка
			|		ГДЕ
			|			ГрафикиРаботы.Период = &Период) КАК ВремяРаботыПодразделения
			|		ПО КадроваяРасстановкаСрезПоследних.Подразделение = ВремяРаботыПодразделения.Подразделение
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.ВремяНачала КАК ВремяНачала,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.ВремяОкончания КАК ВремяОкончания,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.Подразделение КАК Подразделение,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.Должность КАК Должность,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.СтатусЗанятости КАК СтатусЗанятости
			|		ИЗ
			|			РегистрСведений.ИндивидуальныеГрафикиРаботыСотрудников.СрезПоследних(&Период, ) КАК ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних
			|		ГДЕ
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.ДеньНедели = &ДеньНедели) КАК ИндВремяРаботыСотрудников
			|		ПО КадроваяРасстановкаСрезПоследних.Подразделение = ИндВремяРаботыСотрудников.Подразделение
			|			И КадроваяРасстановкаСрезПоследних.ФизическоеЛицо = ИндВремяРаботыСотрудников.ФизическоеЛицо
			|			И КадроваяРасстановкаСрезПоследних.Должность = ИндВремяРаботыСотрудников.Должность
			|ГДЕ
			|	КадроваяРасстановкаСрезПоследних.Подразделение = &Подразделение
			|	И КадроваяРасстановкаСрезПоследних.Актуальность = &Актуальность";
			Запрос.УстановитьПараметр("Подразделение",ОБъект.Подразделение);
			Запрос.УстановитьПараметр("Актуальность",Перечисления.СтатусыСотрудников.Актуальний);
			Запрос.УстановитьПараметр("Период",ДатаТабеля);   
			Запрос.УстановитьПараметр("ДеньНедели",ДеньНедели(ДатаТабеля)); 
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл				НовСтр = Объект.ДанныеДляРегистрацииРасписания.Добавить();
				НовСтр.Дата = ДатаТабеля;
				НовСтр.ДеньМесяца = День(ДатаТабеля);
				Физлицо = Выборка.ФизическоеЛицо;
				
				НовСтр.ВремяНачалаРаботыПодразделения = Выборка.ВремяНачалаРаботыПодразделения;
				НовСтр.ВремяОкончанияРаботыПодразделения  = Выборка.ВремяОкончанияРаботыПодразделения;
								
				НовСтр.Физлицо  = Физлицо;
				НовСтр.Подразделение = Выборка.Подразделение;
				
				Должность = Выборка.Должность;
				НовСтр.Должность = Должность;
				
				НовСтр.ДеньНедели = ДеньНедели(ДатаТабеля);
				
				Если 
					Выборка.РабочийДень = Ложь
					Тогда
					НовСтр.ВремяНачала = Неопределено;
					НовСтр.ВремяОкончания = Неопределено;
					НовСтр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Выходной;
					
				ИначеЕсли
					Выборка.РабочийДень = Истина
					И
					НЕ Выборка.ЕстьИндивидуальныйГрафик  
					Тогда 
					НовСтр.ВремяНачала = Выборка.ВремяНачалаРаботыПодразделения;
					НовСтр.ВремяОкончания = Выборка.ВремяОкончанияРаботыПодразделения;
					НовСтр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Работа
					
				ИначеЕсли 
					Выборка.РабочийДень = Истина
					И
					Выборка.ЕстьИндивидуальныйГрафик  
					И
					Выборка.СтатусЗанятостиСотрудника = Перечисления.СтатусыЗанятости.Работа
					Тогда 
					НовСтр.ВремяНачала = макс(Выборка.ВремяНачалаРаботыПодразделения,Выборка.ВремяНачалаРаботыСотрудника);
					НовСтр.ВремяОкончания = мин(Выборка.ВремяОкончанияРаботыПодразделения, Выборка.ВремяОкончанияРаботыСотрудника);
					НовСтр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Работа;
				ИначеЕсли 
					Выборка.РабочийДень = Истина
					И
					Выборка.ЕстьИндивидуальныйГрафик  
					И
					НЕ Выборка.СтатусЗанятостиСотрудника = Перечисления.СтатусыЗанятости.Работа
					Тогда 
					НовСтр.ВремяНачала = Неопределено;
					НовСтр.ВремяОкончания = Неопределено;
					НовСтр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Выходной;
				КонецЕсли;
				
				НужноДобавить = Истина;
				
				Для каждого Запись из ТЗ цикл
					Если Запись.Физлицо = Физлицо
						И
						Запись.Должность = Должность
						Тогда
						НовСтр.НомерСтрокиСводной = Запись.НомерСтроки;
						НужноДобавить = Ложь;
					КонецЕсли; 
				КонецЦикла;
				
				Если НужноДобавить = Истина
					Тогда
					НовСтрТЗ = ТЗ.Добавить();
					НовСтрТЗ.Физлицо = Физлицо;
					НовСтрТЗ.Должность = Должность;
					МаксНомерСтроки = МаксНомерСтроки+1;
					НовСтрТЗ.НомерСтроки = МаксНомерСтроки;
                    НовСтр.НомерСтрокиСводной = МаксНомерСтроки;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;	
		
		Для каждого Стр из ТЗ цикл
			НовСтр = Объект.АктуальныеСотрудники.Добавить();
			НовСтр.Физлицо = Стр.Физлицо;
			НовСтр.Должность = Стр.Должность; 
		КонецЦикла;	
		
		Для каждого Стр из ТЗ цикл
			НовСтр = Объект.Расписание.Добавить();
			НовСтр.Сотрудник = Стр.Физлицо;
			НовСтр.Должность = Стр.Должность; 
		КонецЦикла;	
		
	КонецЕсли;
	
	Записать();
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьПервичныеДанные1(Команда)
	ЗаполнитьПервичныеДанные();
	ОформлениеТЧ_Расписание();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокАктуальныхСотрудников()
	Объект.АктуальныеСотрудники.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.Физлицо,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.Подразделение,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.Должность
	|ИЗ
	|	Документ.РегистрацияРасписанияРаботыСотрудников.ДанныеДляРегистрацииРасписания КАК РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания
	|ГДЕ
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.Физлицо,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.Подразделение,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.Должность";
	Запрос.УстановитьПараметр("Ссылка", ОБъект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл		НовСтр = Объект.АктуальныеСотрудники.Добавить();
		НовСтр.Физлицо = Выборка.Физлицо;
		НовСтр.Должность = Выборка.Должность;
	КонецЦикла;
	
КонецПроцедуры
 
  
 &НаСервере
 Функция ПереЗаполнитьТЧРасписанияФ()	 
   М = Новый Массив;
   
   Для каждого Стр из Объект.ДанныеДляРегистрацииРасписания цикл
	   
	   ДнейРабочих = 0;
	   Если
			Стр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Работа
			Тогда
			//Текст = СокрЛП(Строка(Час(стр.ВремяНачала)) + ":" + Символы.ПС + Строка(Час(стр.ВремяОкончания)));
			//++ ск_
			Текст = Сред(Строка(стр.ВремяНачала) ,12,5) + Символы.ПС + Сред(Строка(стр.ВремяОкончания) ,12,5);
			//-- ск_
			ДнейРабочих = 1;
		ИначеЕсли
			Стр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Выходной
			Тогда
			Текст = "НР";
			
		ИначеЕсли 
			Стр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Командировка
			Тогда
			Текст = "ВД"
			
		ИначеЕсли 
			Стр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Отпуск
			Тогда
			Текст = "В"		
		ИначеЕсли 
			Стр.СтатусЗанятости = Перечисления.СтатусыЗанятости.ПрочееОтсутствие
			Тогда
			Текст = "НЗ"
		ИначеЕсли 
			Стр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Больничный
			Тогда
			Текст = "ЛН"	

		ИначеЕсли 
			Стр.СтатусЗанятости = Перечисления.СтатусыЗанятости.ОтпускНеОпл
			Тогда
			Текст = "БЗ"	
			
		КонецЕсли;

	      
	   С = новый Структура;
	   С.Вставить("НомерСтроки", Стр.НомерСтрокиСводной);
	   С.Вставить("НомерКолонки", Стр.ДеньМесяца);
	   С.Вставить("текст",Текст);
	   С.Вставить("ДнейРабочих",ДнейРабочих);
	   
	   М.Добавить(С);  
	   
	КонецЦикла;  

	Возврат М;
	
КонецФункции	 
  
&НаКлиенте
 Процедура ОформлениеТЧ_Расписание()
	
	М =  ПереЗаполнитьТЧРасписанияФ();
	
	Для каждого Стр из Объект.Расписание цикл
		Стр.ДнейРаб = 0;
	КонецЦикла;	
		
	Для каждого Стр из М цикл
		
		НомерСтроки = Неопределено;
		НомерКолонки = неопределено;
		Текст = неопределено;
	    ДнейРабочих = Неопределено;
		
		НомерСтроки = Стр.НомерСтроки;
		НомерКолонки = Стр.НомерКолонки;
		Текст = Стр.Текст; 
		ДнейРабочих = Стр.ДнейРабочих;
		Столбец = Строка("Д"+Строка(НомерКолонки));	
					
		Объект.Расписание[НомерСтроки-1][Столбец] = Текст;
		Объект.Расписание[НомерСтроки-1].ДнейРаб = число(Объект.Расписание[НомерСтроки-1].ДнейРаб) + число(ДнейРабочих);

//		Этаформа.Элементы.Расписание[НомерСтроки-1][Столбец].ЦветФона = Новый Цвет(123,234,345);
		
   КонецЦикла;  
	
	
   КонецПроцедуры

&НаКлиенте
Процедура РасписаниеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ИмяКолонки = Элементы.Расписание.ТекущийЭлемент.Имя;
	ИмяКолонкиСокр = Прав(ИмяКолонки,СтрДлина(ИмяКолонки)-11);
	НомерСтрокиСводной = число(Элементы.Расписание.ТекущиеДанные.НомерСтроки);
	
	Если 
		ИмяКолонки = "РасписаниеСотрудник"  
		ИЛИ 
		ИмяКолонки = "РасписаниеДолжность"
		ИЛИ
		ИмяКолонки = "РасписаниеНомерСтроки" 
		ИЛИ
		ИмяКолонки = "РасписаниеДнейРаб"
		Тогда  Возврат
	КонецЕсли;
	
	Адреса = новый структура;
	Адреса.Вставить("ИмяКолонки",ИмяКолонкиСокр);
	Адреса.Вставить("НомерСтрокиСводной",НомерСтрокиСводной);
	
	П = СформироватьПараметрыОткрытияФормыДетализации(Адреса);
	
	ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
	ОткрытьФорму("Документ.РегистрацияРасписанияРаботыСотрудников.Форма.ВыборРасписания",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОповещение(Результат, ДополнительныеПараметры) Экспорт
    ЭтаФорма.Прочитать();
    ОформлениеТЧ_Расписание();
КонецПроцедуры

&НаСервере
Функция СформироватьПараметрыОткрытияФормыДетализации(Адреса)
	// получили параметры поиска
	ИмяКолонки = Неопределено;
	НомерСтрокиСводной = Неопределено;
		
	Адреса.Свойство("ИмяКолонки",ИмяКолонки);
	Адреса.Свойство("НомерСтрокиСводной",НомерСтрокиСводной);
	
	// Ищем подоходящую запись
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.НомерСтроки,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.ВремяНачала,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.ВремяОкончания,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.Примечание,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.СтатусЗанятости,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.ВремяНачалаРаботыПодразделения,
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.ВремяОкончанияРаботыПодразделения
	|ИЗ
	|	Документ.РегистрацияРасписанияРаботыСотрудников.ДанныеДляРегистрацииРасписания КАК РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания
	|ГДЕ
	|	РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.Ссылка = &Ссылка
	|	И РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.НомерСтрокиСводной = &НомерСтрокиСводной
	|	И РегистрацияРасписанияРаботыСотрудниковДанныеДляРегистрацииРасписания.ДеньМесяца = &ДеньМесяца";
	Запрос.УстановитьПараметр("Ссылка", ОБъект.Ссылка);
	Запрос.УстановитьПараметр("НомерСтрокиСводной", Число(НомерСтрокиСводной));
	Запрос.УстановитьПараметр("ДеньМесяца", Число(ИмяКолонки));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		П = новый структура;
		П.Вставить("Идентификатор", Выборка.НомерСтроки);
		П.Вставить("ВремяНачала", Выборка.ВремяНачала);
        П.Вставить("ВремяОкончания", Выборка.ВремяОкончания);
		П.Вставить("ВремяНачалаРаботыПодразделения", Выборка.ВремяНачалаРаботыПодразделения);
        П.Вставить("ВремяОкончанияРаботыПодразделения", Выборка.ВремяОкончанияРаботыПодразделения);
		П.Вставить("ПояснениеНеявки", Выборка.Примечание);
        П.Вставить("СтатусЗанятости", Выборка.СтатусЗанятости);
		П.Вставить("ДокументОбъект", ОБъект.Ссылка);
		Возврат П;
	КонецЕсли;
	   
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
//	Объект.Месяц = НачалоМесяца(Объект.Дата);

КонецПроцедуры
  
&НаСервере
Функция ДнейВМесяце()
	Если Объект.Месяц > '00010101000000'
		тогда
		НачалоПериодаЗаполнения = Началомесяца(Объект.Месяц);
		КонецПериодаЗаполнения = КонецМесяца(Объект.Месяц);
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, ДЕНЬ) КАК Разница");
		Запрос.УстановитьПараметр("МеньшаяДата", НачалоПериодаЗаполнения);
		Запрос.УстановитьПараметр("БольшаяДата", КонецПериодаЗаполнения);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		Если РезультатЗапроса.Следующий() тогда 
			Разница = РезультатЗапроса.Разница+1;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьКолонокРасписания()   
	
	Д = ДнейВМесяце();
	Если Д = 28
		Тогда
		ЭтаФорма.Элементы.Расписание.ПодчиненныеЭлементы.РасписаниеД31.Видимость = Ложь;
		ЭтаФорма.Элементы.Расписание.ПодчиненныеЭлементы.РасписаниеД30.Видимость = Ложь;
		ЭтаФорма.Элементы.Расписание.ПодчиненныеЭлементы.РасписаниеД29.Видимость = Ложь; 
	ИначеЕсли Д = 29
		Тогда
		ЭтаФорма.Элементы.Расписание.ПодчиненныеЭлементы.РасписаниеД31.Видимость = Ложь;
		ЭтаФорма.Элементы.Расписание.ПодчиненныеЭлементы.РасписаниеД30.Видимость = Ложь;
	ИначеЕсли Д = 30
		Тогда
		ЭтаФорма.Элементы.Расписание.ПодчиненныеЭлементы.РасписаниеД31.Видимость = Ложь;	
	КонецЕсли;
	
	Дкон = число(день(КонецМесяца(ОБъект.Месяц)));
	
	
	Для ЧислоМесяца = 1 по Дкон
		цикл
		ДатаДня = Дата(ГОд(Объект.Месяц), месяц(Объект.Месяц), число(ЧислоМесяца));
		НомерДняНедели = ДеньНедели(ДатаДня);
		ИмяКолонки = "РасписаниеД" + строка(ЧислоМесяца);
		Если Число(НомерДняНедели) = 6 или Число(НомерДняНедели) = 7 тогда
			Элементы[ИмяКолонки].ЦветТекста = webцвета.Красный;
		Иначе
			Элементы[ИмяКолонки].ЦветТекста = webцвета.Черный;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимостьКолонокРасписания();
КонецПроцедуры

&НаСервере
Процедура ДобавитьСотрудникаНаСервере()
	
	Если ОБъект.Месяц > '00010101000000'
		
		Тогда
		// таблица добавляемых сотрудников
		ТЗ = новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("Физлицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
		ТЗ.Колонки.Добавить("Должность", Новый ОписаниеТипов("СправочникСсылка.Должности"));
		ТЗ.Очистить();
		
		//Объект.ДанныеДляРегистрацииРасписания.Очистить();
		//Объект.АктуальныеСотрудники.Очистить();    
		//Объект.Расписание.Очистить();
		
		НачалоПериодаЗаполнения = Началомесяца(Объект.Месяц);
		КонецПериодаЗаполнения = КонецМесяца(Объект.Месяц);
		
		МаксНомерСтроки = 0;
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗНОСТЬДАТ(&МеньшаяДата, &БольшаяДата, ДЕНЬ) КАК Разница");
		Запрос.УстановитьПараметр("МеньшаяДата", НачалоПериодаЗаполнения);
		Запрос.УстановитьПараметр("БольшаяДата", КонецПериодаЗаполнения);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		Если РезультатЗапроса.Следующий() тогда 
			Разница = РезультатЗапроса.Разница+1;
		КонецЕсли; 
		
		
		Для День = 1 По Разница Цикл     
			
			ДатаТабеля = НачалоПериодаЗаполнения + (День-1) * 24*60*60 + 1;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	КадроваяРасстановкаСрезПоследних.ФизическоеЛицо,
			|	КадроваяРасстановкаСрезПоследних.Должность,
			|	КадроваяРасстановкаСрезПоследних.Подразделение,
			|	КадроваяРасстановкаСрезПоследних.ЕстьИндивидуальныйГрафик
			|ПОМЕСТИТЬ вт_сбор
			|ИЗ
			|	РегистрСведений.КадроваяРасстановка.СрезПоследних(&Период, ) КАК КадроваяРасстановкаСрезПоследних
			|ГДЕ
			|	КадроваяРасстановкаСрезПоследних.Подразделение = &Подразделение
			|	И КадроваяРасстановкаСрезПоследних.Актуальность = &Актуальность
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	вт_сбор.ФизическоеЛицо,
			|	вт_сбор.Должность,
			|	вт_сбор.Подразделение,
			|	вт_сбор.ЕстьИндивидуальныйГрафик
			|ПОМЕСТИТЬ вт_сбор2
			|ИЗ
			|	вт_сбор КАК вт_сбор
			|
			|СГРУППИРОВАТЬ ПО
			|	вт_сбор.ФизическоеЛицо,
			|	вт_сбор.Должность,
			|	вт_сбор.Подразделение,
			|	вт_сбор.ЕстьИндивидуальныйГрафик
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	вт_сбор2.ФизическоеЛицо,
			|	вт_сбор2.Должность,
			|	ИндВремяРаботыСотрудников.ВремяНачала КАК ВремяНачалаРаботыСотрудника,
			|	ИндВремяРаботыСотрудников.ВремяОкончания КАК ВремяОкончанияРаботыСотрудника,
			|	вт_сбор2.Подразделение,
			|	ВремяРаботыПодразделения.РабочийДень,
			|	ИндВремяРаботыСотрудников.СтатусЗанятости КАК СтатусЗанятостиСотрудника,
			|	вт_сбор2.ЕстьИндивидуальныйГрафик,
			|	ВремяРаботыПодразделения.ВремяНачалаРаботыПодразделения,
			|	ВремяРаботыПодразделения.ВремяОкончанияРаботыПодразделения
			|ИЗ
			|	вт_сбор2 КАК вт_сбор2
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ГрафикиРаботы.ВремяНачалаРаботы КАК ВремяНачалаРаботыПодразделения,
			|			ГрафикиРаботы.ВремяОкончанияРаботы КАК ВремяОкончанияРаботыПодразделения,
			|			СтруктураПредприятия.Ссылка КАК Подразделение,
			|			ГрафикиРаботы.РабочийДень КАК РабочийДень
			|		ИЗ
			|			Справочник.СтруктураПредприятия КАК СтруктураПредприятия
			|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыГрафиковРаботы КАК ВидыГрафиковРаботы
			|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиРаботы КАК ГрафикиРаботы
			|					ПО ВидыГрафиковРаботы.Ссылка = ГрафикиРаботы.ВидГрафика
			|				ПО СтруктураПредприятия.ГрафикРаботыПодразделения = ВидыГрафиковРаботы.Ссылка
			|		ГДЕ
			|			ГрафикиРаботы.Период = &Период) КАК ВремяРаботыПодразделения
			|		ПО вт_сбор2.Подразделение = ВремяРаботыПодразделения.Подразделение
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.ВремяНачала КАК ВремяНачала,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.ВремяОкончания КАК ВремяОкончания,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.Подразделение КАК Подразделение,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.Должность КАК Должность,
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.СтатусЗанятости КАК СтатусЗанятости
			|		ИЗ
			|			РегистрСведений.ИндивидуальныеГрафикиРаботыСотрудников.СрезПоследних(&Период, ) КАК ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних
			|		ГДЕ
			|			ИндивидуальныеГрафикиРаботыСотрудниковСрезПоследних.ДеньНедели = &ДеньНедели) КАК ИндВремяРаботыСотрудников
			|		ПО вт_сбор2.Подразделение = ИндВремяРаботыСотрудников.Подразделение
			|			И вт_сбор2.ФизическоеЛицо = ИндВремяРаботыСотрудников.ФизическоеЛицо
			|			И вт_сбор2.Должность = ИндВремяРаботыСотрудников.Должность
			|ГДЕ
			|	вт_сбор2.Подразделение = &Подразделение";
			Запрос.УстановитьПараметр("Подразделение",ОБъект.Подразделение);
			Запрос.УстановитьПараметр("Актуальность",Перечисления.СтатусыСотрудников.Актуальний);
			Запрос.УстановитьПараметр("Период",ДатаТабеля);   
			Запрос.УстановитьПараметр("ДеньНедели",ДеньНедели(ДатаТабеля)); 
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Физлицо = Выборка.ФизическоеЛицо;
				Должность = Выборка.Должность;
				
				// проверим есть ли такое физлицо, должность
				// таблица Акту сотрудники
				
				РанееВнесенный = Ложь;
				Для каждого Запись из ОБъект.АктуальныеСотрудники цикл
					Если Запись.Физлицо = Физлицо
						И
						Запись.Должность = Должность
						Тогда
						РанееВнесенный = Истина;
					КонецЕсли; 
				КонецЦикла;
				
				Если НЕ РанееВнесенный = Истина
					Тогда
					НовСтрСотр = ОБъект.АктуальныеСотрудники.Добавить();
					НовСтрСотр.Физлицо = Физлицо;
					НовСтрСотр.Должность = Должность;
					
					Инд = Объект.АктуальныеСотрудники.Индекс(НовСтрСотр);
					
					НовСтрТЗ = ТЗ.Добавить();
					НовСтрТЗ.Физлицо = Физлицо;
					НовСтрТЗ.Должность = Должность;
					НовСтрТЗ.НомерСтроки = Инд+1;
					
				КонецЕсли;
				
				
				Для каждого Запись из ТЗ цикл
					Если Запись.Физлицо = Физлицо
						И
						Запись.Должность = Должность
						Тогда
						
						НовСтр = Объект.ДанныеДляРегистрацииРасписания.Добавить();
						НовСтр.НомерСтрокиСводной  = Запись.НомерСтроки;
						
						НовСтр.Дата = ДатаТабеля;
						НовСтр.ДеньМесяца = День(ДатаТабеля);
						
						НовСтр.ВремяНачалаРаботыПодразделения = Выборка.ВремяНачалаРаботыПодразделения;
						НовСтр.ВремяОкончанияРаботыПодразделения  = Выборка.ВремяОкончанияРаботыПодразделения;
						
						НовСтр.Физлицо  = Физлицо;
						НовСтр.Подразделение = Выборка.Подразделение;
						
						
						НовСтр.Должность = Должность;
						
						НовСтр.ДеньНедели = ДеньНедели(ДатаТабеля);
						
						Если 
							Выборка.РабочийДень = Ложь
							Тогда
							НовСтр.ВремяНачала = Неопределено;
							НовСтр.ВремяОкончания = Неопределено;
							НовСтр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Выходной;
							
						ИначеЕсли
							Выборка.РабочийДень = Истина
							И
							НЕ Выборка.ЕстьИндивидуальныйГрафик  
							Тогда 
							НовСтр.ВремяНачала = Выборка.ВремяНачалаРаботыПодразделения;
							НовСтр.ВремяОкончания = Выборка.ВремяОкончанияРаботыПодразделения;
							НовСтр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Работа
							
						ИначеЕсли 
							Выборка.РабочийДень = Истина
							И
							Выборка.ЕстьИндивидуальныйГрафик  
							И
							Выборка.СтатусЗанятостиСотрудника = Перечисления.СтатусыЗанятости.Работа
							Тогда 
							НовСтр.ВремяНачала = макс(Выборка.ВремяНачалаРаботыПодразделения,Выборка.ВремяНачалаРаботыСотрудника);
							НовСтр.ВремяОкончания = мин(Выборка.ВремяОкончанияРаботыПодразделения, Выборка.ВремяОкончанияРаботыСотрудника);
							НовСтр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Работа;
						ИначеЕсли 
							Выборка.РабочийДень = Истина
							И
							Выборка.ЕстьИндивидуальныйГрафик  
							И
							НЕ Выборка.СтатусЗанятостиСотрудника = Перечисления.СтатусыЗанятости.Работа
							Тогда 
							НовСтр.ВремяНачала = Неопределено;
							НовСтр.ВремяОкончания = Неопределено;
							НовСтр.СтатусЗанятости = Перечисления.СтатусыЗанятости.Выходной;
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;	
			
			//Для каждого Стр из ТЗ цикл
			//	НовСтр = Объект.АктуальныеСотрудники.Добавить();
			//	НовСтр.Физлицо = Стр.Физлицо;
			//	НовСтр.Должность = Стр.Должность; 
			//КонецЦикла;	
			
		КонецЦикла;
		
		Для каждого Стр из ТЗ цикл
			НовСтр = Объект.Расписание.Добавить();
			НовСтр.Сотрудник = Стр.Физлицо;
			НовСтр.Должность = Стр.Должность; 
		КонецЦикла;	

		
		
		
		
		КонецЕсли;
		
       	
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСотрудника(Команда)
	ДобавитьСотрудникаНаСервере();  
   	//ЭтаФорма.Прочитать();
    ОформлениеТЧ_Расписание();
КонецПроцедуры

&НаСервере
Процедура УдалитьСотрудникаНаСервере(С)
	Физлицо = Неопределено;
	Должность = неопределено;
    С.Свойство("Сотрудник", Физлицо);
	С.Свойство("Должность", Должность);
	
	Колич = ОБъект.ДанныеДляРегистрацииРасписания.Количество() - 1;
	
	Для  Инд = 0 по Колич цикл
		
		Строка = Колич - Инд;
		
		Если 
		Объект.ДанныеДляРегистрацииРасписания[Строка].Физлицо = Физлицо
		И 
		Объект.ДанныеДляРегистрацииРасписания[Строка].Должность = Должность
		Тогда
		Объект.ДанныеДляРегистрацииРасписания.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из ОБъект.АктуальныеСотрудники цикл
		Если 
			Стр.Физлицо = Физлицо
			И
			Стр.Должность = Должность
			Тогда
			Объект.АктуальныеСотрудники.Удалить(СТр.НомерСТроки - 1);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из ОБъект.Расписание цикл
		Если 
			Стр.Сотрудник = Физлицо
			И
			Стр.Должность = Должность
			Тогда
			Объект.Расписание.Удалить(СТр.НомерСТроки - 1);
		КонецЕсли;
	КонецЦикла;
     	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСотрудника(Команда)
	ТекСтрока = Элементы.Расписание.ТекущиеДанные;
	Если НЕ ТекСтрока = Неопределено
		Тогда
		Сотрудник = ТекСтрока.Сотрудник;
		Должность = ТекСтрока.Должность;
		С = Новый Структура;
		С.Вставить("Сотрудник", Сотрудник);
		С.Вставить("Должность", Должность);
		
		УдалитьСотрудникаНаСервере(С); 
		//		ЭтаФорма.Прочитать();
		//    ОформлениеТЧ_Расписание();
	КонецЕсли;
КонецПроцедуры

