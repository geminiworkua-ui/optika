&НаСервере
Процедура СортироватьНаСервере()
	
	Если Элементы.Расписание.ТекущийЭлемент.Имя = "РасписаниеСотрудник" Тогда
		ТаблицаРасписание = Объект.Расписание.Выгрузить();
		ТаблицаРасписание.Сортировать("Сотрудник Возр");
		Объект.Расписание.Загрузить(ТаблицаРасписание);
		ТаблицаРасписание.Очистить();
	ИначеЕсли Элементы.Расписание.ТекущийЭлемент.Имя = "РасписаниеДолжность" Тогда
		ТаблицаРасписание = Объект.Расписание.Выгрузить();
		ТаблицаРасписание.Сортировать("Должность Возр");
		Объект.Расписание.Загрузить(ТаблицаРасписание);
		ТаблицаРасписание.Очистить();
	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура СортироватьПоВозрастанию(Команда)
	
	СортироватьНаСервере(); 
	
КонецПроцедуры

&НаСервере
Процедура СортироватьПоУбываниюНаСервере()
	
	Если Элементы.Расписание.ТекущийЭлемент.Имя = "РасписаниеСотрудник" Тогда
		ТаблицаРасписание = Объект.Расписание.Выгрузить();
		ТаблицаРасписание.Сортировать("Сотрудник Убыв");
		Объект.Расписание.Загрузить(ТаблицаРасписание);
		ТаблицаРасписание.Очистить();
	ИначеЕсли Элементы.Расписание.ТекущийЭлемент.Имя = "РасписаниеДолжность" Тогда
		ТаблицаРасписание = Объект.Расписание.Выгрузить();
		ТаблицаРасписание.Сортировать("Должность Убыв");
		Объект.Расписание.Загрузить(ТаблицаРасписание); 
		ТаблицаРасписание.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СортироватьПоУбыванию(Команда)
	
	СортироватьПоУбываниюНаСервере();
	
КонецПроцедуры
