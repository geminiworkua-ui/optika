Процедура Печать(ТабДок, Ссылка) Экспорт
	
	Макет = Документы.РегистрацияРасписанияРаботыСотрудников.ПолучитьМакет("РасписаниеРаботыСотрудников");	
	
	ТабДок = Новый ТабличныйДокумент;
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Документ = Строка(Ссылка[0]);
	Область.Параметры.Месяц = Формат(Ссылка[0].Дата, "ДФ='MММM yyy'");
	Область.Параметры.Подразделение = Ссылка[0].Подразделение;
	ТабДок.Вывести(Область);
	
	////////////////////////////////////////////////////////////////
	ОбластьШапка = Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	//Для День = 1 По 31 Цикл
	//	ОбластьШапка.Параметры["День" + День] = День;
	//КонецЦикла;
	
	ТабДок.Вывести(ОбластьШапка);
	
	//////////////////////////////////////////////////////////////////
	Номер = 1;
	
	Для Каждого Стр Из Ссылка[0].Расписание Цикл
		
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаСотрудника");
		
		ОбластьСтрока.Параметры.Номер = Номер;
		ОбластьСтрока.Параметры.Сотрудник = Стр.Сотрудник;
		ОбластьСтрока.Параметры.Должность = Стр.Должность;
		
		Для День = 1 По 31 Цикл
			
			//ЗначениеДня = ПолучитьЗначениеДня(Стр, День);
			
			ОбластьСтрока.Параметры["Д" + День] = ПолучитьЗначениеДня(Стр, День);
			
		КонецЦикла;
		
		ОбластьСтрока.Параметры.ДнейРаб = Стр.ДнейРаб;
		
		ТабДок.Вывести(ОбластьСтрока);
		
		Номер = Номер + 1;
		
	КонецЦикла;
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.Комментарий = Ссылка[0].Комментарий;
	ОбластьПодвал.Параметры.Автор = Ссылка[0].Автор;
	ТабДок.Вывести(ОбластьПодвал);
	
КонецПроцедуры 

Функция ПолучитьЗначениеДня(СтрРасписания, День) Экспорт
	
	// День: 1..31
	ИмяПоля = "Д" + День;

	//// Если такого поля нет
	//Если Не СтрРасписания.Свойство(ИмяПоля) Тогда
	//	Возврат "";
	//КонецЕсли;

	ЗначениеДня = СтрРасписания[ИмяПоля];

	Если Не ЗначениеЗаполнено(ЗначениеДня) Тогда
		Возврат "Х";
	КонецЕсли;

	// Нерабочий
	Если НРег(ЗначениеДня) = "нр" Тогда
		Возврат "нр";
	КонецЕсли;

	// Время вида 10:00-19:00 или 10:00 19:00
	Если СтрНайти(ЗначениеДня, "-") > 0 Тогда
		Части = СтрРазделить(ЗначениеДня, "-");
	Иначе
		Части = СтрРазделить(ЗначениеДня, " ");
	КонецЕсли;

	Если Части.Количество() = 2 Тогда
		Возврат Части[0] + Символы.ПС + Части[1];
	КонецЕсли;

	// На всякий случай
	Возврат ЗначениеДня;

КонецФункции

