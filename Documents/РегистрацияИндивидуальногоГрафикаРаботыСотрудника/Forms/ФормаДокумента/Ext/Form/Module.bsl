
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка)
		Тогда 
		Объект.Идентиф = Параметры.Идент;  
		Объект.Дата = Параметры.Дата;	
		Объект.ДокументОснование = Параметры.Основание;
		Объект.ФизическоеЛицо = Параметры.ФизическоеЛицо;
		Объект.Подразделение = Параметры.НовоеПодразделение;
		Объект.Должность = Параметры.НоваяДолжность;
        
		ПервичноеЗаполнениеСтрокТЧ()
		
	Иначеесли 
		Параметры.Свойство("ФизическоеЛицо")
		ТОгда
		//Объект.Идентиф = Параметры.Идент;  
		Объект.Дата = Параметры.Дата;	
		//Объект.ДокументОснование = Параметры.Основание;
		Объект.ФизическоеЛицо = Параметры.ФизическоеЛицо;
		Объект.Подразделение = Параметры.НовоеПодразделение;
		Объект.Должность = Параметры.НоваяДолжность;
		
	КонецЕсли;
	
КонецПроцедуры
 
&НаСервере
Процедура ПервичноеЗаполнениеСтрокТЧ()
	Для Сч = 1 По 7 Цикл
			НовСтр = ОБъект.Расписание.Добавить();  
		НовСтр.ДеньНедели = Сч;     
		
	КонецЦикла
		      
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()



КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Для каждого Стр из Объект.Расписание цикл
		
		Сч = Стр.ДеньНедели;
		Если      	Сч = 1 Тогда Т = "ru = 'Пн'; uk = 'Пн'";
        ИначеЕсли  	Сч = 2 Тогда Т = "ru = 'Вт'; uk = 'Вт'";
        ИначеЕсли  	Сч = 3 Тогда Т = "ru = 'Ср'; uk = 'Ср'";
        ИначеЕсли  	Сч = 4 Тогда Т = "ru = 'Чт'; uk = 'Чт'";
        ИначеЕсли  	Сч = 5 Тогда Т = "ru = 'Пт'; uk = 'Пт'";
        ИначеЕсли  	Сч = 6 Тогда Т = "ru = 'Сб'; uk = 'Сб'";
        ИначеЕсли  	Сч = 7 Тогда Т = "ru = 'Вс'; uk = 'Нд'";
		КонецЕсли;
		
		Стр.ДеньНеделиПрописью = Нстр(Т);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыСотрудника();

	ФизическоеЛицо  = неопределено;
	НоваяДолжность   = неопределено;
	НовоеПодразделение  = неопределено;
		
	Пар = ПараметрыСотрудникаНаСервере();
	Пар.Свойство("ФизическоеЛицо", ФизическоеЛицо);
	Пар.Свойство("НоваяДолжность", НоваяДолжность);
	Пар.Свойство("НовоеПодразделение", НовоеПодразделение); 
	 
	ЭтаФорма.Физлицо = ФизическоеЛицо;
	ЭтаФорма.Должность = НоваяДолжность;
	ЭтаФорма.Подразделение = НовоеПодразделение;
	 
	
 КонецПроцедуры
 
&НаСервере
Функция ПараметрыСотрудникаНаСервере()

	
	 Запрос = Новый Запрос("ВЫБРАТЬ
	 |	КадровоеДвижениеКадровыеДвижения.ФизическоеЛицо,
	 |	КадровоеДвижениеКадровыеДвижения.НоваяДолжность,
	 |	КадровоеДвижениеКадровыеДвижения.НовоеПодразделение
	 |ИЗ
	 |	Документ.КадровоеДвижение.КадровыеДвижения КАК КадровоеДвижениеКадровыеДвижения
	 |ГДЕ
	 |	КадровоеДвижениеКадровыеДвижения.Ссылка = &Ссылка
	 |	И КадровоеДвижениеКадровыеДвижения.НомерСтроки = &НомерСтроки");
	 Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
	 Запрос.УстановитьПараметр("НомерСтроки", Объект.Идентиф);
	 Выборка = Запрос.Выполнить().Выбрать();
	 Если Выборка.Следующий() Тогда
		 П = Новый Структура;
		 П.Вставить("ФизическоеЛицо", Выборка.ФизическоеЛицо);
		 П.Вставить("НоваяДолжность", Выборка.НоваяДолжность);
		 П.Вставить("НовоеПодразделение", Выборка.НовоеПодразделение);
		 Возврат П;
	 
	 КонецЕсли;  	 
	 
	 КонецФункции
