
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ИндивидуальныеГрафикиРаботыСотрудников.Записывать = Истина;
	Для Каждого ТекСтрокаРасписание Из Расписание Цикл
		Движение = Движения.ИндивидуальныеГрафикиРаботыСотрудников.Добавить();
		Движение.Период = Дата;
		Движение.ФизическоеЛицо = ФизическоеЛицо;
		Движение.Подразделение = Подразделение;
		Движение.Должность = Должность;
		Движение.ДеньНедели = ТекСтрокаРасписание.ДеньНедели;
		Движение.ВремяНачала = ТекСтрокаРасписание.ВремяНачала;
		Движение.ВремяОкончания = ТекСтрокаРасписание.ВремяОкончания;
		
		Если ТекСтрокаРасписание.ВремяНачала > '00010101000000'
			 И
			 ТекСтрокаРасписание.ВремяОкончания > '00010101000000'
        Тогда 
             Движение.СтатусЗанятости = Перечисления.СтатусыЗанятости.Работа;
		Иначе
			 Движение.СтатусЗанятости = Перечисления.СтатусыЗанятости.Выходной;
		КонецЕсли;
		
	КонецЦикла;
	 
	 ДокументОбъект = Ссылка.ДокументОснование.ПолучитьОбъект();
	 ДокументОбъект.КадровыеДвижения[число(Ссылка.Идентиф)].УстановкаИндивидуальногоГрафикаРаботы = Ссылка;
     ДокументОбъект.КадровыеДвижения[число(Ссылка.Идентиф)].ЕстьИндГрафик = Истина;	 
     ДокументОбъект.Записать();
	 
 КонецПроцедуры	     
 
Процедура ОбработкаУдаленияПроведения(Отказ)

	 ДокументОбъект = Ссылка.ДокументОснование.ПолучитьОбъект();
	 ДокументОбъект.КадровыеДвижения[Ссылка.Идентиф].УстановкаИндивидуальногоГрафикаРаботы = неопределено;
	 ДокументОбъект.КадровыеДвижения[Ссылка.Идентиф].ЕстьИндГрафик = Ложь;	 		 
     ДокументОбъект.Записать();
	  
   КонецПроцедуры	  