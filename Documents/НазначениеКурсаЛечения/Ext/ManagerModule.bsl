
Процедура Печать(ТабДок, Ссылка) Экспорт
	//{{_КОНСТРУКТОР_ПЕЧАТИ(Печать)
	Макет = Документы.НазначениеКурсаЛечения.ПолучитьМакет("Печать");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НазначениеКурсаЛечения.Дата,
	|	НазначениеКурсаЛечения.ДиагнозOD,
	|	НазначениеКурсаЛечения.ДиагнозOS,
	|	НазначениеКурсаЛечения.ДлительностьКурса,
	|	НазначениеКурсаЛечения.Комментарий,
	|	НазначениеКурсаЛечения.Номер,
	|	НазначениеКурсаЛечения.ОстротаЗренияODcкДоЛечения,
	|	НазначениеКурсаЛечения.ОстротаЗренияODcкПослеЛечения,
	|	НазначениеКурсаЛечения.ОстротаЗренияODбкДоЛечения,
	|	НазначениеКурсаЛечения.ОстротаЗренияODбкПослеЛечения,
	|	НазначениеКурсаЛечения.ОстротаЗренияOScкДоЛечения,
	|	НазначениеКурсаЛечения.ОстротаЗренияOScкПослеЛечения,
	|	НазначениеКурсаЛечения.ОстротаЗренияOSбкДоЛечения,
	|	НазначениеКурсаЛечения.ОстротаЗренияOSбкПослеЛечения,
	|	НазначениеКурсаЛечения.Пациент,
	|	НазначениеКурсаЛечения.Подразделение,
	|	НазначениеКурсаЛечения.ПрименениеДляГлаз,
	|	НазначениеКурсаЛечения.РасписаниеКурсаЛечений.(
	|		НомерСтроки,
	|		Дата,
	|		Выполнено,
	|		КоличествоПроцедур
	|	),
	|	НазначениеКурсаЛечения.НазначениеЛечебныхПроцедур.(
	|		НомерСтроки,
	|		ЛечебнаяПроцедура,
	|		ПрименениеДляГлаз
	|	)
	|ИЗ
	|	Документ.НазначениеКурсаЛечения КАК НазначениеКурсаЛечения
	|ГДЕ
	|	НазначениеКурсаЛечения.Ссылка В (&Ссылка)";
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьРасписаниеКурсаЛеченийШапка = Макет.ПолучитьОбласть("РасписаниеКурсаЛеченийШапка");
	ОбластьРасписаниеКурсаЛечений = Макет.ПолучитьОбласть("РасписаниеКурсаЛечений");
	ОбластьНазначениеЛечебныхПроцедурШапка = Макет.ПолучитьОбласть("НазначениеЛечебныхПроцедурШапка");
	ОбластьНазначениеЛечебныхПроцедур = Макет.ПолучитьОбласть("НазначениеЛечебныхПроцедур");
	Подвал = Макет.ПолучитьОбласть("Подвал");

	ТабДок.Очистить();

	ВставлятьРазделительСтраниц = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		ТабДок.Вывести(ОбластьЗаголовок);

		Шапка.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Шапка, Выборка.Уровень());

		ТабДок.Вывести(ОбластьНазначениеЛечебныхПроцедурШапка);
		ВыборкаНазначениеЛечебныхПроцедур = Выборка.НазначениеЛечебныхПроцедур.Выбрать();
		Пока ВыборкаНазначениеЛечебныхПроцедур.Следующий() Цикл
			ОбластьНазначениеЛечебныхПроцедур.Параметры.Заполнить(ВыборкаНазначениеЛечебныхПроцедур);
			ТабДок.Вывести(ОбластьНазначениеЛечебныхПроцедур, ВыборкаНазначениеЛечебныхПроцедур.Уровень());
		КонецЦикла;
		
		ТабДок.Вывести(ОбластьРасписаниеКурсаЛеченийШапка);
		ВыборкаРасписаниеКурсаЛечений = Выборка.РасписаниеКурсаЛечений.Выбрать();
		Пока ВыборкаРасписаниеКурсаЛечений.Следующий() Цикл
			ОбластьРасписаниеКурсаЛечений.Параметры.Заполнить(ВыборкаРасписаниеКурсаЛечений);
			ТабДок.Вывести(ОбластьРасписаниеКурсаЛечений, ВыборкаРасписаниеКурсаЛечений.Уровень());
		КонецЦикла;


		Подвал.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Подвал);

		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;
	//}}
КонецПроцедуры
