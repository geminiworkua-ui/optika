КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДляГлаз()

	Если Объект.ПрименениеДляГлаз = Перечисления.ПрименениеДляГлаз.OU
		Тогда
		ЭтаФорма.Элементы.ДиагнозOD.Видимость = Истина;
		ЭтаФорма.Элементы.ДиагнозOS.Видимость = Истина; 
		
	ИначеЕсли
		Объект.ПрименениеДляГлаз = Перечисления.ПрименениеДляГлаз.OD
         		Тогда
		ЭтаФорма.Элементы.ДиагнозOD.Видимость = Истина;
		ЭтаФорма.Элементы.ДиагнозOS.Видимость = Ложь; 

   	ИначеЕсли
		Объект.ПрименениеДляГлаз = Перечисления.ПрименениеДляГлаз.OS
         		Тогда
		ЭтаФорма.Элементы.ДиагнозOD.Видимость = Ложь;
		ЭтаФорма.Элементы.ДиагнозOS.Видимость = Истина;   
	ИНаче
		ЭтаФорма.Элементы.ДиагнозOD.Видимость = Ложь;
		ЭтаФорма.Элементы.ДиагнозOS.Видимость = Ложь;  

	КонецЕсли;
	
	
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Пациент") Тогда
		Объект.Пациент = Параметры.Пациент;  
	КонецЕсли;
    
	Если Параметры.Свойство("Подразделение") Тогда
		Объект.Подразделение = Параметры.Подразделение;  
	КонецЕсли;
    
	
	УстановитьВидимостьДляГлаз();
	
		
	Если НЕ ЗначениеЗаполнено(ОБъект.Ссылка)
		Тогда
		 Объект.Исполнитель = ПользователиКлиентСервер.ТекущийПользователь();
    КонецЕсли
	
	
	
КонецПроцедуры



