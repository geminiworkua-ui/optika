        Т = Новый ТаблицаЗначений;
		Т = объект.НазначениеЛечебныхПроцедур.Выгрузить();
	    Возврат Т;
КонецФункции

&НаКлиенте
Процедура ВыполнитьПроцедуру(Команда)
	
	КолСтр = ОБъект.НазначениеЛечебныхПроцедур.Количество();
    ДлительностьКурса = ДлительностьКурсаНаСервере();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Текст = "ru = 'Документ ""Назначение курса лечения"" не записан. Для фиксации процедуры необходимо записать документ.'; uk = 'Документ ""Призначення курсу лікування"" не записаний. Для фіксації процедури необхідно записати документ.'";
		Сообщить(Нстр(Текст),);
		
	ИначеЕсли КолСтр < 1 Тогда
		Текст = "ru = 'Не выбрано ни одной лечебной процедуры.'; uk = 'Не обрано жодної лікарняної процедури. '";
		Сообщить(Нстр(Текст),);
		
	ИначеЕсли НомерНовойПроцедуры() = Неопределено Тогда 
		Текст = "ru = 'Курс лечебных процедур выполнен.'; uk = 'Курс лікарняних процедур виконано.'";
		Сообщить(Нстр(Текст),);
		
	Иначе
		ТекНомер = НомерНовойПроцедуры();
		П = Новый Структура;
		П.Вставить("НомерПроцедуры",ТекНомер);
		П.Вставить("Пациент", объект.Пациент);
		П.Вставить("КурсЛечения", Объект.Ссылка);
		П.Вставить("Подразделение", Объект.Подразделение);
		ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
		ОткрытьФорму("Документ.ВыполнениеПроцедуры.ФормаОбъекта", П,,,,,ОписаниеОповещения,);  
	КонецЕсли;
		
КонецПроцедуры

