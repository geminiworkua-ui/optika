
&НаСервере
Процедура ДлительностьКурсаПриИзмененииНаСервере()

	// поссчитаем сколько выполнено по курсу
	
	Колич = 0;
	Для каждого Стр из Объект.РасписаниеКурсаЛечений цикл
		Если ЗначениеЗаполнено(Стр.Выполнено) тогда
			Колич = Колич +1;
		КонецЕсли;
	КонецЦикла;
	ВыполненоПоКурсу = Колич;
	КоличествоУстановлено = ОБъект.РасписаниеКурсаЛечений.Количество();
	
	
	Если Объект.ДлительностьКурса < ВыполненоПоКурсу
		Тогда
		Текст = "ru = 'Принять изменение количества процедур по курсу нельзя, т.к. уже есть проведенные процедуры.'; uk = 'Неможливо прийняти кілкість процедур, тому що вже є виконані процедури за даним курсом.'";
		Сообщить(Нстр(Текст),);
		Объект.ДлительностьКурса = окр(ВыполненоПоКурсу/5,0,РежимОкругления.Окр15как20)*5;
		
		
		
	ИначеЕсли Объект.ДлительностьКурса > ВыполненоПоКурсу	
		      И
			  Объект.ДлительностьКурса >  КоличествоУстановлено
		тогда
		НужноДобавить = Объект.ДлительностьКурса - КоличествоУстановлено;
		Сч = 1;
		Пока Сч <= НужноДобавить цикл
			НовСтр = Объект.РасписаниеКурсаЛечений.Добавить();
			НовСтр.Дата = Неопределено;
			НовСтр.Выполнено = Неопределено;
			Сч = Сч +1;
		КонецЦикла;
		
		Текст1 = "ru = 'В расписание добавлено '; uk = 'До розкладу додано '";
		Текст2 = "ru = ' Процедур'; uk = ' Процедур'"; 
		Текст = Нстр(Текст1) + НужноДобавить + Нстр(Текст2);
		Сообщить(Текст,);
		
	ИначеЕсли Объект.ДлительностьКурса > ВыполненоПоКурсу	
		      И
			  НЕ Объект.ДлительностьКурса > КоличествоУстановлено   
			  И
			  КоличествоУстановлено > Объект.ДлительностьКурса
		тогда
		НужноУдалить = КоличествоУстановлено - Объект.ДлительностьКурса;
		Сч = 1;
				
		Пока Сч <= НужноУдалить цикл
			Инд = КоличествоУстановлено - Сч;
			Объект.РасписаниеКурсаЛечений.Удалить(Инд);
			Сч = Сч +1;
		КонецЦикла;
		
		Текст1 = "ru = 'В расписание удалено '; uk = 'З розкладу видалено '";
		Текст2 = "ru = ' Процедур'; uk = ' Процедур'"; 
		Текст = Нстр(Текст1) + НужноУдалить + Нстр(Текст2) ;
		Сообщить(Текст,);
		
	  КонецЕсли;
	  
	  
КонецПроцедуры

