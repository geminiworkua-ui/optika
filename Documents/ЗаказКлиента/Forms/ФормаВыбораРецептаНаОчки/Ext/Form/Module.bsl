

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗакрыть(Команда)
	
	П = Новый Структура;
	П.Вставить("Карточка",ВыборКарточки);
	ЭтаФорма.Закрыть(П);	
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("Пациент", Параметры.Пациент);
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ТекСтр = Элементы.Список.ТекущиеДанные;
	Если НЕ ТекСтр = неопределено
		Тогда
		ВыборКарточки = ТекСтр.Карточка;
	КонецЕсли;

КонецПроцедуры

