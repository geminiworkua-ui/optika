&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	П = Новый Структура("Стр");
	П.Стр = ЭтаФорма.ПолеПоиска;
	Объект.Клиент = ОтборТелефон1ПриИзмененииНаСервере(П);
		
КонецПроцедуры

&НаКлиенте
Процедура ОтборОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Набор = НайтиПоТелефону(ВыбранноеЗначение);
	Если Набор.количество()>0 Тогда
		ОтборКонтрагент = Набор[0];
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтборАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	МассивЗначений = СписокТелефонов(Текст);
	Если Не МассивЗначений.количество()=0 Тогда
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(МассивЗначений);
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	

КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокТелефонов(Телефон)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|	ПартнерыКонтактнаяИнформация.Представление
	|ПОМЕСТИТЬ вт_Подбор
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
	|ГДЕ
	|	ПартнерыКонтактнаяИнформация.Представление ПОДОБНО &НомерТелефона
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 10
	|	Партнеры.НаименованиеПолное
	|ИЗ
	|	Справочник.Партнеры КАК Партнеры
	|ГДЕ
	|	Партнеры.НаименованиеПолное ПОДОБНО &НомерТелефона
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 10
	|	вт_Подбор.Представление
	|ИЗ
	|	вт_Подбор КАК вт_Подбор");
	Запрос.УстановитьПараметр("НомерТелефона", "%"+Телефон + "%");
Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Представление");
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоТелефону(Телефон)

	СтрокаПоиска = "%" +Телефон+"%";
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|	ПартнерыКонтактнаяИнформация.Ссылка
	|ПОМЕСТИТЬ вт_Подбор
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
	|ГДЕ
	|	ПартнерыКонтактнаяИнформация.Представление ПОДОБНО &НомерТелефона
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 10
	|	Партнеры.Ссылка
	|ИЗ
	|	Справочник.Партнеры КАК Партнеры
	|ГДЕ
	|	Партнеры.НаименованиеПолное ПОДОБНО &НомерТелефона
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 10
	|	вт_Подбор.Ссылка
	|ИЗ
	|	вт_Подбор КАК вт_Подбор");
	Запрос.УстановитьПараметр("НомерТелефона", СтрокаПоиска);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

&НаСервере
Функция ОтборТелефон1ПриИзмененииНаСервере(П)
	СтрокаПоиска = Неопределено;
	П.Свойство("Стр",СтрокаПоиска); 
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПартнерыКонтактнаяИнформация.Ссылка
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
	|ГДЕ
	|	ПартнерыКонтактнаяИнформация.Представление ПОДОБНО &НомерТелефона
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Партнеры.Ссылка
	|ИЗ
	|	Справочник.Партнеры КАК Партнеры
	|ГДЕ
	|	Партнеры.НаименованиеПолное ПОДОБНО &НомерТелефона");
	Запрос.УстановитьПараметр("НомерТелефона", СтрокаПоиска);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		Возврат  Выборка.ссылка;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ОтборТелефон1ПриИзменении(Элемент)
	
	П = Новый Структура("Стр");
	П.Стр = ЭтаФорма.ОтборТелефон;
	Объект.Партнер = ОтборТелефон1ПриИзмененииНаСервере(П);
	
    	
КонецПроцедуры

&НаСервере
Функция ПартнерПриИзмененииНаСервере(П)
