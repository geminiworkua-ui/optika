
&НаКлиенте
Процедура ПриЗакрытии()
	ОтменитьБлокировкуНаСервере(); 
	Оповестить("Запись_РасписаниеПриемаВрача",,);
	
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка)
		Тогда 
		Объект.НомерСтрокиРегистратораРасписания = Параметры.НомСтр;  
		Объект.РегистраторРасписания = Параметры.Основание;
		Объект.ВремяНачала = Параметры.ВремяНачала;	
		ОБъект.ВремяОкончания = Параметры.ВремяОкончания;
		Объект.Сотрудник = Параметры.ФизическоеЛицо;
		Объект.Подразделение = Параметры.Подразделение;
		Объект.Должность = Параметры.Должность;
		Объект.Автор = ПользователиКлиентСервер.ТекущийПользователь();
		
		если Параметры.Свойство("Клиент") 
			И  ЗначениеЗаполнено(Параметры.Клиент) 
			И 
			НЕ Параметры.Клиент = Справочники.Партнеры.РозничныйПокупатель
			Тогда
			ОБъект.Клиент = Параметры.Клиент;
		КонецЕсли;
		
		ЭтаФорма.ВызовИзЧекаККМ = Параметры.ВызовИзЧекаККМ;
		
		
		// Проверим что на данное время нет случайно сформированного другого документа записи
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасписаниеПриемаВрача.ЗаписьНаПрием
		|ИЗ
		|	РегистрСведений.РасписаниеПриемаВрача КАК РасписаниеПриемаВрача
		|ГДЕ
		|	РасписаниеПриемаВрача.Врач = &Врач
		|	И РасписаниеПриемаВрача.МестоПриема = &МестоПриема
		|	И РасписаниеПриемаВрача.Должность = &Должность
		|	И РасписаниеПриемаВрача.ВремяНачалаПриема = &ВремяНачалаПриема
		|	И РасписаниеПриемаВрача.ЕстьЗапись";
		
		Запрос.УстановитьПараметр("Врач", Объект.Сотрудник);
		Запрос.УстановитьПараметр("ВремяНачалаПриема", Объект.ВремяНачала);
		Запрос.УстановитьПараметр("Должность", Объект.Должность);
		Запрос.УстановитьПараметр("МестоПриема", ОБъект.Подразделение);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Сообщить("На обраний час вже здійснено запис. Радимо обрати інший час для запису.");	
			ЭтаФорма.НадоЗакрывать = Истина;
			Возврат;
		КонецЕсли;	
		
		
	КонецЕсли; 
	
	// проверим, что на данноек время нет действующей брони
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БроньЗаписиКВрачу.ВремяНачала КАК ВремяНачала,
	|	БроньЗаписиКВрачу.Врач КАК Врач,
	|	БроньЗаписиКВрачу.МестоПриема КАК МестоПриема,
	|	БроньЗаписиКВрачу.Должность КАК Должность,
	|	БроньЗаписиКВрачу.Услуга КАК Услуга,
	|	ИСТИНА КАК ЕстьБронь
	|ИЗ
	|	РегистрСведений.БроньЗаписиКВрачу КАК БроньЗаписиКВрачу
	|ГДЕ
	|	ВЫБОР
	|			КОГДА БроньЗаписиКВрачу.ВремяБронирования >= &ТекущееВремя
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И БроньЗаписиКВрачу.ВремяНачала = &ВремяНачала
	|	И БроньЗаписиКВрачу.Врач = &Врач
	|	И БроньЗаписиКВрачу.МестоПриема = &МестоПриема
	|	И БроньЗаписиКВрачу.Должность = &Должность";
	
	Запрос.УстановитьПараметр("Врач", Объект.Сотрудник);
	Запрос.УстановитьПараметр("ВремяНачала", Объект.ВремяНачала);
	Запрос.УстановитьПараметр("Должность", Объект.Должность);
	Запрос.УстановитьПараметр("МестоПриема", ОБъект.Подразделение);
	Запрос.УстановитьПараметр("ТекущееВремя", Текущаядата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		
		Сообщить("На жаль, на даний момент хтось здійснює попитку запису на обраний час. Спробйте пізніше або оберить інший час");	
		ЭтаФорма.НадоЗакрывать = Истина;
		
	Иначеесли
		Не ЗначениеЗаполнено(ОБъект.Ссылка)
		ТОгда
		
		// отметим, что данный документ начвал редатирование указанного времени
		НЗ = РегистрыСведений.БроньЗаписиКВрачу.СоздатьМенеджерЗаписи();
		НЗ.Регистратор = Объект.Ссылка;
		НЗ.ВремяНачала = Объект.ВремяНачала;
		НЗ.Врач = Объект.Сотрудник;
		НЗ.ВремяНачала = Объект.ВремяНачала;
		НЗ.Должность = ОБъект.Должность;
		НЗ.МестоПриема = ОБъект.Подразделение;
		НЗ.ВремяБронирования = ТекущаяДата()+5*60;  
		НЗ.Записать();
		
		//Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));

	КонецЕсли;
	

КонецПроцедуры

&НаСервере
Процедура ОтменитьБлокировкуНаСервере()
	
	// удалим запись про бронивроание
	НЗ = РегистрыСведений.БроньЗаписиКВрачу.СоздатьМенеджерЗаписи();
	НЗ.ВремяНачала = Объект.ВремяНачала;
	НЗ.Врач = Объект.Сотрудник;
	НЗ.Должность = ОБъект.Должность;
	НЗ.МестоПриема = ОБъект.Подразделение;
	НЗ.Прочитать();
	Если НЗ.Выбран() 
		ТОгда
		НЗ.Удалить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтаФорма.НадоЗакрывать 
		Тогда ЭтаФорма.Закрыть();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗапись(Команда)
	ОтменитьБлокировкуНаСервере();
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	П = Новый Структура("Обновлять");
	П.Обновлять = Истина;
	ЭтаФорма.Закрыть(П);

КонецПроцедуры

&НаКлиенте
