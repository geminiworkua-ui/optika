Функция фОткрытьСмену(ОбъектДрайвера)
	
	Результат = Истина;
	
	ОбъектДрайвера.Запрос = Неопределено;
	ОбъектДрайвера.Ответ = Неопределено;
	
	fiscal = Новый Соответствие;
	fiscal.Вставить("task", 0);
	
	ПолучитьТелоЗапроса(ОбъектДрайвера, fiscal);
	
	Если ОтправитьДляОбработки(ОбъектДрайвера) <> Истина Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция фXОтчет(ОбъектДрайвера)
	
	Результат = Истина;
	
	ОбъектДрайвера.Запрос = Неопределено;
	ОбъектДрайвера.Ответ = Неопределено;
	
	fiscal = Новый Соответствие;
	fiscal.Вставить("task", 10);
	
	ПолучитьТелоЗапроса(ОбъектДрайвера, fiscal);
	
	Если ОтправитьДляОбработки(ОбъектДрайвера) <> Истина Тогда
		Результат = Ложь;
	Иначе
		ВыводЧека(ОбъектДрайвера);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

