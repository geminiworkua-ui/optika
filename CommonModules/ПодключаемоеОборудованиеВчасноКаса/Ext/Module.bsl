Функция НапечататьФискальнуюСтроку(ОбъектДрайвера, Параметры, ПараметрыПодключения, Наименование, Количество, Цена, Сумма, НомерСекции, СтавкаНДС, ДопРеквизиты, ВыходныеПараметры, Скидка = 0) Экспорт
		 
	Если Найти(НРег(ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьИмяКонфигурацииНаСервере()), НРег("УправлениеТорговлейДляУкраины")) Или Найти(НРег(ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьИмяКонфигурацииНаСервере()), НРег("Розница")) Тогда
		Сумма = НомерСекции;
		НомерСекции = СтавкаНДС;
		СтавкаНДС = ДопРеквизиты;
		ДопРеквизиты = ВыходныеПараметры;
		ВыходныеПараметры = Скидка;
	КонецЕсли;
	
	Если Найти(НРег(ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьИмяКонфигурацииНаСервере()), НРег("РозничнаяТорговля")) Тогда
		ОбъектДрайвера = ВыходныеПараметры[0];
	КонецЕсли;
	
	Скидка = (Количество * Цена - Сумма) / (Количество * Цена) * 100;
	
	ДопРеквизиты = ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьТаблицуДопРеквизитов(ДопРеквизиты);	
	
	СтруктураДопРеквизитовТабличнойЧасти = Новый Структура("АртикулТовара, Штрихкод, КодПоУКТВЭД, ШтрихкодыАкцизныхМарок", "", "", "", "");
	Если ДопРеквизиты.Количество() > 2 Тогда
		Если ЗначениеЗаполнено(ДопРеквизиты[2]) Тогда
			СтруктураДопРеквизитовТабличнойЧасти.КодПоУКТВЭД = ДопРеквизиты[2];
		КонецЕсли;
	КонецЕсли;
	Если ДопРеквизиты.Количество() > 3 Тогда
		Если ЗначениеЗаполнено(ДопРеквизиты[3]) Тогда    
			СтруктураДопРеквизитовТабличнойЧасти.ШтрихкодыАкцизныхМарок = ДопРеквизиты[3];
		КонецЕсли;
	КонецЕсли;
	
	СтруктураДопРеквизитов = Новый Структура;
	СтруктураДопРеквизитов.Вставить("СтавкаНДССтрокой", ДопРеквизиты[0]);
	СтруктураДопРеквизитов.Вставить("ЭтоПодакцизныйТовар", ДопРеквизиты[1]);
	СтруктураДопРеквизитов.Вставить("СтруктураДопРеквизитовТабличнойЧасти", СтруктураДопРеквизитовТабличнойЧасти);	
	
	Результат = фПечататьСтроку(ОбъектДрайвера, Наименование, Количество, Цена, Скидка, СтавкаНДС, СтруктураДопРеквизитов);
	
	Возврат Результат;
	
КонецФункции

