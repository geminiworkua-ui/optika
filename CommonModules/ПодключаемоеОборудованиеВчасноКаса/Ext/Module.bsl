Функция ПодключитьУстройство(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	Результат = Истина;
	ПараметрыПодключения.Вставить("ИДУстройства", "");
	ПараметрыПодключения.Вставить("ФРПодключен", Ложь);
		
	ВыходныеПараметры = Новый Массив;
	
	Сервер = Неопределено;
	Порт = Неопределено;
	ИмяУстройства = Неопределено;
	Токен = Неопределено;
	ВыводНаПринтер = Неопределено;
	ШиринаЛенты = Неопределено;
	
	Параметры.Свойство("Сервер", Сервер);
	Параметры.Свойство("Порт", Порт);
	Параметры.Свойство("ИмяУстройства", ИмяУстройства);
	Параметры.Свойство("Токен", Токен);
	Параметры.Свойство("ВыводНаПринтер", ВыводНаПринтер);
	Параметры.Свойство("ШиринаЛенты", ШиринаЛенты);
	
	Если Сервер = Неопределено Или Порт = Неопределено Или ИмяУстройства = Неопределено Или Токен = Неопределено Тогда 		
		Результат = Ложь;
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Не настроєні параметри пристрою.
		|Для коректної роботи пристрою необхідно задати параметри його роботи.
		|Зробити це можна за допомогою форми ""Настройка параметрів"" моделі
		|обладнання для підключення в формі ""Підключення та настройка обладнання"".");
	ИначеЕсли ВыводНаПринтер = Неопределено Или ШиринаЛенты = Неопределено Тогда
		Результат = Ложь;
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить("Не настроєні параметри пристрою.
		|Для коректної роботи пристрою необхідно задати параметри його роботи.
		|Зробити це можна за допомогою форми ""Настройка параметрів"" моделі
		|обладнання для підключення в формі ""Підключення та настройка обладнання"".");
	КонецЕсли;
	
	Если Результат Тогда
		Если ПараметрыПодключения.ФРПодключен Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить("Фіскальний реєстратор вже підключений");
			Результат = Ложь;
		Иначе
			ПараметрыПодключения.ФРПодключен = Истина;
			
			ВыходныеПараметры.Добавить("");
			ВыходныеПараметры.Добавить(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

