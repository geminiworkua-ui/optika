Функция фСумма(ОбъектДрайвера, Сумма)
	
	Результат = Истина;
	
	ОбъектДрайвера.Запрос = Неопределено;
	ОбъектДрайвера.Ответ = Неопределено;
	
	cash = Новый Соответствие;
	cash.Вставить("type", 0);
	cash.Вставить("sum", ?(Сумма > 0, Сумма, -Сумма));
	
	fiscal = Новый Соответствие;
	fiscal.Вставить("task", ?(Сумма > 0, 3, 4));
	fiscal.Вставить("cash", cash);
	
	ПолучитьТелоЗапроса(ОбъектДрайвера, fiscal);
	
	Если ОтправитьДляОбработки(ОбъектДрайвера) <> Истина Тогда
		Результат = Ложь;
	Иначе
		ВыводЧека(ОбъектДрайвера);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция фОткрытьЧек(ОбъектДрайвера, ЭтоВозврат, ФискальныйЧек = Истина)
	
	Результат = Истина;
		
	ОбъектДрайвера.Запрос = Неопределено;
	ОбъектДрайвера.Ответ = Неопределено;
	
	rows = Новый Массив;
	pays = Новый Массив;
	
	receipt = Новый Соответствие;
	receipt.Вставить("rows", rows);
	receipt.Вставить("pays", pays);
	
	fiscal = Новый Соответствие;
	fiscal.Вставить("task", ?(ЭтоВозврат, 2, 1));
	fiscal.Вставить("receipt", receipt);
	
	ПолучитьТелоЗапроса(ОбъектДрайвера, fiscal);
		
	Возврат Результат;		
	
КонецФункции

Функция фПечататьСтроку(ОбъектДрайвера, Наименование, Количество, Цена, Скидка, НДС, СтруктураДопРеквизитов)
	
	Результат = Истина;
		
	row = Новый Соответствие;
	row.Вставить("code", СтруктураДопРеквизитов.СтруктураДопРеквизитовТабличнойЧасти.АртикулТовара);
	row.Вставить("code1", СтруктураДопРеквизитов.СтруктураДопРеквизитовТабличнойЧасти.Штрихкод);
	row.Вставить("code2", СтруктураДопРеквизитов.СтруктураДопРеквизитовТабличнойЧасти.КодПоУКТВЭД);
	Если ЗначениеЗаполнено(СтруктураДопРеквизитов.СтруктураДопРеквизитовТабличнойЧасти.ШтрихкодыАкцизныхМарок) Тогда
		row.Вставить("code_aa", РазложитьСтрокуВМассивПодстрок(СтруктураДопРеквизитов.СтруктураДопРеквизитовТабличнойЧасти.ШтрихкодыАкцизныхМарок));
	КонецЕсли;
	row.Вставить("name", СтрЗаменить(Наименование, СтруктураДопРеквизитов.СтруктураДопРеквизитовТабличнойЧасти.КодПоУКТВЭД + "#", ""));
	row.Вставить("cnt", Количество);
	row.Вставить("price", Цена);
	row.Вставить("disc", Количество * Цена - Окр(Количество * Цена - Количество * Цена * Скидка * 0.01, 2, РежимОкругления.Окр15как20));
	row.Вставить("cost", Количество * Цена);
	row.Вставить("taxgrp", ПолучитьНалоговуюГруппу(СтруктураДопРеквизитов.СтавкаНДССтрокой, СтруктураДопРеквизитов.ЭтоПодакцизныйТовар));
	ОбъектДрайвера.Запрос["fiscal"]["receipt"]["rows"].Добавить(row);
	ОбъектДрайвера.ИтогЧека = ОбъектДрайвера.ИтогЧека + Окр(Количество * Цена - Количество * Цена * Скидка * 0.01, 2, РежимОкругления.Окр15как20);
	
	Возврат Результат;
	
КонецФункции

Функция фЗакрытьЧек(ОбъектДрайвера, ТаблицаОплат)
	
	Результат = Истина;
	
	Если Найти(НРег(ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьИмяКонфигурацииНаСервере()), НРег("РозничнаяТорговля")) Или Найти(НРег(ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьИмяКонфигурацииНаСервере()), НРег("SmallBusiness")) Или Найти(НРег(ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьИмяКонфигурацииНаСервере()), НРег("УправлениеНебольшойФирмой")) Тогда 
		СуммаНал = ТаблицаОплат[0][1].Значение;
		СуммаБезНал = ТаблицаОплат[1][1].Значение + ТаблицаОплат[2][1].Значение + ТаблицаОплат[3][1].Значение;
		
		Если СуммаНал <> 0 Тогда
			pay = Новый Соответствие;
			pay.Вставить("type", ПолучитьВидОплаты("Наличная оплата"));
			pay.Вставить("sum", Окр(ОбъектДрайвера.ИтогЧека - СуммаБезнал, 1));
			pay.Вставить("change", Окр(СуммаНал + СуммаБезнал - ОбъектДрайвера.ИтогЧека, 1));
			ОбъектДрайвера.Запрос["fiscal"]["receipt"]["pays"].Добавить(pay);
			
			ОбъектДрайвера.Запрос["fiscal"]["receipt"].Вставить("round", Окр(ОбъектДрайвера.ИтогЧека - СуммаБезнал, 1) - (ОбъектДрайвера.ИтогЧека - СуммаБезнал));
		КонецЕсли;
			
		Если СуммаБезнал <> 0 Тогда
			Если ТаблицаОплат[1][1].Значение <> 0 Тогда
				pay = Новый Соответствие;
				pay.Вставить("type", ПолучитьВидОплаты("Безналичная оплата"));
				pay.Вставить("sum", ТаблицаОплат[1][1].Значение);
				ОбъектДрайвера.Запрос["fiscal"]["receipt"]["pays"].Добавить(pay);
			КонецЕсли;
			Если ТаблицаОплат[2][1].Значение <> 0 Тогда
				pay = Новый Соответствие;
				pay.Вставить("type", ПолучитьВидОплаты("Післясплата"));
				pay.Вставить("sum", ТаблицаОплат[2][1].Значение);
				ОбъектДрайвера.Запрос["fiscal"]["receipt"]["pays"].Добавить(pay);
			КонецЕсли;
			Если ТаблицаОплат[3][1].Значение <> 0 Тогда
				pay = Новый Соответствие;
				pay.Вставить("type", ПолучитьВидОплаты("Передплата"));
				pay.Вставить("sum", ТаблицаОплат[3][1].Значение);
				ОбъектДрайвера.Запрос["fiscal"]["receipt"]["pays"].Добавить(pay);
			КонецЕсли;
		КонецЕсли;
	Иначе
		СуммаНал = ТаблицаОплат[0][1].Значение;
		СуммаБезНал = 0;
		Если ТаблицаОплат.Количество() > 1 Тогда
			СуммаБезНал = СуммаБезНал + ТаблицаОплат[1][1].Значение;
		КонецЕсли;
		Если ТаблицаОплат.Количество() > 2 Тогда
			СуммаБезНал = СуммаБезНал + ТаблицаОплат[2][1].Значение;
		КонецЕсли;
		
		Если СуммаНал <> 0 Тогда
			pay = Новый Соответствие;
			pay.Вставить("type", ПолучитьВидОплаты("Наличная оплата"));
			pay.Вставить("sum", Окр(ОбъектДрайвера.ИтогЧека - СуммаБезнал, 1));
			pay.Вставить("change", Окр(СуммаНал + СуммаБезнал - ОбъектДрайвера.ИтогЧека, 1));
			ОбъектДрайвера.Запрос["fiscal"]["receipt"]["pays"].Добавить(pay);
			
			ОбъектДрайвера.Запрос["fiscal"]["receipt"].Вставить("round", Окр(ОбъектДрайвера.ИтогЧека - СуммаБезнал, 1) - (ОбъектДрайвера.ИтогЧека - СуммаБезнал));
		КонецЕсли;
		Если СуммаБезнал <> 0 Тогда
			Для Каждого Оплата Из ТаблицаОплат Цикл
				Если Оплата[1].Значение <> 0 И Оплата[2].Значение <> "Наличная оплата" Тогда													
					pay = Новый Соответствие;
					pay.Вставить("type", ПолучитьВидОплаты(Оплата[2].Значение));
					pay.Вставить("sum", Оплата[1].Значение);
					ОбъектДрайвера.Запрос["fiscal"]["receipt"]["pays"].Добавить(pay);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ОбъектДрайвера.Запрос["fiscal"]["receipt"].Вставить("sum", ОбъектДрайвера.ИтогЧека);
	
	Если ОтправитьДляОбработки(ОбъектДрайвера) <> Истина Тогда
		Результат = Ложь;
	Иначе
		ВыводЧека(ОбъектДрайвера);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции



Процедура ПолучитьТелоЗапроса(ОбъектДрайвера, fiscal)
	
	Запрос = Новый Соответствие;
	Запрос.Вставить("ver", 6);
	Запрос.Вставить("source", "BAS");
	Запрос.Вставить("device", ОбъектДрайвера.Параметры.ИмяУстройства);
	Запрос.Вставить("tag", "" + Новый УникальныйИдентификатор);
	Запрос.Вставить("dt", Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss000"));
	//Если Не фОбъект.Параметры.ИспользоватьAPIVK Тогда 
	Запрос.Вставить("token", ОбъектДрайвера.Параметры.Токен);
	//КонецЕсли;
	Запрос.Вставить("need_pf_img", 2);
	Запрос.Вставить("need_pf_pdf", 1);
	Запрос.Вставить("need_pf_txt", 1);
	Запрос.Вставить("type", 1);
	Запрос.Вставить("fiscal", fiscal);
	
	ОбъектДрайвера.Запрос = Запрос;
	
КонецПроцедуры

Функция ОтправитьДляОбработки(ОбъектДрайвера)
	
	Результат = Истина;
	
	ТелоЗапроса = Неопределено;
	ОбработатьJSON(ТелоЗапроса, ОбъектДрайвера.Запрос);
	
	//Если фОбъект.Параметры.ИспользоватьAPIVK Тогда
	//	HTTPСоединение = Новый HTTPСоединение(фОбъект.Параметры.Сервер, фОбъект.Параметры.Порт, , , , 20, Новый ЗащищенноеСоединениеOpenSSL);	
	//	HTTPЗапрос = Новый HTTPЗапрос("/api/v3/fiscal/execute");
	//	HTTPЗапрос.Заголовки.Вставить("Authorization", фОбъект.Параметры.Токен);
	//Иначе
	HTTPСоединение = Новый HTTPСоединение(ОбъектДрайвера.Параметры.Сервер, ОбъектДрайвера.Параметры.Порт, , , , 20);
	HTTPЗапрос = Новый HTTPЗапрос("/dm/execute");
	//КонецЕсли;
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");	
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	
	ОбъектДрайвера.ОписаниеОшибки.Очистить();
	ОбъектДрайвера.ОписаниеОшибки.Добавить(0);
	ОбъектДрайвера.ОписаниеОшибки.Добавить(0);
	
	Попытка
		HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния = 200 Тогда
			ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
			ОбработатьJSON(ТелоОтвета, ОбъектДрайвера.Ответ);
			Если ОбъектДрайвера.Ответ["res"] <> 0 Тогда
				Результат = Ложь;
				ОбъектДрайвера.ОписаниеОшибки.Очистить();
				ОбъектДрайвера.ОписаниеОшибки.Добавить(999);
				ОбъектДрайвера.ОписаниеОшибки.Добавить(Формат(ОбъектДрайвера.Ответ["res"], "ЧГ=0") + ": " + ОбъектДрайвера.Ответ["errortxt"]);
			КонецЕсли;
		Иначе
			Результат = Ложь;
			ОбъектДрайвера.ОписаниеОшибки.Очистить();
			ОбъектДрайвера.ОписаниеОшибки.Добавить(999);
			ОбъектДрайвера.ОписаниеОшибки.Добавить("Код стану: " + HTTPОтвет.КодСостояния);
		КонецЕсли;
	Исключение
		Результат = Ложь;
		ОбъектДрайвера.ОписаниеОшибки.Очистить();
		ОбъектДрайвера.ОписаниеОшибки.Добавить(999);
		ОбъектДрайвера.ОписаниеОшибки.Добавить(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьJSON(Строка, Соответствие)
	
	Если Строка = Неопределено Тогда			
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix));
		ЗаписатьJSON(ЗаписьJSON, Соответствие);
		
		Строка = ЗаписьJSON.Закрыть();
	КонецЕсли;
	
	Если Соответствие = Неопределено Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Строка);
		
		Соответствие = ПрочитатьJSON(ЧтениеJSON, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыводЧека(ОбъектДрайвера)
	
	ШиринаЛентыКоэф = ОбъектДрайвера.Параметры.ШиринаЛенты * 0.95;
	Картинка = Новый Картинка(Base64Значение(СтрЗаменить(ОбъектДрайвера.Ответ["pf_image"], "data:image/png;base64,", "")));
	
	Файл = Новый Файл(ПолучитьИмяВременногоФайла("png"));
	Картинка.Записать(Файл.ПолноеИмя);
	
	Shell = Новый COMОбъект("Shell.Application");
	Folder = Shell.NameSpace(Файл.Путь);
	Item = Folder.ParseName(Файл.Имя); 
	Детали = Folder.GetDetailsOf(Item, -1);
	Детали = СтрЗаменить(Детали, " ", "");
	Х = Найти(Детали, "x");
	
	ВысотаКартинки = "";
	Сч = Х + 1;
	Пока Истина Цикл
		Если КодСимвола(Детали, Сч) >= 48 И КодСимвола(Детали, Сч) <= 57 Тогда
			ВысотаКартинки = ВысотаКартинки + Сред(Детали, Сч, 1);
			Сч = Сч + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ШиринаКартинки = "";
	Сч = Х - 1;
	Пока Истина Цикл
		Если КодСимвола(Детали, Сч) >= 48 И КодСимвола(Детали, Сч) <= 57 Тогда
			ШиринаКартинки = Сред(Детали, Сч, 1) + ШиринаКартинки;
			Сч = Сч - 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	УдалитьФайлы(Файл.ПолноеИмя);
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ПолеСверху = 0;
	ТабДок.ПолеСлева = 0;
	ТабДок.ПолеСнизу = 0;
	ТабДок.ПолеСправа = 0;
	ТабДок.АвтоМасштаб = Истина;
	
	Макет = ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьМакетНаСервере("ДрайверВчасноКасаФискальныйРегистратор");
	Область = ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьОбластьНаСервере(Макет, "Область");
	Область.ОбластьПечати = Область.Область(1, 1, 1, 1);
	
	Рисунок = Область.Рисунки.PNG;
	Рисунок.Высота = ШиринаЛентыКоэф * ВысотаКартинки / ШиринаКартинки;
	Рисунок.Ширина = ШиринаЛентыКоэф;
	Рисунок.Картинка = Картинка;
	
	ПодключаемоеОборудованиеВчасноКасаВызовСервера.ВывестиОбластьНаСервере(ТабДок, Область);
	
	Если ОбъектДрайвера.Параметры.ВыводНаПринтер Тогда
		ТабДок.Напечатать();	
	Иначе
		ТабДок.Показать();
	КонецЕсли;
	
КонецПроцедуры

Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",")
	
	МассивСтрок = Новый Массив;
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока Истина Цикл
			Поз = Найти(Стр, Разделитель);
			Если Поз = 0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр, Поз - 1));
			Стр = СокрЛ(Сред(Стр, Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока Истина Цикл
			Поз = Найти(Стр, Разделитель);
			Если Поз = 0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр, Поз - 1));
			Стр = Сред(Стр, Поз + ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьНалоговуюГруппу(СтавкаНДССтрокой, ЭтоПодакцизныйТовар)
	
	Результат = 0;
	
	Если СтавкаНДССтрокой = "" Тогда 
		СтавкаНДССтрокой = "Без НДС";
	КонецЕсли;
		
	Если СтавкаНДССтрокой = "20" И Не ЭтоПодакцизныйТовар Тогда
		Результат = 1;
	ИначеЕсли СтавкаНДССтрокой = "Без НДС" И Не ЭтоПодакцизныйТовар Тогда
		Результат = 2;
	ИначеЕсли СтавкаНДССтрокой = "20" И ЭтоПодакцизныйТовар Тогда
		Результат = 3;
	ИначеЕсли СтавкаНДССтрокой = "7" Тогда
		Результат = 4;
	ИначеЕсли СтавкаНДССтрокой = "0" Тогда
		Результат = 5;
	ИначеЕсли СтавкаНДССтрокой = "Без НДС" И ЭтоПодакцизныйТовар Тогда
		Результат = 6;
	ИначеЕсли СтавкаНДССтрокой = "Не НДС" Тогда
		Результат = 7;
	ИначеЕсли СтавкаНДССтрокой = "14" Тогда
		Результат = 9;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВидОплаты(ТипОплаты)
	
	Результат = -1;
	
	Если ТипОплаты = "Наличная оплата" Тогда
		Результат = 0;
	ИначеЕсли ТипОплаты = "Безготівка" Тогда
		Результат = 1;
	ИначеЕсли ТипОплаты = "Безналичная оплата" Тогда
		Результат = 2;
	ИначеЕсли ТипОплаты = "Передплата" Тогда
		Результат = 3;
	ИначеЕсли ТипОплаты = "Післясплата" Тогда
		Результат = 4;
	ИначеЕсли ТипОплаты = "Кредит" Тогда
		Результат = 5;
	ИначеЕсли ТипОплаты = "Сертификатом" Тогда
		Результат = 6;
	ИначеЕсли ТипОплаты = "Чек" Тогда
		Результат = 8;
	ИначеЕсли ТипОплаты = "Бонуснібали" Тогда
		Результат = 11;
	ИначеЕсли ТипОплаты = "Погашеннякредиту" Тогда
		Результат = 12;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции



Функция ПечатьЧекаПоШаблону(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВходныеПараметры, ВыходныеПараметры) Экспорт
	
	Результат = Истина;
	
	ПозицииЧека = ВходныеПараметры.ПозицииЧека;
	ТаблицаОплат = ВходныеПараметры.ТаблицаОплат;
	
	ТаблицаДопРеквизитов = Новый Массив;
	ТаблицаДопРеквизитов.Добавить(Новый Массив);
	
	ТипРасчета = МенеджерОборудованияКлиентСервер.КодРасчетаДенежнымиСредствами(ВходныеПараметры.ТипРасчета);
	ТипЧека = ?(ТипРасчета = 1, Ложь, Истина);

	Если ВходныеПараметры.Свойство("ПодписьЧека") Тогда
		РасширенныеПараметры = ВходныеПараметры.ПодписьЧека; 
		ВыходныеПараметры.Очистить();
		ВыходныеПараметры.Добавить(РасширенныеПараметры.НомерСмены);
		ВыходныеПараметры.Добавить(РасширенныеПараметры.НомерЧека);
		ВыходныеПараметры.Добавить(0);
		ВыходныеПараметры.Добавить(МенеджерОборудованияКлиентПереопределяемый.ДатаСеанса());
		ВыходныеПараметры.Добавить(Неопределено);
		ВыходныеПараметры.Добавить(Неопределено);
		ВыходныеПараметры.Добавить(Неопределено);
	Иначе
		Результат = ОткрытьЧек(ОбъектДрайвера, Параметры, ПараметрыПодключения, ТипЧека, Истина, ВыходныеПараметры);
	КонецЕсли;
		
	Если Результат Тогда
		ОшибкаПриПечати = Ложь;
		
		Для ИндексМассива = 0 По ПозицииЧека.Количество() - 1 Цикл
			
			ПозицияЧека = ПозицииЧека[ИндексМассива];
			Если ПозицияЧека.Свойство("ФискальнаяСтрока") Тогда
				
				Наименование = ?(ПозицияЧека.Свойство("Наименование"), ПозицияЧека.Наименование, "");
				Количество = ?(ПозицияЧека.Свойство("Количество"), ПозицияЧека.Количество, 1);
				Цена = ?(ПозицияЧека.Свойство("Цена"), ПозицияЧека.Цена, 0);
				Сумма = ?(ПозицияЧека.Свойство("Сумма"), ПозицияЧека.Сумма, 0);
				НомерСекции = ?(ПозицияЧека.Свойство("НомерСекции"), ПозицияЧека.НомерСекции, 0);
				СтавкаНДС = ?(ПозицияЧека.Свойство("СтавкаНДС"), ПозицияЧека.СтавкаНДС, 0);
				
				ТаблицаДопРеквизитов[0].Очистить();
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("СтавкаНДС"), Строка(СтавкаНДС), 0));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("ЭтоПодакцизныйТовар"), ПозицияЧека.ЭтоПодакцизныйТовар, Ложь));
				
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("Наименование"), ПозицияЧека.Наименование, ""));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("КодПоУКТВЭД"), ПозицияЧека.КодПоУКТВЭД , ""));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("Артикул"), ПозицияЧека.Артикул , ""));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("Штрихкод"), Строка(ПозицияЧека.Штрихкод) , ""));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("ЕдиницаИзмерения"), ПозицияЧека.ЕдиницаИзмерения, ""));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("ПроцентСкидок"), ПозицияЧека.ПроцентСкидки , 0));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("СуммаСкидок"), ПозицияЧека.СуммаСкидок , 0));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("ЦенаВключаетНДС"), ПозицияЧека.ЦенаВключаетНДС , 1));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("СуммаНДС"), ПозицияЧека.СуммаНДС , 0));
				ТаблицаДопРеквизитов[0].Добавить(?(ПозицияЧека.Свойство("ШтрихкодыАкцизныхМарок"), ПозицияЧека.ШтрихкодыАкцизныхМарок, ""));
				
				ДопРеквизиты = СформироватьТаблицуДопРеквизитов(ТаблицаДопРеквизитов);
								  
				Если Не НапечататьФискальнуюСтроку(ОбъектДрайвера, Параметры, ПараметрыПодключения, Наименование, Количество, Цена, Сумма, НомерСекции, СтавкаНДС, ДопРеквизиты, ВыходныеПараметры) Тогда
					ОшибкаПриПечати = Истина;   
					Прервать;
				КонецЕсли;
			ИначеЕсли ПозицияЧека.Свойство("ТекстоваяСтрока") Тогда
				Текст = ?(ПозицияЧека.Свойство("Текст"), ПозицияЧека.Текст, "");
				Если Не НапечататьНефискальнуюСтроку(ОбъектДрайвера, Параметры, ПараметрыПодключения, Текст, ВыходныеПараметры) Тогда
					ОшибкаПриПечати = Истина;   
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			
		Если Не ОшибкаПриПечати Тогда
			
			Результат = Истина;
			
			ТаблицаОплатЧека = Новый Массив;
			
			Если ТаблицаОплат <> Неопределено Тогда				
				СуммаНаличными = 0;
				СуммаЭлектронными = 0;
				СуммаПостоплатой = 0;
				СуммаПредоплатой = 0;
				СуммаПредоставлением = 0;
								
				Для ИндексОплаты = 0 По ТаблицаОплат.Количество() - 1 Цикл
					Если ТаблицаОплат[ИндексОплаты].ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Электронно") Тогда
						СуммаЭлектронными = СуммаЭлектронными + ТаблицаОплат[ИндексОплаты].Сумма;
					ИначеЕсли ТаблицаОплат[ИндексОплаты].ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Предоплата") Тогда
						СуммаПредоплатой = СуммаПредоплатой + ТаблицаОплат[ИндексОплаты].Сумма;
					ИначеЕсли ТаблицаОплат[ИндексОплаты].ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Постоплата") Тогда
						СуммаПостоплатой = СуммаПостоплатой + ТаблицаОплат[ИндексОплаты].Сумма;
					ИначеЕсли ТаблицаОплат[ИндексОплаты].ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.ВстречноеПредоставление") Тогда
						СуммаПредоставлением = СуммаПредоставлением + ТаблицаОплат[ИндексОплаты].Сумма;
					Иначе
						СуммаНаличными = СуммаНаличными + ТаблицаОплат[ИндексОплаты].Сумма;
					КонецЕсли;
				КонецЦикла;
				
				СтрокаОплаты = Новый СписокЗначений();
				СтрокаОплаты.Добавить(0);
				СтрокаОплаты.Добавить(СуммаНаличными);
				ТаблицаОплатЧека.Добавить(СтрокаОплаты);
				
				СтрокаОплаты = Новый СписокЗначений();
				СтрокаОплаты.Добавить(1);
				СтрокаОплаты.Добавить(СуммаЭлектронными + СуммаПредоставлением);
				ТаблицаОплатЧека.Добавить(СтрокаОплаты);
				
				СтрокаОплаты = Новый СписокЗначений();
				СтрокаОплаты.Добавить(2);
				СтрокаОплаты.Добавить(СуммаПостоплатой);
				ТаблицаОплатЧека.Добавить(СтрокаОплаты);
				
				СтрокаОплаты = Новый СписокЗначений();
				СтрокаОплаты.Добавить(3);
				СтрокаОплаты.Добавить(СуммаПредоплатой);
				ТаблицаОплатЧека.Добавить(СтрокаОплаты);				
			КонецЕсли;
			
			Если ТипЧека Тогда 
				НомерЧекаВозврата = ?(ВходныеПараметры.Свойство("ЧекККМПродажаНомерЧекаККМ") , ВходныеПараметры.ЧекККМПродажаНомерЧекаККМ, "");
			Иначе
				НомерЧекаВозврата = "";
			КонецЕсли;
			
			Результат = ЗакрытьЧек(ОбъектДрайвера, Параметры, ПараметрыПодключения, ТаблицаОплатЧека, ВыходныеПараметры);			
		Иначе
			Результат = Ложь;
		КонецЕсли;
			
		КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТаблицуДопРеквизитов(ДанныеЗагрузки) Экспорт
	
	Результат = Новый Массив;
	
	ЗаписьXML = Новый ЗаписьXML; 
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();

	ЗаписьXML.ЗаписатьНачалоЭлемента("Table");
	Для Каждого Позиция Из ДанныеЗагрузки  Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Record");
		
		ЗаписьXML.ЗаписатьАтрибут("VAT", Позиция[0]);
		ЗаписьXML.ЗаписатьАтрибут("IsExcisable", Строка(Формат(Позиция[1], "БЛ=False; БИ=True")));
		
		ЗаписьXML.ЗаписатьАтрибут("Nomenclature" , Позиция[2]);
		ЗаписьXML.ЗаписатьАтрибут("UKTZED" , Позиция[3]);
		ЗаписьXML.ЗаписатьАтрибут("VendorCode" , Позиция[4]);
		ЗаписьXML.ЗаписатьАтрибут("Barcode" , Позиция[5]);
		ЗаписьXML.ЗаписатьАтрибут("Dimension" , Строка(Позиция[6]));
		ЗаписьXML.ЗаписатьАтрибут("Discount" , СтрЗаменить(Строка(Позиция[7]), ",", "."));
		ЗаписьXML.ЗаписатьАтрибут("DiscountAmount" , СтрЗаменить(Строка(Позиция[8]), ",", "."));
		ЗаписьXML.ЗаписатьАтрибут("PriceIncludeVAT",Строка(Позиция[9]));
		ЗаписьXML.ЗаписатьАтрибут("AmountVAT",СтрЗаменить(Строка(Позиция[10]), ",", "."));
		ЗаписьXML.ЗаписатьАтрибут("ExciseStampBarcode", Позиция[11]);
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
    	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции