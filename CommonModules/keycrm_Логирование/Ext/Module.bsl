#Область ПрограммныйИнтерфейс

// Записывает событие в РС keycrm_ЖурналЛогирования.
//
// Параметры:
//  Уровень   - Строка - "Информация", "Предупреждение", "Ошибка"
//  Событие   - Строка - короткое имя события ("Товары", "Цены", "Остатки", "Заказы", "Обмен", "API")
//  Сообщение - Строка - описание для пользователя
//  Контекст  - Структура, Неопределено - контекст обмена (берется ИдентификаторЗапуска)
//  Объект    - СправочникСсылка.Номенклатура, ДокументСсылка.ЗаказКлиента, Неопределено
//  Подробности - Строка - тело запроса / ответ / текст ошибки
//
Процедура Записать(Уровень, Событие, Сообщение, Контекст = Неопределено, Объект = Неопределено, Подробности = "") Экспорт

	Попытка

		МЗ = РегистрыСведений.keycrm_ЖурналЛогирования.СоздатьМенеджерЗаписи();
		МЗ.Период              = ТекущаяДатаСеанса();
		МЗ.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
		МЗ.Уровень             = Уровень;
		МЗ.Событие             = Событие;
		МЗ.Сообщение           = Лев(Сообщение, 1024);
		МЗ.Подробности         = Подробности;

		Если ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("ИдентификаторЗапуска") Тогда
			МЗ.ИдентификаторЗапуска = Контекст.ИдентификаторЗапуска;
		КонецЕсли;

		Если Объект <> Неопределено Тогда
			МЗ.Объект = Объект;
		КонецЕсли;

		МЗ.Записать();

	Исключение
		// Журнал не должен ронять обмен - дублируем в журнал регистрации
		ЗаписьЖурналаРегистрации("KeyCRM - Ошибка логирования",
			УровеньЖурналаРегистрации.Ошибка, , ,
			Сообщение + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура Информация(Событие, Сообщение, Контекст = Неопределено, Объект = Неопределено, Подробности = "") Экспорт
	Записать("Информация", Событие, Сообщение, Контекст, Объект, Подробности);
КонецПроцедуры

Процедура Предупреждение(Событие, Сообщение, Контекст = Неопределено, Объект = Неопределено, Подробности = "") Экспорт
	Записать("Предупреждение", Событие, Сообщение, Контекст, Объект, Подробности);
КонецПроцедуры

Процедура Ошибка(Событие, Сообщение, Контекст = Неопределено, Объект = Неопределено, Подробности = "") Экспорт
	Записать("Ошибка", Событие, Сообщение, Контекст, Объект, Подробности);
КонецПроцедуры

// Удаляет записи старше ХранитьДней (не более 1000 за вызов, чтобы не тормозить обмен).
Процедура УдалитьСтарыеЗаписи(ХранитьДней = 30) Экспорт

	Если ХранитьДней <= 0 Тогда
		ХранитьДней = 30;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	Ж.Период КАК Период,
		|	Ж.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.keycrm_ЖурналЛогирования КАК Ж
		|ГДЕ
		|	Ж.Период < &Граница";
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДатаСеанса()) - ХранитьДней * 86400);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НЗ = РегистрыСведений.keycrm_ЖурналЛогирования.СоздатьНаборЗаписей();
		НЗ.Отбор.Период.Установить(Выборка.Период);
		НЗ.Отбор.ИдентификаторЗаписи.Установить(Выборка.ИдентификаторЗаписи);
		НЗ.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

