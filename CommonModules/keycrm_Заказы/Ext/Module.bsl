// Загружает новые заказы из KeyCRM и создает документы "Заказ клиента" с резервированием на складе.
// Заполнение документа сделано по образцу загрузки заказов с сайта (ИнфралайнСерверСервис.ЗаполнитьЗаказ).
// Уже загруженные заказы повторно не изменяются.

//ДК: 13.11.2026

#Область ПрограммныйИнтерфейс

// Возвращаемое значение:
//  Строка - итог для журнала (пустая строка, если новых заказов нет)
//
Функция ЗагрузитьЗаказы(Контекст) Экспорт

	Параметры = Контекст.Настройка;

	Если Не ЗначениеЗаполнено(Параметры.Организация)
		Или Не ЗначениеЗаполнено(Параметры.СкладЗаказов)
		Или Не ЗначениеЗаполнено(Параметры.Партнер)
		Или Не ЗначениеЗаполнено(Параметры.Контрагент) Тогда
		keycrm_Логирование.Ошибка("Заказы",
			"Загрузка заказов невозможна: в настройке не заполнены Организация, Склад заказов, Партнер или Контрагент",
			Контекст);
		Возврат "заказы: не заполнены настройки";
	КонецЕсли;

	НачалоЗапуска = ТекущаяДатаСеанса();

	// Период выборки: от даты последней успешной загрузки (с запасом 10 минут) до текущего момента
	ДатаПоследнейЗагрузки = Константы.keycrm_ДатаПоследнейЗагрузкиЗаказов.Получить();
	Если ЗначениеЗаполнено(ДатаПоследнейЗагрузки) Тогда
		ДатаС = ДатаПоследнейЗагрузки - 600;
	ИначеЕсли ЗначениеЗаполнено(Параметры.ДатаНачалаЗагрузкиЗаказов) Тогда
		ДатаС = Параметры.ДатаНачалаЗагрузкиЗаказов;
	Иначе
		ДатаС = НачалоДня(НачалоЗапуска);
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.ДатаНачалаЗагрузкиЗаказов) И ДатаС < Параметры.ДатаНачалаЗагрузкиЗаказов Тогда
		ДатаС = Параметры.ДатаНачалаЗагрузкиЗаказов;
	КонецЕсли;

	ФильтрПериода = keycrm_API.ДатаВСтрокуUTC(ДатаС) + ", " + keycrm_API.ДатаВСтрокуUTC(НачалоЗапуска + 3600);

	ОбщийРесурс = "/order?limit=50&include=" + ВключаемыеДанные()
		+ "&filter[created_between]=" + keycrm_API.КодироватьПараметр(ФильтрПериода) + "&page=";

	Создано = 0;
	Ошибок = 0;
	ВсеСтраницыПолучены = Истина;
	ОбработанныеИД = Новый Соответствие;
	Страница = 1;

	Пока Страница <= 20 Цикл

		Ответ = keycrm_API.ВыполнитьЗапрос(Контекст, "GET", ОбщийРесурс + keycrm_API.ИДСтрокой(Страница));

		Если Не Ответ.Успех Тогда
			keycrm_Логирование.Ошибка("Заказы", "Ошибка получения списка заказов", Контекст, , Ответ.ОписаниеОшибки);
			ВсеСтраницыПолучены = Ложь;
			Прервать;
		КонецЕсли;

		Заказы = keycrm_API.МассивДанных(Ответ.Данные);
		Если Заказы.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		// Какие заказы уже загружены
		МассивИД = Новый Массив;
		Для Каждого ДанныеЗаказа Из Заказы Цикл
			МассивИД.Добавить(keycrm_API.ЧислоИз(keycrm_API.Зн(ДанныеЗаказа, "id")));
		КонецЦикла;
		УжеЗагружены = ЗагруженныеЗаказы(МассивИД);

		Для Каждого ДанныеЗаказа Из Заказы Цикл

			ИДЗаказа = keycrm_API.ЧислоИз(keycrm_API.Зн(ДанныеЗаказа, "id"));
			Если ИДЗаказа = 0 Или УжеЗагружены.Получить(ИДЗаказа) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// На случай, если фильтр по дате не сработал на стороне KeyCRM
			ДатаСоздания = keycrm_API.ДатаИзСтрокиUTC(keycrm_API.Зн(ДанныеЗаказа, "created_at"));
			Если ЗначениеЗаполнено(ДатаСоздания) И ДатаСоздания < ДатаС - 86400 Тогда
				Продолжить;
			КонецЕсли;

			ОбработанныеИД.Вставить(ИДЗаказа, Истина);

			Если ОбработатьЗаказ(Контекст, ДанныеЗаказа, ИДЗаказа) Тогда
				Создано = Создано + 1;
			Иначе
				Ошибок = Ошибок + 1;
			КонецЕсли;

		КонецЦикла;

		Если Заказы.Количество() < 50 Тогда
			Прервать;
		КонецЕсли;

		Страница = Страница + 1;

	КонецЦикла;

	// Повторная попытка для заказов, которые раньше не удалось создать (за последние 7 дней, не более 10 за запуск)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 10
		|	Заказы.ИДЗаказа КАК ИДЗаказа
		|ИЗ
		|	РегистрСведений.keycrm_СоответствиеЗаказов КАК Заказы
		|ГДЕ
		|	Заказы.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|	И Заказы.ДатаЗагрузки >= &Граница
		|
		|УПОРЯДОЧИТЬ ПО
		|	Заказы.ДатаЗагрузки";
	Запрос.УстановитьПараметр("Граница", НачалоЗапуска - 7 * 86400);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ОбработанныеИД.Получить(Выборка.ИДЗаказа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Ответ = keycrm_API.ВыполнитьЗапрос(Контекст, "GET",
			"/order/" + keycrm_API.ИДСтрокой(Выборка.ИДЗаказа) + "?include=" + ВключаемыеДанные());

		Если Не Ответ.Успех Тогда
			Продолжить;
		КонецЕсли;

		Если ОбработатьЗаказ(Контекст, Ответ.Данные, Выборка.ИДЗаказа) Тогда
			Создано = Создано + 1;
		КонецЕсли;

	КонецЦикла;

	Если ВсеСтраницыПолучены Тогда
		Константы.keycrm_ДатаПоследнейЗагрузкиЗаказов.Установить(НачалоЗапуска);
	КонецЕсли;

	Если Создано = 0 И Ошибок = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "заказы: создано " + Формат(Создано, "ЧН=0; ЧГ=0")
		+ ?(Ошибок = 0, "", ", с ошибками " + Формат(Ошибок, "ЧН=0; ЧГ=0"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВключаемыеДанные()
	Возврат "buyer,products.offer,shipping";
КонецФункции

// Возвращает соответствие ИДЗаказа -> Истина для заказов, по которым документ уже создан.
// Заказы с ошибкой (пустая ссылка) сюда не попадают - по ним будет повторная попытка.
Функция ЗагруженныеЗаказы(МассивИД)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Заказы.ИДЗаказа КАК ИДЗаказа
		|ИЗ
		|	РегистрСведений.keycrm_СоответствиеЗаказов КАК Заказы
		|ГДЕ
		|	Заказы.ИДЗаказа В(&МассивИД)
		|	И Заказы.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)";
	Запрос.УстановитьПараметр("МассивИД", МассивИД);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ИДЗаказа, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создает документ по заказу KeyCRM и записывает результат в РС keycrm_СоответствиеЗаказов.
Функция ОбработатьЗаказ(Контекст, ДанныеЗаказа, ИДЗаказа)

	ТекстОшибки = "";
	ЗаказСсылка = Неопределено;

	Попытка
		ЗаказСсылка = СоздатьЗаказКлиента(Контекст, ДанныеЗаказа, ИДЗаказа, ТекстОшибки);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	МЗ = РегистрыСведений.keycrm_СоответствиеЗаказов.СоздатьМенеджерЗаписи();
	МЗ.ИДЗаказа = ИДЗаказа;
	МЗ.Прочитать();

	ПерваяПопытка = Не МЗ.Выбран();

	МЗ.ИДЗаказа = ИДЗаказа;
	Если ПерваяПопытка Тогда
		МЗ.ДатаЗагрузки = ТекущаяДатаСеанса();
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаказСсылка) Тогда
		МЗ.Заказ = ЗаказСсылка;
		МЗ.ДатаЗагрузки = ТекущаяДатаСеанса();
	КонецЕсли;
	МЗ.Ошибка = Лев(ТекстОшибки, 500);
	МЗ.Записать(Истина);

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		// В журнал пишем только первую неудачу, чтобы повторные попытки его не засоряли
		Если ПерваяПопытка Тогда
			keycrm_Логирование.Ошибка("Заказы", "Не удалось создать заказ KeyCRM №" + keycrm_API.ИДСтрокой(ИДЗаказа)
				+ ". Попытки будут повторяться 7 дней", Контекст, , ТекстОшибки);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	Если ТекстОшибки = "" Тогда
		keycrm_Логирование.Информация("Заказы", "Создан и проведен заказ по заказу KeyCRM №"
			+ keycrm_API.ИДСтрокой(ИДЗаказа), Контекст, ЗаказСсылка);
	Иначе
		keycrm_Логирование.Предупреждение("Заказы", "Заказ KeyCRM №" + keycrm_API.ИДСтрокой(ИДЗаказа)
			+ " записан БЕЗ проведения (резерв не установлен)", Контекст, ЗаказСсылка, ТекстОшибки);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Возвращаемое значение:
//  ДокументСсылка.ЗаказКлиента, Неопределено - Неопределено, если документ не создан (причина в ТекстОшибки).
//  Если документ записан без проведения, возвращается ссылка, а в ТекстОшибки - причина.
Функция СоздатьЗаказКлиента(Контекст, ДанныеЗаказа, ИДЗаказа, ТекстОшибки)

	Параметры = Контекст.Настройка;

	ТоварыЗаказа = keycrm_API.Зн(ДанныеЗаказа, "products");
	Если ТипЗнч(ТоварыЗаказа) <> Тип("Массив") Или ТоварыЗаказа.Количество() = 0 Тогда
		ТекстОшибки = "В заказе нет товаров";
		Возврат Неопределено;
	КонецЕсли;

	// 1. Поиск номенклатуры по ID варианта и SKU через регистр соответствий (один запрос на заказ)
	МассивSKU = Новый Массив;
	МассивИДВариантов = Новый Массив;
	СтрокиЗаказа = Новый Массив;

	Для Каждого ТоварЗаказа Из ТоварыЗаказа Цикл

		Оффер = keycrm_API.Зн(ТоварЗаказа, "offer");
		ИДВарианта = keycrm_API.ЧислоИз(keycrm_API.Зн(Оффер, "id"));
		SKU = keycrm_API.СтрокаИз(keycrm_API.Зн(Оффер, "sku"));
		Если SKU = "" Тогда
			SKU = keycrm_API.СтрокаИз(keycrm_API.Зн(ТоварЗаказа, "sku"));
		КонецЕсли;

		Если ИДВарианта <> 0 Тогда
			МассивИДВариантов.Добавить(ИДВарианта);
		КонецЕсли;
		Если SKU <> "" Тогда
			МассивSKU.Добавить(SKU);
		КонецЕсли;

		ОписаниеСтроки = Новый Структура;
		ОписаниеСтроки.Вставить("ИДВарианта", ИДВарианта);
		ОписаниеСтроки.Вставить("SKU", SKU);
		ОписаниеСтроки.Вставить("Наименование", keycrm_API.СтрокаИз(keycrm_API.Зн(ТоварЗаказа, "name")));
		ОписаниеСтроки.Вставить("Количество", keycrm_API.ЧислоИз(keycrm_API.Зн(ТоварЗаказа, "quantity")));
		ОписаниеСтроки.Вставить("Цена", keycrm_API.ЧислоИз(keycrm_API.Зн(ТоварЗаказа, "price")));
		ОписаниеСтроки.Вставить("ЦенаПродажи", keycrm_API.ЧислоИз(keycrm_API.Зн(ТоварЗаказа, "price_sold")));
		ОписаниеСтроки.Вставить("Скидка", keycrm_API.ЧислоИз(keycrm_API.Зн(ТоварЗаказа, "total_discount")));
		СтрокиЗаказа.Добавить(ОписаниеСтроки);

	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Варианты.SKU КАК SKU,
		|	Варианты.ИДВарианта КАК ИДВарианта,
		|	Варианты.Номенклатура КАК Номенклатура,
		|	Варианты.Характеристика КАК Характеристика,
		|	Варианты.Номенклатура.СтавкаНДС КАК СтавкаНДС,
		|	Варианты.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Варианты.Номенклатура.НаборУпаковок КАК НаборУпаковок,
		|	Варианты.Номенклатура.ОсновнаяУпаковка КАК ОсновнаяУпаковка
		|ИЗ
		|	РегистрСведений.keycrm_СоответствиеВариантов КАК Варианты
		|ГДЕ
		|	(Варианты.SKU В (&МассивSKU)
		|			ИЛИ Варианты.ИДВарианта <> 0
		|				И Варианты.ИДВарианта В (&МассивИДВариантов))";
	Запрос.УстановитьПараметр("МассивSKU", МассивSKU);
	Запрос.УстановитьПараметр("МассивИДВариантов", МассивИДВариантов);

	ПоИД = Новый Соответствие;
	ПоSKU = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ДанныеВарианта = Новый Структура("Номенклатура, Характеристика, СтавкаНДС, ЕдиницаИзмерения, НаборУпаковок, ОсновнаяУпаковка");
		ЗаполнитьЗначенияСвойств(ДанныеВарианта, Выборка);

		Если Выборка.ИДВарианта <> 0 Тогда
			ПоИД.Вставить(Выборка.ИДВарианта, ДанныеВарианта);
		КонецЕсли;
		ПоSKU.Вставить(ВРег(СокрЛП(Выборка.SKU)), ДанныеВарианта);

	КонецЦикла;

	Для Каждого ОписаниеСтроки Из СтрокиЗаказа Цикл

		ДанныеВарианта = Неопределено;
		Если ОписаниеСтроки.ИДВарианта <> 0 Тогда
			ДанныеВарианта = ПоИД.Получить(ОписаниеСтроки.ИДВарианта);
		КонецЕсли;
		Если ДанныеВарианта = Неопределено И ОписаниеСтроки.SKU <> "" Тогда
			ДанныеВарианта = ПоSKU.Получить(ВРег(ОписаниеСтроки.SKU));
		КонецЕсли;

		Если ДанныеВарианта = Неопределено Тогда
			ТекстОшибки = "Товар заказа не найден в регистре соответствий: SKU """ + ОписаниеСтроки.SKU
				+ """, " + ОписаниеСтроки.Наименование;
			Возврат Неопределено;
		КонецЕсли;

		Если ОписаниеСтроки.Количество <= 0 Тогда
			ТекстОшибки = "В заказе указано нулевое количество: SKU """ + ОписаниеСтроки.SKU + """";
			Возврат Неопределено;
		КонецЕсли;

		ОписаниеСтроки.Вставить("ДанныеВарианта", ДанныеВарианта);

	КонецЦикла;

	// 2. Шапка документа
	ТекущаяДатаЗаказа = ТекущаяДатаСеанса();

	Документ = Документы.ЗаказКлиента.СоздатьДокумент();
	Документ.Дата                  = ТекущаяДатаЗаказа;
	Документ.Организация           = Параметры.Организация;
	Документ.Партнер               = Параметры.Партнер;
	Документ.Контрагент            = Параметры.Контрагент;
	Документ.Соглашение            = Параметры.Соглашение;
	Документ.Склад                 = Параметры.СкладЗаказов;
	Документ.Подразделение         = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.СкладЗаказов, "Подразделение");
	Документ.Валюта                = Константы.ВалютаРегламентированногоУчета.Получить();
	Документ.ЦенаВключаетНДС       = Истина;
	Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Документ.ПорядокРасчетов       = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	Документ.Статус                = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению;
	Документ.Приоритет             = ПриоритетПоУмолчанию();
	Документ.ДатаСогласования      = ТекущаяДатаЗаказа;
	Документ.Согласован            = Истина;
	Документ.ЖелаемаяДатаОтгрузки  = ТекущаяДатаЗаказа;
	Документ.ДатаОтгрузки          = ТекущаяДатаЗаказа;
	Документ.НомерПоДаннымКлиента  = keycrm_API.ИДСтрокой(ИДЗаказа);
	Документ.ДатаПоДаннымКлиента   = keycrm_API.ДатаИзСтрокиUTC(keycrm_API.Зн(ДанныеЗаказа, "created_at"));
	Документ.Комментарий           = "KeyCRM, замовлення №" + keycrm_API.ИДСтрокой(ИДЗаказа);

	// Покупатель и доставка - текстом
	Покупатель = keycrm_API.Зн(ДанныеЗаказа, "buyer");
	Доставка   = keycrm_API.Зн(ДанныеЗаказа, "shipping");

	СтрокиИнформации = Новый Массив;
	ДобавитьСтрокуИнформации(СтрокиИнформации, "Покупець", keycrm_API.Зн(Покупатель, "full_name"));
	ДобавитьСтрокуИнформации(СтрокиИнформации, "Телефон", keycrm_API.Зн(Покупатель, "phone"));
	ДобавитьСтрокуИнформации(СтрокиИнформации, "E-mail", keycrm_API.Зн(Покупатель, "email"));
	ДобавитьСтрокуИнформации(СтрокиИнформации, "Коментар покупця", keycrm_API.Зн(ДанныеЗаказа, "buyer_comment"));
	ДобавитьСтрокуИнформации(СтрокиИнформации, "Коментар менеджера", keycrm_API.Зн(ДанныеЗаказа, "manager_comment"));
	Документ.ДополнительнаяИнформация = СтрСоединить(СтрокиИнформации, Символы.ПС);

	ЧастиАдреса = Новый Массив;
	ДобавитьЧастьАдреса(ЧастиАдреса, keycrm_API.Зн(Доставка, "shipping_address_city"));
	ДобавитьЧастьАдреса(ЧастиАдреса, keycrm_API.Зн(Доставка, "shipping_receive_point"));
	ДобавитьЧастьАдреса(ЧастиАдреса, keycrm_API.Зн(Доставка, "shipping_secondary_line"));
	Документ.АдресДоставки = Лев(СтрСоединить(ЧастиАдреса, ", "), 500);

	СтрокиДоставки = Новый Массив;
	ДобавитьСтрокуИнформации(СтрокиДоставки, "Отримувач", keycrm_API.Зн(Доставка, "recipient_full_name"));
	ДобавитьСтрокуИнформации(СтрокиДоставки, "Телефон отримувача", keycrm_API.Зн(Доставка, "recipient_phone"));
	ДобавитьСтрокуИнформации(СтрокиДоставки, "ТТН", keycrm_API.Зн(Доставка, "tracking_code"));
	Документ.ДополнительнаяИнформацияПоДоставке = СтрСоединить(СтрокиДоставки, Символы.ПС);

	// 3. Товары
	СуммаДокумента = 0;

	Для Каждого ОписаниеСтроки Из СтрокиЗаказа Цикл

		ДанныеВарианта = ОписаниеСтроки.ДанныеВарианта;

		СтрокаТовара = Документ.Товары.Добавить();
		СтрокаТовара.Номенклатура   = ДанныеВарианта.Номенклатура;
		СтрокаТовара.Характеристика = ДанныеВарианта.Характеристика;

		Если ДанныеВарианта.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
			СтрокаТовара.Упаковка = ДанныеВарианта.ОсновнаяУпаковка;
		Иначе
			СтрокаТовара.Упаковка = ДанныеВарианта.ЕдиницаИзмерения;
		КонецЕсли;

		СтрокаТовара.КоличествоУпаковок = ОписаниеСтроки.Количество;
		СтрокаТовара.Количество         = ОписаниеСтроки.Количество;
		СтрокаТовара.ВидЦены            = Параметры.ВидЦены;
		СтрокаТовара.Цена               = ОписаниеСтроки.Цена;

		СуммаБезСкидки = Окр(ОписаниеСтроки.Цена * ОписаниеСтроки.Количество, 2);
		Если ОписаниеСтроки.ЦенаПродажи > 0 Тогда
			СуммаСтроки = Окр(ОписаниеСтроки.ЦенаПродажи * ОписаниеСтроки.Количество, 2);
		Иначе
			СуммаСтроки = СуммаБезСкидки - ОписаниеСтроки.Скидка;
		КонецЕсли;
		Если СуммаСтроки < 0 Или СуммаСтроки > СуммаБезСкидки Тогда
			СуммаСтроки = СуммаБезСкидки;
		КонецЕсли;

		СтрокаТовара.Сумма             = СуммаСтроки;
		СтрокаТовара.СуммаРучнойСкидки = СуммаБезСкидки - СуммаСтроки;
		Если СуммаБезСкидки > 0 Тогда
			СтрокаТовара.ПроцентРучнойСкидки = Окр(100 * СтрокаТовара.СуммаРучнойСкидки / СуммаБезСкидки, 2);
		КонецЕсли;

		СтрокаТовара.СтавкаНДС = ДанныеВарианта.СтавкаНДС;
		ПроцентНДС = ПроцентСтавкиНДС(ДанныеВарианта.СтавкаНДС);
		Если ПроцентНДС > 0 Тогда
			СтрокаТовара.СуммаНДС = Окр(СуммаСтроки - СуммаСтроки / (1 + ПроцентНДС / 100), 2);
		Иначе
			СтрокаТовара.СуммаНДС = 0;
		КонецЕсли;
		СтрокаТовара.СуммаСНДС = СуммаСтроки;

		СтрокаТовара.Склад        = Параметры.СкладЗаказов;
		СтрокаТовара.ДатаОтгрузки = ТекущаяДатаЗаказа;

		// Резервировать на складе
		СтрокаТовара.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;

		СуммаДокумента = СуммаДокумента + СуммаСтроки;

	КонецЦикла;

	Документ.СуммаДокумента = СуммаДокумента;

	// 4. Запись: сначала с проведением (резерв). Если не проводится - сохраняем без проведения,
	//    чтобы заказ не потерялся, и сообщаем причину.
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение

		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

		Попытка
			Документ.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ТекстОшибки = ТекстОшибки + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Неопределено;
		КонецПопытки;

	КонецПопытки;

	Возврат Документ.Ссылка;

КонецФункции

Функция ПриоритетПоУмолчанию()

	Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Середній");
	Если Приоритет.Пустая() Тогда
		Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");
	КонецЕсли;

	Возврат Приоритет;

КонецФункции

// Процент ставки НДС из представления значения перечисления ("20%", "7%"); для "Без НДС" и "0%" - 0.
Функция ПроцентСтавкиНДС(СтавкаНДС)

	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(СокрЛП(СтрЗаменить(Строка(СтавкаНДС), "%", "")));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Процедура ДобавитьСтрокуИнформации(Строки, Заголовок, Значение)

	Текст = keycrm_API.СтрокаИз(Значение);
	Если Текст <> "" Тогда
		Строки.Добавить(Заголовок + ": " + Текст);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьЧастьАдреса(Части, Значение)

	Текст = keycrm_API.СтрокаИз(Значение);
	Если Текст <> "" Тогда
		Части.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

