// Общий модуль tsms_Логирование
// Свойства: Сервер = Истина, Вызов сервера = Ложь, Привилегированный = Истина
// (привилегированный - чтобы запись в лог не падала из-за прав пользователя
//  при тестовой отправке из формы)

#Область ПрограммныйИнтерфейс

// Записывает событие в РС tsms_ЖурналЛогирования.
//
// Параметры:
//  Уровень   - ПеречислениеСсылка.tsms_УровниЛогирования
//  Событие   - ПеречислениеСсылка.tsms_СобытияЛогирования
//  Сообщение - Строка - короткое описание для пользователя
//  Контекст  - Структура, Неопределено - необязательные поля:
//              ИдентификаторЗапуска, ВидОповещения, Партнер, Канал, НомерТелефона, Подробности
//
Процедура Записать(Уровень, Событие, Сообщение, Контекст = Неопределено) Экспорт
	
	Попытка
		
		МЗ = РегистрыСведений.tsms_ЖурналЛогирования.СоздатьМенеджерЗаписи();
		
		Если ТипЗнч(Контекст) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(МЗ, Контекст);
		КонецЕсли;
		
		МЗ.Период              = ТекущаяДатаСеанса();
		МЗ.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
		МЗ.Уровень             = Уровень;
		МЗ.Событие             = Событие;
		МЗ.Сообщение           = Лев(Сообщение, 1024);
		
		МЗ.Записать();
		
	Исключение
		// Лог не должен ронять рассылку - дублируем в журнал регистрации
		ЗаписьЖурналаРегистрации("TurboSMS - Ошибка логирования",
			УровеньЖурналаРегистрации.Ошибка, , ,
			Сообщение + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура Информация(Событие, Сообщение, Контекст = Неопределено) Экспорт
	Записать(Перечисления.tsms_УровниЛогирования.Информация, Событие, Сообщение, Контекст);
КонецПроцедуры

Процедура Предупреждение(Событие, Сообщение, Контекст = Неопределено) Экспорт
	Записать(Перечисления.tsms_УровниЛогирования.Предупреждение, Событие, Сообщение, Контекст);
КонецПроцедуры

Процедура Ошибка(Событие, Сообщение, Контекст = Неопределено) Экспорт
	Записать(Перечисления.tsms_УровниЛогирования.Ошибка, Событие, Сообщение, Контекст);
КонецПроцедуры

// Удаляет записи старше ХранитьДней.
// Вызывается регламентным заданием tsms_ОчисткаЖурналаЛогирования.
Процедура УдалитьСтарыеЗаписи(ХранитьДней = 180) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Ж.Период КАК Период,
		|	Ж.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.tsms_ЖурналЛогирования КАК Ж
		|ГДЕ
		|	Ж.Период < &Граница";
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДатаСеанса()) - ХранитьДней * 86400);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НЗ = РегистрыСведений.tsms_ЖурналЛогирования.СоздатьНаборЗаписей();
		НЗ.Отбор.Период.Установить(Выборка.Период);
		НЗ.Отбор.ИдентификаторЗаписи.Установить(Выборка.ИдентификаторЗаписи);
		НЗ.Записать();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
