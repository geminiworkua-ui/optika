#Область ПрограммныйИнтерфейс

// Точка входа регламентного задания keycrm_Обмен. Выгружает только изменения.
Процедура ВыполнитьОбменРегламент() Экспорт

	ВыполнитьОбмен("Изменения");

КонецПроцедуры

// Выполняет операцию обмена. Вызывается регламентным заданием и фоновым заданием из обработки.
//
// Параметры:
//  Операция - Строка - "Изменения", "ТоварыПолностью", "ЦеныОстаткиПолностью", "Сопоставление", "Заказы"
//  ОтборНоменклатуры - Массив, Неопределено - элементы и группы номенклатуры для ручных операций.
//                      Неопределено или пустой массив - берется отбор из настройки.
//  Настройка - СправочникСсылка.keycrm_НастройкиОбмена, Неопределено - если не указана, берется активная.
//
Процедура ВыполнитьОбмен(Операция, ОтборНоменклатуры = Неопределено, Настройка = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Настройка = АктивнаяНастройка();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат; // обмен не настроен или отключен
	КонецЕсли;

	Параметры = ПараметрыНастройки(Настройка);
	Контекст  = keycrm_API.НовыйКонтекст(Параметры);

	Если Не ЗначениеЗаполнено(Параметры.ТокенAPI) Тогда
		keycrm_Логирование.Ошибка("Обмен", "Не заполнен токен API в настройке обмена", Контекст);
		Возврат;
	КонецЕсли;

	Если ВыполняетсяДругойОбменKeyCRM() Тогда
		keycrm_Логирование.Предупреждение("Обмен",
			"Операция """ + Операция + """ пропущена: предыдущий обмен с KeyCRM еще выполняется", Контекст);
		Возврат;
	КонецЕсли;

	// Для ручных операций отбор из обработки важнее отбора из настройки
	Если ТипЗнч(ОтборНоменклатуры) = Тип("Массив") И ОтборНоменклатуры.Количество() > 0 Тогда
		Отбор = ОтборНоменклатуры;
	Иначе
		Отбор = Параметры.ОтборНоменклатуры;
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итоги  = Новый Массив;

	Попытка

		Если Операция = "Изменения" Тогда

			Если Параметры.ВыгружатьТовары Тогда
				Итоги.Добавить(keycrm_Товары.ВыгрузитьИзменения(Контекст));
			КонецЕсли;

			Если Параметры.ВыгружатьЦены Тогда
				Итоги.Добавить(keycrm_ЦеныОстатки.ВыгрузитьЦены(Контекст, Истина, Неопределено));
			КонецЕсли;

			Если Параметры.ВыгружатьОстатки Тогда
				Если ВыполняетсяОбменДиггер() Тогда
					Итоги.Добавить("остатки пропущены (идет обмен с Диггером)");
				Иначе
					Итоги.Добавить(keycrm_ЦеныОстатки.ВыгрузитьОстатки(Контекст, Истина, Неопределено));
				КонецЕсли;
			КонецЕсли;

			Если Параметры.ЗагружатьЗаказы Тогда
				Итоги.Добавить(keycrm_Заказы.ЗагрузитьЗаказы(Контекст));
			КонецЕсли;

			keycrm_Логирование.УдалитьСтарыеЗаписи(Параметры.СрокХраненияЖурнала);

		ИначеЕсли Операция = "ТоварыПолностью" Тогда

			Итоги.Добавить(keycrm_Товары.ВыгрузитьПолностью(Контекст, Отбор));

		ИначеЕсли Операция = "ЦеныОстаткиПолностью" Тогда

			Итоги.Добавить(keycrm_ЦеныОстатки.ВыгрузитьЦены(Контекст, Ложь, Отбор));

			Если ВыполняетсяОбменДиггер() Тогда
				Итоги.Добавить("остатки пропущены (идет обмен с Диггером), повторите позже");
			Иначе
				Итоги.Добавить(keycrm_ЦеныОстатки.ВыгрузитьОстатки(Контекст, Ложь, Отбор));
			КонецЕсли;

		ИначеЕсли Операция = "Сопоставление" Тогда

			Итоги.Добавить(keycrm_Товары.Сопоставить(Контекст, Отбор));

		ИначеЕсли Операция = "Заказы" Тогда

			Итоги.Добавить(keycrm_Заказы.ЗагрузитьЗаказы(Контекст));

		Иначе

			keycrm_Логирование.Ошибка("Обмен", "Неизвестная операция: " + Операция, Контекст);
			Возврат;

		КонецЕсли;

	Исключение

		keycrm_Логирование.Ошибка("Обмен", "Операция """ + Операция + """ прервана из-за ошибки", Контекст, ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;

	КонецПопытки;

	// В журнал пишем только запуски, в которых что-то происходило, чтобы не засорять его каждые 5 минут
	ТекстИтогов = "";
	Для Каждого Итог Из Итоги Цикл
		Если ЗначениеЗаполнено(Итог) Тогда
			ТекстИтогов = ТекстИтогов + ?(ТекстИтогов = "", "", "; ") + Итог;
		КонецЕсли;
	КонецЦикла;

	Если ТекстИтогов <> "" Или Операция <> "Изменения" Тогда
		Длительность = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000);
		keycrm_Логирование.Информация("Обмен",
			"Операция """ + Операция + """ завершена за " + Формат(Длительность, "ЧН=0; ЧГ=0") + " сек., запросов к API: "
			+ Формат(Контекст.КоличествоЗапросов, "ЧН=0; ЧГ=0")
			+ ?(ТекстИтогов = "", "", ". " + ТекстИтогов), Контекст);
	КонецЕсли;

КонецПроцедуры

// Обработчик подписки keycrm_РегистрацияИзмененийНоменклатуры (ПриЗаписи справочников Номенклатура
// и ХарактеристикиНоменклатуры). Ставит номенклатуру в очередь на проверку и выгрузку.
// ВАЖНО: признак ОбменДанными.Загрузка намеренно не проверяется - обмен с Диггером пишет именно в этом режиме.
Процедура ЗарегистрироватьИзменениеПриЗаписи(Источник, Отказ) Экспорт

	Если ТипЗнч(Источник) = Тип("СправочникОбъект.Номенклатура") Тогда

		Если Источник.ЭтоГруппа Тогда
			Возврат;
		КонецЕсли;
		Номенклатура = Источник.Ссылка;

	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.ХарактеристикиНоменклатуры") Тогда

		Номенклатура = Источник.Владелец;
		Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
			Возврат; // общие характеристики вида номенклатуры не выгружаются
		КонецЕсли;

	Иначе
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Номенклатура) Или Не РегистрацияИзмененийВключена() Тогда
		Возврат;
	КонецЕсли;

	МЗ = РегистрыСведений.keycrm_ОчередьВыгрузки.СоздатьМенеджерЗаписи();
	МЗ.Номенклатура    = Номенклатура;
	МЗ.ДатаРегистрации = ТекущаяДатаСеанса();
	МЗ.Попыток         = 0;
	МЗ.Записать(Истина);

КонецПроцедуры

// Возвращает активную настройку обмена (первую с флагом Используется) или Неопределено.
Функция АктивнаяНастройка() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.keycrm_НастройкиОбмена КАК Настройки
		|ГДЕ
		|	Настройки.Используется
		|	И НЕ Настройки.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Настройки.Код";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Читает настройку обмена в структуру: все реквизиты + массивы Склады и ОтборНоменклатуры.
Функция ПараметрыНастройки(Настройка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Настройки.Ссылка КАК Ссылка,
		|	Настройки.ТокенAPI КАК ТокенAPI,
		|	Настройки.ЗапросовВМинуту КАК ЗапросовВМинуту,
		|	Настройки.ВыгружатьТовары КАК ВыгружатьТовары,
		|	Настройки.ВыгружатьЦены КАК ВыгружатьЦены,
		|	Настройки.ВыгружатьОстатки КАК ВыгружатьОстатки,
		|	Настройки.ЗагружатьЗаказы КАК ЗагружатьЗаказы,
		|	Настройки.ВидЦены КАК ВидЦены,
		|	Настройки.ИДСкладаKeyCRM КАК ИДСкладаKeyCRM,
		|	Настройки.ИспользоватьАртикулВSKU КАК ИспользоватьАртикулВSKU,
		|	Настройки.ТоваровЗаЗапуск КАК ТоваровЗаЗапуск,
		|	Настройки.СрокХраненияЖурнала КАК СрокХраненияЖурнала,
		|	Настройки.Организация КАК Организация,
		|	Настройки.СкладЗаказов КАК СкладЗаказов,
		|	Настройки.Партнер КАК Партнер,
		|	Настройки.Контрагент КАК Контрагент,
		|	Настройки.Соглашение КАК Соглашение,
		|	Настройки.ДатаНачалаЗагрузкиЗаказов КАК ДатаНачалаЗагрузкиЗаказов
		|ИЗ
		|	Справочник.keycrm_НастройкиОбмена КАК Настройки
		|ГДЕ
		|	Настройки.Ссылка = &Настройка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Склады.Склад КАК Склад
		|ИЗ
		|	Справочник.keycrm_НастройкиОбмена.Склады КАК Склады
		|ГДЕ
		|	Склады.Ссылка = &Настройка
		|	И Склады.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Отбор.Номенклатура КАК Номенклатура
		|ИЗ
		|	Справочник.keycrm_НастройкиОбмена.ОтборНоменклатуры КАК Отбор
		|ГДЕ
		|	Отбор.Ссылка = &Настройка
		|	И Отбор.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Настройка", Настройка);

	Пакет = Запрос.ВыполнитьПакет();

	Параметры = Новый Структура;

	ТаблицаШапки = Пакет[0].Выгрузить();
	Если ТаблицаШапки.Количество() = 0 Тогда
		ВызватьИсключение "Не найдена настройка обмена с KeyCRM";
	КонецЕсли;

	Для Каждого Колонка Из ТаблицаШапки.Колонки Цикл
		Параметры.Вставить(Колонка.Имя, ТаблицаШапки[0][Колонка.Имя]);
	КонецЦикла;

	Параметры.Вставить("Склады", Пакет[1].Выгрузить().ВыгрузитьКолонку("Склад"));
	Параметры.Вставить("ОтборНоменклатуры", Пакет[2].Выгрузить().ВыгрузитьКолонку("Номенклатура"));

	Если Параметры.ТоваровЗаЗапуск <= 0 Тогда
		Параметры.ТоваровЗаЗапуск = 30;
	КонецЕсли;

	Возврат Параметры;

КонецФункции

// Истина, если сейчас выполняется одно из регламентных заданий обмена с Диггером
// (в это время документы ввода остатков перезаписываются по одному складу).
Функция ВыполняетсяОбменДиггер() Экспорт

	МетодыДиггера = Новый Массив;
	МетодыДиггера.Добавить("ИНФРАЛАЙНОБМЕН.ВЫПОЛНИТЬОБМЕННАСЕРВЕРЕРЕГЛАМЕНТ");
	МетодыДиггера.Добавить("ЗАГРУЗКАОСТАТКОВИЗДИГГЕР.ЗАГРУЗИТЬОСТАТКИИЗДИГГЕР");
	МетодыДиггера.Добавить("ОБМЕНОСТАТКИИЗДИГЕРПОЛНЫЙ.ЗАГРУЗИТЬОСТАТКИИЗДИГЕРПОЛНЫЙНАСЕРВЕРЕ");

	Отбор = Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно);

	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Если МетодыДиггера.Найти(ВРег(Задание.ИмяМетода)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РегистрацияИзмененийВключена()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Включена
		|ИЗ
		|	Справочник.keycrm_НастройкиОбмена КАК Настройки
		|ГДЕ
		|	Настройки.Используется
		|	И Настройки.ВыгружатьТовары
		|	И НЕ Настройки.ПометкаУдаления";

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Истина, если уже выполняется другое задание обмена с KeyCRM (регламентное или запущенное из обработки).
Функция ВыполняетсяДругойОбменKeyCRM()

	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();

	Отбор = Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно);

	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл

		Если ТекущееЗадание <> Неопределено
			И Задание.УникальныйИдентификатор = ТекущееЗадание.УникальныйИдентификатор Тогда
			Продолжить;
		КонецЕсли;

		Если СтрНайти(ВРег(Задание.ИмяМетода), "KEYCRM_ОБМЕН.ВЫПОЛНИТЬОБМЕН") = 1 Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

