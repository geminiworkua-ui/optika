Функция НайтиКонтрагента(КодПоЕДРПОУ, ИНН, УИД) Экспорт
  Ссылка = Неопределено;	
  Если Не УИД ="" Тогда
	   Ссылка = ПолучитьСсылкуПоУИД(УИД, "СправочникСсылкаКонтрагенты", "СправочникСсылкаКонтрагенты", УзелБУ());
	   
	   Если Не Ссылка = Неопределено Тогда
		   Возврат Строка(Ссылка.УникальныйИдентификатор());
	   КонецЕсли;
  КонецЕсли;
   
  Если Не КодПоЕДРПОУ ="" Тогда
   Ссылка = НайтиПоЕДРПОУ(КодПоЕДРПОУ);
  КОнецЕсли;	  
   
  Если Не Ссылка = Неопределено Тогда
    Возврат Строка(ссылка.УникальныйИдентификатор());
  КонецЕсли;	
   
  Если Не ИНН ="" Тогда
    Ссылка = НайтиПоИНН(Инн);
  КОнецЕсли;	  
   
  Если Не Ссылка = Неопределено Тогда
	    Возврат Строка(ссылка.УникальныйИдентификатор());
  КонецЕсли;	

КонецФункции

