Функция НайтиТовар(КодБухгалтерии, УИД, Поставщик = Неопределено) Экспорт 
	
  Если Не УИД ="" Тогда
	   Ссылка = ПолучитьСсылкуПоУИД(УИД, "СправочникСсылкаНоменклатура", "СправочникСсылкаНоменклатураПоставщиков", УзелБУ());
	   
	   Если Не Ссылка = Неопределено Тогда
		   Возврат Строка(Ссылка.УникальныйИдентификатор());
	   КонецЕсли;
   КонецЕсли;
   
   Если КодБухгалтерии ="" Тогда
	   Возврат Неопределено;
   КОнецЕсли;	   
   
   //Далее ищем Номенклатуру по коду бухгатерии
   
   НоменклатураСсылка = Справочники.Номенклатура.НайтиПоКоду(КодБухгалтерии);
   
   Если Не НоменклатураСсылка = Справочники.Номенклатура.ПустаяСсылка() Тогда
	   
	   Ссылка = ПолучитьНоменклатуруПоставщикаПоТовару(НоменклатураСсылка,"Номенклатура", УИД, Поставщик);
	   Если Не Ссылка = Неопределено Тогда
		   Возврат Строка(ссылка.УникальныйИдентификатор());
	   КонецЕсли;   
	КонецЕсли;	   
   
   ХарактеристикаСсылка = Справочники.ХарактеристикиНоменклатуры.НайтиПоКоду(КодБухгалтерии);
   
   Если Не ХарактеристикаСсылка = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка() Тогда
	   
	   Ссылка = ПолучитьНоменклатуруПоставщикаПоТовару(ХарактеристикаСсылка,"ХарактеристикиНоменклатуры", УИД);
	   Если Не Ссылка = Неопределено Тогда
		   Возврат Строка(ссылка.УникальныйИдентификатор());
	   КОнецЕсли;   
	   Возврат Неопределено;
   КОнецЕсли;	   

КонецФункции	

Функция СоздатьНоменклатуруПоставщика(УИД, ВидМетаданных, Номенклатура, Характеристика, Поставщик =Неопределено, УзелБУ =Неопределено)
	Если УзелБУ = Неопределено Тогда
		УзелБУ =УзелБУ();
	КонецЕсли;
	Если УзелБУ=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Поставщик =Неопределено Тогда
		Поставщик = ПоставщикПоУмолчанию();
	КОнецЕсли;	
	
	Если Характеристика = Неопределено Тогда
		Если Номенклатура = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;	
		НоваяНомПост = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
		НоваяНомПост.Наименование = Номенклатура.Наименование;
		НоваяНомПост.Номенклатура = Номенклатура;
		НоваяНомПост.Упаковка     = НоваяНомПост.Номенклатура.ЕдиницаИзмерения;
		НоваяНомПост.Артикул      = НоваяНомПост.Номенклатура.Артикул;
		НоваяНомПост.Владелец     = Поставщик;
		НоваяНомПост.ОбменДанными.Загрузка = Истина;
		НоваяНомПост.Записать();    
		ДобавитьДанные( НоваяНомПост.Ссылка, УИД, "СправочникСсылкаНоменклатура", "СправочникСсылкаНоменклатураПоставщиков", УзелБУ);
		Возврат НоваяНомПост.Ссылка;
	Иначе	
		НоваяНомПост = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
		НоваяНомПост.Наименование = Характеристика.Владелец.Наименование +"("+Характеристика.Наименование+")";
		НоваяНомПост.Номенклатура = Характеристика.Владелец;
		НоваяНомПост.Упаковка     = НоваяНомПост.Номенклатура.ЕдиницаИзмерения;
		НоваяНомПост.Артикул      = НоваяНомПост.Номенклатура.Артикул;
		НоваяНомПост.Владелец     = Поставщик;
		НоваяНомПост.ОбменДанными.Загрузка = Истина;
		НоваяНомПост.Записать();
		ДобавитьДанные( НоваяНомПост.Ссылка, УИД, "СправочникСсылкаНоменклатура", "СправочникСсылкаНоменклатураПоставщиков", УзелБУ);
		Возврат Строка(НоваяНомПост.Ссылка.УникальныйИдентификатор());
	КонецЕсли;
КонецФункции

