Функция УзелБУ()
	Запрос = новый Запрос(
    "ВЫБРАТЬ
    |	ОбменБУ.Ссылка КАК Ссылка
    |ИЗ
    |	ПланОбмена.ОбменСБухгалтерией КАК ОбменБУ
    |ГДЕ
    |	НЕ ОбменБУ.ЭтотУзел");
	Результат  =Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.ссылка;
	КонецЕсли;	
КонецФункции

Функция ПолучитьСсылкуПоУИД(УникальныйИдентификаторПриемника,ТипПриемника, ТипИсточника, УзелИнформационнойБазы)
Если УзелИнформационнойБазы = Неопределено Тогда
	УзелИнформационнойБазы =  УзелБУ();
КОнецЕсли;

Если УзелИнформационнойБазы = Неопределено Тогда
	Возврат Неопределено;
КонецЕсли;	

Запрос  =Новый Запрос(
"ВЫБРАТЬ
|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника КАК УникальныйИдентификаторИсточника
|ИЗ
|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
|ГДЕ
|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &УзелИнформационнойБазы
|	И СоответствияОбъектовИнформационныхБаз.ТипИсточника = &ТипИсточника
|	И СоответствияОбъектовИнформационныхБаз.ТипПриемника = &ТипПриемника
|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника = &УникальныйИдентификаторПриемника");
Запрос.УстановитьПараметр("УзелИнформационнойБазы", УзелИнформационнойБазы);
Запрос.УстановитьПараметр("ТипИсточника", ТипИсточника);
Запрос.УстановитьПараметр("ТипПриемника", ТипПриемника);
Запрос.УстановитьПараметр("УникальныйИдентификаторПриемника", УникальныйИдентификаторПриемника);
Результат  =Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	Возврат Результат.УникальныйИдентификаторИсточника;
КОнецЕсли;
КОнецФункции

Процедура ДобавитьДанные(УникальныйИдентификаторИсточника, УникальныйИдентификаторПриемника,ТипПриемника, ТипИсточника, УзелИнформационнойБазы)
Если УзелИнформационнойБазы = Неопределено Тогда
	УзелИнформационнойБазы =  УзелБУ();
КОнецЕсли;

Если УзелИнформационнойБазы = Неопределено Тогда
	Возврат;
КонецЕсли;	

НаборЗаписей = регистрыСведений.СоответствияОбъектовИнформационныхБаз.СоздатьНаборЗаписей();
НаборЗаписей.Отбор.УникальныйИдентификаторИсточника.Установить(УникальныйИдентификаторИсточника);
НаборЗаписей.Отбор.УникальныйИдентификаторПриемника.Установить(УникальныйИдентификаторПриемника);
НаборЗаписей.Отбор.УзелИнформационнойБазы.Установить(УзелИнформационнойБазы);
НаборЗаписей.Отбор.ТипИсточника.Установить(ТипИсточника);
НаборЗаписей.Отбор.ТипПриемника.Установить(ТипПриемника);
НаборЗаписей.Прочитать();
Если НаборЗаписей.Количество() =0 Тогда
	Запись = НаборЗаписей.Добавить();
	Запись.УникальныйИдентификаторИсточника = УникальныйИдентификаторИсточника;
	Запись.УникальныйИдентификаторПриемника = УникальныйИдентификаторПриемника;
	Запись.УзелИнформационнойБазы = УзелИнформационнойБазы;
	Запись.ТипИсточника = ТипИсточника;
	Запись.ТипПриемника = ТипПриемника;
	НаборЗаписей.Записать(Истина);
КонецЕсли;	
КонецПроцедуры

Функция ПолучитьСсылку(УИД, ТипМетаданных, ВидМетаданных) Экспорт
	Ссылка = Неопределено;
	
	Если  ТипМетаданных = "Справочники" Тогда
		Ссылка = Справочники[ВидМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	ИначеЕсли ТипМетаданных = "Документы" Тогда	
		Ссылка = Документы[ВидМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));	
	КонецЕсли;	
	
	Если Ссылка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Ссылка.ПолучитьОбъект() =Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ссылка;
КонецФункции	

Функция ПолучитьНоменклатуруПоставщикаПоНоменклатуре(УИД, ВидМетаданных, Поставщик =Неопределено) Экспорт   
	Номенклатура =Неопределено;
	Характеристика = Неопределено;
	Если ВидМетаданных = "Номенклатура" Тогда
		Номенклатура = ПолучитьСсылку(УИД, "Справочники", "Номенклатура");
		Если Номенклатура =Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Запрос = Новый Запрос(
		 "ВЫБРАТЬ
		 |	НоменклатураПоставщиков.Ссылка
		 |ИЗ
		 |	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
		 |ГДЕ
		 |	НоменклатураПоставщиков.Номенклатура = &Номенклатура
		 |	И НЕ НоменклатураПоставщиков.ПометкаУдаления");
		 Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	 ИначеЕсли ВидМетаданных = "ХарактеристикиНоменклатуры" Тогда
		Характеристика = ПолучитьСсылку(УИД, "Справочники", "ХарактеристикиНоменклатуры");
		Если Характеристика =Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Запрос = Новый Запрос(
		 "ВЫБРАТЬ
		 |	НоменклатураПоставщиков.Ссылка
		 |ИЗ
		 |	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
		 |ГДЕ
		 |	НоменклатураПоставщиков.Характеристика = &Характеристика
		 |	И НЕ НоменклатураПоставщиков.ПометкаУдаления");
		 Запрос.УстановитьПараметр("Характеристика", Характеристика); 
	 КонецЕсли;	 
	 Если Не Поставщик =Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "	И НоменклатураПоставщиков.Владелец = &Поставщик"; 
		Запрос.УстановитьПараметр("Поставщик", Поставщик);
	 КонецЕсли;	 
	 
	 Результат = Запрос.Выполнить().Выбрать();
	 Если Результат.Следующий() Тогда
		 Возврат Результат.ссылка;
	 КонецЕсли;
	 
	 Возврат СоздатьНоменклатуруПоставщика(УИД, ВидМетаданных, Номенклатура, Характеристика, Поставщик);
КОнецФункции	

