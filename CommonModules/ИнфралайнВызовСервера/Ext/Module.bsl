

Функция УстановитьЦенуСУчетомУпаковки(СтрокаТЧ) Экспорт
	
	П = Новый Структура("ВидЦены, Цена", Справочники.ВидыЦен.НайтиПоНаименованию("Роздрібна"), 0);
	Если СтрокаТЧ = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Если СтрокаТЧ.Номенклатура.ИспользоватьУпаковки 
		И (НЕ СтрокаТЧ.Упаковка.Числитель = 0 
		ИЛИ НЕ СтрокаТЧ.Упаковка.Знаменатель = 0)
		Тогда
		// Значит это упаковка от ящика
		К = СтрокаТЧ.Упаковка.Числитель /?(НЕ СтрокаТЧ.Упаковка.Знаменатель = 0, СтрокаТЧ.Упаковка.Знаменатель, 1);
		П.ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Від ящика");
	ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.ВидЦены)
		ТОгда
		К = 1;
		П.ВидЦены = СтрокаТЧ.ВидЦены;
	Иначе
		К = 1;
		П.ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Роздрібна");
	КонецЕсли;
	П.Цена = К * Инфра_ОбщиеМодули.НайтиЦенуНаДату(СтрокаТЧ.Номенклатура, СтрокаТЧ.Характеристика, П.ВидЦены, ТекущаяДата());
	Возврат П;
	
КонецФункции
	