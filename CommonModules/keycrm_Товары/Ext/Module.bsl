// Термины KeyCRM: товар (product) = Номенклатура, вариант (offer) = Характеристика.
// Номенклатура без характеристик выгружается как товар с одним вариантом (SKU варианта = SKU товара).

//ДК: 13.11.2026

#Область ПрограммныйИнтерфейс

// Обрабатывает очередь измененной номенклатуры (РС keycrm_ОчередьВыгрузки).
// Карточка отправляется, только если изменился ее хеш; новые характеристики добавляются как варианты.
//
// Возвращаемое значение:
//  Строка - итог для журнала (пустая строка, если очередь пуста)
//
Функция ВыгрузитьИзменения(Контекст) Экспорт

	Параметры = Контекст.Настройка;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 30
		|	Очередь.Номенклатура КАК Номенклатура,
		|	Очередь.ДатаРегистрации КАК ДатаРегистрации,
		|	Очередь.Попыток КАК Попыток,
		|	ЕСТЬNULL(Очередь.Номенклатура.ПометкаУдаления, ИСТИНА) КАК ПометкаУдаления,
		|	ЕСТЬNULL(Очередь.Номенклатура.ЭтоГруппа, ИСТИНА) КАК ЭтоГруппа,
		|	ВЫБОР
		|		КОГДА &БезОтбора
		|				ИЛИ Очередь.Номенклатура В ИЕРАРХИИ (&Отбор)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ВОтборе
		|ИЗ
		|	РегистрСведений.keycrm_ОчередьВыгрузки КАК Очередь
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаРегистрации";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 30",
		"ПЕРВЫЕ " + Формат(Параметры.ТоваровЗаЗапуск, "ЧН=0; ЧГ=0"));
	Запрос.УстановитьПараметр("БезОтбора", Параметры.ОтборНоменклатуры.Количество() = 0);
	Запрос.УстановитьПараметр("Отбор", Параметры.ОтборНоменклатуры);

	Очередь = Запрос.Выполнить().Выгрузить();
	Если Очередь.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	КВыгрузке = Новый Массив;
	Для Каждого СтрокаОчереди Из Очередь Цикл
		Если СтрокаОчереди.ВОтборе И Не СтрокаОчереди.ПометкаУдаления И Не СтрокаОчереди.ЭтоГруппа Тогда
			КВыгрузке.Добавить(СтрокаОчереди.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Статистика = НоваяСтатистика();
	Результаты = Новый Соответствие;

	Если КВыгрузке.Количество() > 0 Тогда
		Результаты = ВыгрузитьПорцию(Контекст, КВыгрузке, Ложь, Статистика);
	КонецЕсли;

	// Чистим очередь
	Для Каждого СтрокаОчереди Из Очередь Цикл

		Успех = Результаты.Получить(СтрокаОчереди.Номенклатура);

		МЗ = РегистрыСведений.keycrm_ОчередьВыгрузки.СоздатьМенеджерЗаписи();
		МЗ.Номенклатура = СтрокаОчереди.Номенклатура;
		МЗ.Прочитать();
		Если Не МЗ.Выбран() Тогда
			Продолжить;
		КонецЕсли;

		Если Успех = Неопределено Или Успех = Истина Тогда
			// Вне отбора / удалена / выгружена. Если за время выгрузки объект записали еще раз -
			// дата регистрации изменилась, оставляем в очереди до следующего запуска.
			Если МЗ.ДатаРегистрации = СтрокаОчереди.ДатаРегистрации Тогда
				МЗ.Удалить();
			КонецЕсли;
		Иначе
			Если СтрокаОчереди.Попыток >= 4 Тогда
				МЗ.Удалить();
				keycrm_Логирование.Ошибка("Товары",
					"Номенклатура исключена из очереди после 5 неудачных попыток выгрузки", Контекст,
					СтрокаОчереди.Номенклатура);
			Иначе
				МЗ.Попыток = СтрокаОчереди.Попыток + 1;
				МЗ.Записать();
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат ТекстСтатистики(Статистика);

КонецФункции

// Полная выгрузка карточек по отбору (ручная операция): все карточки отправляются заново,
// недостающие варианты создаются.
Функция ВыгрузитьПолностью(Контекст, Отбор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ЭтоГруппа
		|	И НЕ Номенклатура.ПометкаУдаления
		|	И (&БезОтбора
		|			ИЛИ Номенклатура.Ссылка В ИЕРАРХИИ (&Отбор))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура.Код";
	Запрос.УстановитьПараметр("БезОтбора", Отбор.Количество() = 0);
	Запрос.УстановитьПараметр("Отбор", Отбор);

	ВсяНоменклатура = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	keycrm_Логирование.Информация("Товары",
		"Полная выгрузка: отобрано номенклатуры " + Формат(ВсяНоменклатура.Количество(), "ЧН=0; ЧГ=0"), Контекст);

	Статистика = НоваяСтатистика();
	Порция = Новый Массив;

	Для Индекс = 0 По ВсяНоменклатура.Количество() - 1 Цикл

		Порция.Добавить(ВсяНоменклатура[Индекс]);

		Если Порция.Количество() = 50 Или Индекс = ВсяНоменклатура.Количество() - 1 Тогда
			ВыгрузитьПорцию(Контекст, Порция, Истина, Статистика);
			Порция = Новый Массив;
		КонецЕсли;

	КонецЦикла;

	Возврат ТекстСтатистики(Статистика);

КонецФункции

// Сопоставление: читает все варианты из KeyCRM и по SKU находит номенклатуру/характеристику в 1С.
// Заполняет регистры соответствий, ничего не создает и не меняет в KeyCRM.
// Понимает SKU вида:
//   <Код или Артикул номенклатуры>_<Код характеристики>
//   <что угодно>_<UUID характеристики>           (старая схема Артикул_UUID)
//   <Код или Артикул номенклатуры>                (товар без характеристик)
Функция Сопоставить(Контекст, Отбор) Экспорт

	Найдено = 0;
	НеНайдено = 0;
	Неоднозначно = 0;
	Страница = 1;

	ОписаниеСтроки100 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100));
	ОписаниеЧисла     = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));

	Пока Истина Цикл

		Ответ = keycrm_API.ВыполнитьЗапрос(Контекст, "GET",
			"/offers?limit=50&page=" + keycrm_API.ИДСтрокой(Страница));

		Если Не Ответ.Успех Тогда
			keycrm_Логирование.Ошибка("Сопоставление", "Ошибка получения списка вариантов, страница "
				+ keycrm_API.ИДСтрокой(Страница), Контекст, , Ответ.ОписаниеОшибки);
			Прервать;
		КонецЕсли;

		Офферы = keycrm_API.МассивДанных(Ответ.Данные);
		Если Офферы.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("SKU", ОписаниеСтроки100);
		Таблица.Колонки.Добавить("Префикс", ОписаниеСтроки100);
		Таблица.Колонки.Добавить("КодХарактеристики", ОписаниеСтроки100);
		Таблица.Колонки.Добавить("ХарактеристикаПоUUID", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		Таблица.Колонки.Добавить("ИДВарианта", ОписаниеЧисла);
		Таблица.Колонки.Добавить("ИДТовара", ОписаниеЧисла);
		Таблица.Колонки.Добавить("Цена", ОписаниеЧисла);

		Для Каждого Оффер Из Офферы Цикл

			SKU = keycrm_API.СтрокаИз(keycrm_API.Зн(Оффер, "sku"));
			Если SKU = "" Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.SKU        = SKU;
			НоваяСтрока.ИДВарианта = keycrm_API.ЧислоИз(keycrm_API.Зн(Оффер, "id"));
			НоваяСтрока.ИДТовара   = keycrm_API.ЧислоИз(keycrm_API.Зн(Оффер, "product_id"));
			НоваяСтрока.Цена       = keycrm_API.ЧислоИз(keycrm_API.Зн(Оффер, "price"));
			НоваяСтрока.ХарактеристикаПоUUID = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

			ПозицияРазделителя = ПозицияПоследнегоРазделителя(SKU);
			Если ПозицияРазделителя > 0 Тогда
				ПраваяЧасть = Сред(SKU, ПозицияРазделителя + 1);
				НоваяСтрока.Префикс = Лев(SKU, ПозицияРазделителя - 1);
				Если СтрДлина(ПраваяЧасть) = 36 И СтрЧислоВхождений(ПраваяЧасть, "-") = 4 Тогда
					Попытка
						НоваяСтрока.ХарактеристикаПоUUID = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(
							Новый УникальныйИдентификатор(ПраваяЧасть));
					Исключение
						НоваяСтрока.КодХарактеристики = ПраваяЧасть;
					КонецПопытки;
				Иначе
					НоваяСтрока.КодХарактеристики = ПраваяЧасть;
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;

		Если Таблица.Количество() > 0 Тогда

			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Т.SKU КАК SKU,
				|	Т.Префикс КАК Префикс,
				|	Т.КодХарактеристики КАК КодХарактеристики,
				|	Т.ХарактеристикаПоUUID КАК ХарактеристикаПоUUID,
				|	Т.ИДВарианта КАК ИДВарианта,
				|	Т.ИДТовара КАК ИДТовара,
				|	Т.Цена КАК Цена
				|ПОМЕСТИТЬ ВтОфферы
				|ИЗ
				|	&Таблица КАК Т
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	Найденные.SKU КАК SKU,
				|	Найденные.ИДВарианта КАК ИДВарианта,
				|	Найденные.ИДТовара КАК ИДТовара,
				|	Найденные.Цена КАК Цена,
				|	Найденные.Номенклатура КАК Номенклатура,
				|	Найденные.Характеристика КАК Характеристика,
				|	ВЫБОР
				|		КОГДА &БезОтбора
				|				ИЛИ Найденные.Номенклатура В ИЕРАРХИИ (&Отбор)
				|			ТОГДА ИСТИНА
				|		ИНАЧЕ ЛОЖЬ
				|	КОНЕЦ КАК ВОтборе
				|ИЗ
				|	(ВЫБРАТЬ
				|		Т.SKU КАК SKU,
				|		Т.ИДВарианта КАК ИДВарианта,
				|		Т.ИДТовара КАК ИДТовара,
				|		Т.Цена КАК Цена,
				|		ВЫРАЗИТЬ(Характеристики.Владелец КАК Справочник.Номенклатура) КАК Номенклатура,
				|		Характеристики.Ссылка КАК Характеристика
				|	ИЗ
				|		ВтОфферы КАК Т
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК Характеристики
				|			ПО Т.ХарактеристикаПоUUID = Характеристики.Ссылка
				|	ГДЕ
				|		Т.ХарактеристикаПоUUID <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
				|		И Характеристики.Владелец ССЫЛКА Справочник.Номенклатура
				|
				|	ОБЪЕДИНИТЬ ВСЕ
				|
				|	ВЫБРАТЬ
				|		Т.SKU,
				|		Т.ИДВарианта,
				|		Т.ИДТовара,
				|		Т.Цена,
				|		Номенклатура.Ссылка,
				|		Характеристики.Ссылка
				|	ИЗ
				|		ВтОфферы КАК Т
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК Характеристики
				|			ПО Т.КодХарактеристики = Характеристики.Код
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
				|			ПО (Характеристики.Владелец = Номенклатура.Ссылка)
				|				И (Номенклатура.Код = Т.Префикс
				|					ИЛИ Номенклатура.Артикул = Т.Префикс)
				|	ГДЕ
				|		Т.ХарактеристикаПоUUID = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
				|		И Т.КодХарактеристики <> """"
				|		И НЕ Характеристики.ПометкаУдаления
				|
				|	ОБЪЕДИНИТЬ ВСЕ
				|
				|	ВЫБРАТЬ
				|		Т.SKU,
				|		Т.ИДВарианта,
				|		Т.ИДТовара,
				|		Т.Цена,
				|		Номенклатура.Ссылка,
				|		ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
				|	ИЗ
				|		ВтОфферы КАК Т
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
				|			ПО (Номенклатура.Код = Т.SKU
				|					ИЛИ Номенклатура.Артикул = Т.SKU)
				|	ГДЕ
				|		Т.ХарактеристикаПоUUID = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
				|		И Т.КодХарактеристики = """"
				|		И НЕ Номенклатура.ЭтоГруппа
				|		И НЕ Номенклатура.ПометкаУдаления) КАК Найденные";
			Запрос.УстановитьПараметр("Таблица", Таблица);
			Запрос.УстановитьПараметр("БезОтбора", Отбор.Количество() = 0);
			Запрос.УстановитьПараметр("Отбор", Отбор);

			НайденныеСтроки = Запрос.Выполнить().Выгрузить();

			// Считаем количество совпадений на каждый SKU, чтобы отсеять неоднозначные
			Совпадений = Новый Соответствие;
			Для Каждого Найденная Из НайденныеСтроки Цикл
				Было = Совпадений.Получить(Найденная.SKU);
				Совпадений.Вставить(Найденная.SKU, ?(Было = Неопределено, 1, Было + 1));
			КонецЦикла;

			Для Каждого Найденная Из НайденныеСтроки Цикл

				Если Совпадений.Получить(Найденная.SKU) > 1 Тогда
					Продолжить;
				КонецЕсли;

				Если Не Найденная.ВОтборе Тогда
					Продолжить;
				КонецЕсли;

				ЗаписатьСоответствиеВарианта(Найденная.Номенклатура, Найденная.Характеристика, Найденная.SKU,
					Найденная.ИДВарианта, Найденная.Цена);
				ЗаписатьСоответствиеТовара(Найденная.Номенклатура, Найденная.ИДТовара, Неопределено);
				Найдено = Найдено + 1;

			КонецЦикла;

			Для Каждого СтрокаТаблицы Из Таблица Цикл
				Количество = Совпадений.Получить(СтрокаТаблицы.SKU);
				Если Количество = Неопределено Тогда
					НеНайдено = НеНайдено + 1;
					keycrm_Логирование.Предупреждение("Сопоставление",
						"Вариант KeyCRM не найден в 1С, SKU: " + СтрокаТаблицы.SKU, Контекст);
				ИначеЕсли Количество > 1 Тогда
					Неоднозначно = Неоднозначно + 1;
					keycrm_Логирование.Предупреждение("Сопоставление",
						"SKU соответствует нескольким позициям 1С, пропущен: " + СтрокаТаблицы.SKU, Контекст);
				КонецЕсли;
			КонецЦикла;

		КонецЕсли;

		Если Офферы.Количество() < 50 Тогда
			Прервать;
		КонецЕсли;

		Страница = Страница + 1;

	КонецЦикла;

	Возврат "сопоставлено вариантов: " + Формат(Найдено, "ЧН=0; ЧГ=0")
		+ ", не найдено в 1С: " + Формат(НеНайдено, "ЧН=0; ЧГ=0")
		+ ", неоднозначных: " + Формат(Неоднозначно, "ЧН=0; ЧГ=0");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВыгрузкаКарточек

// Выгружает порцию номенклатуры: создает/обновляет товар, создает недостающие варианты.
//
// Параметры:
//  МассивНоменклатуры - Массив из СправочникСсылка.Номенклатура
//  Принудительно - Булево - Истина: отправлять карточку, даже если хеш не изменился
//
// Возвращаемое значение:
//  Соответствие - Ключ: Номенклатура, Значение: Булево (успех)
//
Функция ВыгрузитьПорцию(Контекст, МассивНоменклатуры, Принудительно, Статистика)

	Результаты = Новый Соответствие;
	Параметры  = Контекст.Настройка;

	ПоляМаппинга = ОписаниеПолейМаппинга(Контекст);

	// 1. Данные карточек (один запрос на порцию, реквизиты для доп. полей подставляются динамически)
	ТекстПолей = "";
	Для Каждого Поле Из ПоляМаппинга Цикл
		Если Поле.ЭтоСсылка Тогда
			ТекстПолей = ТекстПолей + ",
				|	ПРЕДСТАВЛЕНИЕ(Номенклатура." + Поле.Реквизит + ") КАК " + Поле.Псевдоним;
		Иначе
			ТекстПолей = ТекстПолей + ",
				|	Номенклатура." + Поле.Реквизит + " КАК " + Поле.Псевдоним;
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Код КАК Код,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.Артикул КАК Артикул,
		|	Номенклатура.Описание КАК Описание,
		|	Номенклатура.ИспользованиеХарактеристик КАК ИспользованиеХарактеристик,
		|	ЕСТЬNULL(Товары.ИДТовара, 0) КАК ИДТовара,
		|	ЕСТЬNULL(Товары.ХешКарточки, """") КАК ХешКарточки" + ТекстПолей + "
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.keycrm_СоответствиеТоваров КАК Товары
		|		ПО Номенклатура.Ссылка = Товары.Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&МассивНоменклатуры)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Характеристики.Ссылка КАК Характеристика,
		|	ВЫРАЗИТЬ(Характеристики.Владелец КАК Справочник.Номенклатура) КАК Номенклатура,
		|	Характеристики.Код КАК Код,
		|	Характеристики.Наименование КАК Наименование,
		|	ПРЕДСТАВЛЕНИЕ(Характеристики._Сфера) КАК Сфера,
		|	ПРЕДСТАВЛЕНИЕ(Характеристики._Циліндр) КАК Цилиндр,
		|	ПРЕДСТАВЛЕНИЕ(Характеристики._Вісь) КАК Ось,
		|	ПРЕДСТАВЛЕНИЕ(Характеристики._Аддідація) КАК Аддидация,
		|	ПРЕДСТАВЛЕНИЕ(Характеристики._Диаметр) КАК Диаметр,
		|	ПРЕДСТАВЛЕНИЕ(Характеристики._Радіус) КАК Радиус,
		|	ПРЕДСТАВЛЕНИЕ(Характеристики._Дегресія) КАК Дегрессия,
		|	ПРЕДСТАВЛЕНИЕ(Характеристики._Цвет) КАК Цвет,
		|	ЕСТЬNULL(Варианты.SKU, """") КАК SKU,
		|	ВЫБОР
		|		КОГДА Варианты.Номенклатура ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Сопоставлена
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.keycrm_СоответствиеВариантов КАК Варианты
		|		ПО Характеристики.Ссылка = Варианты.Характеристика
		|			И Характеристики.Владелец = Варианты.Номенклатура
		|ГДЕ
		|	Характеристики.Владелец В(&МассивНоменклатуры)
		|	И НЕ Характеристики.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Варианты.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.keycrm_СоответствиеВариантов КАК Варианты
		|ГДЕ
		|	Варианты.Номенклатура В(&МассивНоменклатуры)
		|	И Варианты.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);

	Пакет = Запрос.ВыполнитьПакет();

	Карточки = Пакет[0].Выгрузить();
	ВсеХарактеристики = Пакет[1].Выгрузить();

	// Номенклатура, у которой уже сопоставлен вариант "без характеристики"
	ЕстьПростойВариант = Новый Соответствие;
	Для Каждого Найденная Из Пакет[2].Выгрузить() Цикл
		ЕстьПростойВариант.Вставить(Найденная.Номенклатура, Истина);
	КонецЦикла;

	// Характеристики по владельцам
	ХарактеристикиПоВладельцам = Новый Соответствие;
	Для Каждого СтрокаХарактеристики Из ВсеХарактеристики Цикл
		СтрокиВладельца = ХарактеристикиПоВладельцам.Получить(СтрокаХарактеристики.Номенклатура);
		Если СтрокиВладельца = Неопределено Тогда
			СтрокиВладельца = Новый Массив;
			ХарактеристикиПоВладельцам.Вставить(СтрокаХарактеристики.Номенклатура, СтрокиВладельца);
		КонецЕсли;
		СтрокиВладельца.Добавить(СтрокаХарактеристики);
	КонецЦикла;

	НеИспользовать = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
	Индивидуальные = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры;

	// 2. Обработка по одной номенклатуре
	Для Каждого Карточка Из Карточки Цикл

		Номенклатура = Карточка.Ссылка;
		Результаты.Вставить(Номенклатура, Ложь);

		ИспользуютсяХарактеристики = ЗначениеЗаполнено(Карточка.ИспользованиеХарактеристик)
			И Карточка.ИспользованиеХарактеристик <> НеИспользовать;

		Если ИспользуютсяХарактеристики И Карточка.ИспользованиеХарактеристик <> Индивидуальные Тогда
			// Общие характеристики вида номенклатуры не поддерживаются: SKU варианта не будет уникальным
			keycrm_Логирование.Предупреждение("Товары",
				"Пропущена: используются общие характеристики вида номенклатуры", Контекст, Номенклатура);
			Результаты.Вставить(Номенклатура, Истина); // убрать из очереди, повторять бессмысленно
			Статистика.Пропущено = Статистика.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		ПрефиксSKU = ПрефиксSKU(Карточка, Параметры);

		// --- Товар ---
		ТелоТовара = ТелоТовара(Карточка, ПрефиксSKU, ПоляМаппинга);
		ХешКарточки = keycrm_API.ХешСтроки(keycrm_API.ВJSON(ТелоТовара));
		ИДТовара = Карточка.ИДТовара;

		Если ИДТовара = 0 Тогда

			Ответ = keycrm_API.ВыполнитьЗапрос(Контекст, "POST", "/products", ТелоТовара);

			Если Ответ.Успех Тогда
				ИДТовара = keycrm_API.ЧислоИз(keycrm_API.Зн(Ответ.Данные, "id"));
			КонецЕсли;

			Если Не Ответ.Успех Или ИДТовара = 0 Тогда
				keycrm_Логирование.Ошибка("Товары", "Ошибка создания товара", Контекст, Номенклатура,
					Ответ.ОписаниеОшибки + Символы.ПС + Ответ.ТелоЗапроса + Символы.ПС + Ответ.ТекстОтвета);
				Статистика.Ошибок = Статистика.Ошибок + 1;
				Продолжить;
			КонецЕсли;

			ЗаписатьСоответствиеТовара(Номенклатура, ИДТовара, ХешКарточки);
			Статистика.Создано = Статистика.Создано + 1;
			keycrm_Логирование.Информация("Товары", "Создан товар, ID " + keycrm_API.ИДСтрокой(ИДТовара),
				Контекст, Номенклатура, Ответ.ТелоЗапроса);

		ИначеЕсли Принудительно Или Карточка.ХешКарточки <> ХешКарточки Тогда

			Ответ = keycrm_API.ВыполнитьЗапрос(Контекст, "PUT",
				"/products/" + keycrm_API.ИДСтрокой(ИДТовара), ТелоТовара);

			Если Не Ответ.Успех Тогда
				keycrm_Логирование.Ошибка("Товары", "Ошибка обновления товара, ID "
					+ keycrm_API.ИДСтрокой(ИДТовара), Контекст, Номенклатура,
					Ответ.ОписаниеОшибки + Символы.ПС + Ответ.ТелоЗапроса);
				Статистика.Ошибок = Статистика.Ошибок + 1;
				Продолжить;
			КонецЕсли;

			ЗаписатьСоответствиеТовара(Номенклатура, ИДТовара, ХешКарточки);
			Статистика.Обновлено = Статистика.Обновлено + 1;
			keycrm_Логирование.Информация("Товары", "Обновлен товар, ID " + keycrm_API.ИДСтрокой(ИДТовара),
				Контекст, Номенклатура, Ответ.ТелоЗапроса);

		Иначе

			Статистика.БезИзменений = Статистика.БезИзменений + 1;

		КонецЕсли;

		// --- Варианты ---
		Если Не ИспользуютсяХарактеристики Тогда

			// Товар без характеристик: в KeyCRM у него один вариант с тем же SKU, что и у товара
			Если ЕстьПростойВариант.Получить(Номенклатура) = Неопределено Тогда
				ЗаписатьСоответствиеВарианта(Номенклатура, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(),
					ПрефиксSKU, 0, Неопределено);
			КонецЕсли;
			Результаты.Вставить(Номенклатура, Истина);
			Продолжить;

		КонецЕсли;

		СтрокиХарактеристик = ХарактеристикиПоВладельцам.Получить(Номенклатура);
		Если СтрокиХарактеристик = Неопределено Тогда
			Результаты.Вставить(Номенклатура, Истина); // характеристик пока нет
			Продолжить;
		КонецЕсли;

		// Занятые SKU этой номенклатуры
		ЗанятыеSKU = Новый Соответствие;
		Для Каждого СтрокаХарактеристики Из СтрокиХарактеристик Цикл
			Если СтрокаХарактеристики.Сопоставлена Тогда
				ЗанятыеSKU.Вставить(ВРег(СокрЛП(СтрокаХарактеристики.SKU)), Истина);
			КонецЕсли;
		КонецЦикла;

		НовыеВарианты = Новый Массив; // структуры: Характеристика, SKU, Тело
		Для Каждого СтрокаХарактеристики Из СтрокиХарактеристик Цикл

			Если СтрокаХарактеристики.Сопоставлена Тогда
				Продолжить;
			КонецЕсли;

			SKU = ПрефиксSKU + "_" + СокрЛП(СтрокаХарактеристики.Код);
			Если Не ЗначениеЗаполнено(СтрокаХарактеристики.Код) Или ЗанятыеSKU.Получить(ВРег(SKU)) <> Неопределено Тогда
				// Код пустой или дублируется в пределах номенклатуры - берем UUID
				SKU = ПрефиксSKU + "_" + Строка(СтрокаХарактеристики.Характеристика.УникальныйИдентификатор());
			КонецЕсли;
			ЗанятыеSKU.Вставить(ВРег(SKU), Истина);

			ТелоВарианта = Новый Структура;
			ТелоВарианта.Вставить("sku", SKU);
			ТелоВарианта.Вставить("properties", СвойстваВарианта(СтрокаХарактеристики));

			НовыеВарианты.Добавить(Новый Структура("Характеристика, SKU, Тело",
				СтрокаХарактеристики.Характеристика, SKU, ТелоВарианта));

		КонецЦикла;

		ВсеВариантыСозданы = Истина;
		Пачка = Новый Массив;

		Для Индекс = 0 По НовыеВарианты.Количество() - 1 Цикл

			Пачка.Добавить(НовыеВарианты[Индекс]);

			Если Пачка.Количество() = 100 Или Индекс = НовыеВарианты.Количество() - 1 Тогда
				Если Не СоздатьВарианты(Контекст, Номенклатура, ИДТовара, Пачка, Статистика) Тогда
					ВсеВариантыСозданы = Ложь;
				КонецЕсли;
				Пачка = Новый Массив;
			КонецЕсли;

		КонецЦикла;

		Результаты.Вставить(Номенклатура, ВсеВариантыСозданы);

	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Создает пачку вариантов (до 100) у товара и записывает соответствия.
Функция СоздатьВарианты(Контекст, Номенклатура, ИДТовара, Пачка, Статистика)

	МассивТел = Новый Массив;
	Для Каждого Вариант Из Пачка Цикл
		МассивТел.Добавить(Вариант.Тело);
	КонецЦикла;

	Ответ = keycrm_API.ВыполнитьЗапрос(Контекст, "POST",
		"/products/" + keycrm_API.ИДСтрокой(ИДТовара) + "/offers", Новый Структура("offers", МассивТел));

	Если Не Ответ.Успех Тогда
		keycrm_Логирование.Ошибка("Товары", "Ошибка создания вариантов (" + Формат(Пачка.Количество(), "ЧН=0; ЧГ=0")
			+ " шт.), товар ID " + keycrm_API.ИДСтрокой(ИДТовара), Контекст, Номенклатура,
			Ответ.ОписаниеОшибки + Символы.ПС + Ответ.ТелоЗапроса);
		Статистика.Ошибок = Статистика.Ошибок + 1;
		Возврат Ложь;
	КонецЕсли;

	// Если KeyCRM вернул созданные варианты - запоминаем их ID. Если нет, работаем по SKU.
	ИДПоSKU = Новый Соответствие;
	Для Каждого Оффер Из keycrm_API.МассивДанных(Ответ.Данные) Цикл
		SKUОтвета = keycrm_API.СтрокаИз(keycrm_API.Зн(Оффер, "sku"));
		Если SKUОтвета <> "" Тогда
			ИДПоSKU.Вставить(ВРег(SKUОтвета), keycrm_API.ЧислоИз(keycrm_API.Зн(Оффер, "id")));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Вариант Из Пачка Цикл
		ИДВарианта = ИДПоSKU.Получить(ВРег(Вариант.SKU));
		ЗаписатьСоответствиеВарианта(Номенклатура, Вариант.Характеристика, Вариант.SKU,
			?(ИДВарианта = Неопределено, 0, ИДВарианта), Неопределено);
	КонецЦикла;

	Статистика.СозданоВариантов = Статистика.СозданоВариантов + Пачка.Количество();
	keycrm_Логирование.Информация("Товары", "Создано вариантов: " + Формат(Пачка.Количество(), "ЧН=0; ЧГ=0")
		+ ", товар ID " + keycrm_API.ИДСтрокой(ИДТовара), Контекст, Номенклатура, Ответ.ТелоЗапроса);

	Возврат Истина;

КонецФункции

// Тело товара для POST/PUT /products. От него же считается хеш карточки.
Функция ТелоТовара(Карточка, ПрефиксSKU, ПоляМаппинга)

	Тело = Новый Структура;
	Тело.Вставить("name", СокрЛП(Карточка.Наименование));
	Тело.Вставить("sku", ПрефиксSKU);

	Если ЗначениеЗаполнено(Карточка.Описание) Тогда
		Тело.Вставить("description", СокрЛП(Карточка.Описание));
	КонецЕсли;

	ДопПоля = Новый Массив;
	Для Каждого Поле Из ПоляМаппинга Цикл

		Значение = Карточка[Поле.Псевдоним];

		Если Поле.Тип = 1 Тогда
			// Переключатель: отправляем и Истина, и Ложь, чтобы снятый признак дошел до KeyCRM
			ДопПоля.Добавить(Новый Структура("uuid, value", Поле.UUID, ЗначениеПереключателя(Значение)));
		Иначе
			Если ЗначениеЗаполнено(Значение) Тогда
				Если ТипЗнч(Значение) = Тип("Число") Тогда
					ЗначениеСтрокой = Формат(Значение, "ЧРД=.; ЧГ=0");
				Иначе
					ЗначениеСтрокой = СокрЛП(Строка(Значение));
				КонецЕсли;
				Если ЗначениеСтрокой <> "" Тогда
					ДопПоля.Добавить(Новый Структура("uuid, value", Поле.UUID, ЗначениеСтрокой));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Если ДопПоля.Количество() > 0 Тогда
		Тело.Вставить("custom_fields", ДопПоля);
	КонецЕсли;

	Возврат Тело;

КонецФункции

Функция ЗначениеПереключателя(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	// Реквизит-ссылка (например, Поляризация, Фотохром): Истина, если значение "Так"/"Да"
	Представление = ВРег(СокрЛП(Строка(Значение)));
	Возврат Представление = "ТАК" Или Представление = "ДА" Или Представление = "YES"
		Или Представление = "TRUE" Или Представление = "+";

КонецФункции

// Префикс SKU: код номенклатуры либо артикул (если включено в настройке и артикул заполнен).
Функция ПрефиксSKU(Карточка, Параметры)

	Если Параметры.ИспользоватьАртикулВSKU И ЗначениеЗаполнено(Карточка.Артикул) Тогда
		Возврат СокрЛП(СтрЗаменить(Карточка.Артикул, Символы.НПП, ""));
	КонецЕсли;

	Возврат СокрЛП(Карточка.Код);

КонецФункции

// Читает справочник keycrm_МаппингПолей и проверяет, что реквизиты есть в справочнике Номенклатура.
//
// Возвращаемое значение:
//  Массив из Структура - Реквизит, UUID, Тип (0 - строка/число, 1 - переключатель), ЭтоСсылка, Псевдоним
//
Функция ОписаниеПолейМаппинга(Контекст)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Маппинг.ИмяРеквизита1С КАК Реквизит,
		|	Маппинг.UUID_KeyCRM КАК UUID,
		|	Маппинг.ТипПоля КАК Тип
		|ИЗ
		|	Справочник.keycrm_МаппингПолей КАК Маппинг
		|ГДЕ
		|	НЕ Маппинг.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	UUID";

	РеквизитыНоменклатуры = Метаданные.Справочники.Номенклатура.Реквизиты;

	ПростыеТипы = Новый Массив;
	ПростыеТипы.Добавить(Тип("Строка"));
	ПростыеТипы.Добавить(Тип("Число"));
	ПростыеТипы.Добавить(Тип("Булево"));
	ПростыеТипы.Добавить(Тип("Дата"));

	Номер = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ИмяРеквизита = СокрЛП(Выборка.Реквизит);
		UUID = СокрЛП(Выборка.UUID);
		Если ИмяРеквизита = "" Или UUID = "" Тогда
			Продолжить;
		КонецЕсли;

		МетаРеквизит = РеквизитыНоменклатуры.Найти(ИмяРеквизита);
		Если МетаРеквизит = Неопределено Тогда
			keycrm_Логирование.Предупреждение("Товары",
				"В маппинге полей указан реквизит, которого нет в справочнике Номенклатура: " + ИмяРеквизита, Контекст);
			Продолжить;
		КонецЕсли;

		ЭтоСсылка = Ложь;
		Для Каждого ТипРеквизита Из МетаРеквизит.Тип.Типы() Цикл
			Если ПростыеТипы.Найти(ТипРеквизита) = Неопределено Тогда
				ЭтоСсылка = Истина;
			КонецЕсли;
		КонецЦикла;

		Номер = Номер + 1;

		Поле = Новый Структура;
		Поле.Вставить("Реквизит", МетаРеквизит.Имя);
		Поле.Вставить("UUID", UUID);
		Поле.Вставить("Тип", ?(Выборка.Тип = 1, 1, 0));
		Поле.Вставить("ЭтоСсылка", ЭтоСсылка);
		Поле.Вставить("Псевдоним", "ДопПоле" + Формат(Номер, "ЧН=0; ЧГ=0"));
		Результат.Добавить(Поле);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СвойстваВариантов

// Свойства варианта для KeyCRM: сначала из реквизитов характеристики, если они пустые - из наименования.
Функция СвойстваВарианта(СтрокаХарактеристики)

	Свойства = Новый Массив;

	// Колонка запроса -> имя свойства в KeyCRM. Чтобы добавить свойство: колонка в запросе + строка здесь.
	ДобавитьСвойство(Свойства, "Сфера", СтрокаХарактеристики.Сфера);
	ДобавитьСвойство(Свойства, "Циліндр", СтрокаХарактеристики.Цилиндр);
	ДобавитьСвойство(Свойства, "Вісь", СтрокаХарактеристики.Ось);
	ДобавитьСвойство(Свойства, "Аддідація", СтрокаХарактеристики.Аддидация);
	ДобавитьСвойство(Свойства, "Діаметр", СтрокаХарактеристики.Диаметр);
	ДобавитьСвойство(Свойства, "Радіус", СтрокаХарактеристики.Радиус);
	ДобавитьСвойство(Свойства, "Дегресія", СтрокаХарактеристики.Дегрессия);
	ДобавитьСвойство(Свойства, "Колір", СтрокаХарактеристики.Цвет);

	Если Свойства.Количество() = 0 Тогда
		Свойства = СвойстваИзНаименования(СтрокаХарактеристики.Наименование);
	КонецЕсли;

	Если Свойства.Количество() = 0 Тогда
		// Вариант должен чем-то отличаться от других - передаем наименование целиком
		ДобавитьСвойство(Свойства, "Варіант", СтрокаХарактеристики.Наименование);
	КонецЕсли;

	Возврат Свойства;

КонецФункции

Процедура ДобавитьСвойство(Свойства, Имя, Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Значение = Строка(Значение);
	КонецЕсли;

	Значение = СокрЛП(СтрЗаменить(Значение, Символы.НПП, " "));
	Если Значение = "" Тогда
		Возврат;
	КонецЕсли;

	Свойства.Добавить(Новый Структура("name, value", Имя, Значение));

КонецПроцедуры

// Разбирает наименование характеристики, сформированное обменом с Диггером.
// Поддерживаются оба формата: "Сф.: -3,00; Д.: 70,00" и " Сф.: -3,00  Д. : 70,00 ".
// Сокращения - из ИнфралайнОбмен.СформироватьНаименованиеХарактеристики:
//   Рад - радіус, Сф. - сфера, Ц. - циліндр, В. - вісь, Ад. - аддідація, Д. - діаметр, Дег - дегресія, Цв. - колір.
Функция СвойстваИзНаименования(Знач Наименование)

	Свойства = Новый Массив;

	Маркер = Символ(1);
	Разделитель = Символ(2);

	Текст = СтрЗаменить(Наименование, Символы.НПП, " ");
	Текст = СтрЗаменить(Текст, ";", " ");

	// Метка -> имя свойства KeyCRM. Замена регистрозависимая, поэтому "Ад.:" не пересекается с "Д.:".
	Метки = Новый Массив;
	ДобавитьМетку(Метки, "Рад", "Радіус");
	ДобавитьМетку(Метки, "Сф.", "Сфера");
	ДобавитьМетку(Метки, "Дег", "Дегресія");
	ДобавитьМетку(Метки, "Ад.", "Аддідація");
	ДобавитьМетку(Метки, "Цв.", "Колір");
	ДобавитьМетку(Метки, "Ц.", "Циліндр");
	ДобавитьМетку(Метки, "В.", "Вісь");
	ДобавитьМетку(Метки, "Д.", "Діаметр");

	Для Каждого Метка Из Метки Цикл
		// варианты написания: "Сф.:" и "Сф. :"
		Текст = СтрЗаменить(Текст, Метка.Метка + " :", Маркер + Метка.Имя + Разделитель);
		Текст = СтрЗаменить(Текст, Метка.Метка + ":", Маркер + Метка.Имя + Разделитель);
	КонецЦикла;

	Для Каждого Часть Из СтрРазделить(Текст, Маркер, Ложь) Цикл

		Позиция = СтрНайти(Часть, Разделитель);
		Если Позиция = 0 Тогда
			Продолжить; // текст до первой метки
		КонецЕсли;

		ДобавитьСвойство(Свойства, Лев(Часть, Позиция - 1), Сред(Часть, Позиция + 1));

	КонецЦикла;

	Возврат Свойства;

КонецФункции

Процедура ДобавитьМетку(Метки, Метка, Имя)
	Метки.Добавить(Новый Структура("Метка, Имя", Метка, Имя));
КонецПроцедуры

#КонецОбласти

#Область РегистрыСоответствий

// Записывает соответствие товара. Хеш = Неопределено - не менять сохраненный хеш.
Процедура ЗаписатьСоответствиеТовара(Номенклатура, ИДТовара, Хеш)

	МЗ = РегистрыСведений.keycrm_СоответствиеТоваров.СоздатьМенеджерЗаписи();
	МЗ.Номенклатура = Номенклатура;
	МЗ.Прочитать();

	Если МЗ.Выбран() И Хеш = Неопределено И МЗ.ИДТовара = ИДТовара Тогда
		Возврат; // нечего менять
	КонецЕсли;

	МЗ.Номенклатура = Номенклатура;
	МЗ.ИДТовара     = ИДТовара;
	Если Хеш <> Неопределено Тогда
		МЗ.ХешКарточки  = Хеш;
		МЗ.ДатаВыгрузки = ТекущаяДатаСеанса();
	КонецЕсли;
	МЗ.Записать(Истина);

КонецПроцедуры

// Записывает соответствие варианта. ЦенаKeyCRM = Неопределено - цена еще не отправлялась
// (для новых записей) либо не менять сведения о цене (для существующих).
Процедура ЗаписатьСоответствиеВарианта(Номенклатура, Характеристика, SKU, ИДВарианта, ЦенаKeyCRM)

	МЗ = РегистрыСведений.keycrm_СоответствиеВариантов.СоздатьМенеджерЗаписи();
	МЗ.Номенклатура   = Номенклатура;
	МЗ.Характеристика = Характеристика;
	МЗ.Прочитать();

	МЗ.Номенклатура   = Номенклатура;
	МЗ.Характеристика = Характеристика;
	МЗ.SKU            = SKU;
	Если ИДВарианта <> 0 Тогда
		МЗ.ИДВарианта = ИДВарианта;
	КонецЕсли;

	Если ЦенаKeyCRM <> Неопределено Тогда
		МЗ.Цена           = ЦенаKeyCRM;
		МЗ.ЦенаОтправлена = Истина;
	КонецЕсли;

	МЗ.Записать(Истина);

КонецПроцедуры

#КонецОбласти

#Область Прочее

Функция ПозицияПоследнегоРазделителя(SKU)

	Для Позиция = 1 По СтрДлина(SKU) Цикл
		Индекс = СтрДлина(SKU) - Позиция + 1;
		Если Сред(SKU, Индекс, 1) = "_" Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

Функция НоваяСтатистика()

	Возврат Новый Структура("Создано, Обновлено, БезИзменений, СозданоВариантов, Пропущено, Ошибок", 0, 0, 0, 0, 0, 0);

КонецФункции

Функция ТекстСтатистики(Статистика)

	Возврат "товары: создано " + Формат(Статистика.Создано, "ЧН=0; ЧГ=0")
		+ ", обновлено " + Формат(Статистика.Обновлено, "ЧН=0; ЧГ=0")
		+ ", без изменений " + Формат(Статистика.БезИзменений, "ЧН=0; ЧГ=0")
		+ ", создано вариантов " + Формат(Статистика.СозданоВариантов, "ЧН=0; ЧГ=0")
		+ ", пропущено " + Формат(Статистика.Пропущено, "ЧН=0; ЧГ=0")
		+ ", ошибок " + Формат(Статистика.Ошибок, "ЧН=0; ЧГ=0");

КонецФункции

