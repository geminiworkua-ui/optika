Функция НайтиАдресПолучателяЗаказа(ТекДокумент, СтруктураАдреса) экспорт
	
	Если Не СокрЛП(СтруктураАдреса.УлицаПолучателя) = "" Тогда	
		УлицаПоКласификатору = 	НайтиУлицу(ТекДокумент.НаселенныйПункт, СокрЛП(СтруктураАдреса.НомерКвартирыПолучателя));  
	Иначе
		УлицаПоКласификатору = Справочники.eComm_Улицы.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	eComm_АдресаДоставки.Ссылка
	|ИЗ
	|	Справочник.eComm_АдресаДоставки КАК eComm_АдресаДоставки
	|ГДЕ
	|	НЕ eComm_АдресаДоставки.ПометкаУдаления
	|	И eComm_АдресаДоставки.Владелец = &УчетнаяЗапись
	|	И eComm_АдресаДоставки.НаселенныйПункт = &НаселенныйПункт
	|	И eComm_АдресаДоставки.Контрагент = &Контрагент ");
	Если УлицаПоКласификатору = Справочники.eComm_Улицы.ПустаяСсылка()
		Тогда Запрос.Текст = Запрос.Текст +
		"	И eComm_АдресаДоставки.Улица = &Улица";
	Иначе Запрос.Текст = Запрос.Текст + "	И eComm_АдресаДоставки.УлицаПоКлассификатору = &УлицаПоКласификатору  ";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст +"	И eComm_АдресаДоставки.НомерДома = &НомерДома 	И eComm_АдресаДоставки.НомерКвартиры = &НомерКвартиры";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", ТекДокумент.УчетнаяЗапись);
	Запрос.УстановитьПараметр("контрагент", ТекДокумент.Получатель); 
	Запрос.УстановитьПараметр("НаселенныйПункт",ТекДокумент.НаселенныйПунктПолучателя); 
	Запрос.УстановитьПараметр("Улица", СтруктураАдреса.УлицаПолучателя); 
	
	Если Не УлицаПоКласификатору = Справочники.eComm_Улицы.ПустаяСсылка() Тогда
		Запрос.УстановитьПараметр("УлицаПоКласификатору", УлицаПоКласификатору); 	
	КонецЕсли;
	Запрос.УстановитьПараметр("НомерДома", СтруктураАдреса.НомерДомаПолучателя);
	Запрос.УстановитьПараметр("НомерКвартиры", СтруктураАдреса.НомерКвартирыПолучателя); 
	
	Результат =Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.ссылка;
	КонецЕсли;	
	
	Если УлицаПоКласификатору = Справочники.eComm_Улицы.ПустаяСсылка() Тогда
		Возврат Неопределено;
	КонецЕсли;	
	НовАдрес = Справочники.eComm_АдресаДоставки.СоздатьЭлемент();
	НовАдрес.Владелец = ТекДокумент.УчетнаяЗапись;
	НовАдрес.Контрагент = ТекДокумент.Получатель;
	НовАдрес.НаселенныйПункт = ТекДокумент.НаселенныйПунктПолучателя;
	НовАдрес.НомерДома = СтруктураАдреса.НомерДомаПолучателя;
	НовАдрес.НомерКвартиры = СтруктураАдреса.НомерКвартирыПолучателя;
	НовАдрес.Улица = СтруктураАдреса.НомерКвартирыПолучателя;
	НовАдрес.УлицаПоКлассификатору = УлицаПоКласификатору;
	НовАдрес.Отделение = Текдокумент.ОтделениеПолучателя;
	НовАдрес.ЭтоАдресОтделения = Не Текдокумент.ОтделениеПолучателя = Справочники.eComm_ОтделенияДоставки.ПустаяСсылка();
	НовАдрес.записать(); 
	Возврат НовАдрес.Ссылка;
КонецФункции

Функция НайтиУлицу(НаселенныйПункт, Название)
	Запрос =Новый Запрос(
	"ВЫБРАТЬ
	|	eComm_Улицы.Ссылка
	|ИЗ
	|	Справочник.eComm_Улицы КАК eComm_Улицы
	|ГДЕ
	|	НЕ eComm_Улицы.ПометкаУдаления
	|	И eComm_Улицы.Владелец = &Владелец
	|	И eComm_Улицы.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Владелец", НаселенныйПункт);
	Запрос.УстановитьПараметр("Наименование", Название);
	Результат =Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.ссылка;
	КонецЕсли;	
КонецФункции

Процедура ЗаполнитьСтоимостьТоваров(ДокументОснование, Документ)  экспорт
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Документ.ОбъявленнаяСтоимость = ДокументОснование.СуммаДокумента;
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
	    Документ.ОбъявленнаяСтоимость = ДокументОснование.СуммаДокумента;
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		УчетныйВидЦены = ДокументОснование.СкладОтправитель.УчетныйВидЦены;
		Сумма =0;
		Для каждого Строка из ДокументОснование.Товары Цикл
			СуммаСтроки = ЦенаПозиции(Строка)*Строка.Количество;
			Сумма = Сумма+ СуммаСтроки;
		КонецЦикла;	                   
		Документ.ОбъявленнаяСтоимость = Сумма;
	КонецЕсли	
КонецПроцедуры	

Функция ЦенаПозиции(Строка, Видцены = Неопределено)           
	Если ВидЦены = Неопределено Тогда
		ВидЦены = ОпределитьВидЦены();
	КонецЕсли;	
 Запрос = Новый Запрос("ВЫБРАТЬ
  |	ЦеныНоменклатурыСрезПоследних.Цена
  |ИЗ
  |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
  |			&Дата,
  |			Номенклатура = &Номенклатура
  |				И Характеристика = &Характеристика
  |				И ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних");
 Запрос.УстановитьПараметр("Номенклатура", Строка.Номенклатура);
 Запрос.УстановитьПараметр("Характеристика", Строка.Характеристика);
 Запрос.УстановитьПараметр("Дата", ТекущаяДата());
 Запрос.УстановитьПараметр("ВидЦены", ВидЦены);   
 Результат = Запрос.Выполнить().Выбрать();
 Если Результат.Следующий() Тогда
	 Возврат Результат.Цена;
 Иначе
	 Возврат 0;
 КонецЕсли;	 
КонецФункции	

