Функция НайтиПолучателяЗаказа(ТекДокумент, СтрКлиента) экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	eComm_КонтрагентыДоставки.Ссылка
	|ИЗ
	|	Справочник.eComm_КонтрагентыДоставки КАК eComm_КонтрагентыДоставки
	|ГДЕ
	|	НЕ eComm_КонтрагентыДоставки.ПометкаУдаления
	|	И eComm_КонтрагентыДоставки.Владелец = &УчетнаяЗапись
	|	И (eComm_КонтрагентыДоставки.Телефон подобно &Телефон
	|			ИЛИ eComm_КонтрагентыДоставки.Наименование Подобно &Наименование)");
	Запрос.УстановитьПараметр("УчетнаяЗапись", ТекДокумент.УчетнаяЗапись);
	Запрос.УстановитьПараметр("Телефон","%"+СтрКлиента.Телефон+"%"); 
	Запрос.УстановитьПараметр("Наименование","%"+СтрКлиента.НаименованиеПолучателя+ "%"); 
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;	
	НовКонтрагент = Справочники.eComm_КонтрагентыДоставки.СоздатьЭлемент();
	НовКОнтрагент.Наименование = СтрКлиента.НаименованиеПолучателя;
	// ++ Боков 
	НовКОнтрагент.Фамилия = СтрКлиента.Фамилия;
	НовКОнтрагент.Имя = СтрКлиента.Имя;	
	НовКОнтрагент.Отчество = СтрКлиента.Отчество;
	// -- 
	НовКонтрагент.Телефон = ?(Лев(СтрКлиента.Телефон,1) ="+", СтрКлиента.Телефон, "+38"+СтрКлиента.Телефон);
	НовКонтрагент.НаселенныйПункт = ТекДокумент.НаселенныйПунктПолучателя;
	НовКонтрагент.Владелец = ТекДокумент.УчетнаяЗапись; 
	НовКонтрагент.СлужбаДоставки = ТекДокумент.СлужбаДоставки; 
	НовКонтрагент.ТипКонтрагента = Справочники.eComm_ОбщиеСправочники.privatperson;
	НовКонтрагент.Записать();  
	Возврат НовКонтрагент.ссылка;
КонецФункции

