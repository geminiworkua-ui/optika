Функция НайтиСоздатьКонтактноеЛицоКонтрагента(Контрагент, СтруктураКонтактногоЛица) экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	eComm_КонтактныеЛицаКонтрагентовДоставки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.eComm_КонтактныеЛицаКонтрагентовДоставки КАК eComm_КонтактныеЛицаКонтрагентовДоставки
	|ГДЕ
	|	НЕ eComm_КонтактныеЛицаКонтрагентовДоставки.ПометкаУдаления
	|	И eComm_КонтактныеЛицаКонтрагентовДоставки.Владелец = &Владелец
	//|	И eComm_КонтактныеЛицаКонтрагентовДоставки.Фамилия = &Фамилия
	//|	И eComm_КонтактныеЛицаКонтрагентовДоставки.Имя = &Имя
	//|	И eComm_КонтактныеЛицаКонтрагентовДоставки.Отчество = &Отчество
	|	Или eComm_КонтактныеЛицаКонтрагентовДоставки.Телефон = &Телефон"); 
	СтруктураКонтактногоЛица.Телефон = СтрЗаменить(СтруктураКонтактногоЛица.Телефон,  "+", "");
	
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("Фамилия",СтруктураКонтактногоЛица.Фамилия);
	Запрос.УстановитьПараметр("Имя",СтруктураКонтактногоЛица.Имя);
	Запрос.УстановитьПараметр("Отчество",СтруктураКонтактногоЛица.Отчество);
	Запрос.УстановитьПараметр("Телефон",СтруктураКонтактногоЛица.Телефон);
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка; 
	Иначе	
		 СО = Справочники.eComm_КонтактныеЛицаКонтрагентовДоставки.СоздатьЭлемент();
		 ЗаполнитьЗначенияСвойств(СО,СтруктураКонтактногоЛица);
		 СО.Владелец = Контрагент;
		 СО.Записать();
