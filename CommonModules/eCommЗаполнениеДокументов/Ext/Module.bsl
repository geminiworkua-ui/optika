Процедура ЗаполнитьЕН(ДокументОснование) Экспорт

Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента")
	Тогда ЗаполнитьНаОснованииЗаказа (ДокументОснование) 
ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
	Тогда ЗаполнитьНаОснованииРеализации (ДокументОснование) 
ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров")
	Тогда ЗаполнитьНаПеремещения (ДокументОснование) 
КонецЕсли;
	
КонецПроцедуры	


Процедура ЗаполнитьНаОснованииЗаказа (ДокументОснование, Документ = Неопределено) Экспорт   
Если Документ =Неопределено Тогда	
Документ  = Документы.eComm_ЭкспрессНакладная.СоздатьДокумент();
КонецЕсли;
Документ.ДокументОснование = ДокументОснование;
Документ.Получатель = ДокументОснование.Получатель;
Документ.АдресПолучателя = ДокументОснование.АдресПолучателя;
Документ.доставкаКурьером = ДокументОснование.ДоставкаКурьерос;
Документ.НаселенныйПунктПолучателя =ДокументОснование.НаселенныйПунктДоставки;
Документ.ОтделениеПолучателя = ДокументОснование.ОтделениеДоставки;
Документ.УчетнаяЗапись = ДокументОснование.УчетнаяЗапись; 
ЗаполнитьПоУчетнойЗаписи(Документ);
ЗаполнитьСтоимостьТоваров(ДокументОснование, Документ);
Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры	

Процедура ЗаполнитьНаОснованииРеализации(ДокументОснование, Документ = Неопределено) Экспорт  
	Если Документ =Неопределено Тогда	
		Документ  = Документы.eComm_ЭкспрессНакладная.СоздатьДокумент();
	КонецЕсли;
	Документ.ДокументОснование = ДокументОснование;
	Документ.Получатель = ДокументОснование.Получатель;
	Документ.АдресПолучателя = ДокументОснование.АдресПолучателя;
	Документ.доставкаКурьером = ДокументОснование.ДоставкаКурьерос;
	Документ.НаселенныйПунктПолучателя =ДокументОснование.НаселенныйПунктДоставки;
	Документ.ОтделениеПолучателя = ДокументОснование.ОтделениеДоставки;
	Документ.УчетнаяЗапись = ДокументОснование.УчетнаяЗапись; 
	ЗаполнитьПоУчетнойЗаписи(Документ);
	ЗаполнитьСтоимостьТоваров(ДокументОснование, Документ);
	Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры	

Процедура ЗаполнитьНаПеремещения(ДокументОснование) Экспорт
  Документ = Неопределено;     
  Документ  = Документы.eComm_ЭкспрессНакладная.СоздатьДокумент();

  
  ЗаполнитьСтоимостьТоваров(ДокументОснование, Документ);
  Документ.Записать(РежимЗаписиДокумента.Проведение);	
КонецПроцедуры	

