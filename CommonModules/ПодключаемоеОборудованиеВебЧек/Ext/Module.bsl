Функция СоздатьОбъектЭкв (Драйвер =неопределено) Экспорт
	
	Если Драйвер = Неопределено Тогда
		Попытка
			Драйвер =  Новый COMОбъект("WebCheck.ClassCardserv");	
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	Параметры =  Новый Структура("FN,MerchantID,Dest,type","","","","");
	ОбъектЕкв = Новый Структура("Драйвер,ПараметрыЭкв",Драйвер,Параметры);
		
	Возврат ОбъектЕкв;
