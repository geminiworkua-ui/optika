
Процедура ibs_СправочникиПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.Контрагенты") Тогда
		Контрагенты_ПриЗаписи(Источник);
	КонецЕсли;	
	
КонецПроцедуры

Процедура Контрагенты_ПриЗаписи(Источник)
	
	// Проверка наличия номера телефона
	НомерТелефона = "";
	Для каждого Стр Из Источник.КонтактнаяИнформация Цикл
		Если Стр.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон
			И Стр.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента Тогда 
			НомерТелефона = Стр.НомерТелефона;
		КонецЕсли;	
	КонецЦикла;
	
	Если ПустаяСтрока(НомерТелефона) Тогда
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КартыЛояльности.Ссылка
		|ИЗ
		|	Справочник.КартыЛояльности КАК КартыЛояльности
		|ГДЕ
		|	КартыЛояльности.Штрихкод = &НомерТелефона";
	Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ТекстСообщения = НСтр("ru='По номеру телефону уже сформирована ранее карточка лояльности: ';uk='За номером телефону вже сформовано раніше картку лояльності: '") + Выборка.Ссылка;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Выборка.Ссылка);
		Возврат;
	КонецЕсли;	
	
	ОбъектКЛ = Справочники.КартыЛояльности.СоздатьЭлемент();
	ОбъектКЛ.Владелец     = Справочники.ВидыКартЛояльности.НайтиПоНаименованию("БП LUXOR 10% 5%", Истина);
	ОбъектКЛ.Наименование = "" + ОбъектКЛ.Владелец + " " + НомерТелефона;
	ОбъектКЛ.Штрихкод 	  = НомерТелефона;
	//ОбъектКЛ.МагнитныйКод = "";
	ОбъектКЛ.Статус 	  = Перечисления.СтатусыКартЛояльности.Действует;
	ОбъектКЛ.Партнер 	  = Источник.Партнер;
	ОбъектКЛ.Контрагент   = Источник.Ссылка;
	//ОбъектКЛ.Соглашение   = "";
	ОбъектКЛ.Телефон = Истина;
	
	Попытка
		ОбъектКЛ.Записать();
	Исключение
	КонецПопытки;
	
КонецПроцедуры	


