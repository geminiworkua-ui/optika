
Функция ПослатьSMS(ТекстСМС,ТекстВайбер,Телефоны,СсылкаНаФотоКартинки,ТекстНаКнопке,АдресПриНажатииКнопки,ТолькоСМС = Ложь,ТолькоВайбер = Ложь,ИмяОтправителя = Неопределено) Экспорт
	
	ИмяОтправителя = Константы.tsms_ИмяОтправителя.Получить();
	
	Если Не ЗначениеЗаполнено(ИмяОтправителя) Тогда
		Возврат "";	
	КонецЕсли;
	
	 ТолькоСМС = Истина;
	 ТолькоВайбер = Ложь;
	
	Сообщение = СокрЛП(ТекстСМС);
	СообщениеВайберТекстом = СокрЛП(ТекстВайбер);
	Если СообщениеВайберТекстом = "" Тогда
		СообщениеВайберТекстом = Сообщение;
	КонецЕсли;
	
	
	Если Телефоны <> "" Тогда
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("recipients",Телефоны);
		
		Если  Не ТолькоСМС Тогда
			СтруктураВайбер = Новый Структура;
			СтруктураВайбер.Вставить("sender",ИмяОтправителя);
			СтруктураВайбер.Вставить("text",СокрЛП(СообщениеВайберТекстом));
			Если СокрЛП(СсылкаНаФотоКартинки) <> "" тогда
				СтруктураВайбер.Вставить("image_url",СокрЛП(СсылкаНаФотоКартинки));
			КонецЕсли;
			
			Если СокрЛП(ТекстНаКнопке) <> "" Тогда
				СтруктураВайбер.Вставить("caption",СокрЛП(ТекстНаКнопке));
			КонецЕсли;
			
			Если СокрЛП(АдресПриНажатииКнопки) <> "" Тогда
				СтруктураВайбер.Вставить("action",СОкрЛП(АдресПриНажатииКнопки));
			КонецЕсли;
			
			СтруктураДанных.Вставить("viber",СтруктураВайбер);
		КонецЕсли;
		
		Если Не ТолькоВайбер Тогда
		СтруктураСМС = Новый Структура;
		СтруктураСМС.Вставить("sender",ИмяОтправителя);
		СтруктураСМС.Вставить("text",СокрЛП(Сообщение));
		СтруктураДанных.Вставить("sms",СтруктураСМС);
		КонецЕсли;
		Результат = ВызватьHTTPМетодНаСервере("POST",Новый HTTPСоединение("api.turbosms.ua",,,,,,Новый ЗащищенноеСоединениеOpenSSL),"message/send.json",СтруктураДанных);;
		Возврат Результат.ОтветСервера;
	Иначе
		Возврат "";
	КонецЕсли;
	

	
КонецФункции


