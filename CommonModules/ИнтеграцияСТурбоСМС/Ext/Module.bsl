// ПараметрыViber - Структура (необязательно):
//   ИДКартинки   - Число, id из file/add
//   ТекстКнопки  - Строка до 30 символов
//   СсылкаКнопки - Строка, URL
// Картинка уходит только вместе с кнопкой (требование Viber/TurboSMS).
Функция ОтправитьСообщениеTurboSMSРасш(Телефоны, ТекстВайбер = "", ТекстСМС = "", ПараметрыViber = Неопределено) Экспорт
	
	Если Телефоны.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("recipients", Телефоны);
	
	ЕстьБлок = Ложь;
	
	Если ЗначениеЗаполнено(СокрЛП(ТекстВайбер)) Тогда
		
		БлокViber = Новый Структура;
		БлокViber.Вставить("sender", "ОПТИКА ЛЮКСОР");
		БлокViber.Вставить("text", СокрЛП(ТекстВайбер));
		
		Если ТипЗнч(ПараметрыViber) = Тип("Структура") Тогда
			
			//ДК: 16.11.2026
			// Карусель: массив карточек в формате TurboSMS. Кнопка и картинка обычного сообщения не передаются.
			Карусель = Неопределено;
			ЕстьКарусель = ПараметрыViber.Свойство("Карусель", Карусель)
				И ТипЗнч(Карусель) = Тип("Массив") И Карусель.Количество() >= 2;
			Если ЕстьКарусель Тогда
				БлокViber.Вставить("carousel", Карусель);
				БлокViber.Вставить("count_clicks", 1);
			КонецЕсли;
			//:ДК 16.11.2026
			
			ИДКартинки   = Неопределено;
			ТекстКнопки  = "";
			СсылкаКнопки = "";
			ПараметрыViber.Свойство("ИДКартинки", ИДКартинки);
			ПараметрыViber.Свойство("ТекстКнопки", ТекстКнопки);
			ПараметрыViber.Свойство("СсылкаКнопки", СсылкаКнопки);
			ТекстКнопки  = СокрЛП(ТекстКнопки);
			СсылкаКнопки = СокрЛП(СсылкаКнопки);
			
			ЕстьКнопка = ЗначениеЗаполнено(ТекстКнопки) И ЗначениеЗаполнено(СсылкаКнопки);
			
			//ДК: 16.11.2026
			//Если ЕстьКнопка Тогда
			Если ЕстьКнопка И Не ЕстьКарусель Тогда
			//:ДК 16.11.2026
				БлокViber.Вставить("caption", Лев(ТекстКнопки, 30));
				БлокViber.Вставить("action", СсылкаКнопки);
				//ДК: 16.11.2026
				БлокViber.Вставить("count_clicks", 1);
				//:ДК 16.11.2026
				Если ТипЗнч(ИДКартинки) = Тип("Число") И ИДКартинки > 0 Тогда
					БлокViber.Вставить("file_id", ИДКартинки);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		СтруктураДанных.Вставить("viber", БлокViber);
		ЕстьБлок = Истина;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СокрЛП(ТекстСМС)) Тогда
		ИмяОтправителяСМС = Константы.tsms_ИмяОтправителя.Получить(); // OpticaLuxor
		Если ЗначениеЗаполнено(ИмяОтправителяСМС) Тогда
			БлокСМС = Новый Структура;
			БлокСМС.Вставить("sender", ИмяОтправителяСМС);
			БлокСМС.Вставить("text", СокрЛП(ТекстСМС));
			СтруктураДанных.Вставить("sms", БлокСМС);
			ЕстьБлок = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЕстьБлок Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение("api.turbosms.ua",,,,,, Новый ЗащищенноеСоединениеOpenSSL);
	Результат = ВызватьHTTPМетодНаСервере("POST", Соединение, "message/send.json", СтруктураДанных);
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОтветСервера = Неопределено;
	Результат.Свойство("ОтветСервера", ОтветСервера);
	
	Возврат ОтветСервера;
	
КонецФункции

// Отправка одним каналом: Канал = "viber" или "sms". Оставлена для тестовой формы.
Функция ОтправитьСообщениеTurboSMS(Канал, Текст, Телефоны, ПараметрыViber = Неопределено) Экспорт
	
	Если Канал = "viber" Тогда
		Возврат ОтправитьСообщениеTurboSMSРасш(Телефоны, Текст, "", ПараметрыViber);
	Иначе
		Возврат ОтправитьСообщениеTurboSMSРасш(Телефоны, "", Текст);
	КонецЕсли;
	
КонецФункции

// Загружает картинку в TurboSMS (метод file/add), возвращает id файла (Число).
// Поддерживаются jpg, jpeg, png до 3 МБ. При ошибке вызывает исключение.
Функция ЗагрузитьФайлTurboSMS(ДвоичныеДанные, Знач Расширение) Экспорт
	
	Расширение = НРег(СтрЗаменить(Расширение, ".", ""));
	
	Если Расширение = "jpg" Или Расширение = "jpeg" Тогда
		ТипMIME = "image/jpeg";
	ИначеЕсли Расширение = "png" Тогда
		ТипMIME = "image/png";
	Иначе
		ВызватьИсключение "Поддерживаются только картинки jpg, jpeg, png";
	КонецЕсли;
	
	Если ДвоичныеДанные.Размер() > 3 * 1024 * 1024 Тогда
		ВызватьИсключение "Размер картинки больше 3 МБ";
	КонецЕсли;
	
	// Base64Строка вставляет переносы строк - убираем
	СтрокаBase64 = Base64Строка(ДвоичныеДанные);
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("data", "data:" + ТипMIME + ";base64," + СтрокаBase64);
	
	Соединение = Новый HTTPСоединение("api.turbosms.ua",,,,,, Новый ЗащищенноеСоединениеOpenSSL);
	Результат = ВызватьHTTPМетодНаСервере("POST", Соединение, "file/add.json", СтруктураДанных);
	
	Ответ = Неопределено;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("ОтветСервера", Ответ);
	КонецЕсли;
	
	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		ВызватьИсключение "TurboSMS вернул некорректный ответ при загрузке картинки";
	КонецЕсли;
	
	ДанныеФайла = Ответ.Получить("response_result");
	Если ТипЗнч(ДанныеФайла) = Тип("Соответствие") Тогда
		ИДФайла = ДанныеФайла.Получить("id");
		Если ТипЗнч(ИДФайла) = Тип("Число") И ИДФайла > 0 Тогда
			Возврат ИДФайла;
		КонецЕсли;
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон("TurboSMS не принял картинку: %1", Ответ.Получить("response_status"));
	
КонецФункции
