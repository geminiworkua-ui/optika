		Если Не ЕстьЗапись Тогда
			СтрЗаписи = бит_сервер.ПолучитьСтруктуруЗаписи(НоваяЗапись.Ссылка, Стр.Ref, ТипПриемника, ТипИсточника, Узел);
			бит_сервер.ДобавитьЗапись(СтрЗаписи);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

Функция ПолучитьЗаписьТипУлиц(стр, Узел);
