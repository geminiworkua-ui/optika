Функция ПолучитьПланОбмена() 
Запрос = Новый Запрос(
  "ВЫБРАТЬ
  |	НоваПошта.Ссылка
  |ИЗ
  |	ПланОбмена.НоваПошта КАК НоваПошта
  |ГДЕ
  |	НЕ НоваПошта.ЭтотУзел
  |	И НЕ НоваПошта.ПометкаУдаления");
Результат = Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	Возврат Результат.ссылка;
КОнецЕсли;	
КонецФункции


Процедура ЗарегистрироватьДанныеОбластей(Данные, Узел)
ТипИсточника = "СправочникСсылка.РегионыДоставки";
ТипПриемника = "НоваПошта.Areas";
  	
	Если Данные =Неопределено Тогда
		возврат;
	КонецЕсли;	
	
	Для каждого стр из Данные  Цикл
		ЕстьЗапись = бит_сервер.ЕстьЗапись(Стр.Ref, ТипПриемника, ТипИсточника, Узел);
		
		Если ЕстьЗапись Тогда
			Ссылка = бит_сервер.ПолучитьОбъект(Стр.Ref, ТипПриемника, ТипИсточника, Узел);
			НоваяЗапись = ссылка.ПолучитьОбъект(); 
			
			Если НоваяЗапись = Неопределено Тогда 
				СтрЗаписи = бит_сервер.ПолучитьСтруктуруЗаписи(Ссылка, Стр.Ref, ТипПриемника, ТипИсточника,  Узел);
				бит_сервер.УдалитьЗапись(СтрЗаписи);
				НоваяЗапись = Справочники.РегионыДоставки.СоздатьЭлемент();
			Иначе
				Если Не Ссылка.ОбластнойЦентр = справочники.НаселенныеПунктыДоставки.ПустаяСсылка() Тогда
					Продолжить;   
				КонецЕсли;	
            КонецЕсли;
		Иначе			
			НоваяЗапись = Справочники.РегионыДоставки.СоздатьЭлемент(); 
		КонецЕсли;   
		
		НоваяЗапись.Наименование = стр.Description;
		НоваяЗапись.НаименованиеRu = стр.DescriptionRu;
		НоваяЗапись.ОбластнойЦентр = ПолучитьЗаписьГорода(Стр.AreasCenter, узел);
        НоваяЗапись.Записать();              
		Если Не ЕстьЗапись Тогда
			СтрЗаписи = бит_сервер.ПолучитьСтруктуруЗаписи(НоваяЗапись.Ссылка, Стр.Ref,  ТипПриемника, ТипИсточника, Узел);
			бит_сервер.ДобавитьЗапись(СтрЗаписи);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

