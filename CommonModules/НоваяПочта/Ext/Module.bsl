                     Продолжить;
				 КонецЕсли;
			КонецЕсли;	 
		Иначе			
			НоваяЗапись = Справочники.Улицы.СоздатьЭлемент(); 
		КонецЕсли;   
		
		НоваяЗапись.Наименование   = стр.Description;
