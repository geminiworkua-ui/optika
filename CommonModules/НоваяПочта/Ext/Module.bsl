Функция ПолучитьСтатус(Статус)
	Если статус = "Working" Тогда
		Возврат перечисления.СтатусРаботы.Работает;
	Иначе
		Возврат перечисления.СтатусРаботы.НеРаботает;
	КонецЕсли;	
КонецФункции	

Функция ПолучитьТипПочтомата(ТипПочтомата)
	
	Если ТипПочтомата ="" или ТипПочтомата ="None" Тогда
		Возврат перечисления.НПТипПочтомата.ПустаяСсылка();
	ИначеЕсли ТипПочтомата ="FullDayService"  Тогда	
        Возврат перечисления.НПТипПочтомата.FullDayService;
	ИначеЕсли ТипПочтомата ="PartTime"  Тогда	
        Возврат перечисления.НПТипПочтомата.PartTime;	
	ИначеЕсли ТипПочтомата ="ForResidentOfEntrance"  Тогда	
        Возврат перечисления.НПТипПочтомата.ForResidentOfEntrance;
	ИначеЕсли ТипПочтомата ="Private"  Тогда	
        Возврат перечисления.НПТипПочтомата.Private;
	ИначеЕсли ТипПочтомата ="LimitedAccess"  Тогда	
        Возврат перечисления.НПТипПочтомата.LimitedAccess;
	Иначе Возврат перечисления.НПТипПочтомата.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции	

Процедура ЗарегистрироватьДанныеОтделений(Город, Данные, Узел)  
ТипИсточника = "СправочникСсылка.ОтделенияДоставки";
ТипПриемника = "НоваПошта.Warehouses";
  	
	Если Данные =Неопределено Тогда
		возврат;
	КонецЕсли;	
	
	Для каждого стр из Данные  Цикл
		ЕстьЗапись = бит_сервер.ЕстьЗапись(Стр.Ref, ТипПриемника, ТипИсточника, Узел);
		
		Если ЕстьЗапись Тогда
			Ссылка = бит_сервер.ПолучитьОбъект(Стр.Ref, ТипПриемника, ТипИсточника, Узел);
			НоваяЗапись = ссылка.ПолучитьОбъект(); 
			
			Если НоваяЗапись = Неопределено Тогда 
				СтрЗаписи = бит_сервер.ПолучитьСтруктуруЗаписи(Ссылка, Стр.Ref, ТипПриемника, ТипИсточника,  Узел);
				бит_сервер.УдалитьЗапись(СтрЗаписи);
				НоваяЗапись = Справочники.ОтделенияДоставки.СоздатьЭлемент();
			Иначе
				//Если Ссылка.ДатаСтатуса = Стр.WarehouseStatusDate Тогда
				//	 Продолжить;  
				//КонецЕсли;	
            КонецЕсли;
		Иначе			
			НоваяЗапись = Справочники.ОтделенияДоставки.СоздатьЭлемент(); 
		КонецЕсли;   
		
		НоваяЗапись.Наименование 	= стр.Description;             
		НоваяЗапись.НаименованиеRu  = стр.DescriptionRu;
		НоваяЗапись.Кратко   		= Стр.ShortAddress;
		НоваяЗапись.КраткоRu   		= Стр.ShortAddressRu;
		НоваяЗапись.Телефон   		= Стр.Phone;
		НоваяЗапись.НомерОтделения  = Стр.Number;
		НоваяЗапись.Индекс 			= Стр.PostalCodeUA; 
		НоваяЗапись.ЦифровойАдресНП = Стр.WarehouseIndex; 
		НоваяЗапись.ТипОтделения 	= ПолучитьТипОтделения(Стр, Узел);
		НоваяЗапись.Владелец 		= Город;     
		НоваяЗапись.Статус 			= ПолучитьСтатус(Стр.WarehouseStatus);    
		Если Не Стр.WarehouseStatusDate = Неопределено или Не Стр.WarehouseStatusDate = "" Тогда
			НоваяЗапись.ДатаСтатуса 	= Дата(Число(Лев(Стр.WarehouseStatusDate,4)), Число(Сред(Стр.WarehouseStatusDate,6,2)), Число(сред(Стр.WarehouseStatusDate,9,2)));
		КОнецЕсли;
		НоваяЗапись.Долгота         = Стр.Longitude;
		НоваяЗапись.Широта          = Стр.Latitude;  
		НоваяЗапись.ТипПочтомата    = ПолучитьТипПочтомата(Стр.PostMachineType);
		НоваяЗапись.ДанныеПоПосылке.Очистить();
		
			Высота  = НоваяЗапись.ДанныеПоПосылке.Добавить(); 
			Высота.Показатель = Перечисления.ЗначенияДляПосылки.Высота;
			Высота.ЗначениеОтправки = стр.SendingLimitationsOnDimensions.Height;
			Высота.ЗначениеПолучения = стр.ReceivingLimitationsOnDimensions.Height;
			
			Длина  = НоваяЗапись.ДанныеПоПосылке.Добавить(); 
			Длина.Показатель = Перечисления.ЗначенияДляПосылки.Длина; 			
			Длина.ЗначениеОтправки = стр.SendingLimitationsOnDimensions.Length; 
			Длина.ЗначениеПолучения = стр.ReceivingLimitationsOnDimensions.Length; 
			
			Ширина  = НоваяЗапись.ДанныеПоПосылке.Добавить(); 
			Ширина.Показатель = Перечисления.ЗначенияДляПосылки.Ширина; 
			Ширина.ЗначениеОтправки = стр.SendingLimitationsOnDimensions.Width;
			Ширина.ЗначениеПолучения = стр.ReceivingLimitationsOnDimensions.Width;	
			
			Вес =  НоваяЗапись.ДанныеПоПосылке.Добавить(); 
			Вес.Показатель = Перечисления.ЗначенияДляПосылки.Вес; 
            Вес.ЗначениеОтправки  =  стр.TotalMaxWeightAllowed;
			Вес.ЗначениеПолучения  =  стр.TotalMaxWeightAllowed;
	
		НоваяЗапись.ГрафикРаботы.Очистить();
		
		   Понедельник = НоваяЗапись.ГрафикРаботы.Добавить();
		   Понедельник.ДеньНедели = Перечисления.ДниНедели.Понедельник;
		   Понедельник.Доставка  =   стр.Delivery.Monday;
		   Понедельник.Расписание=   стр.Schedule.Monday;
		   Понедельник.Прием     =   стр.Reception.Monday;
		   
		   Вторник = НоваяЗапись.ГрафикРаботы.Добавить();
		   Вторник.ДеньНедели = Перечисления.ДниНедели.Вторник;
		   Вторник.Доставка  =   стр.Delivery.Tuesday;
		   Вторник.Расписание=   стр.Schedule.Tuesday;
		   Вторник.Прием     =   стр.Reception.Tuesday;

		   Среда = НоваяЗапись.ГрафикРаботы.Добавить();
		   Среда.ДеньНедели = Перечисления.ДниНедели.Среда;
		   Среда.Доставка  =   стр.Delivery.Wednesday;
		   Среда.Расписание=   стр.Schedule.Wednesday;
		   Среда.Прием     =   стр.Reception.Wednesday;
		   
		   Четверг = НоваяЗапись.ГрафикРаботы.Добавить();
		   Четверг.ДеньНедели = Перечисления.ДниНедели.Четверг;
		   Четверг.Доставка  =   стр.Delivery.Thursday;
		   Четверг.Расписание=   стр.Schedule.Thursday;
		   Четверг.Прием     =   стр.Reception.Thursday;
		   
		   Пятница = НоваяЗапись.ГрафикРаботы.Добавить();
		   Пятница.ДеньНедели = Перечисления.ДниНедели.Пятница;
		   Пятница.Доставка  =   стр.Delivery.Friday;
		   Пятница.Расписание=   стр.Schedule.Friday;
		   Пятница.Прием     =   стр.Reception.Friday;
		   
		   Суббота = НоваяЗапись.ГрафикРаботы.Добавить();
		   Суббота.ДеньНедели = Перечисления.ДниНедели.Суббота;
		   Суббота.Доставка  =   стр.Delivery.Saturday;
		   Суббота.Расписание=   стр.Schedule.Saturday;
		   Суббота.Прием     =   стр.Reception.Saturday;

		   Воскресенье = НоваяЗапись.ГрафикРаботы.Добавить();
		   Воскресенье.ДеньНедели = Перечисления.ДниНедели.Воскресенье;
		   Воскресенье.Доставка  =   стр.Delivery.Sunday;
		   Воскресенье.Расписание=   стр.Schedule.Sunday;
		   Воскресенье.Прием     =   стр.Reception.Sunday;
		   
        НоваяЗапись.Записать(); 
				
		Если Не ЕстьЗапись Тогда
			СтрЗаписи = бит_сервер.ПолучитьСтруктуруЗаписи(НоваяЗапись.Ссылка, Стр.Ref,  ТипПриемника, ТипИсточника, Узел);
			бит_сервер.ДобавитьЗапись(СтрЗаписи);
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

