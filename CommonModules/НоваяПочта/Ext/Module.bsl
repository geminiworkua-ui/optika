				НоваяЗапись = Справочники.НаселенныеПунктыДоставки.СоздатьЭлемент(); 
			
			КонецЕсли;
		Иначе			
			НоваяЗапись = Справочники.НаселенныеПунктыДоставки.СоздатьЭлемент(); 
		КонецЕсли;   
		
		НоваяЗапись.Наименование   = стр.Description;
		НоваяЗапись.НаименованиеRu = стр.DescriptionRu;
		НоваяЗапись.Владелец	   = ПолучитьЗаписьОбласти(Стр.Area, узел);
