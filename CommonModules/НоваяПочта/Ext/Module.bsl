		Понедельник.ДеньНедели = Перечисления.ДниНедели.Понедельник;
		Понедельник.Значение = стр.Delivery1="1";
		
		Вторник = НоваяЗапись.Доставка.Добавить();
		Вторник.ДеньНедели = Перечисления.ДниНедели.Вторник;
		Вторник.Значение = стр.Delivery2="1";
		
		Среда = НоваяЗапись.Доставка.Добавить();
		Среда.ДеньНедели = Перечисления.ДниНедели.Среда;
		Среда.Значение = стр.Delivery3="1";
		
		Четверг = НоваяЗапись.Доставка.Добавить();
		Четверг.ДеньНедели = Перечисления.ДниНедели.Четверг;
		Четверг.Значение = стр.Delivery4="1";
		
		Пятница = НоваяЗапись.Доставка.Добавить();
		Пятница.ДеньНедели = Перечисления.ДниНедели.Пятница;
		Пятница.Значение = стр.Delivery5="1";
		
		Суббота = НоваяЗапись.Доставка.Добавить();
		Суббота.ДеньНедели = Перечисления.ДниНедели.Суббота;
		Суббота.Значение = стр.Delivery6="1";
		
		Воскресенье = НоваяЗапись.Доставка.Добавить();
		Воскресенье.ДеньНедели = Перечисления.ДниНедели.Воскресенье;
		Воскресенье.Значение = стр.Delivery7="1";
		
		НоваяЗапись.Записать();              
		
		Если Не ЕстьЗапись Тогда
			СтрЗаписи = бит_сервер.ПолучитьСтруктуруЗаписи(НоваяЗапись.Ссылка, Стр.Ref, ТипПриемника, ТипИсточника, Узел);
			бит_сервер.ДобавитьЗапись(СтрЗаписи);
		КонецЕсли;
		
		Для Страница =1 по 100 Цикл    
			ДанныеУлиц = ЗапросУлицы(Стр.Ref, Узел, Формат(Страница,"ЧГ=0"));
			Если ДанныеУлиц = Неопределено Тогда
				Прервать;
			КонецЕсли;	
						
			Если ДанныеУлиц.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;	
            ЗарегистрироватьДанныеУлиц(НоваяЗапись.ссылка, ДанныеУлиц, Узел);
		КонецЦикла;	
		
		Для Страница =1 по 100 Цикл    
			ДанныеОтделений = ЗапросОтделенияПочтоматы(Стр.Ref, Узел, Формат(Страница,"ЧГ=0"));
			Если ДанныеОтделений = Неопределено Тогда
				Прервать;
			КонецЕсли;	
						
			Если ДанныеОтделений.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;	
            ЗарегистрироватьДанныеОТделений(НоваяЗапись.ссылка, ДанныеОтделений, Узел);
		КонецЦикла;	

		
	КонецЦикла;	
КонецПроцедуры

Процедура ЗарегистрироватьДанныеУлиц(Город, Данные, Узел)
ТипИсточника = "СправочникСсылка.Улицы";
ТипПриемника = "НоваПошта.Street";

	Если Данные =Неопределено Тогда
		возврат;
	КонецЕсли;	
	
	Для каждого стр из Данные  Цикл
		ЕстьЗапись = бит_сервер.ЕстьЗапись(Стр.Ref, ТипПриемника, ТипИсточника, Узел);
		
		Если ЕстьЗапись Тогда
			Ссылка = бит_сервер.ПолучитьОбъект(Стр.Ref, ТипПриемника, ТипИсточника, Узел);
			НоваяЗапись = ссылка.ПолучитьОбъект(); 
			
			Если НоваяЗапись = Неопределено Тогда 
