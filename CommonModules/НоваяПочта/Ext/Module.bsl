Функция СформироватьСтрЗапрос(modelName, calledMethod,methodProperties = Неопределено, Узел)
	
	СтруктураТела = Новый Структура;
	
	СтруктураТела.Вставить("apiKey", Узел.КлючНП);
	СтруктураТела.Вставить("modelName", modelName);
	СтруктураТела.Вставить("calledMethod", calledMethod);  
	Если Не methodProperties = Неопределено Тогда
		СтруктураТела.Вставить("methodProperties", methodProperties);
	КонецЕсли;

	Возврат СформироватьJSON(СтруктураТела);
КонецФункции	

Функция СформироватьЗапрос(ТелоЗапроса, Узел)
	
//url= "api.novaposhta.ua/v2.0/json/"; 

ПолныйАдресРесурса = Узел.APINP;
СтруктураURI = СтруктураURI(ПолныйАдресРесурса);
HTTPСоединение = Новый HTTPСоединение(СтруктураURI.Хост, СтруктураURI.Порт);
HTTPЗапрос = Новый HTTPЗапрос(СтруктураURI.ПутьНаСервере);

HttpЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
HttpЗапрос.Заголовки.Вставить("Content-Type", "application/json"); 
HttpЗапрос.Заголовки.Вставить("Accept", "application/json"); 

Попытка
ответ = HttpСоединение.ОтправитьДляОбработки(HttpЗапрос);
Возврат Ответ;
Исключение

КонецПопытки;
КонецФункции
	
Процедура ОбработатьЗапрос(ТелоЗапроса, ОтветСтрока, узел)
	Ответ = СформироватьЗапрос(ТелоЗапроса, узел);
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтветСтрока = ответ.ПолучитьТелоКакСтроку();   
КонецПроцедуры	
	
Процедура ОбработкаЗапроса(JSON, ОтветСтр, Узел)   
	СтрокаОтвета="";
	ОбработатьЗапрос(JSON, СтрокаОтвета, Узел);      
	Если Не СтрокаОтвета ="" Или Не СтрокаОтвета = Неопределено Тогда
		Попытка
			ОтветСтр = ЧтениеJson(СтрокаОтвета);  
		Исключение
			
		КонецПопытки;	
	КонецЕсли;	
КонецПроцедуры	

Функция ВыполнитьЗапрос(ТелоЗапроса, Узел)          
	ОтветСтр =Неопределено;                 
	
	ОбработкаЗапроса(ТелоЗапроса, ОтветСтр, Узел); 
	Если ОтветСтр = Неопределено
		Тогда Возврат Неопределено;
	КонецЕсли;
	
	Если ОтветСтр.success Тогда
		возврат ОтветСтр.data;
	КонецЕсли;
	
КонецФункции

