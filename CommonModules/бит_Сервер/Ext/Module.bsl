	КонецЕсли;
	
Если Не Чек.ОплатаПлатежнымиКартами.Итог("Сумма")=0 Тогда
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЧекККМВозврат.ДокументОснование.БанковскийСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)
	|			ТОГДА ЧекККМВозврат.ДокументОснование.БанковскийСчет.Владелец
	|		КОГДА ЧекККМВозврат.ДокументОснование.Касса <> ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка)
	|			ТОГДА ЧекККМВозврат.ДокументОснование.Касса.Владелец
	|		ИНАЧЕ ЧекККМВозврат.Организация
	|	КОНЕЦ КАК Организация,
	|	ЧекККМВозврат.Партнер КАК Партнер,
	|	ВЫБОР
	|		КОГДА ЧекККМВозврат.ДокументОснование.Договор.ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоДоговорамКонтрагентов)
	|			ТОГДА ЧекККМВозврат.ДокументОснование.Договор.СтатьяДвиженияДенежныхСредств
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(ЧекККМВозврат.ДокументОснование.Договор.СтатьяДвиженияДенежныхСредств, ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|					ТОГДА ВЫРАЗИТЬ(ЧекККМВозврат.ДокументОснование.Соглашение КАК Справочник.СоглашенияСКлиентами).СтатьяДвиженияДенежныхСредств
	|				ИНАЧЕ ЧекККМВозврат.ДокументОснование.Договор.СтатьяДвиженияДенежныхСредств
	|			КОНЕЦ
	|	КОНЕЦ КАК СтатьяДвиженияДенежныхСредств,
