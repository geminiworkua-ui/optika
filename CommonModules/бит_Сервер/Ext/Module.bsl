//Функция проверки наличия объекта по Ссылке, типу Приемника и типу Источника в регистре для обмена
Функция ПолучитьУИД(Объект, ТипПриемника, ТипИсточника, Узел ) Экспорт
ТекстЗапроса = "ВЫБРАТЬ
               |	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника КАК УникальныйИдентификаторПриемника
               |ИЗ
               |	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
               |ГДЕ
               |	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &УзелИнформационнойБазы
               |	И СоответствияОбъектовИнформационныхБаз.ТипПриемника = &ТипПриемника
               |	И СоответствияОбъектовИнформационныхБаз.ТипИсточника = &ТипИсточника
               |	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника = &УникальныйИдентификаторИсточника";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УзелИнформационнойБазы",           Узел);
	Запрос.УстановитьПараметр("УникальныйИдентификаторИсточника", Объект);
	Запрос.УстановитьПараметр("ТипПриемника", ТипПриемника);
	Запрос.УстановитьПараметр("ТипИсточника", ТипИсточника);

	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("УникальныйИдентификаторИсточника");

КонецФункции	

//Формирование структуры для записив регистр обмена
//ссылка - объект Источник 8.3
//ID - Идентификатор приемника
//ТипПриемника - тип приемника 7.7
//Узел - узел обмена
Функция ПолучитьСтруктуруЗаписи(Ссылка, ID, ТипПриемника, ТипИсточника, Узел) Экспорт
СтрЗаписи = Новый Структура;
СтрЗаписи.Вставить("УникальныйИдентификаторПриемника", Лев(СокрЛП(ID),36));
СтрЗаписи.Вставить("УникальныйИдентификаторИсточника", Ссылка);
ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
//ТипИсточника = ?(ОбъектМетаданных = Неопределено, Строка(ТипЗнч(Ссылка)), ОбъектМетаданных.ПолноеИмя());
СтрЗаписи.Вставить("ТипПриемника", ТипПриемника); 
СтрЗаписи.Вставить("ТипИсточника", ТипИсточника);
СтрЗаписи.Вставить("УзелИнформационнойБазы", Узел); 
СтрЗаписи.Вставить("УникальныйИдентификаторИсточникаСтрокой",Ссылка.УникальныйИдентификатор()); 
СтрЗаписи.Вставить("ОбъектВыгруженПоСсылке", Истина);
Возврат СтрЗаписи;
КонецФункции

Функция ПолучитьСтруктуруЗаписиВБУ(Ссылка, ID, ТипПриемника, ТипИсточника, Узел, Соединение) Экспорт
СтрЗаписи = Новый Структура;
СтрЗаписи.Вставить("УникальныйИдентификаторПриемника", Лев(СокрЛП(ID),36));
СтрЗаписи.Вставить("УникальныйИдентификаторИсточника", Ссылка);
ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
//ТипИсточника = ?(ОбъектМетаданных = Неопределено, Строка(ТипЗнч(Ссылка)), ОбъектМетаданных.ПолноеИмя());
СтрЗаписи.Вставить("ТипПриемника", ТипПриемника); 
СтрЗаписи.Вставить("ТипИсточника", ТипИсточника);
СтрЗаписи.Вставить("УзелИнформационнойБазы", Узел); 
СтрЗаписи.Вставить("УникальныйИдентификаторИсточникаСтрокой",ПолучитьGuid(Соединение,Ссылка)); 
СтрЗаписи.Вставить("ОбъектВыгруженПоСсылке", Истина);
Возврат СтрЗаписи;
КонецФункции

//Получить объект по Идентификатору приемника с указанием типа Источника, типа Приемника и узла обмена 
//Приемник =  7.7.
//Источник =  8.3
Функция ПолучитьОбъект(ID, ТипПриемника, ТипИсточника, Узел) Экспорт
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника КАК УникальныйИдентификаторИсточника
|ИЗ
|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
|ГДЕ
|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &УзелИнформационнойБазы
|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника = &УникальныйИдентификаторПриемника
|	И СоответствияОбъектовИнформационныхБаз.ТипПриемника = &ТипПриемника
|	И СоответствияОбъектовИнформационныхБаз.ТипИсточника = &ТипИсточника");
Запрос.УстановитьПараметр("УникальныйИдентификаторПриемника", ID);
Запрос.УстановитьПараметр("ТипПриемника", ТипПриемника);
Запрос.УстановитьПараметр("ТипИсточника", ТипИсточника);
Запрос.УстановитьПараметр("УзелИнформационнойБазы", Узел);
Результат = Запрос.Выполнить().Выбрать();
Возврат ?(Результат.Следующий(), Результат.УникальныйИдентификаторИсточника, Неопределено);
КонецФункции	

//Получить объект по Идентификатору приемника с указанием типа Источника, типа Приемника и узла обмена 
//Приемник =  7.7.
//Источник =  8.3
Процедура УдалитьОбъект(ID, ТипПриемника, ТипИсточника, Узел) Экспорт    
НаборЗаписей = РегистрыСведений.СоответствияОбъектовИнформационныхБаз.СоздатьНаборЗаписей();
НаборЗаписей.Отбор.УзелИнформационнойБазы.Установить(Узел);
НаборЗаписей.Отбор.ТипПриемника.Установить(ТипПриемника);
НаборЗаписей.Отбор.ТипИсточника.Установить(ТипИсточника);
НаборЗаписей.Отбор.ТипИсточника.Установить(ТипИсточника);
НаборЗаписей.Отбор.УникальныйИдентификаторПриемника.Установить(ID);
НаборЗаписей.Записать(Истина);
КонецПроцедуры	


