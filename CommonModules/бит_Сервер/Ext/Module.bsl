			ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,Чек);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ЕстьЗачетПоВозвратам(Чек) Тогда
		Если Не МассивУзлов = Неопределено Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,Чек);
		КонецЕсли;
		Возврат;
	КонецЕсли;
			
	Если Не Чек.ВыданоНаличными = 0 Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ВЫБОР
		                      |		КОГДА ЧекККМВозврат.ДокументОснование.Касса <> ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка)
		                      |			ТОГДА ЧекККМВозврат.ДокументОснование.Касса.Владелец
		                      |		КОГДА ЧекККМВозврат.ДокументОснование.БанковскийСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)
		                      |			ТОГДА ЧекККМВозврат.ДокументОснование.БанковскийСчет.Владелец
		                      |		ИНАЧЕ ЧекККМВозврат.ДокументОснование.Организация
		                      |	КОНЕЦ КАК Организация,
		                      |	ЧекККМВозврат.ДокументОснование.Партнер КАК Партнер,
		                      |	ЧекККМВозврат.ДокументОснование.Контрагент КАК Контрагент,
		                      |	ЧекККМВозврат.ДокументОснование.Контрагент.Наименование КАК КонтрагентНаименование,
		                      |	ЧекККМВозврат.ДокументОснование.Контрагент.НаименованиеПолное КАК КонтрагентНаименованиеПолное,
		                      |	ЧекККМВозврат.ДокументОснование.Договор КАК Договор,
		                      |	ЧекККМВозврат.ДокументОснование КАК ДокументОснование,
		                      |	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента) КАК ХозяйственнаяОперация,
		                      |	ЧекККМВозврат.ДокументОснование.Касса КАК Касса,
		                      |	ЧекККМВозврат.Валюта КАК Валюта
		                      |ИЗ
		                      |	Документ.ЧекККМВозврат КАК ЧекККМВозврат
		                      |ГДЕ
		                      |	ЧекККМВозврат.Ссылка = &Ссылка
		                      |	И ЧекККМВозврат.ДокументОснование.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию)
		                      |	И ЧекККМВозврат.ДокументОснование.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПриемНаКомиссиюИмпорт)
		                      |	И ЧекККМВозврат.ДокументОснование.ПорядокРасчетов <> ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоНакладным)");
		
		Запрос.УстановитьПараметр("Ссылка", Чек);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда	
			ДокОрдер = НайтиСоздатьДокРКО(Чек);  
			ДокОрдер.РасшифровкаПлатежа.Очистить();
			ДанныеЗаполнения = Новый Структура;
			Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
				ДанныеЗаполнения.Вставить(Колонка.Имя);
			КонецЦикла;
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(ДанныеЗаполнения, Выборка);
			
			Если Не ПустаяСтрока(Выборка.КонтрагентНаименованиеПолное) Тогда
				ДанныеЗаполнения.Вставить("Выдать", Выборка.КонтрагентНаименованиеПолное);
			Иначе
