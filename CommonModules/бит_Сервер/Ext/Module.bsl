Функция ПолучитьСтруктуруОбмена(Узел)
	СтрОбмена = Новый Структура;
	СтрОбмена.Вставить("Реализации", Ложь);
	СтрОбмена.Вставить("Контрагенты", Ложь);
	СтрОбмена.Вставить("Номенклатура", Ложь);
	СтрОбмена.Вставить("ВозвратРеализации", Ложь);
	СтрОбмена.Вставить("Поступление", Ложь);
	СтрОбмена.Вставить("ВозвратПоступления", Ложь);
	СтрОбмена.Вставить("Оприходование", Ложь);
	СтрОбмена.Вставить("Списание", Ложь); 
	СтрОбмена.Вставить("ЦеныПоставщиков", Ложь); 
	Для каждого Стр из Узел.ОбъектыОбмена Цикл
        Если Не Стр.Выбран Тогда
				Продолжить;
		КонецЕсли;

	    Если Стр.ОбъектОбмена = Перечисления.ОбъектыОбмена.ТМЦ Тогда
		    	СтрОбмена.Номенклатура = Стр.Выбран;
				
			ИначеЕсли Стр.ОбъектОбмена = Перечисления.ОбъектыОбмена.Клиенты Тогда
		    	СтрОбмена.Контрагенты = Стр.Выбран;
				
			ИначеЕсли Стр.ОбъектОбмена	= Перечисления.ОбъектыОбмена.РегистрацияРеализации Тогда
				СтрОбмена.Реализации = Стр.Выбран;
				
			ИначеЕсли Стр.ОбъектОбмена	= Перечисления.ОбъектыОбмена.РегистрацияВозвратаРеализации Тогда
				СтрОбмена.ВозвратРеализации= Стр.Выбран;
				
			ИначеЕсли Стр.ОбъектОбмена	= Перечисления.ОбъектыОбмена.РегистрацияПоступлений Тогда
				СтрОбмена.Поступление = Стр.Выбран;
				
			ИначеЕсли Стр.ОбъектОбмена	= Перечисления.ОбъектыОбмена.РегистрацияВозвратовПоставщику Тогда
				СтрОбмена.ВозвратПоступления = Стр.Выбран;
				
			ИначеЕсли Стр.ОбъектОбмена	= Перечисления.ОбъектыОбмена.РегистрацияОприходований Тогда
				СтрОбмена.Оприходование = Стр.Выбран;
				
			ИначеЕсли Стр.ОбъектОбмена	= Перечисления.ОбъектыОбмена.РегистрацияСписаний Тогда
				СтрОбмена.Списание = Стр.Выбран;
				
			ИначеЕсли Стр.ОбъектОбмена	= Перечисления.ОбъектыОбмена.ЦеныПоставщиков Тогда
				СтрОбмена.ЦеныПоставщиков = Стр.Выбран;	
			КонецЕсли;	
	КонецЦикла;    
	Возврат  СтрОбмена;
КонецФункции	

