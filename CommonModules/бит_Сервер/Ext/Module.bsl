		 Guid = ПолучитьGuid(Соединение, Договор.Ссылка);
		 ЕстьВРегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел); 
  
			Если   ЕстьВРегистре Тогда
				ДоговорСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);  
				Попытка
					ДоговорОбъект = ДоговорСсылка.получитьОбъект();
				Исключение 
					ПартнерОбъект =Неопределено;
					УдалитьЗапись(ПолучитьСтруктуруЗаписи(ДоговорСсылка, Guid , ТипПриемника, ТипИсточника, Узел));
				КонецПопытки;	

				Если ДоговорОбъект = Неопределено Тогда
					ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
					ЕстьВРегистре = Ложь; 
				Иначе 
					//Возврат ПартнерСсылка;	
					ДоговорОбъект = ДоговорСсылка.ПолучитьОбъект(); 
				КонецЕсли;	

			Иначе	
			 ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			КонецЕсли;   
			
			ДоговорОбъект.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
			ДоговорОбъект.Контрагент = Контрагент;
			ДоговорОбъект.Номер = Договор.Ссылка.Номер;
			ДоговорОбъект.Дата = Договор.Ссылка.Дата;
