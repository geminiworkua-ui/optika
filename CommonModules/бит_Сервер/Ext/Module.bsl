Процедура ЗакрытьЗаказы() Экспорт

	// + Боков Ошибка прав доступа на ограниченных правах
	УстановитьПривилегированныйрежим(Истина);
	// - Боков
	
	Запрос = Новый Запрос (
	"ВЫБРАТЬ
	|	ЧекККМ.ДокументОснование
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	|	И НЕ ЧекККМ.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И ЧекККМ.КассоваяСмена.Дата > &Дата");
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
	Результат  =Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		ДокОб = Результат.ДокументОснование.ПолучитьОбъект();
		ДокОб.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт;
		Попытка
			ДокОб.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;	
КонецПроцедуры	

