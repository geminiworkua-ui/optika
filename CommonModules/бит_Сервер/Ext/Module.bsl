			ДокПлатеж.ЭквайринговыйТерминал = Стр.ЭквайринговыйТерминал;
			ДокПлатеж.ОплатаВыполнена = Истина;
			ДокПлатеж.НомерЧекаККМ = Чек.НомерЧекаККМ;
			ДокПлатеж.НомерПлатежнойКарты = Стр.НомерПлатежнойКарты;
