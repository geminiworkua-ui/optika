//Процедура регламентного задания проверки и создания взаиморасчетов по Чекам ККМ
Процедура ВыполнитьРасчет() Экспорт
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	ЧекККМИзменения.Ссылка
|ИЗ
|	Документ.ЧекККМ.Изменения КАК ЧекККМИзменения
|ГДЕ
|	ЧекККМИзменения.Узел В
|			(ВЫБРАТЬ
|				Настройки.Ссылка
|			ИЗ
|				ПланОбмена.Настройки КАК Настройки
|			ГДЕ
|				НЕ Настройки.ЭтотУзел)");
Результат = Запрос.Выполнить().Выбрать(); 
ЗапросУзлов = Новый Запрос(
"ВЫБРАТЬ
|			Настройки.Ссылка
|			ИЗ
|				ПланОбмена.Настройки КАК Настройки
|			ГДЕ
|				НЕ Настройки.ЭтотУзел");
РезультатУзлов = ЗапросУзлов.Выполнить().Выгрузить(); 
МассивУзлов = РезультатУзлов.ВыгрузитьКолонку("ссылка"); 
Пока Результат.Следующий() Цикл
    НайтиСоздатьОрдер(Результат.Ссылка);
КонецЦикла;	

КонецПроцедуры	

//Процедура регламентного задания проверки и создания взаиморасчетов по Чекам возврата ККМ
Процедура ОпределитьВозвраты() Экспорт
	
	// + Боков Ошибка прав доступа на ограниченных правах
	УстановитьПривилегированныйрежим(Истина);
	// - Боков
	
	
	
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЧекККМВозвратИзменения.Ссылка
	|ИЗ
	|	Документ.ЧекККМВозврат.Изменения КАК ЧекККМВозвратИзменения
	|ГДЕ
	|	ЧекККМВозвратИзменения.Узел В
	|			(ВЫБРАТЬ
	|				Настройки.Ссылка
	|			ИЗ
	|				ПланОбмена.Настройки КАК Настройки
	|			ГДЕ
	|				НЕ Настройки.ЭтотУзел)");
	Результат = Запрос.Выполнить().Выбрать(); 
	Пока Результат.Следующий() Цикл
		НайтиСоздатьОрдерВозврат(Результат.Ссылка);
	КонецЦикла;	
КонецПроцедуры	

//Процедура проверки и при необходимости создания документов взаиморасчета
Процедура НайтиСоздатьОрдер(Чек) Экспорт 
	
	// + Боков Ошибка прав доступа на ограниченных правах
	УстановитьПривилегированныйрежим(Истина);
	// - Боков
	
	МассивУзлов =  МассивУзловРегистрации();

	Если Не ЗначениеЗаполнено(Чек) Тогда
		Возврат;                        
	КонецЕсли;
	
	Если Не Чек.статус = Перечисления.СтатусыЧековККМ.Пробит Тогда
		Если Не МассивУзлов = Неопределено Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,Чек);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ЕстьЗачетПоОплатам(Чек) Тогда
		Если Не МассивУзлов = Неопределено Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,Чек);
		КонецЕсли;
		Возврат;
	КонецЕсли;
			
	Если Не Чек.ПолученоНаличными = 0 Тогда
		Запрос = Новый Запрос("
			
		|ВЫБРАТЬ
	    |	ВЫБОР
	    |		КОГДА ДанныеДокумента.ДокументОснование.Касса <> ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка)
	    |			ТОГДА ДанныеДокумента.ДокументОснование.Касса.Владелец
