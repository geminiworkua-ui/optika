Процедура УстановитьКИ(Соединение, контрагент, Партнер) 
Партнер.КонтактнаяИнформация.Очистить();

Для каждого Стр из контрагент.КонтактнаяИнформация Цикл
	//Ищем подобную информацию по представлению
	СтрПоиска = Новый Структура;
	СтрПоиска.Вставить("Представление", СокрЛП(Стр.Представление));
	
	Строки = Партнер.КонтактнаяИнформация.НайтиСтроки(СтрПоиска);
	Если Строки.Количество()>0 Тогда
		Продолжить;
	КонецЕсли;
	
	Если Стр.вид.PredefinedDataName = "ЮрАдресКонтрагента" Тогда
		Если Не СокрЛП(Стр.Представление) ="" Тогда
			КИ = Партнер.КонтактнаяИнформация.Добавить();
			КИ.Вид = справочники.ВидыКонтактнойИнформации.АдресПартнера;
			КИ.Представление = СокрЛП(Стр.Представление); 
		КонецЕсли;	
	ИначеЕсли Стр.вид.PredefinedDataName = "ФактАдресКонтрагента" Тогда
		Если Не СокрЛП(Стр.Представление) ="" Тогда
			КИ = Партнер.КонтактнаяИнформация.Добавить();
			КИ.Вид = справочники.ВидыКонтактнойИнформации.АдресПартнера;
			КИ.Представление = СокрЛП(Стр.Представление);
		КонецЕсли;	
	ИначеЕсли Стр.вид.PredefinedDataName = "ПочтовыйАдресКонтрагента" Тогда
		Если Не СокрЛП(Стр.Представление) ="" Тогда
			КИ = Партнер.КонтактнаяИнформация.Добавить();
			КИ.Вид = справочники.ВидыКонтактнойИнформации.АдресПартнера;
			КИ.Представление = СокрЛП(Стр.Представление);
		КонецЕсли;		
	ИначеЕсли Стр.вид.PredefinedDataName = "ТелефонКонтрагента" Тогда
		Если Не СокрЛП(Стр.Представление) ="" Тогда
			КИ = Партнер.КонтактнаяИнформация.Добавить();
			КИ.Вид = справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
			КИ.Представление = СокрЛП(Стр.Представление);  
		КонецЕсли;	
	ИначеЕсли Стр.вид.PredefinedDataName = "ФаксКонтрагенты" Тогда
		Если Не СокрЛП(Стр.Представление) ="" Тогда
			КИ = Партнер.КонтактнаяИнформация.Добавить();
			КИ.Вид = справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
			КИ.Представление = СокрЛП(Стр.Представление);  
		КонецЕсли;		
	ИначеЕсли Стр.вид.PredefinedDataName = "EmailКонтрагенты" Тогда
		Если Не СокрЛП(Стр.Представление) ="" Тогда
			КИ = Партнер.КонтактнаяИнформация.Добавить();
			КИ.Вид = справочники.ВидыКонтактнойИнформации.EmailПартнера;
			КИ.Представление = СокрЛП(Стр.Представление);  	
		КонецЕсли;	
	КонецЕсли;	
КонецЦикла;	        
	
КонецПроцедуры	

Функция ЗначениеНоменклатурыБУ(Ссылка) Экспорт  
	НаборЗаписей = РегистрыСведений.СоответствияОбъектовИнформационныхБаз.СоздатьНаборЗаписей();   
	
	//НаборЗаписей.Отбор.Узел =
	УзелБУ = УзелБУ();
	Соединение = ПодключитьБазу(УзелБУ); 
	УзелУТ = Соединение.бит_сервер.УзелУТ();

	ТипПриемника ="Справочник.Номенклатура";

	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Номенклатура") Тогда
		ТипИсточника ="Справочник.Номенклатура";
	Иначе
		ТипИсточника ="Справочник.ХарактеристикиНоменклатуры";
	КонецЕсли;	

	ЕстьВРегистре = ЕстьЗаписьСсылки(Ссылка, ТипПриемника, ТипИсточника, УзелБУ);
	Если ЕстьВрегистре Тогда                 
		    ГУИД = ПолучитьУИД(Ссылка, ТипПриемника, ТипИсточника, УзелБУ);
			Возврат Соединение.Справочники.Номенклатура.ПолучитьСсылку(ГУИД);
		Иначе Возврат Соединение.бит_Сервер.НайтиСоздатьНоменклатуру(Ссылка, ТипИсточника);
    КонецЕсли;
    
КонецФункции 

Функция ЗначениеКонтрагентБУ(Ссылка) Экспорт
	УзелБУ = УзелБУ();
	Соединение = ПодключитьБазу(УзелБУ); 
	УзелУТ = Соединение.бит_сервер.УзелУТ();

	ТипПриемника ="Справочник.Контрагенты";
