//Определяет вариант обеспечения Товаров в заказе покупателя
Функция ВариантОбеспечения(ВходныеДанные) Экспорт 
Если ВходныеДанные.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга или
     ВходныеДанные.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа
Тогда Возврат перечисления.ВариантыОбеспечения.НеТребуется;
КонецЕсли;
	
НаличиеНужногоКоличества = ЕстьОстаток(ВходныеДанные);	
Если НаличиеНужногоКоличества =Неопределено	Тогда
	Возврат перечисления.ВариантыОбеспечения.ИзЗаказов;
ИначеЕсли НаличиеНужногоКоличества Тогда
    Возврат перечисления.ВариантыОбеспечения.СоСклада;
Иначе Возврат перечисления.ВариантыОбеспечения.Обособленно;
КонецЕсли;	
КонецФункции

//Определяет наличиесвободного остатка по товарной позиции в заказе покупателя
Функция ЕстьОстаток(ВходящиеДанные) Экспорт
Если ВходящиеДанные = Неопределено Тогда
	Возврат Ложь;
КонецЕсли;	

Если Не ВходящиеДанные.Свойство("Номенклатура") Тогда
	Возврат Неопределено;
КонецЕсли;	

Если Не ВходящиеДанные.Свойство("Характеристика") Тогда
	Возврат Неопределено;
КонецЕсли;	

Если Не ВходящиеДанные.Свойство("Склад") Тогда
	Возврат Неопределено;
КонецЕсли;	

Если Не ВходящиеДанные.Свойство("Количество") Тогда
	Возврат Неопределено;
КонецЕсли;	

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВЫБОР
                      |		КОГДА ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0) >= &Количество
                      |			ТОГДА ИСТИНА
                      |		ИНАЧЕ ЛОЖЬ
                      |	КОНЕЦ КАК Наличие
                      |ИЗ
                      |	РегистрНакопления.СвободныеОстатки.Остатки(
                      |			&Дата,
                      |			Номенклатура = &Номенклатура
                      |				И Характеристика = &Характеристика
                      |				И Склад = &Склад) КАК СвободныеОстаткиОстатки");      
	Запрос.УстановитьПараметр("Номенклатура", 	ВходящиеДанные.Номенклатура);    
	Запрос.УстановитьПараметр("Характеристика", ВходящиеДанные.Характеристика);
  	Запрос.УстановитьПараметр("Количество", 	ВходящиеДанные.Количество);
	Запрос.УстановитьПараметр("Склад", 			ВходящиеДанные.Склад);
	Запрос.УстановитьПараметр("Дата", 			ТекущаяДата());
рез =Запрос.Выполнить().Выбрать();
Если Рез.Следующий() Тогда
	Возврат Рез.Наличие;
	Иначе Возврат Ложь;
КонецЕсли;	
КонецФункции

//Определяет сободный остаток по товарной позиции в заказе покупателя
Функция СвободныйОстаток(ВходящиеДанные) Экспорт
Если ВходящиеДанные = Неопределено Тогда
	Возврат Ложь;
КонецЕсли;	

Если Не ВходящиеДанные.Свойство("Номенклатура") Тогда
