Процедура ОбменБухгалтерия(ПараметрыЗагрузки = Неопределено, АдресРезультата = Неопределено)Экспорт
	МассивУзлов = МассивУзловОбмена();
	
	Для каждого Узел из МассивУзлов Цикл
		Соединение  = ПодключитьБазу(Узел);
		СтрОбмена = ПолучитьСтруктуруОбмена(Узел);
								
			Если СтрОбмена.Номенклатура Тогда
		    	СопоставитьНоменклатуру(Соединение, Узел); 
			КонецЕсли;
			
			Если СтрОбмена.Контрагенты Тогда
		    	СписокКонтрагентыБух(Соединение, Узел); 
			КонецЕсли;
			
			Если СтрОбмена.Реализации Тогда
				СписокРеализации(Соединение, Узел);                                         
			КонецЕсли;
						
			Если СтрОбмена.ВозвратРеализации Тогда
				СписокВозвратаРеализации(Соединение, Узел);
			КонецЕсли;
			
			Если СтрОбмена.Поступление Тогда
				СписокПоступление(Соединение, Узел);
			КонецЕсли;	
				
		    Если СтрОбмена.ВозвратПоступления Тогда
				СписокВозвратПоставщику(Соединение, Узел);
			КонецЕсли;
			
		    Если СтрОбмена.Оприходование Тогда
				СписокОприходование(Соединение, Узел);                                         
			КонецЕсли;	
				
	        Если СтрОбмена.Списание Тогда
				СписокСписание(Соединение, Узел);	
		    КонецЕсли;	
			
			Если СтрОбмена.ЦеныПоставщиков Тогда
				ЦеныПоставщиковБУ(Соединение, Узел);	
		    КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЦеныПоставщиковБУ(Соединение, Узел)
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
 "ВЫБРАТЬ РАЗЛИЧНЫЕ
|	Контрагенты.Ссылка КАК Контрагент
|ИЗ
|	Справочник.Контрагенты КАК Контрагенты
|ГДЕ
|	НЕ Контрагенты.ПометкаУдаления
|	И НЕ Контрагенты.ЭтоГруппа";

Результат = Запрос.Выполнить().выгрузить();
Текущий =0;
Всего = Результат.Количество();
Для каждого Стр из Результат  Цикл  
	Текущий = Текущий +1;		
	ПроцентВыполнения = (Текущий/Всего)*100;
	ПроцентВыполнения = Окр(ПроцентВыполнения,0);
    ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП(Стр.Контрагент.Наименование)); 
	Контрагент = Контрагенты(Соединение, Стр, Узел);
	НоменклатураКонтрагента = ПолучитьМассивНоменклатурыКонтрагента(Соединение, Стр.Контрагент, Контрагент, Узел);
	Если НоменклатураКонтрагента.Количество()=0 Тогда
		Продолжить;
	КОнецЕсли;	
	//ВидЦеныПоставщика = ПолучитьВидЦеныПоставщика(Контрагент, НоменклатураКонтрагента[0].ЦенаВключаетНДС);
    ДокОб = Документы.РегистрацияЦенНоменклатурыПоставщика.СоздатьДокумент();
	ДокОб.Дата = ?(Узел.ДатаПерехода = Дата(1,1,1), ТекущаяДата(), Узел.ДатаПерехода);
	ДокОб.Партнер = Контрагент;
	Для каждого СтрК из НоменклатураКонтрагента Цикл         
		Если СтрК.НоменклатураКонтрагента = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		 СтрТовар = ДокОб.Товары.Добавить();
		 СтрТовар.ВидЦеныПоставщика = ПолучитьВидЦеныПоставщика(Контрагент, СтрК.ЦенаВключаетНДС);
		 СтрТовар.НоменклатураПоставщика = СтрК.НоменклатураКонтрагента;
		 СтрТовар.Номенклатура = СтрК.НоменклатураКонтрагента.Номенклатура;
		 СтрТовар.Характеристика = СтрК.НоменклатураКонтрагента.Характеристика;
		 СтрТовар.Упаковка =  СтрТовар.Номенклатура.ЕдиницаИзмерения;
		 СтрТовар.Цена = СтрК.Цена;
	КонецЦикла;	
	
	Если ДокОб.Товары.количество() = 0 Тогда
		 Продолжить;
	КонецЕсли;
	 
	ДокОб.Записать(РежимЗаписиДокумента.Запись);
	
	Попытка
		ДокОб.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
	КонецПопытки;
	
КонецЦикла;	

КонецПроцедуры	

Функция ПолучитьВидЦеныПоставщика(Контрагент, ЦенаВключаетНДС)
