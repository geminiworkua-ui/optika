Функция НайтиКонтрагентаПоЕДРПОУ(КодПоЕДРПОУ)
	Если СокрЛП(КодПоЕДРПОУ) ="" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос =Новый Запрос(
	 "ВЫБРАТЬ
	 |	Контрагенты.Ссылка
	 |ИЗ
	 |	Справочник.Контрагенты КАК Контрагенты
	 |ГДЕ
	 |	Контрагенты.КодПоЕДРПОУ = &КодПоЕДРПОУ
	 |	И Не Контрагенты.ПометкаУдаления");
	
	Запрос.УстановитьПараметр("КодПоЕДРПОУ", СокрЛП(КодПоЕДРПОУ));
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.ссылка;
	КонецЕсли;
	
КонецФункции	

Процедура УстановитьДоговора(Соединение, Договора, Контрагент, Партнер, Узел)
ТипПриемника ="Справочник.ДоговораКонтрагентов";
ТипИсточника ="Справочник.ДоговораКонтрагентов";	
//УзелУТ = Соединение.бит_сервер.УзелУТ();
	
