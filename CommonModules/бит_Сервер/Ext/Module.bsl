	Контрагент = ЗнКонтрагент(Соединение, Стр.Контрагент, Guid, ПартнерОбъект.Ссылка, Узел);
	ПартнерОбъект.КонтактнаяИнформация.Очистить(); 
	УстановитьКИ(Соединение, Стр.Контрагент, ПартнерОбъект);
	ПартнерОбъект.Записать();
	УИД  = ПартнерОбъект.Ссылка.УникальныйИдентификатор();
	//Если Не УзелУТ =Неопределено Тогда
	//	ЕстьВБазеПриемнике = Соединение.бит_сервер.ЕстьЗапись(УИД, ТипИсточника, ТипПриемника, УзелУТ);
	//	Если Не ЕстьВБазеПриемнике Тогда        

	//		Если Не СокрЛп(Guid)="" и Не Guid ="00000000-0000-0000-0000-000000000000" и не Guid = Неопределено  Тогда
	//			Соединение.бит_сервер.ДобавитьЗапись(ПолучитьСтруктуруЗаписиВБУ(Стр.Контрагент, ПартнерОбъект.Ссылка.УникальныйИдентификатор(), ТипИсточника, ТипПриемника , УзелУТ, Соединение));
	//		Иначе
	//			Guid="";
	//		КонецЕсли;	
	//	КонецЕсли;	
	//КонецЕсли;
	
	УстановитьДоговора(Соединение, Договора, Контрагент,  ПартнерОбъект.Ссылка, Узел);	

	Возврат ПартнерОбъект.Ссылка;

