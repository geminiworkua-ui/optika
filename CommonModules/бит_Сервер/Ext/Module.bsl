Функция ПреобразоватьНомерТелефона(НомерТелефона) Экспорт
	НомерТелефонаЧисла = СокрЛП(НомерТелефона);
	Для Сч = 1 По СтрДлина (СокрЛП(НомерТелефона)) Цикл 
		ЭлИскл = "";
		Эл = Прав(Лев(НомерТелефона,Сч),1); 
		Попытка
			вр = Число(Эл);
			Если вр = 0 И НЕ Эл ="0" Тогда
				ЭлИскл = Эл;	
			КонецЕсли;
		Исключение
			ЭлИскл = Эл;
		КонецПопытки;
		Если НЕ ЭлИскл = "" Тогда
			НомерТелефонаЧисла = СтрЗаменить(НомерТелефонаЧисла, Эл, "")	
		КонецЕсли;
	КонецЦикла;
	Возврат  НомерТелефонаЧисла;
КонецФункции

Функция ПолучитьПрефиксВидаКартыЛояльности(ВидКЛ) Экспорт
    Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ ПЕРВЫЕ 1
	              |	ВидыКартЛояльностиШаблоныКодовКартЛояльности.НачалоДиапазонаШтрихкода КАК НачалоДиапазонаШтрихкода,
	              |	ВидыКартЛояльностиШаблоныКодовКартЛояльности.Ссылка.Наименование КАК ВидКЛНаименование				  
	              |ИЗ
	              |	Справочник.ВидыКартЛояльности.ШаблоныКодовКартЛояльности КАК ВидыКартЛояльностиШаблоныКодовКартЛояльности
	              |ГДЕ
	              |	ВидыКартЛояльностиШаблоныКодовКартЛояльности.Ссылка = &ВидКЛ";
	
	Запрос.УстановитьПараметр("ВидКЛ", ВидКЛ);
	
	Выборка = Запрос.Выполнить();
	
	Если Выборка.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	ВыборкаВидКЛ = Выборка.Выбрать();
	ВыборкаВидКЛ.Следующий();
	ПрефиксШК = Лев(ВыборкаВидКЛ.НачалоДиапазонаШтрихкода,1); 
	Возврат   ПрефиксШК;	
