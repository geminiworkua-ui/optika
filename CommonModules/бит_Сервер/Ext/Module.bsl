Функция НоменклатураКонтрагента(Соединение, НоменклатураКом, Контрагент, Узел)
ТипПриемника ="Справочник.Номенклатура";
ТипИсточника ="Справочник.НоменклатураКонтрагентов";	

Guid = ПолучитьGuid(Соединение, НоменклатураКом);

ЕстьВРегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел); 
  
Если   ЕстьВРегистре Тогда
	НомСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);  
	Попытка
	НомОбъект = НомСсылка.ПолучитьОбъект();
	Исключение 
	НомОбъект =Неопределено;
	УдалитьЗапись(ПолучитьСтруктуруЗаписи(НомСсылка, Guid , ТипПриемника, ТипИсточника, Узел));

	КонецПопытки;	
	
	Если НомОбъект = Неопределено Тогда 
		НомСсылка = НайтиНоменклатуруПоставщика(НоменклатураКом, Контрагент);
		Если Не НомСсылка = Неопределено Тогда
			 ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НомСсылка, Guid , ТипПриемника, ТипИсточника, Узел));
			 Возврат НомСсылка;
		КонецЕсли;
		
		НомОбъект = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
		НомОбъект.Владелец = Контрагент;
		ЕстьВРегистре = Ложь; 
	Иначе 
		Возврат НомСсылка;	
		//ПартнерОбъект = ПартнерСсылка.ПолучитьОбъект(); 
	КонецЕсли;	

Иначе
	НомСсылка = НайтиНоменклатуруПоставщика(НоменклатураКом, Контрагент);
		Если Не НомСсылка = Неопределено Тогда
			 ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НомСсылка, Guid , ТипПриемника, ТипИсточника, Узел));
			 Возврат НомСсылка;
		КонецЕсли;
 
	 
	НомОбъект = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
КонецЕсли;                                                        
    НомОбъект.Владелец = Контрагент;
    НоменклатураСсылка = НайтиСсылкуНоменклатуры(НоменклатураКом);
	Если НоменклатураСсылка =Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	НомОбъект.Наименование = НоменклатураКом.Наименование;
	НомОбъект.Номенклатура = ?(ТипЗнч(НоменклатураСсылка) =Тип("СправочникСсылка.Номенклатура"), НоменклатураСсылка, НоменклатураСсылка.Владелец); 
    НомОбъект.Характеристика = ?(ТипЗнч(НоменклатураСсылка) =Тип("СправочникСсылка.Номенклатура"), справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(),НоменклатураСсылка);
	НомОбъект.Артикул = НомОбъект.Номенклатура.Артикул;
	НомОбъект.Записать();
	Возврат НомОбъект.Ссылка; 
КонецФункции  

Функция НайтиНоменклатуруПоставщика(НоменклатураКом, Контрагент)
