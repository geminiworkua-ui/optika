Функция ПолучитьДоговора(Соединение, Контрагент)
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
"ВЫБРАТЬ РАЗЛИЧНЫЕ
|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
|ИЗ
|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
|ГДЕ
|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
|	И ДоговорыКонтрагентов.Владелец = &Владелец";
Запрос.УстановитьПараметр("Владелец", Контрагент);
Результат =Запрос.Выполнить().Выгрузить();
Возврат Результат;
КонецФункции

Функция Контрагенты(Соединение, Стр, Узел)
ТипПриемника ="Справочник.Контрагенты";
ТипИсточника ="Справочник.Партнеры";	
//УзелУТ = Соединение.бит_сервер.УзелУТ();
Guid = ПолучитьGuid(Соединение, Стр.Контрагент);

ЕстьВРегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел); 
  
Если   ЕстьВРегистре Тогда
	ПартнерСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);  
	Попытка
	ПартнерОбъект = ПартнерСсылка.получитьОбъект();
	Исключение 
	ПартнерОбъект =Неопределено;
	УдалитьЗапись(ПолучитьСтруктуруЗаписи(ПартнерСсылка, Guid , ТипПриемника, ТипИсточника, Узел));

	КонецПопытки;	
	
	Если ПартнерОбъект = Неопределено Тогда
		ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
		ЕстьВРегистре = Ложь; 
	Иначе 
		Возврат ПартнерСсылка;	
		//ПартнерОбъект = ПартнерСсылка.ПолучитьОбъект(); 
	КонецЕсли;	

Иначе
	Контр = НайтиКонтрагентаПоЕДРПОУ(Стр.Контрагент.КодПоЕДРПОУ);
	Если Не Контр = Неопределено Тогда
		 ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Контр.Партнер, Guid , ТипПриемника, ТипИсточника, Узел));
		 Возврат Контр.Партнер;                              
	КонецЕсли;	 
	 
	ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
КонецЕсли;   
   	ПартнерОбъект.Наименование = Стр.Контрагент.Наименование; 
	ПартнерОбъект.НаименованиеПолное = Стр.Контрагент.НаименованиеПолное;
	Договора = ПолучитьДоговора(Соединение, Стр.Контрагент);
	Для каждого ВД из Договора Цикл	 
