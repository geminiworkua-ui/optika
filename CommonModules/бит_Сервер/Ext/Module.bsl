Процедура ЗаполнитьРегистрациюРеализацииНаДату(Дата, СПД )
Запрос =Новый Запрос(
"ВЫБРАТЬ
|	ЗаказыКлиентов.Номенклатура,
|	ЗаказыКлиентов.Характеристика,
|	ЗаказыКлиентов.Склад,
|	Получатели.СПД,
|	ЗаказыКлиентов.Регистратор,
|	ЗаказыКлиентов.КОформлению,
|	ЗаказыКлиентов.Сумма
|ПОМЕСТИТЬ Продажи
|ИЗ
|	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
|		Левое СОЕДИНЕНИЕ (ВЫБРАТЬ
|			ПривязкаСПДСрезПоследних.СПД КАК СПД,
|			ПривязкаСПДСрезПоследних.Магазин КАК Магазин,
|			ПривязкаСПДСрезПоследних.ГруппаНоменклатурыДляРРО КАК ГруппаНоменклатурыДляРРО
|		ИЗ
|			РегистрСведений.ПривязкаСПД.СрезПоследних(&Начало, ) КАК ПривязкаСПДСрезПоследних) КАК Получатели
|		ПО ЗаказыКлиентов.Склад = Получатели.Магазин
|			И ЗаказыКлиентов.Номенклатура.ВидНоменклатуры.ГруппаНоменклатурыДляРРО = Получатели.ГруппаНоменклатурыДляРРО
|ГДЕ
|	ЗаказыКлиентов.Период МЕЖДУ &Начало И &Конец
|	И ТИПЗНАЧЕНИЯ(ЗаказыКлиентов.Регистратор) = ТИП(Документ.РеализацияТоваровУслуг)
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	Продажи.Номенклатура,
|	Продажи.Характеристика,
|	Продажи.Склад,
|	Продажи.СПД,
|	Продажи.Регистратор как ДокументРеализации,
|	Продажи.КОформлению как Количество,
|	Продажи.Сумма как СуммаСНДС
|ИЗ
|	Продажи КАК Продажи
|ГДЕ
|	Продажи.СПД = &СПД");
Запрос.УстановитьПараметр("Начало", НачалоДня(Дата));
Запрос.УстановитьПараметр("Конец",  КонецДня(Дата));
Запрос.УстановитьПараметр("СПД",    СПД);
Результат = Запрос.Выполнить().Выбрать();
ДокОб = НайтиСоздатьРегистрациюРеализации(Дата, СПД);
