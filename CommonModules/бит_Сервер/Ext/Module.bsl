Функция ПолучитьМассивНоменклатурыКонтрагента(Соединение, КонтрагентКом, Контрагент, Узел)
МассивЦен = Новый Массив;

Результат = ПолучитьНоменклатуруКонтрагента(Соединение, КонтрагентКом);

Для каждого Строка из Результат Цикл 
	НовСтр = Новый Структура;
	НовСтр.Вставить("НоменклатураКонтрагента", НоменклатураКонтрагента(Соединение, Строка, Контрагент, Узел));  
	Если НовСтр.НоменклатураКонтрагента  =Неопределено Тогда
	   Продолжить;
	КонецЕсли;

	ЦенаВключаетНДС = Ложь;
	НовСтр.Вставить("Цена", ПолучитьЦену(Соединение, Строка, КонтрагентКом, ЦенаВключаетНДС));
	Если НовСтр.Цена  =Неопределено Тогда
	   Продолжить;
	КонецЕсли;

	НовСтр.Вставить("ЦенаВключаетНДС", ЦенаВключаетНДС);

   	МассивЦен.Добавить(НовСтр);   
КонецЦикла;	

Возврат МассивЦен;

КонецФункции	

