Процедура СопоставитьНоменклатуру(Соединение, Узел)
УзелУТ = Соединение.бит_сервер.УзелУТ();
Таблица = ПолучитьТаблицуНоменклатуры();

ТипПриемника ="Справочник.Номенклатура";

Текущий =0;
Всего = Таблица.Количество();


Для каждого Стр Из Таблица Цикл
	Текущий = Текущий +1;		
	ПроцентВыполнения = (Текущий/Всего)*100;
	ПроцентВыполнения = Окр(ПроцентВыполнения,0);
				
	ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП(Стр.Номенклатура.Наименование));
	

	Если ТипЗнч(Стр.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		ТипИсточника ="Справочник.Номенклатура";
	Иначе
		ТипИсточника ="Справочник.ХарактеристикиНоменклатуры";
	КонецЕсли;	

	ЕстьВРегистре = ЕстьЗапись(Стр.Номенклатура, ТипПриемника, ТипИсточника, Узел);
	
	Если Не ЕстьВРегистре Тогда
			
		ИдентификаторПриемника = ПолучитьЗначениеНоменклатуры(Соединение, Стр.Значение);
		
		Если Не ИдентификаторПриемника = Неопределено Тогда  
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Стр.Номенклатура, ИдентификаторПриемника, ТипПриемника, ТипИсточника, Узел));
		КонецЕсли;	
	КонецЕсли;	

	УИД  = Стр.Номенклатура.УникальныйИдентификатор();
	Если Не УзелУТ =Неопределено Тогда
		ЕстьВБазеПриемнике = Соединение.бит_сервер.ЕстьЗапись(УИД, ТипИсточника, ТипПриемника, УзелУТ);
		Если Не ЕстьВБазеПриемнике Тогда
			ЗначениеБУ = ЗначениеНоменклатурыВБУ(Соединение, Стр.Значение);
			Guid = ПолучитьGuid(Соединение, ЗначениеБУ);

			Если Не СокрЛп(Guid)="" и Не  Guid ="00000000-0000-0000-0000-000000000000" и не Guid = Неопределено Тогда
				Соединение.бит_сервер.ДобавитьЗапись(ПолучитьСтруктуруЗаписиВБУ(ЗначениеБУ, УИД, ТипИсточника, ТипПриемника , УзелУТ, Соединение));
			Иначе
				Guid="";
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;
		
КонецЦикла;

КонецПроцедуры	

Функция ЗначениеНоменклатурыВБУ(Соединение, Код)
Если Не ТипЗнч(Код) = Тип("Строка") Тогда
	КодЗапроса = Код.Наименование;
Иначе
	КодЗапроса = Код;
КонецЕсли;	

Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
"ВЫБРАТЬ  
|	Номенклатура.Ссылка КАК Ссылка
|ИЗ
|	Справочник.Номенклатура КАК Номенклатура
|ГДЕ
|	НЕ Номенклатура.ЭтоГруппа
|	И НЕ Номенклатура.ПометкаУдаления
|   И Номенклатура.Код = &Код";
Запрос.УстановитьПараметр("Код", КодЗапроса);
Результат = Запрос.Выполнить().Выгрузить();
Для каждого Стр из Результат Цикл
	Возврат Стр.ссылка;
КонецЦикла;		
КонецФункции

Функция ПолучитьЗначениеНоменклатуры(Соединение, Код)   
	Возврат ПолучитьGuid(Соединение, ЗначениеНоменклатурыВБУ(Соединение,  Код));
КонецФункции	

// Возвращает ГУИД в другой базе
//
// Параметры
//  <пСсылка>  - <ДокументСсылка> - ссылка на документ Ком соединения
//  <пВнешняяБаза>  - <COM-соединение> - внешнее соединение
//
// Возвращаемое значение:
//   <Строка>   - строковое представление ГУИД
//
Функция ПолучитьGuid(Соединение, пСсылка)
    Попытка
	    УИД = Соединение.String(пСсылка.UUID()); 
	    Возврат Соединение.String(УИД); 
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции 

Функция ПолучитьТаблицуНоменклатуры()
	Запрос = Новый Запрос(
	   "ВЫБРАТЬ
	   |	СвойстваОбъектов.Объект как Номенклатура,
	   |	СвойстваОбъектов.Значение
	   |ИЗ
	   |	РегистрСведений.СвойстваОбъектов КАК СвойстваОбъектов
	   |ГДЕ
	   |	(ТИПЗНАЧЕНИЯ(СвойстваОбъектов.Объект) = ТИП(Справочник.Номенклатура)
	   |	ИЛИ ТИПЗНАЧЕНИЯ(СвойстваОбъектов.Объект) = ТИП(Справочник.ХарактеристикиНоменклатуры))
	   |	И СвойстваОбъектов.Свойство В
	   |			(ВЫБРАТЬ
	   |				СвойстваОбъектов.Ссылка
	   |			ИЗ
	   |				Справочник.СвойстваОбъектов КАК СвойстваОбъектов
	   |			ГДЕ
	   |				СвойстваОбъектов.Код = ""10039"")");   
	Возврат Запрос.Выполнить().Выгрузить();	
КонецФункции	

