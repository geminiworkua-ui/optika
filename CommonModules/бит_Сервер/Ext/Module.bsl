				ДоговорОбъект.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
			ИначеЕсли Соединение.String(Договор.Ссылка.ВидДоговора) = Соединение.String(Соединение.Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком) Тогда
				ДоговорОбъект.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком;
			Иначе Продолжить;	
			КонецЕсли;
			
			ДоговорОбъект.Записать();
			
			Если Не  ЕстьВРегистре Тогда
				ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ДоговорОбъект.Ссылка, Guid , ТипПриемника, ТипИсточника, Узел));
			КонецЕсли;
			УИД  = ДоговорОбъект.Ссылка.УникальныйИдентификатор();
			//Если Не УзелУТ =Неопределено Тогда
			//	ЕстьВБазеПриемнике = Соединение.бит_сервер.ЕстьЗапись(УИД, ТипИсточника, ТипПриемника, УзелУТ);
			//	Если Не ЕстьВБазеПриемнике Тогда        

			//		Если Не СокрЛп(Guid)="" и Не Guid ="00000000-0000-0000-0000-000000000000" и не Guid = Неопределено  Тогда
			//			Соединение.бит_сервер.ДобавитьЗапись(ПолучитьСтруктуруЗаписиВБУ(Договор.ссылка, ДоговорОбъект.Ссылка.УникальныйИдентификатор(), ТипИсточника, ТипПриемника , УзелУТ, Соединение));
			//		Иначе
			//			Guid="";
			//		КонецЕсли;	
			//	
			//	КонецЕсли;	
			//	
			//КонецЕсли;
	
	КОнецЦикла;	
