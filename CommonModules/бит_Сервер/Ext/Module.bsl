			СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ВозвратОплатыКлиенту;			
			СтрокаРасшифровки.ОснованиеПлатежа = Чек.ДокументОснование;
			СтрокаРасшифровки.Заказ = Чек.ДокументОснование;
			СтрокаРасшифровки.Сумма = Стр.Сумма;
			СтрокаРасшифровки.СуммаВзаиморасчетов = Стр.Сумма;
			СтрокаРасшифровки.ВалютаВзаиморасчетов = ДанныеЗаполнения.Валюта;
			
			Попытка
				ДокПлатеж.Записать(РежимЗаписиДокумента.Проведение);
