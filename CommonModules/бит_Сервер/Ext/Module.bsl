//Функция проверки и при необходимости создания РКО воврата ДС по чеку ККМ
Функция НайтиСоздатьОрдерВозвратЧек(Чек ) Экспорт 
	
	МассивУзлов =  МассивУзловРегистрации();
	
	Если Не ЗначениеЗаполнено(Чек) Тогда
		Возврат Неопределено;                        
	КонецЕсли;
	
	Если Не Чек.статус = Перечисления.СтатусыЧековККМ.Пробит Тогда
		Если Не МассивУзлов = Неопределено Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,Чек);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Если ЕстьЗачетПоВозвратам(Чек) Тогда
		Если Не МассивУзлов = Неопределено Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,Чек);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
			
	Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ВЫБОР
		                      |		КОГДА ЧекККМ.ДокументОснование.Касса <> ЗНАЧЕНИЕ(Справочник.Кассы.ПустаяСсылка)
		                      |			ТОГДА ЧекККМ.ДокументОснование.Касса.Владелец
		                      |		КОГДА ЧекККМ.ДокументОснование.БанковскийСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)
		                      |			ТОГДА ЧекККМ.ДокументОснование.БанковскийСчет.Владелец
		                      |		ИНАЧЕ ЧекККМ.ДокументОснование.Организация
		                      |	КОНЕЦ КАК Организация,
		                      |	ЧекККМ.ДокументОснование.Партнер КАК Партнер,
		                      |	ЧекККМ.ДокументОснование.Контрагент КАК Контрагент,
		                      |	ЧекККМ.ДокументОснование.Контрагент.Наименование КАК КонтрагентНаименование,
		                      |	ЧекККМ.ДокументОснование.Контрагент.НаименованиеПолное КАК КонтрагентНаименованиеПолное,
		                      |	ЧекККМ.ДокументОснование.Договор КАК Договор,
		                      |	ЧекККМ.ДокументОснование КАК ДокументОснование,
		                      |	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента) КАК ХозяйственнаяОперация,
		                      |	ЧекККМ.ДокументОснование.Касса КАК Касса,
		                      |	ЧекККМ.Валюта КАК Валюта
		                      |ИЗ
		                      |	Документ.ЧекККМ КАК ЧекККМ
		                      |ГДЕ
		                      |	ЧекККМ.Ссылка = &Ссылка
		                      |	И ЧекККМ.ДокументОснование.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию)
		                      |	И ЧекККМ.ДокументОснование.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПриемНаКомиссиюИмпорт)
		                      |	И ЧекККМ.ДокументОснование.ПорядокРасчетов <> ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоНакладным)");
		
		Запрос.УстановитьПараметр("Ссылка", Чек);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда	
			ДокОрдер = НайтиСоздатьДокРКОЧек(Чек);  
			ДокОрдер.РасшифровкаПлатежа.Очистить();
			ДанныеЗаполнения = Новый Структура;
			Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
				ДанныеЗаполнения.Вставить(Колонка.Имя);
			КонецЦикла;
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(ДанныеЗаполнения, Выборка);
			
			Если Не ПустаяСтрока(Выборка.КонтрагентНаименованиеПолное) Тогда
				ДанныеЗаполнения.Вставить("Выдать", Выборка.КонтрагентНаименованиеПолное);
			Иначе
				ДанныеЗаполнения.Вставить("Выдать", Выборка.КонтрагентНаименование);
			КонецЕсли;  
			ДанныеЗаполнения.Контрагент = НайтиКонтрагента(Чек.Партнер);
			ДанныеЗаполнения.Организация = Чек.ДокументОснование.Организация;
			
			ДенежныеСредстваСервер.ЗаполнитьРеквизитыДокументаПоФормеОплаты(
				Перечисления.ФормыОплаты.Наличная,
				ДанныеЗаполнения) ; 
			ЗаполнитьЗначенияСвойств(ДокОрдер,ДанныеЗаполнения);	
			ДокОрдер.Дата = ТекущаяДата();
			ДокОрдер.чекККМ= Чек;
			ДокОрдер.основание = Строка(Чек);
		    ДокОрдер.Касса = ПолучитьКассу(Чек.ДокументОснование);
			ДокОрдер.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту;
			ДокОрдер.Дата = ТекущаяДата(); 
			ДокОрдер.СуммаДокумента = Чек.СуммаДокумента;  
			ДокОрдер.Кассир = Чек.Кассир;        
			Расшифоровка = ДокОрдер.РасшифровкаПлатежа;
			Расшифоровка.Очистить();
			СтрокаРасшифровки =Расшифоровка.Добавить(); 
			СтрокаРасшифровки.Партнер = Выборка.Партнер;
			СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ВозвратОплатыКлиенту;
			//СтрокаРасшифровки.ОснованиеПлатежа = Чек.ДокументОснование;
			СтрокаРасшифровки.Заказ = Чек.ДокументОснование;
			СтрокаРасшифровки.Сумма = Чек.СуммаДокумента;
			СтрокаРасшифровки.СуммаВзаиморасчетов = Чек.СуммаДокумента;
			СтрокаРасшифровки.ВалютаВзаиморасчетов = ДанныеЗаполнения.Валюта;
			СтрокаРасшифровки.Подразделение = Чек.склад.Подразделение;
			СтрокаРасшифровки.Организация = ДанныеЗаполнения.Организация;
			//СтрокаРасшифровки.АналитикаРасходов = ПланыВидовХарактеристик.СтатьиДоходов.ВыручкаОтПродаж;
			Попытка 
				ДокОрдер.Записать(РежимЗаписиДокумента.Проведение);	
			Исключение              
				ДокОрдер.Записать();
			КонецПопытки	
		КонецЕсли;
	

Если Не МассивУзлов =Неопределено Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзлов,Чек);
КонецЕсли;

Возврат ДокОрдер.Ссылка;

КонецФункции	

Функция МассивУзловРегистрации()
ЗапросУзлов = Новый Запрос(
"ВЫБРАТЬ
|			Настройки.Ссылка
|			ИЗ
|				ПланОбмена.Настройки КАК Настройки
|			ГДЕ
|				НЕ Настройки.ЭтотУзел");
РезультатУзлов = ЗапросУзлов.Выполнить().Выгрузить(); 
Возврат РезультатУзлов.ВыгрузитьКолонку("ссылка"); 

КОнецФункции	

//Получаем кассу из заказа
Функция ПолучитьКассу(Заказ)

УстановитьПривилегированныйРежим(Истина);
	
Запрос = Новый Запрос(
 "ВЫБРАТЬ
 |	Кассы.Ссылка
 |ИЗ
 |	Справочник.Кассы КАК Кассы
 |ГДЕ
 |	Кассы.Подразделение = &Подразделение
 |	И НЕ Кассы.ПометкаУдаления");
Запрос.УстановитьПараметр("Подразделение", Заказ.Подразделение);
Рез = Запрос.Выполнить().Выбрать();
Если Рез.Следующий() Тогда 
	Возврат Рез.ссылка;
Иначе 
	Возврат Справочники.Кассы.ПустаяСсылка();
КонецЕсли;	
КонецФункции

//Находим контрагента по партнеру
Функция НайтиКонтрагента(Партнер) Экспорт  
	
	Если Партнер = Справочники.Партнеры.РозничныйПокупатель Тогда
		Возврат Справочники.Контрагенты.РозничныйПокупатель;	
	КонецЕсли;		
		 
	Запрос =Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления
		|	И Контрагенты.Партнер = &Партнер";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Результат =Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	Иначе 
		НовЭл = Справочники.Контрагенты.СоздатьЭлемент();
		НовЭл.Наименование = Партнер.Наименование;
		НовЭл.НаименованиеПолное = Партнер.НаименованиеПолное;
				
		Попытка
			НовЭл.Записать();   
			//Новый клиент записан возращаем ссылку
			Возврат НовЭл.Ссылка;	
		Исключение   
			//Проблема записи нового клиента возращаем розничного покупателя
	    	Возврат Справочники.Контрагенты.РозничныйПокупатель;	
		КонецПопытки;
	КонецЕсли;
	
КонецФункции	

