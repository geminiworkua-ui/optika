		    ГУИД = ПолучитьУИД(Ссылка, ТипПриемника, ТипИсточника, УзелБУ);
			Возврат Соединение.Справочники.Контрагенты.ПолучитьСсылку(ГУИД);
		Иначе Возврат Соединение.бит_Сервер.НайтиСоздатьКонтрагента(Ссылка, ПолучитьКонтрагента(ссылка));
    КонецЕсли;
    
