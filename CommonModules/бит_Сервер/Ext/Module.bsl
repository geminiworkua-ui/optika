Если Не ВходящиеДанные.Свойство("Характеристика") Тогда
	Возврат Неопределено;
КонецЕсли;	

Если Не ВходящиеДанные.Свойство("Склад") Тогда
	Возврат Неопределено;
КонецЕсли;	


Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0) КАК Остаток
                      |ИЗ
                      |	РегистрНакопления.СвободныеОстатки.Остатки(
                      |			&Дата,
                      |			Номенклатура = &Номенклатура
                      |				И Характеристика = &Характеристика
                      |				И Склад = &Склад) КАК СвободныеОстаткиОстатки");      
	Запрос.УстановитьПараметр("Номенклатура", 	ВходящиеДанные.Номенклатура);    
	Запрос.УстановитьПараметр("Характеристика", ВходящиеДанные.Характеристика);
  	Запрос.УстановитьПараметр("Склад", 			ВходящиеДанные.Склад);
	Запрос.УстановитьПараметр("Дата", 			ТекущаяДата());
рез =Запрос.Выполнить().Выбрать();
Если Рез.Следующий() Тогда
	Возврат Рез.Остаток;
	Иначе Возврат 0;
КонецЕсли;	
КонецФункции

