|ПОМЕСТИТЬ Возвраты
|ИЗ
|	Документ.ВозвратТоваровОтКлиента.Товары КАК ВозвратТоваровОтКлиентаТовары
|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
|			ПривязкаСПДСрезПоследних.СПД КАК СПД,
|			ПривязкаСПДСрезПоследних.Магазин КАК Магазин,
|			ПривязкаСПДСрезПоследних.ГруппаНоменклатурыДляРРО КАК ГруппаНоменклатурыДляРРО
|		ИЗ
|			РегистрСведений.ПривязкаСПД.СрезПоследних(&ДатаРеализации, ) КАК ПривязкаСПДСрезПоследних) КАК Получатели
|		ПО ВозвратТоваровОтКлиентаТовары.Номенклатура.ВидНоменклатуры.ГруппаНоменклатурыДляРРО = Получатели.ГруппаНоменклатурыДляРРО
|			И ВозвратТоваровОтКлиентаТовары.Ссылка.Склад = Получатели.Магазин
|ГДЕ
|	ВозвратТоваровОтКлиентаТовары.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаВозврата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаВозврата, ДЕНЬ)
|	И ВозвратТоваровОтКлиентаТовары.Ссылка.ДокументРеализации МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаРеализации, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаРеализации, ДЕНЬ)
|	И ВозвратТоваровОтКлиентаТовары.Ссылка.Проведен
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	Возвраты.Номенклатура,
|	Возвраты.Характеристика,
|	Возвраты.СПД,
|	Возвраты.Сумма КАК СуммаСНДС
|ИЗ
|	Возвраты КАК Возвраты
|ГДЕ
|	Возвраты.СПД = &СПД");
Запрос.УстановитьПараметр("ДатаРеализации", ДатаР);
Запрос.УстановитьПараметр("ДатаВозврата",  Дата);
Запрос.УстановитьПараметр("СПД",    СПД);
ТоварыВозврата  = Запрос.Выполнить().Выгрузить();  
	Если ТЗВ.Количество() =0 Тогда
		ТЗВ = ТоварыВозврата;
	Иначе 	
		Для каждого Стр из ТоварыВозврата Цикл
			НоваяСтрока = ТЗВ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЦикла;
	КонецЕсли;	
КонецЦикла;

ДокОб = НайтиСоздатьРегистрациюРеализации(Дата, СПД);
ДокОб.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
ДокОб.Дата =Дата;
ДокОб.СПД =СПД;  
ДокОб.Товары.Очистить();
Для Каждого Стр из ТЗВ Цикл
	НовСтр = ДокОб.Товары.Добавить();
	НовСтр.Номенклатура = Стр.Номенклатура;
	НовСтр.Характеристика = Стр.Характеристика;
	НовСтр.ЕдиницаИзмерения = Стр.Номенклатура.ЕдиницаИзмерения;
	НовСтр.Количество = Стр.Количество;
	НовСтр.СуммаРеализацииБезНДС = Стр.СуммаСНДС/6*5;
	НовСтр.ЦенаРеализацииБезНДС = НовСтр.СуммаРеализацииБезНДС/НовСтр.Количество;
	НовСтр.ДокументРеализации = Стр.ДокументРеализации;
КонецЦикла;

ДокОб.Записать();
КонецПроцедуры

Функция НайтиСоздатьРегистрациюРеализации(Дата, СПД)
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	РегистрацияРеализации.Ссылка
|ИЗ
|	Документ.РегистрацияРеализации КАК РегистрацияРеализации
|ГДЕ
|	РегистрацияРеализации.Дата Между НачалоПериода(&Дата, День) И КонецПериода(&Дата, День)
|	И РегистрацияРеализации.Проведен
|	И РегистрацияРеализации.СПД = &СПД");

Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
Запрос.УстановитьПараметр("СПД", СПД);
Результат = Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	ДокОб = Результат.ссылка.ПолучитьОбъект();
	Если ДокОб =Неопределено Тогда
		ДокОб = документы.РегистрацияРеализации.СоздатьДокумент();
		Возврат ДокОб;
	Иначе
		Возврат ДокОб;
	КонецЕсли;
КонецЕсли;
ДокОб = документы.РегистрацияРеализации.СоздатьДокумент();
Возврат ДокОб;
КонецФункции	

