//
Процедура СправочникиПриЗаписи(Источник, Отказ, СтандартнаяОбработка) Экспорт

	

КонецПроцедуры

// СОДЕРЖИМОЕ ДАННОГО МЕТОДА РЕКОМЕНДУЕТСЯ РАЗМЕСТИТЬ                                           
// В ОБЩЕМ МОДУЛЕ "eCommСерверДоработки"                                      
// ДЛЯ УПРОЩЕНИЯ ОБНОВЛЕНИЯ/СОПРОВОЖДЕНИЯ МОДУЛЯ В БУДУЩЕМ                                      
//                                                                                              
// Напр.:                                                                                       
// eCommСерверДоработки.ДокументыПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения, СтандартнаяОбработка);
//
Процедура ДокументыПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения, СтандартнаяОбработка) Экспорт

	ИмяДокументаЗаказ = eCommСервер.ВернутьИмяДокументЗаказ();
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект." + ИмяДокументаЗаказ) Тогда 
		
		Если ЗначениеЗаполнено(Источник.Ссылка)                                             // Если документ еще не записан - значит он только загужается.
			И ЗначениеЗаполнено(Источник.eComm_ИсточникЗаказа)                              // Документ должен быть eComm+
			И Источник.eComm_ИсточникЗаказа.ВыгружатьЗаказы = Истина Тогда                  // Должен быть включен функционал выгрузки заказов
			
			ИмяТЧ_Товары 				= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары");
			ИмяТовары_Характеристика 	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары_Характеристика");
			
			ТекстЗапроса = "ВЫБРАТЬ
				|	ЗаказТовары.Номенклатура КАК Номенклатура,
				|	ЗаказТовары.#ИмяТовары_Характеристика# КАК #ИмяТовары_Характеристика#,
				|	ЗаказТовары.Количество КАК Количество,
				|	ЗаказТовары.Цена КАК Цена
				|ИЗ
				|	Документ.#ИмяДокументаЗаказ#.#ИмяТЧ_Товары# КАК ЗаказТовары
				|ГДЕ
				|	ЗаказТовары.Ссылка = &Ссылка";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяДокументаЗаказ#"		, ИмяДокументаЗаказ);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяТЧ_Товары#"			, ИмяТЧ_Товары);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяТовары_Характеристика#", ИмяТовары_Характеристика);
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
			
			ТоварыДоИзменения 		= Запрос.Выполнить().Выгрузить();
	        ТоварыПослеИзменения 	= Источник[ИмяТЧ_Товары].Выгрузить(,"Номенклатура, " + ИмяТовары_Характеристика + ", Количество, Цена");
			
			Если eCommСервер.ЕстьРазличияВТаблицах(ТоварыДоИзменения, ТоварыПослеИзменения) Тогда 
	
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	eComm_УчетныеЗаписи.Ссылка КАК Ссылка
					|ПОМЕСТИТЬ ВрТабУчетныеЗаписи
					|ИЗ
					|	Справочник.eComm_УчетныеЗаписи КАК eComm_УчетныеЗаписи
					|ГДЕ
					|	eComm_УчетныеЗаписи.Ссылка = &УчетнаяЗапись
					|	И eComm_УчетныеЗаписи.ВыгружатьЗаказы = ИСТИНА
					|	И eComm_УчетныеЗаписи.ПометкаУдаления = ЛОЖЬ
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	eComm_Обмен.Ссылка КАК УзелОбмена
					|ИЗ
					|	ПланОбмена.eComm_Обмен КАК eComm_Обмен
					|ГДЕ
					|	eComm_Обмен.УчетнаяЗапись В
					|			(ВЫБРАТЬ
					|				ВрТабУчетныеЗаписи.Ссылка КАК Ссылка
					|			ИЗ
					|				ВрТабУчетныеЗаписи КАК ВрТабУчетныеЗаписи)";
				
				Запрос.УстановитьПараметр("УчетнаяЗапись", Источник.eComm_ИсточникЗаказа);
				
				РезультатЗапроса = Запрос.Выполнить().Выбрать();
				
				Если РезультатЗапроса.Следующий() Тогда 
					
					ПланыОбмена.ЗарегистрироватьИзменения(РезультатЗапроса.УзелОбмена, Источник.Ссылка);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

