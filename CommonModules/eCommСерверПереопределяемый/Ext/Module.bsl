		ОбновляемыеПоляАктуальные.Добавить("wholesale_prices"		, "Оптовые цены от количества"	, Ложь);
		ОбновляемыеПоляАктуальные.Добавить("installments_payment"	, "Оплата частями (Монобанк / ПриватБанк)", Ложь);
		ОбновляемыеПоляАктуальные.Добавить("price_levels"			, "Уровни цен (B2B)"			, Ложь);
		
		Для Каждого ОбновляемоеПоле Из НастройкиОбмена.ВыгрузкаТоваров.ОбновляемыеПоляНаСайте Цикл 
			Если ОбновляемоеПоле.Пометка = Истина Тогда 
				ОбновляемоеПолеАктуальное = ОбновляемыеПоляАктуальные.НайтиПоЗначению(ОбновляемоеПоле.Значение);
				Если НЕ ОбновляемоеПолеАктуальное = Неопределено Тогда 
					ОбновляемоеПолеАктуальное.Пометка = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		НастройкиОбмена.ВыгрузкаТоваров.Вставить("ОбновляемыеПоляНаСайте", ОбновляемыеПоляАктуальные);
		УчетнаяЗаписьОбъект.НастройкиОбмена = Новый ХранилищеЗначения(НастройкиОбмена);
		УчетнаяЗаписьОбъект.Записать();
		
		СтруктураНастроек.Версия = "2.6.0.7";
		
	Исключение
		
		ЕстьОшибка = Истина;
		ЗаписьЖурналаРегистрации("eComm", , , УчетнаяЗапись, "" + ОписаниеОшибки());
		
	КонецПопытки;
	
	Если ЕстьОшибка Тогда 
		ОтменитьТранзакцию();
		Результат = Ложь;
	Иначе
		ЗафиксироватьТранзакцию();
		Результат = Истина; 
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ОбновитьНастройкиУчетнойЗаписиДоВерсии_2_6_0_8(СтруктураНастроек)

	ЕстьОшибка = Ложь;
	
	НачатьТранзакцию();
	
	Попытка
		
		Если ЗначениеЗаполнено(СтруктураНастроек.ПрофильНастроек) Тогда 
			УчетнаяЗапись = СтруктураНастроек.ПрофильНастроек;	
		Иначе
			УчетнаяЗапись = СтруктураНастроек.УчетнаяЗапись;
		КонецЕсли;
		
		УчетнаяЗаписьОбъект = УчетнаяЗапись.ПолучитьОбъект();
		УчетнаяЗаписьОбъект.Версия = "2.6.0.8";
		
		НастройкиОбмена = УчетнаяЗаписьОбъект.НастройкиОбмена.Получить();
		
		Если НЕ НастройкиОбмена.ВыгрузкаТоваров.Свойство("ПоляДляПеревода") Тогда 
			
			ПоляДляПеревода = Новый СписокЗначений;
			ПоляДляПеревода.Добавить("Наименование"		, НСтр("ru = 'Название'; uk = 'Назва'")						, Истина);
			ПоляДляПеревода.Добавить("Описание"			, НСтр("ru = 'Описание'; uk = 'Опис'")						, Истина);
			
			Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда 
				
				ПоляДляПеревода.Добавить("seo_Наименование"	, НСтр("ru = 'HTML title'; uk = 'HTML title'")				, Истина);
				ПоляДляПеревода.Добавить("КлючевыеСлова"	, НСтр("ru = 'META keywords'; uk = 'META keywords'")		, Истина);
				ПоляДляПеревода.Добавить("seo_Описание"		, НСтр("ru = 'META description'; uk = 'META description'")	, Истина);
				ПоляДляПеревода.Добавить("seo_h1_Заголовок"	, НСтр("ru = 'h1 заголовок'; uk = 'h1 заголовок'")			, Истина); 
				
			ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда 
				
				ПоляДляПеревода.Добавить("КлючевыеСлова"	, НСтр("ru = 'Ключевые слова'; uk = 'Ключові слова'")		, Истина);
				
			КонецЕсли;
			
			НастройкиОбмена.ВыгрузкаТоваров.Вставить("ПоляДляПеревода", ПоляДляПеревода);
			УчетнаяЗаписьОбъект.НастройкиОбмена = Новый ХранилищеЗначения(НастройкиОбмена);
			
		КонецЕсли;
		
		Если УчетнаяЗаписьОбъект.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom 
			И НастройкиОбмена.ВыгрузкаТоваров.Свойство("НеИспользоватьРазновидностиProm") Тогда
			НастройкиОбмена.ВыгрузкаТоваров.Вставить("НеИспользоватьРазновидности", НастройкиОбмена.ВыгрузкаТоваров.НеИспользоватьРазновидностиProm);
			НастройкиОбмена.ВыгрузкаТоваров.Удалить("НеИспользоватьРазновидностиProm");
		КонецЕсли;

		УчетнаяЗаписьОбъект.Записать();
		
		СтруктураНастроек.Версия = "2.6.0.8";
		
	Исключение
		
		ЕстьОшибка = Истина;
		ЗаписьЖурналаРегистрации("eComm", , , УчетнаяЗапись, "" + ОписаниеОшибки());
		
	КонецПопытки;
	
	Если ЕстьОшибка Тогда 
		ОтменитьТранзакцию();
		Результат = Ложь;
	Иначе
		ЗафиксироватьТранзакцию();
		Результат = Истина; 
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

