			УчетнаяЗаписьОбъект = УчетнаяЗапись.ПолучитьОбъект();
			// С добавлением на сайте Хорошоп функционала "оптовых цен от количества"
			// уровни цен перенесем в отдельный объект, а для "цен от количества"
			// используем более подходящий функционал оптовых цен
			Для Каждого Стр Из УчетнаяЗаписьОбъект.ОптовыеЦены Цикл
				
				СтруктураСтроки = Новый Структура("ВидЦены", "УдалитьКодЦеныНаСайте");
				ЗаполнитьЗначенияСвойств(СтруктураСтроки, Стр); 
				
				НовСтр = УчетнаяЗаписьОбъект.УровниЦенB2B.Добавить();
				НовСтр.ВидЦены = СтруктураСтроки.ВидЦены;
				Если СтруктураСтроки.Свойство("УдалитьКодЦеныНаСайте") 
					И ЗначениеЗаполнено(СтруктураСтроки.УдалитьКодЦеныНаСайте) Тогда 
					НовСтр.КодЦеныНаСайте = СтруктураСтроки.УдалитьКодЦеныНаСайте;
				КонецЕсли;
				
			КонецЦикла;
			
			УчетнаяЗаписьОбъект.ОптовыеЦены.Очистить();
			
		КонецЕсли;
		
		УчетнаяЗаписьОбъект.Версия = "2.5.0.5";
		
		НастройкиОбмена = УчетнаяЗаписьОбъект.НастройкиОбмена.Получить();
		
		ОбновляемыеПоляАктуальные = Новый СписокЗначений;
