Процедура ЗаполнитьСоглашениеСКлиентом(СтруктураНастроек, ЗаказОбъект, ВидЦены) Экспорт

	Если НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда
		// Используется только для УТ-подобных конфигураций
		// при работе с уровнями цен Хорошоп
		Возврат;
	КонецЕсли;
	
	ЗаказКлиента_ДатаПоДаннымКлиента	= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "ДатаПоДаннымКлиента");
	ЗаказКлиента_ВидЦен					= eCommСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "ВидЦен");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоглашенияСКлиентами.Ссылка КАК Соглашение,
		|	СоглашенияСКлиентами.ВидЦен КАК ВидЦен
		|ИЗ
		|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
		|ГДЕ
		|	СоглашенияСКлиентами.Партнер = &Партнер
		|	И СоглашенияСКлиентами.ВидЦен = &ВидЦен
		|	И СоглашенияСКлиентами.ПометкаУдаления = ЛОЖЬ
		|	И СоглашенияСКлиентами.Согласован = ИСТИНА
		|	И СоглашенияСКлиентами.ДатаНачалаДействия <= &ДатаЗаказа
		|	И (СоглашенияСКлиентами.ДатаОкончанияДействия >= &ДатаЗаказа
		|			ИЛИ СоглашенияСКлиентами.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("Партнер"		, ЗаказОбъект.Партнер);
	Запрос.УстановитьПараметр("ВидЦен"		, ВидЦены);
	Запрос.УстановитьПараметр("ДатаЗаказа"	, ЗаказОбъект[ЗаказКлиента_ДатаПоДаннымКлиента]);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Количество() = 1 Тогда
		// Соглашение однозначно идентифицировали
		РезультатЗапроса.Следующий();
		ЗаказОбъект.Соглашение = РезультатЗапроса.Соглашение;
	Иначе
		// Соглашение не найдено или найдено более одного варианта
	КонецЕсли;

КонецПроцедуры

