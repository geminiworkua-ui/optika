#Область ОБНОВЛЕНИЕ_УЧЕТНЫХ_ЗАПИСЕЙ_ПРИ_ОБНОВЛЕНИИ_МОДУЛЯ

Функция ОбновитьУчетнуюЗаписьДоВерсииМодуля(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда 
		
		Результат = Истина;
		
		Если eCommСервер.СравнитьВерсии("2.5.0.5", СтруктураНастроек.Версия) > 0 Тогда 
			// Необходимо обновить настройки
			Результат = ОбновитьНастройкиУчетнойЗаписиДоВерсииХорошоп_2_5_0_5(СтруктураНастроек);
		КонецЕсли;
		
		Если Результат И eCommСервер.СравнитьВерсии("2.5.0.7", СтруктураНастроек.Версия) > 0 Тогда
			Результат = ОбновитьНастройкиУчетнойЗаписиДоВерсииХорошоп_2_5_0_7(СтруктураНастроек);
		КонецЕсли;
		
		Если Результат И eCommСервер.СравнитьВерсии("2.6.0.4", СтруктураНастроек.Версия) > 0 Тогда
			Результат = ОбновитьНастройкиУчетнойЗаписиДоВерсииХорошоп_2_6_0_4(СтруктураНастроек);
		КонецЕсли;
		
		Если Результат И eCommСервер.СравнитьВерсии("2.6.0.7", СтруктураНастроек.Версия) > 0 Тогда
			Результат = ОбновитьНастройкиУчетнойЗаписиДоВерсииХорошоп_2_6_0_7(СтруктураНастроек);
		КонецЕсли;
		
		Если Результат И eCommСервер.СравнитьВерсии("2.6.0.8", СтруктураНастроек.Версия) > 0 Тогда
			Результат = ОбновитьНастройкиУчетнойЗаписиДоВерсии_2_6_0_8(СтруктураНастроек);
		КонецЕсли;
		
	ИначеЕсли СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom
		ИЛИ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka Тогда 
		
		Если eCommСервер.СравнитьВерсии("2.6.0.6", СтруктураНастроек.Версия) > 0 Тогда 
			// Необходимо обновить настройки
			
			ИмяДокументаОплатаПлатежнойКартой = eCommСервер.ВернутьИмяПрикладногоОбъекта("ОперацияПоПлатежнымКартам");
			
			Если НЕ СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" 
				И НЕ Метаданные.Документы[ИмяДокументаОплатаПлатежнойКартой].ТабличныеЧасти.Найти("ДополнительныеРеквизиты") = Неопределено Тогда  
				Результат = eCommСервер.ДополнительныеСведенияНайтиСоздать(СтруктураНастроек);
			Иначе
				УчетнаяЗапись = СтруктураНастроек.УчетнаяЗапись;
				
				УчетнаяЗаписьОбъект = УчетнаяЗапись.ПолучитьОбъект();
				УчетнаяЗаписьОбъект.Версия = eCommСервер.ВерсияБиблиотеки();
				УчетнаяЗаписьОбъект.Записать();
				
				СтруктураНастроек.Версия = УчетнаяЗаписьОбъект.Версия;
				
				Результат = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Результат И eCommСервер.СравнитьВерсии("2.6.0.8", СтруктураНастроек.Версия) > 0 Тогда
