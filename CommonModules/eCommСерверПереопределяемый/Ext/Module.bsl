//                                                                                              
// Напр.:                                                                                       
// eCommСерверДоработки.ПослеЗаписиЗаказаКлиента(СтруктураНастроек, ЗаказОбъект, СтандартнаяОбработка);
//
Процедура ПослеЗаписиЗаказаКлиента(СтруктураНастроек, ЗаказОбъект, СтандартнаяОбработка) Экспорт

	Перем ПараметрыЗаказа;
	
	Если НЕ СтруктураНастроек.Свойство("Используется_eCommДоставка")
		ИЛИ НЕ СтруктураНастроек.Используется_eCommДоставка = Истина Тогда 
		Возврат;
	КонецЕсли;
	
	ЗаказОбъект.ДополнительныеСвойства.Свойство("eComm", ПараметрыЗаказа);
	
	Если НЕ ТипЗнч(ПараметрыЗаказа) = Тип("Структура") 
		ИЛИ НЕ ПараметрыЗаказа.Свойство("Доставка") Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаказа.Доставка.Свойство("СоздаватьЭкспрессНакладные")
		И ПараметрыЗаказа.Доставка.СоздаватьЭкспрессНакладные = Ложь Тогда 
		// При перезаписи заказа экспресс-накладные не перезаписываем
		Возврат;
	КонецЕсли;
	
	СлужбаДоставки = Неопределено;
	
	Если Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Новой почтой")) > 0         			// Horoshop
		ИЛИ Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Нова Пошта")) > 0         			// Rozetka
		ИЛИ Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Новая Почта")) >0                 	// Prom
		ИЛИ Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Новою поштою")) > 0 Тогда 
		
		СлужбаДоставки = Перечисления["eComm_СлужбыДоставки"].НоваяПочта;
		
	ИначеЕсли Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Укрпочта")) > 0 
		ИЛИ Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Укрпошта")) > 0
		ИЛИ Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Укрпочтой")) > 0
		ИЛИ Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Укрпоштою")) > 0 Тогда 
		
		СлужбаДоставки = Перечисления["eComm_СлужбыДоставки"].УкрПочта;
		
		Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда
			// Пока хорошоп не передает информацию по типу доставки
			// для укрпочты, будем считать что доставка производится 
			// в отделение
			ПараметрыЗаказа.Доставка.ЭтоАдреснаяДоставка = Ложь;
		КонецЕсли;
		
	ИначеЕсли Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Justin")) > 0
		ИЛИ Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Джастин")) > 0 Тогда 
		
		СлужбаДоставки = Перечисления["eComm_СлужбыДоставки"].Justin;
		
	ИначеЕсли Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Meest")) > 0
		ИЛИ Найти(ВРег(ПараметрыЗаказа.Доставка.СервисДоставки), ВРег("Мист")) > 0 Тогда 
		
		СлужбаДоставки = Перечисления["eComm_СлужбыДоставки"].Meest;
		
	КонецЕсли;
	
	Если СлужбаДоставки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Модуль_eCommДоставкаСервер = eCommСервер.ОбщийМодуль("eCommДоставкаСервер");
	
	//УчетнаяЗапись = Модуль_eCommДоставкаСервер.ВернутьУчетнуюЗаписьПоУмолчанию(СлужбаДоставки);
	УчетнаяЗапись = Модуль_eCommДоставкаСервер.ВернутьУчетнуюЗаписьПоУмолчанию(СлужбаДоставки, ЗаказОбъект.Организация);
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеОтправителя = Модуль_eCommДоставкаСервер.ДанныеОтправителя(УчетнаяЗапись, СлужбаДоставки, ЗаказОбъект.Организация); 
	НастройкиДоставки = Справочники["eComm_УчетныеЗаписиСлужбДоставки"].Настройки(УчетнаяЗапись, ДанныеОтправителя);
	
	ПараметрыЗаказа.Вставить("Ссылка"			, ЗаказОбъект.Ссылка);
	ПараметрыЗаказа.Вставить("СуммаДокумента"	, ЗаказОбъект.СуммаДокумента);
	ПараметрыЗаказа.Вставить("УчетнаяЗапись"	, УчетнаяЗапись);
	ПараметрыЗаказа.Вставить("ТорговаяПлощадка" , СтруктураНастроек.ТорговаяПлощадка);
	
	СтруктураФИО = Модуль_eCommДоставкаСервер.ФамилияИмяОтчество(ПараметрыЗаказа.Контакты.ФИОКлиента);
	ПараметрыЗаказа.Контакты.Вставить("Фамилия"	, СтруктураФИО.Фамилия);
	ПараметрыЗаказа.Контакты.Вставить("Имя"		, ?(ЗначениеЗаполнено(СтруктураФИО.Имя), СтруктураФИО.Имя, "БезИмени"));
	ПараметрыЗаказа.Контакты.Вставить("Отчество"	, СтруктураФИО.Отчество);
	
	ЭкспрессНакладнаяОбъект = Документы["eComm_ЭкспрессНакладная"].СоздатьДокумент();
	ЭкспрессНакладнаяОбъект.Дата = ТекущаяДата();
	Документы["eComm_ЭкспрессНакладная"].ЗаполнитьПоОснованию(НастройкиДоставки, ЭкспрессНакладнаяОбъект, ПараметрыЗаказа);
	ЭкспрессНакладнаяОбъект.Записать();

КонецПроцедуры

