		ОбновляемыеПоляАктуальные.Добавить("price_old"				, "Цена старая"			, Ложь);
		ОбновляемыеПоляАктуальные.Добавить("brand"					, "Бренд"				, Ложь);
		ОбновляемыеПоляАктуальные.Добавить("images"					, "Изображения"			, Ложь);
		ОбновляемыеПоляАктуальные.Добавить("parent"					, "Группа"				, Ложь);
		ОбновляемыеПоляАктуальные.Добавить("seo_keywords"			, "Ключевые слова"		, Ложь);
		ОбновляемыеПоляАктуальные.Добавить("characteristics"		, "Характеристики"		, Ложь);
		Если НЕ eCommСервер.ВернутьИмяПрикладногоОбъекта("СопутствующиеТовары") = "" Тогда 
			ОбновляемыеПоляАктуальные.Добавить("accessories"		, "Сопутствующие товары", Ложь);
		КонецЕсли;
		ОбновляемыеПоляАктуальные.Добавить("icons"					, "Иконки (Ярлыки)"				, Ложь);
		ОбновляемыеПоляАктуальные.Добавить("export_to_marketplace"	, "Выгружать на маркетплейсы"	, Ложь);
		ОбновляемыеПоляАктуальные.Добавить("wholesale_prices"		, "Оптовые цены от количества"	, Ложь);
		ОбновляемыеПоляАктуальные.Добавить("price_levels"			, "Уровни цен (B2B)"			, Ложь);
		
		Для Каждого ОбновляемоеПоле Из НастройкиОбмена.ВыгрузкаТоваров.ОбновляемыеПоляНаСайте Цикл 
			Если ОбновляемоеПоле.Пометка = Истина Тогда 
				ОбновляемоеПолеАктуальное = ОбновляемыеПоляАктуальные.НайтиПоЗначению(ОбновляемоеПоле.Значение);
				Если НЕ ОбновляемоеПолеАктуальное = Неопределено Тогда 
					ОбновляемоеПолеАктуальное.Пометка = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		НастройкиОбмена.ВыгрузкаТоваров.Вставить("ОбновляемыеПоляНаСайте", ОбновляемыеПоляАктуальные);
		УчетнаяЗаписьОбъект.НастройкиОбмена = Новый ХранилищеЗначения(НастройкиОбмена);
		УчетнаяЗаписьОбъект.Записать();
		
		СтруктураНастроек.Версия = "2.5.0.5";
		
	Исключение
		
		ЕстьОшибка = Истина;
		ЗаписьЖурналаРегистрации("eComm", , , УчетнаяЗапись, "" + ОписаниеОшибки());
		
	КонецПопытки;
	
	Если ЕстьОшибка Тогда 
		ОтменитьТранзакцию();
		Результат = Ложь;
	Иначе
		ЗафиксироватьТранзакцию();
		Результат = Истина; 
	КонецЕсли;
	
	Возврат Результат;

