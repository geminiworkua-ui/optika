 Функция ПроверимНаличиеТоваровПодОбеспечениеНаСервере(М, Склад) экспорт

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Характеристика",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("СкладИсточник", Новый ОписаниеТипов("СправочникСсылка.ВариантыИсточниковОбеспечения"));
	//ТЗ.Колонки.Добавить("ТипНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"); 
	
	Для Инд = 0 по М.Количество()-1 цикл
		П = М[Инд];
		Номенклатура 			= неопределено;	
		//Характеристика			= неопределено;	
		//Количество     			= неопределено;
		//СкладИсточник           = неопределено;
		П.Свойство("Номенклатура", Номенклатура);
		
		Если Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар
			Тогда
			НовСтр = ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, П);
			//
			//
			//П.Свойство("Номенклатура", НовСтр.Номенклатура);
			//П.Свойство("Характеристика", НовСтр.Характеристика);
			//П.Свойство("Количество", НовСтр.Количество);
			//П.Свойство("СкладИсточник", НовСтр.СкладИсточник);  
		КонецЕсли;
		
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Номенклатура,
	|	ТЗ.Характеристика,
	|	ТЗ.Количество,
	|	ТЗ.СкладИсточник
	|ПОМЕСТИТЬ вт_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	СУММА(вт_ТЗ.Количество) КАК Количество,
	|	ВложенныйЗапрос.СкладОбеспечения,
	|	вт_ТЗ.СкладИсточник
	|ПОМЕСТИТЬ вт_ТолькоИзОстатков
	|ИЗ
	|	вт_ТЗ КАК вт_ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВариантыИсточниковОбеспечения.Ссылка КАК Ссылка,
	|			ВЫБОР
	|				КОГДА ВариантыИсточниковОбеспечения.СкладИсточник = ЗНАЧЕНИЕ(Справочник.ВариантыИсточниковОбеспечения.ИзНаличия)
	|					ТОГДА &Склад
	|				ИНАЧЕ ВариантыИсточниковОбеспечения.СкладИсточник
	|			КОНЕЦ КАК СкладОбеспечения
	|		ИЗ
	|			Справочник.ВариантыИсточниковОбеспечения КАК ВариантыИсточниковОбеспечения) КАК ВложенныйЗапрос
	|		ПО вт_ТЗ.СкладИсточник = ВложенныйЗапрос.Ссылка
	|ГДЕ
	|	НЕ вт_ТЗ.СкладИсточник = ЗНАЧЕНИЕ(Справочник.ВариантыИсточниковОбеспечения.ПодЗаказ)
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	ВложенныйЗапрос.СкладОбеспечения,
	|	вт_ТЗ.СкладИсточник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТолькоИзОстатков.Номенклатура,
	|	вт_ТолькоИзОстатков.Характеристика,
	|	вт_ТолькоИзОстатков.СкладОбеспечения,
	|	вт_ТолькоИзОстатков.СкладИсточник,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(вт_ТолькоИзОстатков.Количество, 0) <= ЕСТЬNULL(РасчетСвобОстатка.СвобОстаток, 0)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНарушение
	|ПОМЕСТИТЬ вт_СлучаиОшибки
	|ИЗ
	|	вт_ТолькоИзОстатков КАК вт_ТолькоИзОстатков
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
	|			СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
	|			СвободныеОстаткиОстатки.Склад КАК Склад,
	|			СУММА(ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0)) КАК СвобОстаток
	|		ИЗ
	|			РегистрНакопления.СвободныеОстатки.Остатки КАК СвободныеОстаткиОстатки
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СвободныеОстаткиОстатки.Номенклатура,
	|			СвободныеОстаткиОстатки.Характеристика,
	|			СвободныеОстаткиОстатки.Склад) КАК РасчетСвобОстатка
	|		ПО вт_ТолькоИзОстатков.Номенклатура = РасчетСвобОстатка.Номенклатура
	|			И вт_ТолькоИзОстатков.Характеристика = РасчетСвобОстатка.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_СлучаиОшибки.Номенклатура,
	|	вт_СлучаиОшибки.Характеристика,
	|	вт_СлучаиОшибки.СкладИсточник,
	|	вт_СлучаиОшибки.ЕстьНарушение
	|ИЗ
	|	вт_СлучаиОшибки КАК вт_СлучаиОшибки
	|ГДЕ
	|	вт_СлучаиОшибки.ЕстьНарушение";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
//	Выборка = Запрос.Выполнить().Выбрать();
	
	МР = Новый Массив;
	Для каждого Выборка из ТЗ цикл
		П = Новый Структура;
		П.Вставить("Номенклатура", Выборка.Номенклатура);
		П.Вставить("Характеристика", Выборка.Характеристика);
		П.Вставить("СкладИсточник", Выборка.СкладИсточник);
		П.Вставить("ЕстьНарушение",Выборка.ЕстьНарушение);
		МР.Добавить(П);
	КонецЦикла;	
	
	Возврат МР;	

КонецФункции	

&НаСервере
Функция ОстаткиНаСкладеМагазинаНаСервере(М, Склад) экспорт
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Характеристика",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));   
	ТЗ.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));   	
	ТЗ.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));   	
	ТЗ.Колонки.Добавить("Подбирать", новый описаниеТипов("Булево"));	
	ТЗ.Колонки.Добавить("СкладИсточник", Новый ОписаниеТипов("СправочникСсылка.ВариантыИсточниковОбеспечения"));
	
	Для Инд = 0 по М.Количество()-1 цикл
		
		НовСтр = ТЗ.Добавить();
		П = М[Инд];
		Номенклатура 			= неопределено;	
		Характеристика			= неопределено;	
		Количество     			= неопределено;
		П.Свойство("Номенклатура", НовСтр.Номенклатура);
		П.Свойство("Характеристика", НовСтр.Характеристика);
		П.Свойство("Количество", НовСтр.Количество); 
		П.Свойство("КоличествоУпаковок", НовСтр.КоличествоУпаковок); 
		Если ЗначениеЗаполнено(НовСтр.Упаковка)
			ТОгда
			П.Свойство("Упаковка", НовСтр.Упаковка); 
		Иначе
			НовСтр.Упаковка = НовСтр.НОменклатура.ЕдиницаИзмерения;
		КонецЕсли;
		П.Свойство("Упаковка", НовСтр.Упаковка); 
	    НовСтр.Подбирать = НовСтр.Номенклатура.ВидНоменклатуры.ПроизводитьПоискПоСкладам;
	
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Номенклатура,
	|	ТЗ.Характеристика,
	|	ТЗ.Количество,
	|	ТЗ.СкладИсточник,
	|	ТЗ.КоличествоУпаковок,
	|	ТЗ.Упаковка
	|ПОМЕСТИТЬ вт_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	СУММА(вт_ТЗ.Количество) КАК Количество,
	|	вт_ТЗ.СкладИсточник,
	|	вт_ТЗ.Упаковка,
	|	СУММА(вт_ТЗ.КоличествоУпаковок) КАК КоличествоУпаковок
	|ПОМЕСТИТЬ вт_ГруппировкаТЗ
	|ИЗ
	|	вт_ТЗ КАК вт_ТЗ
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	вт_ТЗ.СкладИсточник,
	|	вт_ТЗ.Упаковка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ГруппировкаТЗ.Номенклатура,
	|	вт_ГруппировкаТЗ.Характеристика,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(вт_ГруппировкаТЗ.Количество, 0) > ЕСТЬNULL(ОстатокНаСкладе.СвободныйОстаток, 0)
	|				ИЛИ вт_ГруппировкаТЗ.СкладИсточник = ЗНАЧЕНИЕ(Справочник.ВариантыИсточниковОбеспечения.ПустаяСсылка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НужноПереподбирать,
	|	вт_ГруппировкаТЗ.Упаковка,
	|	вт_ГруппировкаТЗ.КоличествоУпаковок
	|ПОМЕСТИТЬ тз_ГдеЕстьНарушение
	|ИЗ
	|	вт_ГруппировкаТЗ КАК вт_ГруппировкаТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0) КАК СвободныйОстаток,
	|			СвободныеОстаткиОстатки.Склад КАК Склад,
	|			СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
	|			СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
	|			ВложенныйЗапрос.ВариантИсточника КАК ВариантИсточника
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ВариантыИсточниковОбеспечения.Ссылка КАК ВариантИсточника,
	|				ВЫБОР
	|					КОГДА ВариантыИсточниковОбеспечения.Ссылка = ЗНАЧЕНИЕ(Справочник.ВариантыИсточниковОбеспечения.ИзНаличия)
	|						ТОГДА &Склад
	|					ИНАЧЕ ВариантыИсточниковОбеспечения.СкладИсточник
	|				КОНЕЦ КАК Склад
	|			ИЗ
	|				Справочник.ВариантыИсточниковОбеспечения КАК ВариантыИсточниковОбеспечения) КАК ВложенныйЗапрос
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СвободныеОстатки.Остатки(&Дата, ) КАК СвободныеОстаткиОстатки
	|				ПО ВложенныйЗапрос.Склад = СвободныеОстаткиОстатки.Склад) КАК ОстатокНаСкладе
	|		ПО вт_ГруппировкаТЗ.Номенклатура = ОстатокНаСкладе.Номенклатура
	|			И вт_ГруппировкаТЗ.Характеристика = ОстатокНаСкладе.Характеристика
	|			И вт_ГруппировкаТЗ.СкладИсточник = ОстатокНаСкладе.Склад
	|ГДЕ
	|	НЕ вт_ГруппировкаТЗ.СкладИсточник = ЗНАЧЕНИЕ(Справочник.ВариантыИсточниковОбеспечения.ПодЗаказ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	СУММА(вт_ТЗ.Количество) КАК Количество,
	|	ВложенныйЗапрос.ВариантОбеспечения,
	|	ВложенныйЗапрос.СкладИсточник,
	|	вт_ТЗ.Упаковка,
	|	СУММА(вт_ТЗ.КоличествоУпаковок) КАК КоличествоУпаковок
	|ПОМЕСТИТЬ вт_ТолькоИзОстатков
	|ИЗ
	|	вт_ТЗ КАК вт_ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВЫБОР
	|				КОГДА НЕ Номенклатура.СхемаОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)
	|					ТОГДА Номенклатура.СхемаОбеспечения
	|				ИНАЧЕ Номенклатура.ВидНоменклатуры.СхемаОбеспечения
	|			КОНЕЦ КАК СхемаОбеспечения,
	|			Номенклатура.Ссылка КАК Номенклатура
	|		ИЗ
	|			Справочник.Номенклатура КАК Номенклатура) КАК ВложенныйЗапрос1
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СхемыОбеспечения КАК СхемыОбеспечения
	|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					ВариантыИсточниковОбеспечения.Ссылка КАК ВариантОбеспечения,
	|					ВариантыИсточниковОбеспечения.СкладИсточник КАК СкладИсточник
	|				ИЗ
	|					Справочник.ВариантыИсточниковОбеспечения КАК ВариантыИсточниковОбеспечения
	|				ГДЕ
	|					ВариантыИсточниковОбеспечения.СкладИсточник = &Склад) КАК ВложенныйЗапрос
	|				ПО СхемыОбеспечения.СпособОбеспеченияПотребностей = ВложенныйЗапрос.ВариантОбеспечения
	|			ПО ВложенныйЗапрос1.СхемаОбеспечения = СхемыОбеспечения.СхемаОбеспечения
	|		ПО вт_ТЗ.Номенклатура = ВложенныйЗапрос1.Номенклатура
	|ГДЕ
	|	СхемыОбеспечения.Склад = &Склад
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	ВложенныйЗапрос.ВариантОбеспечения,
	|	ВложенныйЗапрос.СкладИсточник,
	|	вт_ТЗ.Упаковка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТолькоИзОстатков.Номенклатура,
	|	вт_ТолькоИзОстатков.Характеристика,
	|	РасчетСвобОстаткаМагазин.СвобОстаток КАК СвобОстатокМагазин,
	|	вт_ТолькоИзОстатков.Количество,
	|	ОстатокПоСкладуОбеспечения.СвобОстаток КАК СвобОстатокСклад,
	|	вт_ТолькоИзОстатков.ВариантОбеспечения,
	|	вт_ТолькоИзОстатков.СкладИсточник,
	|	вт_ТолькоИзОстатков.КоличествоУпаковок,
	|	вт_ТолькоИзОстатков.Упаковка
	|ПОМЕСТИТЬ вт_СлучаиОшибки
	|ИЗ
	|	вт_ТолькоИзОстатков КАК вт_ТолькоИзОстатков
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
	|			СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
	|			СвободныеОстаткиОстатки.Склад КАК Склад,
	|			СУММА(ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0)) КАК СвобОстаток
	|		ИЗ
	|			РегистрНакопления.СвободныеОстатки.Остатки(&Дата, Склад = &Склад) КАК СвободныеОстаткиОстатки
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СвободныеОстаткиОстатки.Номенклатура,
	|			СвободныеОстаткиОстатки.Характеристика,
	|			СвободныеОстаткиОстатки.Склад) КАК РасчетСвобОстаткаМагазин
	|		ПО вт_ТолькоИзОстатков.Номенклатура = РасчетСвобОстаткаМагазин.Номенклатура
	|			И вт_ТолькоИзОстатков.Характеристика = РасчетСвобОстаткаМагазин.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
	|			СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
	|			СвободныеОстаткиОстатки.Склад КАК Склад,
	|			СУММА(ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0)) КАК СвобОстаток
	|		ИЗ
	|			РегистрНакопления.СвободныеОстатки.Остатки(&Дата, ) КАК СвободныеОстаткиОстатки
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СвободныеОстаткиОстатки.Номенклатура,
	|			СвободныеОстаткиОстатки.Характеристика,
	|			СвободныеОстаткиОстатки.Склад) КАК ОстатокПоСкладуОбеспечения
	|		ПО вт_ТолькоИзОстатков.Номенклатура = ОстатокПоСкладуОбеспечения.Номенклатура
	|			И вт_ТолькоИзОстатков.Характеристика = ОстатокПоСкладуОбеспечения.Характеристика
	|			И вт_ТолькоИзОстатков.СкладИсточник = ОстатокПоСкладуОбеспечения.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			тз_ГдеЕстьНарушение.Номенклатура КАК Номенклатура,
	|			тз_ГдеЕстьНарушение.Характеристика КАК Характеристика,
	|			тз_ГдеЕстьНарушение.НужноПереподбирать КАК НужноПереподбирать,
	|			тз_ГдеЕстьНарушение.Упаковка КАК Упаковка
	|		ИЗ
	|			тз_ГдеЕстьНарушение КАК тз_ГдеЕстьНарушение) КАК ВложенныйЗапрос
	|		ПО вт_ТолькоИзОстатков.Номенклатура = ВложенныйЗапрос.Номенклатура
	|			И вт_ТолькоИзОстатков.Характеристика = ВложенныйЗапрос.Характеристика
	|			И вт_ТолькоИзОстатков.Упаковка = ВложенныйЗапрос.Упаковка
	|ГДЕ
	|	ВложенныйЗапрос.НужноПереподбирать
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_СлучаиОшибки.Номенклатура,
	|	вт_СлучаиОшибки.Характеристика,
	|	вт_СлучаиОшибки.Количество,
	|	СУММА(ЕСТЬNULL(вт_СлучаиОшибки.СвобОстатокМагазин, 0)) КАК СвобОстатокМагазин,
	|	СУММА(ЕСТЬNULL(вт_СлучаиОшибки.СвобОстатокСклад, 0)) КАК СвобОстатокСклад,
	|	вт_СлучаиОшибки.ВариантОбеспечения,
	|	вт_СлучаиОшибки.СкладИсточник,
	|	ВложенныйЗапрос.ПоискПоСкладам,
	|	вт_СлучаиОшибки.КоличествоУпаковок,
	|	вт_СлучаиОшибки.Упаковка
	|ИЗ
	|	вт_СлучаиОшибки КАК вт_СлучаиОшибки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Номенклатура.ВидНоменклатуры.ПроизводитьПоискПоСкладам КАК ПоискПоСкладам,
	|			Номенклатура.Ссылка КАК Номенклатура
	|		ИЗ
	|			Справочник.Номенклатура КАК Номенклатура) КАК ВложенныйЗапрос
	|		ПО вт_СлучаиОшибки.Номенклатура = ВложенныйЗапрос.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_СлучаиОшибки.Номенклатура,
	|	вт_СлучаиОшибки.Характеристика,
	|	вт_СлучаиОшибки.Количество,
	|	вт_СлучаиОшибки.СкладИсточник,
	|	вт_СлучаиОшибки.ВариантОбеспечения,
	|	ВложенныйЗапрос.ПоискПоСкладам,
	|	вт_СлучаиОшибки.КоличествоУпаковок,
	|	вт_СлучаиОшибки.Упаковка";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТВЗ = Новый ТаблицаЗначений;
	ТВЗ = Запрос.Выполнить().Выгрузить();
	
	
	МР = Новый Массив;
	Пока Выборка.Следующий() цикл
		П = Новый Структура;
		П.Вставить("Номенклатура", Выборка.Номенклатура);
		П.Вставить("Характеристика", Выборка.Характеристика);
		П.Вставить("СкладИсточник", Выборка.СкладИсточник);
		П.Вставить("ВариантОбеспечения", Выборка.ВариантОбеспечения);
		П.Вставить("СвобОстатокМагазин",Выборка.СвобОстатокМагазин);
		П.Вставить("СвобОстатокСклад",Выборка.СвобОстатокСклад);
		П.Вставить("Количество",Выборка.Количество);
		П.Вставить("КоличествоУпаковок",Выборка.КоличествоУпаковок);		
		П.Вставить("Упаковка",Выборка.Упаковка);				
		П.Вставить("ПоискПоСкладам",Выборка.ПоискПоСкладам);
		
		Если ЗначениеЗаполнено(Выборка.Упаковка) 
			И Выборка.Упаковка.Числитель > 0 Тогда
			Знам  = ?(Выборка.Упаковка.Знаменатель > 0, Выборка.Упаковка.Знаменатель, 1);
			Кратность = Выборка.Упаковка.Числитель / Знам;
		ИНаче
			Кратность = 1;	
		КонецЕсли;
        П.Вставить("Кратность", Кратность);
		МР.Добавить(П);
	КонецЦикла;	
	
	Возврат МР;	

КонецФункции

&НаСервере
Функция ПолучитьРеквизитыОбъектовНовойПочты(ОБъектСсылка) экспорт
	
	п = Новый Структура("Получатель, Декларация");
	
	Рез = РегистрыСведений.РеквизитыДоставки.СтруктураДанныхЗаписи(ОбъектСсылка);
	Если Рез = неопределено
		ТОгда П.Получатель = "Не визначено. Додати";
	ИначеЕсли Рез.ПараметрыДоставкиСтрокой = ""
		Тогда 
		п.Получатель = "Реквізити отримувача не визначені";
	Иначе
		
		П.Получатель = Рез.ПараметрыДоставкиСтрокой;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	eComm_ЭкспрессНакладная.Ссылка,
	                      |	eComm_ЭкспрессНакладная.Проведен,
	                      |	eComm_ЭкспрессНакладная.НомерТТН,
	                      |	eComm_ЭкспрессНакладная.Статус,
	                      |	eComm_ЭкспрессНакладная.Номер,
	                      |	eComm_ЭкспрессНакладная.Дата,
	                      |	ВложенныйЗапрос.Статус КАК Статус1,
	                      |	ВложенныйЗапрос.ОписаниеСтатуса
	                      |ИЗ
	                      |	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			eComm_СтатусыЭкспрессНакладных.ЭкспрессНакладная КАК ЭкспрессНакладная,
	                      |			eComm_СтатусыЭкспрессНакладных.Статус КАК Статус,
	                      |			eComm_СтатусыЭкспрессНакладных.ОписаниеСтатуса КАК ОписаниеСтатуса,
	                      |			eComm_СтатусыЭкспрессНакладных.НачалоПлатногоХранения КАК НачалоПлатногоХранения,
	                      |			eComm_СтатусыЭкспрессНакладных.СтатусДенежногоПеревода КАК СтатусДенежногоПеревода,
	                      |			eComm_СтатусыЭкспрессНакладных.ДатаПрибытияНаСклад КАК ДатаПрибытияНаСклад,
	                      |			eComm_СтатусыЭкспрессНакладных.ДнейХраненияНаСкладе КАК ДнейХраненияНаСкладе,
	                      |			eComm_СтатусыЭкспрессНакладных.ДатаПолучения КАК ДатаПолучения
	                      |		ИЗ
	                      |			РегистрСведений.eComm_СтатусыЭкспрессНакладных КАК eComm_СтатусыЭкспрессНакладных) КАК ВложенныйЗапрос
	                      |		ПО eComm_ЭкспрессНакладная.Ссылка = ВложенныйЗапрос.ЭкспрессНакладная
	                      |ГДЕ
	                      |	eComm_ЭкспрессНакладная.ДокументОснование = &ДокументОснование
	                      |	И НЕ eComm_ЭкспрессНакладная.ПометкаУдаления");
	
	Запрос.УстановитьПараметр("ДокументОснование",ОБъектСсылка); 
	Выборка =  Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 тогда
	Текст = "Оформлених експрес-накладних немає";
	Иначе
		Текст = "";
		Пока выборка.Следующий() цикл
		Текст = Текст + "Вн№ " + Строка(Выборка.Номер) + " " + Строка(Выборка.Дата) + " " + Строка(Выборка.НомерТТН) + ": " + Строка(Выборка.ОписаниеСтатуса)+ Символы.ПС;
	КонецЦикла;
	КонецЕсли;
    П.Декларация = Текст;
	Возврат П;
	
КонецФункции	

