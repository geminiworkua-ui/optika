Процедура СоздатьКопиюРеквизитовДоставки(Получатель, Источник) экспорт
	
	УстановитьПривилегированныйрежим(Истина);
	
	Набор = РегистрыСведений.РеквизитыДоставки.СоздатьНаборЗаписей();
	Набор.Отбор.ОбъектВладелец.Установить(Источник); 
	Набор.Прочитать();
	Для каждого Запись из Набор цикл
		
		НовЗапись = РегистрыСведений.РеквизитыДоставки.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(НовЗапись, Запись, ,"ОбъектВладелец");
		НовЗапись.ОбъектВладелец = Получатель;
		НовЗапись.Записать();
	КонецЦикла;
		
КонецПроцедуры	

	
&НаСервере
Процедура СоздатьРеквизитыПеремещения(СкладОтправитель, СкладПолучатель, ДокументПеремещения)  экспорт
	
	Если Не ЗначениеЗаполнено(СкладОтправитель)
		ИЛИ НЕ ЗначениеЗаполнено(СкладПолучатель)
		ИЛи НЕ ЗначениеЗаполнено(ДокументПеремещения)
		ТОгда
		Возврат;
	КонецЕсли;
	
	СтруктураОтправитель = РегистрыСведений.РеквизитыДоставки.СтруктураДанныхЗаписи(СкладОтправитель);
	СтруктураПолучатель = РегистрыСведений.РеквизитыДоставки.СтруктураДанныхЗаписи(СкладПолучатель);
	СтруктураНазначения = РегистрыСведений.РеквизитыДоставки.СтруктураДанныхЗаписи(ДокументПеремещения); 
	
	Если  СтруктураОтправитель = Неопределено
		ИЛИ  СтруктураПолучатель = Неопределено
		ИЛИ НЕ  СтруктураНазначения = Неопределено
		ТОгда
		Возврат;
	КонецЕсли;
	
	НовЗапись = РегистрыСведений.РеквизитыДоставки.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(НовЗапись,СтруктураОтправитель,"СлужбаДоставки, ТехнологияДоставки, УчетнаяЗапись, НаселенныйПунктОтправителя, ОтправительПоУмолчанию, ОтделениеОтправителя, ФизическоеЛицоОтправитель"); 
	ЗаполнитьЗначенияСвойств(НовЗапись,СтруктураПолучатель,"ПолучательФИО, ПолучательФамилия, ПолучательИмя, ПолучательОтчество, ПолучательТелефон, НаселенныйПунктПолучателя, УлицаПолучателя, ОтделениеПолучателя, НомерДомаПолучателя, НомерКвартирыПолучателя "); 	
	НовЗапись.ОбъектВладелец = ДокументПеремещения;
	НовЗапись.Записать();
		
КонецПроцедуры	
	
	
&НаСервере
Функция ДополнениеУстновкиЦенНаХарактеристики(Номенклатура, Характеристика) экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ХарактеристикиНоменклатуры.Владелец КАК Владелец
	                      |ПОМЕСТИТЬ Вт1
	                      |ИЗ
	                      |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	                      |ГДЕ
	                      |	ХарактеристикиНоменклатуры.Владелец = &Номенклатура
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ХарактеристикиНоменклатуры.Владелец
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Вт1.Владелец КАК Владелец,
	                      |	ВложенныйЗапрос.ВидЦены КАК ВидЦены,
	                      |	ЕСТЬNULL(ВложенныйЗапрос.Цена, 0) КАК Цена
	                      |ИЗ
	                      |	Вт1 КАК Вт1
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	                      |			ЦеныНоменклатурыСрезПоследних.ВидЦены КАК ВидЦены,
	                      |			МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Цена) КАК Цена
	                      |		ИЗ
	                      |			РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	                      |		
	                      |		СГРУППИРОВАТЬ ПО
	                      |			ЦеныНоменклатурыСрезПоследних.Номенклатура,
	                      |			ЦеныНоменклатурыСрезПоследних.ВидЦены) КАК ВложенныйЗапрос
	                      |		ПО Вт1.Владелец = ВложенныйЗапрос.Номенклатура");
	
	 Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата()-1000);
	 Запрос.УстановитьПараметр("ВидЦены", Справочники.ВидыЦен.НайтиПоНаименованию("Роздрібна"));
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);	  
		Цена = 0;
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество() > 0 Тогда
			
			ДО = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
			ДО.Дата = ТекущаяДата()-1000;
            ДО.Согласован = Истина;
			ДО.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
            ДО.Комментарий = "Створено автоматично ";
			
			Для Каждого Стр Из ТЗ Цикл
				НовСтр = ДО.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, СТр);
				НовСтр.Номенклатура = Номенклатура;
				НовСтр.Характеристика = Характеристика;
				Цена = Стр.Цена;
			КонецЦикла;
			
			ТЗвидыЦен = ТЗ;
			ТЗвидыЦен.Свернуть("ВидЦены");
			Для каждого Стр Из ТЗвидыЦен Цикл 	
				СтрокаВЦ = ДО.ВидыЦен.Добавить();  
				СтрокаВЦ.ВидЦены = Стр.ВидЦены;
		//		СтрокаВЦ.НастройкиКомпоновкиДанных =  ПоместитьВоВременноеХранилище(Стр.ВидЦены, Новый УникальныйИдентификатор);
			КонецЦикла;
  			
			Попытка
				ДО.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ДО.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки;
		КонецЕсли;
		
	//	ТЗСтрок = ТЗ.НайтиСтроки(новый Структура("Номенклатура, Характеристика", Номенклатура, Характеристика));
	
	
	
	Возврат Цена;
		
КонецФункции	

