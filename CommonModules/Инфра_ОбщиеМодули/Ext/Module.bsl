Функция ОпределитьКассуККМ(Номенклатура, Склад, НуженЧек) Экспорт
	 
	УстановитьПривилегированныйРежим(Истина);
	
	СтрВозврат  =Новый Структура;
	СтрВозврат.Вставить("КассаККМ", Справочники.КассыККМ.ПустаяСсылка());
	СтрВозврат.Вставить("КассирПоУмолчанию",Справочники.Пользователи.ПустаяСсылка());
	
	Если НуженЧек Тогда
		
		Запрос =Новый Запрос(
		"ВЫБРАТЬ
		|	ПривязкаСПДСрезПоследних.КассаККМ,
		|	ПривязкаСПДСрезПоследних.КассирПоУмолчанию
		|ИЗ
		|	РегистрСведений.ПривязкаСПД.СрезПоследних(
		|			&Дата,
		|			ГруппаНоменклатурыДляРРО = &ГруппаНоменклатурыДляРРО
		|				И Магазин = &Магазин
		|				И Фискализация = ИСТИНА) КАК ПривязкаСПДСрезПоследних");
		
	ИНаче
		Запрос =Новый Запрос(
		"ВЫБРАТЬ
		|	ПривязкаСПДСрезПоследних.КассаККМ,
		|	ПривязкаСПДСрезПоследних.КассирПоУмолчанию
		|ИЗ
		|	РегистрСведений.ПривязкаСПД.СрезПоследних(
		|			&Дата,
		|			Магазин = &Магазин
		|				И Фискализация = ЛОЖЬ) КАК ПривязкаСПДСрезПоследних");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Магазин", Склад);
	Если Номенклатура.ВидНоменклатуры = Справочники.Номенклатура.ПустаяСсылка() Тогда
		Возврат СтрВозврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ГруппаНоменклатурыДляРРО", Номенклатура.ВидНоменклатуры.ГруппаНоменклатурыДляРРО);
	Рез =Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда
		СтрВозврат.КассаККМ = Рез.КассаККМ;
		СтрВозврат.КассирПоУмолчанию	= Рез.КассирПоУмолчанию;
	КонецЕсли;
	Возврат СтрВозврат; 
	
 КонецФункции
 
Функция РаспределитьПоЧекам(Заказ, РМК, ТЗОстатки) Экспорт
	МассивЧеков = Новый Массив;
	КассыРМК = ПолучитьКассыРМК(РМК); 
	//ТЗОстатки = ОстаткиКОплате.Выгрузить();
	Для Каждого КассаРМК из КассыРМК Цикл 
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("КассаККМ", КассаРМК);
		СтруктураПоиска.Вставить("Платим", Истина);
		
		НайденныеСтроки = ТЗОстатки.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() =0 Тогда
			Продолжить;
		КонецЕсли;	
		ЧекПоТоварам = СоздатьЧекПоОтбору(НайденныеСтроки, Заказ);
		Если Не ЧекПоТоварам = Неопределено и Не ЧекПоТоварам = Документы.ЧекККМ.ПустаяСсылка() Тогда	
			МассивЧеков.Добавить(ЧекПоТоварам);
		КонецЕсли;
	КонецЦикла;
	Возврат  МассивЧеков;
КонецФункции

Функция ПолучитьКассыРМК(РМК)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НастройкиРМККассыККМ.КассаККМ
	|ИЗ
	|	Справочник.НастройкиРМК.КассыККМ КАК НастройкиРМККассыККМ
	|ГДЕ
	|	НастройкиРМККассыККМ.Ссылка.РабочееМесто = &РабочееМесто");
	Запрос.УстановитьПараметр("РабочееМесто", РМК);
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КассаККМ");
	Возврат Результат;
	
КонецФункции


Функция СоздатьЧекПоОтбору(СтрокиЗаказа, Заказ) экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	НовыйЧек = Документы.ЧекККМ.СоздатьДокумент();  
	Если СтрокиЗаказа.Количество()=0 Тогда
		Возврат Неопределено;
	КОнецЕсли;	 
	КассаККМ = СтрокиЗаказа[0].КассаККМ;
	НовыйЧек.ДокументОснование = Заказ;
	НовыйЧек.НомерЧекаККМ = "";
	НовыйЧек.Архивный = Ложь;
	НовыйЧек.Статус = Неопределено;
	
	НовыйЧек.ПолученоНаличными = 0;
	
	СостояниеКассовойСмены = РозничныеПродажи.ПолучитьСостояниеКассовойСмены(КассаККМ);
	ЗаполнитьЗначенияСвойств(НовыйЧек, СостояниеКассовойСмены);
	
	Для каждого Стр из СтрокиЗаказа Цикл
		СтрТЧ =НовыйЧек.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТЧ, Стр);  
		СтрТЧ.Количество = Стр.КоличествоЧек;
		СтрТЧ.КоличествоУпаковок = Стр.КоличествоЧек;
		СтрТЧ.Цена = Стр.Цена;
		СтрТЧ.Сумма = Стр.СуммаЧек;
		СтрТЧ.Штрихкод = ЗаполнитьШтрихкод(Стр.Номенклатура, Стр.Характеристика);
		СтрТЧ.СуммаБонусныхБалловКСписанию = 0;
		СтрТЧ.СуммаБонусныхБалловКСписаниюВВалюте = 0; 
		СтрТЧ.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		СтрТЧ.продавец = ПродавецПоЗаказу(Заказ, Стр.Номенклатура, Стр.Характеристика);
		Если СтрТЧ.продавец = Справочники.Пользователи.ПустаяСсылка() Тогда
			СтрТЧ.продавец = Стр.Кассир; 	
		КонецЕсли;
		Если СтрТЧ.продавец = Справочники.Пользователи.ПустаяСсылка() Тогда
			СтрТЧ.продавец = ПараметрыСеанса.АвторизованныйПользователь;    
		КонецЕсли;	 
	
	КонецЦикла;	 
	
	Для каждого Стр из Заказ.скидкиНаценки Цикл
		СтрТЧ =НовыйЧек.СкидкиНаценки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТЧ, Стр);
	КонецЦикла;	 
	
	если НовыйЧек.СкидкиНаценки.Количество()=0
		Тогда
		НовыйЧек.СкидкиРассчитаны = Ложь;
	Иначе
		НовыйЧек.СкидкиРассчитаны = Истина;
	КонецЕсли;	 
	НовыйЧек.ДокументОснование = Заказ;
	НовыйЧек.Партнер = Заказ.Партнер;                
	НовыйЧек.Организация = КассаККМ.Владелец;
	НовыйЧек.КартаЛояльности = Заказ.КартаЛояльности;
	НовыйЧек.СуммаДокумента = Заказ.СуммаДокумента;  
	НовыйЧек.Статус = Перечисления.СтатусыЧековККМ.ТоварЗарезервирован;
	НовыйЧек.Дата = ТекущаяДата();
	НовыйЧек.Записать(РежимЗаписиДокумента.Проведение);
	Возврат НовыйЧек.Ссылка;  
	
КонецФункции 

Функция ПродавецПоЗаказу(Заказ, Номенклатура, Характеристика)
   СтрПоиска = Новый Структура;
   СтрПоиска.Вставить("Номенклатура", Номенклатура);
   СтрПоиска.Вставить("Характеристика", Характеристика); 
   СтрПоиска.Вставить("Отменено", Ложь);
   Строки = Заказ.Товары.НайтиСтроки(СтрПоиска);
   Если Не Строки.количество()=0 Тогда
	 Возврат Строки[0].Продавец;  
	Иначе	Возврат Справочники.Пользователи.ПустаяСсылка(); 
   КонецЕсли;	   
   
				
КонецФункции	

