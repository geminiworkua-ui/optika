
// + Боков
// Обходит наряды на работу и проверяет, поступил ли материалв, указанный в т.ч., в полном объеме. Если да, то меняетс статус заказа

Процедура КонтрольОбеспеченияМастераМатериалами() Экспорт
	
    // выбираем состав гнарядов, которые ожидают обеспечения
	тз_Наряды = новый ТаблицаЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НарядНаРаботы.Ссылка КАК НарядНаРаботу
		|ИЗ
		|	Документ.НарядНаРаботы КАК НарядНаРаботы
		|ГДЕ
		|	НарядНаРаботы.Проведен
		|	И НарядНаРаботы.Статус = &СтатусОжидаетОбеспечения";
	
	Запрос.УстановитьПараметр("СтатусОжидаетОбеспечения", Перечисления.СтатусДокументаНарядНаРаботу.ОжидаетОбеспечения);
	тз_Наряды = Запрос.Выполнить().Выгрузить();
	
	// отбираем остатки товаров на магазинах на сегодня
	тз_Остатки = новый ТаблицаЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоотвествиеПодразделенияМастера.Подразделение
		|ПОМЕСТИТЬ вт_НужныеПоразделения
		|ИЗ
		|	РегистрСведений.СоотвествиеПодразделенияМастера КАК СоотвествиеПодразделенияМастера
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.Номенклатура,
		|	ТоварыНаСкладахОстатки.Характеристика,
		|	ТоварыНаСкладахОстатки.Назначение,
		|	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Количество,
		|	ТоварыНаСкладахОстатки.Назначение.Заказ КАК ЗаказКлиента,
		|	ТоварыНаСкладахОстатки.Склад.Подразделение КАК Подразделение
		|ИЗ
		|	вт_НужныеПоразделения КАК вт_НужныеПоразделения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(&ТекДата, ) КАК ТоварыНаСкладахОстатки
		|		ПО вт_НужныеПоразделения.Подразделение = ТоварыНаСкладахОстатки.Склад.Подразделение";
	
	Запрос.УстановитьПараметр("ТекДата", Текущаядата());
	тз_Остатки = Запрос.Выполнить().Выгрузить();

	
	// обходим докмуенты и построчно проверяем наличе товара на остатке
	
	Для каждого Стр из тз_Наряды цикл
		Обеспечен = Истина;
		Для каждого СтрТЧ из Стр.НарядНаРаботу.Товары Цикл
			Если СтрТЧ.ОбеспечиватьОбособленно = Истина 
				Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	вт_Остатки.Номенклатура,
				|	вт_Остатки.Характеристика,
				|	вт_Остатки.Количество КАК Колич,
				|	вт_Остатки.ЗаказКлиента,
				|	вт_Остатки.Подразделение
				|ПОМЕСТИТЬ вт_Ост
				|ИЗ
				|	&вт_Остатки КАК вт_Остатки
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	вт_Ост.Номенклатура,
				|	вт_Ост.Характеристика,
				|	вт_Ост.ЗаказКлиента,
				|	вт_Ост.Подразделение,
				|	СУММА(вт_Ост.Колич) КАК Колич
				|ИЗ
				|	вт_Ост КАК вт_Ост
				|ГДЕ
				|	вт_Ост.Номенклатура = &Номенклатура
				|	И вт_Ост.Характеристика = &Характеристика
				|	И вт_Ост.ЗаказКлиента = &ЗаказКлиента
				|	И вт_Ост.Подразделение = &Подразделение
				|
				|СГРУППИРОВАТЬ ПО
				|	вт_Ост.Характеристика,
				|	вт_Ост.ЗаказКлиента,
				|	вт_Ост.Номенклатура,
				|	вт_Ост.Подразделение";
				
				Запрос.УстановитьПараметр("Номенклатура", СтрТЧ.Номенклатура);
				Запрос.УстановитьПараметр("Характеристика", СтрТЧ.Характеристика);
				Запрос.УстановитьПараметр("ЗаказКлиента", Стр.НарядНаРаботу.ЗаказКлиента); 
				Запрос.УстановитьПараметр("Подразделение", Стр.НарядНаРаботу.Подразделение);
				Запрос.УстановитьПараметр("вт_Остатки", тз_Остатки);

				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					КоличЕсть = Выборка.Колич;
				Иначе
					КоличЕсть = 0
				КонецЕсли;
				
			Иначе
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	вт_Остатки.Номенклатура,
				|	вт_Остатки.Характеристика,
				|	вт_Остатки.Количество КАК Колич,
				|	вт_Остатки.Подразделение
				|ПОМЕСТИТЬ вт_Ост
				|ИЗ
				|	&вт_Остатки КАК вт_Остатки
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	вт_Ост.Номенклатура,
				|	вт_Ост.Характеристика,
				|	вт_Ост.Колич
				|ИЗ
				|	вт_Ост КАК вт_Ост
				|ГДЕ
				|	вт_Ост.Номенклатура = &Номенклатура
				|	И вт_Ост.Характеристика = &Характеристика
				|	И вт_Ост.Подразделение = &Подразделение
				|
				|СГРУППИРОВАТЬ ПО
				|	вт_Ост.Характеристика,
				|	вт_Ост.Номенклатура,
				|	вт_Ост.Колич";
				
				Запрос.УстановитьПараметр("Номенклатура", СтрТЧ.Номенклатура);
				Запрос.УстановитьПараметр("Характеристика", СтрТЧ.Характеристика);
				Запрос.УстановитьПараметр("Подразделение", Стр.НарядНаРаботу.Подразделение);
				Запрос.УстановитьПараметр("вт_Остатки", тз_Остатки);

				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					КоличЕсть = Выборка.Колич;
				Иначе
					КоличЕсть = 0
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрТЧ.Количество > КоличЕсть
				Тогда
				Обеспечен = Ложь
			КонецЕсли;
		КонецЦикла;
		// если все пришло, то меняем документу статус
		Если  Обеспечен = Истина
			Тогда
			ДокОбъект = Стр.НарядНаРаботу.ПолучитьОбъект();
			ДокОбъект.Статус = Перечисления.СтатусДокументаНарядНаРаботу.ОжидаетПринятияВработу;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		КонецЦикла;

	КонецПроцедуры
	
Функция ЗаменитьНоменклатуру (ДокументИсточник, НоменклатураСтар, ХарактеристикаСтар,  НоменклатураНов, ХарактеристикаНов,Назначение, Количество, Автор, ПричинаОтмены, Комментарий) Экспорт	
		

	Если Назначение = Неопределено
		или НЕ ЗначениеЗаполнено(Назначение)
		Тогда
		Сообщить("По обраній позиції не визнечени документи замовлень. Реєстрація зміни номенклатури неможлива");
		Возврат Ложь;
	Иначе
		
		Попытка;
		
		// Найдем и пометим как отмененные в документах перемещения
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказНаПеремещениеТовары.Ссылка КАК ДокументПеремещения
		|ИЗ
		|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
		|ГДЕ
		|	ЗаказНаПеремещениеТовары.Номенклатура = &Номенклатура
		|	И ЗаказНаПеремещениеТовары.Характеристика = &Характеристика
		|	И ЗаказНаПеремещениеТовары.Ссылка.Проведен
		|	И ЗаказНаПеремещениеТовары.Назначение = &Назначение
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаПеремещениеТовары.Ссылка";
		Запрос.УстановитьПараметр("Назначение", Назначение);
	    Запрос.УстановитьПараметр("Номенклатура", НоменклатураСтар);
	    Запрос.УстановитьПараметр("Характеристика", ХарактеристикаСтар);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() > 0 Тогда 	
			Пока Выборка.Следующий() цикл
				ДокОбъект = Выборка.ДокументПеремещения.ПолучитьОбъект();			
				Для каждого Стр из ДокОбъект.Товары цикл
					Если Стр.Номенклатура = НоменклатураСтар
						И 
						Стр.Характеристика = ХарактеристикаСтар
						Тогда
						Стр.Отменено  = Истина;
					КонецЕсли;
				КонецЦикла;
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;
		КонецЕсли;	
		
		
		// Найдем и обработаем Заказ Клиента

		ДокументЗаказ = неопределено;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Номенклатура,
		|	ЗаказКлиентаТовары.Характеристика,
		|	ЗаказКлиентаТовары.Количество,
		|	ЗаказКлиентаТовары.НомерСтроки,
		|	ЗаказКлиентаТовары.ВариантОбеспечения
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка.Ссылка = &Ссылка
		|	И ЗаказКлиентаТовары.Номенклатура = &Номенклатура
		|	И ЗаказКлиентаТовары.Характеристика = &Характеристика";
		Запрос.УстановитьПараметр("Ссылка", Назначение.Заказ);
	    Запрос.УстановитьПараметр("Номенклатура", НоменклатураСтар);
	    Запрос.УстановитьПараметр("Характеристика", ХарактеристикаСтар);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		ДокОбъект = Назначение.Заказ.ПолучитьОбъект();		
		
		Если Выборка.Количество() >0 Тогда 	
			
		ДокументЗаказ = Назначение.Заказ;	
			
			
		Пока Выборка.Следующий() цикл
			
		//отметимСтрокуНаУдаление	
		ДокОбъект.Товары[Выборка.НомерСтроки-1].Отменено = Истина;
		ДокОбъект.Товары[Выборка.НомерСтроки-1].ПричинаОтмены = ПричинаОтмены;
		
		// Отразим преемника платежа - т.е. в старой номенклатуре отметим на какую номенлклатуру "перейдут" полученные ранее оплаты.
        ДокОбъект.Товары[Выборка.НомерСтроки-1].ПреемникПлатежаН = НоменклатураНов;
		ДокОбъект.Товары[Выборка.НомерСтроки-1].ПреемникПлатежаХ = ХарактеристикаНов;
		
		// проверим: если в документе ранее были замены, то в них
		// сменим преемника на нового
		
		
		Для каждого Стр Из  ДокОбъект.Товары цикл
			Если 
				Стр.Отменено  = Истина
				И
				ЗначениеЗаполнено(Стр.ПреемникПлатежаН) 
				И 
				ЗначениеЗаполнено(Стр.ПреемникПлатежаХ)
				И
				Стр.ПреемникПлатежаН = НоменклатураСтар 
				И
				Стр.ПреемникПлатежаХ = ХарактеристикаСтар
				Тогда
				Стр.ПреемникПлатежаН = НоменклатураСтар;
				Стр.ПреемникПлатежаХ = ХарактеристикаНов;
			КонецЕсли;
		КонецЦикла;

		//добавим новую строку ТЧ для заполнения
		
		НовСтр = ДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,ДокОбъект.Товары[Выборка.НомерСтроки-1]);
		
		НовСтр.Номенклатура = НоменклатураНов;
		НовСтр.Характеристика = ХарактеристикаНов;
		НовСтр.Отменено = Ложь;
		НовСтр.ПричинаОтмены = Неопределено;
		// установим цену для новой номенклатуры
		Цена = НайтиЦенуНаДату(НоменклатураНов,ХарактеристикаНов,ДокОбъект.Товары[Выборка.НомерСтроки-1].ВидЦены,ДокОбъект.Дата);
		НовСтр.Цена = Цена;
		НовСтр.Сумма = Цена * НовСтр.Количество;
		// вычислим суммы НДС и заполним суммы
		Если  ДокОбъект.ЦенаВключаетНДС = Истина
			Тогда
			НовСтр.СуммаНДС = НовСтр.Сумма * (1-1/(1+ЗначениеСтавкиНДС(НовСтр.СтавкаНДС)));
			НовСтр.СуммаСНДС = НовСтр.Сумма;
		Иначе
			НовСтр.СуммаНДС = НовСтр.Сумма * ЗначениеСтавкиНДС(НовСтр.СтавкаНДС);
			НовСтр.СуммаСНДС = НовСтр.Сумма + НовСтр.СуммаНДС;
		КонецЕсли;
		
		КонецЦикла;
		 		// запишем в комментарий документа суть произошедшего
		
		ТекКомметарий = ДокОбъект.Комментарий;
		НовЗапись = формат(ТекущаяДата(),"Л=uk; ДФ=dd.MM.yyyy") + " здійснено заміну номенклатури " + строка(НоменклатураСтар) + строка(ХарактеристикаСтар) + 
		" На " + строка(НоменклатураНов) + строка(ХарактеристикаНов)  + " у зв'язку з " 
		+ строка(ПричинаОтмены) +  " / " + строка(Комментарий)+  ". Автор - " + Строка(Автор);
		
		
		Если ЗначениеЗаполнено(ТекКомметарий) Тогда
			НовТекст = ТекКомметарий + Символы.ПС + СокрЛП(НовЗапись);
		ИНаче
			НовТекст = СокрЛП(НовЗапись);
		КонецЕсли;
		ДокОбъект.Комментарий = НовТекст;
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
       		
		// сформируем запись в регистре  "РеестрЗаменыНоменклатуры"
		
		МенеджерЗаписей = РегистрыСведений.РеестрЗаменНоменклатуры.СоздатьМенеджерЗаписи();
		МенеджерЗаписей.Период = Текущаядата();
		МенеджерЗаписей.Регистратор = ДокументИсточник;
		МенеджерЗаписей.Автор = Автор;
		МенеджерЗаписей.ДокументРегистратор = ДокументИсточник;
		МенеджерЗаписей.ДокументЗамены = ДокументЗаказ;
		МенеджерЗаписей.НоменклатураНов =  НоменклатураНов;
		МенеджерЗаписей.НоменклатураСтар =  НоменклатураСтар;
		МенеджерЗаписей.ХарактеристикаНов = ХарактеристикаНов; 
		МенеджерЗаписей.ХарактеристикаСтар  = ХарактеристикаСтар;
		МенеджерЗаписей.Записать(Истина);
			
	КонецЕсли; 
	
	// Повторно обойдем документы заказа на перемещение и произведем замену
	ЗаказНаПеремещение = неопределено;
	
	
	Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНаПеремещениеТовары.Ссылка КАК ДокументПеремещения
		|ИЗ
		|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
		|ГДЕ
		|	ЗаказНаПеремещениеТовары.Номенклатура = &Номенклатура
		|	И ЗаказНаПеремещениеТовары.Характеристика = &Характеристика
		|	И ЗаказНаПеремещениеТовары.Ссылка.Проведен
		|	И ЗаказНаПеремещениеТовары.Назначение = &Назначение
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаПеремещениеТовары.Ссылка";
		Запрос.УстановитьПараметр("Назначение", Назначение);
	    Запрос.УстановитьПараметр("Номенклатура", НоменклатураСтар);
	    Запрос.УстановитьПараметр("Характеристика", ХарактеристикаСтар);
		Выборка = Запрос.Выполнить().Выбрать();
	
		Если Выборка.Количество() > 0 Тогда 	
			Пока Выборка.Следующий() цикл
				ДокОбъект = Выборка.ДокументПеремещения.ПолучитьОбъект();			
				
				ЗаказНаПеремещение = ДокОбъект; 
				
				
				Для каждого Стр из ДокОбъект.Товары цикл
					Если Стр.Номенклатура = НоменклатураСтар
						И 
						Стр.Характеристика = ХарактеристикаСтар
						Тогда
						НовСтр = ДокОбъект.Товары.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр,Стр);
						НовСтр.Номенклатура = НоменклатураНов;
						НовСтр.Характеристика = ХарактеристикаНов;
						НовСтр.Отменено = Ложь;
						
					КонецЕсли;
				КонецЦикла;
				
				// запишем в комментарий документа суть произошедшего
				
				ТекКомметарий = ДокОбъект.Комментарий;
				НовЗапись = формат(ТекущаяДата(),"Л=uk; ДФ=dd.MM.yyyy") + " здійснено заміну номенклатури " + строка(НоменклатураСтар) + строка(ХарактеристикаСтар) + 
				" На " + строка(НоменклатураНов) + строка(ХарактеристикаНов)  + " у зв'язку з " 
				+ строка(ПричинаОтмены) +  " / " + строка(Комментарий)+  ". Автор - " + Строка(Автор);
				
				
				Если ЗначениеЗаполнено(ТекКомметарий) Тогда
					НовТекст = ТекКомметарий + Символы.ПС + СокрЛП(НовЗапись);
				ИНаче
					НовТекст = СокрЛП(НовЗапись);
				КонецЕсли;
				ДокОбъект.Комментарий = НовТекст;
				
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				
				
				// сформируем запись в регистре  "РеестрЗаменыНоменклатуры" - отметим что на что поменяли
				
				
				МенеджерЗаписей = РегистрыСведений.РеестрЗаменНоменклатуры.СоздатьМенеджерЗаписи();
				МенеджерЗаписей.Регистратор = ДокументИсточник;
				МенеджерЗаписей.Период = Текущаядата();
				МенеджерЗаписей.Автор = Автор;
				МенеджерЗаписей.ДокументРегистратор = ДокументИсточник;
				МенеджерЗаписей.ДокументЗамены = ЗаказНаПеремещение;
				МенеджерЗаписей.НоменклатураНов =  НоменклатураНов;
				МенеджерЗаписей.НоменклатураСтар =  НоменклатураСтар;
				МенеджерЗаписей.ХарактеристикаНов = ХарактеристикаНов; 
				МенеджерЗаписей.ХарактеристикаСтар  = ХарактеристикаСтар;
				МенеджерЗаписей.Записать(Истина);
				
			КонецЦикла;
		КонецЕсли;	
		
		Возврат Истина;
		
		
	Исключение
		Сообщить("Выполнение замнены не удалось");
		Возврат Ложь;
		
	КонецПопытки;	
		
	КонецЕсли;	
КонецФункции

Функция НайтиЦенуНаДату(Номенклатура, Характеристика, ВидЦены, Дата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Упаковка.Числитель, 0) > 0
	|			ТОГДА ЦеныНоменклатурыСрезПоследних.Цена * ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Упаковка.Знаменатель, 0) / ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Упаковка.Числитель, 0)
	|		ИНАЧЕ ЦеныНоменклатурыСрезПоследних.Цена
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ТекДата, ) КАК ЦеныНоменклатурыСрезПоследних
	|ГДЕ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура = &Номенклатура
	|	И ЦеныНоменклатурыСрезПоследних.Характеристика = &Характеристика
	|	И ЦеныНоменклатурыСрезПоследних.ВидЦены = &ВидЦены";
	
	Запрос.УстановитьПараметр("ТекДата", Дата);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Цена = Выборка.Цена;
	Иначе
		Цена = 0;
	КонецЕсли;
	
	Возврат Цена;	
	
КонецФункции	

Функция ЗначениеСтавкиНДС(СтавкаНДС)
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20
		Тогда С = 0.2
	ИначеЕсли  СтавкаНДС = Перечисления.СтавкиНДС.НДС14
		Тогда С = 0.14
	ИначеЕсли  СтавкаНДС = Перечисления.СтавкиНДС.НДС7
		Тогда С = 0.07
	ИначеЕсли  СтавкаНДС = Перечисления.СтавкиНДС.НДС0
		Тогда С = 0
	ИначеЕсли  СтавкаНДС = Перечисления.СтавкиНДС.БезНДС
		Тогда С = 0	
    ИначеЕсли  СтавкаНДС = Перечисления.СтавкиНДС.НеНДС
		Тогда С = 0
	КонецЕсли;
	Возврат С	
	
КонецФункции

Функция СформироватьРеализацию(П) экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	
	М = новый Массив;
	ЗаказКлиента = Неопределено;
	Номенклатура = Неопределено;
	Характеристика = Неопределено;
	Отгружаем =  Неопределено;
	М = Неопределено;
	П.Свойство("ЗаказКлиента", ЗаказКлиента); 
	П.Свойство("М", М);
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура", новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Характеристика", новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗ.Колонки.Добавить("Упаковка", новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТЗ.Колонки.Добавить("Отгружаем", новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("ОстатокОтгрузки", новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("НомерСтроки", новый ОписаниеТипов("Число"));
	
	
	Для Инд = 0 по М.Количество() - 1 цикл;
		НовСтр = ТЗ.Добавить();
		С = М[Инд];
		С.Свойство("Номенклатура", НовСтр.Номенклатура);
		С.Свойство("Характеристика", НовСтр.Характеристика);
		С.Свойство("Отгружаем", НовСтр.Отгружаем);
		С.Свойство("Упаковка", НовСтр.Упаковка);
		НовСтр.ОстатокОтгрузки = НовСтр.Отгружаем;
		НовСтр.НомерСтроки = Инд + 1;
	КонецЦикла;
	
	Реализация = документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Реализация.Менеджер = ПараметрыСеанса.АвторизованныйПользователь; 
	Реализация.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();     
	Реализация.Валюта = ЗаказКлиента.Валюта;
	Реализация.ВалютаВзаиморасчетов = ЗаказКлиента.Валюта;
    Реализация.РеализацияПоЗаказам = Истина;
	Реализация.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
	Реализация.ЗаказКлиента = ЗаказКлиента;
	Реализация.Склад = ЗаказКлиента.Склад;  
	Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Реализация.Партнер = ЗаказКлиента.Партнер;                   
	Реализация.КартаЛояльности = ЗаказКлиента.КартаЛояльности;
	Реализация.Контрагент = ?(ЗаказКлиента.КартаЛояльности.Контрагент = Справочники.Контрагенты.ПустаяСсылка(), бит_сервер.НайтиКонтрагента(ЗаказКлиента.Партнер),ЗаказКлиента.КартаЛояльности.Контрагент);
	Реализация.Подразделение = ЗаказКлиента.Подразделение;
	Реализация.Касса = ЗаказКлиента.Касса;      
	Реализация.Валюта = ЗаказКлиента.Валюта;
	//	Реализация.БанковскийСчет = ЗаказКлиента.БанковскийСчет;
	Реализация.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным;
	Реализация.Дата = ТекущаяДата();
	//	Реализация.ДатаОтгрузки = бит_сервер.ДатаОтгрузки(ЗаказКлиента);
	Реализация.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	Реализация.Выполнено = Истина;
	
	// +y.surai IBS 2026.08.26
	Реализация.Лікар = ЗаказКлиента.Врач;
	Реализация.СтроннійЛікар = ЗаказКлиента.ibs_ПостороннийВрач;      
	Реализация.Майстер = ЗаказКлиента.ibs_Мастер;
	// -y.surai IBS 2026.08.26
	
	ДокументЗаказ = ЗаказКлиента.ПолучитьОбъект();
	//  Установим Статус отгрузки по товарам к отгрузке
	СуммаДокумента = 0;
	
    // вычислим ссылку на назначение
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Назначения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Назначения КАК Назначения
		|ГДЕ
		|	Назначения.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", ЗаказКлиента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Назначение = Выборка.Ссылка;
	Иначе
		Назначение = неопределено;
	КонецЕсли;

	Если ТЗ.Количество() > 0
		Тогда
		Для каждого Стр из ДокументЗаказ.Товары Цикл
			Если Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить
				ИЛИ Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно 
				ИЛИ Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется Тогда
				
				Если (Не Стр.Упаковка.Числитель = 1 
					ИЛИ НЕ Стр.Упаковка.Знаменатель = 1   )
					И  Стр.Упаковка.Числитель > 0
					
					ТОгда
					Множитель = Стр.Упаковка.Знаменатель /Стр.Упаковка.Числитель;					
				Иначе	
					Множитель = 1;
				КонецЕсли;
				
				// найдем сколько надо отгрузить по данной номенклатуре
				НадоОтгрузить = 0;
				СтрТаблицы = неопределено;
				Для каждого СтрТаблицы из ТЗ цикл
					Если Стр.Номенклатура = СтрТаблицы.Номенклатура И Стр.Характеристика = СтрТаблицы.Характеристика Тогда
						НадоОтгрузить = СтрТаблицы.ОстатокОтгрузки; 
						НомерСтрТаблицы =  ТЗ.Индекс(СтрТаблицы);
						Продолжить;
					КонецЕсли;
				КонецЦикла;
				
				Если Стр.КоличествоУпаковок <= НадоОтгрузить
					И
					НадоОтгрузить  > 0
					Тогда
					
					ИсхОбесп = Стр.ВариантОбеспечения;				
					СтрокаРеализации = Реализация.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРеализации, Стр);
					СтрокаРеализации.ЗаказКлиента = ДокументЗаказ;
					//СтрокаРеализации.КодСтроки = Стр.НомерСтроки;
					//СтрокаРеализации.КлючСвязи = Стр.НомерСтроки;
					
					Если ИсхОбесп = Перечисления.ВариантыОбеспечения.Обособленно Тогда
						Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно;
						СтрокаРеализации.Назначение = Назначение;
					Иначе
						Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;	
					КонецЕсли;
					
					СуммаДокумента = СуммаДокумента + Стр.Сумма;
					// запишем что еще надо отгрузить
					ТЗ[Число(НомерСтрТаблицы)].ОстатокОтгрузки = НадоОтгрузить - Стр.КоличествоУпаковок;
					
				ИначеЕсли Стр.КоличествоУпаковок > НадоОтгрузить И НадоОтгрузить  > 0 Тогда
					Дельта = Стр.КоличествоУпаковок - НадоОтгрузить;
					// создадим новую строку на остаток
					СтрокаЗаказа = ДокументЗаказ.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаЗаказа, Стр);
					СтрокаЗаказа.Количество =  Дельта * Множитель;
					СтрокаЗаказа.КоличествоУпаковок = Дельта;
					СтрокаЗаказа.Сумма = Дельта * СтрокаЗаказа.Цена;
					СтрокаЗаказа.СуммаСНДС = Дельта * СтрокаЗаказа.Цена;
					// в исходнгой строке изменим количество
					Стр.Количество =  НадоОтгрузить * Множитель;
					Стр.КоличествоУпаковок = НадоОтгрузить;
					Стр.Сумма = НадоОтгрузить * СтрокаЗаказа.Цена;
					Стр.СуммаСНДС = НадоОтгрузить * СтрокаЗаказа.Цена;
					ИсхОбесп = Стр.ВариантОбеспечения; 
					//Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно;
					СтрокаРеализации = Реализация.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРеализации, Стр);
					СтрокаРеализации.ЗаказКлиента = ДокументЗаказ;
					//СтрокаРеализации.КодСтроки = Стр.НомерСтроки;
					//СтрокаРеализации.КлючСвязи = Стр.НомерСтроки;
					
					Если ИсхОбесп = Перечисления.ВариантыОбеспечения.Обособленно Тогда
						Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно;
						СтрокаРеализации.Назначение = Назначение;
					Иначе
						Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;	
					КонецЕсли;
					
					СтрокаРеализации.Назначение = Назначение;
					
					СуммаДокумента = СуммаДокумента + Стр.Сумма;
					// запишем что еще надо отгрузить
					ТЗ[Число(НомерСтрТаблицы)].ОстатокОтгрузки = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
		// проведем Закакз	
		Попытка
			ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
			Реализация.СуммаДокумента = СуммаДокумента;
			Реализация.СуммаВзаиморасчетов = СуммаДокумента;
           	Реализация.Записать(РежимЗаписиДокумента.Проведение);
			ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокументЗаказ.Записать(РежимЗаписиДокумента.Запись);
			Реализация.СуммаДокумента = СуммаДокумента;
			Реализация.СуммаВзаиморасчетов = СуммаДокумента;
			Реализация.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
		Возврат Реализация.Ссылка;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция СформироватьЗаказНаПеремещениеПодОбеспечение(ПП) Экспорт
	
    
	КоличествоПоставщик 	= неопределено;	
	ЗаказКлиента 			= неопределено;	
	Номенклатура 			= неопределено;	
	Характеристика			= неопределено;	
	Количество     			= неопределено;
	Склад					= Неопределено;
	Автор					= неопределено; 
	ЗаказПоставщику         = неопределено; 
	КоличествоВсего			= неопределено;
	
	М = Новый Массив;
	
	ПП.Свойство("М", М);
	ПП.Свойство("КоличествоПоставщик", КоличествоПоставщик);
	ПП.Свойство("ЗаказКлиента", ЗаказКлиента);
	ПП.Свойство("Номенклатура", Номенклатура);
	ПП.Свойство("Характеристика", Характеристика);
	ПП.Свойство("Склад", Склад); 
	ПП.Свойство("Поставщику", ЗаказПоставщику);
	ПП.Свойство("КоличествоВсего", КоличествоВсего);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Назначения.Ссылка КАК Назначение
	|ИЗ
	|	Справочник.Назначения КАК Назначения
	|ГДЕ
	|	Назначения.Заказ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЗаказКлиента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Назначение = Выборка.Назначение;
		
		Если М.Количество() > 0 Тогда
			
			Для Инд = 0 по М.Количество() - 1 цикл
				
				СкладОтправитель = Неопределено;
				Количество = Неопределено;
				
				П = неопределено;
				П = М[Инд];
				П.Свойство("Склад", СкладОтправитель);
				П.Свойство("Количество", Количество);
				
				Автор = ПараметрыСеанса.ТекущийПользователь;	
				НовДок = Документы.ЗаказНаПеремещение.СоздатьДокумент();
				НовДок.Дата = ТекущаяДата();
				НовДок.ДокументОснование = ЗаказКлиента;
				Текст = "Створено " + формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " обробкою формування замовлень на переміщення користувачем " + Строка(Автор);
				НовДок.Комментарий = Текст;
				НовДОк.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
				НовДок.СкладОтправитель = СкладОтправитель;
				НовДок.СкладПолучатель = Склад;
				НовДок.Статус = Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
				НовДок.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
				НовДок.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
				НовДок.Ответственный = Автор;
				
				
				НовСтр = НовДок.Товары.Добавить();
				НовСтр.Номенклатура = Номенклатура; 
				НовСтр.Упаковка = Номенклатура.ЕдиницаИзмерения;
				НовСтр.Характеристика = Характеристика;
				НовСтр.Количество = Количество;
				НовСтр.КоличествоУпаковок = Количество;
				НовСтр.Назначение = Назначение;
				НовСтр.НачалоОтгрузки = КонецДня(ТекущаяДата())+ 1;
				НовСтр.ОкончаниеПоступления = КонецДня(ТекущаяДата())+ 1;
				НовСтр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
				
				НовДок.Записать(РежимЗаписиДокумента.Проведение);
				
				Текст = "Сформовано замовлення на переміщення " + Строка(НовДок);
				Сообщить(Текст);
				
			КонецЦикла;
			
		ИначеЕсли
			ЗаказПоставщику = Истина и
			КоличествоПоставщик > 0 
			Тогда
			СкладОтправитель = Неопределено;
			
			ВсеПлохо = Ложь;
			Если НЕ Номенклатура.СхемаОбеспечения = Справочники.СхемыОбеспечения.ПустаяСсылка()
				Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СхемыОбеспечения.СпособОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей.Ссылка КАК СкладОтправитель
				|ИЗ
				|	РегистрСведений.СхемыОбеспечения КАК СхемыОбеспечения
				|ГДЕ
				|	СхемыОбеспечения.Склад = &СкладПолучатель
				|	И СхемыОбеспечения.СхемаОбеспечения = &СхемаОбеспечения
				|	И СхемыОбеспечения.СпособОбеспеченияПотребностей.ТипОбеспечения = &ТипОбеспечения";
				
				Запрос.УстановитьПараметр("СкладПолучатель", Склад);
				Запрос.УстановитьПараметр("СхемаОбеспечения", Номенклатура.СхемаОбеспечения);
				Запрос.УстановитьПараметр("ТипОбеспечения", Перечисления.ТипыОбеспечения.Перемещение);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() ТОгда
					СкладОтправитель = Выборка.СкладОтправитель;
				Иначе
					СкладОтправитель = Неопределено;
               	КонецЕсли;
			КонецЕсли;
			
			Если СкладОтправитель = Неопределено
				Тогда
				Сообщить("Для обраної номенклатури не визначена схема забезпечення за замовчанням. Автоматичне формування замовлення на перміщення неможливо");
				Возврат Ложь;
			КонецЕсли;
				
	        Если НЕ СкладОтправитель = Неопределено
                Тогда
				
			Количество = КоличествоПоставщик;
			
			Автор = ПараметрыСеанса.ТекущийПользователь;	
			НовДок = Документы.ЗаказНаПеремещение.СоздатьДокумент();
			НовДок.Дата = ТекущаяДата();
			НовДок.ДокументОснование = ЗаказКлиента;
			Текст = "Створено " + формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " обробкою формування замовлень на переміщення користувачем " + Строка(Автор);
			НовДок.Комментарий = Текст;
			НовДОк.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
			НовДок.СкладОтправитель = СкладОтправитель;
			НовДок.СкладПолучатель = Склад;
			НовДок.Статус = Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
			НовДок.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
			НовДок.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
			НовДок.Ответственный = Автор;
			
			
			НовСтр = НовДок.Товары.Добавить();
			НовСтр.Номенклатура = Номенклатура; 
			НовСтр.Упаковка = Номенклатура.ЕдиницаИзмерения;
			НовСтр.Характеристика = Характеристика;
			НовСтр.Количество = Количество;
			НовСтр.КоличествоУпаковок = Количество;
			НовСтр.Назначение = Назначение;
			НовСтр.НачалоОтгрузки = КонецДня(ТекущаяДата())+ 1;
			НовСтр.ОкончаниеПоступления = КонецДня(ТекущаяДата())+ 1;
			НовСтр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно;
			
			НовДок.Записать(РежимЗаписиДокумента.Проведение);
			
			Текст = "Сформовано замовлення на переміщення " + Строка(НовДок);
			Сообщить(Текст);
			КонецЕсли;
		КонецЕсли; 
		
	Иначе
		Сообщить("Для цього замовлення клієнта не сформовано запис у довіднику `Призначення`");
		
	КонецЕсли; 
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьНеобходимостьОформленияОбеспечения(Магазин) Экспорт

		
	Запрос = новый Запрос (
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыКлиентовГруппировка.Номенклатура,
	|	ЗаказыКлиентовГруппировка.Характеристика,
	|	СУММА(ЗаказыКлиентовГруппировка.Потребность) КАК Потребность,
	|	ЗаказыКлиентовГруппировка.ЗаказКлиента,
	|	ЗаказыКлиентовГруппировка.Заказчик,
	|	ЗаказыКлиентовГруппировка.Склад,
	|	СУММА(ГотовыеЗаказы.Заказано) КАК Заказано,
	|	СУММА(ЕСТЬNULL(ЗаказыКлиентовГруппировка.Потребность, 0) - ЕСТЬNULL(ГотовыеЗаказы.Заказано, 0)) КАК Необходимо,
	|	ЗаказыКлиентовГруппировка.ВариантОбеспечения
	|ПОМЕСТИТЬ вт_РеестрЗаказов
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|		ЗаказКлиентаТовары.Характеристика КАК Характеристика,
	|		СУММА(ЗаказКлиентаТовары.КоличествоУпаковок) КАК Потребность,
	|		ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	|		ЗаказКлиентаТовары.Ссылка.Партнер КАК Заказчик,
	|		ЗаказКлиентаТовары.Ссылка.Склад КАК Склад,
	|		ЗаказКлиентаТовары.ВариантОбеспечения КАК ВариантОбеспечения
	|	ИЗ
	|		Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|	ГДЕ
	|		ЗаказКлиентаТовары.Ссылка.Проведен
	|		И ЗаказКлиентаТовары.Ссылка.Склад = &Склад
	|		И ЗаказКлиентаТовары.Ссылка.Статус В(&Статус)
	|		И НЕ ЗаказКлиентаТовары.Отменено
	|		И ЗаказКлиентаТовары.ВариантОбеспечения = &ВариантыОбеспечения
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЗаказКлиентаТовары.Ссылка,
	|		ЗаказКлиентаТовары.Номенклатура,
	|		ЗаказКлиентаТовары.Характеристика,
	|		ЗаказКлиентаТовары.Ссылка.Партнер,
	|		ЗаказКлиентаТовары.Ссылка.Склад,
	|		ЗаказКлиентаТовары.ВариантОбеспечения) КАК ЗаказыКлиентовГруппировка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ГотовыеЗаказы.Номенклатура КАК Номенклатура,
	|			ГотовыеЗаказы.Характеристика КАК Характеристика,
	|			СУММА(ГотовыеЗаказы.Заказано) КАК Заказано,
	|			ГотовыеЗаказы.ЗаказКлиента КАК ЗаказКлиента,
	|			ГотовыеЗаказы.РегистраторСкладПолучатель КАК РегистраторСкладПолучатель
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
	|				ЗаказНаПеремещениеТовары.Характеристика КАК Характеристика,
	|				ЗаказНаПеремещениеТовары.КоличествоУпаковок КАК Заказано,
	|				ЗаказНаПеремещениеТовары.Назначение.Заказ.Ссылка КАК ЗаказКлиента,
	|				ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель КАК РегистраторСкладПолучатель
	|			ИЗ
	|				Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
	|			ГДЕ
	|				ЗаказНаПеремещениеТовары.Ссылка.Проведен
	|				И НЕ ЗаказНаПеремещениеТовары.Отменено) КАК ГотовыеЗаказы
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ГотовыеЗаказы.Характеристика,
	|			ГотовыеЗаказы.ЗаказКлиента,
	|			ГотовыеЗаказы.РегистраторСкладПолучатель,
	|			ГотовыеЗаказы.Номенклатура) КАК ГотовыеЗаказы
	|		ПО ЗаказыКлиентовГруппировка.Номенклатура = ГотовыеЗаказы.Номенклатура
	|			И ЗаказыКлиентовГруппировка.Характеристика = ГотовыеЗаказы.Характеристика
	|			И ЗаказыКлиентовГруппировка.ЗаказКлиента = ГотовыеЗаказы.ЗаказКлиента
	|			И ЗаказыКлиентовГруппировка.Склад = ГотовыеЗаказы.РегистраторСкладПолучатель
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыКлиентовГруппировка.Характеристика,
	|	ЗаказыКлиентовГруппировка.Номенклатура,
	|	ЗаказыКлиентовГруппировка.ЗаказКлиента,
	|	ЗаказыКлиентовГруппировка.Заказчик,
	|	ЗаказыКлиентовГруппировка.Склад,
	|	ЗаказыКлиентовГруппировка.ВариантОбеспечения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ЕСТЬNULL(вт_РеестрЗаказов.Необходимо, 0)) КАК КоличествоПотребность
	|ИЗ
	|	вт_РеестрЗаказов КАК вт_РеестрЗаказов
	|ГДЕ
	|	вт_РеестрЗаказов.Необходимо > 0");
	
	Запрос.УстановитьПараметр("Склад", Магазин);
	
	МС = новый Массив;
	МС.Добавить(Перечисления.СтатусыЗаказовКлиентов.КОбеспечению);
	МС.Добавить(Перечисления.СтатусыЗаказовКлиентов.КОтгрузке);
	Запрос.УстановитьПараметр("Статус", МС);
	
//	М = Новый Массив;
//	М.Добавить(Перечисления.ВариантыОбеспечения.Обособленно);
//	М.Добавить(Перечисления.ВариантыОбеспечения.Требуется);
//	М.Добавить(Перечисления.ВариантыОбеспечения.ИзЗаказов);
//	Запрос.УстановитьПараметр("ВариантыОбеспечения", М);
	Запрос.УстановитьПараметр("ВариантыОбеспечения", Перечисления.ВариантыОбеспечения.Обособленно);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Нужно = Выборка.КоличествоПотребность;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Нужно)
		Тогда
		Нужно = 0
	КонецЕсли;
		
	Возврат Нужно
	
КонецФункции	

Функция СоздатьЗаказНаПеремещениеПодОбеспечение(ПП) Экспорт // Боков
	
	ЗаказКлиента 			= неопределено;	
	Склад					= Неопределено;
	Автор					= неопределено; 
	М 						= Неопределено;
	ПП.Свойство("М", М);
	ПП.Свойство("ЗаказКлиента", ЗаказКлиента);
	ПП.Свойство("Склад", Склад); 
	ПП.Свойство("Автор", Автор);
	
	
	// Найдем назначение
	ЗапросН = Новый Запрос;
	ЗапросН.Текст = 
	"ВЫБРАТЬ
	|	Назначения.Ссылка КАК Назначение
	|ИЗ
	|	Справочник.Назначения КАК Назначения
	|ГДЕ
	|	Назначения.Заказ = &СсылкаЗаказКлиента";
	ЗапросН.УстановитьПараметр("СсылкаЗаказКлиента", ЗаказКлиента.Ссылка);
	ВыборкаН = ЗапросН.Выполнить().Выбрать();
	Если ВыборкаН.Следующий() Тогда
		Назначение = ВыборкаН.Назначение;
	Иначе
		Сообщить("Помилка формування переміщення: для вказаного Замовлення клаєнта не визначено Значення доваіднику /Призначення/");
		Возврат Ложь
	КонецЕсли;
	
	// сформируем ТЗв Складов-источников обеспечения.
	// Перегоним данные массива в ТЗ
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Характеристика",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Инд = 0 по М.Количество()-1 цикл
		НовСтр = ТЗ.Добавить();
		П = М[Инд];
		Номенклатура 			= неопределено;	
		Характеристика			= неопределено;	
		Количество     			= неопределено;
		П.Свойство("Номенклатура", НовСтр.Номенклатура);
		П.Свойство("Характеристика", НовСтр.Характеристика);
		П.Свойство("Количество", НовСтр.Количество);
	КонецЦикла;	
	
	// Найдем схемы обеспечения и сгруппируем их 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Номенклатура,
	|	ТЗ.Характеристика,
	|	ТЗ.Количество
	|ПОМЕСТИТЬ вт_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	вт_ТЗ.Количество,
	|	ПодборСкладаОтправителя.СкладОтправитель
	|ПОМЕСТИТЬ вт_СхемаОбеспечения
	|ИЗ
	|	вт_ТЗ КАК вт_ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Номенклатура.Ссылка КАК Номенклатура,
	|			ВложенныйЗапрос.СкладОтправитель КАК СкладОтправитель
	|		ИЗ
	|			Справочник.Номенклатура КАК Номенклатура
	|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					СхемыОбеспечения.СпособОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей КАК СкладОтправитель,
	|					СхемыОбеспечения.СхемаОбеспечения КАК СхемаОбеспечения
	|				ИЗ
	|					РегистрСведений.СхемыОбеспечения КАК СхемыОбеспечения
	|				ГДЕ
	|					СхемыОбеспечения.Склад = &Склад) КАК ВложенныйЗапрос
	|				ПО Номенклатура.СхемаОбеспечения = ВложенныйЗапрос.СхемаОбеспечения) КАК ПодборСкладаОтправителя
	|		ПО вт_ТЗ.Номенклатура = ПодборСкладаОтправителя.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_СхемаОбеспечения.СкладОтправитель
	|ИЗ
	|	вт_СхемаОбеспечения КАК вт_СхемаОбеспечения
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_СхемаОбеспечения.СкладОтправитель";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЕстьОшибкиФормирования = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.СкладОтправитель)
			ИЛИ Выборка.СкладОтправитель = Справочники.Склады.ПустаяСсылка()
			Тогда
			Сообщить("Помилка. Для обраної номенклатури не визначена Схема забезпечення!");
			Возврат Ложь
		Иначе
			
			
			// создаем документ
			НовДок = Документы.ЗаказНаПеремещение.СоздатьДокумент();
			НовДок.Дата = ТекущаяДата();
			НовДок.ДокументОснование = ЗаказКлиента;
			Текст = "Створено " + формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " обробкою формування замовлень на переміщення користувачем " + Строка(Автор);
			НовДок.Комментарий = Текст;
			НовДОк.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
			НовДок.СкладОтправитель = Выборка.СкладОтправитель;
			НовДок.СкладПолучатель = Склад;
			НовДок.Статус = Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
			НовДок.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
			НовДок.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
			НовДок.Ответственный = Автор;
			
			// заполним ТЧ по выбранной сземе обеспечения
			ЗапросТЧ = Новый Запрос;
			ЗапросТЧ.Текст = 
			"ВЫБРАТЬ
			|	ТЗ.Номенклатура,
			|	ТЗ.Характеристика,
			|	ТЗ.Количество
			|ПОМЕСТИТЬ вт_ТЗ
			|ИЗ
			|	&ТЗ КАК ТЗ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	вт_ТЗ.Номенклатура,
			|	вт_ТЗ.Характеристика,
			|	вт_ТЗ.Количество,
			|	ПодборСкладаОтправителя.СкладОтправитель
			|ПОМЕСТИТЬ вт_СхемаОбеспечения
			|ИЗ
			|	вт_ТЗ КАК вт_ТЗ
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			Номенклатура.Ссылка КАК Номенклатура,
			|			ВложенныйЗапрос.СкладОтправитель КАК СкладОтправитель
			|		ИЗ
			|			Справочник.Номенклатура КАК Номенклатура
			|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|					СхемыОбеспечения.СпособОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей КАК СкладОтправитель,
			|					СхемыОбеспечения.СхемаОбеспечения КАК СхемаОбеспечения
			|				ИЗ
			|					РегистрСведений.СхемыОбеспечения КАК СхемыОбеспечения
			|				ГДЕ
			|					СхемыОбеспечения.Склад = &Склад) КАК ВложенныйЗапрос
			|				ПО Номенклатура.СхемаОбеспечения = ВложенныйЗапрос.СхемаОбеспечения) КАК ПодборСкладаОтправителя
			|		ПО вт_ТЗ.Номенклатура = ПодборСкладаОтправителя.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	вт_СхемаОбеспечения.Номенклатура,
			|	вт_СхемаОбеспечения.Характеристика,
			|	вт_СхемаОбеспечения.Количество
			|ИЗ
			|	вт_СхемаОбеспечения КАК вт_СхемаОбеспечения
			|ГДЕ
			|	вт_СхемаОбеспечения.СкладОтправитель = &СкладОтправитель";
			
			ЗапросТЧ.УстановитьПараметр("Склад", Склад);
			ЗапросТЧ.УстановитьПараметр("СкладОтправитель", Выборка.СкладОтправитель);
			ЗапросТЧ.УстановитьПараметр("ТЗ", ТЗ);
			ВыборкаТЧ = ЗапросТЧ.Выполнить().Выбрать();
			Пока ВыборкаТЧ.Следующий() Цикл
				
				НовСтр = НовДок.Товары.Добавить();
				НовСтр.Номенклатура = ВыборкаТЧ.Номенклатура; 
				НовСтр.Упаковка = ВыборкаТЧ.Номенклатура.ЕдиницаИзмерения;
				НовСтр.Характеристика = ВыборкаТЧ.Характеристика;
				НовСтр.Количество = ВыборкаТЧ.Количество;
				НовСтр.КоличествоУпаковок = ВыборкаТЧ.Количество;
				НовСтр.Назначение = Назначение;
				НовСтр.НачалоОтгрузки = КонецДня(ТекущаяДата())+ 1;
				НовСтр.ОкончаниеПоступления = КонецДня(ТекущаяДата())+ 1;
				НовСтр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно;
				
			КонецЦикла;
			
			Попытка			
				НовДок.Записать(РежимЗаписиДокумента.Проведение);
				Текст = "Сформовано замовлення на переміщення " + Строка(НовДок);
				Сообщить(Текст);
			Исключение
				Сообщить("Помилка! Замовлення на перемрміщення не сформовано");
				ЕстьОшибкиФормирования = Истина;
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;         
	
	Док = ЗаказКлиента.ПолучитьОбъект();
	
	Если 
		ЕстьОшибкиФормирования = Ложь
		Тогда
		Док.СформированоОбеспечение = Истина;
	Иначе
		Док.СформированоОбеспечение = Ложь;
	КонецЕсли;
	Док.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат Истина;
	   
КонецФункции

Функция СоздатьЗаказНаПеремещениеПодОбеспечениеПодПараметры(ПП) Экспорт// Боков
	
	ЗаказКлиента 			= неопределено;	
	Склад					= Неопределено;
	Автор					= неопределено; 
	М 						= Неопределено;
	ПП.Свойство("М", М);
	ПП.Свойство("ЗаказКлиента", ЗаказКлиента);
	ПП.Свойство("Склад", Склад); 
	ПП.Свойство("Автор", Автор);
	
	ЕстьОшибкиПроведения = Ложь; //
	Мсозданных = Новый Массив;   // Запишем документы, созданные обработкой.
	
	// Найдем назначение
	ЗапросН = Новый Запрос;
	ЗапросН.Текст = 
	"ВЫБРАТЬ
	|	Назначения.Ссылка КАК Назначение
	|ИЗ
	|	Справочник.Назначения КАК Назначения
	|ГДЕ
	|	Назначения.Заказ = &СсылкаЗаказКлиента";
	ЗапросН.УстановитьПараметр("СсылкаЗаказКлиента", ЗаказКлиента.Ссылка);
	ВыборкаН = ЗапросН.Выполнить().Выбрать();
	Если ВыборкаН.Следующий() Тогда
		Назначение = ВыборкаН.Назначение;
	Иначе
		Сообщить("Помилка формування переміщення: для вказаного Замовлення клаєнта не визначено Значення довіднику /Призначення/");
		Возврат Ложь
	КонецЕсли;
	
	// сформируем ТЗв Складов-источников обеспечения.
	// Перегоним данные массива в ТЗ
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Характеристика",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число")); 	
	ТЗ.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения")); 
	ТЗ.Колонки.Добавить("ВариантИсточникаОбеспечения",Новый ОписаниеТипов("СправочникСсылка.ВариантыИсточниковОбеспечения"));
	
	Для Инд = 0 по М.Количество()-1 цикл
		НовСтр = ТЗ.Добавить();
		П = М[Инд];
		Номенклатура 					= неопределено;	
		Характеристика					= неопределено;	
		Количество     					= неопределено;
		ВариантИсточникаОбеспечения 	= неопределено;
		П.Свойство("Номенклатура", НовСтр.Номенклатура);
		П.Свойство("Характеристика", НовСтр.Характеристика);
		П.Свойство("Количество", НовСтр.Количество); 
		П.Свойство("КоличествоУпаковок", НовСтр.КоличествоУпаковок);
		П.Свойство("Упаковка", НовСтр.Упаковка); 
		П.Свойство("ВариантИсточникаОбеспечения", НовСтр.ВариантИсточникаОбеспечения) 
	КонецЦикла;	
		
	// Найдем схемы обеспечения и сгруппируем их 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Номенклатура,
	|	ТЗ.Характеристика,
	|	ТЗ.Количество,
	|	ТЗ.ВариантИсточникаОбеспечения,
	|	ТЗ.КоличествоУпаковок,
	|	ТЗ.Упаковка
	|ПОМЕСТИТЬ вт_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗ.Номенклатура,
	|	вт_ТЗ.Характеристика,
	|	вт_ТЗ.Количество,
	|	ВЫБОР
	|		КОГДА НЕ вт_ТЗ.ВариантИсточникаОбеспечения = ЗНАЧЕНИЕ(Справочник.ВариантыИсточниковОбеспечения.ПодЗаказ)
	|				И НЕ ПодборСкладаОтправителя.СкладИсточник ЕСТЬ NULL
	|				И НЕ ПодборСкладаОтправителя.СкладИсточник = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|			ТОГДА ПодборСкладаОтправителя.СкладИсточник
	|		КОГДА НЕ ПодборСкладаПоХарактеристике.ИсточникОбеспечения ЕСТЬ NULL
	|				И НЕ ПодборСкладаПоХарактеристике.ИсточникОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)
	|			ТОГДА ПодборСкладаПоХарактеристике.ИсточникОбеспечения
	|		КОГДА НЕ ПодборСкладаПоСхемамОбеспечения.ИсточникОбеспечения ЕСТЬ NULL
	|				И НЕ ПодборСкладаПоСхемамОбеспечения.ИсточникОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)
	|			ТОГДА ПодборСкладаПоСхемамОбеспечения.ИсточникОбеспечения
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|	КОНЕЦ КАК СкладИсточник,
	|	вт_ТЗ.ВариантИсточникаОбеспечения,
	|	вт_ТЗ.КоличествоУпаковок,
	|	вт_ТЗ.Упаковка
	|ПОМЕСТИТЬ вт_СхемаОбеспечения
	|ИЗ
	|	вт_ТЗ КАК вт_ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВариантыИсточниковОбеспечения.Ссылка КАК ВариантИсточникаОбеспечения,
	|			ВариантыИсточниковОбеспечения.СкладИсточник КАК СкладИсточник
	|		ИЗ
	|			Справочник.ВариантыИсточниковОбеспечения КАК ВариантыИсточниковОбеспечения) КАК ПодборСкладаОтправителя
	|		ПО вт_ТЗ.ВариантИсточникаОбеспечения = ПодборСкладаОтправителя.ВариантИсточникаОбеспечения
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СхемыОбеспечения.СпособОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей.Ссылка КАК ИсточникОбеспечения,
	|			ВложенныйЗапрос.Номенклатура КАК Номенклатура
	|		ИЗ
	|			(ВЫБРАТЬ
	|				Номенклатура.Ссылка КАК Номенклатура,
	|				ВЫБОР
	|					КОГДА Номенклатура.СхемаОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)
	|						ТОГДА Номенклатура.ВидНоменклатуры.СхемаОбеспечения
	|					ИНАЧЕ Номенклатура.СхемаОбеспечения
	|				КОНЕЦ КАК ВозможнаяСхемаОбеспечения,
	|				Номенклатура.СхемаОбеспечения КАК СхемаОбеспечения,
	|				Номенклатура.ВидНоменклатуры.СхемаОбеспечения КАК ВидНоменклатурыСхемаОбеспечения
	|			ИЗ
	|				Справочник.Номенклатура КАК Номенклатура) КАК ВложенныйЗапрос
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СхемыОбеспечения КАК СхемыОбеспечения
	|				ПО ВложенныйЗапрос.ВозможнаяСхемаОбеспечения = СхемыОбеспечения.СхемаОбеспечения
	|		ГДЕ
	|			СхемыОбеспечения.Склад = &Склад
	|			И НЕ ВложенныйЗапрос.ВозможнаяСхемаОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)) КАК ПодборСкладаПоСхемамОбеспечения
	|		ПО вт_ТЗ.Номенклатура = ПодборСкладаПоСхемамОбеспечения.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СхемыОбеспечения.СпособОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей.Ссылка КАК ИсточникОбеспечения,
	|			ВложенныйЗапрос.Характеристика КАК Характеристика
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ВЫБОР
	|					КОГДА ХарактеристикиНоменклатуры.СхемаОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)
	|							И ТИПЗНАЧЕНИЯ(ХарактеристикиНоменклатуры.Владелец) = ТИП(Справочник.НОменклатура)
	|						ТОГДА ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры.СхемаОбеспечения
	|					КОГДА ХарактеристикиНоменклатуры.СхемаОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)
	|							И ТИПЗНАЧЕНИЯ(ХарактеристикиНоменклатуры.Владелец) = ТИП(Справочник.ВидыНоменклатуры)
	|						ТОГДА ХарактеристикиНоменклатуры.Владелец.СхемаОбеспечения
	|				КОНЕЦ КАК ВозможнаяСхемаОбеспечения,
	|				ХарактеристикиНоменклатуры.СхемаОбеспечения КАК СхемаОбеспечения,
	|				ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
	|			ИЗ
	|				Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры) КАК ВложенныйЗапрос
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СхемыОбеспечения КАК СхемыОбеспечения
	|				ПО ВложенныйЗапрос.ВозможнаяСхемаОбеспечения = СхемыОбеспечения.СхемаОбеспечения
	|		ГДЕ
	|			СхемыОбеспечения.Склад = &Склад
	|			И НЕ ВложенныйЗапрос.ВозможнаяСхемаОбеспечения = ЗНАЧЕНИЕ(Справочник.СхемыОбеспечения.ПустаяСсылка)) КАК ПодборСкладаПоХарактеристике
	|		ПО вт_ТЗ.Характеристика = ПодборСкладаПоХарактеристике.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_СхемаОбеспечения.СкладИсточник КАК СкладОтправитель,
	|	вт_СхемаОбеспечения.Номенклатура,
	|	вт_СхемаОбеспечения.Характеристика,
	|	вт_СхемаОбеспечения.Количество,
	|	вт_СхемаОбеспечения.ВариантИсточникаОбеспечения,
	|	вт_СхемаОбеспечения.КоличествоУпаковок,
	|	вт_СхемаОбеспечения.Упаковка
	|ИЗ
	|	вт_СхемаОбеспечения КАК вт_СхемаОбеспечения
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_СхемаОбеспечения.СкладИсточник,
	|	вт_СхемаОбеспечения.Номенклатура,
	|	вт_СхемаОбеспечения.Характеристика,
	|	вт_СхемаОбеспечения.Количество,
	|	вт_СхемаОбеспечения.ВариантИсточникаОбеспечения,
	|	вт_СхемаОбеспечения.КоличествоУпаковок,
	|	вт_СхемаОбеспечения.Упаковка
	|ИТОГИ ПО
	|	СкладОтправитель";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
//	Запрос.УстановитьПараметр("ИспользованиеХарактеристик", 
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"СкладОтправитель");
	
//    ТЗтест = новый ТаблицаЗначений;
//	ТЗтест = Запрос.Выполнить().Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		
		Если НЕ ЗначениеЗаполнено(Выборка.СкладОтправитель)
			ИЛИ Выборка.СкладОтправитель = Справочники.Склады.ПустаяСсылка()
			Тогда
			// попробуем вычислать схему обеспечения
			Сообщить("Помилка. Для обраного набору номенклатури є позиції, за якими не визначена Схема забезпечення!");
			ЕстьОшибкиПроведения = Истина;
			
		Иначе
			// создаем документ
			НовДок = Документы.ЗаказНаПеремещение.СоздатьДокумент();
			НовДок.Дата = ТекущаяДата();
			НовДок.ДокументОснование = ЗаказКлиента;
			Текст = "Створено " + формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " обробкою формування замовлень на переміщення користувачем " + Строка(Автор);
			НовДок.Комментарий = Текст;
			НовДОк.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
			НовДок.СкладОтправитель = Выборка.СкладОтправитель;
			НовДок.СкладПолучатель = Склад;
			НовДок.Статус = Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
			НовДок.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
			НовДок.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
			НовДок.Ответственный = Автор;
			
			// заполним ТЧ по выбранной сземе обеспечения
			
			ВыборкаТЧ = Выборка.Выбрать();
			Пока ВыборкаТЧ.Следующий() Цикл
				НовСтр = НовДок.Товары.Добавить();
				НовСтр.Номенклатура = ВыборкаТЧ.Номенклатура; 
				НовСтр.Упаковка = ВыборкаТЧ.Упаковка;
				НовСтр.Характеристика = ВыборкаТЧ.Характеристика;
				НовСтр.Количество = ВыборкаТЧ.Количество;
				НовСтр.КоличествоУпаковок = ВыборкаТЧ.КоличествоУпаковок;
				НовСтр.Назначение = Назначение;
				НовСтр.НачалоОтгрузки = КонецДня(ТекущаяДата())+ 1;
				НовСтр.ОкончаниеПоступления = КонецДня(ТекущаяДата())+ 1;
				
				Если ВыборкаТЧ.ВариантИсточникаОбеспечения = Справочники.ВариантыИсточниковОбеспечения.ПодЗаказ
					Тогда
					НовСтр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно
				Иначе
					НовСтр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада
				КонецЕсли
				
			КонецЦикла;
			
			Попытка			
				НовДок.Записать(РежимЗаписиДокумента.Проведение);
				Текст = "Сформовано замовлення на переміщення " + Строка(НовДок);
				Мсозданных.Добавить(НовДок);
				Сообщить(Текст);
			Исключение
				Сообщить("Помилка! Замовлення на перемрміщення не сформовано");
				ЕстьОшибкиПроведения = Истина;
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;         
	
	// Проанализирует наличие ошибок
	
	Если ЕстьОшибкиПроведения И Мсозданных.Количество() > 0
		тогда
		Для Инд = 0 по Мсозданных.Количество() - 1 Цикл
			Док = М[Инд];
			ДокОбъект = Док.ПолучитьОбъект();
			Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			ДокОбъект.ПометкаУдаления = Истина;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			Сообщить("Документ " + Строка(док) + " видалено тому, що не було сформовано повний комплект документыв за замовленням");
			Исключение
			КонецПопытки;
			
		КонецЦикла;
	КонецЕсли;		
	
	Возврат НЕ ЕстьОшибкиПроведения;

КонецФункции	

Процедура СформироватьЗаписиИсторииСтатусов(ПП)  экспорт
	
	ДокументРегистратор 	= Неопределено;
	Статус 					= неопределено;
	ТекСтатус 				= Неопределено;
	СкладОтправитель        = Неопределено;
	М 						= неопределено;
	
	ПП.Свойство("ДокументРегистратор",ДокументРегистратор);
	ПП.Свойство("Статус",Статус);
	ПП.Свойство("ТекСтатус",ТекСтатус);
	ПП.Свойство("М",М);
	
	// проверим, было ли изменение статуса относительно прошлой записи  
	// Если статус меняется, то формируем записи по строкам, где есть назначение (т.е. там, где есть привязка к заказам клиента)
	ТекущаяДата = ТекущаяДата();
	Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИсторияСтатусовДокументовСрезПоследних.СтатусТ КАК СтатусТ
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовДокументов.СрезПоследних(&ТекДата, ДокументРегистратор = &ДокументРегистратор) КАК ИсторияСтатусовДокументовСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИсторияСтатусовДокументовСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументРегистратор", ДокументРегистратор);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если НЕ ТекСтатус = Выборка.СтатусТ
			Тогда
			   НадоЗаписать = Истина;
		   Иначе
			   НадоЗаписать = Ложь;
		КонецЕсли
	Иначе
		 НадоЗаписать = Истина;
	КонецЕсли;
	
	Если НадоЗаписать = Истина 
		Тогда
		
		НаборЗаписей = РегистрыСведений.ИсторияСтатусовДокументов.СоздатьНаборЗаписей(); 
		
		НаборЗаписей.Отбор.Период.Установить(ТекущаяДата); 
			
		
		Для Инд = 0 по М.КОличество()-1 Цикл
			Номенклатура       		= Неопределено;
			Характеристика     		= Неопределено;
			ОкончаниеПоступления  	= Неопределено;
			Количество            	= Неопределено;
			Назначение            	= Неопределено;

			П = М[Инд];
			П.Свойство("Номенклатура",Номенклатура);
            П.Свойство("Характеристика",Характеристика);
            П.Свойство("ОкончаниеПоступления",ОкончаниеПоступления);
            П.Свойство("Количество",Количество);
			П.Свойство("Назначение",Назначение);

			НовЗапись = НаборЗаписей.Добавить();
				НовЗапись.Период = ТекущаяДата;
				НовЗапись.Дата = ТекущаяДата();
				НовЗапись.ДокументРегистратор = ДокументРегистратор;
				НовЗапись.Статус = Статус; 
				НовЗапись.СтатусТ = ТекСтатус;
				НовЗапись.Назначение = Назначение;
				НовЗапись.Номенклатура = Номенклатура;
				НовЗапись.Характеристика = Характеристика;
				НовЗапись.ДатаПлан = ОкончаниеПоступления;
				НовЗапись.Автор = Ответственный;
				НовЗапись.Количество = Количество;
				НовЗапись.СкладНазначения = СкладОтправитель;
				НовЗапись.ЗаказКлиента = Назначение.Заказ;
			КонецЦикла; 
		НаборЗаписей.Записать(Истина);
		
	КонецЕсли;

	
	
	
	
	
	
	
КонецПроцедуры	

Функция ЗначениеПоказателя(П) экспорт
	
	Если ЗначениеЗаполнено(П) Тогда
		
		Показатель = неопределено;
		Дата = Неопределено;
		
		П.Свойство("Показатель",Показатель); 
		П.Свойство("Дата",Дата); 
				
		Если Дата = Неопределено
			Тогда Дата = ТекущаяДата();
		КонецЕсли;
		
		//Если ТипЗнч(Показатель) = Тип("Строка")
		//	Тогда
		//	
		//	ПоказательСсылка = Справочники.Показатели..НайтиПоНаименованию(Показатель);
		//КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗначенияПоказателейСрезПоследних.ЛюбаяС,
		|	ЗначенияПоказателейСрезПоследних.Число,
		|	ЗначенияПоказателейСрезПоследних.Буль,
		|	ЗначенияПоказателейСрезПоследних.Стр
		|ИЗ
		|	РегистрСведений.ЗначенияПоказателей.СрезПоследних(&ТекДата, Показатель.Наименование ПОДОБНО &Показатель) КАК ЗначенияПоказателейСрезПоследних";
		
		Запрос.УстановитьПараметр("Показатель", Показатель);
		Запрос.УстановитьПараметр("ТекДата", Дата);
		
		ТЗ = Новый ТаблицаЗначений;	
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Для каждого Кол из ТЗ.Колонки цикл
			Если Не Кол = неопределено
				Тогда
				Возврат Кол
			КонецЕсли;
		КонецЦикла; 
		
	КонецЕсли;
	
КонецФункции	

Функция СоздатьАвтореализациюИнтернетМагазин(Ссылка) Экспорт
	
	// Соберем таблицу аналогично модулю ручной подборки заказов	
	
	ДокЗаказа = Ссылка.ПолучитьОбъект();
	
	ТЗ = новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура", новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Характеристика", новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗ.Колонки.Добавить("Количество", новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("Подобрано", новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("Остаток", новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("Код", новый ОписаниеТипов("Число")); 
	
	ТЗрез = новый ТаблицаЗначений;
	ТЗрез.Колонки.Добавить("Номенклатура", новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗрез.Колонки.Добавить("Характеристика", новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗрез.Колонки.Добавить("Количество", новый ОписаниеТипов("Число"));
	ТЗрез.Колонки.Добавить("Цена", новый ОписаниеТипов("Число"));
	ТЗрез.Колонки.Добавить("Склад", новый ОписаниеТипов("СправочникСсылка.Склады"));
	
	Для каждого Стр из ДокЗаказа.Товары Цикл
		
		Если Стр.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар
			Тогда
			НовСтр = ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр); 
			НовСтр.Остаток = НовСтр.Количество;
		КонецЕсли;  
		
	КонецЦикла;
	НадоПовторить = Истина;
	Итерация = 0;
	
	Мрез = Новый Массив;
	
	Пока НадоПовторить = Истина цикл
		
		НадоПовторить = Ложь;
		
		ТЗ.Свернуть("Номенклатура, Характеристика","Количество, Остаток, Подобрано, Код");
		
		//Удалим нулевые строки.
		
		КолСтрок = ТЗ.Количество();
		Для Инд = 1 по КолСтрок цикл
			
			НомСтр = КолСтрок - ИНд;
			Если 
				ТЗ[НомСтр].Количество = 0
				Тогда
				Строка = ТЗ[НомСтр];
				ТЗ.Удалить(Строка);
			КонецЕсли;
		КонецЦикла;
		
		Код = 1;
		Для каждого Стр из ТЗ Цикл
			Стр.Код = Код; 
			Код = Код + 1;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Номенклатура,
		|	ТЗ.Характеристика,
		|	ТЗ.Остаток КАК Количество,
		|	ТЗ.Код
		|ПОМЕСТИТЬ вт_ТЗ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТЗ.Номенклатура,
		|	вт_ТЗ.Характеристика,
		|	СУММА(вт_ТЗ.Количество) КАК Количество,
		|	вт_ТЗ.Код КАК Код,
		|	ВложенныйЗапрос.ТипНоменклатуры
		|ПОМЕСТИТЬ вт_ТЗ2
		|ИЗ
		|	вт_ТЗ КАК вт_ТЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
		|			Номенклатура.Ссылка КАК Ссылка
		|		ИЗ
		|			Справочник.Номенклатура КАК Номенклатура) КАК ВложенныйЗапрос
		|		ПО вт_ТЗ.Номенклатура = ВложенныйЗапрос.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ТЗ.Номенклатура,
		|	вт_ТЗ.Характеристика,
		|	ВложенныйЗапрос.ТипНоменклатуры,
		|	вт_ТЗ.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТЗ2.Номенклатура,
		|	вт_ТЗ2.Характеристика,
		|	ВложенныйЗапрос.Склад,
		|	ВложенныйЗапрос.Остаток,
		|	вт_ТЗ2.Код,
		|	вт_ТЗ2.ТипНоменклатуры,
		|	ВложенныйЗапрос.Склад.ОчередьИспользования КАК СкладОчередьИспользования
		|ИЗ
		|	вт_ТЗ2 КАК вт_ТЗ2
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
		|			СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
		|			СвободныеОстаткиОстатки.Склад КАК Склад,
		|			СУММА(СвободныеОстаткиОстатки.ВНаличииОстаток - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0)) КАК Остаток
		|		ИЗ
		|			РегистрНакопления.СвободныеОстатки.Остатки(&ТекДата, ) КАК СвободныеОстаткиОстатки
		|		
		|		СГРУППИРОВАТЬ ПО
		|			СвободныеОстаткиОстатки.Номенклатура,
		|			СвободныеОстаткиОстатки.Характеристика,
		|			СвободныеОстаткиОстатки.Склад) КАК ВложенныйЗапрос
		|		ПО вт_ТЗ2.Номенклатура = ВложенныйЗапрос.Номенклатура
		|			И вт_ТЗ2.Характеристика = ВложенныйЗапрос.Характеристика
		|ГДЕ
		|	вт_ТЗ2.ТипНоменклатуры = &ТипНоменклатуры
		|
		|УПОРЯДОЧИТЬ ПО
		|	СкладОчередьИспользования";
		
		Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
		Запрос.УстановитьПараметр("ТЗ", ТЗ);   
		Запрос.УстановитьПараметр("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Товар);
		
		ТЗост = Новый ТаблицаЗначений;
		ТЗост = Запрос.Выполнить().Выгрузить();
		
		ТЗС = новый ТаблицаЗначений;
		
		ТЗС.Колонки.Добавить("Склад", новый ОписаниеТипов("СправочникСсылка.Склады")); 
		ТЗС.Колонки.Добавить("Рейтинг", новый ОписаниеТипов("Число"));
		
		Для каждого Стр из ТЗ цикл
			
			ТЗС.Колонки.Добавить(Строка("Ост_" + Строка(Стр.Код)), новый ОписаниеТипов("Число"));
			//	ТЗС.Колонки.Добавить(Строка("Нал_" + Строка(Стр.Код)), новый ОписаниеТипов("Булево"));
			//	ТЗС.Колонки.Добавить(Строка("Кол_" + Строка(Стр.Код)), новый ОписаниеТипов("Число"));
		КонецЦикла;
		
		Для каждого Стр из ТЗост цикл
			Если ЗначениеЗаполнено(Стр.Склад) и Стр.Остаток > 0 
				Тогда
				НовСтр = ТЗС.Добавить();	
				ИмяКолонки = Строка("Ост_" + Строка(Стр.Код)); 	
				НовСтр[ИмяКолонки] = Стр.Остаток;
				НовСтр.Склад = Стр.Склад;
			КонецЕсли;
			
		КонецЦикла;	
		
		// полученную "матрицу" проанализируем на предмет соотвествия остатка товара  на складе заказу
		// для чего по каждой строке вычислим сколько колонок соотвествуют потребности 
		
		
		Для каждого Стр из ТЗС цикл
			
			РейтингСклада = 0;
			
			Для каждого Колонка из ТЗС.Колонки цикл
				
				Если Лев(Колонка.Имя,4) = "Ост_" 
					Тогда
					// номер колонки
					Ном = число(СтрЗаменить(Колонка.Имя,"Ост_",""));
					// значение потребности  
					НужноТовара = ТЗ.НайтиСтроки(новый Структура("Код", Ном))[0].Остаток;
					ОстатокТовара = число(стр[Колонка.Имя]);
					Если ОстатокТовара >= НужноТовара
						Тогда  ИндОбесп = 1;
					ИначеЕсли 
						ОстатокТовара > 0
						И
						ОстатокТовара < НужноТовара
						Тогда 
						ИндОбесп =  ОстатокТовара / НужноТовара;
					Иначе
						ИндОбесп = 0;
					КонецЕсли;
					РейтингСклада = РейтингСклада  + ИндОбесп;
				КонецЕсли; 
				
			КонецЦикла;	
			
			Стр.Рейтинг = РейтингСклада;
		КонецЦикла;			
		
		
		// если фокус не удался и надо формировать сборный заказ, тогда.
		// Сначала выстраиваем магазины в рейтинге по количеству позиций в заказе из одной точки.
		
		ТЗС.Сортировать("Рейтинг убыв"); 
		
		// перенесем подбор строки 0 в заказ;
		
		Если ТЗС.Количество() > 0
			Тогда
			СтрокаРезульта = ТЗС[0];
		Иначе
			Продолжить
		КонецЕсли;
		
		// начнем собирать параметрі реализации
			
		
		ММ = Новый Массив;
		Для каждого Стр из ТЗ цикл
			Код = Стр.Код;
			ИскомаяКолонка = "Ост_" + строка(Код);
			Значение = ТЗС[0][ИскомаяКолонка];			
			
			Если число(Значение) > 0
				Тогда
				Стр.Подобрано  = Стр.Подобрано + Значение;
				Стр.Остаток  = Стр.Остаток - Значение;
				П = Новый Структура;
				П.Вставить("Номенклатура", Стр.Номенклатура);
				П.Вставить("Характеристика", Стр.Характеристика);
				П.Вставить("Количество", Значение);
				ММ.Добавить(П); 
				
				НовСтрТЗ = ТЗрез.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрТЗ,П);
				НовСтрТЗ.Склад = ТЗС[0].Склад;
				
			КонецЕсли;
		КонецЦикла;
		
		
		ПП = Новый Структура;
		ПП.Вставить("Заказ",Ссылка);
		ПП.Вставить("Склад",ТЗС[0].Склад);
		ПП.Вставить("ММ", ММ);
		
		Мрез.Добавить(ПП);
				
		Итерация = Итерация + 1; 
		Остаточек = ТЗ.Итог("Остаток");
		
		Если Итерация < 20
			и Остаточек > 0
			
			Тогда НадоПовторить = Истина
		Иначе НадоПовторить = Ложь
		КонецЕсли;
	КонецЦикла;

	Если Остаточек = 0
		Тогда
		Сообщить("Сформирован подбор товаров");
		
		// обновим ТЧ заказа - под реализацию
		
		Для каждого Стр из ДокЗаказа.Товары цикл
			
			Если Стр.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар
				ТОгда
			
			ОстатокРаспределения = Стр.КоличествоУпаковок;
			
			Для каждого Распр из ТЗрез цикл
				Если Стр.Номенклатура = Распр.Номенклатура
					И
					Стр.Характеристика = Распр.Характеристика
				Тогда
			
					Стр.Количество = мин(Распр.Количество, ОстатокРаспределения);
					Стр.КоличествоУпаковок = Стр.Количество;
					ОстатокРаспределения = ОстатокРаспределения - Стр.Количество;
					Стр.Сумма = Стр.Цена * Стр.Количество;
					Стр.СуммаСНДС = Стр.Сумма; 
					Стр.Склад = Распр.Склад;
					Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
					
					Если ОстатокРаспределения > 0 тогда
					НовСтр = ДокЗаказа.Товары.Добавить();    
					ЗаполнитьЗначенияСвойств(НовСтр, Стр);
					НовСтр.Количество = ОстатокРаспределения; 
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		КонецЦикла;
		
		ДокЗаказа.СформированоОбеспечение = Истина;
		ДокЗаказа.Записать(РежимЗаписиДокумента.Проведение);
		Рез = СоздатьДокументРеализации(Мрез);
		
		Если Рез = Ложь
			Тогда
			ДокЗаказа.ЕстьПроблемаФормированияОтгрузки  = Истина;
        КонецЕсли;
		ДокЗаказа.ЕстьПроблемаФормированияОтгрузки  = Ложь;
		ДокЗаказа.Записать();
		Возврат Истина
	Иначе 
		Сообщить("По документу " + Строка(ДокЗаказа) + " не удалось подобрать товары");
		ДокЗаказа.ЕстьПроблемаФормированияОтгрузки  = Истина; 
		ДокЗаказа.Записать();
		Возврат Ложь
		КонецЕсли;
	
КонецФункции	

Функция СоздатьДокументРеализации(Мрез)

	ВсеХорошо = Истина;
	
	Для каждого ПП из Мрез цикл
		
		ЗаказКлиента = Неопределено;
		Склад = Неопределено;
		ММ = Неопределено;
		ПП.Свойство("Заказ", ЗаказКлиента);
		ПП.Свойство("Склад", Склад);
		ПП.Свойство("ММ", ММ);
		
		Реализация = документы.РеализацияТоваровУслуг.СоздатьДокумент();
		Реализация.Менеджер = неопределено; 
		Реализация.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();     
		Реализация.Валюта = ЗаказКлиента.Валюта;
		Реализация.ВалютаВзаиморасчетов = ЗаказКлиента.Валюта;
		Реализация.РеализацияПоЗаказам = Истина;
		Реализация.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
		Реализация.ЗаказКлиента = ЗаказКлиента;
		Реализация.Склад = Склад;  
		Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		Реализация.Партнер = ЗаказКлиента.Партнер;                   
		Реализация.КартаЛояльности = ЗаказКлиента.КартаЛояльности;
		Реализация.Контрагент = ?(ЗаказКлиента.КартаЛояльности.Контрагент = Справочники.Контрагенты.ПустаяСсылка(), бит_сервер.НайтиКонтрагента(ЗаказКлиента.Партнер),ЗаказКлиента.КартаЛояльности.Контрагент);
		Реализация.Подразделение = ЗаказКлиента.Склад.Подразделение;
		Реализация.Касса = ЗаказКлиента.Касса;      
		Реализация.Валюта = ЗаказКлиента.Валюта;
		Реализация.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным;
		Реализация.Дата = ТекущаяДата();
		Реализация.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		Реализация.Выполнено = Ложь;
		
		ДокументЗаказ = ЗаказКлиента.ПолучитьОбъект();
		//  Установим Статус отгрузки по товарам к отгрузке
		СуммаДокумента = 0;
		
		// вычислим ссылку на назначение
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Назначения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Назначения КАК Назначения
		|ГДЕ
		|	Назначения.Заказ = &Заказ";
		
		Запрос.УстановитьПараметр("Заказ", ЗаказКлиента);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Назначение = Выборка.Ссылка;
		Иначе
			Назначение = неопределено;
		КонецЕсли;
		
		СумДок = 0;
		Для каждого Стр из ДокументЗаказ.Товары Цикл
			
			Если Стр.Склад = Склад
				Тогда
			НовСтр = Реализация.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр);
			НовСтр.Назначение = Назначение;
			СумДок = СумДок + НовСтр.Сумма;	
			КонецЕсли;
			
		КонецЦикла;				
		
		Реализация.СуммаДокумента = СумДок;
		Реализация.СуммаВзаиморасчетов = СумДок;
		Реализация.Комментарий = "Створено автоматично підчас обробки передплаченого замовлення Інтернет-магазіну";
			
		Сообщить("Создан" + Строка(Реализация));

			Попытка
				Реализация.Записать(РежимЗаписиДокумента.Проведение);  
												
			Исключение 
				Сообщить("Сбой ");
				Реализация.Записать(РежимЗаписиДокумента.Запись);  
                ВсеХорошо = Ложь;
			КонецПопытки;
			
		КонецЦикла;	
		
		Возврат ВсеХорошо;
		
	
КонецФункции	

Процедура РегламентноеЗаданиеЗакрытиеЗаказов() Экспорт
	
	РегистрыСведений.ОчередьОжиданияНаЗакрытие.ПопыткаЗаполнитьОчередь();
	
КонецПроцедуры

Функция ВыполнитьЗаменуНоменклатурыНаСервере(П) Экспорт
		
	УстановитьПривилегированныйРежим(Истина);
	
	//Инфра_ОбщиеМодули.ЗаменитьНоменклатуру(
	//П.ДокументИсточник,
	//П.НоменклатураСтар,
	//П.ХарактеристикаСтар,
	//П.НоменклатураНов,
	//П.ХарактеристикаНов,
	//П.Назначение,
	//П.Количество,
	//П.Автор,
	//,); 
	
	РеестрДокументов = п.ТЗ;
	
	//НачатьТранзакцию();
	Попытка		
		
		Колич = РеестрДокументов.Количество();		
		Для НОм = 1 по Колич цикл
			
			НомерСтроки = Колич - ном;
			Док = РеестрДокументов[НомерСтроки].Ссылка;
			
			До = РеестрДокументов[НомерСтроки].ПолучитьОБъект();
			
			Для каждого стр из ДО.Товары цикл
				Если 
					Стр.Номенклатура = П.НоменклатураСтар
					И 
					Стр.Характеристика = П.ХарактеристикаСтар
					И
					(ТипЗнч(Док) = ТИП("ДокументСсылка.ЗаказКлиента") 
					ИЛИ 			
					(ТипЗнч(Док) = ТИП("ДокументСсылка.ЗаказНаПеремещение") и Стр.Назначение = П.Назначение))
					Тогда
					Стр.Отменено = Истина;
					
					Если ТипЗнч(Док) = ТИП("ДокументСсылка.ЗаказКлиента")
						Тогда
						//Стр.ПричинаОтмены = Справочники.ПричиныОтменыЗаказовКлиентов.НайтиПоКоду("");
										
						Продавец = Стр.Продавец;
					КонецЕсли; 
					
				КонецЕсли;
			КонецЦикла;
			
			Если ТипЗнч(Док) = ТИП("ДокументСсылка.ЗаказКлиента") Тогда
				ДО.Записать(РежимЗаписиДокумента.Запись);
			ИНачеЕсли
				ТипЗнч(Док) = ТИП("ДокументСсылка.ЗаказНаПеремещение")
				 Тогда
				ДО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
					
		КонецЦикла;
		
		Для каждого Стр из РеестрДокументов цикл
			
			ДО = Стр.ПолучитьОБъект();	
			НовСтр = ДО.ТОвары.Добавить();
			НовСтр.Номенклатура = П.НоменклатураНов;
			НовСтр.Характеристика = П.ХарактеристикаНов;
			НовСтр.Упаковка = НовСтр.Номенклатура.ЕдиницаИзмерения;
			НовСтр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно;
			НовСтр.Количество = П.Количество; 
			НовСтр.КоличествоУпаковок = П.КОличество;

			Если ТипЗнч(Стр) = ТИП("ДокументСсылка.ЗаказНаПеремещение")
				Тогда
				НовСтр.Упаковка = НовСтр.Номенклатура.ЕдиницаИзмерения;
				НовСтр.Назначение = П.Назначение;
				НовСтр.НачалоОтгрузки = КонецДня(ТекущаяДата())+ 1;
				НовСтр.ОкончаниеПоступления = КонецДня(ТекущаяДата())+ 1;
            					
			ИначеЕсли ТипЗнч(Стр) = ТИП("ДокументСсылка.ЗаказКлиента")
				Тогда
				НовСтр.Склад = ДО.Склад;
				НовСтр.ДатаОтгрузки = бит_сервер.ДатаОтгрузки(ДО);
				НОвСтр.СрокПоставки = 1;				
				НОвСтр.ВидЦены = ДО.Склад.РозничныйВидЦены;    
				НОвСтр.Продавец = Продавец;
				НОвСтр.Цена = ЦенаНоменклатуры(П.НоменклатураНов, П.ХарактеристикаНов, До.Склад);
				НОвСтр.Сумма = НОвСтр.Цена * НОвСтр.Количество;
                НовСтр.СуммаСНДС = НОвСтр.Сумма;
				НовСтр.ПреемникПлатежаН  = П.НоменклатураСтар;
				НовСтр.ПреемникПлатежаХ  = П.ХарактеристикаСтар;
				НовСтр.СтавкаНДС  = Перечисления.СтавкиНДС.БезНДС;
				
				ДО.СуммаДокумента = ДО.ТОвары.Итог("Сумма");
				
			КонецЕсли; 
			ДО.Записать(РежимЗаписиДокумента.Запись);
			ДО.Записать(РежимЗаписиДокумента.Проведение);
			
			
			// Запишщем в регистре сведений произведенные замены
			МенеджерЗаписей = РегистрыСведений.РеестрЗаменНоменклатуры.СоздатьМенеджерЗаписи();
			МенеджерЗаписей.Регистратор = П.ДокументСсылка;
			МенеджерЗаписей.Период = Текущаядата();
			МенеджерЗаписей.Автор = П.Автор;
			МенеджерЗаписей.ДокументРегистратор = П.ДокументСсылка;
			МенеджерЗаписей.ДокументЗамены = ДО.Ссылка;;
			МенеджерЗаписей.НоменклатураНов =  П.НоменклатураНов;
			МенеджерЗаписей.НоменклатураСтар =  П.НоменклатураСтар;
			МенеджерЗаписей.ХарактеристикаНов = П.ХарактеристикаНов; 
			МенеджерЗаписей.ХарактеристикаСтар  = П.ХарактеристикаСтар;
			МенеджерЗаписей.Количество  = П.Количество;

			МенеджерЗаписей.Записать(Истина);

					
			
		КонецЦикла;
				
		Сообщить("Зміни виконані"); 
			
		Возврат Истина;
//		ЗафиксироватьТранзакцию();

	Исключение
	//	ОтменитьТранзакцию();
		//ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции замены номенклатуры'"),
		//УровеньЖурналаРегистрации.Ошибка,,,
		//ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщить("Помилка виконання, операція скасована.");	
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ПроверкаВыполнениеОбработкиВозможнаЗамена(П) экспорт
	
	ЕстьПроблема = Ложь;	
	// Проверим статус
	
	Если ЗначениеЗаполнено(П.ДокументИсточник)
		И
		(П.Статус = Перечисления.СтатусыЗаказовПоставщикам.Закрыт)
		Тогда
		ЕстьПроблема = Истина
	КонецЕсли;
	
	Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.Ссылка
		|ПОМЕСТИТЬ вт_Сборка
		|ИЗ
		|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
		|			ПеремещениеТоваровТовары.Характеристика КАК Характеристика,
		|			ПеремещениеТоваровТовары.Ссылка.ЗаказНаПеремещение КАК ЗаказНаПеремещение,
		|			ПеремещениеТоваровТовары.Количество КАК Количество,
		|			ПеремещениеТоваровТовары.Ссылка КАК Ссылка,
		|			ПеремещениеТоваровТовары.Назначение КАК Назначение
		|		ИЗ
		|			Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
		|		ГДЕ
		|			ПеремещениеТоваровТовары.Ссылка.Проведен) КАК ВложенныйЗапрос
		|		ПО ЗаказНаПеремещениеТовары.Номенклатура = ВложенныйЗапрос.Номенклатура
		|			И ЗаказНаПеремещениеТовары.Характеристика = ВложенныйЗапрос.Характеристика
		|			И ЗаказНаПеремещениеТовары.Ссылка = ВложенныйЗапрос.ЗаказНаПеремещение
		|			И ЗаказНаПеремещениеТовары.Назначение = ВложенныйЗапрос.Назначение
		|ГДЕ
		|	ЗаказНаПеремещениеТовары.Характеристика = &Характеристика
		|	И ЗаказНаПеремещениеТовары.Номенклатура = &Номенклатура
		|	И ЗаказНаПеремещениеТовары.Назначение.Заказ = &ЗаказКлиента
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Ссылка
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПоступлениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|			ПоступлениеТоваровУслугТовары.Характеристика КАК Характеристика,
		|			ПоступлениеТоваровУслугТовары.Ссылка КАК Ссылка,
		|			ПоступлениеТоваровУслугТовары.Назначение КАК Назначение,
		|			ПоступлениеТоваровУслугТовары.ЗаказПоставщику КАК ЗаказПоставщику
		|		ИЗ
		|			Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары) КАК ВложенныйЗапрос
		|		ПО ЗаказПоставщикуТовары.Номенклатура = ВложенныйЗапрос.Номенклатура
		|			И ЗаказПоставщикуТовары.Характеристика = ВложенныйЗапрос.Характеристика
		|			И ЗаказПоставщикуТовары.Назначение = ВложенныйЗапрос.Назначение
		|			И ЗаказПоставщикуТовары.Ссылка = ВложенныйЗапрос.ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщикуТовары.Характеристика = &Характеристика
		|	И ЗаказПоставщикуТовары.Номенклатура = &Номенклатура
		|	И ЗаказПоставщикуТовары.Назначение.Заказ = &ЗаказКлиента
		|	И ЗаказПоставщикуТовары.Ссылка = &СсылкаТекущийЗаказПоставщику
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Сборка.Ссылка
		|ИЗ
		|	вт_Сборка КАК вт_Сборка";
		Запрос.УстановитьПараметр("ЗаказКлиента", П.ЗаказКлиента);
	    Запрос.УстановитьПараметр("Номенклатура", П.НоменклатураСтар);
	    Запрос.УстановитьПараметр("Характеристика", П.ХарактеристикаСтар);
	   	Запрос.УстановитьПараметр("СсылкаТекущийЗаказПоставщику", П.ДокументИсточник);
	
		М = Новый Массив;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() цикл
			Если ЗначениеЗаполнено(Выборка.Ссылка)
				Тогда
				М.Добавить(Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
		
	    Возврат М;

КонецФункции

Функция ЦенаНоменклатуры(Номенклатура, Характеристика, Склад)  

   ВидЦены = Склад.РозничныйВидЦены;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЦеныНоменклатурыСрезПоследних.Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			&Дата,
		|			ВидЦены = &ВидЦены
		|				И Номенклатура = &Номенклатура
		|				И Характеристика = &Характеристика) КАК ЦеныНоменклатурыСрезПоследних";
	
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат  ВыборкаДетальныеЗаписи.Цена;
	Иначе
		Возврат 0
	КонецЕсли;
	
