		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи КАК eComm_УчетныеЗаписи
		|ГДЕ
		|	eComm_УчетныеЗаписи.ТорговаяПлощадка = ЗНАЧЕНИЕ(Перечисление.eComm_ТорговыеПлощадки.Rozetka)
		|	И eComm_УчетныеЗаписи.ВыгружатьТовары = ИСТИНА
		|	И eComm_УчетныеЗаписи.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	eComm_ИнтернетТовары.Категория КАК ing_Категория,
		|	eComm_ИнтернетТовары.ИнтернетСсылка КАК ing_ИнтернетСсылка,
		|	eComm_ИнтернетТовары.Описание КАК ing_Описание,
		|	eComm_ИнтернетТовары.АкционнаяСкидка КАК ing_АкционнаяСкидка,
		|	eComm_ИнтернетТовары.Наименование КАК ing_Наименование
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|ГДЕ
		|	eComm_ИнтернетТовары.Владелец В
		|			(ВЫБРАТЬ
		|				ВрТабУчетнаяЗапись.Ссылка
		|			ИЗ
		|				ВрТабУчетнаяЗапись КАК ВрТабУчетнаяЗапись)
		|	И eComm_ИнтернетТовары.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Форма.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Форма, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	

КонецПроцедуры

