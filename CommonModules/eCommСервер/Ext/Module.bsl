Функция ДополнительныеСведенияНайтиСоздать(СтруктураНастроек) Экспорт

	ИмяДокументаОплатаПлатежнойКартой = ВернутьИмяПрикладногоОбъекта("ОперацияПоПлатежнымКартам");
	
	Если НЕ ЗначениеЗаполнено(ИмяДокументаОплатаПлатежнойКартой) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Если Метаданные.Документы[ИмяДокументаОплатаПлатежнойКартой].ТабличныеЧасти.Найти("ДополнительныеРеквизиты") = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	//ИспользоватьРеквизиты = Константы.ИспользоватьДополнительныеРеквизитыИСведения.Получить();
	//Если Не ИспользоватьРеквизиты Тогда
	//	Константы.ИспользоватьДополнительныеРеквизитыИСведения.Установить(Истина);
	//КонецЕсли;
	
	ТипСтрока_0 	= Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1024));
	ТипСтрока_64 	= Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(64));
	ТипСтрока_128 	= Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(128));
	ТипЧисло 		= Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(14, 2));
	ТипДата 		= Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	
	ИмяПредопределенногоЗначенияОперация 	= ВернутьИмяРеквизитаОбъекта("НаборыДополнительныхРеквизитовИСведений", "ОперацияПоПлатежнымКартам");
	ИмяРеквизитаОбъекта_Имя					= ВернутьИмяРеквизитаОбъекта("ПВХДополнительныеРеквизиты", "Имя");
	НаборыДополнительныхРеквизитовИСведений_Ссылка = Справочники.НаборыДополнительныхРеквизитовИСведений[ИмяПредопределенногоЗначенияОперация];
	НаборыДополнительныхРеквизитовИСведений_Объект = НаборыДополнительныхРеквизитовИСведений_Ссылка.ПолучитьОбъект();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаборыДополнительныхРеквизитовИСведений_Ссылка", НаборыДополнительныхРеквизитовИСведений_Ссылка);
	Запрос.УстановитьПараметр("Данные", ДанныеМакета(СтруктураНастроек));
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	Имя,
		|	Наименование,
		|	Заголовок,
		|	Подсказка,
		|	Комментарий,
		|	ТипДанных
		|ПОМЕСТИТЬ
		|	Данные
		|ИЗ
		|	&Данные КАК Данные
		|;
		|
		|ВЫБРАТЬ
		|	Данные.Наименование КАК Наименование,
		|	Данные.Имя КАК Имя,
		|	Данные.Заголовок КАК Заголовок,
		|	Данные.Подсказка КАК Подсказка,
		|	Данные.Комментарий КАК Комментарий,
		|	Данные.ТипДанных КАК ТипДанных,
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
		|ИЗ
		|	Данные
		|	ЛЕВОЕ СОЕДИНЕНИЕ
		|		ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|	ПО
		|		(ДополнительныеРеквизитыИСведения.НаборСвойств = &НаборыДополнительныхРеквизитовИСведений_Ссылка)
		|		И (ДополнительныеРеквизитыИСведения.#Имя# = Данные.Имя)
		|";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#Имя#", ИмяРеквизитаОбъекта_Имя);
	ДополнительныеСведения = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ДополнительныеСведения_Строка Из ДополнительныеСведения Цикл
		
		Если ДополнительныеСведения_Строка.Имя = "prro_ACQUIREPN" 
			ИЛИ ДополнительныеСведения_Строка.Имя = "prro_ACQUIRENM" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДополнительныеСведения_Строка.Ссылка) Тогда
			ДополнительныеРеквизитыИСведения_Объект = ДополнительныеСведения_Строка.Ссылка.ПолучитьОбъект();
		Иначе
			ДополнительныеРеквизитыИСведения_Объект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
		КонецЕсли;
		
		ДополнительныеРеквизитыИСведения_Объект.НаборСвойств 	= НаборыДополнительныхРеквизитовИСведений_Ссылка;
		
		Если ДополнительныеСведения_Строка.ТипДанных = "Дата" Тогда
			ТипЗначения = ТипДата;
		ИначеЕсли ДополнительныеСведения_Строка.ТипДанных = "Число" Тогда
			ТипЗначения = ТипЧисло;
		ИначеЕсли ДополнительныеСведения_Строка.ТипДанных = "Строка64" Тогда
			ТипЗначения = ТипСтрока_64;
		ИначеЕсли ДополнительныеСведения_Строка.ТипДанных = "Строка128" Тогда
			ТипЗначения = ТипСтрока_128;	
		Иначе
			ТипЗначения = ТипСтрока_0;
		КонецЕсли;
		
		ДополнительныеРеквизитыИСведения_Объект.ТипЗначения 	= ТипЗначения;
		ДополнительныеРеквизитыИСведения_Объект[ИмяРеквизитаОбъекта_Имя] = ДополнительныеСведения_Строка.Имя;
		ДополнительныеРеквизитыИСведения_Объект.Наименование 	= ДополнительныеСведения_Строка.Заголовок;
		ДополнительныеРеквизитыИСведения_Объект.Заголовок 		= ДополнительныеСведения_Строка.Заголовок;
		ДополнительныеРеквизитыИСведения_Объект.Подсказка 		= ДополнительныеСведения_Строка.Подсказка;
		ДополнительныеРеквизитыИСведения_Объект.Комментарий 	= ДополнительныеСведения_Строка.Комментарий;
		ДополнительныеРеквизитыИСведения_Объект.Виден 			= Истина;
		ДополнительныеРеквизитыИСведения_Объект.Доступен 		= Истина;
		ДополнительныеРеквизитыИСведения_Объект.ПометкаУдаления = Ложь;
		ДополнительныеРеквизитыИСведения_Объект.Записать();		
		
		ДополнительныеСведения_Строка.Ссылка = ДополнительныеРеквизитыИСведения_Объект.Ссылка;
		
		Если НаборыДополнительныхРеквизитовИСведений_Объект.ДополнительныеРеквизиты.Найти(ДополнительныеСведения_Строка.Ссылка, "Свойство") = Неопределено Тогда
			НаборыДополнительныхРеквизитовИСведений_Объект.ДополнительныеРеквизиты.Добавить().Свойство = ДополнительныеРеквизитыИСведения_Объект.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнительныеСведения.Индексы.Добавить("Имя");
	
	Если НаборыДополнительныхРеквизитовИСведений_Объект.Модифицированность() Тогда
		НаборыДополнительныхРеквизитовИСведений_Объект.Записать();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ДополнительныеСведенияНайти(СтруктураНастроек) Экспорт
	
	ИмяПредопределенногоЗначенияОперация 	= ВернутьИмяРеквизитаОбъекта("НаборыДополнительныхРеквизитовИСведений", "ОперацияПоПлатежнымКартам");
	ИмяРеквизитаОбъекта_Имя					= ВернутьИмяРеквизитаОбъекта("ПВХДополнительныеРеквизиты", "Имя");
	НаборыДополнительныхРеквизитовИСведений_Ссылка = Справочники.НаборыДополнительныхРеквизитовИСведений[ИмяПредопределенногоЗначенияОперация];

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка,
		|	ДополнительныеРеквизитыИСведения.#Имя# КАК Имя
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|ГДЕ
		|	(ДополнительныеРеквизитыИСведения.НаборСвойств = &НаборыДополнительныхРеквизитовИСведений_Ссылка)
		|		И (ДополнительныеРеквизитыИСведения.#Имя# ПОДОБНО ""prro_%"")";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#Имя#", ИмяРеквизитаОбъекта_Имя);
	
	Запрос.УстановитьПараметр("НаборыДополнительныхРеквизитовИСведений_Ссылка", НаборыДополнительныхРеквизитовИСведений_Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;	

КонецФункции

Функция ДанныеМакета(СтруктураНастроек)

	Макет = Справочники.eComm_УчетныеЗаписи.ПолучитьМакет("ДополнительныеРеквизиты");
	
	КоличествоЗаписей = Макет.ВысотаТаблицы;
	
	ТаблицаДопРеквизитов = Новый ТаблицаЗначений;
	
	СоответствиеКолонок = Новый Соответствие;
	
	Для НомерКолонки = 1 По Макет.ШиринаТаблицы Цикл
		ТаблицаДопРеквизитов.Колонки.Добавить(СокрЛП(Макет.Область(1, НомерКолонки).Текст), Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000)));
		СоответствиеКолонок.Вставить(НомерКолонки, СокрЛП(Макет.Область(1, НомерКолонки).Текст));
	КонецЦикла;
		
	Для НомерСтроки = 2 по КоличествоЗаписей Цикл
		
		НовСтр = ТаблицаДопРеквизитов.Добавить();
		Для НомерКолонки = 1 По Макет.ШиринаТаблицы Цикл
			НовСтр[СоответствиеКолонок.Получить(НомерКолонки)] = СокрЛП(Макет.Область(НомерСтроки, НомерКолонки).Текст);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаДопРеквизитов;

КонецФункции

#КонецОбласти

