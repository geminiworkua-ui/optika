Функция ВидПлатежнойКарты(Знач НомерКарты) Экспорт
	
	Результат = "?";
	
	Если Лев(НомерКарты, 1) = "3" Тогда
		Результат = "American Express";
	ИначеЕсли Лев(НомерКарты, 1) = "4" Тогда
		Результат = "VISA";
	ИначеЕсли Лев(НомерКарты, 1) = "5" Тогда
		Результат = "MasterCard";
	ИначеЕсли Лев(НомерКарты, 1) = "6" Тогда 
		Результат = "China UnionPay";
	ИначеЕсли Лев(НомерКарты, 1) = "9" Тогда
		Результат = "Простір";
	ИначеЕсли НомерКарты = "PartPay" Тогда 
		Результат = "PartPay";
	КонецЕсли;
	
	Возврат Результат;
	
