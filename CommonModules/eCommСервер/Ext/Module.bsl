#Область РЕГЛАМЕНТНЫЕ_ЗАДАНИЯ

Процедура ЗаданиеВыполнитьОбмен(УчетнаяЗапись, НаправлениеОбмена = "") Экспорт
	
	НастройкиОбмена = Настройки(УчетнаяЗапись);
	
	Если НаправлениеОбмена = "ВыгружатьТовары" Тогда 
		
		Если НастройкиОбмена.ВыгружатьТовары = Истина Тогда 
			ВыгрузитьТовары(НастройкиОбмена);
		КонецЕсли;
		
	ИначеЕсли НаправлениеОбмена = "ЗагружатьЗаказы" Тогда 
		
		Если НастройкиОбмена.ЗагружатьЗаказы = Истина Тогда 
			ЗагрузитьЗаказы(НастройкиОбмена);
		КонецЕсли;
		
		Если НастройкиОбмена.СинхронизироватьСтатусыЗаказов = Истина Тогда 
			СинхронизироватьСтатусыЗаказов(НастройкиОбмена);
		КонецЕсли;
		
		Если НастройкиОбмена.ВыгружатьЗаказы = Истина Тогда 
			ВыгрузитьЗаказы(НастройкиОбмена);
		КонецЕсли;
		
		Если НастройкиОбмена.ЗагружатьСтатусыОплат = Истина Тогда 
			ЗагрузитьСтатусыОплатПоЗаказам(НастройкиОбмена);
		КонецЕсли;
		
	ИначеЕсли НаправлениеОбмена = "ПолучениеОплат" Тогда
		
		//++ eComm: Платежные сервисы
		Модуль_eCommПлатежныеСервисы = ОбщийМодуль("eCommПлатежныеСервисы");
		Если НЕ Модуль_eCommПлатежныеСервисы = Неопределено Тогда 
			Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.eComm_УчетныеЗаписиПлатежныхСервисов") Тогда
				Справочники["eComm_УчетныеЗаписиПлатежныхСервисов"].ВыполнитьРегламентноеЗадание(Модуль_eCommПлатежныеСервисы.Настройки(УчетнаяЗапись), НаправлениеОбмена);
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

Функция ВыгрузитьТовары(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.ВыгружатьТовары = Истина Тогда 
		Если УчетнаяЗаписьОбновленаДоВерсииМодуля(СтруктураНастроек) Тогда
			Справочники.eComm_УчетныеЗаписи.ВыгрузитьТовары(СтруктураНастроек);
		Иначе
			Сообщить("Ошибка при обновлении версии модуля """ + СтруктураНастроек.УчетнаяЗапись + """");
		КонецЕсли;
	Иначе
		Сообщить("Для учетной записи """ + СтруктураНастроек.УчетнаяЗапись + """ выгрузка товаров отключена!!!");
	КонецЕсли;

КонецФункции

Функция ЗагрузитьЗаказы(СтруктураНастроек, НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт
	
	Если СтруктураНастроек.ЗагружатьЗаказы = Истина Тогда 
		Если УчетнаяЗаписьОбновленаДоВерсииМодуля(СтруктураНастроек) Тогда
			// Дря регламентного задания "Начало периода" и "Конец периода" равны "Неопределено"
			Справочники.eComm_УчетныеЗаписи.ЗагрузитьЗаказы(СтруктураНастроек, НачалоПериода, КонецПериода);
		Иначе
			Сообщить("Ошибка при обновлении версии модуля """ + СтруктураНастроек.УчетнаяЗапись + """");
		КонецЕсли;
	Иначе
		Сообщить("Для учетной записи """ + СтруктураНастроек.УчетнаяЗапись + """ загрузка заказов отключена!!!");
	КонецЕсли;
	
КонецФункции

Функция ВыгрузитьЗаказы(СтруктураНастроек) Экспорт

	Если СтруктураНастроек.ВыгружатьЗаказы = Истина Тогда  
		Если УчетнаяЗаписьОбновленаДоВерсииМодуля(СтруктураНастроек) Тогда 
			Справочники.eComm_УчетныеЗаписи.ВыгрузитьЗаказы(СтруктураНастроек);
		Иначе
			Сообщить("Ошибка при обновлении версии модуля """ + СтруктураНастроек.УчетнаяЗапись + """");
		КонецЕсли;
	Иначе
		Сообщить("Для учетной записи """ + СтруктураНастроек.УчетнаяЗапись + """ выгрузка заказов отключена!!!");
	КонецЕсли;

КонецФункции

Функция СинхронизироватьСтатусыЗаказов(СтруктураНастроек) Экспорт
	
	Если СтруктураНастроек.СинхронизироватьСтатусыЗаказов = Истина Тогда 
		Если УчетнаяЗаписьОбновленаДоВерсииМодуля(СтруктураНастроек) Тогда 
			Справочники.eComm_УчетныеЗаписи.СинхронизироватьСтатусыЗаказов(СтруктураНастроек);
		Иначе
			Сообщить("Ошибка при обновлении версии модуля """ + СтруктураНастроек.УчетнаяЗапись + """");
		КонецЕсли;
	Иначе
		Сообщить("Для учетной записи """ + СтруктураНастроек.УчетнаяЗапись + """ синхронизация статусов заказов отключена !!!");
	КонецЕсли;
	
КонецФункции

Функция ЗагрузитьСтатусыОплатПоЗаказам(СтруктураНастроек, НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт

	Если СтруктураНастроек.ЗагружатьСтатусыОплат = Истина Тогда  
		Если УчетнаяЗаписьОбновленаДоВерсииМодуля(СтруктураНастроек) Тогда 
			Справочники.eComm_УчетныеЗаписи.ЗагрузитьСтатусыОплатПоЗаказам(СтруктураНастроек, НачалоПериода, КонецПериода);
		Иначе
			Сообщить("Ошибка при обновлении версии модуля """ + СтруктураНастроек.УчетнаяЗапись + """");
		КонецЕсли;
	Иначе
		Сообщить("Для учетной записи """ + СтруктураНастроек.УчетнаяЗапись + """ загрузка статусов оплат по заказам отключена!!!");
	КонецЕсли;

КонецФункции

Функция УчетнаяЗаписьОбновленаДоВерсииМодуля(СтруктураНастроек)

	Если СтруктураНастроек.Версия = ВерсияБиблиотеки() Тогда 
		Результат = Истина;
	Иначе
		Результат = eCommСерверПереопределяемый.ОбновитьУчетнуюЗаписьДоВерсииМодуля(СтруктураНастроек);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗапуститьВыполнениеВФоне(Знач КлючЗадания, Знач ИмяЭкспортнойПроцедуры, Знач Параметры,
	Знач НаименованиеЗадания = "", ОжидатьЗавершение = Ложь, ВремяОжидания = 2) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаданиеВыполнено",      Ложь);
	Результат.Вставить("ТекстОшибки",           "");
	Результат.Вставить("СостояниеЗадания",      "");
	Результат.Вставить("ИдентификаторЗадания",  "");
	
	Если Не ЗначениеЗаполнено(НаименованиеЗадания) Тогда
		НаименованиеЗадания = ИмяЭкспортнойПроцедуры;
	КонецЕсли;
	
	ЗапущеноЗаданий = 0;
	Отбор = Новый Структура;
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	
	МассивЗаданий 	= ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	ЗапущеноЗаданий = МассивЗаданий.Количество();
	
	Если ЗапущеноЗаданий > 0 Тогда
		
		Для Каждого ФЗ Из МассивЗаданий Цикл 
			Попытка
				ФЗ.Отменить();
			Исключение
			КонецПопытки;
		КонецЦикла;
		
		Задание = ФоновыеЗадания.Выполнить(ИмяЭкспортнойПроцедуры, Параметры, КлючЗадания, НаименованиеЗадания);
		Результат.ИдентификаторЗадания = Задание.УникальныйИдентификатор;
		Результат.СостояниеЗадания = "Выполняется";
		
	Иначе
		
		Задание = ФоновыеЗадания.Выполнить(ИмяЭкспортнойПроцедуры, Параметры, КлючЗадания, НаименованиеЗадания);
		Результат.ИдентификаторЗадания = Задание.УникальныйИдентификатор;
		Результат.СостояниеЗадания = "Выполняется";
		Результат.ЗаданиеВыполнено = Результат.СостояниеЗадания <> "Выполняется";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтатусФоновогоЗадания(Знач КлючЗадания) Экспорт

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(КлючЗадания);	
	
	СтруктураРезультата = Новый Структура("Статус, ТекстОшибки", "Неопределено", "");
	
	Если НЕ Задание = Неопределено Тогда 
		
		Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда 
			СтруктураРезультата.Статус = "Активно";
		ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			СтруктураРезультата.Статус = "Завершено";
		ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			СтруктураРезультата.Статус = "ЗавершеноАварийно";
			СтруктураРезультата.ТекстОшибки = Задание.ИнформацияОбОшибке.Описание;
		ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
			СтруктураРезультата.Статус = "Отменено";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции

Процедура ЗапуститьВыполнениеМетода(ИмяОбъекта, УчетнаяЗапись, АдресВХранилище, КодГорода = Неопределено) Экспорт

	Если ИмяОбъекта = "eComm_OLX.НаселенныеПункты" Тогда 
		Обработки["eComm_OLX"].НаселенныеПункты(УчетнаяЗапись, АдресВХранилище);
	ИначеЕсли ИмяОбъекта = "eComm_OLX.РайоныНаселенныхПунктов" Тогда 
		Обработки["eComm_OLX"].РайоныНаселенныхПунктов(УчетнаяЗапись, АдресВХранилище, КодГорода);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область  НАСТРОЙКИ

Функция Настройки(ОбъектНастроек) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаНастроек(ОбъектНастроек);
		
	Запрос.УстановитьПараметр("ОбъектНастроек", ОбъектНастроек);
	
	РезультатЗапроса = Запрос.Выполнить();

	СтруктураНастроек = Новый Структура;
	
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		
		Если Колонка.Имя = "НастройкиУчетнойЗаписи"
			ИЛИ Колонка.Имя = "НастройкиДопПрофиля"
			ИЛИ Колонка.Имя = "НастройкиКомпоновщика" Тогда
			// Обработаем позже
			Продолжить;
		КонецЕсли;
		
		СтруктураНастроек.Вставить(Колонка.Имя);
		
	КонецЦикла; 
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		ЗаполнитьЗначенияСвойств(СтруктураНастроек, Выборка, , "АдресAPI");
		ДополнитьНастройкиПараметрамиПодключения(СтруктураНастроек, Выборка.АдресAPI);
		
		ИмяОбработки = ВернутьИмяЗначенияПеречисления(СтруктураНастроек.ТорговаяПлощадка);
		
		ИмяОбъектаДополнительныеРеквизиты 	= ВернутьИмяПрикладногоОбъекта("ПВХДополнительныеРеквизиты");
		ИспользоватьМножественныеРеквизиты 	= НЕ Метаданные.ПланыВидовХарактеристик[ИмяОбъектаДополнительныеРеквизиты].Реквизиты.Найти("МножественныйРеквизит") = Неопределено;
		
		СтруктураНастроек.Вставить("НастройкиОбмена"			, Выборка.НастройкиУчетнойЗаписи.Получить());
		Если ТипЗнч(ОбъектНастроек) = Тип("СправочникСсылка.eComm_ПрофилиНастроекУчетнойЗаписи") Тогда 
			// Подменим настийки учетной записи настройками дополнительного профиля
			ВыгрузкаТоваровНастройкиПрофиля = Выборка.НастройкиДопПрофиля.Получить().ВыгрузкаТоваров;
			ЗаполнитьЗначенияСвойств(СтруктураНастроек.НастройкиОбмена.ВыгрузкаТоваров, ВыгрузкаТоваровНастройкиПрофиля);
			ЗаполнитьЗначенияСвойств(СтруктураНастроек, ВыгрузкаТоваровНастройкиПрофиля, "Сервер, 
																						| Каталог, 
																						| Логин, 
																						| Пароль, 
																						| ИмяФайла, 
																						| URL_КаталогаКартинок, 
																						| ВыгружатьКартинкиИзБазы,
																						| ОграничениеМинимальногоОстатка,
																						| ОграничениеМаксимальогоОстатка");
		КонецЕсли;
		СтруктураНастроек.Вставить("НастройкиКомпоновщика"		, Выборка.НастройкиКомпоновщика.Получить());
		СтруктураНастроек.Вставить("ИспользоватьХарактеристики"	, ВключеноИспользованиеХарактеристик());
		СтруктураНастроек.Вставить("ТипПлатформы"				, ТипПлатформыСтрокой());
		СтруктураНастроек.Вставить("Менеджер"					, "eComm_" + ИмяОбработки);
		СтруктураНастроек.Вставить("ИмяКонфигурации"			, ИмяКонфигурации());
		СтруктураНастроек.Вставить("ИспользоватьМножественныеРеквизиты", ИспользоватьМножественныеРеквизиты);
		
		Если Выборка.ВыгружатьТовары = Истина Тогда 
			
			ДополнитьНастройкиОптовымиЦенами(СтруктураНастроек);
			ДополнитьНастройкиУровнямиЦен(СтруктураНастроек);
			
		КонецЕсли;
		
		Если Выборка.ЗагружатьЗаказы = Истина Тогда 
			
			СтруктураНастроек.Вставить("КонтактныеЛицаПодчиненыВладельцу", Метаданные.Справочники[ВернутьИмяПрикладногоОбъекта("КонтактныеЛица")].Владельцы.Количество() > 0);      // Используется для поиска (не поиска) по контактным лицам
			
			ДополнитьНастройкиПеревозчиками(СтруктураНастроек);			
			ДополнитьНастройкиСпособамиОплаты(СтруктураНастроек);
			
			Модуль_eCommДоставкаСервер = eCommСервер.ОбщийМодуль("eCommДоставкаСервер");
			СтруктураНастроек.Вставить("Используется_eCommДоставка", ?(Модуль_eCommДоставкаСервер = Неопределено, Ложь, Истина));
			
		КонецЕсли;
		
	КонецЕсли;  
	
	// Удалим из настроек таблицы значений
	Попытка
		СтруктураНастроек.НастройкиОбмена.ЗагрузкаЗаказов.Удалить("Перевозчики");
	Исключение
	КонецПопытки;
	
	eCommСерверПереопределяемый.ДополнитьНастройкиУчетнойЗаписи(СтруктураНастроек);
	
	Возврат СтруктураНастроек;

КонецФункции

Функция ТекстЗапросаНастроек(ОбъектНастроек)
	
	Если ТипЗнч(ОбъектНастроек) = Тип("СправочникСсылка.eComm_УчетныеЗаписи") Тогда 
		ТекстЗапроса = "ВЫБРАТЬ
			|	УчетныеЗаписи.Версия,
			|	УчетныеЗаписи.Код,
			|	УчетныеЗаписи.Сервер,
			|	УчетныеЗаписи.Каталог + ВЫБОР
			|		КОГДА УчетныеЗаписи.Каталог ПОДОБНО ""%/""
			|			ТОГДА """"
			|		ИНАЧЕ ""/""
			|	КОНЕЦ КАК Каталог,
			|	УчетныеЗаписи.Логин,
			|	УчетныеЗаписи.Пароль,
			|	УчетныеЗаписи.ВыгружатьТовары,
			|	УчетныеЗаписи.ВыгружатьТолькоИзменения,
			|	УчетныеЗаписи.ОграничениеМаксимальогоОстатка,
			|	УчетныеЗаписи.ОграничениеМинимальногоОстатка,
			|	УчетныеЗаписи.ИмяФайла,
			|	ВЫБОР 
			|		КОГДА УчетныеЗаписи.ТорговаяПлощадка = Значение(Перечисление.eComm_ТорговыеПлощадки.Joom) 
			|			ТОГДА ""json""
			|		КОГДА УчетныеЗаписи.ТорговаяПлощадка = Значение(Перечисление.eComm_ТорговыеПлощадки.Prom) 
			|			ТОГДА ""yml""
			|		КОГДА УчетныеЗаписи.ТорговаяПлощадка = Значение(Перечисление.eComm_ТорговыеПлощадки.Horoshop) 
			|			ТОГДА ""json""
			|		ИНАЧЕ ""xml""
			|	КОНЕЦ КАК РасширениеФайла,
			|	УчетныеЗаписи.ТипЦены,
			//|	УчетныеЗаписи.ТипЦеныОпт,
			|	УчетныеЗаписи.НастройкиКомпоновщика,
			|	УчетныеЗаписи.НазваниеКомпании,
			|	УчетныеЗаписи.НазваниеМагазина,
			|	УчетныеЗаписи.ОписаниеМагазина,
			| 	УчетныеЗаписи.URL_ИнтернетМагазина,
			|	УчетныеЗаписи.Ссылка КАК УчетнаяЗапись,
			|	Значение(Справочник.eComm_ПрофилиНастроекУчетнойЗаписи.ПустаяСсылка) КАК ПрофильНастроек,
			|	УчетныеЗаписи.URL_КаталогаКартинок + ВЫБОР
			|		КОГДА УчетныеЗаписи.URL_КаталогаКартинок ПОДОБНО ""%/""
			|			ТОГДА """"
			|		ИНАЧЕ ""/""
