				Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда 
					
					СоответствиеСтатусовОплаты = Новый Соответствие;
					СоответствиеСтатусовОплаты.Вставить("paid"		, "оплачено покупцем");
					СоответствиеСтатусовОплаты.Вставить("unpaid"	, "не оплачено");
					СоответствиеСтатусовОплаты.Вставить("refunded"	, "виконане повернення покупцю");
					СоответствиеСтатусовОплаты.Вставить("paid_out"	, "виплачено продавцю");
					
					НаименованиеСтатусаОплаты = СоответствиеСтатусовОплаты.Получить(СтатусОплаты);
					
				Иначе
					
					НаименованиеСтатусаОплаты = СтатусОплаты;
					
				КонецЕсли;
				
				ЗначениеСтатуса = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(НаименованиеСтатусаОплаты, Истина, , СвойствоСтатусОплаты);
				
				Если НЕ ЗначениеЗаполнено(ЗначениеСтатуса) Тогда 
					
					ЗначениеСтатусаОбъект = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
					ЗначениеСтатусаОбъект.Наименование 	= НаименованиеСтатусаОплаты;
					ЗначениеСтатусаОбъект.Владелец 		= СвойствоСтатусОплаты;
					ЗначениеСтатусаОбъект.Записать();
					
					ЗначениеСтатуса = ЗначениеСтатусаОбъект.Ссылка;
					
				КонецЕсли;
				
			Иначе
				
				ЗначениеСтатуса = Неопределено;
				
			КонецЕсли;
			
			// Это конфигурация на управляемых формах. Доп. реквизиты хранятся в ТЧ документа
			
			Отбор = Новый Структура("Свойство", СвойствоСтатусОплаты);
			НайденныеСтроки = ЗаказОбъект["ДополнительныеРеквизиты"].НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() > 0 Тогда 
				ТекСтрока = НайденныеСтроки[0];
				Если ТекСтрока.Значение = ЗначениеСтатуса Тогда 
					// Статус оплаты не изменился.
					// Перезаписывать нет смысла
					Возврат;
				КонецЕсли;
			Иначе
				ТекСтрока = ЗаказОбъект["ДополнительныеРеквизиты"].Добавить();
				ТекСтрока.Свойство = СвойствоСтатусОплаты;
			КонецЕсли;
			ТекСтрока.Значение = ЗначениеСтатуса;
				
		КонецЕсли; 
		
	КонецЕсли;

КонецПроцедуры

