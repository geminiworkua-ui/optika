Функция ВернутьСимвольныйКодВалюты(СтруктураНастроек, Валюта, КешВалют) Экспорт

	Если НЕ ЗначениеЗаполнено(Валюта) Тогда 
		
		Возврат "";
		
	ИначеЕсли КешВалют[Валюта] = Неопределено Тогда 
		
		КодВалюты = Валюта.Код;
		Если КодВалюты = "980" Тогда 
			СимвольныйКод = "UAH";
		ИначеЕсли КодВалюты = "840" Тогда 
			СимвольныйКод = "USD";
		ИначеЕсли КодВалюты = "978" Тогда 
			СимвольныйКод = "EUR";
		Иначе
			СимвольныйКод = Валюта.Наименование;
		КонецЕсли;
		
		КешВалют.Вставить(Валюта, СимвольныйКод);
		
		Возврат СимвольныйКод;
			
	Иначе
		
		Возврат КешВалют[Валюта];
		
	КонецЕсли;

КонецФункции

