Процедура ЗафиксироватьСостояниеОбмена(СтруктураНастроек, ДействиеПриОбмене, ДанныеСостоянияОбмена) Экспорт

	Если НЕ ТипЗнч(ДанныеСостоянияОбмена) = Тип("Структура") Тогда 
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.eComm_СостояниеОбменовДанными.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УчетнаяЗапись 		= СтруктураНастроек.УчетнаяЗапись;
	МенеджерЗаписи.ПрофильНастроек		= СтруктураНастроек.ПрофильНастроек;
	МенеджерЗаписи.ДействиеПриОбмене 	= ДействиеПриОбмене;
	МенеджерЗаписи.Прочитать();
	
	Если НЕ МенеджерЗаписи.Выбран() Тогда 
		МенеджерЗаписи.УчетнаяЗапись 		= СтруктураНастроек.УчетнаяЗапись;
		МенеджерЗаписи.ПрофильНастроек 		= СтруктураНастроек.ПрофильНастроек;
		МенеджерЗаписи.ДействиеПриОбмене 	= ДействиеПриОбмене;
	КонецЕсли;
	
	Если ДанныеСостоянияОбмена.Свойство("ДатаНачала") Тогда 
		МенеджерЗаписи.ДатаНачала = ДанныеСостоянияОбмена.ДатаНачала;
	КонецЕсли;
	Если ДанныеСостоянияОбмена.Свойство("ДатаОкончания") Тогда 
		МенеджерЗаписи.ДатаОкончания = ДанныеСостоянияОбмена.ДатаОкончания;
	КонецЕсли;
	Если ДанныеСостоянияОбмена.Свойство("Параметры") Тогда 
		МенеджерЗаписи.Параметры = Новый ХранилищеЗначения(ДанныеСостоянияОбмена.Параметры);
	КонецЕсли;
	
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

Функция ДанныеСостоянияОбмена(СтруктураНастроек, ДействиеПриОбмене) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостояниеОбменов.УчетнаяЗапись КАК УчетнаяЗапись,
		|	СостояниеОбменов.ПрофильНастроек КАК ПрофильНастроек,
		|	СостояниеОбменов.ДействиеПриОбмене КАК ДействиеПриОбмене,
		|	СостояниеОбменов.ДатаНачала КАК ДатаНачала,
		|	СостояниеОбменов.ДатаОкончания КАК ДатаОкончания,
		|	СостояниеОбменов.Параметры КАК Параметры
		|ИЗ
		|	РегистрСведений.eComm_СостояниеОбменовДанными КАК СостояниеОбменов
		|ГДЕ
		|	СостояниеОбменов.УчетнаяЗапись = &УчетнаяЗапись
		|	И СостояниеОбменов.ПрофильНастроек = &ПрофильНастроек
		|	И СостояниеОбменов.ДействиеПриОбмене = &ДействиеПриОбмене";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись"		, СтруктураНастроек.УчетнаяЗапись);
	Запрос.УстановитьПараметр("ПрофильНастроек"		, СтруктураНастроек.ПрофильНастроек);
	Запрос.УстановитьПараметр("ДействиеПриОбмене"	, ДействиеПриОбмене);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		
		ДанныеСостоянияОбмена = Новый Структура("УчетнаяЗапись, ПрофильНастроек, ДатаНачала, ДатаОкончания");
		ЗаполнитьЗначенияСвойств(ДанныеСостоянияОбмена, РезультатЗапроса);
		ДанныеСостоянияОбмена.Вставить("Параметры", РезультатЗапроса.Параметры.Получить());
		
		Возврат ДанныеСостоянияОбмена;
		
	ИначеЕсли ДействиеПриОбмене = Перечисления.eComm_ДействияПриОбмене.ОбменЗаказами Тогда 
		// Временно на период перехода:
		
		Если НЕ Метаданные.РегистрыСведений.Найти("eComm_ВремяЗагруженногоЗаказа") = Неопределено Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ВремяЗагруженногоЗаказа.ДатаЗагрузки КАК ДатаЗагрузки
				|ИЗ
				|	РегистрСведений.eComm_ВремяЗагруженногоЗаказа КАК ВремяЗагруженногоЗаказа
				|ГДЕ
				|	ВремяЗагруженногоЗаказа.УчетнаяЗапись = &УчетнаяЗапись";
			
			Запрос.УстановитьПараметр("УчетнаяЗапись", СтруктураНастроек.УчетнаяЗапись);
			
			РезультатЗапроса = Запрос.Выполнить().Выбрать();
			
			Если РезультатЗапроса.Следующий() Тогда
				
				ДанныеСостоянияОбмена = Новый Структура;
				ДанныеСостоянияОбмена.Вставить("ДатаНачала"		, РезультатЗапроса.ДатаЗагрузки - 1);
				ДанныеСостоянияОбмена.Вставить("ДатаОкончания"	, РезультатЗапроса.ДатаЗагрузки);
				ДанныеСостоянияОбмена.Вставить("УчетнаяЗапись"	, СтруктураНастроек.УчетнаяЗапись);
				ДанныеСостоянияОбмена.Вставить("ПрофильНастроек", СтруктураНастроек.ПрофильНастроек);
				ДанныеСостоянияОбмена.Вставить("Параметры"		, Неопределено);
				
				eCommСервер.ЗафиксироватьСостояниеОбмена(СтруктураНастроек, Перечисления.eComm_ДействияПриОбмене.ОбменЗаказами, ДанныеСостоянияОбмена);
				
				Возврат ДанныеСостоянияОбмена;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура("УчетнаяЗапись, ПрофильНастроек, ДатаНачала, ДатаОкончания, Параметры");
	
КонецФункции

Функция Установить_HTTPСоединение(СтруктураНастроек) Экспорт

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	
	Соединение = eCommСерверПереопределяемый.Установить_HTTPСоединение(СтруктураНастроек, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда 
		
		Если СтруктураНастроек.Свойство("HTTP_ЗащищенноеСоединение")
			И СтруктураНастроек["HTTP_ЗащищенноеСоединение"] = Истина Тогда
			
			Если СтруктураНастроек.ТипПлатформы = "Windows" Тогда 
				ssl = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Новый СертификатыУдостоверяющихЦентровWindows());
			Иначе
				ssl = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
			КонецЕсли;
			
		Иначе
			
			ssl = Неопределено;
			
		КонецЕсли;
		
		Попытка
			Соединение = Новый HTTPСоединение(СтруктураНастроек.HTTP_Сервер, СтруктураНастроек.HTTP_Порт,,,,,ssl);
		Исключение
			Сообщить("Не удалось установить HTTP-соединение!!!");
			Соединение = Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Соединение;

КонецФункции

Функция Установить_FTPСоединение(СтруктураНастроек) Экспорт

