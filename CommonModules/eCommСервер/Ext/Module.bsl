#Область АДАПТАЦИЯ_КОНФИГУРАЦИЙ

Функция ВернутьИмяДокументЗаказ() Экспорт

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	Результат = eCommСерверПереопределяемый.ВернутьИмяДокументЗаказ(ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		
		ИмяКонфигурации = ИмяКонфигурации();
		Если ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда 
			Результат = "ЗаказПокупателя";
		ИначеЕсли ИмяКонфигурации = "BASSmallBusiness" Тогда
			Результат = "ЗаказПокупателя";
		Иначе
			Результат = "ЗаказКлиента";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции 

Функция ВернутьИмяСправочникПартнеры() Экспорт

	ИмяКонфигурации = ИмяКонфигурации();
	Если ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда 
		Возврат "Контрагенты";
	ИначеЕсли ИмяКонфигурации = "BASSmallBusiness" Тогда
		Возврат "Контрагенты";
	Иначе
		Возврат "Партнеры";
	КонецЕсли;

КонецФункции

Функция ВернутьИмяОбъектаКонтактнаяИнформация(ИмяКонтакта = "Партнеры") Экспорт

	ИмяКонфигурации = ИмяКонфигурации();
	
	Если ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда 
		Результат = "РегистрСведений";
	ИначеЕсли ИмяКонфигурации = "BASSmallBusiness" Тогда
		Результат = "Справочник." + ?(ИмяКонтакта = "КонтактныеЛица", "КонтактныеЛица", "Контрагенты");
	Иначе
		Результат = "Справочник." + ?(ИмяКонтакта = "КонтактныеЛица", "КонтактныеЛицаПартнеров", "Партнеры");
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ВернутьИмяКонстантыИспользоватьХарактеристики() Экспорт
		
	ИмяКонфигурации = ИмяКонфигурации();
	
	Если ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда 
		Возврат "ИспользоватьХарактеристикиНоменклатуры";
	ИначеЕсли ИмяКонфигурации = "BASSmallBusiness" Тогда
		Возврат "ФункциональнаяОпцияИспользоватьХарактеристики";
	Иначе
		Возврат "ИспользоватьХарактеристикиНоменклатуры";
	КонецЕсли;

КонецФункции 

Функция ВернутьИмяПрикладногоОбъекта(ИмяОбъекта, ИспользоватьПолноеИмя = Ложь) Экспорт

	ОбрабатыватьВстроеннымОбработчиком = Истина;
