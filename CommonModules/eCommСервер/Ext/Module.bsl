			|ИЗ
			|	Документ.ОперацияПоПлатежнымКартам КАК ОперацияПоПлатежнойКарте
			|ГДЕ
			|	ОперацияПоПлатежнойКарте.ДокументОснование = &ЗаказПокупателя
			|	И НЕ ОперацияПоПлатежнойКарте.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Справочник.ХозяйственныеОперации.ВозвратОплатыПокупателю)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ОперацияПоПлатежнойКарте.Проведен УБЫВ,
			|	ОперацияПоПлатежнойКарте.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);	

	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ОперацияПоПлатежнойКарте.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ОперацияПоПлатежнойКарте.РасшифровкаПлатежа КАК ОперацияПоПлатежнойКарте
			|ГДЕ
			|	ОперацияПоПлатежнойКарте.НомерСтроки = 1
			|	И ОперацияПоПлатежнойКарте.ОснованиеПлатежа = &ЗаказПокупателя
			|
