Процедура ДополнитьНастройкиПеревозчиками(СтруктураНастроек)

	СоответствиеПеревозчиков = Новый Соответствие;
	
	Перевозчики = Неопределено;
	
	Если СтруктураНастроек.НастройкиОбмена.Свойство("ЗагрузкаЗаказов") 
		И ТипЗнч(СтруктураНастроек.НастройкиОбмена.ЗагрузкаЗаказов) = Тип("Структура")
		И СтруктураНастроек.НастройкиОбмена.ЗагрузкаЗаказов.Свойство("Перевозчики", Перевозчики)
		И ТипЗнч(Перевозчики) = Тип("ТаблицаЗначений") Тогда 
		
		Для Каждого Стр Из Перевозчики Цикл 
			СоответствиеПеревозчиков.Вставить(Стр.СервисДоставки, Новый Структура("Перевозчик, СпособДоставки", Стр.Перевозчик, Стр.СпособДоставки)); 
		КонецЦикла;
		
	КонецЕсли;
	
	СтруктураНастроек.Вставить("Перевозчики"	, СоответствиеПеревозчиков);
	
КонецПроцедуры

Процедура ДополнитьНастройкиСпособамиОплаты(СтруктураНастроек)

	СоответствиеСпособовОплаты = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СпособыОплаты.СпособОплатыНаСайте КАК СпособОплатыНаСайте,
		|	СпособыОплаты.СпособОплатыВБазе КАК СпособОплатыВБазе,
		|	СпособыОплаты.ИмяРеквизита КАК ИмяРеквизита,
		|	СпособыОплаты.НаложенныйПлатеж КАК НаложенныйПлатеж
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи.СпособыОплаты КАК СпособыОплаты
		|ГДЕ
		|	СпособыОплаты.Ссылка = &УчетнаяЗапись";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", СтруктураНастроек.УчетнаяЗапись);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		СоответствиеСпособовОплаты.Вставить(РезультатЗапроса.СпособОплатыНаСайте, Новый Структура("ИмяРеквизита, СпособОплатыВБазе, НаложенныйПлатеж", РезультатЗапроса.ИмяРеквизита, РезультатЗапроса.СпособОплатыВБазе, РезультатЗапроса.НаложенныйПлатеж));
