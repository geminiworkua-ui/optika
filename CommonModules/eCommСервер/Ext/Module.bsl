			ИначеЕсли ИмяОбъекта = "ЗначенияНоменклатурыПоУмолчанию" Тогда 
				Результат = "ЗначенияНоменклатурыПоУмолчанию";
			ИначеЕсли ИмяОбъекта = "ЮрФизЛицо" Тогда 
				Результат = "ВидыКонтрагентов";
			ИначеЕсли ИмяОбъекта = "СпособыРасчетаЦеныНабора" Тогда 
				Результат = "СпособыРасчетаЦеныНабора";
			ИначеЕсли ИмяОбъекта = "НоменклатураПрисоединенныеФайлы" Тогда 
				Результат = "НоменклатураПрисоединенныеФайлы";
			ИначеЕсли ИмяОбъекта = "ХарактеристикиНоменклатурыПрисоединенныеФайлы" Тогда 
				Результат = "ХарактеристикиНоменклатурыПрисоединенныеФайлы";
			ИначеЕсли ИмяОбъекта = "ИспользоватьПартнеровКакКонтрагентов" Тогда 
