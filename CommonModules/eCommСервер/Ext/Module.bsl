Функция ВернутьЗначениеЧислом(ЗначениеЭлемента) Экспорт

	Если ТипЗнч(ЗначениеЭлемента) = Тип("Число") Тогда 
		
		Результат = ЗначениеЭлемента;
		
	Иначе
		
		ЗначениеСтрокой = Строка(ЗначениеЭлемента);
		РезультатСтрокойЧислел = "";
		
		Для а = 1 По СтрДлина(ЗначениеСтрокой) Цикл
			КодСимвола = КодСимвола(Сред(ЗначениеСтрокой, а, 1));
			Цифра = Сред(ЗначениеСтрокой, а, 1);
			Если (КодСимвола >= 48 И КодСимвола <= 57)        // Цифры
				ИЛИ КодСимвола = 46 ИЛИ КодСимвола = 44 Тогда // Разделители: "." и ","
				Если КодСимвола = 44 Тогда 
					Цифра = ".";
				КонецЕсли;
				Если а = СтрДлина(ЗначениеСтрокой) 
					И Цифра = "." Тогда 
					// Это последняя точка. Она не нужна
					Цифра = "";
				КонецЕсли;
				РезультатСтрокойЧислел = РезультатСтрокойЧислел + Цифра;
			КонецЕсли; 
		КонецЦикла;
		
		Если НЕ РезультатСтрокойЧислел = "" Тогда 
			Результат = Число(РезультатСтрокойЧислел);
		Иначе
			Результат = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции

