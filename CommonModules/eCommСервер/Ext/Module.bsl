#Если ТолстыйКлиентОбычноеПриложение Тогда
Функция ЗаказПокупателя_ФормаДокумента_ПередОткрытием(Форма, Отказ, СтандартнаяОбработка) Экспорт

	ЕстьИнтернетРеквизиты = Ложь;
	
	Если ПравоДоступа("Чтение", Метаданные.Справочники.eComm_СостоянияЗаказовПокупателей) Тогда 
		
		// В разных конфигурациях ширина формы разная
		// поэтому будем равняться по "типовым" элементам
		ЭлементДоговор = Форма.ЭлементыФормы.Найти("ДоговорКонтрагента");
		ДоговорЛево 	= ЭлементДоговор.Лево;
		ДоговорШирина 	= ЭлементДоговор.Ширина;

		Элемент = Форма.ЭлементыФормы.Добавить(Тип("Надпись"), "НадписьСостояние", Истина);
		Элемент.Лево 		= ДоговорЛево - 104;	// По умолчанию для УТП: 414
		Элемент.Верх 		= 56;
		Элемент.Ширина 		= 91;
		Элемент.Высота 		= 19;	
		Элемент.Заголовок 	= "Состояние:";
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, Форма.Панель, ГраницаЭлементаУправления.Право, Форма.Панель, ГраницаЭлементаУправления.Лево);
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, Форма.ЭлементыФормы.Организация, ГраницаЭлементаУправления.Право);
		
		Элемент = Форма.ЭлементыФормы.Добавить(Тип("ПолеВвода"), "eComm_СостояниеЗаказа", Истина);
		Элемент.Лево 		= ДоговорЛево;			// По умолчанию для УТП: 518
		Элемент.Верх 		= 56;
		Элемент.Ширина 		= ДоговорШирина;		// По умолчанию для УТП: 371
		Элемент.Высота 		= 19;	
		Элемент.Данные 		= "eComm_СостояниеЗаказа";	
		Элемент.ИзменяетДанные = Истина;
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, Форма.ЭлементыФормы["НадписьСостояние"], ГраницаЭлементаУправления.Право);
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, Форма.Панель, ГраницаЭлементаУправления.Право);
		Элемент.УстановитьДействие("НачалоВыбора", Новый Действие("СостояниеНачалоВыбора"));
		
		ЕстьИнтернетРеквизиты = Истина;
		
	КонецЕсли;

	Если ПравоДоступа("Чтение", Метаданные.Справочники.eComm_УчетныеЗаписи) Тогда
		
		ЭлементДополнение = Форма.ЭлементыФормы.Найти("ДополнениеКАдресуДоставки");
		ДополнениеЛево 		= ЭлементДополнение.Лево;
		ДополнениеШирина 	= ЭлементДополнение.Ширина;
		ДополнениеВерх		= ЭлементДополнение.Верх;
		
		Форма.ЭлементыФормы.ОсновнаяПанель.ТекущаяСтраница = Форма.ЭлементыФормы.ОсновнаяПанель.Страницы.Дополнительно;
		
		Элемент = Форма.ЭлементыФормы.Добавить(Тип("Надпись"), "НадписьИсточник", Истина, Форма.ЭлементыФормы.ОсновнаяПанель);
		Элемент.Лево 		= ДополнениеЛево - 107;
		Элемент.Верх 		= ДополнениеВерх + 23;	// По умолчанию для УТП: 187
		Элемент.Ширина 		= 99;
		Элемент.Высота 		= 19;	
		Элемент.Заголовок 	= "Источник:";
		Если ДополнениеВерх = 187 Тогда 
			// Для УТП привязка своя:
			Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, Форма.Панель, ГраницаЭлементаУправления.Право, Форма.Панель, ГраницаЭлементаУправления.Лево);
			Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, Форма.Панель, ГраницаЭлементаУправления.Право, Форма.Панель, ГраницаЭлементаУправления.Лево);
		Иначе
			//Для УПП - своя
			Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, Форма.ЭлементыФормы.ДокументОснование, ГраницаЭлементаУправления.Право);
			Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, Форма.ЭлементыФормы.ДокументОснование, ГраницаЭлементаУправления.Право);
		КонецЕсли;

		Элемент = Форма.ЭлементыФормы.Добавить(Тип("ПолеВвода"), "eComm_ИсточникЗаказа", Истина, Форма.ЭлементыФормы.ОсновнаяПанель);
		Элемент.Лево 		= ДополнениеЛево;		// По умолчанию для УТП: 515
		Элемент.Верх 		= ДополнениеВерх + 23;	// По умолчанию для УТП: 187
		Элемент.Ширина 		= ДополнениеШирина;		// По умолчанию для УТП: 358
		Элемент.Высота 		= 19;	
		Элемент.Данные 		= "eComm_ИсточникЗаказа";	
		Элемент.ИзменяетДанные = Истина;
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, Форма.ЭлементыФормы.НадписьОтветственный, ГраницаЭлементаУправления.Право);
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, Форма.Панель, ГраницаЭлементаУправления.Право);
		
		Форма.ЭлементыФормы.ОсновнаяПанель.ТекущаяСтраница = Форма.ЭлементыФормы.ОсновнаяПанель.Страницы.Товары;
		
		ЕстьИнтернетРеквизиты = Истина;
		
	КонецЕсли;
	
	Если ЕстьИнтернетРеквизиты = Истина Тогда 
		
		Элемент = Форма.ЭлементыФормы.Добавить(Тип("Надпись"), "НадписьНомерНаСайте", Истина);
		Элемент.Лево 		= 414;
		Элемент.Верх 		= 32;
		Элемент.Ширина 		= 91;
		Элемент.Высота 		= 19;	
		Элемент.Заголовок 	= "Номер на сайте:";
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, Форма.ЭлементыФормы.НадписьСостояние, ГраницаЭлементаУправления.Лево);
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, Форма.ЭлементыФормы.НадписьСостояние, ГраницаЭлементаУправления.Лево);
		
		Элемент = Форма.ЭлементыФормы.Добавить(Тип("ПолеВвода"), "НомерВходящегоДокументаЭлектронногоОбмена", Истина);
		Элемент.Лево 		= 518;
		Элемент.Верх 		= 32;
		Элемент.Ширина 		= 120;
		Элемент.Высота 		= 19;	
		Элемент.Данные 		= "НомерВходящегоДокументаЭлектронногоОбмена";	
		Элемент.ИзменяетДанные = Истина;
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, Форма.ЭлементыФормы.НадписьНомерНаСайте, ГраницаЭлементаУправления.Право);
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, Форма.ЭлементыФормы.НадписьНомерНаСайте, ГраницаЭлементаУправления.Право);
		
		Элемент = Форма.ЭлементыФормы.Добавить(Тип("Надпись"), "НадписьДатаНаСайте", Истина);
		Элемент.Лево 		= 650;
		Элемент.Верх 		= 32;
		Элемент.Ширина 		= 91;
		Элемент.Высота 		= 19;	
		Элемент.Заголовок 	= "Дата на сайте:";
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, Форма.ЭлементыФормы.НомерВходящегоДокументаЭлектронногоОбмена, ГраницаЭлементаУправления.Лево);
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, Форма.ЭлементыФормы.НомерВходящегоДокументаЭлектронногоОбмена, ГраницаЭлементаУправления.Лево);
		
		Элемент = Форма.ЭлементыФормы.Добавить(Тип("ПолеВвода"), "ДатаВходящегоДокументаЭлектронногоОбмена", Истина);
		Элемент.Лево 		= 741;
		Элемент.Верх 		= 32;
		Элемент.Ширина 		= 120;
		Элемент.Высота 		= 19;	
		Элемент.Данные 		= "ДатаВходящегоДокументаЭлектронногоОбмена";	
		Элемент.ИзменяетДанные = Истина;
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, Форма.ЭлементыФормы.НадписьДатаНаСайте, ГраницаЭлементаУправления.Право);
		Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, Форма.ЭлементыФормы.НадписьДатаНаСайте, ГраницаЭлементаУправления.Право);
		
	КонецЕсли;

КонецФункции
#КонецЕсли

Процедура ПрочитатьИнтернетТовары(Форма) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры
		|ПОМЕСТИТЬ НоменклатураХарактеристика
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	(НЕ Номенклатура.ВестиУчетПоХарактеристикам
		|			ИЛИ НЕ &ИспользоватьХарактеристики)
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И Номенклатура.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО Номенклатура.Ссылка = ХарактеристикиНоменклатуры.Владелец
		|ГДЕ
		|	&ИспользоватьХарактеристики
		|	И Номенклатура.ВестиУчетПоХарактеристикам
		|	И Номенклатура.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НоменклатураХарактеристика.Номенклатура,
		|	НоменклатураХарактеристика.ХарактеристикаНоменклатуры,
		|	eComm_УчетныеЗаписи.Ссылка КАК Владелец
		|ПОМЕСТИТЬ НоменклатураХаратктеристикаВладелец
		|ИЗ
		|	НоменклатураХарактеристика КАК НоменклатураХарактеристика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.eComm_УчетныеЗаписи КАК eComm_УчетныеЗаписи
		|		ПО (ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НоменклатураХаратктеристикаВладелец.Номенклатура,
		|	НоменклатураХаратктеристикаВладелец.ХарактеристикаНоменклатуры,
		|	НоменклатураХаратктеристикаВладелец.Владелец КАК Владелец,
		|	eComm_ИнтернетТовары.Ссылка КАК ИнтернетТовар,
		|	eComm_ИнтернетТовары.Категория,
		|	eComm_ИнтернетТовары.Отключить,
		|	eComm_ИнтернетТовары.Код
		|ИЗ
		|	НоменклатураХаратктеристикаВладелец КАК НоменклатураХаратктеристикаВладелец
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|		ПО НоменклатураХаратктеристикаВладелец.Номенклатура = eComm_ИнтернетТовары.Номенклатура
		|			И НоменклатураХаратктеристикаВладелец.ХарактеристикаНоменклатуры = eComm_ИнтернетТовары.ХарактеристикаНоменклатуры
		|			И НоменклатураХаратктеристикаВладелец.Владелец = eComm_ИнтернетТовары.Владелец

		|ИТОГИ ПО
		|	Владелец";
	
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики"	, Константы.ИспользоватьХарактеристикиНоменклатуры.Получить());
	Запрос.УстановитьПараметр("Ссылка"						, Форма.Ссылка);
	Форма.ИнтернетТовары = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецПроцедуры

Процедура ЗаказПокупателя_ФормаДокумента_ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт

	Если НЕ ПравоДоступа("Чтение", Метаданные.Справочники.eComm_УчетныеЗаписи) Тогда 
		Возврат;
	КонецЕсли;
	
	ГруппаДляРазмещенияРеквизита = ?(ИмяКонфигурации() = "BASSmallBusiness", "ДополнительноПраво", "ГруппаПараметрыПраво");
	
	Элемент = Форма.Элементы.Добавить("eComm_ИсточникЗаказа", Тип("ПолеФормы"), Форма.Элементы[ГруппаДляРазмещенияРеквизита]);
	Элемент.Вид 				= ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным 		= "Объект.eComm_ИсточникЗаказа";
	Элемент.Заголовок	 		= "Источник заказа";
	Элемент.ПоложениеЗаголовка 	= ПоложениеЗаголовкаЭлементаФормы.Авто;
	Элемент.Видимость 			= Истина;
	Элемент.Доступность 		= Истина;
	Элемент.ТолькоПросмотр 		= Ложь;
	Элемент.КнопкаСпискаВыбора 	= Неопределено;
	Элемент.КнопкаВыбора 		= Неопределено;
	Элемент.КнопкаОчистки 		= Неопределено;
	Элемент.КнопкаРегулирования = Неопределено;
	Элемент.КнопкаОткрытия 		= Неопределено;

КонецПроцедуры

Процедура ИнтернетРеквизиты_ФормаДокумента_ПриСозданииНаСервере(Форма, Отказ) Экспорт

	ЭтоУТП = ИмяКонфигурации() = "УправлениеТорговымПредприятиемДляУкраины";
	ИмяОбъектаСвойствТовара = ВернутьИмяПрикладногоОбъекта("ЗначенияСвойствНоменклатуры", Истина);
	ИмяСсылкиТовараВСвойстве = ВернутьИмяРеквизитаОбъекта("ЗначенияСвойствНоменклатуры", "Номенклатура");
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	НоменклатураДополнительныеРеквизиты.Свойство КАК Свойство,
		|	НоменклатураДополнительныеРеквизиты.Свойство#ИмяРеквизита_НаименованиеСвойства# КАК НаименованиеСвойства,
		|	НоменклатураДополнительныеРеквизиты.Значение КАК Значение,
		|	MP_СвойстваТоваров.Наименование КАК Наименование,
		|	MP_СвойстваТоваров.Отключить КАК Отключить,
		|	MP_СвойстваТоваров.Ссылка КАК Ссылка
		|ИЗ
		|	#ИмяОбъектаСвойствТовара# КАК НоменклатураДополнительныеРеквизиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_СвойстваТоваров КАК MP_СвойстваТоваров
		|		ПО НоменклатураДополнительныеРеквизиты.Свойство = MP_СвойстваТоваров.Свойство
		|			И (MP_СвойстваТоваров.Владелец = &УчетнаяЗапись)
		|ГДЕ
		|	НоменклатураДополнительныеРеквизиты.#ИмяСсылкиТовараВСвойстве# = &Номенклатура";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаСвойствТовара#"			, ИмяОбъектаСвойствТовара);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяСсылкиТовараВСвойстве#"			, ИмяСсылкиТовараВСвойстве);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_НаименованиеСвойства#"	, ?(ЭтоУТП, "", ".Заголовок"));
	
	Форма.СписокСвойств.ТекстЗапроса = ТекстЗапроса;

КонецПроцедуры

