Процедура ДополнитьНастройкиПараметрамиПодключения(СтруктураНастроек, АдресAPI)
	
	АдресСайта = СокрЛП(АдресAPI); 
	
	Сервер 					= ""; 
	Порт 					= 0;
	ЗащищенноеСоединение 	= Ложь;
	
	Если НЕ ПустаяСтрока(АдресСайта) Тогда
		
		АдресСайта = СтрЗаменить(АдресСайта, "\", "/");
		АдресСайта = СтрЗаменить(АдресСайта, " ", "");
		
		Если НРег(Лев(АдресСайта, 7)) = "http://" Тогда
			Сервер = Сред(АдресСайта, 8);
		ИначеЕсли НРег(Лев(АдресСайта, 8)) = "https://" Тогда
			Сервер = Сред(АдресСайта, 9);
			ЗащищенноеСоединение = Истина;
		Иначе
			Сервер = АдресСайта;
		КонецЕсли;
		
		ПозицияДвоеточия = Найти(Сервер, ":");
		ПортСтрока = "0";
		Если ПозицияДвоеточия > 0 Тогда
			СерверСПортом = Сервер;
			Сервер = Лев(СерверСПортом, ПозицияДвоеточия - 1);
			ПортСтрока = Прав(СерверСПортом, СтрДлина(СерверСПортом) - ПозицияДвоеточия);
		КонецЕсли;
		
		Попытка
			
			Порт = Число(ПортСтрока);
			
		Исключение
			
			Сообщить("Не удалось получить номер порта: " + ПортСтрока + Символы.ПС
					+ "Проверьте правильность ввода адреса сайта.");
				
		КонецПопытки;
		
		Если Порт = 0 Тогда
			Порт = ?(ЗащищенноеСоединение, 443, 80);
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураНастроек.Вставить("HTTP_Сервер"				, Сервер); 
	СтруктураНастроек.Вставить("HTTP_Порт"					, Порт);
	СтруктураНастроек.Вставить("HTTP_ЗащищенноеСоединение"	, ЗащищенноеСоединение);
	
КонецПроцедуры

Процедура ДополнитьНастройкиОптовымиЦенами(СтруктураНастроек)

	ОптовыеЦены = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОптовыеЦены.Ссылка КАК Ссылка,
		|	ОптовыеЦены.НомерСтроки КАК НомерСтроки,
		|	ОптовыеЦены.ВидЦены КАК ВидЦены
		//|	ОптовыеЦены.КодЦеныНаСайте КАК КодЦеныНаСайте
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи.ОптовыеЦены КАК ОптовыеЦены
		|ГДЕ
		|	ОптовыеЦены.Ссылка = &УчетнаяЗапись";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", СтруктураНастроек.УчетнаяЗапись);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		ОптовыеЦены.Добавить(РезультатЗапроса.ВидЦены);
	КонецЦикла;
	
	СтруктураНастроек.Вставить("ОптовыеЦены", ОптовыеЦены);

КонецПроцедуры

Процедура ДополнитьНастройкиУровнямиЦен(СтруктураНастроек)

	Если НЕ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop Тогда 
		Возврат;
	КонецЕсли;
	
	УровниЦен = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УровниЦенB2B.Ссылка КАК Ссылка,
		|	УровниЦенB2B.НомерСтроки КАК НомерСтроки,
		|	УровниЦенB2B.ВидЦены КАК ВидЦены,
		|	УровниЦенB2B.КодЦеныНаСайте КАК КодЦеныНаСайте
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписи.УровниЦенB2B КАК УровниЦенB2B
		|ГДЕ
		|	УровниЦенB2B.Ссылка = &УчетнаяЗапись";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", СтруктураНастроек.УчетнаяЗапись);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
