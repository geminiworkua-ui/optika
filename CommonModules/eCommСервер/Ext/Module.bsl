			ИначеЕсли ИмяОбъекта = "ОперацияПоПлатежнымКартам" Тогда 	
				Результат = "";
			КонецЕсли;
			
		ИначеЕсли ИмяКонфигурации = "BASSmallBusiness" Тогда
			
			Если ИмяОбъекта = "ЗначенияСвойствНоменклатуры" Тогда 
				Результат = ?(ИспользоватьПолноеИмя = Истина, "Справочник.Номенклатура.", "") + "ДополнительныеРеквизиты";
			ИначеЕсли ИмяОбъекта = "ЗначенияСвойствХарактеристики" Тогда 
