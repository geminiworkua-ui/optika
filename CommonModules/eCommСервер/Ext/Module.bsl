Функция ИмяКонфигурации() Экспорт

	ИспользоватьВстроенныйОбработчик = Истина;
	
	ИмяКонфигурации = eCommСерверПереопределяемый.ИмяКонфигурации(ИспользоватьВстроенныйОбработчик);
	
	Если НЕ ИспользоватьВстроенныйОбработчик = Ложь Тогда
		
		ИмяКонфигурации = Метаданные.Имя;
		
		Если ИмяКонфигурации = "УправлениеНебольшойФирмойДляУкраины" 
			ИЛИ ИмяКонфигурации = "УправлениеШвейнымПроизводствомДляУкраины" Тогда 
			ИмяКонфигурации = "BASSmallBusiness";
		ИначеЕсли ИмяКонфигурации = "УправлениеПроизводственнымПредприятиемДляУкраины" 
			ИЛИ ИмяКонфигурации = "УправлениеТорговлейДляУкраины" Тогда 
			ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины";
		ИначеЕсли ИмяКонфигурации = "BASERP" 
			ИЛИ ИмяКонфигурации = "BASКомплексноеУправлениеПредприятием" Тогда 
			ИмяКонфигурации = "BASУправлениеТорговлей";
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ИмяКонфигурации;
	
КонецФункции

