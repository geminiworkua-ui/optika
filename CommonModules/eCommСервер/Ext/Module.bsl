		//	|	ПланОбмена.eComm_Обмен КАК УзлыОбмена
		//	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.eComm_УчетныеЗаписи КАК УчетныеЗаписи
		//	|		ПО УзлыОбмена.УчетнаяЗапись = УчетныеЗаписи.Ссылка
		//	|ГДЕ
		//	|	УзлыОбмена.ПометкаУдаления = ЛОЖЬ
		//	|	И УчетныеЗаписи.ВыгружатьТовары = ИСТИНА
		//	|			И УчетныеЗаписи.ВыгружатьТолькоИзменения = ИСТИНА
		//	|			И УчетныеЗаписи.ПометкаУдаления = ЛОЖЬ";

		//ВыборкаУзлов = Запрос.Выполнить().Выбрать();
		//Если ВыборкаУзлов.Количество() = 0 Тогда 
		//	Возврат;
		//КонецЕсли;
		//
		//ИмяРеквизитаВидЦен = eCommСервер.ВернутьИмяРеквизитаОбъекта("ЦеныНоменклатуры", "ВидЦен");
		//
		//Для каждого Запись Из Источник Цикл
		//	
		//	Если НЕ ЗначениеЗаполнено(Запись.Номенклатура) Тогда 
		//		Продолжить;
		//	КонецЕсли;
		//	
		//	ВыборкаУзлов.Сбросить();
		//	Пока ВыборкаУзлов.Следующий() Цикл 
		//		
		//		Если ВыборкаУзлов.ТипЦены = Запись[ИмяРеквизитаВидЦен] Тогда 
		//			// Пометим не все позиции, а только те, по которым тип цены
		//			// совпадает с выгружаемой ценой учетной записи
		//			ПланыОбмена.ЗарегистрироватьИзменения(ВыборкаУзлов.УзелОбмена, Запись.Номенклатура);
		//		КонецЕсли;
		//		
		//	КонецЦикла;
		//	
		//КонецЦикла;
		
		ИмяРеквизитаВидЦен = eCommСервер.ВернутьИмяРеквизитаОбъекта("ЦеныНоменклатуры", "ВидЦен");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	eComm_УчетныеЗаписи.Ссылка КАК УчетнаяЗапись,
			|	eComm_УчетныеЗаписи.ТипЦены КАК ТипЦены
			|ПОМЕСТИТЬ ВрТаб
			|ИЗ
			|	Справочник.eComm_УчетныеЗаписи КАК eComm_УчетныеЗаписи
			|ГДЕ
			|	eComm_УчетныеЗаписи.ПометкаУдаления = ЛОЖЬ
			|	И eComm_УчетныеЗаписи.ВыгружатьТовары = ИСТИНА
			|	И eComm_УчетныеЗаписи.ВыгружатьТолькоИзменения = ИСТИНА
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	eComm_УчетныеЗаписиОптовыеЦены.Ссылка,
			|	eComm_УчетныеЗаписиОптовыеЦены.ВидЦены
			|ИЗ
			|	Справочник.eComm_УчетныеЗаписи.ОптовыеЦены КАК eComm_УчетныеЗаписиОптовыеЦены
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.eComm_УчетныеЗаписи КАК eComm_УчетныеЗаписи
			|		ПО eComm_УчетныеЗаписиОптовыеЦены.Ссылка = eComm_УчетныеЗаписи.Ссылка
			|ГДЕ
			|	eComm_УчетныеЗаписи.ПометкаУдаления = ЛОЖЬ
			|	И eComm_УчетныеЗаписи.ВыгружатьТовары = ИСТИНА
			|	И eComm_УчетныеЗаписи.ВыгружатьТолькоИзменения = ИСТИНА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВрТаб.ТипЦены КАК ВидЦены,
			|	eComm_Обмен.Ссылка КАК УзелОбмена
			|ИЗ
			|	ВрТаб КАК ВрТаб
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланОбмена.eComm_Обмен КАК eComm_Обмен
			|		ПО ВрТаб.УчетнаяЗапись = eComm_Обмен.УчетнаяЗапись
			|
			|СГРУППИРОВАТЬ ПО
			|	eComm_Обмен.Ссылка,
			|	ВрТаб.ТипЦены
			|ИТОГИ ПО
			|	ВидЦены";
		
		ВыборкаТипЦены = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		// Определим изменения каких видов цен и для 
		// каких узлов обмена будут отслеживаться
		СоответствиеВидовЦенУзлам = Новый Соответствие;
		
		Пока ВыборкаТипЦены.Следующий() Цикл
			
			МассивУзловОбмена = Новый Массив;
			
			ВыборкаДетальныеЗаписи = ВыборкаТипЦены.Выбрать();
		
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				МассивУзловОбмена.Добавить(ВыборкаДетальныеЗаписи.УзелОбмена);
			КонецЦикла;
			
			СоответствиеВидовЦенУзлам.Вставить(ВыборкаТипЦены.ВидЦены, МассивУзловОбмена);
			
		КонецЦикла;
		
		// Получим соответствие номенклатуры узлам обмена,
		// для которых актуальна выгрузка отслеживаемых цен
		// (цены фиксируются в настройках учетной записи торг. площадки)
		СоответствиеНоменклатурыУзламОбмена = Новый Соответствие;
		
		Для каждого Запись Из Источник Цикл
			
			Если НЕ ЗначениеЗаполнено(Запись.Номенклатура) Тогда 
				Продолжить;
			КонецЕсли;
			
			Если СоответствиеНоменклатурыУзламОбмена[Запись.Номенклатура] = Неопределено Тогда 
				СоответствиеНоменклатурыУзламОбмена.Вставить(Запись.Номенклатура, Новый Массив); 
			КонецЕсли;
			
			УзлыОбменаВидаЦен = СоответствиеВидовЦенУзлам[Запись[ИмяРеквизитаВидЦен]];
			
			Если ТипЗнч(УзлыОбменаВидаЦен) = Тип("Массив") Тогда 
				Для Каждого УзелОбмена Из УзлыОбменаВидаЦен Цикл 
					Если СоответствиеНоменклатурыУзламОбмена[Запись.Номенклатура].Найти(УзелОбмена) = Неопределено Тогда 
						 СоответствиеНоменклатурыУзламОбмена[Запись.Номенклатура].Добавить(УзелОбмена)
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		// Пометим к обмену номенклатуру с измененными ценами
		Для Каждого КлючЗначение Из СоответствиеНоменклатурыУзламОбмена Цикл  
			Если КлючЗначение.Значение.Количество() > 0 Тогда 
				ПланыОбмена.ЗарегистрироватьИзменения(КлючЗначение.Значение, КлючЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
	
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей." + ВернутьИмяПрикладногоОбъекта("СвободныеОстатки")) Тогда 
		
		МассивУзловТовары = МассивУзловДляРегистрации();
		Если МассивУзловТовары.Количество() = 0 Тогда 
			Возврат;
		КонецЕсли;
		
		Для каждого Запись Из Источник Цикл
			Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда 
				ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловТовары, Запись.Номенклатура);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция МассивУзловДляРегистрации(УчетнаяЗапись = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УзлыОбмена.Ссылка КАК УзелОбмена
		|ИЗ
		|	ПланОбмена.eComm_Обмен КАК УзлыОбмена
		|ГДЕ
		|	УзлыОбмена.ПометкаУдаления = ЛОЖЬ
		|	И УзлыОбмена.УчетнаяЗапись В
		|			(ВЫБРАТЬ
		|				УчетныеЗаписи.Ссылка КАК Ссылка
		|			ИЗ
		|				Справочник.eComm_УчетныеЗаписи КАК УчетныеЗаписи
		|			ГДЕ
		|				ВЫБОР
		|					КОГДА &УчетнаяЗапись = НЕОПРЕДЕЛЕНО
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ УзлыОбмена.УчетнаяЗапись = &УчетнаяЗапись
		|				КОНЕЦ
		|				И УчетныеЗаписи.ВыгружатьТовары = ИСТИНА
		|				И УчетныеЗаписи.ВыгружатьТолькоИзменения = ИСТИНА
		|				И УчетныеЗаписи.ПометкаУдаления = ЛОЖЬ)";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("УзелОбмена");
	
	Возврат РезультатЗапроса;
	
КонецФункции

