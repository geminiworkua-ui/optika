	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда 
		
		ИмяКонфигурации = ИмяКонфигурации();
		
		Если ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
			
			Если ИмяОбъекта = "ЗначенияСвойствНоменклатуры" Тогда 
				Результат = ?(ИспользоватьПолноеИмя = Истина, "РегистрСведений.", "") + "ЗначенияСвойствОбъектов";
			ИначеЕсли ИмяОбъекта = "ЗначенияСвойствХарактеристики" Тогда 
