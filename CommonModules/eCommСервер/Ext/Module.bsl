Процедура ПередЗаписьюОперацииПоПлатежнымКартам(СтруктураНастроек, ДокументОбъект, Выборка) Экспорт

	ИмяКонфигурации = ИмяКонфигурации();
	
	Если ИмяКонфигурации = "BASSmallBusiness" Тогда 
		
		МодульНалогиУНФ 						= ОбщийМодуль("НалогиУНФ");
		МодульУправлениеНебольшойФирмойПовтИсп 	= ОбщийМодуль("УправлениеНебольшойФирмойПовтИсп");
		
		Если НЕ МодульНалогиУНФ = Неопределено Тогда 
			
			ДокументОбъект.НалогообложениеНДС = МодульНалогиУНФ.НалогообложениеНДС(ДокументОбъект.Организация,, ДокументОбъект.Дата);
			
			Если ДокументОбъект.НалогообложениеНДС = Перечисления["ТипыНалогообложенияНДС"].ОблагаетсяНДС Тогда
				СтавкаНДСПоУмолчанию = Справочники["СтавкиНДС"].СтавкаНДС(ДокументОбъект.Организация.ВидСтавкиНДСПоУмолчанию, ?(ЗначениеЗаполнено(ДокументОбъект.Дата), ДокументОбъект.Дата, ТекущаяДатаСеанса()));
			ИначеЕсли ДокументОбъект.НалогообложениеНДС = Перечисления["ТипыНалогообложенияНДС"].НеОблагаетсяНДС Тогда
				СтавкаНДСПоУмолчанию = МодульУправлениеНебольшойФирмойПовтИсп.ПолучитьСтавкуНДСБезНДС();
			Иначе
				СтавкаНДСПоУмолчанию = МодульУправлениеНебольшойФирмойПовтИсп.ПолучитьСтавкуНДСНоль();
			КонецЕсли;
			
			Для Каждого Стр Из ДокументОбъект.РасшифровкаПлатежа Цикл 
				Если НЕ ЗначениеЗаполнено(Стр.СтавкаНДС) Тогда 
					Стр.СтавкаНДС = СтавкаНДСПоУмолчанию;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации = "BASУправлениеТорговлей" Тогда 
		
		ДокументОбъект["СтатьяДвиженияДенежныхСредств"] = Справочники["СтатьиДвиженияДенежныхСредств"].ПоступлениеОплатыОтКлиента;
		
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда 
			ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
			//Если НЕ ЗначениеЗаполнено(ТекПользователь) Тогда 
			//	ТекПользователь = Справочники.Пользователи.НайтиПоНаименованию("1c");
			//КонецЕсли;
			ДокументОбъект.Ответственный = ТекПользователь;
		КонецЕсли;
		
		Для Каждого Стр Из ДокументОбъект.РасшифровкаПлатежа Цикл 
			Если НЕ ЗначениеЗаполнено(Стр.ОснованиеПлатежа) Тогда 
				Стр.ОснованиеПлатежа = Стр.Заказ;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Стр.СтатьяДвиженияДенежныхСредств) Тогда 
				Стр.СтатьяДвиженияДенежныхСредств = Справочники["СтатьиДвиженияДенежныхСредств"].ПоступлениеОплатыОтКлиента;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьОперацияПоПлатежнымКартам(СтруктураНастроек, ДокументОбъект, Выборка) Экспорт

