		|	СГРУППИРОВАТЬ ПО
		|		ТоварыВРозницеОстатки.Номенклатура,
		|		ВЫБОР
		|			КОГДА &ИспользоватьХарактеристики
		|				ТОГДА ТоварыВРозницеОстатки.ХарактеристикаНоменклатуры
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|		КОНЕЦ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ТоварыВРезервеНаСкладахОстатки.Номенклатура,
		|		ВЫБОР
		|			КОГДА &ИспользоватьХарактеристики
		|				ТОГДА ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|		КОНЕЦ,
		|		СУММА(-ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток)
		|	ИЗ
		|		РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеНаСкладахОстатки
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ТоварыВРезервеНаСкладахОстатки.Номенклатура,
		|		ВЫБОР
		|			КОГДА &ИспользоватьХарактеристики
		|				ТОГДА ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
		|			ИНАЧЕ ЗНАЧЕНИЕ(справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|		КОНЕЦ,
		|		ВЫБОР
		|			КОГДА &ИспользоватьХарактеристики
		|				ТОГДА ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|		КОНЕЦ) КАК ЗапросПоОстаткам
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗапросПоОстаткам.Номенклатура,
		|	ЗапросПоОстаткам.ХарактеристикаНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.ЭтоГруппа,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры
		|ПОМЕСТИТЬ СправочникНоменклатуры
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	(НЕ Номенклатура.ВестиУчетПоХарактеристикам
		|			ИЛИ НЕ &ИспользоватьХарактеристики)
		|	И НЕ Номенклатура.ЭтоГруппа
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.ЭтоГруппа,
		|	ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО Номенклатура.Ссылка = ХарактеристикиНоменклатуры.Владелец
		|ГДЕ
		|	&ИспользоватьХарактеристики
		|	И Номенклатура.ВестиУчетПоХарактеристикам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗапросПоЦенам.Номенклатура,
		|	ЗапросПоЦенам.Цена,
		|	ЗапросПоЦенам.ХарактеристикаНоменклатуры,
		|	ЗапросПоЦенам.Валюта
		|ПОМЕСТИТЬ ТаблицаЦен
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|		МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Цена) КАК Цена,
		|		ВЫБОР
		|			КОГДА &ИспользоватьХарактеристики
		|				ТОГДА ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.пустаяСсылка)
		|		КОНЕЦ КАК ХарактеристикаНоменклатуры,
		|		ЦеныНоменклатурыСрезПоследних.ТипЦен КАК ТипЦен,
		|		ЦеныНоменклатурыСрезПоследних.Валюта КАК Валюта
		|	ИЗ
		|		РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ТекущаяДата, ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ЦеныНоменклатурыСрезПоследних.Номенклатура,
		|		ВЫБОР
		|			КОГДА &ИспользоватьХарактеристики
		|				ТОГДА ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|		КОНЕЦ,
		|		ЦеныНоменклатурыСрезПоследних.ТипЦен,
		|		ЦеныНоменклатурыСрезПоследних.Валюта,
		|		ВЫБОР
		|			КОГДА &ИспользоватьХарактеристики
		|				ТОГДА ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.пустаяСсылка)
		|		КОНЕЦ) КАК ЗапросПоЦенам
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗапросПоЦенам.Номенклатура,
		|	ЗапросПоЦенам.Цена,
		|	ЗапросПоЦенам.ХарактеристикаНоменклатуры,
		|	ЗапросПоЦенам.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НоменклатураСпр.Ссылка КАК Номенклатура,
		|	НоменклатураСпр.ЭтоГруппа КАК ЭтоГруппа,
		|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
		|	0 КАК ЦенаОпт,
		|	ЦеныНоменклатурыСрезПоследних.Валюта,
		|	ВЫБОР
		|		КОГДА НЕ &ОграничениеМаксимальогоОстатка = 0
		|			ТОГДА ВЫБОР
		|					КОГДА &ОграничениеМаксимальогоОстатка >= ЕСТЬNULL(ОстаткиНоменклатуры.КоличествоОстаток, 0)
		|							И &ОграничениеМинимальногоОстатка <= ЕСТЬNULL(ОстаткиНоменклатуры.КоличествоОстаток, 0)
		|						ТОГДА ЕСТЬNULL(ОстаткиНоменклатуры.КоличествоОстаток, 0)
		|					КОГДА &ОграничениеМаксимальогоОстатка >= ЕСТЬNULL(ОстаткиНоменклатуры.КоличествоОстаток, 0)
		|							И &ОграничениеМинимальногоОстатка >= ЕСТЬNULL(ОстаткиНоменклатуры.КоличествоОстаток, 0)
		|						ТОГДА &ОграничениеМинимальногоОстатка
		|					КОГДА &ОграничениеМаксимальогоОстатка <= ЕСТЬNULL(ОстаткиНоменклатуры.КоличествоОстаток, 0)
		|							И &ОграничениеМинимальногоОстатка <= ЕСТЬNULL(ОстаткиНоменклатуры.КоличествоОстаток, 0)
		|						ТОГДА &ОграничениеМаксимальогоОстатка
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА &ОграничениеМинимальногоОстатка >= ЕСТЬNULL(ОстаткиНоменклатуры.КоличествоОстаток, 0)
		|					ТОГДА &ОграничениеМинимальногоОстатка
		|				ИНАЧЕ ЕСТЬNULL(ОстаткиНоменклатуры.КоличествоОстаток, 0)
		|			КОНЕЦ
		|	КОНЕЦ КАК КоличествоОстаток,
		|	НоменклатураСпр.Ссылка.Код КАК Код,
		|	НоменклатураСпр.Ссылка.Наименование КАК Наименование,
		|	НоменклатураСпр.ХарактеристикаНоменклатуры,
		|	ИнтернетРеквизитыТоваров.Ссылка КАК ИнтернетТовар,
		//|	"""" КАК Цвет,
		|   НоменклатураПрисоединенныеФайлы.КоличествоПрисоединенныхФайлов
		|ИЗ
		|	СправочникНоменклатуры КАК НоменклатураСпр
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаЦен КАК ЦеныНоменклатурыСрезПоследних
		|		ПО НоменклатураСпр.Ссылка = ЦеныНоменклатурыСрезПоследних.Номенклатура
		|			И НоменклатураСпр.ХарактеристикаНоменклатуры = ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиНоменклатуры КАК ОстаткиНоменклатуры
		|		ПО НоменклатураСпр.Ссылка = ОстаткиНоменклатуры.Номенклатура
		|			И НоменклатураСпр.ХарактеристикаНоменклатуры = ОстаткиНоменклатуры.ХарактеристикаНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_ИнтернетТовары КАК ИнтернетРеквизитыТоваров
		|			ПО НоменклатураСпр.Ссылка = ИнтернетРеквизитыТоваров.Номенклатура
		|			И НоменклатураСпр.ХарактеристикаНоменклатуры = ИнтернетРеквизитыТоваров.ХарактеристикаНоменклатуры
		|			И ИнтернетРеквизитыТоваров.Владелец = &УчетнаяЗапись
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ХранилищеДополнительнойИнформации.Ссылка) КАК КоличествоПрисоединенныхФайлов,
		|				ХранилищеДополнительнойИнформации.Объект КАК Номенклатура
		|			ИЗ
		|				Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
		|			ГДЕ
		|				ХранилищеДополнительнойИнформации.Объект ССЫЛКА Справочник.Номенклатура
		|				И ХранилищеДополнительнойИнформации.Объект В
		|					(ВЫБРАТЬ
		|						СправочникНоменклатуры.Ссылка
		|					ИЗ
		|						СправочникНоменклатуры КАК СправочникНоменклатуры)
		|				И ХранилищеДополнительнойИнформации.ВидДанных = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительнойИнформацииОбъектов.Изображение)
		|		
		|			СГРУППИРОВАТЬ ПО
		|				ХранилищеДополнительнойИнформации.Объект) КАК НоменклатураПрисоединенныеФайлы
		|		ПО НоменклатураСпр.Ссылка = НоменклатураПрисоединенныеФайлы.Номенклатура";
		
	Возврат ТекстЗапроса;

КонецФункции

Функция ВернутьТекстЗапросаПоКонтрагентам(СтруктураНастроек, ПараметрыПоиска) Экспорт
	
	Перем Телефон, Email;	
	
	ПараметрыПоиска.Свойство("Телефон"	, Телефон);
	ПараметрыПоиска.Свойство("Email"	, Email);
	
	//++ Исправление ошибки API Rozetka.ua от 02.02.2021
	// для версии модулей eComm+ 2.0
	Если Email = "true" Тогда 
		Email = "";
	КонецЕсли;
	//--
	
	ТекстЗапроса = "";
	
	ИмяОбъектаКИ_Партнеры 			= ВернутьИмяОбъектаКонтактнаяИнформация("Партнеры");
	ИмяОбъектаКИ_КонтактныеЛица 	= ВернутьИмяОбъектаКонтактнаяИнформация("КонтактныеЛица");
	ИмяСправочникПартнеры 			= ВернутьИмяСправочникПартнеры();
	ИмяСправочникКонтактныеЛица 	= ВернутьИмяПрикладногоОбъекта("КонтактныеЛица");
	ИмяРеквизитаОбъект				= ВернутьИмяРеквизитаОбъекта("КонтактнаяИнформация", "Объект");
	КонтактныеЛицаПодчиненыВладельцу = СтруктураНастроек.КонтактныеЛицаПодчиненыВладельцу;
	
	// Если конфигурация поддерживает независимое ведение
	// управленческой и юридической структуры клиентов 
	ИскатьДополнительноВСправочникеКонтрагенты = ?(ИмяСправочникПартнеры = "Партнеры", Истина, Ложь);
	
	Если ЗначениеЗаполнено(Email) Тогда 
		
		ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПартнерыКонтактнаяИнформация.#Объект# КАК Партнер,
			|	ВЫРАЗИТЬ(ПартнерыКонтактнаяИнформация.Представление КАК СТРОКА(1024)) КАК ЗначениеРеквизита,
			|	&СтрокаПартнеры КАК НайденоВОбъекте,
			|	&СтрокаEmail КАК НайденовРеквизите,
			|	ПартнерыКонтактнаяИнформация.#Объект# КАК НайденоПоСсылка,
			|	3 КАК Приоритет
			|ПОМЕСТИТЬ НайденоПоАдресуЭП
			|ИЗ
			|	#ИмяОбъектаКонтактнаяИнформация_Партнеры#.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
			|ГДЕ
			|	ВЫРАЗИТЬ(ПартнерыКонтактнаяИнформация.Представление КАК СТРОКА(1024)) = &АдресаЭП
			|	И ПартнерыКонтактнаяИнформация.#Объект# ССЫЛКА Справочник.#ИмяСправочникПартнеры#
			|	И ПартнерыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)"
			
			+ ?(НЕ КонтактныеЛицаПодчиненыВладельцу, "", "
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	КонтактныеЛицаПартнеровКонтактнаяИнформация.#Объект#.Владелец,
				|	ВЫРАЗИТЬ(КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление КАК СТРОКА(1024)),
				|	&СтрокаКонтактныеЛицаПартнеров,
				|	&СтрокаEmail,
				|	КонтактныеЛицаПартнеровКонтактнаяИнформация.#Объект#,
				|	3
				|ИЗ
				|	#ИмяОбъектаКонтактнаяИнформация_КонтактныеЛица#.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
				|ГДЕ
				|	(ВЫРАЗИТЬ(КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление КАК СТРОКА(1024))) = &АдресаЭП
				|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.#Объект# ССЫЛКА Справочник.#ИмяСправочникКонтактныеЛица#
				|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)") 
			
			+ ?(НЕ ИскатьДополнительноВСправочникеКонтрагенты, "", "
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	КонтрагентыКонтактнаяИнформация.Ссылка.Партнер,
				|	ВЫРАЗИТЬ(КонтрагентыКонтактнаяИнформация.Представление КАК СТРОКА(1024)),
				|	""Контрагент"",
				|	&СтрокаEmail,
				|	КонтрагентыКонтактнаяИнформация.Ссылка,
				|	1
				|ИЗ
				|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
				|ГДЕ
				|	(ВЫРАЗИТЬ(КонтрагентыКонтактнаяИнформация.Представление КАК СТРОКА(1024))) = &АдресаЭП
				|	И КонтрагентыКонтактнаяИнформация.Ссылка ССЫЛКА Справочник.Контрагенты
				|	И КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)") 
			
			+ ";
				|
				|////////////////////////////////////////////////////////////////////////////////";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Телефон) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПартнерыКонтактнаяИнформация.#Объект# КАК Партнер,
			|	ВЫРАЗИТЬ(ПартнерыКонтактнаяИнформация.Представление КАК СТРОКА(1024)) КАК ЗначениеРеквизита,
			|	&СтрокаПартнеры КАК НайденоВОбъекте,
			|	&СтрокаТелефон КАК НайденовРеквизите,
			|	ПартнерыКонтактнаяИнформация.#Объект# КАК НайденоПоСсылка,
			|	2 КАК Приоритет
			|ПОМЕСТИТЬ НайденоПоТелефону
			|ИЗ
			|	#ИмяОбъектаКонтактнаяИнформация_Партнеры#.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
			|ГДЕ
			|	(ВЫРАЗИТЬ(ПартнерыКонтактнаяИнформация.Представление КАК СТРОКА(1024)) В (&МассивНомеровТелефона)
			|			ИЛИ ПартнерыКонтактнаяИнформация.Представление ПОДОБНО &ПредставлениеТелефона0)
			|	И (ПартнерыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))"
			
			+ ?(НЕ КонтактныеЛицаПодчиненыВладельцу, "", "
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	КонтактныеЛицаПартнеровКонтактнаяИнформация.#Объект#.Владелец,
				|	ВЫРАЗИТЬ(КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление КАК СТРОКА(1024)),
				|	&СтрокаКонтактныеЛицаПартнеров,
				|	&СтрокаТелефон,
				|	КонтактныеЛицаПартнеровКонтактнаяИнформация.#Объект#,
				|	3
				|ИЗ
				|	#ИмяОбъектаКонтактнаяИнформация_КонтактныеЛица#.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
				|ГДЕ
				|	(ВЫРАЗИТЬ(КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление КАК СТРОКА(1024)) В (&МассивНомеровТелефона)
				|			ИЛИ КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление ПОДОБНО &ПредставлениеТелефона0)
				|	И (КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))") 
		
			+ ?(НЕ ИскатьДополнительноВСправочникеКонтрагенты, "", "
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	КонтрагентыКонтактнаяИнформация.Ссылка.Партнер,
				|	ВЫРАЗИТЬ(КонтрагентыКонтактнаяИнформация.Представление КАК СТРОКА(1024)),
				|	""Контрагент"",
				|	&СтрокаТелефон,
				|	КонтрагентыКонтактнаяИнформация.Ссылка,
				|	1
				|ИЗ
				|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
				|ГДЕ
				|	(ВЫРАЗИТЬ(КонтрагентыКонтактнаяИнформация.Представление КАК СТРОКА(1024)) В (&МассивНомеровТелефона)
				|			ИЛИ КонтрагентыКонтактнаяИнформация.Представление ПОДОБНО &ПредставлениеТелефона0)
				|	И КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)")
			
			+ ";
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	НайденоПоТелефону.Партнер,
				|	НайденоПоТелефону.ЗначениеРеквизита,
				|	НайденоПоТелефону.НайденоВОбъекте,
				|	НайденоПоТелефону.НайденовРеквизите,
				|	НайденоПоТелефону.НайденоПоСсылка,
				|	НайденоПоТелефону.Приоритет
				|ПОМЕСТИТЬ НайденныеПартнеры
				|ИЗ
				|	НайденоПоТелефону КАК НайденоПоТелефону
				|";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Email) Тогда 
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + ?(ЗначениеЗаполнено(Телефон), " ОБЪЕДИНИТЬ ВСЕ ", "") + "
			|
			|ВЫБРАТЬ
			|	НайденоПоАдресуЭП.Партнер,
			|	НайденоПоАдресуЭП.ЗначениеРеквизита,
			|	НайденоПоАдресуЭП.НайденоВОбъекте,
			|	НайденоПоАдресуЭП.НайденовРеквизите,
			|	НайденоПоАдресуЭП.НайденоПоСсылка,
			|	НайденоПоАдресуЭП.Приоритет			
			|	" + ?(НЕ ЗначениеЗаполнено(Телефон), " ПОМЕСТИТЬ НайденныеПартнеры ", "") + " 
			|ИЗ
			|	НайденоПоАдресуЭП КАК НайденоПоАдресуЭП
			|";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + " ;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НайденныеПартнеры.Партнер КАК Партнер,
		|	НайденныеПартнеры.ЗначениеРеквизита КАК ЗначениеРеквизита,
		|	НайденныеПартнеры.НайденоВОбъекте КАК НайденоВОбъекте,
		|	НайденныеПартнеры.НайденовРеквизите КАК НайденоВРеквизите,
		|	НайденныеПартнеры.НайденоПоСсылка КАК НайденоПоСсылка, 
		|	НайденныеПартнеры.Приоритет,
		|	Партнеры.Представление
		|ИЗ
		|	НайденныеПартнеры КАК НайденныеПартнеры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.#ИмяСправочникПартнеры# КАК Партнеры
		|		ПО НайденныеПартнеры.Партнер = Партнеры.Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	НайденныеПартнеры.Приоритет";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Объект#"											, ИмяРеквизитаОбъект);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяСправочникПартнеры#"							, ИмяСправочникПартнеры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяСправочникКонтактныеЛица#"					, ИмяСправочникКонтактныеЛица);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаКонтактнаяИнформация_Партнеры#"		, ИмяОбъектаКИ_Партнеры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаКонтактнаяИнформация_КонтактныеЛица#"	, ИмяОбъектаКИ_КонтактныеЛица);
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ВернутьЗапросСостоянияЗаказа(Источник, ИмяРеквизитаСостояниеЗаказа)

	ИмяДокументаЗаказКлиента = ВернутьИмяДокументЗаказ();

	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЗаказПокупателя.eComm_ИсточникЗаказа КАК УчетнаяЗапись,
		|	ЗаказПокупателя.#СостояниеЗаказа# КАК СостояниеЗаказа,
		|	МАКСИМУМ(ЕСТЬNULL(eComm_СостоянияЗаказовТорговойПлощадки.Наименование, НЕОПРЕДЕЛЕНО)) КАК СостояниеЗаказаТорговойПлощадки
		|ИЗ
		|	Документ.#ИмяДокументаЗаказКлиента# КАК ЗаказПокупателя
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_СостоянияЗаказовТорговойПлощадки КАК eComm_СостоянияЗаказовТорговойПлощадки
		|		ПО ЗаказПокупателя.eComm_ИсточникЗаказа = eComm_СостоянияЗаказовТорговойПлощадки.Владелец
		|			И ЗаказПокупателя.#СостояниеЗаказа# = eComm_СостоянияЗаказовТорговойПлощадки.СостояниеЗаказаПокупателя
		|			И (eComm_СостоянияЗаказовТорговойПлощадки.ПометкаУдаления = ЛОЖЬ)
		|ГДЕ
		|	ЗаказПокупателя.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателя.eComm_ИсточникЗаказа,
		|	ЗаказПокупателя.#СостояниеЗаказа#
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостоянияЗаказовТорговойПлощадки.Наименование КАК ТекущееСостояниеЗаказа,
		|	СостоянияЗаказовТорговойПлощадки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_СостоянияЗаказовТорговойПлощадки КАК СостоянияЗаказовТорговойПлощадки
		|ГДЕ
		|	СостоянияЗаказовТорговойПлощадки.Владелец = &УчетнаяЗапись
		|	И СостоянияЗаказовТорговойПлощадки.ПометкаУдаления = ЛОЖЬ
		|	И СостоянияЗаказовТорговойПлощадки.СостояниеЗаказаПокупателя = &СостояниеЗаказаПокупателя";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#СостояниеЗаказа#"			, ИмяРеквизитаСостояниеЗаказа);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяДокументаЗаказКлиента#"	, ИмяДокументаЗаказКлиента);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка"						, Источник.Ссылка);
	Запрос.УстановитьПараметр("УчетнаяЗапись"				, Источник.eComm_ИсточникЗаказа);
	Запрос.УстановитьПараметр("СостояниеЗаказаПокупателя"	, Источник[ИмяРеквизитаСостояниеЗаказа]);

	Возврат Запрос;
	
КонецФункции

Функция ВернутьЗапросСостоянияЗаказаУНФ(Источник, ИмяРеквизитаСостояниеЗаказа)

	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЗаказПокупателя.eComm_ИсточникЗаказа КАК УчетнаяЗапись,
		|	МАКСИМУМ(ЕСТЬNULL(СостоянияЗаказовТорговойПлощадки.Наименование, НЕОПРЕДЕЛЕНО)) КАК СостояниеЗаказаТорговойПлощадки
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_СостоянияЗаказовТорговойПлощадки КАК СостоянияЗаказовТорговойПлощадки
		|		ПО ЗаказПокупателя.eComm_ИсточникЗаказа = СостоянияЗаказовТорговойПлощадки.Владелец
		|			И (ВЫБОР
		|				КОГДА ЗаказПокупателя.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|						И ЗаказПокупателя.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Успешно)
		|					ТОГДА ВЫБОР
		|							КОГДА &ТорговаяПлощадка = ЗНАЧЕНИЕ(Перечисление.eComm_ТорговыеПлощадки.Prom)
		|								ТОГДА СостоянияЗаказовТорговойПлощадки.Наименование = ""delivered""
		|							ИНАЧЕ СостоянияЗаказовТорговойПлощадки.Наименование = ""6""
		|						КОНЕЦ
		|				КОГДА ЗаказПокупателя.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|						И ЗаказПокупателя.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
		|					ТОГДА ЗаказПокупателя.ПричинаОтмены = СостоянияЗаказовТорговойПлощадки.СостояниеЗаказаПокупателя
		|				ИНАЧЕ ЗаказПокупателя.СостояниеЗаказа = СостоянияЗаказовТорговойПлощадки.СостояниеЗаказаПокупателя
		|			КОНЕЦ)
		|			И (СостоянияЗаказовТорговойПлощадки.ПометкаУдаления = ЛОЖЬ)
		|ГДЕ
		|	ЗаказПокупателя.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателя.eComm_ИсточникЗаказа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА &СостояниеЗаказаПокупателя = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|				И &ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Успешно)
		|			ТОГДА ВЫБОР
		|					КОГДА &ТорговаяПлощадка = ЗНАЧЕНИЕ(Перечисление.eComm_ТорговыеПлощадки.Prom)
		|						ТОГДА ""delivered""
		|					КОГДА &ТорговаяПлощадка = ЗНАЧЕНИЕ(Перечисление.eComm_ТорговыеПлощадки.Horoshop)
		|						ТОГДА ""3""
		|					КОГДА &ТорговаяПлощадка = ЗНАЧЕНИЕ(Перечисление.eComm_ТорговыеПлощадки.Allo)
		|						ТОГДА ""4""
		|					ИНАЧЕ ""6""
		|				КОНЕЦ
		|		ИНАЧЕ СостоянияЗаказовТорговойПлощадки.Наименование
		|	КОНЕЦ КАК ТекущееСостояниеЗаказа,
		|	СостоянияЗаказовТорговойПлощадки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_СостоянияЗаказовТорговойПлощадки КАК СостоянияЗаказовТорговойПлощадки
		|ГДЕ
		|	СостоянияЗаказовТорговойПлощадки.Владелец = &УчетнаяЗапись
		|	И СостоянияЗаказовТорговойПлощадки.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|			КОГДА &СостояниеЗаказаПокупателя = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|					И &ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Успешно)
		|				ТОГДА ВЫБОР
		|						КОГДА &ТорговаяПлощадка = ЗНАЧЕНИЕ(Перечисление.eComm_ТорговыеПлощадки.Prom)
		|							ТОГДА СостоянияЗаказовТорговойПлощадки.Наименование = ""delivered""
		|						КОГДА &ТорговаяПлощадка = ЗНАЧЕНИЕ(Перечисление.eComm_ТорговыеПлощадки.Horoshop)
		|							ТОГДА СостоянияЗаказовТорговойПлощадки.Наименование = ""3""
		|						КОГДА &ТорговаяПлощадка = ЗНАЧЕНИЕ(Перечисление.eComm_ТорговыеПлощадки.Allo)
		|							ТОГДА СостоянияЗаказовТорговойПлощадки.Наименование = ""4""
		|						ИНАЧЕ СостоянияЗаказовТорговойПлощадки.Наименование = ""6""
		|					КОНЕЦ
		|			КОГДА &СостояниеЗаказаПокупателя = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|					И &ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
		|				ТОГДА СостоянияЗаказовТорговойПлощадки.СостояниеЗаказаПокупателя = &ПричинаОтмены
		|			ИНАЧЕ СостоянияЗаказовТорговойПлощадки.СостояниеЗаказаПокупателя = &СостояниеЗаказаПокупателя
		|		КОНЕЦ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка"						, Источник.Ссылка);
	Запрос.УстановитьПараметр("УчетнаяЗапись"				, Источник.eComm_ИсточникЗаказа);
	Запрос.УстановитьПараметр("ТорговаяПлощадка"			, Источник.eComm_ИсточникЗаказа.ТорговаяПлощадка);
	Запрос.УстановитьПараметр("СостояниеЗаказаПокупателя"	, Источник[ИмяРеквизитаСостояниеЗаказа]);
	Запрос.УстановитьПараметр("ВариантЗавершения"			, Источник["ВариантЗавершения"]);
	Запрос.УстановитьПараметр("ПричинаОтмены"				, Источник["ПричинаОтмены"]);

	Возврат Запрос;

КонецФункции

Функция ВключеноИспользованиеХарактеристик() Экспорт

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	Результат = eCommСерверПереопределяемый.ВключеноИспользованиеХарактеристик(ОбрабатыватьВстроеннымОбработчиком);
	
	Если ОбрабатыватьВстроеннымОбработчиком = Истина Тогда 
		
		Результат = Константы[ВернутьИмяКонстантыИспользоватьХарактеристики()].Получить();
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции 

Функция ВернутьСохраняемыеРеквизитыЗаказа() Экспорт

	МассивВозможныйРеквизитов = Новый Массив;
	
	// ОБЩИЕ
	МассивВозможныйРеквизитов.Добавить("Организация");
	МассивВозможныйРеквизитов.Добавить("СтруктурнаяЕдиница");
	МассивВозможныйРеквизитов.Добавить("ВалютаДокумента"); 
	МассивВозможныйРеквизитов.Добавить("Подразделение");
	МассивВозможныйРеквизитов.Добавить("СкладГруппа"); 
	МассивВозможныйРеквизитов.Добавить("СуммаВключаетНДС");
	МассивВозможныйРеквизитов.Добавить("АвторасчетНДС");
	МассивВозможныйРеквизитов.Добавить("УчитыватьНДС");
	МассивВозможныйРеквизитов.Добавить("ВидОперации");
	
	// УНФ
	МассивВозможныйРеквизитов.Добавить("СтруктурнаяЕдиницаПродажи");
	МассивВозможныйРеквизитов.Добавить("НалогообложениеНДС");
	МассивВозможныйРеквизитов.Добавить("СостояниеЗаказа");
	МассивВозможныйРеквизитов.Добавить("ХозяйственнаяОперация");
	МассивВозможныйРеквизитов.Добавить("Касса");
	
	// УТП
	МассивВозможныйРеквизитов.Добавить("eComm_СостояниеЗаказа");
	МассивВозможныйРеквизитов.Добавить("ТипЦен");
	МассивВозможныйРеквизитов.Добавить("КурсВзаиморасчетов");
	МассивВозможныйРеквизитов.Добавить("КратностьВзаиморасчетов");
	
	// УТ-3
	МассивВозможныйРеквизитов.Добавить("Статус");
	МассивВозможныйРеквизитов.Добавить("Приоритет");
	МассивВозможныйРеквизитов.Добавить("Соглашение");
	
	eCommСерверПереопределяемый.ДополнитьСохраняемыеРеквизитыЗаказа(МассивВозможныйРеквизитов);
	
	Возврат МассивВозможныйРеквизитов;

КонецФункции

Функция ПолучитьКодНоменклатуры(Знач Код)
	
	ПозицияРазделителя = Найти(Код, "_");
	Если ПозицияРазделителя > 0 Тогда
		КодНоменклатуры = Лев(Код, ПозицияРазделителя - 1);
	Иначе
		КодНоменклатуры = Код;
	КонецЕсли;	
	
	Возврат КодНоменклатуры;
	
КонецФункции

Функция ПолучитьКодХарактеристики(Знач Код)
	
	ПозицияРазделителя = Найти(Код, "_");
	Если ПозицияРазделителя > 0 Тогда
		КодХарактеристики = Прав(Код, СтрДлина(Код) - ПозицияРазделителя);
	Иначе
		КодХарактеристики = "";
	КонецЕсли;	
	
	Возврат КодХарактеристики;
	
КонецФункции

#КонецОбласти

#Область МЕТОДЫ_ЗАГРУЗКИ_ЗАКАЗОВ

Функция НайтиСоздатьНоменклатуруХарактеристику(СтруктураНастроек, СтруктураИнтернетТовара) Экспорт

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	
	НоменклатураХарактеристика = eCommСерверПереопределяемый.НайтиСоздатьНоменклатуруХарактеристику(СтруктураНастроек, СтруктураИнтернетТовара, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ИнтернетТовары.Номенклатура КАК Номенклатура,
		|	eComm_ИнтернетТовары.ХарактеристикаНоменклатуры КАК Характеристика
		|ИЗ
		|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
		|ГДЕ
		|	eComm_ИнтернетТовары.Код = &Код
		|	И eComm_ИнтернетТовары.Владелец = &Владелец";
		
		Запрос.УстановитьПараметр("Владелец", СтруктураНастроек.УчетнаяЗапись);
		Запрос.УстановитьПараметр("Код"		, СтруктураИнтернетТовара.Код);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		НоменклатураХарактеристика = Новый Структура("Номенклатура, Характеристика", Справочники.Номенклатура.ПустаяСсылка(), Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		
		Если РезультатЗапроса.Следующий() Тогда 
			ЗаполнитьЗначенияСвойств(НоменклатураХарактеристика, РезультатЗапроса);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НоменклатураХарактеристика;
	
КонецФункции

// НЕ ИСПОЛЬЗУЕТСЯ
Функция НайтиНоменклатуру(СтруктураНастроек, СтруктураНоменклатуры) Экспорт
	
	ОбрабатыватьВстроеннымОбработчиком = Истина;
	
	Номенклатура = eCommСерверПереопределяемый.НайтиНоменклатуру(СтруктураНастроек, СтруктураНоменклатуры, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда 
		
		Номенклатура 	= Справочники.Номенклатура.ПустаяСсылка();
		КодНоменклатуры = ПолучитьКодНоменклатуры(СтруктураНоменклатуры.Код);
		
		Если НЕ КодНоменклатуры = "" Тогда
			
			//Если НЕ СтруктураНастроек.ИспользоватьИдентификаторРеквизитаТовара Тогда 

			//	Номенклатура = Справочники.Номенклатура.НайтиПоКоду(КодНоменклатуры);

			//Иначе
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ИнтернетРеквизиты.Номенклатура КАК Номенклатура
				|ИЗ
				|	Справочник.eComm_ИнтернетТовары КАК ИнтернетРеквизиты
				|ГДЕ
				|	ИнтернетРеквизиты.Владелец = &УчетнаяЗапись
				|	И ИнтернетРеквизиты.ПометкаУдаления = ЛОЖЬ
				|	И ИнтернетРеквизиты.Код = &Код";
				
				Запрос.УстановитьПараметр("УчетнаяЗапись"	, СтруктураНастроек.УчетнаяЗапись);
				Запрос.УстановитьПараметр("Код"				, КодНоменклатуры);
				
				РезультатЗапроса = Запрос.Выполнить().Выбрать();
				
				Если РезультатЗапроса.Следующий() Тогда 
					Номенклатура = РезультатЗапроса.Номенклатура;
				КонецЕсли;
				
			//КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Номенклатура;
	
КонецФункции

Процедура ЗаполнитьРеквизитыПоУмолчаниюДляНовогоКлиента(СтруктураНастроек, КлиентОбъект) Экспорт

	Если СтруктураНастроек.Свойство("ИмяКонфигурации")
		И СтруктураНастроек.ИмяКонфигурации = "BASSmallBusiness" Тогда 
		
		// Значения по умолчанию.
		КлиентОбъект["ВестиРасчетыПоДоговорам"] 	= Константы["ВестиРасчетыПоДоговорам"].Получить();
		КлиентОбъект["ВестиРасчетыПоДокументам"] 	= Константы["ВестиРасчетыПоДокументам"].Получить();
		КлиентОбъект["ВестиРасчетыПоЗаказам"] 		= Константы["ВестиРасчетыПоЗаказам"].Получить();
		КлиентОбъект["ВестиУчетОплатыПоСчетам"] 	= Константы["ВестиУчетОплатыПоСчетам"].Получить();
		
		КлиентОбъект["СчетУчетаРасчетовСПокупателем"] 	= ПланыСчетов["Управленческий"]["РасчетыСПокупателями"];
		КлиентОбъект["СчетУчетаАвансовПокупателя"] 		= ПланыСчетов["Управленческий"]["РасчетыПоАвансамПолученным"];
		КлиентОбъект["СчетУчетаРасчетовСПоставщиком"] 	= ПланыСчетов["Управленческий"]["РасчетыСПоставщиками"];
		КлиентОбъект["СчетУчетаАвансовПоставщику"] 		= ПланыСчетов["Управленческий"]["РасчетыПоАвансамВыданным"];
		
	КонецЕсли;

КонецПроцедуры

Процедура ПослеЗаписиНовогоКлиента(СтруктураНастроек, ЗаказОбъект, КлиентОбъект) Экспорт

	// На этом этапе заказ только создан, но клиент уже записан
	
	Если СтруктураНастроек.Свойство("ИмяКонфигурации") Тогда 
		
		Если СтруктураНастроек.ИмяКонфигурации = "BASSmallBusiness" Тогда
			ПослеЗаписиНовогоКлиентаУНФ(СтруктураНастроек, ЗаказОбъект, КлиентОбъект);
		ИначеЕсли СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
			//
		Иначе
			ПослеЗаписиНовогоКлиентаУТBAS(СтруктураНастроек, ЗаказОбъект, КлиентОбъект);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПослеЗаписиНовогоКлиентаУНФ(СтруктураНастроек, ЗаказОбъект, КлиентОбъект) Экспорт

	Если СтруктураНастроек.Свойство("КонтактныеЛицаПодчиненыВладельцу") 
		И СтруктураНастроек.КонтактныеЛицаПодчиненыВладельцу = Ложь Тогда 
		
		// Инициализируем параметры	
		ПараметрыЗаказа = Неопределено;
		ЗаказОбъект.ДополнительныеСвойства.Свойство("eComm", ПараметрыЗаказа);
		
		Если ТипЗнч(ПараметрыЗаказа) = Тип("Структура") 
			И ПараметрыЗаказа.Свойство("Контакты") Тогда
			
			// Создадим контактное лицо
			КонтактноеЛицоОбъект = Справочники["КонтактныеЛица"].СоздатьЭлемент();
			КонтактноеЛицоОбъект.Наименование = ПараметрыЗаказа.Контакты.ФИОКлиента;
			КонтактноеЛицоОбъект.ДатаСоздания = ТекущаяДата();
			
			Если ЗначениеЗаполнено(ПараметрыЗаказа.Контакты.Телефон) Тогда
				
				НовСтр = КонтактноеЛицоОбъект.КонтактнаяИнформация.Добавить();
				НовСтр.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				НовСтр.Вид = Справочники.ВидыКонтактнойИнформации["ТелефонКонтактногоЛица"];
				НовСтр.Представление = ПараметрыЗаказа.Контакты.Телефон;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПараметрыЗаказа.Контакты.Email) Тогда 
				НовСтр = КонтактноеЛицоОбъект.КонтактнаяИнформация.Добавить();
				НовСтр.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
				НовСтр.Вид = Справочники.ВидыКонтактнойИнформации["EmailКонтактногоЛица"];
				НовСтр.Представление = ПараметрыЗаказа.Контакты.Email;
			КонецЕсли;
			
			КонтактноеЛицоОбъект.Записать();
			
			// Зафиксируем связь 
			МенеджерЗаписи = РегистрыСведений["СвязиКонтрагентКонтакт"].СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период		= ТекущаяДата();
			МенеджерЗаписи.Контрагент 	= КлиентОбъект.Ссылка;
			МенеджерЗаписи.Контакт		= КонтактноеЛицоОбъект.Ссылка;
			МенеджерЗаписи.Записать();
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПослеЗаписиНовогоКлиентаУТBAS(СтруктураНастроек, ЗаказОбъект, КлиентОбъект)

	МодульУправлениеКонтактнойИнформациейСлужебныйВызовСервера = ОбщийМодуль("УправлениеКонтактнойИнформациейСлужебныйВызовСервера");
	
	Если НЕ МодульУправлениеКонтактнойИнформациейСлужебныйВызовСервера = Неопределено Тогда
		// УТBAS
		
		Попытка
			
			Для Каждого ДанныеСтроки Из КлиентОбъект.КонтактнаяИнформация Цикл 
				ДанныеСтроки.ЗначенияПолей = МодульУправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(ДанныеСтроки.Представление, ДанныеСтроки.Вид);
			КонецЦикла;
			КлиентОбъект.Записать();
			
		Исключение
		КонецПопытки;
		
	Иначе
		// УТ-3
		
		МодульКонтактнаяИнформацияСлужебныйВызовСервера = ОбщийМодуль("КонтактнаяИнформацияСлужебныйВызовСервера");
		Если НЕ МодульКонтактнаяИнформацияСлужебныйВызовСервера = Неопределено Тогда 
			
			Попытка
				
				Для Каждого ДанныеСтроки Из КлиентОбъект.КонтактнаяИнформация Цикл 
					ДанныеСтроки.ЗначенияПолей = МодульКонтактнаяИнформацияСлужебныйВызовСервера.ПарсингКонтактнойИнформацииXML(ДанныеСтроки.Представление, ДанныеСтроки.Вид);
				КонецЦикла;
				КлиентОбъект.Записать();
				
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуТЧТовары(СтруктураНастроек, ЗаказОбъект, СтрокаТабличнойЧасти, СтруктураЗаполнения) Экспорт

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	
	eCommСерверПереопределяемый.ЗаполнитьСтрокуТЧТовары(СтруктураНастроек, ЗаказОбъект, СтрокаТабличнойЧасти, СтруктураЗаполнения, ОбрабатыватьВстроеннымОбработчиком); 
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда 	
		
		ИмяКонфигурации = СтруктураНастроек.ИмяКонфигурации;
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураЗаполнения);

		Если ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда 
			
			СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры = СтруктураЗаполнения.Характеристика;
			СтрокаТабличнойЧасти.ЕдиницаИзмерения 			= СтрокаТабличнойЧасти.Номенклатура["ЕдиницаХраненияОстатков"];
			СтрокаТабличнойЧасти.Коэффициент 				= 1;
			СтрокаТабличнойЧасти.СтавкаНДС 					= СтрокаТабличнойЧасти.Номенклатура["СтавкаНДС"];
			
			Если СтруктураЗаполнения.Свойство("СуммаСоСкидкой") 
				И ЗначениеЗаполнено(СтруктураЗаполнения.СуммаСоСкидкой) Тогда
				
				СтрокаТабличнойЧасти.Сумма = СтруктураЗаполнения.СуммаСоСкидкой;
				
				МодульОбработкаТабличныхЧастей = ОбщийМодуль("ОбработкаТабличныхЧастей");
				МодульОбработкаТабличныхЧастей.ПриИзмененииСуммыТабЧасти(СтрокаТабличнойЧасти, ЗаказОбъект, ПараметрыСеанса.ТекущийПользователь,, Истина, Истина, Истина, "Товары");
				МодульОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, ЗаказОбъект);
				
			КонецЕсли;
			
			// Набор-комплект
			МодульУправлениеЗапасами = ОбщийМодуль("УправлениеЗапасами");       
			Если НЕ МодульУправлениеЗапасами = Неопределено Тогда   
				СтрокаТабличнойЧасти.КлючСтроки = МодульУправлениеЗапасами.ПолучитьНовыйКлючСтроки(ЗаказОбъект);
				МодульУправлениеЗапасами.ДобавитьСоставНабора(СтрокаТабличнойЧасти, ЗаказОбъект);
			КонецЕсли;
			
		ИначеЕсли ИмяКонфигурации = "BASSmallBusiness" Тогда 
			
			ИмяРеквизита_Всего = ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары_Всего");
			Если ЗначениеЗаполнено(ИмяРеквизита_Всего) Тогда 
				СтрокаТабличнойЧасти[ИмяРеквизита_Всего] = СтрокаТабличнойЧасти.Сумма;
			КонецЕсли;
			
			СтрокаТабличнойЧасти.ТипНоменклатурыЗапас = ((СтрокаТабличнойЧасти.Номенклатура.ТипНоменклатуры = Перечисления["ТипыНоменклатуры"].Запас)
													ИЛИ (СтрокаТабличнойЧасти.Номенклатура.ТипНоменклатуры = Перечисления["ТипыНоменклатуры"].ПодарочныйСертификат));

			СтрокаТабличнойЧасти.ЕдиницаИзмерения 			= СтрокаТабличнойЧасти.Номенклатура["ЕдиницаИзмерения"];
			Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("СтавкаНДС") = Неопределено Тогда
				ВидСтавкиНДС = СтрокаТабличнойЧасти.Номенклатура["ВидСтавкиНДС"];
				Если ЗначениеЗаполнено(ВидСтавкиНДС) Тогда 
					СтрокаТабличнойЧасти.СтавкаНДС = Справочники["СтавкиНДС"].СтавкаНДС(ВидСтавкиНДС,ТекущаяДатаСеанса());
				КонецЕсли;
			Иначе
				СтрокаТабличнойЧасти.СтавкаНДС = СтрокаТабличнойЧасти.Номенклатура["СтавкаНДС"];
			КонецЕсли;
			
			МенеджерОбмена = ОбщийМодуль("МенеджерОбменаЧерезУниверсальныйФормат16");
			Если МенеджерОбмена = Неопределено Тогда 
				МенеджерОбмена = ОбщийМодуль("МенеджерОбменаЧерезУниверсальныйФормат18");
			КонецЕсли
			;
			Если НЕ МенеджерОбмена = Неопределено Тогда 
				МенеджерОбмена.РассчитатьСуммуНДСЗаказа(СтрокаТабличнойЧасти, ЗаказОбъект);
			КонецЕсли;
			
			МодульНаборыКлиентСервер 	= ОбщийМодуль("НаборыКлиентСервер");
			
			Если НЕ МодульНаборыКлиентСервер = Неопределено
				И СтруктураЗаполнения.Свойство("СуммаСоСкидкой") 
				И ЗначениеЗаполнено(СтруктураЗаполнения.СуммаСоСкидкой) Тогда
				
				СтрокаТабличнойЧасти.СуммаСкидкиНаценки = СтрокаТабличнойЧасти.Сумма - СтруктураЗаполнения.СуммаСоСкидкой;
				
				ПараметрыРасчета = Новый Структура("РассчитатьПроцентСкидки", Истина);
				ПараметрыРасчета.Вставить("СуммаВключаетНДС", ЗаказОбъект.СуммаВключаетНДС);
				
				МодульНаборыКлиентСервер.РассчитатьСуммыВСтрокеТЧ(ЗаказОбъект.Запасы, СтрокаТабличнойЧасти, ПараметрыРасчета);
				
			КонецЕсли;
			
			Если СтрокаТабличнойЧасти.Номенклатура["ЭтоНабор"] = Истина Тогда 
				
				МодульНаборыСервер 			= ОбщийМодуль("НаборыСервер");
				
				Если НЕ МодульНаборыСервер = Неопределено 
					И НЕ МодульНаборыКлиентСервер = Неопределено Тогда 
					
					СтруктураДанные = Новый Структура;
					СтруктураДанные.Вставить("Организация"			, ЗаказОбъект.Организация);
					СтруктураДанные.Вставить("Номенклатура"			, СтрокаТабличнойЧасти.Номенклатура);
					СтруктураДанные.Вставить("Характеристика"		, СтрокаТабличнойЧасти.Характеристика);
					СтруктураДанные.Вставить("НалогообложениеНДС"	, ЗаказОбъект.НалогообложениеНДС);
					СтруктураДанные.Вставить("Цена"					, СтрокаТабличнойЧасти.Цена);
					СтруктураДанные.Вставить("ДатаОбработки"		, ЗаказОбъект.Дата);
					СтруктураДанные.Вставить("ВалютаДокумента"		, ЗаказОбъект.ВалютаДокумента);
					СтруктураДанные.Вставить("СуммаВключаетНДС"		, ЗаказОбъект.СуммаВключаетНДС);
					СтруктураДанные.Вставить("СтавкаНДС"			, СтрокаТабличнойЧасти.СтавкаНДС);
					СтруктураДанные.Вставить("ВидЦен"				, ЗаказОбъект.ВидЦен);
					СтруктураДанные.Вставить("ЕдиницаИзмерения"		, СтрокаТабличнойЧасти.ЕдиницаИзмерения);
					
					МодульНаборыСервер.ДобавитьИнформациюОНабореПриПолученииДанныхНоменклатуры(СтруктураДанные);
					МодульНаборыКлиентСервер.ЗаменитьСтрокуДаннымиНабора(ЗаказОбъект, "Запасы", СтрокаТабличнойЧасти, СтруктураДанные);
				
				КонецЕсли;

			КонецЕсли;
			
		Иначе//Если ИмяКонфигурации = "УправлениеТорговлейДляУкраины" Тогда 
		
			СтрокаТабличнойЧасти["КоличествоУпаковок"] 	= СтрокаТабличнойЧасти.Количество;
			СтрокаТабличнойЧасти["ВидЦены"] 			= СтруктураНастроек.ТипЦены;
			СтрокаТабличнойЧасти["СуммаСНДС"] 			= СтрокаТабличнойЧасти.Сумма;
			СтрокаТабличнойЧасти.СтавкаНДС 				= СтрокаТабличнойЧасти.Номенклатура["СтавкаНДС"];
			
			МодульОбработкаТабличнойЧастиСервер = ОбщийМодуль("ОбработкаТабличнойЧастиСервер");
			Если НЕ МодульОбработкаТабличнойЧастиСервер = Неопределено Тогда 
				
				// Цена промо и др скидки
				Если СтруктураЗаполнения.Свойство("СуммаСоСкидкой") 
					И ЗначениеЗаполнено(СтруктураЗаполнения.СуммаСоСкидкой) Тогда
					
					СтрокаТабличнойЧасти.СуммаРучнойСкидки = СтрокаТабличнойЧасти.Сумма - Число(СтруктураЗаполнения.СуммаСоСкидкой);
					
					СтруктураПересчетаСуммы = Новый Структура;
					СтруктураПересчетаСуммы.Вставить("Дата",            ТекущаяДата());
					СтруктураПересчетаСуммы.Вставить("ЦенаВключаетНДС", ЗаказОбъект.ЦенаВключаетНДС);
					
					СтруктураДействий = Новый Структура;
					СтруктураДействий.Вставить("ПересчитатьПроцентРучнойСкидки");
					СтруктураДействий.Вставить("ПересчитатьСумму");
					СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки"		, Новый Структура("Очищать, ПересчитыватьСуммуРучнойСкидки", Ложь, Ложь));
					СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Ложь));
					СтруктураДействий.Вставить("ПересчитатьСуммуНДС"						, СтруктураПересчетаСуммы);
					СтруктураДействий.Вставить("ПересчитатьСуммуСНДС"						, СтруктураПересчетаСуммы);
					
					МодульОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТабличнойЧасти, СтруктураДействий, Неопределено);
					
				КонецЕсли;
				
			КонецЕсли;

		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

Процедура РаспределитьСуммуПоКолонке(СтруктураНастроек, ЗаказОбъект, Товары, СуммаРаспределения)
	
	МассивДанныхКолонки = Товары.ВыгрузитьКолонку("Сумма");
	МассивРаспределения = РаспределитьПропорционально(СуммаРаспределения, МассивДанныхКолонки);
	
	Если МассивРаспределения = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	МенеджерОбмена = ОбщийМодуль("МенеджерОбменаЧерезУниверсальныйФормат16");
	Если МенеджерОбмена = Неопределено Тогда 
		МенеджерОбмена = ОбщийМодуль("МенеджерОбменаЧерезУниверсальныйФормат18");
	КонецЕсли;
	ИмяРеквизита_ПроцентСкидкиНаценки 	= ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары_ПроцентСкидкиНаценки");
	ИмяРеквизита_СуммаСкидкиНаценки 	= ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары_СуммаСкидкиНаценки");
	
	Индекс = 0;
	Для каждого СтрокаТабличнойЧасти Из Товары Цикл
		
		СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Сумма + МассивРаспределения[Индекс];
		
		СуммаБезСкидки = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество;
		СуммаСкидки = СуммаБезСкидки - СтрокаТабличнойЧасти.Сумма;
		
		Если СуммаСкидки <> 0 Тогда
			СтрокаТабличнойЧасти[ИмяРеквизита_ПроцентСкидкиНаценки] = 100 * СуммаСкидки / СуммаБезСкидки;
			Если ЗначениеЗаполнено(ИмяРеквизита_СуммаСкидкиНаценки) Тогда 
				СтрокаТабличнойЧасти[ИмяРеквизита_СуммаСкидкиНаценки] = СуммаСкидки;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ МенеджерОбмена = Неопределено Тогда 
			МенеджерОбмена.РассчитатьСуммуНДСЗаказа(СтрокаТабличнойЧасти, ЗаказОбъект);
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция РаспределитьПропорционально(Знач ИсхСумма, МассивКоэф, Знач Точность = 2) Экспорт
	
	Если МассивКоэф.Количество() = 0 Или ИсхСумма = 0 Или ИсхСумма = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИндексМакс = 0;
	МаксЗнач   = 0;
	РаспрСумма = 0;
	СуммаКоэф  = 0;
	
	Для К = 0 По МассивКоэф.Количество() - 1 Цикл
	
		МодульЧисла = ?(МассивКоэф[К] > 0, МассивКоэф[К], - МассивКоэф[К]);
	
		Если МаксЗнач < МодульЧисла Тогда
			МаксЗнач = МодульЧисла;
			ИндексМакс = К;
		КонецЕсли;
	
		СуммаКоэф = СуммаКоэф + МассивКоэф[К];
	
	КонецЦикла;
	
	Если СуммаКоэф = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивСумм = Новый Массив(МассивКоэф.Количество());
	
	Для К = 0 По МассивКоэф.Количество() - 1 Цикл
		МассивСумм[К] = Окр(ИсхСумма * МассивКоэф[К] / СуммаКоэф, Точность, 1);
		РаспрСумма = РаспрСумма + МассивСумм[К];
	КонецЦикла;
	
	// Погрешности округления отнесем на коэффицент с максимальным весом.
	Если Не РаспрСумма = ИсхСумма Тогда
		МассивСумм[ИндексМакс] = МассивСумм[ИндексМакс] + ИсхСумма - РаспрСумма;
	КонецЕсли;
	
	Возврат МассивСумм;
	
КонецФункции

Функция РейтингПользователяRozetka(Рейтинг)

	Результат = "";
	
	Если Рейтинг = 1 Тогда 
		Результат = НСтр("ru = 'Высокий процент выкупа заказов'; uk = 'Високий відсоток викупу замовлень'");
	ИначеЕсли Рейтинг = 2 Тогда 
		Результат = НСтр("ru = 'Средний процент выкупа заказов'; uk = 'Середній відсоток викупу замовлень'");
	ИначеЕсли Рейтинг = 3 Тогда 
		Результат = НСтр("ru = 'Низкий процент выкупа заказов'; uk = 'Низький відсоток викупу замовлень'");
	Иначе
		Результат = НСтр("ru = 'Недостаточно данных для определения процента выкупа'; uk = 'Недостатньо даних для визначення відсотка викупу'");
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьЗаказыПокупателейССайта(СтруктураНастроек, ДокументОбъект)
	
	Если НЕ СтруктураНастроек.ИмяКонфигурации = "BASSmallBusiness" Тогда 
		Возврат;
	КонецЕсли;
	
	НоваяЗапись = РегистрыСведений["ЗаказыПокупателейССайта"].СоздатьМенеджерЗаписи();
	НоваяЗапись.ЗаказПокупателя 	= ДокументОбъект.Ссылка;
	НоваяЗапись.НомерЗаказаНаСайте 	= ДокументОбъект.НомерВходящегоДокумента;
	НоваяЗапись.ДатаЗаказаНаСайте 	= ДокументОбъект.Дата;
	НоваяЗапись.Записать();
	
КонецПроцедуры

Процедура ЗаписатьЗаказКлиента(СтруктураНастроек, ЗаказОбъект) Экспорт

	Перем eComm;
	
	ОбрабатыватьВстроеннымОбработчиком = Истина;
	
	eCommСерверПереопределяемый.ЗаписатьЗаказКлиента(СтруктураНастроек, ЗаказОбъект, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		
		ПроводитьЗаказыПриЗагрузке 			= ВернутьЗначениеНастройки(СтруктураНастроек, "ЗагрузкаЗаказов", "ПроводитьЗаказыПриЗагрузке");
		НеРезервироватьТоварыВЗаказах		= ВернутьЗначениеНастройки(СтруктураНастроек, "ЗагрузкаЗаказов", "НеРезервироватьТоварыВЗаказах");
		ДобавлятьТипОплатыВКомментарий 		= ВернутьЗначениеНастройки(СтруктураНастроек, "ЗагрузкаЗаказов", "ДобавлятьТипОплатыВКомментарий");
		ДобавлятьПроцентВыкупаВКомментарий	= ВернутьЗначениеНастройки(СтруктураНастроек, "ЗагрузкаЗаказов", "ДобавлятьПроцентВыкупаВКомментарий");
		УслугаДоставки						= ВернутьЗначениеНастройки(СтруктураНастроек, "ЗагрузкаЗаказов", "УслугаДоставки");
		СвойствоСтатусОплаты				= ВернутьЗначениеНастройки(СтруктураНастроек, "ЗагрузкаЗаказов", "СвойствоСтатусОплаты");
		
		// Дополнение комментария
		Если ЗаказОбъект.ДополнительныеСвойства.Свойство("eComm", eComm)
			И ТипЗнч(eComm) = Тип("Структура")
			И eComm.Свойство("Оплата")
			И ТипЗнч(eComm.Оплата) = Тип("Структура") Тогда
			
			Если ДобавлятьТипОплатыВКомментарий = Истина
				И eComm.Оплата.Свойство("СпособОплатыНаСайте") Тогда  
				ЗаказОбъект.Комментарий = ЗаказОбъект.Комментарий + ?(ЗаказОбъект.Комментарий = "", "", "; ") + eComm.Оплата.СпособОплатыНаСайте;
			КонецЕсли;
			
			Если ДобавлятьПроцентВыкупаВКомментарий = Истина
				И eComm.Оплата.Свойство("РейтингПользователя") Тогда 
				РейтингПользователя = РейтингПользователяRozetka(eComm.Оплата.РейтингПользователя);
				ЗаказОбъект.Комментарий = ЗаказОбъект.Комментарий + ?(ЗаказОбъект.Комментарий = "" И РейтингПользователя = "", "", "; ") + РейтингПользователя;
			КонецЕсли;
			
		КонецЕсли;
		
		// Применение купонов на документ
		//
		ИмяТЧ_Товары = ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары");
		Если ЗаказОбъект.ДополнительныеСвойства.Свойство("eComm", eComm)
			И ТипЗнч(eComm) = Тип("Структура")
			И eComm.Свойство("СуммаБезСкидки")
			И eComm.Свойство("Всего") Тогда
			
			// В некоторых случаях (для хорошоп) скидка на документ не учитывается 
			// в данных табличной части. Исправим это
			
			Попытка
				
				СуммаСкидки = eComm.СуммаБезСкидки - eComm.Всего;
				Если ЗначениеЗаполнено(СуммаСкидки) Тогда
					РаспределитьСуммуПоКолонке(СтруктураНастроек, ЗаказОбъект, ЗаказОбъект[ИмяТЧ_Товары], -СуммаСкидки);
				КонецЕсли;
				
				МенеджерОбмена = ОбщийМодуль("МенеджерОбменаЧерезУниверсальныйФормат16");
				Если МенеджерОбмена = Неопределено Тогда 
					МенеджерОбмена = ОбщийМодуль("МенеджерОбменаЧерезУниверсальныйФормат18");
				КонецЕсли;
				
				Если НЕ МенеджерОбмена = Неопределено Тогда 
					Для Каждого СтрокаТабличнойЧасти Из ЗаказОбъект[ИмяТЧ_Товары] Цикл
						МенеджерОбмена.РассчитатьСуммуНДСЗаказа(СтрокаТабличнойЧасти, ЗаказОбъект);
					КонецЦикла;
				КонецЕсли;
				
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;
		
		// Резервирование товаров под заказ
		//
		ИмяРеквизита_Резерв = ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары_Резерв");
		Если ЗначениеЗаполнено(ИмяРеквизита_Резерв) Тогда
			
			ИмяФункциональнойОпции = ВернутьИмяПрикладногоОбъекта("ФункциональнаяОпцияРезервированиеЗапасов");
			Если ЗначениеЗаполнено(ИмяФункциональнойОпции)
				И Константы[ИмяФункциональнойОпции].Получить() = Истина 
				И НЕ НеРезервироватьТоварыВЗаказах = Истина Тогда 
				
				Для Каждого СтрокаТабличнойЧасти Из ЗаказОбъект[ИмяТЧ_Товары] Цикл 
					Если СтрокаТабличнойЧасти["ТипНоменклатурыЗапас"] = Истина Тогда 
						СтрокаТабличнойЧасти[ИмяРеквизита_Резерв] = СтрокаТабличнойЧасти.Количество;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// Добавление услуги доставки в табличную часть для Horoshop
		//
		Если (СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Horoshop 
			ИЛИ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka)
			И ЗначениеЗаполнено(УслугаДоставки) Тогда 
			
			Если ЗаказОбъект.ДополнительныеСвойства.Свойство("eComm", eComm)
				И ТипЗнч(eComm) = Тип("Структура")
				И eComm.Свойство("СтоимостьДоставки") Тогда
				
				СтоимостьДоставки = eComm.СтоимостьДоставки;
		
				Если ТипЗнч(СтоимостьДоставки) = Тип("Число")
					И СтоимостьДоставки > 0 Тогда 
					
					// Добавим услугу
					НовСтр = ЗаказОбъект[ИмяТЧ_Товары].Добавить();
					НовСтр.Номенклатура 	= УслугаДоставки;
					НовСтр.Количество		= 1;
					НовСтр.ЕдиницаИзмерения = НовСтр.Номенклатура.ЕдиницаИзмерения;
					НовСтр.Цена				= СтоимостьДоставки;
					НовСтр.Сумма			= СтоимостьДоставки;
					
					ИмяРеквизита_Всего = ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары_Всего");
					Если ЗначениеЗаполнено(ИмяРеквизита_Всего) Тогда 
						НовСтр[ИмяРеквизита_Всего] = НовСтр.Сумма;
					КонецЕсли;
					
					Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("СтавкаНДС") = Неопределено Тогда
						ВидСтавкиНДС = НовСтр.Номенклатура["ВидСтавкиНДС"];
						Если ЗначениеЗаполнено(ВидСтавкиНДС) Тогда 
							НовСтр.СтавкаНДС = Справочники["СтавкиНДС"].СтавкаНДС(ВидСтавкиНДС,ТекущаяДатаСеанса());
						КонецЕсли;
					Иначе
						НовСтр.СтавкаНДС = НовСтр.Номенклатура["СтавкаНДС"];
					КонецЕсли;
					
					МенеджерОбмена = ОбщийМодуль("МенеджерОбменаЧерезУниверсальныйФормат16");
					Если МенеджерОбмена = Неопределено Тогда 
						МенеджерОбмена = ОбщийМодуль("МенеджерОбменаЧерезУниверсальныйФормат18");
					КонецЕсли;
					
					Если НЕ МенеджерОбмена = Неопределено Тогда 
						МенеджерОбмена.РассчитатьСуммуНДСЗаказа(НовСтр, ЗаказОбъект);
					КонецЕсли;
					
				КонецЕсли;
		
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
			// Обновление дополнительного реквизита "Статус оплаты" для конфигураций на управляемых формах
			// 
			ЗаписатьСтатусОплатыУНФ(СтруктураНастроек, ЗаказОбъект, СвойствоСтатусОплаты);
		КонецЕсли;
		
		
		// Проведение документа
		//
		Если ПроводитьЗаказыПриЗагрузке = Истина Тогда
			
			Если НЕ ЗаказОбъект.Метаданные().Реквизиты.Найти("ДатаОтгрузки") = Неопределено Тогда 
				ЗаказОбъект.ДатаОтгрузки = ТекущаяДата();
			КонецЕсли;
			
			Попытка
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись)
			КонецПопытки;
			
		Иначе
			
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
			
		КонецЕсли;
		
		Если СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
			// Обновление дополнительного реквизита "Статус оплаты" для конфигураций на обычных формах
			//
			ЗаписатьСтатусОплатыУТП(СтруктураНастроек, ЗаказОбъект, СвойствоСтатусОплаты);	
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьСтатусОплаты(СтруктураНастроек, ЗаказОбъект, СвойствоСтатусОплаты, ДляКонфигурации)
	
	Перем eComm;
	
	Если (СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom
		ИЛИ СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Rozetka)
		И ЗначениеЗаполнено(СвойствоСтатусОплаты) Тогда
		
		СтатусОплаты = Неопределено;
		ИмяТЧ_ДополнительныеРеквизиты = ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "ДополнительныеРеквизиты");
		
		Если ДляКонфигурации = "УФ" И ИмяТЧ_ДополнительныеРеквизиты = "ЗначенияСвойствОбъектов" Тогда 
			Возврат;
		КонецЕсли;
		
		Если ДляКонфигурации = "ОФ" И НЕ ИмяТЧ_ДополнительныеРеквизиты = "ЗначенияСвойствОбъектов" Тогда 
			Возврат;
		КонецЕсли;
		
		Если ЗаказОбъект.ДополнительныеСвойства.Свойство("eComm", eComm)
			И ТипЗнч(eComm) = Тип("Структура")
			И eComm.Свойство("Оплата") 
			И ТипЗнч(eComm.Оплата) = Тип("Структура")
			И eComm.Оплата.Свойство("СтатусОплаты", СтатусОплаты) 
			И ЗначениеЗаполнено(ИмяТЧ_ДополнительныеРеквизиты) Тогда
			
			Если ЗначениеЗаполнено(СтатусОплаты) Тогда 
				// Найдем доп. реквизит
				
				Если СтруктураНастроек.ТорговаяПлощадка = Перечисления.eComm_ТорговыеПлощадки.Prom Тогда 
					
					СоответствиеСтатусовОплаты = Новый Соответствие;
					СоответствиеСтатусовОплаты.Вставить("paid"		, "оплачено покупцем");
					СоответствиеСтатусовОплаты.Вставить("unpaid"	, "не оплачено");
					СоответствиеСтатусовОплаты.Вставить("refunded"	, "виконане повернення покупцю");
					СоответствиеСтатусовОплаты.Вставить("paid_out"	, "виплачено продавцю");
					
					НаименованиеСтатусаОплаты = СоответствиеСтатусовОплаты.Получить(СтатусОплаты);
					
				Иначе
					
					НаименованиеСтатусаОплаты = СтатусОплаты;
					
				КонецЕсли;
				
				ЗначениеСтатуса = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(НаименованиеСтатусаОплаты, Истина, , СвойствоСтатусОплаты);
				
				Если НЕ ЗначениеЗаполнено(ЗначениеСтатуса) Тогда 
					
					ЗначениеСтатусаОбъект = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
					ЗначениеСтатусаОбъект.Наименование 	= НаименованиеСтатусаОплаты;
					ЗначениеСтатусаОбъект.Владелец 		= СвойствоСтатусОплаты;
					ЗначениеСтатусаОбъект.Записать();
					
					ЗначениеСтатуса = ЗначениеСтатусаОбъект.Ссылка;
					
				КонецЕсли;
				
			Иначе
				
				ЗначениеСтатуса = Неопределено;
				
			КонецЕсли;
			
			Если НЕ ИмяТЧ_ДополнительныеРеквизиты = "ЗначенияСвойствОбъектов" Тогда 
				// Это конфигурация на управляемых формах. Доп. реквизиты хранятся в ТЧ документа
				
				Отбор = Новый Структура("Свойство", СвойствоСтатусОплаты);
				НайденныеСтроки = ЗаказОбъект[ИмяТЧ_ДополнительныеРеквизиты].НайтиСтроки(Отбор);
				
				Если НайденныеСтроки.Количество() > 0 Тогда 
					ТекСтрока = НайденныеСтроки[0];
				Иначе
					ТекСтрока = ЗаказОбъект[ИмяТЧ_ДополнительныеРеквизиты].Добавить();
					ТекСтрока.Свойство = СвойствоСтатусОплаты;
				КонецЕсли;
				ТекСтрока.Значение = ЗначениеСтатуса;
				
			Иначе
				// Это конфигурация на обчных формах. Свойства хранятся в регистре "ЗначенияСвойствОбъектов"
				
				МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект 	= ЗаказОбъект.Ссылка;
				МенеджерЗаписи.Свойство = СвойствоСтатусОплаты;
				МенеджерЗаписи.Прочитать();
				Если НЕ МенеджерЗаписи.Выбран() Тогда 
					МенеджерЗаписи.Объект 	= ЗаказОбъект.Ссылка;
					МенеджерЗаписи.Свойство = СвойствоСтатусОплаты;
				КонецЕсли;
				МенеджерЗаписи.Значение = ЗначениеСтатуса;
				МенеджерЗаписи.Записать(Истина);
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли;

КонецПроцедуры

Процедура ПослеЗаписиЗаказаКлиента(СтруктураНастроек, ЗаказОбъект) Экспорт

	Перем ЭтоНоваяПочта, ПараметрыЗаказа;
	
	ОбрабатыватьВстроеннымОбработчиком = Истина;
	
	ЗаписатьЗаказыПокупателейССайта(СтруктураНастроек, ЗаказОбъект);
	
	eCommСерверПереопределяемый.ПослеЗаписиЗаказаКлиента(СтруктураНастроек, ЗаказОбъект, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область МЕТОДЫ_ЗАГРУЗКИ_ОПЛАТ

Процедура ЗаписатьСтатусОплатыПоЗаказуКлиента(СтруктураНастроек, ЗаказОбъект) Экспорт

	Перем eComm;
	
	ОбрабатыватьВстроеннымОбработчиком = Истина;
	
	eCommСерверПереопределяемый.ЗаписатьСтатусОплатыПоЗаказуКлиента(СтруктураНастроек, ЗаказОбъект, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда
		
		СвойствоСтатусОплаты = ВернутьЗначениеНастройки(СтруктураНастроек, "ЗагрузкаЗаказов", "СвойствоСтатусОплаты");
		
		Если НЕ СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
			// Обновление дополнительного реквизита "Статус оплаты" для конфигураций на управляемых формах
			// 
			
			ЗаписатьСтатусОплатыУНФ(СтруктураНастроек, ЗаказОбъект, СвойствоСтатусОплаты);	
			
			// Проведение документа
			//
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
		Иначе	
			// Обновление дополнительного реквизита "Статус оплаты" для конфигураций на обычных формах
			//
			
			ЗаписатьСтатусОплатыУТП(СтруктураНастроек, ЗаказОбъект, СвойствоСтатусОплаты);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

