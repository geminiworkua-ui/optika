Процедура eComm_СправочникиПередЗаписью(Источник, Отказ) Экспорт
	
	Возврат;
	
	СтандартнаяОбработка = Истина;
	eCommСерверПереопределяемый.СправочникиПередЗаписью(Источник, Отказ, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.eComm_ИнтернетТовары") 
		И ЗначениеЗаполнено(Источник.Ссылка) Тогда 
		
		// Используется только для Prom.ua
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	eComm_ИнтернетТовары.Отключить КАК Отключить
			|ИЗ
			|	Справочник.eComm_ИнтернетТовары КАК eComm_ИнтернетТовары
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.eComm_УчетныеЗаписи КАК eComm_УчетныеЗаписи
			|		ПО eComm_ИнтернетТовары.Владелец = eComm_УчетныеЗаписи.Ссылка
			|ГДЕ
			|	eComm_УчетныеЗаписи.ВыгружатьТовары = ИСТИНА
			|	И eComm_УчетныеЗаписи.ТорговаяПлощадка = ЗНАЧЕНИЕ(Перечисление.eComm_ТорговыеПлощадки.Prom)
			|	И eComm_ИнтернетТовары.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		РезультатЗапроса.Следующий();
		
		Если (Источник.Отключить = Истина 
			И РезультатЗапроса.Отключить = Ложь) Тогда	    // Если отключается выгрузка на Prom.ua
			РегистрыСведений["eComm_ТоварыКИзменениюСтатусов"].ЗафиксироватьИзменениеСтатуса(Источник.Владелец, Источник.Ссылка, "not_on_display");
		ИначеЕсли (Источник.Отключить = Ложь 
			И РезультатЗапроса.Отключить = Истина) Тогда	// Если включается выгрузка на Prom.ua
			РегистрыСведений["eComm_ТоварыКИзменениюСтатусов"].ЗафиксироватьИзменениеСтатуса(Источник.Владелец, Источник.Ссылка, "on_display");
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура eComm_СправочникиПриЗаписи(Источник, Отказ) Экспорт
	
	Возврат;
	СтандартнаяОбработка = Истина;
	eCommСерверПереопределяемый.СправочникиПриЗаписи(Источник, Отказ, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.Номенклатура") Тогда
		
		МассивУзловТовары = МассивУзловДляРегистрации();
		Если МассивУзловТовары.Количество() = 0 Тогда 
			Возврат;
		КонецЕсли;
		
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловТовары, Источник.Ссылка);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.eComm_ИнтернетТовары") Тогда
		
		Если ЗначениеЗаполнено(Источник.Владелец) Тогда 
			
			МассивУзловТовары = МассивУзловДляРегистрации(Источник.Владелец);
			Если МассивУзловТовары.Количество() = 0 Тогда 
				Возврат;
			КонецЕсли;
			
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловТовары, Источник.Номенклатура);
			
		КонецЕсли;
		
	Иначе
		
		// Изображения номенклатуры
		ИмяСправочника_НоменклатураПрисоединенныеФайлы = ВернутьИмяПрикладногоОбъекта("НоменклатураПрисоединенныеФайлы");
		
		Если ЗначениеЗаполнено(ИмяСправочника_НоменклатураПрисоединенныеФайлы) 
			И ТипЗнч(Источник) = Тип("СправочникОбъект." + ИмяСправочника_НоменклатураПрисоединенныеФайлы) Тогда 
			
			МассивУзловТовары = МассивУзловДляРегистрации();
			Если МассивУзловТовары.Количество() = 0 Тогда 
				Возврат;
			КонецЕсли;
			
			ИмяРеквизита_ВладелецФайла = ВернутьИмяРеквизитаОбъекта("НоменклатураПрисоединенныеФайлы", "ВладелецФайла");
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловТовары, Источник[ИмяРеквизита_ВладелецФайла]);
			
		КонецЕсли;
		
		
		// Изображения характеристики
		ИмяСправочника_ХарактеристикиНоменклатурыПрисоединенныеФайлы = ВернутьИмяПрикладногоОбъекта("ХарактеристикиНоменклатурыПрисоединенныеФайлы");
		
		Если ЗначениеЗаполнено(ИмяСправочника_ХарактеристикиНоменклатурыПрисоединенныеФайлы) 
			И ТипЗнч(Источник) = Тип("СправочникОбъект." + ИмяСправочника_ХарактеристикиНоменклатурыПрисоединенныеФайлы) Тогда 
			
			МассивУзловТовары = МассивУзловДляРегистрации();
			Если МассивУзловТовары.Количество() = 0 Тогда 
				Возврат;
			КонецЕсли;
			
			ИмяРеквизита_ВладелецФайла 	= ВернутьИмяРеквизитаОбъекта("НоменклатураПрисоединенныеФайлы", "ВладелецФайла");
			ХарактеристикаСсылка 		= Источник[ИмяРеквизита_ВладелецФайла];
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ХарактеристикиНоменклатуры.Владелец КАК Владелец
				|ИЗ
				|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
				|ГДЕ
				|	ХарактеристикиНоменклатуры.Ссылка = &ХарактеристикаСсылка";
			
			Запрос.УстановитьПараметр("ХарактеристикаСсылка", ХарактеристикаСсылка);
			
			РезультатЗапроса = Запрос.Выполнить().Выбрать();
			
			Если РезультатЗапроса.Следующий() 
				И ТипЗнч(РезультатЗапроса.Владелец) = Тип("СправочникСсылка.Номенклатура") Тогда 
				ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловТовары, РезультатЗапроса.Владелец);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура eComm_ДокументыПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Возврат;	
	
	СтандартнаяОбработка = Истина;
	eCommСерверПереопределяемый.ДокументыПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяДокументаЗаказ 			= ВернутьИмяДокументЗаказ();
	ИмяРеквизитаСостояниеЗаказа = ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "СостояниеЗаказа");
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект." + ИмяДокументаЗаказ) Тогда
		
		Если ЗначениеЗаполнено(Источник.eComm_ИсточникЗаказа)
			И ЗначениеЗаполнено(Источник[ИмяРеквизитаСостояниеЗаказа])
			И НЕ Источник.ПометкаУдаления Тогда       											
			
			Если ИмяКонфигурации() = "BASSmallBusiness" Тогда 
				Запрос = ВернутьЗапросСостоянияЗаказаУНФ(Источник, ИмяРеквизитаСостояниеЗаказа);
			Иначе
				Запрос = ВернутьЗапросСостоянияЗаказа(Источник, ИмяРеквизитаСостояниеЗаказа);
			КонецЕсли;
			
			МассивРезультатов = Запрос.ВыполнитьПакет();
			ВыборкаПредыдущегоСостояния = МассивРезультатов[0].Выбрать();
			ВыборкаТекущегоСостояния 	= МассивРезультатов[1].Выбрать();
						
			Если ВыборкаПредыдущегоСостояния.Следующий() Тогда 
				ПредыдущееСостояниеЗаказаТоргПлощадки = ВыборкаПредыдущегоСостояния.СостояниеЗаказаТорговойПлощадки;
			Иначе
				ПредыдущееСостояниеЗаказаТоргПлощадки = Неопределено;
			КонецЕсли;
			
			Если ВыборкаТекущегоСостояния.Следующий() Тогда 
				ТекущееСостояниеЗаказаТоргПлощадки 	= ВыборкаТекущегоСостояния.ТекущееСостояниеЗаказа;
				ТекущееСостояниеСсылка 				= ВыборкаТекущегоСостояния.Ссылка;
			Иначе
				ТекущееСостояниеЗаказаТоргПлощадки 	= Неопределено;
				ТекущееСостояниеСсылка 				= Неопределено;
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(Источник.Ссылка) Тогда 
				ДокСсылка = Документы[ИмяДокументаЗаказ].ПолучитьСсылку();
				Источник.УстановитьСсылкуНового(ДокСсылка);
			Иначе
				ДокСсылка = Источник.Ссылка;
			КонецЕсли;
			
			Если НЕ ПредыдущееСостояниеЗаказаТоргПлощадки = ТекущееСостояниеЗаказаТоргПлощадки 
				И ЗначениеЗаполнено(ТекущееСостояниеСсылка) Тогда 
				МенезжерЗаписи = РегистрыСведений.eComm_ЗаказыКИзменениюСтатусов.СоздатьМенеджерЗаписи();
				МенезжерЗаписи.Период			= ТекущаяДата();
				МенезжерЗаписи.УчетнаяЗапись 	= Источник.eComm_ИсточникЗаказа;
				МенезжерЗаписи.Заказ			= ДокСсылка;
				МенезжерЗаписи.Статус			= ТекущееСостояниеСсылка;
				МенезжерЗаписи.Записать(Истина);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура eComm_РегистрыПриЗаписи(Источник, Отказ, Замещение) Экспорт
	Возврат;
	СтандартнаяОбработка = Истина;
	eCommСерверПереопределяемый.РегистрыПриЗаписи(Источник, Отказ, Замещение, СтандартнаяОбработка);
	
