Функция СравнитьВерсии(Знач СтрокаВерсии1, Знач СтрокаВерсии2) Экспорт
	
	Строка1 = ?(ПустаяСтрока(СтрокаВерсии1), "0.0.0.0", СтрокаВерсии1);
	Строка2 = ?(ПустаяСтрока(СтрокаВерсии2), "0.0.0.0", СтрокаВерсии2);
	Версия1 = РазложитьСтрокуВМассивПодстрок(Строка1, ".", Истина, Истина);
	Если Версия1.Количество() <> 4 Тогда
		ВызватьИсключение(СтрЗаменить(НСтр("ru='Неправильный формат параметра СтрокаВерсии1: %1';uk='Неправильний формат параметра СтрокаВерсии1: %1'"), "%1", СтрокаВерсии1));
	КонецЕсли;
	Версия2 = РазложитьСтрокуВМассивПодстрок(Строка2, ".", Истина, Истина);
	Если Версия2.Количество() <> 4 Тогда
		ВызватьИсключение(СтрЗаменить(НСтр("ru='Неправильный формат параметра СтрокаВерсии2: %1';uk='Неправильний формат параметра СтрокаВерсии2: %1'"), "%1", СтрокаВерсии2));
	КонецЕсли;
	
	Результат = 0;
	Для Разряд = 0 По 3 Цикл
		Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
		Если Результат <> 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьРазличияВТаблицах(Таблица1, Таблица2) Экспорт
	
	//Опеределяем перечень колонок Таблица1
    ВсеКолонки = "";
    Для Каждого Колонка Из Таблица1.Колонки Цикл 
        ВсеКолонки = ВсеКолонки + ", " + Колонка.Имя
    КонецЦикла;
    ВсеКолонки = Сред(ВсеКолонки, 3);
	
	//Вносим данные из Таблица1 в новую общую таблицу 
    Таблица = Таблица2.Скопировать();    
	
	//Вносим данные из Таблица2 в новую общую таблицу 
	Для инд = 1 По Таблица1.Количество() Цикл 
		Таблица.Вставить(0) 
	КонецЦикла;
	Для инд = 0 По Таблица1.Колонки.Количество() - 1 Цикл 
		Таблица.ЗагрузитьКолонку(Таблица1.ВыгрузитьКолонку(инд), инд) 
	КонецЦикла;
	
	//Добавляем новую колонку в общую таблицу и заполняем значением 1
    Таблица.Колонки.Добавить("Счёт");
    Таблица.ЗаполнитьЗначения(1, "Счёт");
	
	//Сворачиваем таблицу так чтобы все колонки группировались, а колонка Счет сумировалась
	//Идентичные схлопнутся со значением 2 в колонке Счет
    Таблица.Свернуть(ВсеКолонки, "Счёт");
	
	//Делаем отбор строк по колонке Счет со значением 1, если хоть что-то есть, то присутствуют различия
	Возврат Таблица.Скопировать(Новый Структура("Счёт", 1), ВсеКолонки).Количество() > 0;
    
КонецФункции

Функция ТипПлатформыСтрокой() Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда 
		ТипПлатформыСтрокой = "Windows";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64 Тогда 
		ТипПлатформыСтрокой = "Linux";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.MacOS_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.MacOS_x86_64 Тогда 
		ТипПлатформыСтрокой = "MacOS";
	Иначе
		ТипПлатформыСтрокой = "";
	КонецЕсли;
	
	Возврат ТипПлатформыСтрокой;
	
КонецФункции

