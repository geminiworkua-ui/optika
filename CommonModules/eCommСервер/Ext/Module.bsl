Функция ВернутьМассивНомеровТелефонов(Телефон) Экспорт

	МассивНомеров = Новый Массив;
	
	ТелефонБезРазделителей = "";
	Для а = 1 По СтрДлина(Телефон) Цикл
		КодСимвола = КодСимвола(Сред(Телефон, а, 1));
		Цифра = Сред(Телефон, а, 1);
		Если (КодСимвола >= 48 И КодСимвола <= 57) Тогда
			ТелефонБезРазделителей = ТелефонБезРазделителей + Цифра;
		КонецЕсли; 
	КонецЦикла;
	
	МассивНомеров.Добавить(ТелефонБезРазделителей);
	
	ДлинаНомера = СтрДлина(ТелефонБезРазделителей);
	
	Если ДлинаНомера > 10 
		И Сред(ТелефонБезРазделителей, ДлинаНомера - 10, 1) = "8" Тогда 
		Для Сч = 10 По ДлинаНомера Цикл 
			МассивНомеров.Добавить(Прав(ТелефонБезРазделителей, Сч));
		КонецЦикла;
		
	ИначеЕсли ДлинаНомера = 10 Тогда 
		МассивНомеров.Добавить(	"8" + ТелефонБезРазделителей);
		МассивНомеров.Добавить("38" + ТелефонБезРазделителей);
	КонецЕсли;
	
	Возврат МассивНомеров;

КонецФункции

Функция ВернутьСтруктуруАдреса(Адрес) Экспорт

	// "Киев, ул. Ямская 35/34, оф. 115"
	// "Великие Мосты, ул. Львівська вул., дом. 166"
	СтруктураАдреса = Новый Структура("НаселенныйПункт, Улица, НомерДома, НомерКвартиры", "", "", "", "");
	
	МассивПодстрок = РазложитьСтрокуВМассивПодстрок(Адрес, ",", Истина, Истина);
	Если МассивПодстрок.Количество() > 0 Тогда 
		СтруктураАдреса.НаселенныйПункт = СокрЛП(МассивПодстрок[0]);
	КонецЕсли;
	
	Если МассивПодстрок.Количество() > 1 Тогда
		УлицаСтрокой = МассивПодстрок[1];
		УлицаСтрокой = СтрЗаменить(УлицаСтрокой, "вул.", "");
		УлицаСтрокой = СтрЗаменить(УлицаСтрокой, "ул.", "");
		СтруктураАдреса.Улица = СокрЛП(УлицаСтрокой);
	КонецЕсли;
	
	Если МассивПодстрок.Количество() > 2 Тогда 
		СтруктураАдреса.НомерДома = СокрЛП(МассивПодстрок[2]);
	КонецЕсли;
	
	Если МассивПодстрок.Количество() > 3 Тогда 
		СтруктураАдреса.НомерКвартиры = СокрЛП(МассивПодстрок[3]);
	КонецЕсли;
	
	Возврат СтруктураАдреса;

КонецФункции

