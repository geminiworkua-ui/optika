			ИначеЕсли ИмяОбъекта = "ЗначенияНоменклатурыПоУмолчанию" Тогда 
				Результат = "";
			ИначеЕсли ИмяОбъекта = "ЮрФизЛицо" Тогда 
				Результат = "КомпанияЧастноеЛицо";
			ИначеЕсли ИмяОбъекта = "СпособыРасчетаЦеныНабора" Тогда 
				Результат = "ВариантыРасчетаЦенНаборов";
			ИначеЕсли ИмяОбъекта = "НоменклатураПрисоединенныеФайлы" Тогда 
				Результат = "НоменклатураПрисоединенныеФайлы";
			ИначеЕсли ИмяОбъекта = "ХарактеристикиНоменклатурыПрисоединенныеФайлы" Тогда 
				Результат = "";
			ИначеЕсли ИмяОбъекта = "ИспользоватьПартнеровКакКонтрагентов" Тогда 
				Результат = "ИспользоватьПартнеровКакКонтрагентов";
			ИначеЕсли ИмяОбъекта = "ФункциональнаяОпцияРезервированиеЗапасов" Тогда 
				Результат = "";
			ИначеЕсли ИмяОбъекта = "КонтактныеЛица" Тогда 
				Результат = "КонтактныеЛицаПартнеров";
			ИначеЕсли ИмяОбъекта = "КатегорииНоменклатуры" Тогда 
				Результат = "ВидыНоменклатуры";
			ИначеЕсли ИмяОбъекта = "СоглашенияСКлиентами" Тогда 
