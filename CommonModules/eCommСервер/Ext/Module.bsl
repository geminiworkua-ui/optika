	Если ТипЗнч(ПоляДляПеревода) = Тип("СписокЗначений") Тогда
		// Актуальный вариант настроек
		
		ЭлементСписка = ПоляДляПеревода.НайтиПоЗначению(ИмяРеквизита);
		
		Если НЕ ЭлементСписка = Неопределено 
			И ЭлементСписка.Пометка = Истина Тогда 
			Результат = Истина;
		Иначе
			Результат = Ложь;
		КонецЕсли;
		
	Иначе
		// Старый вариант настроек. Переводим все
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция НоменклатураИспользуетХарактеристики(Номенклатура) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА &ИспользоватьХарактеристики
		|				И Номенклатура.#ИспользоватьХарактеристики#
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|	КОНЕЦ КАК ХарактеристикаНоменклатуры,
		|	ВЫБОР
		|		КОГДА &ИспользоватьХарактеристики
		|				И Номенклатура.#ИспользоватьХарактеристики#
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ИспользоватьХарактеристики
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &ПараметрКоманды
		|;";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИспользоватьХарактеристики#", ВернутьИмяРеквизитаОбъекта("Номенклатура", "ИспользоватьХарактеристики"));
	
	Запрос.УстановитьПараметр("ПараметрКоманды"				, Номенклатура);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристики"	, ВключеноИспользованиеХарактеристик());
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		ИспользоватьХарактеристики = РезультатЗапроса.ИспользоватьХарактеристики;
	Иначе
		ИспользоватьХарактеристики = Ложь;
	КонецЕсли;
	
	Возврат ИспользоватьХарактеристики;

КонецФункции

