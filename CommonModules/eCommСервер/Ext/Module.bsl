Функция ВернутьИмяРеквизитаОбъекта(ИмяОбъекта, ИмяРеквизита) Экспорт

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	Результат = eCommСерверПереопределяемый.ВернутьИмяРеквизитаОбъекта(ИмяОбъекта, ИмяРеквизита, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда 
		
		ИмяКонфигурации = ИмяКонфигурации();
		
		Если ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
			
			// Документы
			Если ИмяОбъекта = "ЗаказКлиента" Тогда 
				Если ИмяРеквизита = "ДатаПоДаннымКлиента" Тогда 
					Результат = "ДатаВходящегоДокументаЭлектронногоОбмена";
				ИначеЕсли ИмяРеквизита = "НомерПоДаннымКлиента" Тогда 
					Результат = "НомерВходящегоДокументаЭлектронногоОбмена";
				ИначеЕсли ИмяРеквизита = "ВидЦен" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Источник" Тогда 
					Результат = "eComm_ИсточникЗаказа";
				ИначеЕсли ИмяРеквизита = "СостояниеЗаказа" Тогда 
					Результат = "eComm_СостояниеЗаказа";
				ИначеЕсли ИмяРеквизита = "Договор" Тогда 
					Результат = "ДоговорКонтрагента";
				ИначеЕсли ИмяРеквизита = "СпособДоставки" Тогда
					Результат = ""; 
				ИначеЕсли ИмяРеквизита = "ПеревозчикПартнер" Тогда
					Результат = "Грузоотправитель";
				ИначеЕсли ИмяРеквизита = "ТрекНомер" Тогда
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Товары" Тогда 
					Результат = "Товары";
				ИначеЕсли ИмяРеквизита = "Товары_Характеристика" Тогда 
					Результат = "ХарактеристикаНоменклатуры";
				ИначеЕсли ИмяРеквизита = "Товары_ПроцентСкидкиНаценки" Тогда 
					Результат = "ПроцентСкидкиНаценки";
				ИначеЕсли ИмяРеквизита = "Товары_СуммаСкидкиНаценки" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Товары_Всего" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Товары_Резерв" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "ДополнительныеРеквизиты" Тогда 
					Результат = "ЗначенияСвойствОбъектов";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "ОперацияПоПлатежнымКартам" Тогда 
				Если ИмяРеквизита = "Курс" Тогда 
					Результат = "";
				КонецЕсли;
			// Справочники
			ИначеЕсли ИмяОбъекта = "ВидыКонтактнойИнформации" Тогда 
				Если ИмяРеквизита = "ТелефонКонтрагента" Тогда 
					Результат = "ТелефонКонтрагента";
				ИначеЕсли ИмяРеквизита = "АдресЭлектроннойПочтыКонтрагента" Тогда 
					Результат = "АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами";
				ИначеЕсли ИмяРеквизита = "АдресДоставкиКонтрагента" Тогда 
					Результат = "АдресДоставкиКонтрагента";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "НаборыДополнительныхРеквизитовИСведений" Тогда 
				Если ИмяРеквизита = "ОперацияПоПлатежнойКарте" Тогда 
					Результат = "Документ_ОперацияПоПлатежнымКартам";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "Номенклатура" Тогда 
				Если ИмяРеквизита = "ИспользоватьХарактеристики" Тогда 
					Результат = "ВестиУчетПоХарактеристикам";
				ИначеЕсли ИмяРеквизита = "Описание" Тогда 
					Результат = "ДополнительноеОписаниеНоменклатуры";
				ИначеЕсли ИмяРеквизита = "КатегорияНоменклатуры" Тогда 
					Результат = "НоменклатурнаяГруппа";
				ИначеЕсли ИмяРеквизита = "Производитель" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "СтранаПроисхождения" Тогда 
					Результат = "СтранаПроисхождения";
				ИначеЕсли ИмяРеквизита = "ЭтоНабор" Тогда 
					Результат = "Комплект";
				ИначеЕсли ИмяРеквизита = "СпособРасчетаЦеныНабора" Тогда 
					Результат = "";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "ХарактеристикиНоменклатуры" Тогда
				Если ИмяРеквизита = "Артикул" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Недействителен" Тогда 
					Результат = "";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "КатегорииНоменклатуры" Тогда 
				Если ИмяРеквизита = "КатегорияНоменклатуры" Тогда 
					Результат = "НоменклатурнаяГруппа";                      // Пересмотреть
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "Партнеры" Тогда 
				Если ИмяРеквизита = "ЮрФизЛицо" Тогда 
					Результат = "ЮрФизЛицо";
				ИначеЕсли ИмяРеквизита = "Клиент" Тогда 
					Результат = "Покупатель";
				ИначеЕсли ИмяРеквизита = "ГруппаДоступа" Тогда 
					Результат = "ГруппаДоступаККонтрагенту";
				ИначеЕсли ИмяРеквизита = "НаименованиеПолное" Тогда 
					Результат = "НаименованиеПолное";
				ИначеЕсли ИмяРеквизита = "НомерТелефона" Тогда 
					Результат = "";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "ДоговорСКонтрагентом" Тогда 
				Если ИмяРеквизита = "Валюта" Тогда 
					Результат = "ВалютаВзаиморасчетов";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "НоменклатураПрисоединенныеФайлы" Тогда 
				Если ИмяРеквизита = "ВладелецФайла" Тогда 
					Результат = "Объект";
				КонецЕсли;
			// Перечисления
			ИначеЕсли ИмяОбъекта = "ЮрФизЛицо" Тогда 
				Если ИмяРеквизита = "ФизЛицо" Тогда 
					Результат = "ФизЛицо";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "СпособыРасчетаЦеныНабора" Тогда 
				Если ИмяРеквизита = "СкладыватьИзЦенКомплектующих" Тогда 
					Результат = "";
				КонецЕсли;
			// Другое
			ИначеЕсли ИмяОбъекта = "ЦеныНоменклатуры" Тогда 
				Если ИмяРеквизита = "ВидЦен" Тогда 
					Результат = "ТипЦен";
				ИначеЕсли ИмяРеквизита = "Валюта" Тогда 
					Результат = "Валюта";
				ИначеЕсли ИмяРеквизита = "Характеристика" Тогда 
