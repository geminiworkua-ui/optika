					Результат = "РассчитываетсяИзЦенКомплектующих";
				КонецЕсли;
			// Другое
			ИначеЕсли ИмяОбъекта = "ЦеныНоменклатуры" Тогда 
				Если ИмяРеквизита = "ВидЦен" Тогда 
					Результат = "ВидЦены";
				ИначеЕсли ИмяРеквизита = "Валюта" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Характеристика" Тогда 
					Результат = "Характеристика";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "ЗначенияСвойствНоменклатуры" Тогда 
				Если ИмяРеквизита = "Номенклатура" Тогда 
					Результат = "Ссылка";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "СопутствующиеТовары" Тогда 
				Если ИмяРеквизита = "ХарактеристикаСопутствующегоТовара" Тогда 
					Результат = "";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "СоставНаборов" Тогда 
				Если ИмяРеквизита = "НоменклатураНабора" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "ХарактеристикаНабора" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Номенклатура" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Характеристика" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Общий" Тогда 
					Результат = "";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "КонтактнаяИнформация" Тогда 
				Если ИмяРеквизита = "Объект" Тогда 
					Результат = "Ссылка";
				ИначеЕсли ИмяРеквизита = "НомерТелефона" Тогда 
					Результат = "НомерТелефона";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "ПВХДополнительныеРеквизиты" Тогда 
				Если ИмяРеквизита = "Заголовок" Тогда 
					Результат = "Заголовок";
				ИначеЕсли ИмяРеквизита = "Имя" Тогда 
					Результат = "пРРО_eComm_Имя";
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ВернутьИмяЗначенияПеречисления(ЗначениеПеречисления) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗначениеПеречисления) Тогда 
		Возврат "";
	КонецЕсли;
	
	ИмяПеречисления = ЗначениеПеречисления.Метаданные().Имя;
	ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ЗначениеПеречисления);
	
	Возврат Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;

КонецФункции

Функция ВернутьТекстЗапросаПоТоварам(СтруктураНастроек) Экспорт
	
	ИспользоватьВстроенныйОбработчик = Истина;
	
	ТекстЗапроса = eCommСерверПереопределяемый.ВернутьТекстЗапросаПоТоварам(СтруктураНастроек, ИспользоватьВстроенныйОбработчик);
	
	Если НЕ ИспользоватьВстроенныйОбработчик = Ложь Тогда 
		
		ИмяКонфигурации = ИмяКонфигурации();
		
		Если ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда 
			
			ТекстЗапроса = ВернутьТекстЗапросаПоТоварамУТП(СтруктураНастроек);
						
		ИначеЕсли ИмяКонфигурации = "BASSmallBusiness" Тогда 
			
			ТекстЗапроса = ВернутьТекстЗапросаПоТоварамУНФ(СтруктураНастроек);
				
		Иначе
			
			ИмяМетаданных = Метаданные.Имя;
			
			Если ИмяМетаданных = "BASУправлениеТорговлей" 
				ИЛИ ИмяМетаданных = "BASERP" 
				ИЛИ ИмяМетаданных = "BASКомплексноеУправлениеПредприятием" Тогда
				ТекстЗапроса = ВернутьТекстЗапросаПоТоварамУТBAS(СтруктураНастроек);
			Иначе
				ТекстЗапроса = ВернутьТекстЗапросаПоТоварамУТ3(СтруктураНастроек);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат ТекстЗапроса;

КонецФункции 

Функция ВернутьТекстЗапросаПоТоварамУНФ(СтруктураНастроек)

		ТекстЗапроса = "ВЫБРАТЬ
		|	УзелОбмена.Ссылка КАК УзелОбмена,
		|	УзелОбмена.УчетнаяЗапись
		|ПОМЕСТИТЬ ВрТабУзелОбмена
		|ИЗ
		|	ПланОбмена.eComm_Обмен КАК УзелОбмена
		|ГДЕ
		|	УзелОбмена.УчетнаяЗапись В
		|			(ВЫБРАТЬ
		|				УчетныеЗаписи.Ссылка
		|			ИЗ
		|				Справочник.eComm_УчетныеЗаписи КАК УчетныеЗаписи
		|			ГДЕ
		|				УчетныеЗаписи.Ссылка = &УчетнаяЗапись
		|				И &ВыгружатьТолькоИзменения = ИСТИНА)
		|	И УзелОбмена.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НоменклатураИзменения.Ссылка КАК Номенклатура
		|ПОМЕСТИТЬ ВрТабНоменклатураИзменения
		|ИЗ
		|	Справочник.Номенклатура.Изменения КАК НоменклатураИзменения
		|ГДЕ
		|	НоменклатураИзменения.Узел В
		|			(ВЫБРАТЬ
		|				ВрТабУзелОбмена.УзелОбмена
		|			ИЗ
		|				ВрТабУзелОбмена КАК ВрТабУзелОбмена)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СпрНоменклатура.Ссылка КАК Номенклатура,
		|	СпрНоменклатура.КатегорияНоменклатуры,
		|	СпрНоменклатура.ЭтоГруппа
		|ПОМЕСТИТЬ ВрТабНоменклатура
		|ИЗ
		|	Справочник.Номенклатура КАК СпрНоменклатура
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &УчетнаяЗапись В
		|					(ВЫБРАТЬ
		|						ВрТабУзелОбмена.УчетнаяЗапись
		|					ИЗ
		|						ВрТабУзелОбмена КАК ВрТабУзелОбмена)
		|				ТОГДА СпрНоменклатура.Ссылка В
		|						(ВЫБРАТЬ
		|							ВрТабНоменклатураИзменения.Номенклатура
		|						ИЗ
		|							ВрТабНоменклатураИзменения КАК ВрТабНоменклатураИзменения)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И СпрНоменклатура.ЭтоГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВрТабНоменклатура.Номенклатура,
		|	ЕСТЬNULL(СпрХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаНоменклатуры,
		|	ВрТабНоменклатура.ЭтоГруппа
		|ПОМЕСТИТЬ ВрТабНоменклатураХарактеристики
		|ИЗ
		|	ВрТабНоменклатура КАК ВрТабНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
		|		ПО (ВрТабНоменклатура.Номенклатура = СпрХарактеристикиНоменклатуры.Владелец
		|				ИЛИ ВрТабНоменклатура.КатегорияНоменклатуры = СпрХарактеристикиНоменклатуры.Владелец)
		|			И (&ИспользоватьХарактеристики)
		|			И (ВрТабНоменклатура.Номенклатура.ИспользоватьХарактеристики)
		|			И СпрХарактеристикиНоменклатуры.ПометкаУдаления = Ложь
		|			И НЕ СпрХарактеристикиНоменклатуры.Недействителен = Истина
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// 
		|ВЫБРАТЬ
		|	ЗапросПоОстаткам.Номенклатура КАК Номенклатура,
		|	ЗапросПоОстаткам.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	СУММА(ЗапросПоОстаткам.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ОстаткиНоменклатуры
		|ИЗ
