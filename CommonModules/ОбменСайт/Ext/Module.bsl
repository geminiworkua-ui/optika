	ТипДанных = "Nomenclature";
	Для НомерПакета = 0 по КоличПакетов-1 цикл
		ТЗ = СформироватьПакет(НомерПакета, Выборка, РазмерМассива, Узел.ШагОтправкиОписание); 
		Данные = ЗаполнитьСтруктуруНоменклатуры(ТЗ, Узел, СписокУдаления);
		СтруктураОтправки = Новый Структура();  
		СтруктураОтправки = ОбменСайт.СформироватьДанныеОчки(ТипДанных, Данные, Узел);
		СписокУдаления = ТЗ.ВыгрузитьКолонку("Ссылка");
		ОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Узел, ТипДанных, "", СписокУдаления, Отказ, Перечисления.НаправлениеДляПередачи.Описание);	
	КонецЦикла;
		
КонецПроцедуры

Функция СформироватьПакет(НомерПакета, Данные, РазмерМассива, Шаготправки) 
    	УстановитьПРивилегированныйрежим(Истина);

		ТаблицаЗначений = обСкопироватьКолонки(Данные); 
		
		Для Инд = НомерПакета*ШагОтправки по мин((НомерПакета+1)*ШагОтправки-1, РазмерМассива-1) 	Цикл  
			СтрокаДанных = Данные[Инд];
			СтрокаТЗ = ТаблицаЗначений.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЗ, Данные[Инд]); 
		КонецЦикла;
		
Возврат ТаблицаЗначений;
КонецФункции	

Функция обСкопироватьКолонки(ТЗ) Экспорт
		УстановитьПРивилегированныйрежим(Истина);

	Копия = Новый ТаблицаЗначений;
   Для Каждого Колонка Из ТЗ.Колонки Цикл
       Копия.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
   КонецЦикла;
   Возврат Копия;
КонецФункции

Функция ПолучитьСовместноПродаваемуюНоменклатуру(Номенклатура)
	УстановитьПРивилегированныйрежим(Истина);
	
	Массив = Новый Массив;
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка КАК Предпосылка,
	               |	НоменклатураПродаваемаяСовместно.НоменклатураСледствие КАК Следствие
	               |ИЗ
	               |	РегистрСведений.НоменклатураПродаваемаяСовместно КАК НоменклатураПродаваемаяСовместно
	               |ГДЕ
	               |	(НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка = &Номенклатура
	               |			ИЛИ НоменклатураПродаваемаяСовместно.НоменклатураСледствие = &Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Результат Цикл
		
		Если Строка.Предпосылка = Номенклатура Тогда 
			УИД = Строка.Следствие.УникальныйИдентификатор();
		КонецЕсли;
		
		Если Строка.Следствие = Номенклатура Тогда 
			УИД = Строка.Предпосылка.УникальныйИдентификатор();
		КонецЕсли;
		
		Массив.Добавить(УИД);
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция ЗаполнитьСтруктуруНоменклатуры(Выборка,Узел, СписокУдаления)
		УстановитьПРивилегированныйрежим(Истина);

	Массив = Новый Массив;
	
	Для Каждого Строка Из Выборка Цикл 
		СобщениеОбОшибке ="";
		Если Строка.Ссылка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		Если Строка.Ссылка = Справочники.Номенклатура.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;
		
		    // ++ Боков
			//СобщениеОбОшибке= СокрЛП(СобщениеОбОшибке + " " +  Строка(Строка.Ссылка));
			// -- Боков
		    ЕстьОшибка = Ложь;

			УИДНом 				= ОпределитьУИД(Строка.Ссылка); 
		
			УИДБренд 			= ОпределитьУИД(Строка.Марка); 
			
			Если УИДБренд = Null Тогда 
				СобщениеОбОшибке = СобщениеОбОшибке + " Не указан бренд; ";
				УИДБренд = "";
			КонецЕсли;	
			
			УИДПроизводитель 	= ОпределитьУИД(Строка.Производитель);

			Если УИДПроизводитель = Null Тогда
				СобщениеОбОшибке = СобщениеОбОшибке + " Не указан Производитель; "; 
				УИДПроизводитель = "";
			КонецЕсли;
			
			УИДКатегория 		= ОпределитьУИД(Строка.ТоварнаяКатегория);
			
			Если УИДКатегория = Null Тогда
				СобщениеОбОшибке = СобщениеОбОшибке + " Не указана категория; ";  
				УИДКатегория = "";
			КонецЕсли;

			Структура = Новый Структура;
			
			Структура.Вставить("ID", УИДНом);
			
			// ++ Боков А.А. 11.09.2025 
			// проверим условвия необходимости пометки на удаление
			Если Строка.ССылка.ПометкаУдаления
				ИЛИ НЕ Строка.Ссылка.РазрешенОбменСайт
				ИЛИ (Узел.Код = "0002" и НЕ Строка.Ссылка.СайтLuxor)
				ИЛИ (Узел.Код = "0001" и НЕ Строка.Ссылка.СайтPolaroid)				
				Тогда
			Структура.Вставить("Del", истина);
			Иначе
	        Структура.Вставить("Del", Ложь);
			КонецЕсли;
			//--			
			//Структура.Вставить("Del", Строка.ПометкаУдаления);
			
			Структура.Вставить("ID_Brand", УИДБренд);
			Структура.Вставить("ID_Man", УИДПроизводитель); 
			
			Структура.Вставить("ID_Cat", УИДКатегория);  
			Если Строка.Ссылка.ФайлКартинки = Справочники.НоменклатураПрисоединенныеФайлы.ПустаяСсылка() Тогда
					СобщениеОбОшибке = СобщениеОбОшибке + " Не указано фото по умолчанию; ";

			КОнецЕсли;	
			Структура.Вставить("PictureMain", Строка(Строка.Ссылка.ФайлКартинки.УникальныйИдентификатор())); // Нет в базе
			Структура.Вставить("BestSeller", Строка.Ссылка.BestSeller); // Нет в базе
			Структура.Вставить("Only_Box", Строка.Ссылка.ТолькоКоробка); //  Нет в базе
			
			Структура.Вставить("Accompanying", ПолучитьСовместноПродаваемуюНоменклатуру(Строка.Ссылка)); //  Нет в базе 
			Если СокрЛП(Строка.НаименованиеПолное) = "" Тогда
					СобщениеОбОшибке = СобщениеОбОшибке + " Не указано Полное наименование (UA); ";
			КонецЕсли;	
			Структура.Вставить("Name_UA", Строка.НаименованиеПолное);
			
			Если СокрЛП(Строка.НаименованиеПолное_RU) = "" Тогда
					СобщениеОбОшибке = СобщениеОбОшибке + " Не указано Полное наименование (RU); ";
				    ЕстьОшибка = Истина;
			КонецЕсли;	
			Структура.Вставить("Name_RU", ? (Строка.НаименованиеПолное_RU = "", Строка.НаименованиеПолное, Строка.НаименованиеПолное_RU) ); //Нет поля в базе
			
			Если СокрЛП(Строка.Описание) = "" Тогда
					СобщениеОбОшибке = СобщениеОбОшибке + " Не указано Описание (UA); "; 
					 ЕстьОшибка = Истина;
			КонецЕсли;	

			Структура.Вставить("Description_UA", Строка.Описание); 
			
			Если СокрЛП(Строка.Описание_RU) = "" Тогда
					СобщениеОбОшибке = СобщениеОбОшибке + " Не указано Описание (RU); ";
			КонецЕсли;
			Структура.Вставить("Description_RU", ?(Строка.Описание_RU = "", Строка.Описание, Строка.Описание_RU) ); //Нет поля в базе
			
			Если СокрЛП(Строка.Модель) = "" Тогда
				СобщениеОбОшибке = СобщениеОбОшибке + " Не указана модель (UA); ";
			КонецЕсли;	
            Структура.Вставить("Model_UA", Строка.Модель); 
			
			Если СокрЛП(Строка.Модель_RU) = "" Тогда
				СобщениеОбОшибке = СобщениеОбОшибке + " Не указана модель (RU); ";
			КонецЕсли;	
            Структура.Вставить("Model_RU", ?(Строка.Модель_RU="", Строка.Модель, Строка.Модель_RU)); //Нет поля в базе
			
			// ++ Боков А.А. 14.10.2025 
			Структура.Вставить("PackName", Строка(Строка.ЕдиницаИзмерения));
			// -- Боков А.А.
			
			// ++ Боков. Вместе с номенклмастурой понесем характеристики
			Если НЕ Строка.ссылка.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
				мРез = Новый Массив;	
				ЗапросХ = Новый Запрос("ВЫБРАТЬ
				                      |	ХарактеристикиНоменклатуры.Ссылка,
				                      |	ХарактеристикиНоменклатуры.Владелец КАК Владелец,
				                      |	ХарактеристикиНоменклатуры.Наименование,
				                      |	ХарактеристикиНоменклатуры.НаименованиеПолное
				                      |ИЗ
				                      |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
				                      |ГДЕ
				                      |	НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
				                      |	И ХарактеристикиНоменклатуры.Владелец = &Владелец");
				ЗапросХ.УстановитьПараметр("Владелец", Строка.Ссылка);
				ВыборкаХ = ЗапросХ.Выполнить().Выбрать();
				Пока ВыборкаХ.Следующий() Цикл
					П = новый Структура("ID, ID_Ser, IDSname");
					П.ID_Ser = Строка(ВыборкаХ.Ссылка.УникальныйИдентификатор());
					П.ID = Строка(УИДНом);
					П.IDSname = ВыборкаХ.НаименованиеПолное; 
					
					Если ЗначениеЗаполнено(Строка.Ссылка.СвойстваОбъектовНабор)
						Тогда
						мСвойств = новый Массив;
						Для каждого типХаракт из  Строка.Ссылка.СвойстваОбъектовНабор.Состав цикл
							ПП = Новый Структура("ID_Pro, Name_UA", 
							Строка(ИнфралайнОбмен.ПолучитьУИД_ПоИмениСвойста(Строка(типХаракт.Свойство))),
							Строка(ВыборкаХ.Ссылка[Строка(типХаракт.Свойство)]));
							мСвойств.Добавить(ПП);							
						КонецЦикла; 
						п.Вставить("Attributes", мСвойств);
					КонецЕсли;
					мРез.Добавить(П);
				КонецЦикла;
				Структура.Вставить("Series", мРез);	
			КонецЕсли;	
			//--
			//Массив.Добавить(Структура);  
			
			Если НЕ ЕстьОшибка Тогда 
				Массив.Добавить(Структура);     
			Иначе              
				ТипДанных = "Описание";
				СобщениеОбОшибке = Строка(Строка.Ссылка) + " " + СобщениеОбОшибке;
				ЗаписатьОшибку(ТипДанных,Строка.Ссылка, СобщениеОбОшибке, Узел);
				Продолжить;
				//Массив.Добавить(Структура);   
				// Боков
			КонецЕсли;	
			
			НаборДанных = РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
			НаборДанных.Отбор.Номенклатура.Установить(Строка.Ссылка);
			НаборДанных.Отбор.Направление.Установить(Перечисления.НаправлениеДляПередачи.Описание);
			НаборДанных.Отбор.УзелРегистрации.Установить(Узел);
			НаборДанных.Прочитать();
			Если Не НаборДанных.Количество() = 0 Тогда
				СписокУдаления.Добавить(НаборДанных);
			Иначе
				Запись = НаборДанных.Добавить();
				Запись.Направление = Перечисления.НаправлениеДляПередачи.Описание;
				Запись.Номенклатура = Строка.Ссылка;
				Запись.УзелРегистрации = Узел;
				НаборДанных.Записать();
				СписокУдаления.Добавить(НаборДанных);
			КонецЕсли;	
			
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции 

Процедура ЗаписатьОшибку(ТипДанных, Ссылка, ТекстОшибки, Сайт)
    	УстановитьПРивилегированныйрежим(Истина);

	Запись = РегистрыСведений.ЛогированиеСайт.СоздатьМенеджерЗаписи();
Запись.Время = ТекущаяДата();
Запись.Сайт = Сайт;
Запись.Режим = "Подготовка к передаче";
Запись.ТипДанных = ТипДанных;
Запись.Статус ="Ошибка";              
Запись.КодСтатуса ="ERROR";              
Запись.Ошибка = ТекстОшибки;
Запись.Ссылка = Ссылка;
Запись.Записать(Истина);

КонецПроцедуры	

Функция ПолучитьВрачей(Полный, Узел, СписокУдаления) Экспорт
	
	УстановитьПРивилегированныйрежим(Истина);
	
	ЗапросВрачи = Новый Запрос;
	МассивВрачи = Новый Массив;
	
	Если НЕ Узел.СайтLuxor Тогда
		Возврат МассивВрачи;;
	КонецЕсли;
	
	Если Полный Тогда 
		ЗапросВрачи.Текст = "ВЫБРАТЬ
		                    |	КадроваяРасстановкаСрезПоследних.ФизическоеЛицо КАК Врач,
		                    |	КадроваяРасстановкаСрезПоследних.Актуальность КАК Актуальность,
		                    |	КадроваяРасстановкаСрезПоследних.Регистратор КАК Регистратор
		                    |ИЗ
		                    |	РегистрСведений.КадроваяРасстановка.СрезПоследних(&Дата, ) КАК КадроваяРасстановкаСрезПоследних
		                    |ГДЕ
		                    |	КадроваяРасстановкаСрезПоследних.Должность.ЭтоВрач";
		ЗапросВрачи.УстановитьПараметр("Дата",ТекущаяДата());
	//ЗапросВрачи.УстановитьПараметр("Актуальность"	,Перечисления.СтатусыСотрудников.Актуальний);
	Иначе
		ЗапросВрачи.Текст = "ВЫБРАТЬ
		                    |	КадроваяРасстановкаСрезПоследних.ФизическоеЛицо КАК Врач,
		                    |	КадроваяРасстановкаСрезПоследних.Актуальность КАК Актуальность,
		                    |	КадроваяРасстановкаСрезПоследних.Регистратор КАК Регистратор
		                    |ИЗ
		                    |	РегистрСведений.КадроваяРасстановка.Изменения КАК КадроваяРасстановкаИзменения
		                    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяРасстановка.СрезПоследних(&Дата, ) КАК КадроваяРасстановкаСрезПоследних
		                    |		ПО КадроваяРасстановкаИзменения.Регистратор = КадроваяРасстановкаСрезПоследних.Регистратор
		                    |ГДЕ
		                    |	КадроваяРасстановкаИзменения.Узел = &Узел
		                    |	И КадроваяРасстановкаСрезПоследних.Должность.ЭтоВрач";
		ЗапросВрачи.УстановитьПараметр("Дата",НачалоДня(ТекущаяДата()));
		ЗапросВрачи.УстановитьПараметр("Узел",Узел);
	
	КонецЕсли;

	
	Выборка = ЗапросВрачи.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Выборка Цикл 
		
		Актуальность = ?(Строка.Актуальность = Перечисления.СтатусыСотрудников.Актуальний,Ложь,Истина);
		Структура = Новый Структура;
		
		УИД = ОпределитьУИД(Строка.Врач);
		
		Структура.Вставить("id"		,УИД);
		Структура.Вставить("name"	,Строка.Врач.Наименование); 
		Структура.Вставить("Del"	,Актуальность);
		
		МассивВрачи.Добавить(Структура);
		
		СписокУдаления.Добавить(ПолучитьНаборЗаписей(Строка.Регистратор, Строка.Врач,РегистрыСведений.КадроваяРасстановка))
		
	КонецЦикла;
	
	Возврат МассивВрачи;
	
КонецФункции


Функция ПолучитьСписокУслуг(Узел) экспорт

	УстановитьПРивилегированныйрежим(Истина);
	
	ЗапросНоменклатура = Новый Запрос;
	МассивУслуг = Новый Массив;
	
	Если НЕ Узел.СайтLuxor Тогда
		Возврат МассивУслуг;;
	КонецЕсли;
	
	ЗапросНоменклатура.Текст = "ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка КАК НоменклатураСсылка,
	|	СправочникНоменклатура.НаименованиеПолное,
	|	СправочникНоменклатура.НаименованиеПолное_RU,
	|	СправочникНоменклатура.Описание,
	|	СправочникНоменклатура.Описание_RU,
	|	ЕСТЬNULL(ВложенныйЗапрос.Цена, 0) КАК Цена
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|			МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Цена) КАК Цена
	|		ИЗ
	|			РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЦеныНоменклатурыСрезПоследних.Номенклатура) КАК ВложенныйЗапрос
	|		ПО СправочникНоменклатура.Ссылка = ВложенныйЗапрос.Номенклатура
	|ГДЕ
	|	СправочникНоменклатура.ВидНоменклатуры = &ВидНоменклатуры
	|	И СправочникНоменклатура.СайтLuxor
	|	И НЕ СправочникНоменклатура.ПометкаУдаления";
	ЗапросНоменклатура.УстановитьПараметр("Дата",ТекущаяДата()); 
	ЗапросНоменклатура.УстановитьПараметр("ВидЦены", Справочники.ВидыЦен.НайтиПоНаименованию("Роздрібна"));
	ЗапросНоменклатура.УстановитьПараметр("ВидНоменклатуры", Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Послуги лікаря"));
	
	
	Выборка = ЗапросНоменклатура.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Выборка Цикл 
		
		Структура = Новый Структура("name, name_ru, opisanie, opisanie_ru, price", Строка.НаименованиеПолное, 
		Строка.НаименованиеПолное_RU, 
		Строка.Описание,
		Строка.Описание_RU, 
		Строка.Цена);
		
		//УИД = ОпределитьУИД(Строка.НоменклатураСсылка);
		Структура.Вставить("id"		,Строка(Строка.НоменклатураСсылка.УникальныйИдентификатор()));
		МассивУслуг.Добавить(Структура);
		
		//СписокУдаления.Добавить(ПолучитьНаборЗаписей(Строка.Регистратор, Строка.Врач,РегистрыСведений.КадроваяРасстановка))
		
	КонецЦикла;
	
Возврат МассивУслуг;
    
КонецФункции

Функция ПолучитьМагазины(Полный, Узел, СписокУдаления) Экспорт
    	УстановитьПРивилегированныйрежим(Истина);

	МассивМагазины = Новый Массив;    
	Если Полный Тогда
	ЗапросМагазины = Новый Запрос("ВЫБРАТЬ
		                       |	Склады.Ссылка КАК Магазин
		                       |ИЗ
		                       |	Справочник.Склады КАК Склады
		                       |ГДЕ
		                       |	Склады.ТипСклада = ЗНАЧЕНИЕ(Перечисление.ТипыСкладов.РозничныйМагазин)");
	Иначе
	ЗапросМагазины = Новый Запрос("ВЫБРАТЬ
	                              |	СкладыИзменения.Ссылка КАК Магазин
	                              |ИЗ
	                              |	Справочник.Склады.Изменения КАК СкладыИзменения
	                              |ГДЕ
	                              |	СкладыИзменения.Узел = &Узел");
	ЗапросМагазины.УстановитьПараметр("Узел", Узел);
	КонецЕсли;
	
	Выборка = ЗапросМагазины.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Выборка Цикл 
		
		Структура = Новый Структура;
		
		//УИД = ОпределитьУИД(Строка.Магазин);
		УИД = Строка(Строка.Магазин.Подразделение.УникальныйИдентификатор());
		Структура.Вставить("id"		,УИД);
		Структура.Вставить("name"	,Строка.Магазин.Наименование);
		Структура.Вставить("Del"	,Строка.Магазин.ПометкаУдаления);
		
		МассивМагазины.Добавить(Структура);
		СписокУдаления.Добавить(Строка.Магазин);
	
	КонецЦикла;
	
	Возврат МассивМагазины;
	
