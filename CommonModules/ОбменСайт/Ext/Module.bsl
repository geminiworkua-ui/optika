	//	|						ТоварыДляПередачиНаСайт.Номенклатура
	//	|					ИЗ
	//	|						РегистрСведений.ТоварыДляПередачиНаСайт.Изменения КАК ТоварыДляПередачиНаСайт
	//	|					ГДЕ
	//	|						ТоварыДляПередачиНаСайт.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Цены)
	//	|						И ТоварыДляПередачиНаСайт.УзелРегистрации = &Узел
	//	|						И ТоварыДляПередачиНаСайт.Узел = &Узел)
	//	|				И ВидЦены.ОтправлятьНаСайт = &Узел
	//	|				И Номенклатура.РазрешенОбменСайт) КАК ЦеныНоменклатурыСрезПоследних";
	КонецЕсли;
	ЗапросЦены.УстановитьПараметр("Дата", ТекущаяДата());
	ЗапросЦены.УстановитьПараметр("Узел", Узел);	
	ЗапросЦены.УстановитьПараметр("ВидЦены1", Узел.ЦенаОбычная);
	ЗапросЦены.УстановитьПараметр("ВидЦены2", Узел.ЦенаЗаУпаковку);
    ЗапросЦены.УстановитьПараметр("ВидЦены3", Узел.ЦенаАкционная);
    	
	Выборка = ЗапросЦены.Выполнить().Выгрузить();
	
	РазмерМассива = Выборка.Количество();
	Если Узел.ШагОтправкиЦены = 0 Тогда
		КоличПакетов = 1;
	Иначе
		КоличПакетов = Окр(РазмерМассива / Узел.ШагОтправкиЦены,0, РежимОкругления.Окр15как20);   
	КонецЕсли;
	
	Если КоличПакетов = 0 Тогда
