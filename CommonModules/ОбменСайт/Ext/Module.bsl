Функция ЗаполнитьСтруктуруРазное(ТЗ)
		УстановитьПРивилегированныйрежим(Истина);

	МассивРазное = Новый Массив;
	

	Для Каждого Строка Из  ТЗ Цикл
		
		Структура = Новый Структура;
		УИД = ОпределитьУИД(Строка.Ссылка);
		
		Структура.Вставить("ID",УИД);
		Структура.Вставить("Del",Строка.ПометкаУдаления);
		Структура.Вставить("Name_UA",Строка.Наименование);
		Структура.Вставить("Name_RU",?(Строка.Наименование_ru ="", Строка.Наименование, Строка.Наименование_ru));//В базе нет Name_RU
		
		МассивРазное.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат МассивРазное;
	
КонецФункции

//Property - массив со свойствами
Функция ПолучитьВсеСвойства(Полный, Узел) Экспорт 
	УстановитьПРивилегированныйрежим(Истина);
	
	ЗапросСвойства = Новый Запрос;
	МассивСвойства = Новый Массив; 
	Если Полный Тогда
	
	ЗапросСвойства.Текст = "ВЫБРАТЬ
	                       |	Номенклатура.Ссылка КАК Ссылка
	                       |ИЗ
	                       |	Справочник.Номенклатура КАК Номенклатура
	                       |ГДЕ
	                       |	НЕ Номенклатура.ЭтоГруппа
	                       |	И Номенклатура.Ссылка В
	                       |			(ВЫБРАТЬ
	                       |				ТоварыДляПередачиНаСайт.Номенклатура
	                       |			ИЗ
	                       |				РегистрСведений.ТоварыДляПередачиНаСайт КАК ТоварыДляПередачиНаСайт
	                       |			ГДЕ
	                       |				ТоварыДляПередачиНаСайт.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Описание)
	                       |				И ТоварыДляПередачиНаСайт.УзелРегистрации = &Узел)
	                       |	И Номенклатура.РазрешенОбменСайт";
	Иначе
	ЗапросСвойства.Текст =  "ВЫБРАТЬ
	                        |	Номенклатура.Ссылка КАК Ссылка
	                        |ИЗ
	                        |	Справочник.Номенклатура КАК Номенклатура
	                        |ГДЕ
	                        |	НЕ Номенклатура.ЭтоГруппа
	                        |	И Номенклатура.Ссылка В
	                        |			(ВЫБРАТЬ
	                        |				ТоварыДляПередачиНаСайтИзменения.Номенклатура
	                        |			ИЗ
	                        |				РегистрСведений.ТоварыДляПередачиНаСайт.Изменения КАК ТоварыДляПередачиНаСайтИзменения
	                        |			ГДЕ
	                        |				ТоварыДляПередачиНаСайтИзменения.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Описание)
	                        |				И ТоварыДляПередачиНаСайтИзменения.УзелРегистрации = &Узел
	                        |				И ТоварыДляПередачиНаСайтИзменения.Узел = &Узел)
	                        |	И Номенклатура.РазрешенОбменСайт";
	КонецЕсли;
	
	
    ЗапросСвойства.УстановитьПараметр("Узел", Узел);
	ВыборкаСвойства = ЗапросСвойства.Выполнить().Выгрузить();
	Для Каждого Строка Из  ВыборкаСвойства Цикл
		
		Структура = Новый Структура;
		УИДВладелец = ОпределитьУИД(Строка.Ссылка);
		
		Для каждого Свойство из Строка.Ссылка.ВидНоменклатуры.РеквизитыДляКонтроляНоменклатуры Цикл 
			Если Не Свойство.ТребоватьЗаполнения Тогда
				Продолжить;
			КонецЕсли;	
			
			ТипЗнч = ТипЗнч(Строка.Ссылка[Свойство.ИмяРеквизита]);
						
			Если ТипЗнч = Тип("Булево")
				ИЛИ ТипЗнч = Тип("Число")
				ИЛИ ТипЗнч = Тип("Строка")
				Или ТипЗнч = Тип("СправочникСсылка.ВидыНоменклатуры")
			Тогда
			    Продолжить;
			КонецЕсли;
			
			Если Строка.Ссылка[Свойство.ИмяРеквизита].Пустая() Тогда
				Продолжить;
			КонецЕсли;	
			
			УИДСвойство = ИнфралайнОбмен.ПолучитьУИД_ПоИмениСвойста(Свойство.ИмяРеквизита);
			ТипЗначения = ТипЗнч(Строка.Ссылка[Свойство.ИмяРеквизита]);

			Структура.Вставить("Parent_ID",УИДВладелец);
			Структура.Вставить("ID",УИДСвойство);
			Структура.Вставить("Del",Строка.Ссылка.ПометкаУдаления);
			
			Структура.Вставить("Name_UA",Строка.Ссылка[Свойство.ИмяРеквизита].Наименование);
			Структура.Вставить("Name_RU",Строка.Ссылка[Свойство.ИмяРеквизита].Наименование_ru);	
			
			МассивСвойства.Добавить(Структура);
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивСвойства;
	
КонецФункции

//PropertyNomenclature - Свойства товаров
Процедура ПолучитьСвойстваНоменклатуры(Полный, Узел) Экспорт //Нужно заполнить
		УстановитьПРивилегированныйрежим(Истина);

	СписокУдаления = Новый Массив;
	ЗапросСвойства = Новый Запрос;
	Если Полный Тогда
	
	ЗапросСвойства.Текст = "ВЫБРАТЬ
	                       |	Номенклатура.Ссылка КАК Ссылка,
	                       |	Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
	                       |	Номенклатура.НаименованиеПолное КАК Наименование,
	                       |	Номенклатура.НаименованиеПолное_RU КАК Наименование_ru
	                       |ИЗ
	                       |	Справочник.Номенклатура КАК Номенклатура
	                       |ГДЕ
	                       |	НЕ Номенклатура.ЭтоГруппа
	                       |	И (Номенклатура.СайтLuxor
	                       |				И Номенклатура.СайтLuxor = &СайтLuxor
	                       |			ИЛИ Номенклатура.СайтPolaroid
	                       |				И Номенклатура.СайтPolaroid = &СайтPolaroid)
	                       |
	                       |СГРУППИРОВАТЬ ПО
	                       |	Номенклатура.Ссылка,
	                       |	Номенклатура.ПометкаУдаления,
	                       |	Номенклатура.НаименованиеПолное,
	                       |	Номенклатура.НаименованиеПолное_RU"; 
	
	ЗапросСвойства.УстановитьПараметр("СайтLuxor", Узел.Код = "0002");   
	ЗапросСвойства.УстановитьПараметр("СайтPolaroid", Узел.Код = "0001");    
	
	
	Иначе
	ЗапросСвойства.Текст =  "ВЫБРАТЬ
	                        |	Номенклатура.Ссылка КАК Ссылка,
	                        |	Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
	                        |	Номенклатура.НаименованиеПолное КАК Наименование,
	                        |	Номенклатура.НаименованиеПолное_RU КАК Наименование_ru
	                        |ИЗ
	                        |	Справочник.Номенклатура КАК Номенклатура
	                        |ГДЕ
	                        |	НЕ Номенклатура.ЭтоГруппа
	                        |	И Номенклатура.Ссылка В
	                        |			(ВЫБРАТЬ
	                        |				ТоварыДляПередачиНаСайтИзменения.Номенклатура
	                        |			ИЗ
	                        |				РегистрСведений.ТоварыДляПередачиНаСайт.Изменения КАК ТоварыДляПередачиНаСайтИзменения
	                        |			ГДЕ
	                        |				ТоварыДляПередачиНаСайтИзменения.Номенклатура.РазрешенОбменСайт
	                        |				И ТоварыДляПередачиНаСайтИзменения.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Допреквизиты)
	                        |				И ТоварыДляПередачиНаСайтИзменения.УзелРегистрации = &Узел
	                        |				И ТоварыДляПередачиНаСайтИзменения.Узел = &Узел)";
	КонецЕсли;
	ЗапросСвойства.УстановитьПараметр("Узел", Узел);
	Выборка = ЗапросСвойства.Выполнить().Выгрузить();
	РазмерМассива = Выборка.Количество();
	КоличПакетов = Окр(РазмерМассива / Узел.ШагОтправкиОписание,0, РежимОкругления.Окр15как20);   
	Если КоличПакетов = 0 Тогда
		КоличПакетов =1;
	КонецЕсли;
    Отказ = Ложь;
	ТипДанных = "PropertyNomenclature";
	Для НомерПакета = 0 по КоличПакетов-1 цикл
		ТЗ = СформироватьПакет(НомерПакета, Выборка, РазмерМассива, Узел.ШагОтправкиОписание); 
		Данные = ЗаполнитьСтруктуруСвойствНоменклатуры(ТЗ);
		СтруктураОтправки = Новый Структура();  
		СтруктураОтправки = ОбменСайт.СформироватьДанныеОчки(ТипДанных, Данные, Узел);		
		СписокУдаления = ТЗ.ВыгрузитьКолонку("ССылка");
		ОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Узел, ТипДанных, "", СписокУдаления, Отказ, Перечисления.НаправлениеДляПередачи.Допреквизиты);	
	КонецЦикла;

