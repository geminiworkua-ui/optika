Процедура ПолучитьРубрикатор(Полный, Узел) Экспорт 
		УстановитьПРивилегированныйрежим(Истина);

	СписокУдаления = Новый Массив;

Выборка = ПолучитьСписокРубрик(Полный, Узел);

	РазмерМассива = Выборка.Количество();
	КоличПакетов = Окр(РазмерМассива / Узел.ШагОтправкиОписание,0, РежимОкругления.Окр15как20);   
	Если КоличПакетов = 0 Тогда
		КоличПакетов =1;
	КонецЕсли;
    Отказ = Ложь;
	ТипДанных = "Rubricator";
	Для НомерПакета = 0 по КоличПакетов-1 цикл
		ТЗ = СформироватьПакет(НомерПакета, Выборка, РазмерМассива, Узел.ШагОтправкиОписание); 
		Данные = ЗаполнитьСтруктуруРубрикатор(ТЗ);
		СтруктураОтправки = Новый Структура();  
		СтруктураОтправки = ОбменСайт.СформироватьДанныеОчки(ТипДанных, Данные, Узел);
		ОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Узел, ТипДанных, "", СписокУдаления, Отказ);	
	КонецЦикла;

КонецПроцедуры

Функция ЗаполнитьСтруктуруРубрикатор(СписокРубрик)
 	УстановитьПРивилегированныйрежим(Истина);

Рубрики = Новый Массив;		

Для Каждого Строка Из СписокРубрик Цикл
		
		Структура = Новый Структура;      
				
		УИД = ОпределитьУИД(Строка.Ссылка);
		Структура.Вставить("ID",УИД);
		Структура.Вставить("Del",Строка.Ссылка.ПометкаУдаления);
		Структура.Вставить("Name_UA",Строка.Ссылка.Наименование);
