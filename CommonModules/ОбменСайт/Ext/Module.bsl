#Область ПолучениеДанных      
Функция ПолучитьСписокКатегорий(Полный, Узел)
	УстановитьПРивилегированныйрежим(Истина);

ЗапросКатегории = Новый Запрос;
Если Полный Тогда	
ЗапросКатегории.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
                        |	ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора КАК Ссылка,
                        |	ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора.ПометкаУдаления КАК ПометкаУдаления,
                        |	ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора.Наименование КАК Наименование,
                        |	ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора.Наименование_ru КАК Наименование_ru
                        |ИЗ
                        |	РегистрСведений.ТоварыДляПередачиНаСайт КАК ТоварыДляПередачиНаСайт
                        |ГДЕ
                        |	ТоварыДляПередачиНаСайт.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Описание)
                        |	И ТоварыДляПередачиНаСайт.УзелРегистрации = &Узел
                        |	И НЕ ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора = ЗНАЧЕНИЕ(Справочник.Категорияраствора.ПустаяСсылка)";
Иначе
ЗапросКатегории.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
                        |	ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора КАК Ссылка,
                        |	ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора.ПометкаУдаления КАК ПометкаУдаления,
                        |	ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора.Наименование КАК Наименование,
                        |	ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора.Наименование_ru КАК Наименование_ru
                        |ИЗ
                        |	РегистрСведений.ТоварыДляПередачиНаСайт.Изменения КАК ТоварыДляПередачиНаСайт
                        |ГДЕ
                        |	ТоварыДляПередачиНаСайт.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Описание)
                        |	И ТоварыДляПередачиНаСайт.УзелРегистрации = &Узел
                        |	И ТоварыДляПередачиНаСайт.Узел = &Узел
                        |	И НЕ ТоварыДляПередачиНаСайт.Номенклатура.КатегорияРаствора = ЗНАЧЕНИЕ(Справочник.Категорияраствора.ПустаяСсылка)";
КонецЕсли;
ЗапросКатегории.УстановитьПараметр("Узел", Узел);
ВыборкаКатегорий = ЗапросКатегории.Выполнить().Выгрузить();		

Возврат ВыборкаКатегорий;
КонецФункции

//Category - массив с категориями
Процедура ПолучитьВсеКатегории(Полный, Узел) Экспорт
    	УстановитьПРивилегированныйрежим(Истина);

	СписокУдаления  =Новый Массив;
	
	
	Выборка = ПолучитьСписокКатегорий(Полный, Узел);
	
	РазмерМассива = Выборка.Количество();
	КоличПакетов = Окр(РазмерМассива / Узел.ШагОтправкиОписание,0, РежимОкругления.Окр15как20);   
	Если КоличПакетов = 0 Тогда
		КоличПакетов =1;
	КонецЕсли;
    Отказ = Ложь;
	ТипДанных = "Category";
	Для НомерПакета = 0 по КоличПакетов-1 цикл
		ТЗ = СформироватьПакет(НомерПакета, Выборка, РазмерМассива, Узел.ШагОтправкиОписание); 
		Данные = ЗаполнитьСтруктуруКатегорий(ТЗ);
		СтруктураОтправки = Новый Структура();  
		СтруктураОтправки = ОбменСайт.СформироватьДанныеОчки(ТипДанных, Данные, Узел);
		ОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Узел, ТипДанных, "", СписокУдаления, Отказ);	
	КонецЦикла;
КонецПроцедуры

Функция ЗаполнитьСтруктуруКатегорий(СписокКатегорий)
		УстановитьПРивилегированныйрежим(Истина);

	Категории = Новый Массив;	
	
	Для Каждого Строка Из СписокКатегорий Цикл
		
		Структура = Новый Структура;      
		Если Строка.ссылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		
		УИД = ОпределитьУИД(Строка.Ссылка);
		УИДРодителя = ОпределитьУИД(Строка.Ссылка.Родитель);
		
		Структура.Вставить("Parent_ID",УИДРодителя);
		Структура.Вставить("ID",УИД);
		Структура.Вставить("Del",Строка.Ссылка.ПометкаУдаления);
		Структура.Вставить("Name_UA",Строка.Наименование);
		Структура.Вставить("Name_RU",Строка.Наименование_ru);//В базе нет Name_RU
		
		Категории.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат Категории;
	
КонецФункции

//Brand - массив с брендами
//Country - массив со странами
//Manufacturer - массив с производителями
Процедура ПолучитьРазное (Полный, ТипДанных,Узел) Экспорт
    	УстановитьПРивилегированныйрежим(Истина);

	СписокУдаления = Новый Массив;
	Запрос = Новый Запрос;
	
	Если ТипДанных = "Brand" Тогда     	
		
		Справочник = "Справочник.Марки"; 
		Если Полный Тогда	
			Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			               |	ТоварыДляПередачиНаСайт.Номенклатура.Марка КАК Ссылка,
			               |	ТоварыДляПередачиНаСайт.Номенклатура.Марка.ПометкаУдаления КАК ПометкаУдаления,
			               |	ТоварыДляПередачиНаСайт.Номенклатура.Марка.Наименование КАК Наименование,
			               |	ТоварыДляПередачиНаСайт.Номенклатура.Марка.Наименование_ru КАК Наименование_ru
			               |ИЗ
			               |	РегистрСведений.ТоварыДляПередачиНаСайт КАК ТоварыДляПередачиНаСайт
			               |ГДЕ
			               |	ТоварыДляПередачиНаСайт.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Описание)
			               |	И ТоварыДляПередачиНаСайт.УзелРегистрации = &Узел
			               |	И НЕ ТоварыДляПередачиНаСайт.Номенклатура.Марка = ЗНАЧЕНИЕ(Справочник.Марки.ПустаяССылка)";
		Иначе
			Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			               |	ТоварыДляПередачиНаСайт.Номенклатура.Марка как Ссылка,
			               |	ТоварыДляПередачиНаСайт.Номенклатура.Марка.ПометкаУдаления как ПометкаУдаления,
			               |	ТоварыДляПередачиНаСайт.Номенклатура.Марка.Наименование как Наименование,
