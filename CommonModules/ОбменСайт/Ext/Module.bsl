//NomenclaturePicture - картинки к товарам
Процедура ПолучитьКартинки (Полный, Узел,СписокУдаления) Экспорт
    	УстановитьПРивилегированныйрежим(Истина);

	Запрос = Новый Запрос;
	
	
	Структура = ПолучитьТекстЗапроса("НоменклатураПрисоединенныеФайлы",Узел);
	
	Если Не Узел = Неопределено Тогда
		Запрос.УстановитьПараметр("Узел",Узел);
	КонецЕсли;  
	Если Полный Тогда
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураПрисоединенныеФайлы.Ссылка КАК Ссылка,
	               |	НоменклатураПрисоединенныеФайлы.ВладелецФайла КАК Владелец,
	               |	НоменклатураПрисоединенныеФайлы.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
	               |	НоменклатураПрисоединенныеФайлы.Наименование КАК Наименование,
	               |	НоменклатураПрисоединенныеФайлы.Размер КАК Размер
	               |ИЗ
	               |	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	               |ГДЕ
	               |	НоменклатураПрисоединенныеФайлы.ВладелецФайла.РазрешенОбменСайт
	               |	И ((НоменклатураПрисоединенныеФайлы.ВладелецФайла.СайтLuxor
	               |				И НоменклатураПрисоединенныеФайлы.ВладелецФайла.СайтLuxor = &СайтLuxor)
	               |			ИЛИ (НоменклатураПрисоединенныеФайлы.ВладелецФайла.СайтPolaroid
	               |				И НоменклатураПрисоединенныеФайлы.ВладелецФайла.СайтPolaroid = &СайтPolaroid))";
    Запрос.УстановитьПараметр("СайтLuxor", Узел.Код = "0002");   
	Запрос.УстановитьПараметр("СайтPolaroid", Узел.Код = "0001");   
		
		
	Иначе
	Запрос.Текст ="ВЫБРАТЬ
	              |	НоменклатураПрисоединенныеФайлы.Ссылка КАК Ссылка,
	              |	НоменклатураПрисоединенныеФайлы.ВладелецФайла КАК Владелец,
	              |	НоменклатураПрисоединенныеФайлы.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
	              |	НоменклатураПрисоединенныеФайлы.Наименование КАК Наименование,
	              |	НоменклатураПрисоединенныеФайлы.Размер КАК Размер
	              |ИЗ
	              |	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	              |ГДЕ
	              |	НоменклатураПрисоединенныеФайлы.ВладелецФайла В
	              |			(ВЫБРАТЬ
	              |				ТоварыДляПередачиНаСайт.Номенклатура
	              |			ИЗ
	              |				РегистрСведений.ТоварыДляПередачиНаСайт.Изменения КАК ТоварыДляПередачиНаСайт
	              |			ГДЕ
	              |				ТоварыДляПередачиНаСайт.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.картинки)
	              |				И ТоварыДляПередачиНаСайт.УзелРегистрации = &Узел
	              |				И ТоварыДляПередачиНаСайт.Узел = &Узел)
	              |	И НоменклатураПрисоединенныеФайлы.ВладелецФайла.РазрешенОбменСайт";   
КонецЕсли;	
	Выборка = Запрос.Выполнить().Выгрузить();
    РазмерМассива = Выборка.Количество();
	КоличПакетов = Окр(РазмерМассива / Узел.ШагОтправкиОписание,0, РежимОкругления.Окр15как20);   
	Если КоличПакетов = 0 Тогда
		КоличПакетов =1;
	КонецЕсли;
    Отказ = Ложь;
	ТипДанных = "NomenclaturePicture";
	Для НомерПакета = 0 по КоличПакетов-1 цикл
		ТЗ = СформироватьПакет(НомерПакета, Выборка, РазмерМассива, Узел.ШагОтправкиОписание); 
		Данные = ЗаполнитьСтруктуруКартинок(ТЗ, СписокУдаления, Узел);
		СтруктураОтправки = Новый Структура();  
		СтруктураОтправки = ОбменСайт.СформироватьДанныеОчки(ТипДанных, Данные, Узел);
		СписокУдаления = ТЗ.ВыгрузитьКолонку("Владелец");
		ОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Узел, ТипДанных, "", СписокУдаления, Отказ, Перечисления.НаправлениеДляПередачи.картинки);	
	КонецЦикла;
КонецПроцедуры

Функция ЗаполнитьСтруктуруКартинок(ТЗ,СписокУдаления, Узел)
		УстановитьПРивилегированныйрежим(Истина);

	Массив = Новый Массив;	
	Для Каждого Строка Из тз Цикл
		
		УИДНом = ОпределитьУИД(Строка.Владелец);
		
		Структура = Новый Структура;
		Структура.Вставить("ID_Nom"			, УИДНом );
		Структура.Вставить("Del"			, Строка.ПометкаУдаления );
		Структура.Вставить("PictureName"	, Строка.Наименование + "." + Строка.Ссылка.Расширение);
		Структура.Вставить("PictureSize"	, Строка.Размер );
		Структура.Вставить("Picture"		, Base64Строка(ПрисоединенныеФайлы.ПолучитьДвоичныеДанныеФайла( Строка.Ссылка )));
		
