Функция СформироватьСтруктуруОстатки(Выборка,Узел, СписокУдаления, ИсхДанные)
		УстановитьПРивилегированныйрежим(Истина);
   	Массив = Новый Массив;
	//СтруктураПоиска = Новый Структура("Номенклатура");
	Выборка.Свернуть("Номенклатура, ИспользованиеХарактеристик", "Остаток");
	
	Для Каждого Строка Из Выборка Цикл
		
		УИДНом = ОпределитьУИД(Строка.Номенклатура);
		Остаток = Строка.Остаток;
		Структура = Новый Структура;
		Структура.Вставить("ID_Nom",УИДНом);
		Структура.Вставить("Rest", Остаток); 
		//Структура.Вставить("ID_Ser", NULL); // Нет ничего по этому полю
				
		Если НЕ Строка.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать
			//И значениеЗаполнено(Строка.НОменклатура.СвойстваОбъектовНабор)
			ТОгда
			ПараметрыОтбора = Новый СТруктура("Номенклатура", Строка.Номенклатура);
			пТЗ =  ИсхДанные.НайтиСтроки(ПараметрыОтбора);
			мОстатковХарактеристики = новый Массив;
			Для каждого пСтрока из пТЗ цикл
				П = Новый Структура();	
				п.Вставить("ID_Ser",  Строка(пСтрока.Характеристика.Ссылка.УникальныйИдентификатор()));
				п.Вставить("Rest", пСтрока.Остаток);
				//мСвойств = новый Массив;
				//Для каждого типХаракт из  Строка.Номенклатура.СвойстваОбъектовНабор.Состав цикл
				//	ПП = Новый Структура("ID_Pro, Name_UA", 
				//									Строка(ИнфралайнОбмен.ПолучитьУИД_ПоИмениСвойста(Строка(типХаракт.Свойство))),
				//									Строка(пСтрока.Характеристика[Строка(типХаракт.Свойство)]));
				//	мСвойств.Добавить(ПП);							
				//КонецЦикла; 
				//п.Вставить("Attributes", мСвойств);
				мОстатковХарактеристики.Добавить(П);
			КонецЦикла;
			Структура.Вставить("Series", мОстатковХарактеристики);	
		КонецЕсли;
		
		Массив.Добавить(Структура);
		НаборДанных = РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
		НаборДанных.Отбор.Номенклатура.Установить(Строка.Номенклатура);
		НаборДанных.Отбор.Направление.Установить(Перечисления.НаправлениеДляПередачи.Остатки);
		НаборДанных.Отбор.УзелРегистрации.Установить(Узел);
		НаборДанных.Прочитать();
		Если Не НаборДанных.Количество() = 0 Тогда
			СписокУдаления.Добавить(НаборДанных);
		Иначе
			Запись = НаборДанных.Добавить();
			Запись.Направление = Перечисления.НаправлениеДляПередачи.Остатки;
			Запись.Номенклатура = Строка.Номенклатура;
			Запись.УзелРегистрации = Узел;
			НаборДанных.Записать();
			СписокУдаления.Добавить(НаборДанных);
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Массив
	
КонецФункции
