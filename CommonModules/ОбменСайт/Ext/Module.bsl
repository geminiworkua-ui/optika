	СтруктураОтправки.Вставить("Категории", "Category");
	СтруктураОтправки.Вставить("Рубрикатор", "Rubricator");
	СтруктураОтправки.Вставить("Бренды","Brand");
	СтруктураОтправки.Вставить("Страны","Country");
