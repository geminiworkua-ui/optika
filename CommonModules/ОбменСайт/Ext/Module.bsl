Функция ПолучитьСтруктуруЗаписиКВрачу(Источник)
		УстановитьПРивилегированныйрежим(Истина);

	Структура = Новый Структура;
	
	Структура.Вставить("TimeStart"	,Источник.ВремяНачала);
	//Структура.Вставить("TimeEnd"	,Источник.ВремяОкончания);
	Структура.Вставить("Doctor"		,Строка(Источник.Сотрудник.УникальныйИдентификатор()));
	Структура.Вставить("Shop"		,Строка(Источник.Подразделение.УникальныйИдентификатор()));
	Структура.Вставить("Position"	,Строка(Источник.Должность.УникальныйИдентификатор()));
	Структура.Вставить("Status"		,?(Источник.Проведен,"Время занято","Свободно"));
	Структура.Вставить("DocID"		,Строка(Источник.Ссылка.УникальныйИдентификатор()));
	Структура.Вставить("ClientID"	,Строка(Источник.Клиент.УникальныйИдентификатор()));

	Возврат  Структура;
