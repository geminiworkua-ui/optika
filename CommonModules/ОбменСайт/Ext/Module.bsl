		П.Вставить("Price", Строка.Цена3);
		МЦен.Добавить(П);

		//Структура.Вставить("Quantity",	ОстатокТовара(Строка.Номенклатура));
        Структура.Вставить("Prices", МЦен);		
		Массив.Добавить(Структура); 
		НаборДанных = РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
		НаборДанных.Отбор.Номенклатура.Установить(Строка.Номенклатура);
		НаборДанных.Отбор.Направление.Установить(Перечисления.НаправлениеДляПередачи.Цены);
		НаборДанных.Отбор.УзелРегистрации.Установить(Узел);
		НаборДанных.Прочитать();
		Если Не НаборДанных.Количество() = 0 Тогда
			СписокУдаления.Добавить(НаборДанных);
		Иначе
			Запись = НаборДанных.Добавить();
			Запись.Направление = Перечисления.НаправлениеДляПередачи.Цены;
			Запись.Номенклатура = Строка.Номенклатура;
			Запись.УзелРегистрации = Узел;
			НаборДанных.Записать();
			СписокУдаления.Добавить(НаборДанных);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Массив;
		
КонецФункции
#КонецОбласти

#Область Остатки 

Функция ОстатокТовара(Номенклатура) 
		УстановитьПРивилегированныйрежим(Истина);
	
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.Текст = "ВЫБРАТЬ
	                      |	СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
	                      |	СвободныеОстаткиОстатки.ВНаличииОстаток - СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток КАК Остаток
	                      |ИЗ
	                      |	РегистрНакопления.СвободныеОстатки.Остатки(
	                      |			&Дата,
	                      |			Номенклатура  = &Номенклатура) КАК СвободныеОстаткиОстатки";
	ЗапросОстатки.УстановитьПараметр("Дата",ТекущаяДата());
	ЗапросОстатки.УстановитьПараметр("Номенклатура",Номенклатура);
	Выборка = ЗапросОстатки.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Остаток;
	Иначе
		Возврат 0;
	КонецЕсли;	
	

КонецФункции


//RestNomenclature - остатки
Процедура ПолучитьОстатки(Полный, Узел, СписокУдаления) Экспорт
		УстановитьПРивилегированныйрежим(Истина);

		Если Полный Тогда
			ЗапросОстатки = Новый Запрос;
			
			ЗапросОстатки.Текст = "ВЫБРАТЬ
			                      |	СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
			                      |	СвободныеОстаткиОстатки.ВНаличииОстаток - СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток КАК Остаток,
			                      |	СвободныеОстаткиОстатки.Характеристика,
			                      |	СвободныеОстаткиОстатки.Номенклатура.ИспользованиеХарактеристик КАК ИспользованиеХарактеристик
			                      |ПОМЕСТИТЬ вт_сбор
			                      |ИЗ
			                      |	РегистрНакопления.СвободныеОстатки.Остатки(
			                      |			&Дата,
			                      |			Номенклатура В
			                      |				(ВЫБРАТЬ
			                      |					ТоварыДляПередачиНаСайт.Номенклатура
			                      |				ИЗ
			                      |					РегистрСведений.ТоварыДляПередачиНаСайт КАК ТоварыДляПередачиНаСайт
			                      |				ГДЕ
			                      |					ТоварыДляПередачиНаСайт.Номенклатура.РазрешенОбменСайт
			                      |					И ТоварыДляПередачиНаСайт.УзелРегистрации = &Узел
			                      |					И ТоварыДляПередачиНаСайт.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Описание))) КАК СвободныеОстаткиОстатки
			                      |;
			                      |
			                      |////////////////////////////////////////////////////////////////////////////////
			                      |ВЫБРАТЬ
			                      |	вт_сбор.Номенклатура,
			                      |	ВЫБОР
			                      |		КОГДА ЕСТЬNULL(вт_сбор.Остаток, 0) < 0
			                      |			ТОГДА 0
			                      |		ИНАЧЕ ЕСТЬNULL(вт_сбор.Остаток, 0)
			                      |	КОНЕЦ КАК Остаток,
			                      |	вт_сбор.Характеристика,
			                      |	вт_сбор.ИспользованиеХарактеристик
			                      |ИЗ
			                      |	вт_сбор КАК вт_сбор";
			
			
			ЗапросОстатки.УстановитьПараметр("Дата",ТекущаяДата());
			ЗапросОстатки.УстановитьПараметр("Узел",Узел);   
		Иначе
			ЗапросОстатки = Новый Запрос;
			ЗапросОстатки.Текст = "ВЫБРАТЬ
			                      |	СвободныеОстаткиОстатки.Номенклатура,
			                      |	СвободныеОстаткиОстатки.ВНаличииОстаток - СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток КАК Остаток,
			                      |	СвободныеОстаткиОстатки.Характеристика,
			                      |	СвободныеОстаткиОстатки.Номенклатура.ИспользованиеХарактеристик КАК ИспользованиеХарактеристик
			                      |ПОМЕСТИТЬ вт
			                      |ИЗ
			                      |	РегистрНакопления.СвободныеОстатки.Остатки(
			                      |			&Дата,
			                      |			Номенклатура В
			                      |				(ВЫБРАТЬ
			                      |					ТоварыДляПередачиНаСайтИзменения.Номенклатура
			                      |				ИЗ
			                      |					РегистрСведений.ТоварыДляПередачиНаСайт.Изменения КАК ТоварыДляПередачиНаСайтИзменения
			                      |				ГДЕ
			                      |					ТоварыДляПередачиНаСайтИзменения.Номенклатура.РазрешенОбменСайт
			                      |					И ТоварыДляПередачиНаСайтИзменения.УзелРегистрации = &Узел
			                      |					И ТоварыДляПередачиНаСайтИзменения.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Остатки)
			                      |					И ТоварыДляПередачиНаСайтИзменения.Узел = &Узел)) КАК СвободныеОстаткиОстатки
			                      |;
			                      |
			                      |////////////////////////////////////////////////////////////////////////////////
			                      |ВЫБРАТЬ
			                      |	вт.Номенклатура,
			                      |	ВЫБОР
			                      |		КОГДА ЕСТЬNULL(вт.Остаток, 0) < 0
			                      |			ТОГДА 0
			                      |		ИНАЧЕ ЕСТЬNULL(вт.Остаток, 0)
			                      |	КОНЕЦ КАК Остаток,
			                      |	вт.Характеристика,
			                      |	вт.ИспользованиеХарактеристик
			                      |ИЗ
			                      |	вт КАК вт";
			ЗапросОстатки.УстановитьПараметр("Узел",Узел);
			ЗапросОстатки.УстановитьПараметр("Дата",ТекущаяДата());
		КонецЕсли;
		
		Выборка = ЗапросОстатки.Выполнить().Выгрузить();
		РазмерМассива = Выборка.Количество();
		КоличПакетов = Окр(РазмерМассива / Узел.ШагОтправкиОстатки,0, РежимОкругления.Окр15как20);   
		Если КоличПакетов = 0 Тогда
			КоличПакетов =1;
		КонецЕсли;
		Отказ = Ложь;
		ТипДанных = "RestNomenclature";
		Для НомерПакета = 0 по КоличПакетов-1 цикл
			ТЗ = СформироватьПакет(НомерПакета, Выборка, РазмерМассива, Узел.ШагОтправкиОстатки); 
			Данные = СформироватьСтруктуруОстатки(ТЗ, Узел, СписокУдаления, Выборка);
			СтруктураОтправки = Новый Структура();  
			СтруктураОтправки = ОбменСайт.СформироватьДанныеОчки(ТипДанных, Данные, Узел);
			СписокУдаления = ТЗ.ВыгрузитьКолонку("Номенклатура");
			ОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Узел, ТипДанных, "", СписокУдаления, Отказ, Перечисления.НаправлениеДляПередачи.Остатки);	
		КонецЦикла;

КонецПроцедуры

