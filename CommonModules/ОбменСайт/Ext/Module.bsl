Функция ПолучитьНаборСвойств(Узел, СписокУдаления) Экспорт 
	УстановитьПРивилегированныйрежим(Истина);

	ЗапросСвойства = Новый Запрос;
	МассивСвойства = Новый Массив;
	
	Если Не Узел = Неопределено Тогда
		ЗапросСвойства.Текст = "ВЫБРАТЬ
		|	СвойстваОбъектовНаборыИзменения.Ссылка КАК Владелец,
		|	СвойстваОбъектовНаборыСостав.Свойство,
		|	СвойстваОбъектовНаборыИзменения.Ссылка.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.СвойстваОбъектовНаборы.Изменения КАК СвойстваОбъектовНаборыИзменения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СвойстваОбъектовНаборы.Состав КАК СвойстваОбъектовНаборыСостав
		|		ПО СвойстваОбъектовНаборыИзменения.Ссылка = СвойстваОбъектовНаборыСостав.Ссылка
		|ГДЕ
		|	СвойстваОбъектовНаборыИзменения.Узел = &Узел";
		ЗапросСвойства.УстановитьПараметр("Узел",Узел);
	Иначе
		ЗапросСвойства.Текст = "ВЫБРАТЬ
		|	СвойстваОбъектовНаборыСостав.Ссылка КАК Владелец,
		|	СвойстваОбъектовНаборыСостав.Свойство,
		|	СвойстваОбъектовНаборыСостав.Ссылка.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.СвойстваОбъектовНаборы.Состав КАК СвойстваОбъектовНаборыСостав";
	КонецЕсли;
	
	ВыборкаСвойства = ЗапросСвойства.Выполнить().Выгрузить();
	
	Для Каждого Строка Из  ВыборкаСвойства Цикл
		
		Структура = Новый Структура;
		УИДВладелец = ОпределитьУИД(Строка.Владелец);
		УИДСвойство = ОпределитьУИД(Строка.Свойство);
		
		Структура.Вставить("Parent_ID",УИДВладелец);
		Структура.Вставить("ID",УИДСвойство);
		Структура.Вставить("Del",Строка.ПометкаУдаления);
		Структура.Вставить("Name_UA",Строка.Свойство.Наименование);
		Структура.Вставить("Name_RU",Строка.Свойство.Наименование);//В базе нет Name_RU
		
		МассивСвойства.Добавить(Структура);
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(Строка.Владелец,Строка.Владелец.Наименование,Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	
	Возврат МассивСвойства;
	
КонецФункции	


//Возвращает Истина если запись разрешена и Ложь если запрещена
//На вход принимает Струтуру с полями Регистра БроньЗаписиКВрачу
Функция ПоискБрони (СтруктураПоиска) Экспорт
    	УстановитьПРивилегированныйрежим(Истина);

	СтрокиБрони = РегистрыСведений.БроньЗаписиКВрачу.СрезПоследних(ТекущаяДата(), СтруктураПоиска);
	Если СтрокиБрони = Неопределено Тогда
		Возврат Истина;
	ИначеЕсли СтрокиБрони[0].ВремяБронирования + 60*15 > ТекущаяДата() Тогда
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;
КонецФункции
 
