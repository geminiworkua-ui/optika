Функция ПолучитьСотрудниковПолное(Узел = Неопределено,СписокУдаления) Экспорт   
		УстановитьПРивилегированныйрежим(Истина);

	ЗапросСотрудники = Новый Запрос;
	МассивСотрудники = Новый Массив;
		
	ЗапросСотрудники.Текст = "ВЫБРАТЬ
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.Подразделение,
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник,
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.Должность,
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.Регистратор
	                         |ИЗ
	                         |	РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(&Дата, ) КАК РасписаниеРаботыСотрудниковСрезПоследних
	                         |ГДЕ
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.СтатусЗанятости = &СтатусЗанятости
	                         |	И РасписаниеРаботыСотрудниковСрезПоследних.Должность.ЭтоВрач
	                         |	И РасписаниеРаботыСотрудниковСрезПоследних.Подразделение.Родитель.Код = ""00-000043""";
	ЗапросСотрудники.УстановитьПараметр("Дата"				,ТекущаяДата());
	ЗапросСотрудники.УстановитьПараметр("СтатусЗанятости"	,Перечисления.СтатусыЗанятости.Работа);
	Результат = ЗапросСотрудники.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Результат Цикл
		
		ЗапросГрафикРаботы = Новый Запрос;
		ЗапросГрафикРаботы.Текст = "ВЫБРАТЬ
		                           |	РасписаниеРаботыСотрудниковСрезПоследних.ВремяНачалаРаботы,
		                           |	РасписаниеРаботыСотрудниковСрезПоследних.ВремяОкончанияРаботы,
		                           |	РасписаниеРаботыСотрудниковСрезПоследних.Период
		                           |ИЗ
		                           |	РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(&Дата, ) КАК РасписаниеРаботыСотрудниковСрезПоследних
		                           |ГДЕ
		                           |	РасписаниеРаботыСотрудниковСрезПоследних.СтатусЗанятости = &СтатусЗанятости
		                           |	И РасписаниеРаботыСотрудниковСрезПоследних.Подразделение = &Подразделение
		                           |	И РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник = &Сотрудник
		                           |	И РасписаниеРаботыСотрудниковСрезПоследних.Должность = &Должность";
		ЗапросГрафикРаботы.УстановитьПараметр("Дата"			,ТекущаяДата());
		ЗапросГрафикРаботы.УстановитьПараметр("СтатусЗанятости"	,Перечисления.СтатусыЗанятости.Работа);
		ЗапросГрафикРаботы.УстановитьПараметр("Подразделение"	,Строка.Подразделение);
		ЗапросГрафикРаботы.УстановитьПараметр("Сотрудник"		,Строка.Сотрудник);
		ЗапросГрафикРаботы.УстановитьПараметр("Должность"		,Строка.Должность);
		
		МассивГрафикРаботы = Новый Массив;
		
		Для Каждого Стр Из Результат Цикл
			Структура 		= Новый Структура;
			СтруктураОтбор 	= Новый Структура;
			
			Структура.Вставить("TimeStart"	,Стр.ВремяНачалаРаботы);
			Структура.Вставить("NimeEnd"	,Стр.ВремяОкончанияРаботы);
			МассивГрафикРаботы.Добавить(Структура);
			
			СтруктураОтбор.Вставить("Регистратор"			,Строка.Регистратор);
			СтруктураОтбор.Вставить("Подразделение"			,Строка.Подразделение);
			СтруктураОтбор.Вставить("Сотрудник"				,Строка.Сотрудник);
			СтруктураОтбор.Вставить("Должность"				,Строка.Сотрудник);
			СтруктураОтбор.Вставить("ВремяНачалаРаботы"		,Стр.ВремяНачалаРаботы);
			СтруктураОтбор.Вставить("ВремяОкончанияРаботы"	,Стр.ВремяОкончанияРаботы);
			СтруктураОтбор.Вставить("СтатусЗанятости"		,Перечисления.СтатусыЗанятости.Работа);
			
			
			Если Не Узел = Неопределено Тогда
				СписокУдаления.Добавить(ПолучитьНаборЗаписей(Строка.Регистратор, СтруктураОтбор, РегистрыСведений.РасписаниеРаботыСотрудников),Строка.Номенклатура.Наименование,Истина);
			КонецЕсли;
		КонецЦикла;
		
		Структура = Новый Структура;
		
		Структура.Вставить("uuid"		,Строка(Строка.Сотрудник.УникальныйИдентификатор()));
		Структура.Вставить("Name"		,Строка.Сотрудник.Наименовани);
		Структура.Вставить("Shop"		,Строка(Строка.Подразделение.УникальныйИдентификатор()));  
		Структура.Вставить("Job"		,Строка(Строка.Должность.УникальныйИдентификатор()));      
		Структура.Вставить("WorkTime"	,МассивГрафикРаботы);
		
		МассивСотрудники.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат МассивСотрудники;
	
КонецФункции

Функция ПолучитьСотрудниковПИзменения(Узел = Неопределено,СписокУдаления) Экспорт   
		УстановитьПРивилегированныйрежим(Истина);

	ЗапросСотрудники = Новый Запрос;
	МассивСотрудники = Новый Массив;
		
	ЗапросСотрудники.Текст = "ВЫБРАТЬ
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.Подразделение,
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник,
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.Должность,
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.Регистратор
	                         |ИЗ
	                         |	РегистрСведений.РасписаниеРаботыСотрудников.Изменения КАК РасписаниеРаботыСотрудниковИзменения
	                         |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(&Дата, ) КАК РасписаниеРаботыСотрудниковСрезПоследних
	                         |		ПО РасписаниеРаботыСотрудниковИзменения.Регистратор = РасписаниеРаботыСотрудниковСрезПоследних.Регистратор
	                         |ГДЕ
	                         |	РасписаниеРаботыСотрудниковСрезПоследних.СтатусЗанятости = &СтатусЗанятости
	                         |	И РасписаниеРаботыСотрудниковСрезПоследних.Должность.ЭтоВрач
	                         |	И РасписаниеРаботыСотрудниковСрезПоследних.Подразделение.Родитель.Код = ""00-000043""
	                         |	И РасписаниеРаботыСотрудниковИзменения.Узел = &Узел";
	ЗапросСотрудники.УстановитьПараметр("Дата"				,ТекущаяДата());
	ЗапросСотрудники.УстановитьПараметр("СтатусЗанятости"	,Перечисления.СтатусыЗанятости.Работа);
	ЗапросСотрудники.УстановитьПараметр("Узел"				,Узел);
	Результат = ЗапросСотрудники.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Результат Цикл
		
		ЗапросГрафикРаботы = Новый Запрос;
		ЗапросГрафикРаботы.Текст = "ВЫБРАТЬ
		                           |	РасписаниеРаботыСотрудниковСрезПоследних.ВремяНачалаРаботы,
		                           |	РасписаниеРаботыСотрудниковСрезПоследних.ВремяОкончанияРаботы,
		                           |	РасписаниеРаботыСотрудниковСрезПоследних.Период
		                           |ИЗ
		                           |	РегистрСведений.РасписаниеРаботыСотрудников.Изменения КАК РасписаниеРаботыСотрудниковИзменения
		                           |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасписаниеРаботыСотрудников.СрезПоследних(&Дата, ) КАК РасписаниеРаботыСотрудниковСрезПоследних
		                           |		ПО РасписаниеРаботыСотрудниковИзменения.Регистратор = РасписаниеРаботыСотрудниковСрезПоследних.Регистратор
		                           |ГДЕ
		                           |	РасписаниеРаботыСотрудниковСрезПоследних.СтатусЗанятости = &СтатусЗанятости
		                           |	И РасписаниеРаботыСотрудниковСрезПоследних.Подразделение = &Подразделение
		                           |	И РасписаниеРаботыСотрудниковСрезПоследних.Сотрудник = &Сотрудник
		                           |	И РасписаниеРаботыСотрудниковСрезПоследних.Должность = &Должность
		                           |	И РасписаниеРаботыСотрудниковИзменения.Узел = &Узел";
		ЗапросГрафикРаботы.УстановитьПараметр("Дата"			,ТекущаяДата());
		ЗапросГрафикРаботы.УстановитьПараметр("СтатусЗанятости"	,Перечисления.СтатусыЗанятости.Работа);
		ЗапросГрафикРаботы.УстановитьПараметр("Подразделение"	,Строка.Подразделение);
		ЗапросГрафикРаботы.УстановитьПараметр("Сотрудник"		,Строка.Сотрудник);
		ЗапросГрафикРаботы.УстановитьПараметр("Должность"		,Строка.Должность);
		ЗапросГрафикРаботы.УстановитьПараметр("Узел"			,Узел);
		
		МассивГрафикРаботы = Новый Массив;
		
		Для Каждого Стр Из Результат Цикл
			Структура 		= Новый Структура;
			СтруктураОтбор 	= Новый Структура;
			
			Структура.Вставить("TimeStart"	,Стр.ВремяНачалаРаботы);
			Структура.Вставить("NimeEnd"	,Стр.ВремяОкончанияРаботы);
			МассивГрафикРаботы.Добавить(Структура);
			
			СтруктураОтбор.Вставить("Регистратор"			,Строка.Регистратор);
			СтруктураОтбор.Вставить("Подразделение"			,Строка.Подразделение);
			СтруктураОтбор.Вставить("Сотрудник"				,Строка.Сотрудник);
			СтруктураОтбор.Вставить("Должность"				,Строка.Сотрудник);
			СтруктураОтбор.Вставить("ВремяНачалаРаботы"		,Стр.ВремяНачалаРаботы);
			СтруктураОтбор.Вставить("ВремяОкончанияРаботы"	,Стр.ВремяОкончанияРаботы);
			СтруктураОтбор.Вставить("СтатусЗанятости"		,Перечисления.СтатусыЗанятости.Работа);
			
			
			Если Не Узел = Неопределено Тогда
				СписокУдаления.Добавить(ПолучитьНаборЗаписей(Строка.Регистратор, СтруктураОтбор, РегистрыСведений.РасписаниеРаботыСотрудников),Строка.Номенклатура.Наименование,Истина);
			КонецЕсли;
		КонецЦикла;
		
		Структура = Новый Структура;
		
		Структура.Вставить("uuid"		,Строка(Строка.Сотрудник.УникальныйИдентификатор()));
		Структура.Вставить("Name"		,Строка.Сотрудник.Наименовани);
		Структура.Вставить("Shop"		,Строка(Строка.Подразделение.УникальныйИдентификатор()));  
		Структура.Вставить("Job"		,Строка(Строка.Должность.УникальныйИдентификатор()));      
		Структура.Вставить("WorkTime"	,МассивГрафикРаботы);
		
		МассивСотрудники.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат МассивСотрудники;
	
КонецФункции
#КонецОбласти