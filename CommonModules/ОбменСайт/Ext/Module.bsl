Функция РазбитьНаПакеты(СтруктураДанных) Экспорт
		УстановитьПРивилегированныйрежим(Истина);

	МассивПакетов = Новый Массив();
	Для Каждого Данные Из СтруктураДанных Цикл
		МассивДанных = Данные.Значение;
		Пока Не МассивДанных.Количество() = 0 Цикл
			МассивПакетов.Добавить(ПолучитьПустуюСтруктуруОтправки());
			НПакет = МассивПакетов[МассивПакетов.ВГраница()];
			Если МассивДанных.Количество() >= 25 Тогда
				Для Индекс = 0 По 24 Цикл
					
					НПакет[Данные.Ключ].Добавить(МассивДанных[0]);
					МассивДанных.Удалить(0);
					//Индекс = Индекс+1;
				КонецЦикла;
			Иначе
				Пока Не МассивДанных.Количество() = 0 Цикл				
					НПакет[Данные.Ключ].Добавить(МассивДанных[0]);
					МассивДанных.Удалить(0);
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;	
	Возврат МассивПакетов;
КонецФункции

Процедура ОтправитьДанныеОчки (МассивПакетов, Узел, ТипДанных, СсылкаОбъекта,СписокОбъектов, Отказ, НаправлениеОбмена= Неопределено) Экспорт
	
	УстановитьПРивилегированныйрежим(Истина);
	
	//Для Каждого Пакет Из МассивПакетов Цикл			
	НадоОтправлять = Ложь;	
	Для каждого КлючИЗначение из МассивПакетов цикл
		Если  
			ТипЗНЧ(КлючИЗначение.Значение) = Тип("Массив")
			И КлючИЗначение.Значение.Количество() > 0 
			ТОгда НадоОтправлять= Истина
		КонецЕсли;
	КонецЦикла;
	Если  Не НадоОТправлять Тогда Возврат
	КонецЕсли;
	//
	Сервер = Узел.Сайт.Сервер;
	Метод = Узел.Сайт.Метод; 
	Логин = Узел.Сайт.Логин; 
	Пароль = Узел.Сайт.Пароль; 
	
	//HttpСоединение = Новый HTTPСоединение(Сервер,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	//HttpЗапрос = Новый HttpЗапрос();
	//HttpЗапрос.Заголовки.Вставить("Accept", "application/json");
	
	SSL = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС());
	HttpСоединение = Новый HTTPСоединение(Сервер,,ЛОгин,Пароль,,720,SSL);
	HttpЗапрос = Новый HttpЗапрос();
	HttpЗапрос.Заголовки.Вставить("Accept", "application/json");
	
	АдресЗапроса = Сервер + Метод;
	
	ТелоЗапроса = СформироватьJSON(МассивПакетов);
	
	HttpЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	HttpЗапрос.Заголовки.Вставить("Content-Type", "application/json");
	СтрокаЛог = РегистрыСведений.ЛогированиеСайт.СоздатьМенеджерЗаписи();
	СтрокаЛог.Время = ТекущаяДата();
	СтрокаЛог.Режим = Перечисления.СайтЛогиРежим.Отправка;
	СтрокаЛог.ТипДанных = ТипДанных;
	СтрокаЛог.Сайт = Узел.Сайт;
	СтрокаЛог.ДанныеИсходящие = ТелоЗапроса;
	
	Попытка
		HttpЗапрос.АдресРесурса = Метод;
		Ответ = HttpСоединение.ОтправитьДляОбработки(HttpЗапрос);
		
		//	Ответ = HttpСоединение.ВызватьHTTPМетод("POST",HttpЗапрос);
		
		СтруктураОтвет = ЧтениеJSON(Ответ);
		СтрокаЛог.КодСтатуса = Ответ.КодСостояния;
		СтрокаЛог.ДанныеВходящие = Ответ.ПолучитьТелоКакСтроку("UTF8");
		
		Если СтруктураОтвет.success Тогда
			СтрокаЛог.Статус = Перечисления.СайтЛогиСтатусы.Успешно;
			Если Не СписокОбъектов = Неопределено Тогда
				Для Каждого Строчка Из СписокОбъектов Цикл  
					Если Не Строчка = Неопределено И НаправлениеОбмена= Неопределено  Тогда						
						ПланыОбмена.УдалитьРегистрациюИзменений(Узел,Строчка);                                            
					Иначе
						СнятьСРегистрацииПоНаправлениюОбмена(Узел, Строчка, НаправлениеОбмена);
						ЗарегистрироватьФактОТправкиНаСайт(Строчка, Узел)
					КонецЕсли;	
					
				КонецЦикла;
			КонецЕсли;
		Иначе
			СтрокаЛог.Статус = Перечисления.СайтЛогиСтатусы.СОшибками;	
			Отказ = Истина;
		КонецЕсли;      
	Исключение
		Отказ = Истина;	
	КонецПопытки;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	РАЗНОСТЬДАТ(&ДатаНач, &ДатаКон, СЕКУНДА) КАК Длительность");
	Запрос.УстановитьПараметр("ДатаНач", СтрокаЛог.Время);
	Запрос.УстановитьПараметр("ДатаКон", Текущаядата());		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтрокаЛог.Длительность= Выборка.Длительность;
	Иначе
		СтрокаЛОг.Длительность = 0;
	КонецЕсли;
	
	СтрокаЛог.Записать();
	//КонецЦикла;
		
КонецПроцедуры        

Процедура ЗарегистрироватьФактОТправкиНаСайт(Строка, Узел)
	
	УстановитьПривилегированныйРежим(Истина);
	Если ТипЗнч(Строка) = Тип("СправочникСсылка.Номенклатура") Тогда
		Если Строка.ПометкаУдаления
			ИЛИ НЕ Строка.РазрешенОбменСайт
			ИЛИ (Узел.Код = "0002" и НЕ Строка.СайтLuxor)
			ИЛИ (Узел.Код = "0001" и НЕ Строка.СайтPolaroid)	 
			Тогда
			//НаборЗаписей = РегистрыСведений.РегистрацияОтправкиНоменклатурыНаСайт.СоздатьНаборЗаписей();
			//НаборЗаписей.Отбор.Узел.Установить(Узел);
			//НаборЗаписей.Отибор.Номенклатура.Установить(Строка);
			//НаборЗаписей.Записать;	
			Запись = РегистрыСведений.РегистрацияОтправкиНоменклатурыНаСайт.СоздатьМенеджерЗаписи();
			Запись.Номенклатура = Строка;
			Запись.Узел = Узел;
			Запись.НужноОтменить = Истина;
			Запись.ПереданаОтмена = Истина;
			Запись.Записать();
		Иначе
			Запись = РегистрыСведений.РегистрацияОтправкиНоменклатурыНаСайт.СоздатьМенеджерЗаписи();
			Запись.Номенклатура = Строка;
			Запись.Узел = Узел;
			Запись.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	










Процедура СнятьСрегистрацииПоНаправлениюОбмена(Узел, Ссылка, НаправлениеОбмена)
	Набор = РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
	Набор.Отбор.Номенклатура.Установить(Ссылка);	
	Набор.Отбор.Направление.Установить(НаправлениеОбмена);	
	Набор.Отбор.УзелРегистрации.Установить(Узел);
	Набор.Прочитать();     
	Если Набор.Количество()=0 Тогда
		Возврат;
	Конецесли;
	ПланыОБмена.УдалитьРегистрациюИзменений(Узел, Набор);
КонецПроцедуры	
	
