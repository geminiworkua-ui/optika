Процедура ПроизвестиОбменПоНаправлению(Полный, Направление, Узел)

Попытка	
	
	УстановитьПРивилегированныйрежим(Истина);

	СписокУдаления = Новый Массив;
	Отказ = Ложь;
	СО = СоответствияОбмена();    
	СписокУдаления = Новый Массив;
	ТипДанных = СО.Получить(Направление); 
	
	Если Не ТипДанных = Неопределено Тогда	
		
		    Если Направление = "Товары" 			
				Тогда
				ПолучитьВсюНоменклатуру(Полный, Узел, СписокУдаления);  
				Возврат;
			ИначеЕсли Направление = "Категории" 	
				Тогда
		        ПолучитьВсеКатегории(Полный, Узел);
				Возврат;
			ИначеЕсли Направление = "Рубрикатор" 	
				Тогда
				ПолучитьРубрикатор(Полный, Узел);			
				Возврат;
			ИначеЕсли Направление = "Производитель" 
				Тогда
				ПолучитьРазное(Полный, ТипДанных, Узел);  
				Возврат;
			ИначеЕсли Направление = "Бренды" 		
				Тогда 
				ПолучитьРазное(Полный, ТипДанных, Узел);  
				Возврат;
			ИначеЕсли Направление = "Страны"  		
				Тогда
				ПолучитьРазное(Полный, ТипДанных, Узел);  
				Возврат;
			ИначеЕсли Направление = "Свойства" 		
				Тогда 
				Результат = ПолучитьСвойства(Полный, Узел);  
			ИначеЕсли Направление = "КатегорииЦен"  				
				Тогда
				ПолучитьВидыЦен(Полный, Узел);
				Возврат;
			ИначеЕсли Направление = "ЦеныНоменклатуры" 
				Тогда
				ПолучитьЦеныНоменклатуры(Полный, Узел, СписокУдаления);  
				Возврат;
			ИначеЕсли Направление = "PriceNomenclature" 
				Тогда
				ПолучитьОстатки(Полный, Узел, СписокУдаления); 
				Возврат;
			ИначеЕсли Направление = "КартинкиНоменклатуры" 
				Тогда
				ПолучитьКартинки(Полный, Узел, СписокУдаления);    
				Возврат;
			ИначеЕсли Направление = "ЗаписьКВрачу" 
				Тогда
				Результат = ОбработатьЗаписиКВрачу(Узел, СписокУдаления);	
			ИначеЕсли Направление = "РасписаниеВрачей"  
				И Полный
				Тогда
				Результат = ОбработатьЗаписиКВрачу(Узел, СписокУдаления);	
			КонецЕсли;
			
			СтруктураОтправки = СформироватьДанныеОчки(ТипДанных, Результат, Узел.Сайт); 
			ОтправитьДанныеОчки(СтруктураОтправки, Узел, ТипДанных, "", СписокУдаления, Отказ);
	КонецЕсли;
	
Исключение
КонецПопытки;

	
	
КонецПроцедуры

