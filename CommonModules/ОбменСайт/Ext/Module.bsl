Функция ПолучитьДолжности(Узел = Неопределено,СписокУдаления) Экспорт
		УстановитьПРивилегированныйрежим(Истина);

	ЗапросДолжности = Новый Запрос;
	МассивДолжности = Новый Массив;
	Структура = ПолучитьТекстЗапроса("Должности",Узел);
	
	Если Узел = Неопределено Тогда
		ТекстУсловия = "
						|ГДЕ
	                    |	Должности.ЭтоВрач = ИСТИНА";
	Иначе
		ТекстУсловия = "
						|ГДЕ
	                    |	Должности.ЭтоВрач = ИСТИНА
	                    |	И Должности.Узел = &Узел";
		ЗапросДолжности.УстановитьПараметр("Узел",Узел);
	КонецЕсли;
	 
	ЗапросДолжности.Текст = "ВЫБРАТЬ
	                       |	Должности" + Структура.ТекстСсылка + ".Ссылка КАК Ссылка,
	                       |	Должности" + Структура.ТекстСсылка + ".Наименование КАК Наименование
	                       |ИЗ
	                       |	Справочник.Должности" + Структура.ТекстИзменения + " КАК Должности" + ТекстУсловия;
	Результат = ЗапросДолжности.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Результат Цикл
		
		Структура = Новый Структура;
		
		Структура.Вставить("uuid",Строка(Строка.Ссылка.УникальныйИдентификатор()));
		Структура.Вставить("Name",Строка.Наименование);
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(Строка.Ссылка,Строка.Наименование,Истина);
		КонецЕсли;
		
		МассивДолжности.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат МассивДолжности;
	
КонецФункции

