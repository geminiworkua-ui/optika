	//|ИЗ
	//|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	//|ГДЕ
	//|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточникаСтрокой = &УИД
	//|	И СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &Узел");
	//Запрос.УстановитьПараметр("УИД",Строка(УИД));                                                                                           
