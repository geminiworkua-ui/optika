	Структура.Вставить("DocID"		,Строка(Источник.УникальныйИдентификатор()));
	
	Если Строка.ЕстьЗапись Тогда
		Структура.Вставить("Status"		,"Время занято");
		//Структура.Вставить("DocID"		,Строка(Строка.Ссылка.УникальныйИдентификатор()));
		Структура.Вставить("ClientID"	,Строка(Строка.ДокументЗаписи.Клиент.УникальныйИдентификатор())); 
	Иначе
		Структура.Вставить("Status"		,"Свободно");
		//Структура.Вставить("DocID"		,Строка(Строка.Ссылка.УникальныйИдентификатор()));
		//Структура.Вставить("DocID"		,"");
		Структура.Вставить("ClientID"	,""); 
	КонецЕсли;
	
	Возврат Структура;
		
