#Область Служебное
Функция ПолучитьУзелСтаройБазы() Экспорт
	УстановитьПРивилегированныйрежим(Истина);
	
	
	ЗапросСтараяБаза = Новый Запрос(
	"ВЫБРАТЬ
	|	СтараБаза.Ссылка
	|ИЗ
	|	ПланОбмена.СтараБаза КАК СтараБаза
	|ГДЕ
	|	НЕ СтараБаза.ЭтотУзел");
	Рез =  ЗапросСтараяБаза.Выполнить().Выбрать();
	
	Если рез.Следующий() Тогда
		Возврат Рез.Ссылка;
	КонецЕсли;
КонецФункции

Функция ПолучитьУзлыОбменаСайт() Экспорт
	УстановитьПРивилегированныйрежим(Истина);
	
	ЗапросСтараяБаза = Новый Запрос(
	"ВЫБРАТЬ
	|	ОбменССайтомНовый.Ссылка
	|ИЗ
	|	ПланОбмена.ОбменССайтомНовый КАК ОбменССайтомНовый
	|ГДЕ
	|	НЕ ОбменССайтомНовый.ЭтотУзел");
	Рез =  ЗапросСтараяБаза.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат Рез;
КонецФункции


