Процедура ИзменитьРасписание(Ссылка)    
    	УстановитьПРивилегированныйрежим(Истина);

	ДокументОбъект = Ссылка.РегистраторРасписания.ПолучитьОбъект();
Инд = число(Ссылка.НомерСтрокиРегистратораРасписания-1);                    
Если Ссылка.проведен Тогда

	 ДокументОбъект.РасписаниеПриема[Инд].ДокументЗаписи = Ссылка;
     ДокументОбъект.РасписаниеПриема[Инд].ЕстьЗапись = Истина;
	 ДокументОбъект.РасписаниеПриема[Инд].Номенклатура = Ссылка.Номенклатура;
    
 Иначе
