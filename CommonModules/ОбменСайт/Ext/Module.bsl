Функция  ОбработатьЗаписиКВрачу(Узел = Неопределено, СписокУдаления) Экспорт
		УстановитьПРивилегированныйрежим(Истина);
	
    Запрос = Новый Запрос(	
	 "ВЫБРАТЬ
	 |	ЗаписьНаПриемИзменения.Ссылка
	 |ИЗ
	 |	Документ.ЗаписьНаПрием.Изменения КАК ЗаписьНаПриемИзменения
	 |ГДЕ
	 |	ЗаписьНаПриемИзменения.Узел = &Узел");
	Запрос.УстановитьПараметр("Узел", Узел);
	
	Результат =Запрос.Выполнить().Выбрать();
	
	МассивЗаписей = Новый Массив;
	Пока Результат.Следующий() Цикл		
