Функция ПолучитьМассивОсновныхСвойств()
	
	м = НОвый Массив;
	м.Добавить("Марка"); 
	м.Добавить("Производитель"); 
	м.Добавить("Наименование");	
	м.Добавить("ТоварнаяКатегория"); 
	м.Добавить("НаименованиеПолное"); 
	м.Добавить("BestSeller"); 
	м.Добавить("ТолькоКоробка");    
	м.Добавить("НаименованиеПолное_RU");    			
	м.Добавить("Описание");    
	
	м.Добавить("Описание_RU");    
	м.Добавить("Модель");    
	м.Добавить("Модель_RU");    
	
	Возврат М;	

