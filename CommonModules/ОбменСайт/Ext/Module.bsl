КонецФункции

Функция ОпределитьУИД(Данные) Экспорт 
		УстановитьПРивилегированныйрежим(Истина);

	Если Метаданные.НайтиПоТипу(ТипЗнч(Данные)) = Неопределено Тогда
		Возврат Данные;
	КонецЕсли;
	
	УИДСтаройБазы = ПолучитьУИДСтаройБазы(Данные);
	
	//УИДСтаройБазы = ПолучитьУИДСтаройБазы(Данные.УникальныйИдентификатор());
	
	Возврат ?(Не УИДСтаройБазы = Неопределено, УИДСтаройБазы, ?(Данные.Пустая(), NULL,Строка(Данные.УникальныйИдентификатор())));
	
КонецФункции

Функция ПолучитьТекстЗапроса(ТипДанных, Узел)
		УстановитьПРивилегированныйрежим(Истина);

	ТекстЗапроса = Новый Структура;
	
	Если Узел = Неопределено Тогда
		ТекстЗапроса.Вставить("ТекстСсылка"		, "");
		ТекстЗапроса.Вставить("ТекстИзменения"	, "");
		ТекстЗапроса.Вставить("ТекстУсловие"	, "");
	Иначе
		ТекстЗапроса.Вставить("ТекстСсылка", ".Ссылка");
		ТекстЗапроса.Вставить("ТекстИзменения",".Изменения");
		ТекстЗапроса.Вставить("ТекстУсловие","
	                        |ГДЕ
	                        |	" + ТипДанных + ".Узел = &Узел");
	КонецЕсли;
	Возврат ТекстЗапроса;
КонецФункции

Функция ПолучитьНаборЗаписей(Регистратор , Номенклатура,Регистр)
		УстановитьПРивилегированныйрежим(Истина);

	Рег = Регистр;
	
	Набор = Рег.СоздатьНаборЗаписей();
	
	Если Не ТипЗнч(Регистратор) = Тип("Структура") Тогда
		Набор.Отбор.Регистратор.Использование 	= Истина;
		Набор.Отбор.Регистратор.Значение 		= Регистратор;
	Иначе
		Набор.Отбор.Объект.Использование 	= Истина;
		Набор.Отбор.Объект.Значение			= Регистратор.Объект;
		Набор.Отбор.Свойство.Использование 	= Истина;
		Набор.Отбор.Свойство.Значение		= Регистратор.Свойство;
	КонецЕсли;
	
	Набор.Прочитать();
	
	Если Рег = РегистрыСведений.РасписаниеРаботыСотрудников Тогда
		СтруктураОтбор = Номенклатура;
		Индекс = Набор.Выгрузить().НайтиСтроки(СтруктураОтбор)[0].НомерСтроки - 1;
		НайденаяЗапись = Набор.Получить(Индекс);
	ИначеЕсли Рег = РегистрыСведений.СвойстваОбъектов Тогда
		СтруктураОтбор = Регистратор;
		НайденаяЗапись = Набор[0];
	ИначеЕсли Рег = РегистрыСведений.КадроваяРасстановка Тогда
		СтруктураОтбор = Новый Структура;
		СтруктураОтбор.Вставить("ФизическоеЛицо",Номенклатура);
		Индекс = Набор.Выгрузить().НайтиСтроки(СтруктураОтбор)[0].НомерСтроки - 1;
		НайденаяЗапись = Набор.Получить(Индекс);
	Иначе
		СтруктураОтбор = Новый Структура;
		СтруктураОтбор.Вставить("Номенклатура",Номенклатура);
		Индекс = Набор.Выгрузить().НайтиСтроки(СтруктураОтбор)[0].НомерСтроки - 1;
		НайденаяЗапись = Набор.Получить(Индекс);
	КонецЕсли;
	
	Набор.Очистить();
	
	НЗапись = Набор.Добавить();
	
	Если Рег = РегистрыНакопления.ТоварыНаСкладах Тогда
		НЗапись.Активность 				= НайденаяЗапись.Активность;
		НЗапись.ВидДвижения 			= НайденаяЗапись.ВидДвижения;
		НЗапись.ВНаличии 				= НайденаяЗапись.ВНаличии;
		НЗапись.КонтролироватьОстатки 	= НайденаяЗапись.КонтролироватьОстатки;
		НЗапись.КОтгрузке 				= НайденаяЗапись.КОтгрузке;
		НЗапись.Назначение 				= НайденаяЗапись.Назначение;
		НЗапись.Номенклатура 			= НайденаяЗапись.Номенклатура;
		НЗапись.Период 					= НайденаяЗапись.Период;
		НЗапись.Помещение 				= НайденаяЗапись.Помещение;
		НЗапись.Регистратор 			= НайденаяЗапись.Регистратор;
		НЗапись.Серия 					= НайденаяЗапись.Серия;
		НЗапись.Склад 					= НайденаяЗапись.Склад;
		НЗапись.Характеристика 			= НайденаяЗапись.Характеристика;
	КонецЕсли;
	
	Если Рег = РегистрыСведений.ЦеныНоменклатуры Тогда
		НЗапись.Активность 		= НайденаяЗапись.Активность;
		НЗапись.Валюта 			= НайденаяЗапись.Валюта;
		НЗапись.ВидЦены 		= НайденаяЗапись.ВидЦены;
		НЗапись.Номенклатура 	= НайденаяЗапись.Номенклатура;
		НЗапись.Период 			= НайденаяЗапись.Период;
		НЗапись.Регистратор 	= НайденаяЗапись.Регистратор;
		НЗапись.Упаковка 		= НайденаяЗапись.Упаковка;
		НЗапись.Характеристика 	= НайденаяЗапись.Характеристика; 
		НЗапись.Цена 			= НайденаяЗапись.Цена;
	КонецЕсли;
	
	Если Рег = РегистрыСведений.РасписаниеРаботыСотрудников Тогда
		НЗапись.Активность 				= НайденаяЗапись.Активность;
		НЗапись.ВремяНачалаРаботы 		= НайденаяЗапись.ВремяНачалаРаботы;
		НЗапись.ВремяОкончанияРаботы 	= НайденаяЗапись.ВремяОкончанияРаботы;
		НЗапись.Должность 				= НайденаяЗапись.Должность;
		//НЗапись.НомерСтроки 			= НайденаяЗапись.НомерСтроки;
		НЗапись.Период 					= НайденаяЗапись.Период;
		НЗапись.Подразделение 			= НайденаяЗапись.Подразделение;
		НЗапись.Регистратор 			= НайденаяЗапись.Регистратор;
		НЗапись.Сотрудник 				= НайденаяЗапись.Сотрудник;
		НЗапись.СтатусЗанятости 		= НайденаяЗапись.СтатусЗанятости;
	КонецЕсли;
	
	Если Рег = РегистрыСведений.СвойстваОбъектов Тогда
		НЗапись.Активность 		= НайденаяЗапись.Активность;
		НЗапись.Значение 		= НайденаяЗапись.Значение;
		НЗапись.Объект 			= НайденаяЗапись.Объект;
		НЗапись.Период 			= НайденаяЗапись.Период;
		НЗапись.Регистратор 	= НайденаяЗапись.Регистратор;
		НЗапись.Свойство 		= НайденаяЗапись.Свойство;
	КонецЕсли;
	
	Если Рег = РегистрыСведений.КадроваяРасстановка Тогда
		НЗапись.Активность 					= НайденаяЗапись.Активность;
		НЗапись.Актуальность 				= НайденаяЗапись.Актуальность;
		НЗапись.БазоваяСтавка 				= НайденаяЗапись.БазоваяСтавка;
		НЗапись.ВидКадровогоДвижения 		= НайденаяЗапись.ВидКадровогоДвижения;
		НЗапись.Должность 					= НайденаяЗапись.Должность;
		НЗапись.ЕстьИндивидуальныйГрафик	= НайденаяЗапись.ЕстьИндивидуальныйГрафик;
		НЗапись.Период 						= НайденаяЗапись.Период;
		НЗапись.Подразделение 				= НайденаяЗапись.Подразделение;
		НЗапись.ПроцентВыручки 				= НайденаяЗапись.ПроцентВыручки;
		НЗапись.Регистратор 				= НайденаяЗапись.Регистратор;
		НЗапись.СпособНачисленияСтавки 		= НайденаяЗапись.СпособНачисленияСтавки;
		НЗапись.ФизическоеЛицо 				= НайденаяЗапись.ФизическоеЛицо;
	КонецЕсли;
	
	Возврат Набор;
КонецФункции

