Функция  ЗаполнитьСтруктуруСвойствНоменклатуры(ВыборкаСвойства)
	МассивОС = ПолучитьМассивОсновныхСвойств();
	УстановитьПРивилегированныйрежим(Истина);
	МассивСвойства = Новый Массив; 
	
	Для Каждого Строка Из  ВыборкаСвойства Цикл
		УИДВладелец = ОпределитьУИД(Строка.Ссылка);
		Для каждого Свойство из Строка.Ссылка.ВидНоменклатуры.РеквизитыДляКонтроляНоменклатуры Цикл
			Результат =МассивОС.Найти(Свойство.ИмяРеквизита);
			Если Не Результат = Неопределено Тогда
				Продолжить;
			КОнецЕсли;	 
			Если Не Свойство.ТребоватьЗаполнения Тогда
				Продолжить;
			КонецЕсли;
			// 
			УИДСвойство = ИнфралайнОбмен.ПолучитьУИД_ПоИмениСвойста(Свойство.ИмяРеквизита);
			если УИДСвойство = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			Если  ТипЗнч(Строка.Ссылка[Свойство.ИмяРеквизита]) =Тип("Булево") или  
				ТипЗнч(Строка.Ссылка[Свойство.ИмяРеквизита]) =Тип("Число") Или
				ТипЗнч(Строка.Ссылка[Свойство.ИмяРеквизита]) =Тип("Дата") или 
				ТипЗнч(Строка.Ссылка[Свойство.ИмяРеквизита]) =Тип("Строка") или 
				ТипЗнч(Строка.Ссылка[Свойство.ИмяРеквизита]) =Тип("СправочникСсылка.ВидыНоменклатуры") или
				ТипЗнч(Строка.Ссылка[Свойство.ИмяРеквизита]) =Тип("ПеречислениеСсылка.СтавкиНДС")  
				Тогда
				Продолжить;
			КонецЕсли;	
			Если Строка.Ссылка[Свойство.ИмяРеквизита].Пустая() Тогда
				Продолжить;
			КонецЕсли;	
			
			Структура = Новый Структура;
			Структура.Вставить("Parent_ID",УИДВладелец);
			Структура.Вставить("ID",УИДСвойство);
			Структура.Вставить("Del",Строка.ПометкаУдаления);  
			
			ТипДанных =  ОпределитьТипМД(Строка.Ссылка[Свойство.ИмяРеквизита]);
			Если Типданных = "Справочник" Тогда
				Структура.Вставить("Name_UA",Строка.Ссылка[Свойство.ИмяРеквизита].Наименование);
				Попытка    
					Значение = Строка.Ссылка[Свойство.ИмяРеквизита].Наименование_ru;
					Структура.Вставить("Name_RU",?(Значение = "", Строка.Ссылка[Свойство.ИмяРеквизита].Наименование, Значение));
				Исключение
					Структура.Вставить("Name_RU",Строка.Ссылка[Свойство.ИмяРеквизита].Наименование);
				КонецПопытки;
			ИначеЕсли Типданных = "Перечисление" Тогда
				Структура.Вставить("Name_UA",Строка(Строка.Ссылка[Свойство.ИмяРеквизита]));
				Структура.Вставить("Name_RU",Строка(Строка.Ссылка[Свойство.ИмяРеквизита]));
			КонецЕсли;	
			
			МассивСвойства.Добавить(Структура);
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивСвойства;
	
КонецФункции

Функция ОпределитьТипМД(Значение)
    	УстановитьПРивилегированныйрежим(Истина);

	ТипЗначения = ТипЗнч(Значение);
ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
    Возврат "Справочник";
ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
    Возврат "Документ";
ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
    Возврат "Перечисление";
КонецЕсли;                 
КОнецФункции

//CategoryPrice - массив с типами цен
Процедура ПолучитьВидыЦен(Полный, Узел) Экспорт 
    	УстановитьПРивилегированныйрежим(Истина);

	СписокУдаления = Новый Массив;	
	ЗапросВидыЦен = Новый Запрос(
	 "ВЫБРАТЬ
	 |	ВидыЦен.Ссылка,
	 |	ВидыЦен.Наименование,
	 |	ВидыЦен.ПометкаУдаления,
	 |	ВидыЦен.Идентификатор,
	 |	ВидыЦен.Наименование_ru
	 |ИЗ
	 |	Справочник.ВидыЦен КАК ВидыЦен
	 |ГДЕ
	 |	ВидыЦен.ОтправлятьНаСайт = &Узел");
	
	
	
	ЗапросВидыЦен.УстановитьПараметр("Узел",Узел);
	
	Выборка = ЗапросВидыЦен.Выполнить().Выгрузить();
    РазмерМассива = Выборка.Количество();
	КоличПакетов = Окр(РазмерМассива / Узел.ШагОтправкиОписание,0, РежимОкругления.Окр15как20);   
	Если КоличПакетов = 0 Тогда
		КоличПакетов =1;
	КонецЕсли;
    Отказ = Ложь;
	ТипДанных = "CategoryPrice";
	Для НомерПакета = 0 по КоличПакетов-1 цикл
		ТЗ = СформироватьПакет(НомерПакета, Выборка, РазмерМассива, Узел.ШагОтправкиОписание); 
		Данные = ЗаполнитьСтруктуруВидовЦен(ТЗ);
		СтруктураОтправки = Новый Структура();  
		СтруктураОтправки = ОбменСайт.СформироватьДанныеОчки(ТипДанных, Данные, Узел);
		ОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Узел, ТипДанных, "", СписокУдаления, Отказ);	
	КонецЦикла;
КонецПроцедуры
	
Функция ЗаполнитьСтруктуруВидовЦен (ВыборкаВидыЦен)	
		УстановитьПРивилегированныйрежим(Истина);
	ВидыЦен = Новый Массив;
	
	Для Каждого Строка Из ВыборкаВидыЦен Цикл
		
		Структура = Новый Структура;
		УИД = ОпределитьУИД(Строка.Ссылка);
		
	    Структура.Вставить("ID"			,УИД);
		Структура.Вставить("Del"		,Строка.ПометкаУдаления);
		Структура.Вставить("Main"		,?(Строка.Идентификатор = "Роздрібна",Истина,Ложь));
		Структура.Вставить("Quantity"	,Ложь);
		Структура.Вставить("Name_UA"	,Строка.Наименование);
		Структура.Вставить("Name_RU"	,?(Строка.Наименование_ru= "",Строка.Наименование, Строка.Наименование_ru));
		
		ВидыЦен.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат ВидыЦен;
	
КонецФункции


