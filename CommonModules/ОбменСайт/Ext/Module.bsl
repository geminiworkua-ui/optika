	Отказ = Ложь;
	ТипДанных = "PriceNomenclature";
	Для НомерПакета = 0 по КоличПакетов-1 цикл
		ТЗ = СформироватьПакет(НомерПакета, Выборка, РазмерМассива, Узел.ШагОтправкиЦены); 
