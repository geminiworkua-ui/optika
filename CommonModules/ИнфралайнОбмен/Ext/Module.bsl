#Область НалоговаяГруппа 
Функция СтавкиНДС(НалоговаяГруппа)
Если НалоговаяГруппа.PredefinedDataName ="БезНДС" Тогда
	Возврат перечисления.СтавкиНДС.БезНДС;                          
Иначеесли  НалоговаяГруппа.PredefinedDataName ="НеНДС" Тогда
	Возврат перечисления.СтавкиНДС.НеНДС;
Иначеесли  НалоговаяГруппа.PredefinedDataName ="НДС0" Тогда
	Возврат перечисления.СтавкиНДС.НДС0;
Иначеесли  НалоговаяГруппа.PredefinedDataName ="НДС20" Тогда
	Возврат перечисления.СтавкиНДС.НДС20;
Иначеесли  НалоговаяГруппа.PredefinedDataName ="НДС14" Тогда
	Возврат перечисления.СтавкиНДС.НДС14;
Иначеесли  НалоговаяГруппа.PredefinedDataName ="НДС7" Тогда
	Возврат перечисления.СтавкиНДС.НДС7; 
Иначе Возврат перечисления.СтавкиНДС.БезНДС;	
КонецЕсли;

