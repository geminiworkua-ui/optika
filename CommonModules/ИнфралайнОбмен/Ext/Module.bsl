Процедура ТМЦСерии(Соединение, ТМЦКом, Узел, СтрОбмена)  

ТипПриемника ="ТМЦСерии";
ТипИсточника ="Справочник.ХарактеристикиНоменклатуры";
Выборка = СписокСерий(Соединение, ТМЦКом);

Текущий =0;
Всего = Выборка.Количество();
Для каждого СерияКом из Выборка цикл   
	Текущий = Текущий + 1;
				
	ПроцентВыполнения = (Текущий/Всего)*100;
	ПроцентВыполнения = Окр(ПроцентВыполнения,0);
	СтрокаПр = " (" +Строка(текущий) +" из "	+Строка(Всего)+")"; 	
	ДлительныеОперации.СообщитьПрогресс("Серии " + СтрокаПр);

	НовыйЭлемент =Ложь;	
	Серия = ТМЦСерия(Соединение, СерияКом.Ссылка, Узел, СтрОбмена); 
		
 КонецЦикла;

