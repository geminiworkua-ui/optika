Процедура ТрасляцияДигер(Соединение=Неопределено, Узел =Неопределено, СтрОбмена = Неопределено) Экспорт
	
	Если Узел =Неопределено Тогда
		Узел  =ПолучитьУзел();
	КонецЕсли;    
	
	Если Соединение  =Неопределено Тогда
		Соединение = ПодключитьБазу (Узел); 
	КонецЕсли;
    
	Если  Соединение = Неопределено Тогда 
		  Возврат;
	КонецЕсли;

	Если СтрОбмена = Неопределено Тогда
		УзелОб = Узел.ПолучитьОбъект();
		Узелоб.ДатаПерехода =  Началодня(ТекущаяДата());
		УзелОб.Записать();
		СтрОбмена = ПолучитьСтрОбмена(Узел);
	КонецЕсли;
	
	Если Узел.ДатаПерехода = Дата(1,1,1) Тогда
		ДатаПерехода = Началодня(ТекущаяДата());
	Иначе 	                                    
		ДатаПерехода = Началодня(Узел.ДатаПерехода);
	КонецЕсли;
	
    	  
	УстановитьДиректориюОбменаДигер(Соединение, узел);
   	
	Если СтрОбмена.Свойство("Организации") и СтрОбмена.Организации Тогда
		 СписокОрганизации(Соединение, Узел, СтрОбмена);	
	КонецЕсли;
	 
	Если СтрОбмена.Свойство("Страны") и  СтрОбмена.Страны Тогда
		 СписокСтраны(Соединение, Узел, СтрОбмена);
	КонецЕсли;
	 
	Если СтрОбмена.Свойство("КатегорииЦен") и  СтрОбмена.КатегорииЦен Тогда
		 СписокКатегорииЦен(Соединение, Узел, СтрОбмена);
	КонецЕсли;
	 
	Если СтрОбмена.Свойство("Склады") и СтрОбмена.Склады Тогда
		 СписокСклады(Соединение, Узел, СтрОбмена);	 			 
	КонецЕсли;	 
	 
	Если СтрОбмена.Свойство("Подразделения")и  СтрОбмена.Подразделения Тогда
		 СписокПодразделения(Соединение, Узел, СтрОбмена);	 
	КонецЕсли;	 
	 
	Если СтрОбмена.Свойство("Кассы")и СтрОбмена.Кассы Тогда
		 СписокКассы(Соединение, Узел, СтрОбмена);	 	 
	КонецЕсли;
	
	Если СтрОбмена.Свойство("Контрагенты")и СтрОбмена.Контрагенты Тогда
		 СписокКонтрагенты(Соединение, Узел, СтрОбмена);	 				 	
	КонецЕсли;

	Если СтрОбмена.Свойство("ТМЦ")и  СтрОбмена.ТМЦ Тогда  
		 СписокТМЦ(Соединение, ДатаПерехода, Узел, СтрОбмена);
	КонецЕсли;
	
	Если СтрОбмена.Свойство("Цены")и СтрОбмена.Цены Тогда  
		 ДокументЦены(Соединение, Узел, СтрОбмена);
	КонецЕсли;
	
	Если СтрОбмена.Свойство("Остатки")и СтрОбмена.Остатки Тогда  
		 Остатки(Соединение, Узел, СтрОбмена);
	КонецЕсли;
	
	Если СтрОбмена.Свойство("Штрихкоды")и СтрОбмена.Штрихкоды Тогда
		 СписокШтрихкоды(Соединение, Узел, ,СтрОбмена);
	КонецЕсли;
	
	Если СтрОбмена.Свойство("Файлы")и СтрОбмена.Файлы Тогда
		 СписокФайлы(Соединение, Узел, ,СтрОбмена);
	КонецЕсли;
	
	Если СтрОбмена.Свойство("ДопАртикулы")и СтрОбмена.ДопАртикулы Тогда
		СписокДопАртикулы(Соединение, Узел, СтрОбмена);
	КОнецЕсли;	
	
	Если СтрОбмена.Свойство("ДопРеквизиты") и  СтрОбмена.ДопРеквизиты Тогда
		СписокДопРеквизиты(Соединение, Узел,СтрОбмена);
		ЗаполнитьЗначенияРеквизитовСайт(Соединение, Узел, СтрОбмена);
	КонецЕсли;  
	
	Если СтрОбмена.Свойство("ДопРеквизитыКлиенты")и СтрОбмена.ДопРеквизитыКлиенты Тогда
		СписокДопРеквизитыКлиенты(Соединение, Узел, СтрОбмена);
	КонецЕсли;  
	
	Если СтрОбмена.Свойство("Резерв")и СтрОбмена.Резерв Тогда
		ПолучитьКонтрольОстатка(Соединение, Узел, СтрОбмена);	
	КонецЕсли;	 
	
	Если СтрОбмена.Свойство("Состав")и СтрОбмена.Состав Тогда
		СписокСостава(Соединение, Узел, СтрОбмена);	
	КонецЕсли;	 
	
	Если СтрОбмена.Свойство("БонусПрограмма")и СтрОбмена.БонусПрограмма Тогда
		СписокБонусныхПрограмм(Соединение, Узел, СтрОбмена);
	КонецЕсли;	
	
	Если СтрОбмена.Свойство("ОстаткиБонусов") и СтрОбмена.ОстаткиБонусов Тогда
		ОстаткиПоБонусам(Соединение, Узел, СтрОбмена);
	КонецЕсли;	
	
	Если СтрОбмена.Свойство("КартыЛояльности")и СтрОбмена.КартыЛояльности Тогда
		СписокКартЛояльности(Соединение, Узел, СтрОбмена);
		 СписокСкидочныхКарт(Соединение, Узел, СтрОбмена);
	КонецЕсли;	
	
	Если СтрОбмена.Свойство("Упаковки")и СтрОбмена.Упаковки Тогда
		СписокУпаковки(Соединение, ,Узел);			
	КонецЕсли;
	
	Если СтрОбмена.Свойство("СвойстваНабора")и СтрОбмена.СвойстваНабора Тогда
		СписокНаборы(Соединение, Узел);			
	КонецЕсли;
	
	Если СтрОбмена.Свойство("СвойстваНабора")и  СтрОбмена.СвойстваНабора Тогда
		СписокНаборы(Соединение, Узел, СтрОбмена);			
	КонецЕсли;
	
	Если СтрОбмена.Свойство("СвойстваОбъекта")и  СтрОбмена.СвойстваОбъекта Тогда
		СписокСвойств(Соединение, Узел, СтрОбмена);
	КонецЕсли;	

	Если СтрОбмена.Свойство("ЗначенияСвойств")и СтрОбмена.ЗначенияСвойств Тогда
		СписокЗначений(Соединение, Узел, СтрОбмена);
	КонецЕсли;	
	
	Если СтрОбмена.Свойство("Марки")и СтрОбмена.Марки Тогда
		СписокМарки(Соединение, Узел, СтрОбмена);			
	КонецЕсли;	
	
	Если СтрОбмена.Свойство("Сотрудники")и СтрОбмена.Сотрудники Тогда
		СписокСотрудники(Соединение, Узел, СтрОбмена);			
	КонецЕсли;
	
КонецПроцедуры	


