Процедура ПолучитьКонтрольОстатка(Соединение, Узел,  СтрОбмена); 
НаборЗаписей = регистрыСведений.ТоварныеОграничения.СоздатьНаборЗаписей();
НаборЗаписей.Записать();
	
СписокОстатков = ПолучитьСписокОстатка(Соединение);
Текущий =0;
Всего = СписокОстатков.Количество();

Для каждого Запись  из  СписокОстатков Цикл 
   Текущий = Текущий +1;
   ПроцентВыполнения = (Текущий/Всего)*100;
   ПроцентВыполнения = Окр(ПроцентВыполнения,0);
   СтрокаПр = " ("+Строка(текущий) +" из "	+Строка(Всего)+")"; 	
   ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП("/Контроль остатка/ " + Запись.ТМЦ.Ссылка.Наименование +" ("+ Запись.Серия.Ссылка.Наименование+") /" +Запись.Склад.ссылка.Наименование+ "/" ) + СтрокаПр);
   НовыйЭлемент = Ложь;	
   
   ТМЦ = ТМЦ(Соединение, Запись.ТМЦ, Узел);
   Если ТМЦ = Неопределено Тогда
	    Продолжить;
	КонецЕсли;
	
	//alx 30.04.2026 Н 
	//Если Не Запись.серия = Неопределено Тогда
	//	Серия = ТМЦСерия(Соединение, Запись.Серия, Узел);	  
	//КонецЕсли;
	
	Серия = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Склад = Справочники.Склады.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Запись.Серия.Description) Тогда
		Серия = НайтиСериюПоНаименованиюДигер(ТМЦ, Запись.Серия.Description);  
		Если Серия = Неопределено 
			Или Серия = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка() Тогда
			Серия = ТМЦСерия(Соединение, Запись.Серия, Узел)
		КонецЕсли;
	КонецЕсли;
	//alx 30.04.2026 К 	
	
	Если Не Запись.Склад =Неопределено Тогда
		Склад = Склады(Соединение, Запись.Склад, Узел);	
		Если Склад = НЕопределено Или Склад = Справочники.Склады.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;	
	КонецЕсли;	
	
	//alx 30.04.2026 Н 
	Если Запись.Кво_Мин = 0 Тогда
		Продолжить;
	КонецЕсли;
	
	МаксНовый = Запись.Кво_Мин;
	Если МаксНовый = 1 Тогда
		МинНовый = 0;
	ИначеЕсли ТМЦ.ВидНоменклатуры.Наименование = "4.1. Контактна корекція" Тогда
		РазмерУпаковки = Число(Запись.ВУпаковке);
		МинНовый = МаксНовый / 2;
		Если РазмерУпаковки > 0 Тогда
			МинНовый = Цел(МинНовый / РазмерУпаковки) * РазмерУпаковки;
		Иначе
			МинНовый = 0;
		КонецЕсли;
	Иначе
		МинНовый = Цел(МаксНовый / 2);
		Если МинНовый < МаксНовый / 2 Тогда
			МинНовый = МинНовый + 1;
		КонецЕсли;
	КонецЕсли;
	//alx 30.04.2026 К

	НаборЗаписей = регистрыСведений.ТоварныеОграничения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(ТМЦ);
