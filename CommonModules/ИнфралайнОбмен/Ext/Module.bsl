Функция ТМЦСайт(Соединение, ТМЦ, Узел, СтрОбмена =Неопределено)
ТипПриемника ="ТМЦ";
ТипИсточника ="Справочник.Номенклатура";	
СписокТМЦ =  ДанныеНоменклатурыСайт(Соединение );
Для каждого Стр Из СписокТМЦ Цикл 
	МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Стр.Дополнение,"/");
	Если МассивСтрок.Количество()=0 Тогда
		Продолжить;
	КонецЕсли;	
	
	Если МассивСтрок.Количество()=1 Тогда
		Продолжить;
	КонецЕсли;	
	
	Если Не МассивСтрок[1] ="Property" Тогда
		Продолжить;
	КонецЕсли;	
    Тмц  = Тмц(Соединение, Стр.Объект, Узел);
	УзелСайта = ПланыОбмена.ОбменССайтомНовый.НайтиПоНаименованию(Стр.Сайт);
	
	ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Тмц,  МассивСтрок[1], ТипПриемника, УзелСайта));
КонецЦикла;	
