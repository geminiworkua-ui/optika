#Область ФизЛица
Функция Физлица(Соединение, Физлицо, Пол, ДеньРождения, КодПоДРФО, Узел)  
	
 	ТипПриемника ="Контрагенты";
	ТипИсточника ="Справочник.ФизическиеЛица";	
    Guid = ПолучитьGuid(Соединение,Физлицо);
	Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
		Возврат Справочники.ФизическиеЛица.ПустаяСсылка();
	КонецЕсли;
	ЕстьВРегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника,  Узел);
	Если  ЕстьВРегистре Тогда
		ФизлицоСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника,  Узел); 
		
		Попытка
			ФизлицоОбъект = ФизлицоСсылка.ПолучитьОбъект();
		Исключение                       
			ФизлицоОбъект = неопределено;
		КОнецПопытки;
		
		Если ФизлицоОбъект = неопределено Тогда
			ФизлицоОбъект = Справочники.ФизическиеЛица.НайтиПоНаименованию(Строка(Физлицо.Наименование));
		КонецЕсли;
		
		Если ФизлицоОбъект = неопределено Тогда
			ФизлицоОбъект = Справочники.ФизическиеЛица.СоздатьЭлемент();
			ЕстьВРегистре = Ложь;
		КонецЕсли; 
		
	Иначе	
		ФизлицоПоиск = Справочники.ФизическиеЛица.НайтиПоНаименованию(Строка(Физлицо.Наименование));
		Если Не ЗначениеЗаполнено(ФизлицоПоиск) Тогда
			ФизлицоОбъект = Справочники.ФизическиеЛица.СоздатьЭлемент();
		Иначе	
			ФизлицоОбъект = ФизлицоПоиск.ПолучитьОбъект();
		КонецЕсли; 
		ЕстьВРегистре = Ложь;

	КонецЕсли;   
	    ФизлицоОбъект.Наименование = Физлицо.Наименование;
		ФизлицоОбъект.Уточнение = Физлицо.Описание;
		ФизлицоОбъект.Пол = Пол;
		ФизлицоОбъект.ПометкаУдаления = Ложь;
//		ФизлицоОбъект.Подразделение = Подразделения(Соединение, Физлицо.Подразделение, Узел); 
		
		ФизлицоОбъект.ДатаРождения = ДеньРождения;
		
		Попытка
			ФизлицоОбъект.Записать();
		Исключение
			Справочники.ФизическиеЛица.ПустаяСсылка();	
		КонецПопытки;	
		
		Если Не ЕстьВРегистре Тогда
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ФизлицоОбъект.Ссылка, Guid , ТипПриемника,  Узел));
        КонецЕсли;
		Возврат ФизлицоОбъект.Ссылка;

КонецФункции

