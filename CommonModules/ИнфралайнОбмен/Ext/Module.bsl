		Если Не ТипЗнч(НомОбъект) = Тип("СправочникОбъект.Номенклатура") Тогда 
			Возврат;
		КонецЕсли;
		
		МассивСайтов =МассивУзловДляОбмена(НомОбъект.ссылка);
				
		Для каждого УзелСайта из МассивСайтов Цикл
			Если УзелСайта = Неопределено Тогда
				Продолжить;
			КонецЕсли;	   
			
			НаборЗаписей  =РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Номенклатура.Установить(Номобъект.Ссылка);
			НаборЗаписей.Отбор.УзелРегистрации.Установить(УзелСайта);
			НаборЗаписей.Записать();
			
			Запись = Наборзаписей.Добавить();
			Запись.Номенклатура = НомОбъект.Ссылка;
			Запись.Направление = Перечисления.НаправлениеДляПередачи.Описание;
			Запись.УзелРегистрации = УзелСайта;
			Запись = Наборзаписей.Добавить();
			Запись.Номенклатура = НомОбъект.Ссылка;
			Запись.Направление = Перечисления.НаправлениеДляПередачи.Цены;
			Запись.УзелРегистрации = УзелСайта;
	        Запись = Наборзаписей.Добавить();
			Запись.Номенклатура = НомОбъект.Ссылка;
			Запись.Направление = Перечисления.НаправлениеДляПередачи.Остатки;
			Запись.УзелРегистрации = УзелСайта;                           
			Запись = Наборзаписей.Добавить();
			Запись.Номенклатура = НомОбъект.Ссылка;
			Запись.Направление = Перечисления.НаправлениеДляПередачи.Картинки;
			Запись.УзелРегистрации = УзелСайта;                            
			НаборЗаписей.Записать();
		КонецЦикла;	
	
КонецПроцедуры
	
Процедура ЗарегистрироватьКОбмену(ЭлементСсылка, НаправленияОбмена) Экспорт
	Если ЭлементСсылка =Неопределено Тогда
		Возврат;
	КОнецЕсли;	
	
	МассивСайтов =МассивУзловДляОбмена(ЭлементСсылка);

	Для каждого Узел из МассивСайтов Цикл 
		Если Узел = Неопределено Тогда
			Продолжить;
		КонецЕсли;	    
		НаборСС = Неопределено;
		Для каждого Направление из НаправленияОбмена Цикл
			НаборСС = РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
			НаборСС.Отбор.Номенклатура.Установить(ЭлементСсылка);
			НаборСС.Отбор.Направление.Установить(Направление); 
			НаборСС.Отбор.УзелРегистрации.Установить(Узел);
			НаборСС.Прочитать();
			Если НаборСС.Количество() = 0 Тогда 
			    Запись = наборСС.Добавить();
				Запись.Номенклатура = ЭлементСсылка;
				Запись.Направление = Направление;
				Запись.УзелРегистрации = Узел;
				НаборСС.Записать(Истина);		
			КонецЕсли;                   
			
			Если Не НаборСС = Неопределено Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Узел,НаборСС);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	
КонецПроцедуры	

Функция МассивУзловДляОбмена(Элемент)Экспорт	
МассивСайтов =Новый Массив();

	Если Элемент.СайтLuxor Тогда     
		МассивСайтов.Добавить(УзелLuxor());   
	КонецЕсли;	
		
	Если Элемент.СайтPolaroid Тогда   
	    МассивСайтов.Добавить(УзелLuxor());   
	КонецЕсли;    
Возврат МассивСайтов;	
КОнецФункции

Процедура СписокДопРеквизитыКлиенты(Соединение, Узел, СтрОбмена)
НаборЗаписей = РегистрыСведений.СвойстваОбъектов.СоздатьНаборЗаписей();
НаборЗаписей.Записать();
СО = ПолучитьСписокДопСвойсвКонтрагенты(соединение); 
Текущий =0;
Всего = СО.Количество();
   
Для каждого Стр из СО Цикл
   Текущий = Текущий +1;
   ПроцентВыполнения = (Текущий/Всего)*100;
   ПроцентВыполнения = Окр(ПроцентВыполнения,0);
   СтрокаПр = " ("+Строка(текущий) +" из "	+Строка(Всего)+")"; 	
			
   ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП("/Доп.Реквизиты Контрагенты/ " + Стр.Объект.Наименование) + СтрокаПр);
   
	КонтрагентСсылка = Контрагенты(Соединение, Стр.Объект, Узел);
	КонтрагентСвойство = СвойствоОбъекта(Соединение, Стр.Свойство, Узел);
	КонтрагентЗначение = Стр.Значение;
	
	НаборЗаписей.Отбор.Объект.Установить(КонтрагентСсылка);
	НаборЗаписей.Отбор.Свойство.Установить(КонтрагентСвойство); 
	НаборЗаписей.Прочитать();
	  Если НаборЗаписей.Количество() = 0 Тогда
	      НоваяЗапись = НаборЗаписей.Добавить();
		  НоваяЗапись.Объект = КонтрагентСсылка;
		  НоваяЗапись.Свойство = КонтрагентСвойство;
		  НоваяЗапись.Значение = КонтрагентЗначение; 
		  НоваяЗапись.Период =ТекущаяДата();	 
	  Иначе 
		  Для каждого Запись из НаборЗаписей Цикл
			Запись.Объект 	= КонтрагентСсылка;
		    Запись.Свойство = КонтрагентСвойство;
		    Запись.Значение = КонтрагентЗначение;
			Запись.Период =ТекущаяДата();
		 КонецЦикла;
	  КонецЕсли;	

  НаборЗаписей.Записать();	  
КонецЦикла;	

КонецПроцедуры	

