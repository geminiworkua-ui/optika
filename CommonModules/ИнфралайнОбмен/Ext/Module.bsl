Функция ТМЦСерия(Соединение, Характеристика, Узел, СтрОбмена= Неопределено)

//ЗапросСерии = Соединение.NewObject("Запрос");
Если   Характеристика = Null  Тогда
	Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
КонецЕсли;	
//ЗапросСерии.УстановитьПараметр("Владелец", Характеристика.Владелец);	   
ТипПриемника ="ТМЦСерии";
ТипИсточника ="Справочник.ХарактеристикиНоменклатуры";	
   
Guid = ПолучитьGuid(Соединение,Характеристика);  

Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
КонецЕсли;

ЗаписьУдалена = Ложь; 

ЕстьВРегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел) ;	
НовыйЭлемент = Не ЕстьВРегистре;
Если ЕстьВРегистре Тогда
	
		ХарСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел); 
		
		Если ХарСсылка = Неопределено Тогда
			ЕстьВРеестре = Ложь;     
			ХарОбъект = Неопределено;                                                  
			УдалитьЗапись(ПолучитьСтруктуруЗаписи(ХарСсылка, Guid , ТипПриемника, Узел));
		Иначе	
		    ХарОбъект = ХарСсылка.ПолучитьОбъект();    
		КонецЕсли;
		
		Если ХарОбъект = Неопределено Тогда
		  ХарОбъект = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент(); 
		  ЕстьВРегистре = Ложь;
		  УдалитьЗапись(ПолучитьСтруктуруЗаписи(ХарСсылка, Guid , ТипПриемника, Узел));
	  	 ИначеЕсли СтрОбмена= Неопределено Тогда
		  	  Возврат ХарСсылка;
		 КонецЕсли;
Иначе	
   ХарОбъект = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент(); 
КонецЕсли;   

	ХарОбъект.ОбменДанными.Загрузка = Истина;
	ХарОбъект.Наименование = Характеристика.Наименование; 
	ХарОбъект.КвоВЯщике = Характеристика.КвоВЯщике;
	ХарОбъект.Артикул = Характеристика.Артикул;
	ХарОбъект.АртикулБР = Характеристика.АртикулБР; 
	ХарОбъект.Описание = Характеристика.Описание; 
	ХарОбъект.Срок = Характеристика.Срок;
	ХарОбъект.Регистрация = Характеристика.Регистрация; 
	ХарОбъект.Сертификат = Характеристика.Сертификат;
	ХарОбъект.Вес = Характеристика.Вес;
	ХарОбъект.Объем = Характеристика.Объем;
	ХарОбъект.СвоиЦены = Характеристика.СвоиЦены;
	ХарОбъект.КФФЦены = Характеристика.КФФЦены;
	ХарОбъект.ЕдиницаИзмерения = ТМЦЕдиницы(Соединение, Характеристика.ТМЦЕдиница, Узел);
	ХарОбъект.ЕдиницаИзмеренияМин = ТМЦЕдиницы(Соединение,Характеристика.ТМЦЕдиница_Мин, Узел);
	ХарОбъект.ЕдиницаИзмеренияЯщик = ТМЦЕдиницы(Соединение,Характеристика.ТМЦЕдиница_Ящик, Узел);
	ХарОбъект.Владелец = ТМЦ(Соединение, Характеристика.Owner, Узел);
	ХарОбъект.НаименованиеПолное = Характеристика.Наименование;  
	ХарОбъект.ДатаАктуальности = ТекущаяДата(); 
	ХарОбъект.ОбменДанными.Загрузка =Истина;
	ХарОбъект.Записать();	
	
	Если Не ЕстьВРегистре Тогда
		Ссылка = НайтиПоНаименованиюХарактеристикиВладельца(Харобъект);       
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid , ТипПриемника, Узел));
	КонецЕсли;
	
	Если СтрОбмена= Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;                         
 		
	ТМЦСерияДопРеквизиты(Соединение, ХарОбъект, Характеристика, Узел);  
	Штрихкод(ХарОбъект.Ссылка, Характеристика);   
	ПолучитьФотоОбъект(Соединение, Характеристика, ХарОбъект.Ссылка, Узел);

	//ХарОбъект.обменДанными.Загрузка = ЛожЬ;
	//ХарОбъект.Записать();
	
	Возврат ХарОбъект.Ссылка;                                         

КонецФункции

Функция НайтиПоНаименованиюХарактеристикиВладельца(ХарОбъект)
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	ХарактеристикиНоменклатуры.Ссылка
