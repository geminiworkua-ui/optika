Функция Остаток (Соединение,ТМЦ, Серия, Склад, Узел) 
	Если Узел.ДатаПерехода = Дата(1,1,1) Тогда
		ДатаВыполнения = НачалоДня(ТекущаяДата());
	Иначе
	    ДатаВыполнения = НачалоДня(Узел.ДатаПерехода);
	КонецЕсли;	
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
 "ВЫБРАТЬ
|	ТоварыОстатки.Валюта КАК Валюта,
|	ТоварыОстатки.КвоОстаток КАК КвоОстаток,
|	ТоварыОстатки.СуммаОстаток КАК СуммаОстаток,
|	ТоварыОстатки.СуммаВалОстаток КАК СуммаВалОстаток
|ИЗ
|	РегистрНакопления.Товары.Остатки(
|			&Дата, Склад = &Склад ";

Если Не Серия = Неопределено Тогда	

Запрос.Текст = Запрос.Текст +"	И Серия = &Серия ";  
Запрос.УстановитьПараметр("Серия", Серия.Ссылка);  
Иначе Запрос.Текст = Запрос.Текст +"	И Серия = Значение(Справочник.ТМЦСерии.ПустаяСсылка) ";  
 
КонецЕсли;

Запрос.Текст = Запрос.Текст + " И ТМЦ = &ТМЦ ) КАК ТоварыОстатки ";

Запрос.УстановитьПараметр("Дата",  ДатаВыполнения);
Запрос.УстановитьПараметр("ТМЦ", ТМЦ);
Запрос.УстановитьПараметр("Склад", Склад);
Результат = Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	Возврат Результат;
КонецЕсли;	
КонецФункции	

Процедура Остатки(Соединение,Узел, СтрОбмена) 
	Запрос =Новый Запрос(
	"ВЫБРАТЬ
	|	ВводОстатков.Ссылка
	|ИЗ
	|	Документ.ВводОстатков КАК ВводОстатков
	|ГДЕ
	|	ВводОстатков.ТипОперации = ЗНАЧЕНИЕ(Перечисление.ТипыОперацийВводаОстатков.ОстаткиСобственныхТоваров)
	|	И НЕ ВводОстатков.ПометкаУдаления");
	
	Если Узел.ДатаПерехода = Дата(1,1,1) Тогда
		ДатаВыполнения = НачалоДня(ТекущаяДата());
	Иначе
		ДатаВыполнения = НачалоДня(Узел.ДатаПерехода);
	КонецЕсли;	
	
	Результат  = Запрос.Выполнить().Выбрать(); 
	Текущий =0;
	Всего = Результат.Количество();
	
	Пока Результат.Следующий() Цикл
		Докоб = Результат.Ссылка.ПолучитьОбъект();
		
		Если ДокОб = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДокОб.ПометкаУдаления =Истина;
		ДокОб.Товары.Очистить();
		Если ДокОб.Проведен Тогда 
			Для Каждого Движение Из ДокОб.Движения Цикл
				Движение.Очистить();
			КонецЦикла;
			
			ДокОб.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе
			ДокОб.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		Попытка
			ДокОб.Удалить();
		Исключение
		КОнецПопытки;
		Текущий = Текущий +1;		
		ПроцентВыполнения = (Текущий/Всего)*100;
		ПроцентВыполнения = Окр(ПроцентВыполнения,0);
		ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения, "Удаление документов " + " (" + строка(текущий) +" из "+ Строка(всего) +")");
	КОнецЦИкла;	
	
	
	
	Запрос = Соединение.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыОстатки.Валюта КАК Валюта,
	|	ТоварыОстатки.КвоОстаток КАК КвоОстаток,
	|	ТоварыОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ТоварыОстатки.СуммаВалОстаток КАК СуммаВалОстаток,
	|	ТоварыОстатки.ТМЦ КАК ТМЦ,
	|	ТоварыОстатки.ТМЦ.Наименование КАК ТМЦНаименование,
	|	ТоварыОстатки.Серия КАК ТМЦСерия,
	|	ТоварыОстатки.ТМЦ.Рубрикатор.Наименование КАК ТМЦРубрикаторНаименование,
	|	ТоварыОстатки.ТМЦ.ГруппаТМЦ.Наименование КАК ТМЦГруппаТМЦНаименование
	|ИЗ
	|	РегистрНакопления.Товары.Остатки(&Дата, Склад = &Склад) КАК ТоварыОстатки";
	
	СкладыОрг =ПолучитьСписокСкладов(Соединение);
	
	Для каждого Склад из СкладыОрг Цикл	
		
		СкладСсылка = Склады(Соединение, Склад.ссылка, Узел);	
		УО = ПолучитьДокументОстатков(Соединение, СкладСсылка,  ДатаВыполнения);
		Запрос.УстановитьПараметр("Дата",  ДатаВыполнения);
		Запрос.УстановитьПараметр("Склад", Склад.ссылка);
		Результат = Запрос.Выполнить().Выбрать(); 
		Текущий =0;
		Всего = Результат.Количество();
		Пока Результат.Следующий() Цикл    
			Текущий = Текущий +1;		
			ПроцентВыполнения = (Текущий/Всего)*100;
			ПроцентВыполнения = Окр(ПроцентВыполнения,0);
			ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,"Остатки склада " + СкладСсылка.Наименование+ " (" + строка(текущий) +" из "+ Строка(всего) +")");
			
			Если Результат.КвоОстаток <=0 Тогда
				Продолжить;
			КонецЕсли;    
			
			НовыйЭлемент = Ложь;   
			Если Результат.ТМЦ.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			
			мНоменклатура = Справочники.Номенклатура.НайтиПоНаименованию(Результат.ТМЦНаименование);
			Если Не мНоменклатура = Неопределено
				И ЗначениеЗаполнено(мНоменклатура)
				И мНоменклатура.Родитель.НеЗагружатьДиггер
				Тогда
				Продолжить;
			КонецЕсли;
			
			ГруппаНоменклатуры = Справочники.Номенклатура.НайтиПоНаименованию(Результат.ТМЦГруппаТМЦНаименование);
			Если Не ГруппаНоменклатуры = Неопределено
				И ЗначениеЗаполнено(ГруппаНоменклатуры)
				И НЕ ГруппаНоменклатуры.НеЗагружатьДиггер = NULL
				И НЕ ГруппаНоменклатуры.НеЗагружатьДиггер
				Тогда
				Продолжить;
			КонецЕсли;
			
			Номенклатура = ТМЦ(Соединение, Результат.ТМЦ, Узел);
			Если Номенклатура = Неопределено Тогда
				Продолжить;
			КонецЕсли;	       
			
			Если Номенклатура.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;	 
			
			Если Номенклатура.НеЗагружать Тогда
				Продолжить;
			КонецЕсли;	
			
			Если Не Номенклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
				Если Результат.ТМЦСерия.ПометкаУдаления Тогда 
					Продолжить;                 
				КонецЕсли;	
				Характеристика = ТМЦСерия(Соединение, Результат.ТМЦСерия, Узел); 
			Иначе
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			КонецЕсли; 
			
			Если УО.Товары.Количество()>=250 Тогда
				УО.ОбменДанными.Загрузка =Истина;
				УО.Записать(РежимЗаписидокумента.Запись);
				УО.ОбменДанными.Загрузка =Ложь;  
				
				Попытка	
					УО.Записать(РежимЗаписиДокумента.Проведение);
				Исключение      
					
				КонецПопытки;
				
				УО = ПолучитьДокументОстатков(Соединение, СкладСсылка,  ДатаВыполнения);
			КонецЕсли;
			
			Если Номенклатура.ВидНОменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("4.1. Контактна корекція")
				И НОменклатура.КвоВЯщике > 0
				Тогда
				Количество = Окр(Результат.КвоОстаток/НОменклатура.КвоВЯщике,0,РежимОкругления.Окр15как10);
				Остаток = Результат.КвоОстаток - (Количество * НОменклатура.КвоВЯщике);
				Если Количество > 0  Тогда
					СО =УО.Товары.Добавить();
					СО.Номенклатура 	= Номенклатура;
					СО.Характеристика  = Характеристика;
					ПараметрыАналитики = Новый Структура;
					ПараметрыАналитики.Вставить("Номенклатура", СО.Номенклатура);
					ПараметрыАналитики.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());				 
					ПараметрыАналитики.Вставить("Характеристика", СО.Характеристика);
					ПараметрыАналитики.Вставить("Склад",СкладСсылка);
					Ключ = РегистрыСведений.АналитикаУчетаНоменклатуры.ЗначениеКлючаАналитики(ПараметрыАналитики);			 
					СО.АналитикаУчетаНоменклатуры =  Ключ;		 
					СО.Упаковка = Номенклатура.ЕдиницаИзмерения;
					СО.СтавкаНДС = СО.Номенклатура.СтавкаНДС; 
					СО.Количество = Количество;
					СО.КоличествоУпаковок = Количество; 
					Остаток = Результат.КвоОстаток - (СО.Количество * НОменклатура.КвоВЯщике);
					СО.Цена  = НОменклатура.КвоВЯщике * (Результат.СуммаОстаток/Результат.КвоОстаток);
					СО.Сумма = СО.Цена * СО.Количество;
				КонецЕсли;
			Иначе
				СО =УО.Товары.Добавить();
				СО.Номенклатура 	= Номенклатура;
				СО.Характеристика  = Характеристика;
				ПараметрыАналитики = Новый Структура;
				ПараметрыАналитики.Вставить("Номенклатура", СО.Номенклатура);
				ПараметрыАналитики.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());				 
				ПараметрыАналитики.Вставить("Характеристика", СО.Характеристика);
				ПараметрыАналитики.Вставить("Склад",СкладСсылка);
				Ключ = РегистрыСведений.АналитикаУчетаНоменклатуры.ЗначениеКлючаАналитики(ПараметрыАналитики);			 
				СО.АналитикаУчетаНоменклатуры =  Ключ;		 
				СО.Упаковка = Номенклатура.ЕдиницаИзмерения;
				СО.СтавкаНДС = СО.Номенклатура.СтавкаНДС; 
				Остаток = 0; 
				СО.Количество = Результат.КвоОстаток;
				СО.КоличествоУпаковок = Результат.КвоОстаток; 
				СО.Цена  = (Результат.СуммаОстаток/Результат.КвоОстаток);
				СО.Сумма = СО.Цена * СО.Количество;
			КонецЕсли;
			
			Если Номенклатура.ВидНОменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("4.1. Контактна корекція")
				И Остаток > 0
				И НОменклатура.КвоВЯщике > 0
				Тогда
				НовСтр = УО.Товары.Добавить();
				НовСтр.Номенклатура 	= Номенклатура;
				НовСтр.Характеристика  = Характеристика;
				ПараметрыАналитики = Новый Структура;
				ПараметрыАналитики.Вставить("Номенклатура", НовСтр.Номенклатура);
				ПараметрыАналитики.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());				 
				ПараметрыАналитики.Вставить("Характеристика", НовСтр.Характеристика);
				ПараметрыАналитики.Вставить("Склад",СкладСсылка);
				Ключ = РегистрыСведений.АналитикаУчетаНоменклатуры.ЗначениеКлючаАналитики(ПараметрыАналитики);			 
				НовСтр.АналитикаУчетаНоменклатуры =  Ключ;		 
				НовСтр.Упаковка = Номенклатура.ЕдиницаИзмерения;
				НовСтр.СтавкаНДС = НовСтр.Номенклатура.СтавкаНДС; 
				НовСтр.КоличествоУпаковок = Остаток;
				НовСтр.Количество = Окр(Остаток/НОменклатура.КвоВЯщике, 3);
				НовСтр.Упаковка = НовСтр.НОменклатура.ОсновнаяУпаковка;
				НовСтр.Цена = Результат.СуммаОстаток/Результат.КвоОстаток;
				НовСтр.Сумма = НовСтр.Цена * Остаток; 	
			КонецЕсли;
			
		КонецЦикла;
		
		УО.Склад = СкладСсылка;
		УО.Дата = ДатаВыполнения; 
		УО.ОбменДанными.Загрузка = Истина;
		УО.Записать(РежимЗаписиДокумента.Запись);
		УО.ОбменДанными.Загрузка = Ложь;
		Попытка                           
			УО.ОбменДанными.Загрузка = Ложь;	
			УО.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			
		КонецПопытки;
 КонецЦикла;	
 
КонецПроцедуры	
