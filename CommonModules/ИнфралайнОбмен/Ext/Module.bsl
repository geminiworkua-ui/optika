Если Не ТолькоЦифры(Штрихкод) Тогда
	  Штрихкод ="";
КонецЕсли;
  
Если СокрЛП(Штрихкод) ="" Тогда 
	Возврат;
КонецЕсли;

Если ЕстьШтрихкод(Ссылка, Штрихкод) Тогда
	 //УдалитьШтрихкоды(Ссылка, Штрихкод);	
	 Возврат;
КонецЕсли;	
 
Менеджер = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();


Менеджер.Штрихкод = СокрЛП(Штрихкод);

Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Номенклатура") Тогда
	Менеджер.Номенклатура = Ссылка;
