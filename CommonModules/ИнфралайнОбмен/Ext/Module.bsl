Процедура ВыполнитьОбменНаСервере(ПараметрыЗагрузки = Неопределено, АдресРезультата = Неопределено) Экспорт
		
	Узел  =ПолучитьУзел();

	Соединение = ПодключитьБазу (Узел); 
	СтрОбмена = ПолучитьСтрОбмена(Узел);
	
	Если  Соединение = Неопределено Тогда 
		  Возврат;
	КонецЕсли;
	  
	Сообщить("Подключение установленно");  
	
	ТрасляцияДигер(Соединение, Узел, СтрОбмена);
	
КонецПроцедуры 

 //++Рудик оновлення тільки змінених елементів довідників ТМЦ і Контррагентів
 Процедура ВыполнитьОбменНаСервереРегламент(ПараметрыЗагрузки = Неопределено, АдресРезультата = Неопределено) Экспорт
		
	Узел  =ПолучитьУзел();
    УзелОб = Узел.ПолучитьОбъект();
	Узелоб.ТількиЗмінені=  Истина;
	УзелОб.Записать();

	Соединение = ПодключитьБазу (Узел); 
	СтрОбмена = ПолучитьСтрОбменаРегламент(Узел);
	
	Если  Соединение = Неопределено Тогда 
		  Возврат;
	КонецЕсли;
	
