Процедура ПолучитьСписокФото(Соединение, Узел)
Папка_Фото = сокрЛП(Узел.ПапкаФото);
Если Не Прав(Папка_Фото,1) ="\" Тогда
Папка_Фото =Папка_Фото + "\";  
КонецЕсли;  

М_Файлы = ПолучитьСписокФотоОбъекта("",Папка_Фото);

Для каждого ФайлКартинка из М_Файлы Цикл
	СведениеОфайле = РаботаСфайламиКлиентСервер.СведенияОФайле("ФайлСВерсией", ФайлКартинка); 
	УИД = СведениеОфайле.ИмяБезРасширения;  
	
	ТипПриемника ="ТМЦ";
	ТипИсточника ="Справочник.Номенклатура"; 

	НоменклатураСсылка =ПолучитьССылкуПОУИД(УИД,ТипПриемника,ТипИсточника, Узел);  
	
	Если  Не НоменклатураСсылка =Неопределено Тогда
				
	    ФайлСсылка = ПоместитьВыбранныеФайлыВХранилище(ФайлКартинка,НоменклатураСсылка, Узел);
		
		Если ФайлСсылка  = справочники.НоменклатураПрисоединенныеФайлы.ПустаяСсылка() Тогда 
			 Продолжить;
		КонецЕсли;
		 
		Если НоменклатураСсылка.ФайлКартинки.Пустая() Тогда
				  НоменклатураОбъект = НоменклатураСсылка.ПолучитьОбъект(); 
			      НоменклатураОбъект.ФайлКартинки =ФайлСсылка;
			      НоменклатураОбъект.Записать();
			
		КонецЕсли; 
	Иначе
		ТипПриемника ="ТМЦСерии";
		ТипИсточника ="Справочник.ХарактеристикиНоменклатуры"; 
		
		ХарактеристикаСсылка =ПолучитьССылкуПОУИД(УИД,ТипПриемника,ТипИсточника, Узел); 
		
		Если  ХарактеристикаСсылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;	    
		
		ФайлСсылка = ПоместитьВыбранныеФайлыВХранилище(ФайлКартинка,ХарактеристикаСсылка, Узел);
		
		Если ФайлСсылка  = справочники.ХарактеристикиНоменклатурыПрисоединенныеФайлы.ПустаяСсылка() Тогда
            Продолжить;
		КонецЕсли;	
		
	 	Если ХарактеристикаСсылка.ФайлКартинки = справочники.ХарактеристикиНоменклатурыПрисоединенныеФайлы.ПустаяСсылка() Тогда
				  ХарактеристикаОбъект = ХарактеристикаСсылка.ПолучитьОбъект(); 
			      ХарактеристикаОбъект.ФайлКартинки =ФайлСсылка;
			      ХарактеристикаОбъект.Записать();
		КонецЕсли; 
	
	КонецЕсли;	
КонецЦикла;	

КонецПроцедуры

Процедура ПолучитьФотоОбъект(Соединение, ОбъектКом, ОбъектСсылка, Узел)

Папка_Фото 	= Узел.ПапкаФото;

Если  Не ФайлСуществует(Папка_Фото) Тогда
	Папка_Фото = СокрЛП(Узел.ПапкаФото);   
КонецЕсли;

Если  Не ФайлСуществует(Папка_Фото) Тогда 
      Возврат;
КонецЕсли;
  
Если Не Прав(Папка_Фото,1) = "\" Тогда
	Папка_Фото = Папка_Фото +"\"; 
КонецЕсли;

Guid = ПолучитьGuid(Соединение,ОбъектКом);

Если Guid =Неопределено Тогда
	Возврат;
КонецЕсли;

СписокФайлов = ПолучитьСписокФотоОбъекта(Guid, Папка_Фото);

Если ОбъектСсылка = Неопределено Тогда
	Возврат;
КонецЕсли;	
МассивФайловОбъекта =новый Массив;

ПрисоединенныеФайлы.ПолучитьПрикрепленныеФайлыКОбъекту(ОбъектСсылка, МассивФайловОбъекта);

Если МассивФайловОбъекта.Количество() =0 Тогда
	Для каждого ФайлКартинки из СписокФайлов Цикл 
		ДобавитьФайл(ФайлКартинки, ОбъектСсылка)
	КонецЦикла;	
Иначе  
	МассивДобавления =Новый Массив;
	Для Каждого ФайлКартинки из СписокФайлов Цикл   
		Совпадение = Ложь;
		Для каждого Эл из МассивФайловОбъекта Цикл
        	Файл = Новый Файл(ФайлКартинки);
				Если Файл.Существует() Тогда
                    ПараметрыФайла = Новый Структура();
					ПараметрыФайла.Вставить("Автор", Пользователи.АвторизованныйПользователь());
					ПараметрыФайла.Вставить("ВладелецФайлов", ОбъектСсылка);
					ПараметрыФайла.Вставить("ИмяБезРасширения", Файл.ИмяБезРасширения);
    				ПараметрыФайла.Вставить("РасширениеБезТочки", СтрЗаменить(Файл.Расширение,".", ""));
					ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное");
					Если Эл.Расширение = ПараметрыФайла.РасширениеБезТочки и Эл.Наименование = ПараметрыФайла.ИмяБезРасширения Тогда
						Совпадение = Истина;  
						Прервать;
					КонецЕсли;	
				КонецЕсли;	
		КонецЦикла;	
		Если Не Совпадение Тогда
			 ДобавитьФайл(ФайлКартинки, ОбъектСсылка);
		КонецЕсли;	 
	КонецЦикла;
КонецЕсли;	
КонецПроцедуры

Процедура ДобавитьФайл(ИмяФайлаКартинки, ОбъектСсылка)
Файл = Новый Файл(ИмяФайлаКартинки);
Если Файл.Существует() Тогда 
	ДвоичныеДанные = Новый ДвоичныеДанные(Файл.ПолноеИмя);
	АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
    ПараметрыФайла = Новый Структура();
	ПараметрыФайла.Вставить("Автор", Пользователи.АвторизованныйПользователь());
	ПараметрыФайла.Вставить("ВладелецФайлов", ОбъектСсылка);
	ПараметрыФайла.Вставить("ИмяБезРасширения", Файл.ИмяБезРасширения);
    ПараметрыФайла.Вставить("РасширениеБезТочки", СтрЗаменить(Файл.Расширение,".", ""));
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное");
    ФайлСсылка = ПрисоединенныеФайлы.ДобавитьПрисоединенныйФайл(ПараметрыФайла, АдресФайла,"", ОбъектСсылка.НаименованиеПолное);

	Если ФайлСсылка = Неопределено Тогда		
		Возврат;
	КонецЕсли;	
		
	Если ПараметрыФайла.РасширениеБезТочки = "F1" или ПараметрыФайла.РасширениеБезТочки = "F001" или ПараметрыФайла.РасширениеБезТочки = "F01" Тогда
		   ОбъектОб = ОбъектСсылка.ПолучитьОбъект();   
		   ОбъектОб.ФайлКартинки = ФайлСсылка;
		   ОбъектОб.обменДанными.Загрузка = Истина;
		   ОбъектОб.Записать();
	КонецЕсли;
КонецЕсли;
	
	
КонецПроцедуры

Функция ПолучитьСписокФотоОбъекта(GUID, Папка_Фото);
ПрефиксФайла= GUID + "*.F";
М_Файлы= НайтиФайлы(Папка_Фото, ПрефиксФайла+ "*", Ложь);

ПрефиксФайлаСхемы= GUID +"*.S";  
S_Файлы= НайтиФайлы(Папка_Фото, ПрефиксФайлаСхемы+ "*", Ложь);    

Для каждого ФайлКартинка из S_Файлы Цикл
	М_Файлы.Добавить(ФайлКартинка);
КонецЦикла;

ПрефиксФайла360	= GUID + "*.3D";
D_Файлы= НайтиФайлы(Папка_Фото+ ПрефиксФайла360, "*.*", Ложь);    

Для каждого ФайлКартинка из D_Файлы Цикл
	М_Файлы.Добавить(ФайлКартинка);
КонецЦикла;

 Возврат М_Файлы; 
КонецФункции	

