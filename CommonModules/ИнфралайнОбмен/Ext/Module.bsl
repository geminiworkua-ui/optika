Иначе
	Менеджер.Номенклатура = Ссылка.Владелец;        
	Менеджер.Характеристика =Ссылка;
	Менеджер.Упаковка = Менеджер.Номенклатура.ЕдиницаИзмерения; 
КонецЕсли;     

Менеджер.Записать(Истина);

