			//НоваяЗапись.МаксимальноеКоличествоЗапаса = Запись.Кво_Макс;  
			НоваяЗапись.МинимальноеКоличествоЗапаса = МинНовый;
			НоваяЗапись.МаксимальноеКоличествоЗапаса = МаксНовый; 
			НоваяЗапись.Группировка = Справочники.ГруппировкиТоварныхОграничений.ПустаяСсылка();  
			//alx 30.04.2026 К 
			НоваяЗапись.УпаковкаЗаказа               = НоваяЗапись.Номенклатура.ЕдиницаИзмерения;
			НоваяЗапись.МетодОбеспеченияПотребностей = Перечисления.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаМинМакс;
			НоваяЗапись.ОбеспечениеЗаказовПриПоддержанииЗапаса = Перечисления.ОбеспечениеЗаказовПриПоддержанииЗапаса.НезависимоОтЗапасов;
		Иначе  
			НаборЗаписей = регистрыСведений.ТоварныеОграничения.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Номенклатура.Установить(ТМЦ);
			НаборЗаписей.Отбор.Характеристика.Установить(Серия);
			НаборЗаписей.Отбор.Склад.Установить(Склад); 
			НаборЗаписей.Записать();
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Склад = Склад;
			НоваяЗапись.Номенклатура = ТМЦ; 
			НоваяЗапись.Характеристика =  Серия;
			//НоваяЗапись.Период = ТекущаяДата();
			НоваяЗапись.УпаковкаЗаказа               = НоваяЗапись.Номенклатура.ЕдиницаИзмерения;   
			//alx 30.04.2026 Н 
			//НоваяЗапись.МинимальноеКоличествоЗапаса = Запись.Кво_Мин;
			//НоваяЗапись.МаксимальноеКоличествоЗапаса = Запись.Кво_Макс;
			НоваяЗапись.МинимальноеКоличествоЗапаса = МинНовый;
			НоваяЗапись.МаксимальноеКоличествоЗапаса = МаксНовый; 
			НоваяЗапись.Группировка = Справочники.ГруппировкиТоварныхОграничений.ПустаяСсылка();  
			//alx 30.04.2026 К 
			НоваяЗапись.МетодОбеспеченияПотребностей = Перечисления.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаМинМакс;
			НоваяЗапись.ОбеспечениеЗаказовПриПоддержанииЗапаса = Перечисления.ОбеспечениеЗаказовПриПоддержанииЗапаса.НезависимоОтЗапасов;
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;	
	
