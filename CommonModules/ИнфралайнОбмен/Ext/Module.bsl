Процедура УстановитьЗначениеПеревода(Соединение, Узел, СтрОбмена)
НовыйЭлемент =Ложь;	
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст =  
"ВЫБРАТЬ
 |	Перевод.ПНаименование КАК ПНаименование,
 |	Перевод.Реквизит КАК Реквизит,
 |	Перевод.Страна КАК Страна,
 |	Перевод.Владелец КАК Владелец
 |ИЗ
 |	Справочник.Перевод КАК Перевод
 |ГДЕ
 |	ТИПЗНАЧЕНИЯ(Перевод.Владелец) = ТИП(справочник.ТМЦ)";

Результат =  Запрос.Выполнить().Выгрузить();
Текущий =0;
Всего = Результат.Количество();
   
Для каждого Стр из Результат Цикл
	Текущий = Текущий +1;
	ПроцентВыполнения = (Текущий/Всего)*100;
	ПроцентВыполнения = Окр(ПроцентВыполнения,0);
	СтрокаПр = " ("+Строка(текущий) +" из "	+Строка(Всего)+")"; 	
	ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП("/Значение перевода ТМЦ/") +СтрокаПр); 
    Попытка
		Номенклатура = Тмц(Соединение, Стр.Владелец, Узел, СтрОбмена); 
	Исключение
	    Номенклатура = Неопределено;
		Продолжить;
	КонецПопытки;
	
	Если  Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
		Продолжить;
	КонецЕсли;

	Запись = РегистрыСведений.СвойстваОбъектов.СоздатьМенеджерЗаписи();
	Запись.Объект = Номенклатура;    
	
	Запись.Свойство = Справочники.СвойстваОбъектов.НайтиПоНаименованию(Стр.Реквизит +Стр.Страна.Кратко);
	Если Запись.Свойство = Справочники.СвойстваОбъектов.ПустаяСсылка() Тогда
		НовЭл = Справочники.СвойстваОбъектов.СоздатьЭлемент();
		НовЭл.Наименование = Стр.Реквизит+"_" +Стр.Страна.Кратко;
		НовЭл.Записать();
		Запись.Свойство = НовЭл.Ссылка;
	КонецЕсли;
	
	Запись.Значение = Стр.ПНаименование;
	Запись.Записать();				 	
КонецЦикла;

КонецПроцедуры	

