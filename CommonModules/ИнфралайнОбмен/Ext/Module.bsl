Функция ПолучитьИмяРеквизита(ИмяРеквизита) Экспорт 
    Запрос =Новый Запрос(
	 "ВЫБРАТЬ
	 |	СоответствеНазванияРеквизиту.Реквизит
	 |ИЗ
	 |	РегистрСведений.СоответствеНазванияРеквизиту КАК СоответствеНазванияРеквизиту
	 |ГДЕ
	 |	СоответствеНазванияРеквизиту.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование",ИмяРеквизита);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат СокрЛП(Результат.реквизит);
	КонецЕсли;	
	
КонецФункции

Функция НайтиПоНаименованию(Справочник, Значение, ТипЗнч = Неопределено)
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Метаданные.Справочники, Справочник) Тогда	
		Если ТипЗнч =Неопределено Тогда
			ВОзврат Неопределено;
		КонецЕсли;	
		ИмяСпр = ПолучитьИмяРеквизита(ТипЗнч);
		Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Метаданные.Справочники,ИмяСпр)	
			Тогда ВОзврат Неопределено;
		КонецЕсли;	
	КонецЕсли;	
		
Запрос = Новый Запрос( "ВЫБРАТЬ
 |	Спр.Ссылка
 |ИЗ
 |	Справочник."+ Справочник +" КАК Спр
 |ГДЕ
 |	Спр.Наименование = &Значение");
Запрос.УстановитьПараметр("Значение", СокрЛП(Значение));
Результат = Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	Возврат Результат.Ссылка;
КонецЕсли;
Элемент = Справочники[Справочник].СоздатьЭлемент();
Элемент.Наименование=  Значение;
Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Элемент, "Наименование_RU") Тогда
	Элемент.Наименование_ru = Значение;
КонецЕсли;
Элемент.ОбменДанными.Загрузка = Истина;
Элемент.Записать();
Возврат Элемент.Ссылка;
КонецФункции	

Функция ПолучитьЗначение(Спр, Значение, Соединение= Неопределено, ТипЗнч= Неопределено, Узел =Неопределено)   
	
Если ТипЗнч(Значение) = Тип("Дата") Тогда
	Возврат Значение;
КонецЕсли;

Если ТипЗнч(Значение) = Тип("Булево") Тогда
	Возврат Значение;
КонецЕсли;
	
Если ТипЗнч(Значение) = Тип("Строка") Тогда
	ЗначениеСтр = СокрЛП(Значение);
	Если Спр= "" Тогда
		Возврат ЗначениеСтр;
	КонецЕсли;	
КонецЕсли;

Если ТипЗнч(Значение) = Тип("Число") Тогда
	Если Спр="" Тогда
		Возврат Значение;
	КонецЕсли;	
	ЗначениеСтр = Формат(Значение,Формат(Значение,"ЧН=0; ЧВН=; ЧГ=0"));
КонецЕсли;

Если ТипЗнч(Значение) = Тип("СправочникСсылка.СвойстваОбъектовЗначения") Тогда
	 ЗначениеСтр = Значение.Наименование;
КонецЕсли;

Если ТипЗнч(Значение) = Тип("COMОбъект") Тогда
//Свойство = свойствоОбъекта(Соединение, Значение.свойство, Узел);
	Если СокрЛП(Спр)= "ДодатковийТовар" Тогда
		ЗначениеТМЦ = ТМЦ(Соединение, Значение.Значение, Узел);
		Возврат ЗначениеТМЦ;
	Иначе		
		ЗначениеСвойства = ЗначениеОбъекта(Соединение, Значение.Значение, Узел); 
		Если ТипЗнч(ЗначениеСвойства) = Тип("Строка") Тогда
			
			ЗначениеСтр = ЗначениеСвойства;
		ИначеЕсли ТипЗнч(ЗначениеСвойства) = Тип("Число") Тогда
		    ЗначениеСтр = Формат(ЗначениеСвойства,"ЧГ=0");
		ИначеЕсли ТипЗнч(ЗначениеСвойства) = Тип("Булево") Тогда
		    Возврат ЗначениеСвойства;
		ИначеЕсли ТипЗнч(ЗначениеСвойства) = Тип("Дата") Тогда	
	        Возврат ЗначениеСвойства;
		ИначеЕсли ТипЗнч(ЗначениеСвойства) = Тип("СправочникСсылка.СвойстваОбъектовЗначения") Тогда	
	         ЗначениеСтр = ЗначениеСвойства.Наименование; 
		ИначеЕсли ТипЗнч(ЗначениеСвойства) = Тип("COMОбъект") Тогда	
	         Возврат Неопределено;			 
		Иначе  Возврат ЗначениеСвойства;
		КонецЕсли;	 
			
		Если Спр="" Тогда
			Возврат ЗначениеСвойства;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Метаданные.Справочники,СокрЛП(Спр)) Тогда
			Возврат НайтиПоНаименованию(СокрЛП(Спр), ЗначениеСтр, Спр);  
		Иначе 
			СпрУ =УточнитьСправочникПоРеквизиту(Спр);
			
			Если Не СпрУ ="" и Не СпрУ = Неопределено Тогда
				Возврат НайтиПоНаименованию(СокрЛП(СпрУ), ЗначениеСтр, СпрУ);  
			КонецЕсли;
			
			Возврат  ЗначениеСвойства;
		КонецЕсли;	
	КонецЕсли;	
	
КонецЕсли;

Возврат НайтиПоНаименованию(СокрЛП(Спр), ЗначениеСтр, СокрЛП(ТипЗнч));


Если ТипЗнч(Значение) = Тип("Строка") Тогда 
	ЗначениеСтр = СокрЛП(Значение);  
	Если Значение = "" Тогда
		Возврат Справочники[Спр].ПустаяСсылка();
	КонецЕсли;

  	ЗначениеСправочника = НайтиПоНаименованию(Спр,ЗначениеСтр);
	Если ЗначениеСправочника = Неопределено Тогда
		ЗначениеОб =Справочники[Спр].СоздатьЭлемент();
		ЗначениеОб.Наименование =ЗначениеСтр; 
		ЗначениеОб.Наименование_ru = ЗначениеСтр;
		ЗначениеОб.Записать();
		Возврат ЗначениеОб.Ссылка;
	Иначе
		Возврат ЗначениеСправочника;
	КонецЕсли;	
ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда  
	Если Значение = 0 Тогда
		Возврат Справочники[Спр].ПустаяСсылка();
	КонецЕсли;
	ЗначениеСтр = Формат(Значение,"ЧН=0; ЧВН=; ЧГ=0");  
    ЗначениеСтр = СтрЗаменить(ЗначениеСтр, " ","");
	ЗначениеСправочника = НайтиПоНаименованию(Спр,ЗначениеСтр);
	
	Если ЗначениеСправочника =  Неопределено Тогда
		ЗначениеОб =Справочники[Спр].СоздатьЭлемент();
		ЗначениеОб.Наименование =ЗначениеСтр;
		ЗначениеОб.Наименование_ru =ЗначениеСтр;
		ЗначениеОб.Записать();
		Возврат ЗначениеОб.Ссылка;
	Иначе
		Возврат ЗначениеСправочника;
	КонецЕсли; 
ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда  
	Если Значение = Дата(1,1,1) Тогда
		Возврат Справочники[Спр].ПустаяСсылка();
	КонецЕсли;

    ЗначениеСтр = Формат(Значение,"ЧГ=0; ДФ=dd.MM.yyyy");
	ЗначениеСправочника = НайтиПоНаименованию(Спр,ЗначениеСтр);
    Если ЗначениеСправочника =  Неопределено Тогда
		ЗначениеОб =Справочники[Спр].СоздатьЭлемент();
		ЗначениеОб.Наименование =ЗначениеСтр;
		ЗначениеОб.Наименование_ru =ЗначениеСтр;
		ЗначениеОб.Записать();
		Возврат ЗначениеОб.Ссылка;
	Иначе
		Возврат ЗначениеСправочника;
	КонецЕсли; 	
ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
    ЗначениеСтр = Строка(Значение);
	ЗначениеСправочника = НайтиПоНаименованию(Спр, ЗначениеСтр);
    Если ЗначениеСправочника =  Неопределено Тогда
		ЗначениеОб =Справочники[Спр].СоздатьЭлемент();
		ЗначениеОб.Наименование =ЗначениеСтр;
		ЗначениеОб.Наименование_ru =ЗначениеСтр;
		ЗначениеОб.Записать();
		Возврат ЗначениеОб.Ссылка;
	Иначе
		Возврат ЗначениеСправочника;
	КонецЕсли; 	
	
	
Иначе
	Если Спр ="Номенклатура" или Спр ="ВидыНоменклатуры" Тогда
		ЗначениеСтр = СокрЛП(Значение.Наименование);
		Возврат Справочники[Спр].НайтиПоНаименованию(ЗначениеСтр);
	КОнецЕсли;
	
	Если Спр ="ПолМодели"  Тогда
		ЗначениеСтр = Врег(Лев(СокрЛП(Значение.Наименование),1));
		Если ЗначениеСтр = "Ж" Тогда Возврат Справочники.ПолМодели.Женский;
		ИначеЕсли ЗначениеСтр = "Д" Тогда Возврат Справочники.ПолМодели.Детский;	
		ИначеЕсли ЗначениеСтр = "Ч" Тогда Возврат Справочники.ПолМодели.Мужской;		
		Иначе Возврат Справочники.ПолМодели.Унисекс;
		КонецЕсли;	
	КОнецЕсли;  
	
	Если Спр ="КоллекцииНоменклатуры"  Тогда
		Если ТипЗнч(Значение) = Тип("Число") Тогда
						
				Если Значение = 0 Тогда
					Возврат Справочники.КоллекцииНоменклатуры.ПустаяСсылка();
				КонецЕсли;	
						
				ЗначениеСтрокой = Формат(Значение, "ЧГ=0");
						
				Если ЗначениеСтрокой ="" Тогда
					  Возврат Справочники.КоллекцииНоменклатуры.ПустаяСсылка();
				КонецЕсли;
						  
				Значение = НайтиПоНаименованию(Спр, ЗначениеСтрокой);
				
				Если Значение = неопределено  Тогда
					  Значен = Справочники.КоллекцииНоменклатуры.СоздатьЭлемент();
					  Значен.Наименование = ЗначениеСтрокой;
					  Значен.Записать();
					  Возврат Значен.Ссылка;
				Иначе
					  Возврат Значение;
				КонецЕсли;
		ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
				  ЗначениеСтрокой =  Лев(СокрЛП(Значение), 4);
				  Значение = НайтиПоНаименованию(Спр, ЗначениеСтрокой);
				  Если Значение = неопределено или Значение = Справочники.КоллекцииНоменклатуры.ПустаяСсылка() Тогда
					   Значен = Справочники.КоллекцииНоменклатуры.СоздатьЭлемент();
					   Значен.Наименование = ЗначениеСтрокой;
					   Значен.Записать();
				   	   Возврат  Значен.Ссылка;
				  Иначе
					   Возврат Значение;
				  КонецЕсли;
        ИначеЕсли ТипЗнч(Значение) = Тип("COMОбъект") Тогда
                  ЗначениеСтрокой =  Лев(СокрЛП(Значение.Description), 4);
				  Значение = НайтиПоНаименованию(Спр, ЗначениеСтрокой);
				  Если Значение = неопределено или Значение = Справочники.КоллекцииНоменклатуры.ПустаяСсылка() Тогда
					   Значен = Справочники.КоллекцииНоменклатуры.СоздатьЭлемент();
					   Значен.Наименование = ЗначениеСтрокой;
					   Значен.Записать();
				   	   Возврат  Значен.Ссылка;
				  Иначе
					   Возврат Значение;
				  КонецЕсли;

		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.КоллекцииНоменклатуры") Тогда
			Возврат Значение;	
		КонецЕсли;	

	КОнецЕсли;  

	 Если ТипЗнч(Значение) = Тип("COMОбъект") Тогда
	 	Если  Спр = "МатериалЛинз" или
			  Спр = "РежимНоски" или
        	  Спр = "ПропусканиеКислорода" или
			  Спр = "Влагоемкость" или 
			  Спр = "ТипМатериала" или
        	  Спр = "ТолщинаПоЦентру" или  
			  Спр = "_Диаметр" или   
			  Спр = "ЦветЛинз" или
			  Спр = "ЦветОправы" или
			  Спр = "МатериалОправы"  или
			  Спр = "ФормаОправы"  или
			  Спр = "ВидОправы" или
			  Спр = "Категория" или
			  Спр = "ВремяИспользованияПослеОткрытия" Или
			  Спр = "Тон"       Или
			  Спр = "МатериалКонтактныхЛинз"       Или  
			  Спр = "ТипРаствора" Или  
			  Спр = "МинимальноеВремяДезинфекции" Или
			  Спр = "Консервант"
		Тогда	  
		 ЗначениеСтр = СокрЛП(Значение.Наименование);  
		Иначе	 
			Попытка
				ЗначениеСтр = СокрЛП(Значение.ПНаименование);  
			Исключение   
				ЗначениеСтр = СокрЛП(Значение.Наименование);  
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
          ЗначениеСтр = СокрЛП(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
          ЗначениеСтр = Формат(Значение, "ЧГ=0");
	КонецЕсли;
	
	Попытка 
		
		ЗначениеСправочника = НайтиПоНаименованию(Спр, ЗначениеСтр);
      
			
		Если ЗначениеСправочника = Неопределено Тогда
			ЗначениеОб =Справочники[Спр].СоздатьЭлемент();
			ЗначениеОб.Наименование = ЗначениеСтр;
			ЗначениеОб.Наименование_ru = ПолучитьЗначениеПереводаТекста(Соединение, Значение, "ПНаименование");  
			Если ЗначениеОб.Наименование_ru ="" Тогда
				ЗначениеОб.Наименование_ru = ЗначениеСтр;
			КонецЕсли;	
			ЗначениеОб.Записать();
	        Возврат ЗначениеОб.Ссылка;
	     Иначе
			Возврат ЗначениеСправочника;
		КонецЕсли;
	Исключение
		
	КонецПопытки;
КонецЕсли;

