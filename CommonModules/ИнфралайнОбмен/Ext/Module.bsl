				КонецЕсли;	
		    Иначе
				МаркаОбъект = Справочники.Марки.СоздатьЭлемент(); 
				ЕстьВРегистре = Ложь;
			КонецЕсли;
		
	КонецЕсли;		
		
	Если СтрОбмена= Неопределено И Не МаркаСсылка =Неопределено Тогда
			Возврат МаркаСсылка; 
	КонецЕсли;	
Иначе
