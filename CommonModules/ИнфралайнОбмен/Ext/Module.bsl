		СО.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Конечная;
		СО.ВесЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0301");
		СО.ВысотаЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");
		СО.ГлубинаЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");
		СО.ШиринаЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");
		СО.ЛинейныеРазмерыПредставление = "0 х 0 х 0";
