				ЕстьВРегистре = Истина;
			КонецЕсли;
			
			Если СтрОбмена= Неопределено Тогда

				Возврат  МаркаОбъект.Ссылка;

			КонецЕсли;

	Иначе
    	МаркаОбъект = Справочники.Марки.СоздатьЭлемент(); 
    КонецЕсли;
КонецЕсли; 


	МаркаОбъект.Наименование = Марка.Наименование;  
