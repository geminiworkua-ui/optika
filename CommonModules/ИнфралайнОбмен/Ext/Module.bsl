Функция КатегорияЦен(Соединение, ВидЦен, Узел, СтрОбмена = Неопределено)
Объект = Узел;	
ТипПриемника ="КатегорииЦен";
ТипИсточника ="Справочник.ВидыЦен";	
Guid = ПолучитьGuid(Соединение,ВидЦен);  
Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
 Возврат Справочники.ВидыЦен.ПустаяСсылка();
КонецЕсли;

ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Объект.Ссылка) ;	
Если ЕстьВРегистре Тогда
	ВидЦенСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Объект.Ссылка); 
	Попытка
		ВидЦенОбъект = ВидЦенСсылка.ПолучитьОбъект(); 
	Исключение
		ВидЦенОбъект = Неопределено;
	КонецПопытки;

	Если ВидЦенОбъект = Неопределено Тогда    
	 УдалитьЗапись(ПолучитьСтруктуруЗаписи(ВидЦенСсылка, Guid , ТипПриемника, Объект.Ссылка));  
	 ЗаписьУдалена = Истина;
	 ВидЦенОбъект = Справочники.ВидыЦен.СоздатьЭлемент(); 	  
	 ЕстьВРегистре =Ложь;  
 	ИначеЕсли СтрОбмена = Неопределено Тогда 
	 Возврат ВидЦенСсылка;
	КонецЕсли;
Иначе	
   ВидЦенОбъект = Справочники.ВидыЦен.СоздатьЭлемент(); 
КонецЕсли;   
   
   
   ВидЦенОбъект.Наименование = ВидЦен.Наименование;
   ВидЦенОбъект.ВалютаЦены = Справочники.Валюты.НайтиПоКоду(ВидЦен.Валюта.Код);
   Если ВидЦенОбъект.ВалютаЦены = справочники.Валюты.ПустаяСсылка() Тогда
	   ВидЦенОбъект.ВалютаЦены = Константы.ВалютаРегламентированногоУчета.Получить();
   КонецЕсли;   
   ВидЦенОбъект.Идентификатор =СтрЗаменить(ВидЦен.Наименование, " ","");
   ВидЦенОбъект.БазовыйВидЦены = КатегорияЦен(Соединение, ВидЦен.БазоваяКатегория, Узел);
   
   Если ВидЦенОбъект.БазовыйВидЦены = Справочники.ВидыЦен.ПустаяСсылка() Тогда
	   ВидЦенОбъект.СпособЗаданияЦены = Перечисления.СпособыЗаданияЦен.Вручную;  
   Иначе   
       ВидЦенОбъект.СпособЗаданияЦены = Перечисления.СпособыЗаданияЦен.НаценкаНаДругойВидЦен;  
   Конецесли;  
   
   Попытка
   	ВидЦенОбъект.Записать();
   Исключение
	 Возврат Справочники.ВидыЦен.ПустаяСсылка();  
   КонецПопытки;	
 
	Если не ЕстьВРегистре тогда	
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ВидЦенОбъект.Ссылка, Guid , ТипПриемника, Объект.Ссылка));
	Конецесли; 

	Возврат ВидЦенОбъект.Ссылка; 
	
