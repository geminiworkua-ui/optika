	НомОбъект.КодМариона = Справочники.КодыМариона.НайтиПоНаименованию(ТМЦ.Код_Мориона);   
	НомОбъект.ТоварнаяКатегория = ?(НомОбъект.ТоварнаяКатегория = сПРАВОЧНИКИ.ТоварныеКатегории.ПустаяСсылка(), ТМЦКатегория(Соединение, ТМЦ.Категория, НомОбъект.ВидНоменклатуры, Узел ), НомОбъект.ТоварнаяКатегория);
	НомОбъект.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	
	
	
	// ++ Боков А.А. 06.10.2025 
