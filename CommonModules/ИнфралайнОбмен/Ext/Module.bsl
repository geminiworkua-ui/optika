#Область Подразделения

Процедура СписокПодразделения(Соединение, Узел, СтрОбмена)
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
 "ВЫБРАТЬ
 |	Подразделения.Ссылка КАК Ссылка
 |ИЗ
 |	Справочник.Подразделения КАК Подразделения
 |ГДЕ
 |	НЕ Подразделения.ПометкаУдаления";

Выборка = Запрос.Выполнить().выбрать(); 

Результат =Запрос.Выполнить().Выгрузить(); 
Текущий =0;
Всего = Результат.Количество();


Пока Выборка.следующий() Цикл  
		Текущий = Текущий +1;		
		ПроцентВыполнения = (Текущий/Всего)*100;
		ПроцентВыполнения = Окр(ПроцентВыполнения,0);
				
		ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП(Выборка.Ссылка.Наименование));
	

	Подразделения(Соединение,Выборка.Ссылка, Узел, СтрОбмена);
КонецЦикла	

КонецПроцедуры	

Функция Подразделения(Соединение, Подразделение, Узел, СтрОбмена= Неопределено)
Объект = Узел;	
ТипПриемника ="Подразделения";
ТипИсточника ="Справочник.СтруктураПредприятия";	
Если Подразделение = Null Тогда
	Возврат Справочники.СтруктураПредприятия.ПустаяСсылка();
КонецЕсли;	
Guid = ПолучитьGuid(Соединение,Подразделение);
Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Справочники.СтруктураПредприятия.ПустаяСсылка();
КонецЕсли;
  ЕстьВРегистре =      ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Объект.Ссылка);
Если  ЕстьВРегистре Тогда
	
	ПодразделениеСсылка =  ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Объект.Ссылка);
	
	Попытка
    	ПодразделениеОбъект = ПодразделениеСсылка.ПолучитьОбъект();
	Исключение
		ПодразделениеОбъект = Неопределено;
	КонецПопытки;
	
	Если ПодразделениеОбъект = Неопределено Тогда
		 ПодразделениеОбъект = Справочники.СтруктураПредприятия.СоздатьЭлемент();
		 ЕстьВРегистре = Ложь;
	 ИначеЕсли СтрОбмена= Неопределено Тогда
		 Возврат ПодразделениеСсылка;
	КонецЕсли;	 
Иначе	
	ПодразделениеОбъект = Справочники.СтруктураПредприятия.СоздатьЭлемент();
КонецЕсли;   
    ПодразделениеОбъект.Наименование = Подразделение.Наименование; 
	ПодразделениеОбъект.ПометкаУдаления = Подразделение.ПометкаУдаления;
	ПодразделениеОбъект.Записать(); 
	Если  Не ЕстьВРегистре Тогда
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ПодразделениеОбъект.Ссылка, Guid , ТипПриемника, Объект.Ссылка));
    КонецЕсли;
	Возврат  ПодразделениеОбъект.Ссылка;


КонецФункции

