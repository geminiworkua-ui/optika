	НомОбъект.НаименованиеПолное 	= ?(НомОбъект.НаименованиеПолное ="", ТМЦ.ПНаименование, НомОбъект.НаименованиеПолное) ;
	//НомОбъект.НаименованиеПолное_ru	= ПолучитьЗначениеПереводаТекста(Соединение, ТМЦ.ссылка,"ПНаименование") ;
	НомОбъект.описание 			 	= ?(НомОбъект.Описание ="",ТМЦ.Описание,НомОбъект.описание) ; 
	//НомОбъект.описание_ru 			= ПолучитьЗначениеПереводаТекста(Соединение, ТМЦ.ссылка,"Описание"); 
	НомОбъект.СезоннаяГруппа 	 	= ТМЦКоллекция(Соединение, ТМЦ.Рубрикатор, Узел);
	НомОбъект.ТипНоменклатуры 	 	= ТМЦТип(Соединение,ТМЦ.Вид, Узел); 
	НомОбъект.ВидНоменклатуры 	 	= ?(ВидНоменклатуры = Неопределено, ТМЦВид(Соединение, ТМЦ.Категория,НомОбъект.ТипНоменклатуры, Узел), ВидНоменклатуры);  
	
	Если НомОбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	
	НомОбъект.Страна 			 	= Страны(Соединение, ТМЦ.Страна, Узел);
	НомОбъект.КвоВЯщике			 	= ТМЦ.КвоВЯщике; 
	НомОбъект.АртикулБР 		 	= ТМЦ.АртикулБР; 
	//НомОбъект.WS_Name		 	 	= ?(НомОбъект.WS_Name= "",ТМЦ.СНаименование, НомОбъект.WS_Name); 
	
	СвойствоНабора = ПолучитьСвойствоНабора(Соединение, Тмц.Ссылка); 
	
	Если Не СвойствоНабора =Неопределено Тогда
		НомОбъект.СвойстваОбъектовНабор = ЗначениеНабора(Соединение,СвойствоНабора, Узел); 
	КонецЕсли;
	
	НомОбъект.ДатаАктуальности = ТекущаяДата();
	
	// ++ Боков А.А. 06.10.2025 
	Если Не ВидНоменклатуры = Неопределено
		И ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("4.1. Контактна корекція")
		ТОгда
		НомОбъект.ЕдиницаИзмерения	=  справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2110");
	Иначе		
