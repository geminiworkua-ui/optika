Функция СвойстваТМЦ(соединение, КомСсылка, Узел, СтрОбмена =Неопределено)
 ТипПриемника ="СвойстваОбъектов";
ТипИсточника ="Справочник.СвойстваОбъектов";	
   
Guid = ПолучитьGuid(Соединение,КомСсылка);
Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Неопределено;;
КонецЕсли;

Если КомСсылка.Isfolder Тогда
		Возврат Неопределено;	
КонецЕсли;   
ЕстьВРегистре= Ложь;

ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел);	

	Если ЕстьВРегистре Тогда
		СвСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);   		
		Если СвСсылка = Неопределено Тогда
			 СвОбъект = Неопределено;
             ЕстьВРегистре = Ложь; 
			 УдалитьЗапись(ПолучитьСтруктуруЗаписи(СвСсылка, Guid , ТипПриемника, Узел));    
		Иначе	 
		
			СвОбъект = СвСсылка.ПолучитьОбъект();   
			Если СвОбъект =Неопределено Тогда
				ЕстьВРегистре = Ложь; 
			 	УдалитьЗапись(ПолучитьСтруктуруЗаписи(СвСсылка, Guid , ТипПриемника, Узел));    
				СвОбъект = Справочники.СвойстваОбъектов.СоздатьЭлемент();
			Иначе
				Если СтрОбмена =Неопределено Тогда
					Возврат СвСсылка;
				КонецЕсли;
			КонецЕсли;	 
		КонецЕсли;	
	Иначе
		СвОбъект =Неопределено;  
		СвОбъект = Справочники.СвойстваОбъектов.СоздатьЭлемент();
		ЕстьВРегистре= Ложь;
	КонецЕсли;
	
	
	Если  СвОбъект.ПометкаУдаления Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	Если СвОбъект =Неопределено Тогда
		 СвОбъект = Справочники.СвойстваОбъектов.СоздатьЭлемент(); 
		 ЕстьВРегистре = Ложь; 
	КонецЕсли;	 
	
		
	СвОбъект.ОбменДанными.Загрузка = Истина;
	СвОбъект.Наименование = КомСсылка.Наименование;
	СвОбъект.GUID = GUID;
	СвОбъект.Записать();
	Если не ЕстьВРегистре Тогда	
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(СвОбъект.Ссылка, Guid , ТипПриемника, Узел));
	Конецесли;   
		
	Возврат СвОбъект.Ссылка; 
	
КонецФункции	

