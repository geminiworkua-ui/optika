Функция ПолучитьСписокТМЦ(Соединение, Узел, ВидНоменклатуры = Неопределено, ГруппаНом =Неопределено) Экспорт 
	Если Узел =Неопределено Тогда
		Узел = ПолучитьУзел();
	КонецЕсли;
	
	Если Соединение =Неопределено Тогда
		Соединение = ПодключитьБазу(Узел);
	КонецЕсли;	
	
	КомКатегории = Неопределено;
	
	Если Не ВидНоменклатуры = Неопределено Тогда 
		КомКатегории = ПолучитьКомОбъектПапкиТМЦ(ВидНоменклатуры, ГруппаНом, Соединение, Узел);
	КонецЕсли;
	//++РудикВВ
	Если Узел.ТількиЗмінені тогда
		Запрос = Соединение.NewObject("Запрос"); 
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТМЦИзменения.Узел КАК Узел,
		|	ТМЦИзменения.НомерСообщения КАК НомерСообщения,
		|	ТМЦИзменения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТМЦ.Изменения КАК ТМЦИзменения
		|ГДЕ
		|	НЕ ТМЦИзменения.Ссылка.ЭтоГруппа
		|	И не ТМЦИзменения.Ссылка.ПометкаУдаления";
		Если Не КомКатегории  = Неопределено Тогда
			Запрос.Текст = Запрос.Текст + "	И ТМЦИзменения.Ссылка.Родитель В ИЕРАРХИИ (&Категория)";           
			Запрос.установитьПараметр("Категория", КомКатегории);
		Иначе	
			Запрос.Текст = Запрос.Текст + "	И НЕ ТМЦИзменения.Ссылка.Родитель В ИЕРАРХИИ (Значение(Справочник.Тмц.ПустаяСсылка))";  
		КонецЕсли;
		
	иначе
		//--
	Запрос = Соединение.NewObject("Запрос"); 
	Запрос.Текст = 
	"ВЫБРАТЬ  
	|	ТМЦ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТМЦ КАК ТМЦ
	|ГДЕ
	|	НЕ ТМЦ.ЭтоГруппа
	|	И НЕ ТМЦ.ПометкаУдаления ";
	
	Если Не КомКатегории  = Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "	И ТМЦ.Родитель В ИЕРАРХИИ (&Категория)";           
		Запрос.установитьПараметр("Категория", КомКатегории);
	Иначе	
		Запрос.Текст = Запрос.Текст + "	И НЕ ТМЦ.Родитель В ИЕРАРХИИ (Значение(Справочник.Тмц.ПустаяСсылка))";  
	КонецЕсли;
	КонецЕсли;
	Возврат Запрос.Выполнить().Выгрузить()
	
КонецФункции

Функция ПолучитьКомОбъектПапкиТМЦ(ВидНоменклатуры, ГруппаНом,  Соединение, Узел) 
ТипПриемника ="ТМЦ";
ТипИсточника ="Справочник.Номенклатура"; 

Если ГруппаНом =Неопределено Тогда

	ГруппаНом = ПолучитьСсылкуКаталогаНоменклатуры(ВидНоменклатуры);

КонецЕсли;

GUID = ПолучитьGUIDПоСсылке(ГруппаНом,ТипПриемника, ТипИсточника,Узел);	  

Если Узел =Неопределено Тогда
	Узел =ПолучитьУзел();
КонецЕсли;

Если Соединение = Неопределено Тогда
	Соединение = ПодключитьБазу(Узел);
КонецЕсли;	
	
Если Не GUID= Неопределено Тогда
	Возврат Соединение.Справочники.ТМЦ.ПолучитьСсылку(Соединение.NewObject("УникальныйИдентификатор",GUID));
КонецЕсли; 

