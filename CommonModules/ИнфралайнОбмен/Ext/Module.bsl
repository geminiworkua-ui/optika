Функция ПолучитьСтрОбмена(Узел)
	
	СтрОбмена = Новый Структура;
	
	СтрОбмена.Вставить("Организации", Ложь);
	СтрОбмена.Вставить("Страны", Ложь);
	СтрОбмена.Вставить("КатегорииЦен", Ложь);
	СтрОбмена.Вставить("Склады", Ложь);    
	СтрОбмена.Вставить("Марки", Ложь);
	СтрОбмена.Вставить("Подразделения", Ложь);
	СтрОбмена.Вставить("Кассы", Ложь);
	СтрОбмена.Вставить("ТМЦ", Ложь); 
	СтрОбмена.Вставить("ВидыТМЦ", Ложь); 
	СтрОбмена.Вставить("Контрагенты", Ложь);	 
	СтрОбмена.Вставить("Остатки", Ложь);   
	СтрОбмена.Вставить("Цены", Ложь);
	СтрОбмена.Вставить("Файлы", Ложь);
	СтрОбмена.Вставить("ДопРеквизиты", Ложь);
	СтрОбмена.Вставить("ДопАртикулы", Ложь);
	СтрОбмена.Вставить("Штрихкоды", Ложь);
	СтрОбмена.Вставить("Резерв", Ложь); 
	СтрОбмена.Вставить("Узел", Узел);
	СтрОбмена.Вставить("Состав", Ложь);
	СтрОбмена.Вставить("БонусПрограмма", Ложь);
	СтрОбмена.Вставить("ОстаткиБонусов", Ложь);
	СтрОбмена.Вставить("КартыЛояльности", Ложь);
    СтрОбмена.Вставить("ДопРеквизитыКлиенты", Ложь); 
	СтрОбмена.Вставить("Упаковки", Ложь);
	СтрОбмена.Вставить("СвойстваНабора", Ложь);
	СтрОбмена.Вставить("СвойстваОбъекта", Ложь);
	СтрОбмена.Вставить("ЗначенияСвойств", Ложь); 
	СтрОбмена.Вставить("Сотрудники", Ложь);

	Для каждого Стр из Узел.ОбъектыОбмена Цикл 
		
		Если Не Стр.Выбран Тогда
				Продолжить;
		КонецЕсли;

		
		Если Стр.ОбъектОбмена = Перечисления.ОбъектыОбмена.Организации  
			Тогда СтрОбмена.организации 	= Стр.Выбран;
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Страны  
			Тогда	СтрОбмена.Страны   		= Стр.Выбран;
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.КатегорииЦен Тогда
			СтрОбмена.КатегорииЦен 	 		= Стр.Выбран;
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Склады Тогда
			 СтрОбмена.Склады 		 		= Стр.Выбран;	 			 
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Подразделения Тогда
			 СтрОбмена.Подразделения 		= Стр.Выбран;	 
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Кассы Тогда
			 СтрОбмена.Кассы 		 		= Стр.Выбран;
		 ИначеЕсли Стр.ОбъектОбмена  		= Перечисления.ОбъектыОбмена.ТМЦ Тогда  
			СтрОбмена.ТМЦ 			 		= Стр.Выбран;		
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Клиенты Тогда
			СтрОбмена.Контрагенты 	 		= Стр.Выбран;	 				 	
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Файлы Тогда
			СтрОбмена.Файлы 		 		= Стр.Выбран;	 				 	
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.ДопРеквизиты Тогда
			СтрОбмена.ДопРеквизиты 	 		= Стр.Выбран;	 				 		
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.ДопАртикулы Тогда			
			СтрОбмена.ДопАртикулы 	 		= Стр.Выбран;	 				 			
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Штрихкоды Тогда
			СтрОбмена.Штрихкоды 	 		= Стр.Выбран;
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Резерв Тогда
			СтрОбмена.Резерв 		 		= Стр.Выбран;		
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Остатки Тогда
			СтрОбмена.Остатки 		 		= Стр.Выбран;		
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Цены Тогда
			СтрОбмена.Цены 			 		= Стр.Выбран;			
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Состав Тогда
			СтрОбмена.Состав 		 		= Стр.Выбран;				
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.БонусныеСистемы Тогда
			СтрОбмена.БонусПрограмма 		= Стр.Выбран;					
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.ОстаткиБонусов Тогда
			СтрОбмена.ОстаткиБонусов 		= Стр.Выбран;	
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.КартыЛояльности Тогда
			СтрОбмена.КартыЛояльности 		= Стр.Выбран;			
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.ДопРеквизитыКлиенты Тогда
			СтрОбмена.ДопРеквизитыКлиенты 	= Стр.Выбран;				
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.ЕдиницыИзмерения Тогда
			СтрОбмена.Упаковки 				= Стр.Выбран;	
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.НаборыСвойств Тогда
			СтрОбмена.СвойстваНабора 		= Стр.Выбран;				
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.СвойстваОбъекта Тогда
			СтрОбмена.СвойстваОбъекта 		= Стр.Выбран;	
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.ЗначениеСвойства Тогда
			СтрОбмена.ЗначенияСвойств		= Стр.Выбран;
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Марки Тогда
			СтрОбмена.Марки					= Стр.Выбран;		
		// ++ Боков А.А. 11.08.2025 	
		ИначеЕсли	Стр.ОбъектОбмена 		= Перечисления.ОбъектыОбмена.Сотрудники Тогда
			СтрОбмена.Сотрудники			= Стр.Выбран;				
		// -- Боков А.А.	
			
		КонецЕсли;

	КонецЦикла;       
			
	Возврат СтрОбмена;	
 КонецФункции	


