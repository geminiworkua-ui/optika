Функция РеквизитСвойствоОбъкта(Наименование) 
Ссылка = Справочники.СвойстваОбъектов.НайтиПоНаименованию( СокрЛП(Наименование));
	Если Ссылка = Справочники.СвойстваОбъектов.ПустаяСсылка() Тогда

		НовЭл =Справочники.СвойстваОбъектов.СоздатьЭлемент();
		НовЭл.Наименование =  СокрЛП(Наименование);
		НовЭл.Записать();
		Ссылка = НовЭл.Ссылка;
	КонецЕсли;
	Возврат Ссылка;

