Функция ПолучитьСвойствоНабора(Соединение, Тмц);
   Родитель = Тмц;	 
   
   Пока Не ЭтоКорневаяПапка(Соединение, Родитель) Цикл
   		ПапкаНабора = Родитель.СвойстваОбъектовНабор; 
   		
		Если Не ЭтоКорневаяПапка(Соединение, ПапкаНабора) Тогда
			Возврат ПапкаНабора;
		КонецЕсли;
		Родитель = Родитель.Родитель;
	КонецЦикла;
	
