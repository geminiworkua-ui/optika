#Область Штрихкод
 
Процедура СписокШтрихкоды(Соединение, Узел, Категория= Неопределено, СтрОбмена= Неопределено)
 СписокТМЦ = ПолучитьСписокТМЦ(Соединение, Узел, Категория); 
 Текущий =0;
 Всего = СписокТМЦ.Количество();
 Для каждого ТМЦКом из СписокТМЦ Цикл 
   Текущий = Текущий +1;
   ПроцентВыполнения = (Текущий/Всего)*100;
   ПроцентВыполнения = Окр(ПроцентВыполнения,0);
   СтрокаПр = " ("+Строка(текущий) +" из "	+Строка(Всего)+")"; 	
			
   ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП("/Штрихкода/ " + ТМЦКом.Ссылка.Наименование) + СтрокаПр);

   НовыйЭлемент =Ложь;
   ТМЦСсылка = ТМЦ(Соединение, ТМЦКом.Ссылка, Узел); 
   
   Если ТМЦСсылка = Неопределено Тогда
	   Продолжить;
   КонецЕсли;
   
   Если ТМЦСсылка = Справочники.Номенклатура.ПустаяСсылка() Тогда
	   Продолжить;
   КонецЕсли;
   
   Штрихкод(ТМЦСсылка, ТМЦКом.Ссылка);
   
   Если ТМЦСсылка.ИспользованиеХарактеристик  = перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
	   Продолжить;
   КонецЕсли;	   

   СписокСерий = СписокСерий(Соединение, ТМЦКом.Ссылка);
	Для каждого СерияКом из СписокСерий Цикл
	   Серия = ТМЦСерия(Соединение, СерияКом.ссылка, Узел); 
		Если Серия = справочники.ХарактеристикиНоменклатуры.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;	
		Штрихкод(Серия, СерияКом.Ссылка);
	КонецЦикла;	  
	
 КонецЦикла;	 
КонецПроцедуры	

Функция ЕстьШтрихкод(Ссылка, Штрихкод)
Запрос = новый Запрос("ВЫБРАТЬ
                      |	ШтрихкодыНоменклатуры.Штрихкод
                      |ИЗ
                      |	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
                      |ГДЕ
                      |	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод
                      |	И ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура
                      |	И ШтрихкодыНоменклатуры.Характеристика = &Характеристика"); 	
Запрос.УстановитьПараметр("Штрихкод", СокрЛП(Штрихкод));

Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Номенклатура") Тогда 
	Запрос.УстановитьПараметр("Номенклатура", Ссылка);  
	Запрос.УстановитьПараметр("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
Иначе
	Запрос.УстановитьПараметр("Номенклатура", Ссылка.Владелец);  
	Запрос.УстановитьПараметр("Характеристика", Ссылка);
КонецЕсли;
	Результат =Запрос.Выполнить().Выбрать();
