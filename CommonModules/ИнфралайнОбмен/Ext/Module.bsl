Функция ДанныеНоменклатурыСайт(Соединение)
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
"ВЫБРАТЬ РАЗЛИЧНЫЕ
|	СвободныеЗначения.Объект КАК Объект,
|	ВЫБОР
|		КОГДА СвободныеЗначения.Настройка.Наименование = ""ОБРОБКА: Digger Обмін з сайтом Polaroid""
|			ТОГДА ""Polaroid""
|		ИНАЧЕ ""Luxor""
|	КОНЕЦ КАК Сайт,
|	СвободныеЗначения.Дополнение КАК Дополнение
|ИЗ
|	РегистрСведений.СвободныеЗначения КАК СвободныеЗначения
|ГДЕ
|	ТИПЗНАЧЕНИЯ(СвободныеЗначения.Объект) = ТИП(Справочник.ТМЦ)
|	И НЕ СвободныеЗначения.Дополнение = """"
|	И СвободныеЗначения.Настройка.Наименование ПОДОБНО ""ОБРОБКА: Digger Обмін з сайтом %""
|	И НЕ ТМЦ.ПометкаУдаления";

Возврат Запрос.Выполнить().Выгрузить()

