#Область Страны
Процедура СписокСтраны(Соединение, Узел, СтрОбмена)

Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 	
 "ВЫБРАТЬ
|	Страны.Ссылка КАК Ссылка
|ИЗ
|	Справочник.Страны КАК Страны
|ГДЕ
|	НЕ Страны.ПометкаУдаления";
Выборка = Запрос.Выполнить().выбрать();
Рез = Запрос.Выполнить().Выгрузить();
Всего = Рез.Количество();
Текущий = 0;
Пока Выборка.следующий() Цикл  
	Текущий = Текущий +1;		
	ПроцентВыполнения = (Текущий/Всего)*100;
	ПроцентВыполнения = Окр(ПроцентВыполнения,0);
				
	ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП(Выборка.Ссылка.Наименование));

	СтранаСсылка = Страны(Соединение, Выборка.Ссылка, Узел, СтрОбмена); 
КонецЦикла;
КонецПроцедуры	

Функция Страны(Соединение, Страна, Узел, СтрОбмена= Неопределено); 
