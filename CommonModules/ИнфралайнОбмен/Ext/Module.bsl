Функция БазоваяЕИ(Соединение, НоменклатураКом)
	
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 	
"ВЫБРАТЬ
    |	ТМЦЕдиницы.Ссылка КАК Ссылка
    |ИЗ
    |	Справочник.ТМЦЕдиницы КАК ТМЦЕдиницы
    |ГДЕ
    |	ТМЦЕдиницы.ТМЦЕдиница = ЗНАЧЕНИЕ(Справочник.ТМЦЕдиницы.ПустаяСсылка)
    |	И ТМЦЕдиницы.Владелец = &Владелец
	|	И НЕ ТМЦЕдиницы.ПометкаУдаления
	|	И Не  ТМЦЕдиницы.Наименование =""грн.""";
Запрос.УстановитьПараметр("Владелец", НоменклатураКом);
Результат  =Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
   Возврат Результат.Ссылка;
КонецЕсли;	
КонецФункции

Функция ПрочиеЕИ(Соединение, НоменклатураКом)
	
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 	
"ВЫБРАТЬ
    |	ТМЦЕдиницы.Ссылка КАК Ссылка
    |ИЗ
    |	Справочник.ТМЦЕдиницы КАК ТМЦЕдиницы
    |ГДЕ
    |	Не ТМЦЕдиницы.ТМЦЕдиница = ЗНАЧЕНИЕ(Справочник.ТМЦЕдиницы.ПустаяСсылка)
    |	И ТМЦЕдиницы.Владелец = &Владелец
	|	И НЕ ТМЦЕдиницы.ПометкаУдаления
	|	И Не  ТМЦЕдиницы.Наименование =""грн.""";
Запрос.УстановитьПараметр("Владелец", НоменклатураКом);
Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

