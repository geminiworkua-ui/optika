Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Справочники.Партнеры.ПустаяСсылка();
КонецЕсли;
  ЕстьВРегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел);
Если   ЕстьВРегистре Тогда
	ПартнерСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);  
	Попытка
	ПартнерОбъект = ПартнерСсылка.получитьОбъект();
	Исключение 
	ПартнерОбъект =Неопределено;
	УдалитьЗапись(ПолучитьСтруктуруЗаписи(ПартнерСсылка, Guid , ТипПриемника, Узел));

	КонецПопытки;	
	Если ПартнерОбъект = Неопределено Тогда
		ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
		ЕстьВРегистре = Ложь;                 
	КонецЕсли;	
	Если  СтрОбмена = Неопределено Тогда
		Возврат ПартнерСсылка;	
	ИначеЕсли  Не СтрОбмена.Контрагенты Тогда
		Возврат ПартнерСсылка;	
	КонецЕсли;	


Иначе	
	ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
КонецЕсли;   
   	ПартнерОбъект.Наименование = Контрагент.Наименование; 
	ПартнерОбъект.НаименованиеПолное = Контрагент.ПНаименование;
