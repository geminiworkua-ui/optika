Процедура СписокТМЦ(Соединение, Дата,  Узел, СтрОбмена, ВидНоменклатурыОграничения = Неопределено)  

	СписокГруппТМЦ(Соединение, Узел);	
	ВидыНоменклатуры = ПолучитьВидыТМЦ();
	Для каждого Вид из ВидыНоменклатуры Цикл  
		ВидНоменклатуры = Вид.ВидНоменклатуры;	
		//
		Если НЕ ВидНоменклатурыОграничения = Неопределено
			И НЕ ВидНоменклатурыОграничения = ВидНоменклатуры
			Тогда
			Продолжить;
		КонецЕсли;
		//
		
		ТМЦСписок = ПолучитьСписокТМЦ(Соединение, Узел, Вид.ВидНоменклатуры, Вид.Группа);
		Если ТМЦСписок =Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		Текущий =0;
		Всего = ТМЦСписок.Количество();
		Для Каждого ТМЦКом из ТМЦСписок Цикл
			Текущий = Текущий +1;
			ПроцентВыполнения = (Текущий/Всего)*100;
			ПроцентВыполнения = Окр(ПроцентВыполнения,0);
			СтрокаПр = " ("+Строка(текущий) +" из "	+Строка(Всего)+")"; 	
			
			ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП(ТМЦКом.Ссылка.Наименование) + СтрокаПр);
			
			ТМЦСсылка = ТМЦ(Соединение, ТМЦКом.Ссылка, Узел, ВидНоменклатуры, СТРОБМЕНА);
			
			Если ТМЦСсылка = Справочники.Номенклатура.ПустаяСсылка() Или ТМЦСсылка = Неопределено Тогда
				Продолжить; 
				//++РудикВВ
			иначе 
				попытка
					Соединение.ОбменDigger.УдалитьРегистрациюИзменений( ТМЦКом.Ссылка);	
				исключение
				конецпопытки;
				//
			КонецЕсли;    
			
			Если ВидНоменклатуры.ИспользованиеХарактеристик  = перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры 
				Тогда  ТМЦСерии(Соединение, ТМЦКом.ссылка, Узел, СтрОбмена);  
			КонецЕсли;
			
		КонецЦикла;
КонецЦикла; 
КонецПроцедуры

Процедура СписокУпаковки(Соединение, Категория = Неопределено, Узел)
 ТМЦСписок = ПолучитьСписокТМЦ(Соединение, Узел, Категория);

Текущий =0;
Всего = ТМЦСписок.Количество();
Для Каждого ТМЦКом из ТМЦСписок Цикл
   Текущий = Текущий +1;
   ПроцентВыполнения = (Текущий/Всего)*100;
   ПроцентВыполнения = Окр(ПроцентВыполнения,0);
   СтрокаПр = " ("+Строка(текущий) +" из "	+Строка(Всего)+")"; 	
			
   ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП(ТМЦКом.Ссылка.Наименование) + СтрокаПр);

   НовыйЭлемент =Ложь;
   ТМЦСсылка = ТМЦ(Соединение, ТМЦКом.Ссылка, Узел); 
   Если ТМЦСсылка = Неопределено Тогда    
	   Продолжить;
   КонецЕсли;	   
   НомОбъект = ТМЦСсылка.ПолучитьОбъект();
   Если НомОбъект = Неопределено Тогда
	   Продолжить;
   КонецЕсли;
   
   Если НомОбъект.ЭтоГруппа Тогда
	   Продолжить;
   КонецЕсли;
   
   ЕдиницаИзмерения = ТМЦЕдиницы(Соединение, БазоваяЕИ(Соединение, ТМЦКом.ссылка), Узел);
   Если ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка() Тогда
	   ЕдиницаИзмерения = ТМЦЕдиницы(Соединение, ТМЦКОМ.Ссылка.Единица, Узел); 
   КОнецЕсли;
   НомОбъект.ЕдиницаИзмерения =  ЕдиницаИзмерения;
  
   Прочие = ПрочиеЕИ(Соединение, ТМЦКом.Ссылка); 
	Если Не Прочие.Количество() =0 Тогда
		Итератор =0; 
		НомОбъект.ИспользоватьУпаковки = Истина;
		НомОбъект.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры;
		Для каждого Единица из Прочие Цикл   
			Упаковка =  НайтиСоздатьУпаковкуНоменклатуры(Соединение, НомОбъект.Ссылка, Единица, Узел);
			
			Если  Единица.ТМЦЕдиница =null Тогда	
					НомОбъект.ЕдиницаИзмеренияМин 		= Упаковка;  
					НомОбъект.ОсновнаяУпаковка			= Упаковка;    
					НомОбъект.ЕдиницаИзмеренияЦенник  	= Упаковка;
			Иначе	
					НомОбъект.ЕдиницаИзмеренияЯщик = Упаковка;	
			КонецЕсли;
			
		КонецЦикла;			
	Иначе
		//НомОбъект.НаборУпаковок = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;   
		НомОбъект.ЕдиницаИзмеренияМин =  ЕдиницаИзмерения;  
		НомОбъект.ЕдиницаИзмеренияЦенник  = ЕдиницаИзмерения;
	КОнецЕсли;	
    НомОбъект.Записать(); 
КонецЦикла;


