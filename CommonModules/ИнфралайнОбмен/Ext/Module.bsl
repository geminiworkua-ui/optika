Функция ОпределитьЗначениеРеквизита(Соединение, Реквизит, ТипЗнч, Значение, Узел, СтрОбмена =Неопределено) 
	Если ТипЗнч  = "Строка" Тогда
		 Возврат СокрЛП(Значение);   
	КонецЕсли;	 
		 
	Если ТипЗнч ="ХранилищеЗначения" Тогда    
			 Возврат Неопределено;
	КонецЕсли;	 
		 
	
	Если ТипЗнч = "Число" Тогда		 
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗнч  = "Дата" Тогда		 
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗнч = "Булево" Тогда		 
		Возврат Значение;
	КонецЕсли;
	
	Если Реквизит = "ЦветФона" Тогда
		Знч =  Значение.Получить();
	 	Возврат Знч;
	КонецЕсли;
	
	Если Реквизит = Справочники.СвойстваОбъектов.НайтиПоНаименованию("Вид") Тогда
		Вид =  ТМЦВид(Соединение, Значение, , Узел, Ложь);
	 	Возврат Вид;
	КонецЕсли;
	
	Если Реквизит = Справочники.СвойстваОбъектов.НайтиПоНаименованию("Единица") Тогда
		Единица = ТМЦЕдиницы(Соединение, Значение, Узел);
		Возврат Единица;
	КонецЕсли;	

    Если Реквизит = Справочники.СвойстваОбъектов.НайтиПоНаименованию("Марка") Тогда 
		Марка =  ТМЦМарки(Соединение, Значение, Узел, Ложь);
		Возврат Марка;
	КонецЕсли;	
	
	Если Реквизит = Справочники.СвойстваОбъектов.НайтиПоНаименованию("НалоговаяГруппа") Тогда 
		Возврат  СтавкиНДС(Значение);
	КонецЕсли;
	
	Если Реквизит =Справочники.СвойстваОбъектов.НайтиПоНаименованию("Категория") Тогда 
		Категория = ТМЦКатегория(Соединение, Значение, , Узел, Ложь);	
