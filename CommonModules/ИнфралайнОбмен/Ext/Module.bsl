	Сервер = СокрЛП(Узел.ПутьКбазе)= "";
    Возврат ?(Сервер,"Srvr="+Узел.SrvrAdr+";"+"Ref="+Узел.base+";Usr="+узел.Usr +";Pwd="+Узел.Pwd+";","File="+Узел.ПутьКбазе+";Usr="+узел.Usr +";Pwd="+Узел.Pwd+";" );
