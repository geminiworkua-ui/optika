|	ТМЦСоотношения.Код КАК Код,
|	ТМЦСоотношения.Наименование КАК Наименование,
|	ТМЦСоотношения.Контрагент КАК Контрагент,
|	ТМЦСоотношения.ТМЦСерия КАК ТМЦСерия,
|	ТМЦСоотношения.Сноска КАК Сноска,
|	ТМЦСоотношения.Владелец КАК Владелец
|ИЗ
|	Справочник.ТМЦСоотношения КАК ТМЦСоотношения
|ГДЕ
|	НЕ ТМЦСоотношения.ПометкаУдаления";  
Выборка = ЗапросСоот.Выполнить().выбрать();
ТипПриемника ="ТМЦСоотношения";
ТипИсточника ="Справочник.НоменклатураПоставщиков";	

Текущий = 0;
Всего = Выборка.Количество();

Пока Выборка.следующий() цикл 
   Guid = ПолучитьGuid(Соединение,Выборка.ссылка);  
   Текущий = Текущий +1;
   ПроцентВыполнения = (Текущий/Всего)*100;
   ПроцентВыполнения = Окр(ПроцентВыполнения,0);
   СтрокаПр = " ("+Строка(текущий) +" из "	+Строка(Всего)+")"; 	
   ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП("/Доп.артикула/ " + Выборка.Ссылка.Наименование) + СтрокаПр);

    Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
		Продолжить;
	КонецЕсли;
	
	НовыйЭлемент = Ложь;
   
	ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел);
	Владелец = Контрагенты(Соединение, Выборка.Контрагент, Узел);
	ТМЦСерия = ТМЦСерия(Соединение, Выборка.ТМЦСерия, Узел);
	Наименование =СокрЛП(Выборка.Наименование); 
		Если ТолькоЦифры(Наименование) Тогда
			ННаименование = СокрЛП(ТМЦСерия.Владелец.Наименование); 
			НАртикул = Наименование;
		Иначе
			ННаименование = Наименование; 
			НАртикул = "";
		КонецЕсли;

	Если ЕстьВРегистре Тогда
		НомСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел); 
		Попытка
			НомОбъект = НомСсылка.ПолучитьОбъект(); 
		Исключение
			НомОбъект = Неопределено;
		КонецПопытки;
		
		Если НомОбъект = Неопределено Тогда 
		 УдалитьЗапись(ПолучитьСтруктуруЗаписи(НомСсылка, Guid , ТипПриемника, Узел));	
		 НомОбъект = Справочники.НоменклатураПоставщиков.СоздатьЭлемент(); 	  
		 ЕстьВРегистре =Ложь; 
	 	ИначеЕсли СтрОбмена= Неопределено Тогда
		  Продолжить; 
	    КонецЕсли;
		
	Иначе    
	    СтруктураОтбора = Новый Структура;  

		СтруктураОтбора.Вставить("Номенклатура", ТМЦСерия.Владелец);
		СтруктураОтбора.Вставить("Характеристика", ТМЦСерия);
		СтруктураОтбора.Вставить("Владелец", Владелец);
		СтруктураОтбора.Вставить("Наименование", ННаименование);
		СтруктураОтбора.Вставить("Артикул", ННаименование);

		НомСсылка = ДанныеОтбораНоменклатуры(СтруктураОтбора);

		Если НомСсылка = Неопределено Тогда
			НомОбъект = Справочники.НоменклатураПоставщиков.СоздатьЭлемент(); 
		Иначе      
				 
			НомОбъект = НомСсылка.ПолучитьОбъект();
			Если НомОбъект = Неопределено Тогда
				НомОбъект = Справочники.НоменклатураПоставщиков.СоздатьЭлемент(); 
				ЕстьВРегистре =Ложь;
			КонецЕсли;
			
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НомОбъект.Ссылка, Guid , ТипПриемника, Узел));
			
			Продолжить;
            						
		КонецЕсли;	
	КонецЕсли;	
	 	
        НомОбъект.Артикул = НАртикул;
		НомОбъект.Владелец = Владелец;
		НомОбъект.Наименование = ННаименование;
		НомОбъект.Номенклатура = ТМЦСерия.Владелец;
		НомОбъект.Характеристика = ТМЦСерия;
		НомОбъект.Упаковка = ТМЦСерия.Владелец.ЕдиницаИзмерения;
		НомОбъект.Характеристика = ТМЦСерия;
		НомОбъект.Владелец = Владелец;		
		Попытка
		 НомОбъект.Записать();	                         
	 	Исключение 
		 Продолжить;
		КонецПопытки;
		
		Если не ЕстьВРегистре тогда	
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НомОбъект.Ссылка, Guid , ТипПриемника, Узел));
		Конецесли; 
КонецЦикла;
КонецПроцедуры	
 
Процедура СписокФайлы(Соединение, Узел, Категория =Неопределено, СтрОбмена =Неопределено)
 СписокТМЦ = ПолучитьСписокТМЦ(Соединение, Узел, Категория); 
 Текущий =0;
 Всего = СписокТМЦ.Количество();
 Для каждого ТМЦКом из СписокТМЦ Цикл 
   Текущий = Текущий +1;
   ПроцентВыполнения = (Текущий/Всего)*100;
   ПроцентВыполнения = Окр(ПроцентВыполнения,0);
   СтрокаПр = " ("+Строка(текущий) +" из "	+Строка(Всего)+")"; 	
			
   ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП("/Файлы/ " +ТМЦКом.Ссылка.Наименование) + СтрокаПр);

   НовыйЭлемент =Ложь;
   ТМЦСсылка = ТМЦ(Соединение, ТМЦКом.Ссылка, Узел); 
   
   Если ТМЦСсылка = Неопределено Тогда
	   Продолжить;
   КонецЕсли;   
   
   Если ТМЦСсылка.ЭтоГруппа Тогда
	   Продолжить;
   КонецЕсли;   
   
   Если ТМЦСсылка = Справочники.Номенклатура.ПустаяСсылка() Тогда
       Продолжить;
   КонецЕсли;   
   ПолучитьФотоОбъект(Соединение, ТМЦКом.ссылка, ТМЦСсылка, Узел);
   Если ТМЦСсылка.ИспользованиеХарактеристик  = перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
	   Продолжить;
   КонецЕсли;	   

   СписокСерий = СписокСерий(Соединение, ТМЦКом.Ссылка);
   
   Для каждого СерияКом из СписокСерий Цикл
   			Серия = ТМЦСерия(Соединение, СерияКом.ссылка, Узел); 
			Если Серия = справочники.ХарактеристикиНоменклатуры.ПустаяСсылка() Тогда
				Продолжить;
			КонецЕсли;	 
			     КонецЦикла;	  
		
 КонецЦикла;	 
	
	
КонецПроцедуры	

