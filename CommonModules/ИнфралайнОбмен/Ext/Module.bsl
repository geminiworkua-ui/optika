	КонецПопытки;

	Если Объект =Неопределено Тогда
		Объект = Справочники.КартыЛояльности.СоздатьЭлемент(); 
		ЕстьВРегистре = Ложь; 
		УдалитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid , ТипПриемника, Узел));  
		Ссылка = СоздатьНовуюКарту(Партнер, ВидКарт, Штрихкод);
        ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid , ТипПриемника, Узел));  
		Возврат Ссылка;
  	ИначеЕсли СтрОбмена= Неопределено Тогда
		Возврат Ссылка;   
	КонецЕсли;	 
Иначе	
	Запрос = Новый Запрос (
	"ВЫБРАТЬ
	|	КартыЛояльности.Ссылка
	|ИЗ
	|	Справочник.КартыЛояльности КАК КартыЛояльности
	|ГДЕ
	|	КартыЛояльности.Владелец = &Владелец
	|	И КартыЛояльности.Партнер = &Партнер");
	Запрос.УстановитьПараметр("Владелец",ВидКарт);
	Запрос.УстановитьПараметр("Партнер",Партнер);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.следующий()Тогда 
		Ссылка = ИзменитьКартУ(Результат.ссылка, Партнер, ВидКарт, Штрихкод);
	Иначе
		Ссылка = СоздатьНовуюКарту(Партнер, ВидКарт, Штрихкод);
	КонецЕсли;
	 ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid , ТипПриемника, Узел)); 
	 Возврат Ссылка; 
КонецЕсли;	 
