Функция СвойствоОбъекта(Соединение, СО, Узел, СтрОбмена= Неопределено)

ТипПриемника ="СвойстваОбъектов";
ТипИсточника ="Справочник.СвойстваОбъектов";
   
Guid = ПолучитьGuid(Соединение,СО);
Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Неопределено;
КонецЕсли;

ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел) ;	
Если ЕстьВРегистре Тогда
	СОссылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);   
	Если СОссылка = Неопределено Тогда
		УдалитьЗапись(ПолучитьСтруктуруЗаписи(СОСсылка, Guid , ТипПриемника, Узел));  
		ЕстьВРегистре = Ложь;            
		СООбъект = Неопределено;
	Иначе
		СООбъект = СОссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если СООбъект =Неопределено Тогда 
		УдалитьЗапись(ПолучитьСтруктуруЗаписи(СОСсылка, Guid , ТипПриемника, Узел));  
		СООбъект = Справочники.СвойстваОбъектов.СоздатьЭлемент(); 
		ЕстьВРегистре = Ложь;            
	Иначе
		Если СтрОбмена= Неопределено Тогда
			возврат СоСсылка;	
		КонецЕсли;	
	КонецЕсли;	
Иначе	
	СООбъект = Справочники.СвойстваОбъектов.СоздатьЭлемент(); 
	
КонецЕсли;   
    СООбъект.GUID 		  = GUID;
	СООбъект.Наименование = СО.Наименование; 
	СООбъект.Десятичные   = СО.Десятичные;
	СООбъект.Длина        = СО.Длина;
	СООбъект.ДляЦенника   = СО.ДляЦенника;    
	СООбъект.Кратко       = СО.Кратко;
	СООбъект.Номер        = СО.Номер;
	СООбъект.НуженПлюс    = СО.НуженПлюс;
	СООбъект.Суффикс      = СО.Суффикс;
	Если Не ТипЗнч(Со.Тип) = Тип("COMОбъект") Тогда
	СООбъект.Тип 	      = СО.Тип;
	КОнецЕсли;
	
	СООбъект.ОбменДанными.Загрузка = Истина;
	СООбъект.Записать();
		
	Если не ЕстьВРегистре тогда	
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(СООбъект.Ссылка, Guid , ТипПриемника, Узел));
	Конецесли; 
		
	 Возврат СООбъект.Ссылка;
	
КонецФункции	

Процедура СписокЗначений(Соединение, Узел, СтрОбмена =Неопределено)
СЗ = ПолучитьСписокЗначений(Соединение);
Для каждого СВ из СЗ Цикл
