Функция ТМЦ(Соединение, ТМЦ, Узел, ВидНоменклатуры =Неопределено, СтрОбмена =Неопределено)
	ТипПриемника ="ТМЦ";
	ТипИсточника ="Справочник.Номенклатура";	
	
	Guid = ПолучитьGuid(Соединение,ТМЦ.ссылка);
	Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Если ТМЦ.Isfolder Тогда
		Возврат РодительТМЦ(Соединение, ТМЦ, Узел);	
	КонецЕсли;   
	
	Если  ТМЦ.ПометкаУдаления Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел);	
	
	Если ЕстьВРегистре Тогда
		НомСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);   		
		Если НомСсылка = Неопределено Тогда
			НомОбъект = Неопределено;
			ЕстьВРегистре = Ложь; 
			УдалитьЗапись(ПолучитьСтруктуруЗаписи(НомСсылка, Guid , ТипПриемника, Узел));    
		Иначе	 
			
			НомОбъект = НомСсылка.ПолучитьОбъект();   
			Если Номобъект =Неопределено Тогда
				ЕстьВРегистре = Ложь; 
				УдалитьЗапись(ПолучитьСтруктуруЗаписи(НомСсылка, Guid , ТипПриемника, Узел));    
			Иначе
				Если СтрОбмена =Неопределено Тогда 
					Возврат НомСсылка;
				КонецЕсли;
			КонецЕсли;	 
		КонецЕсли;	
	Иначе
		НомОбъект =Неопределено;
	КонецЕсли;
	
	
	Если НомОбъект =Неопределено Тогда
		НомСсылка = НайтиТМЦ(ТМЦ.Наименование);
		Если НомСсылка =НЕопределено Тогда
			НомОбъект = Справочники.Номенклатура.СоздатьЭлемент(); 
			ЕстьВРегистре = Ложь; 
		Иначе	 
			НомОбъект = НомСсылка.ПолучитьОбъект(); 
			Если НомОбъект =НЕопределено Тогда
				НомОбъект = Справочники.Номенклатура.СоздатьЭлемент(); 
				ЕстьВРегистре = Ложь;
			Иначе	
				ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НомСсылка, Guid , ТипПриемника, Узел)); 
				Возврат НомСсылка;  
			КонецЕсли;
		КонецЕсли;		
	Иначе	
		Если СтрОбмена = Неопределено Тогда
			Возврат Номссылка;	
		КонецЕсли;	 
		Если НомСсылка =НЕопределено Тогда
			НомОбъект = Справочники.Номенклатура.СоздатьЭлемент(); 
			ЕстьВРегистре = Ложь; 
		Иначе	 
			НомОбъект = НомСсылка.ПолучитьОбъект(); 
			Если НомОбъект =НЕопределено Тогда
				НомОбъект = Справочники.Номенклатура.СоздатьЭлемент(); 
				ЕстьВРегистре = Ложь;
			Иначе
				Если Не ЕстьВРегистре Тогда 
					ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НомСсылка, Guid , ТипПриемника, Узел)); 
					ЕстьВРегистре = Истина;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;		
		
	КонецЕсли;
	
	
	//УстановитьЗначениеПеревода(Соединение, Узел , ТМЦ.ссылка, НомОбъект);   
	
	Если ТМЦ.Isfolder Тогда
		Возврат РодительТМЦ(Соединение, ТМЦ, Узел);	
	КонецЕсли;              
	
	Если НомОбъект.ЭтоГруппа Тогда 
		Если ЗначениеЗаполнено(НомОбъект.Ссылка) Тогда
			Возврат НомОбъект.Ссылка;	                
		Иначе	                                        
			Возврат РодительТМЦ(Соединение, ТМЦ, Узел);	
		КонецЕсли;	
	КонецЕсли;   
	
	// проверка на ОС и хозтовары	
	НомОбъект.Родитель	   			= ?(НомОбъект.Родитель = Справочники.Номенклатура.ПустаяСсылка(), РодительТМЦ(Соединение, ТМЦ.Родитель, Узел),НомОбъект.Родитель);
	Если НомОбъект.Родитель.НеЗагружатьДиггер Тогда
		Если ЗначениеЗаполнено(НомОбъект.Ссылка) Тогда 
			НомОбъект.ПометкаУдаления = Истина;
			НомОбъект.Записать();   
		КонецЕсли;
		Возврат Неопределено
	КонецЕсли;
	//
	
	УстановитьЗначениеПереводаОбъекта(Соединение, Узел, ТМЦ.Ссылка, НомОбъект);
	УстановитьСвободныеЗначенияОбъекта(Соединение, Узел , ТМЦ.ссылка, НомОбъект);
	ЗаполнениеДопРеквизитов(Соединение, Тмц.ссылка,  НомОбъект, Узел);
	//УстановитьСвойстваОбъекта(Соединение, узел, Тмц.ссылка, НомОбъект);
	ЗаполнитьЗначениеОбъекта(Соединение, узел, ТМЦ.ссылка, НомОбъект);
	
	НомОбъект.ОбменДанными.Загрузка = Истина; 
	
	Если НомОбъект.НеЗагружать Тогда
		НомОбъект.ПометкаУдаления = Истина; 
		Если ЗначениеЗаполнено(НомОбъект.Ссылка) Тогда 
			НомОбъект.Записать();   
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Если НомОбъект.ПометкаУдаления Тогда  
		Если ЗначениеЗаполнено(НомОбъект.Ссылка) Тогда 
			НомОбъект.Записать();   
		КонецЕсли;	
		Возврат Неопределено;
	КонецЕсли;
	
	//НомОбъект.Родитель	   			= ?(НомОбъект.Родитель = Справочники.Номенклатура.ПустаяСсылка(), РодительТМЦ(Соединение, ТМЦ.Родитель, Узел),НомОбъект.Родитель);
	НомОбъект.Наименование 			= ТМЦ.Наименование;
	НомОбъект.НаименованиеDigger	= ТМЦ.Наименование; 
	НомОбъект.Артикул 	   			= ТМЦ.Артикул;    
	НомОбъект.Марка        			= ТМЦМарки(Соединение, ТМЦ.марка, узел);
	НомОбъект.Производитель 	 	= Производители(Соединение, ТМЦ.Производитель, Узел);
