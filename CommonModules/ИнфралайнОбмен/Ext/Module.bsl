Процедура ДокументЦены(Соединение, Узел, СтрОбмена, ВидНоменклатурыОграничение = Неопределено)  экспорт
Если Узел.ДатаПерехода = Дата(1,1,1) Тогда	
ДатаВыполнения	= НачалоДня(ТекущаяДата());
Иначе
ДатаВыполнения	= НачалоДня(Узел.ДатаПерехода); 
КонецЕсли;
Запрос =Новый Запрос(
  "ВЫБРАТЬ
  |	УстановкаЦенНоменклатуры.Ссылка
  |ИЗ
  |	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
  |ГДЕ
  |	УстановкаЦенНоменклатуры.Проведен");

Результат  = Запрос.Выполнить().Выбрать();
Текущий =0;
Всего = Результат.Количество();
Пока Результат.Следующий() Цикл
	Докоб = Результат.Ссылка.ПолучитьОбъект();
	
	Если ДокОб = Неопределено Тогда
		Продолжить;
	КонецЕсли;
	
	ДокОб.ПометкаУдаления =Истина;
    ДокОб.Товары.Очистить();    
	
	Если ДокОб.Проведен Тогда 
		Для каждого Движение Из ДокОб.Движения Цикл
			Движение.Очистить();
		КонецЦикла;	
		ДокОб.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе           
		ДокОб.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Попытка
		ДокОб.Удалить();       
	Исключение
		
	КонецПопытки;
    Текущий = Текущий +1;		
	ПроцентВыполнения = (Текущий/Всего)*100;
	ПроцентВыполнения = Окр(ПроцентВыполнения,0);
			
	ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения, "Удаление документов " + " (" + строка(текущий) +" из "+ Строка(всего) +")");
				

КОнецЦИкла;	

Запрос = Соединение.NewObject("Запрос");      
Запрос.Текст = 
"ВЫБРАТЬ
|	ТМЦЦеныСрезПоследних.Цена КАК Цена,
|	ТМЦЦеныСрезПоследних.ТМЦ КАК ТМЦ
|ИЗ
|	РегистрСведений.ТМЦЦены.СрезПоследних(
|			&Дата,
|			Категория = &Категория
|				И ТМЦ.Родитель В ИЕРАРХИИ (&Вид)) КАК ТМЦЦеныСрезПоследних
|ГДЕ
|	ТМЦЦеныСрезПоследних.Цена > 0"; 

КатегорииЦен =  ПолучитьКатегорииЦен(Соединение);
ВидыТМЦ      =ПолучитьВидыТМЦ();   

Для Каждого Категория из КатегорииЦен Цикл  
		ВидЦены = КатегорияЦен(Соединение, Категория.ссылка, Узел);  
		
		Если Видцены.ПометкаУдаления тогда
			Продолжить;
		КонецЕсли;    
		
		УЦ = Неопределено;
		НоменклатураСХарактеристиками = Новый Массив;
		
		Для каждого Вид из ВидыТМЦ Цикл
			ВидНоменклатуры = Вид.ВидНоменклатуры;
			
			Если Не ВидНоменклатурыОграничение = Неопределено 
				И НЕ ВидНоменклатуры = ВидНоменклатурыОграничение 
				Тогда
				Продолжить;
			КонецЕсли;
			
			
			
			Если ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка() Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВидНоменклатуры.ПометкаУдаления Тогда
			  Продолжить;	
			КонецЕсли;
		  
			Если УЦ = Неопределено Тогда
				УЦ = ПолучитьДокументЦены(Соединение, Видцены , ДатаВыполнения, Узел, ВидНоменклатуры  );
			КонецЕсли;	

	 		 Запрос.УстановитьПараметр("Дата", ДатаВыполнения); 
			 Запрос.УстановитьПараметр("Категория", Категория.ссылка); 
			 КатегорияНом = ПолучитьКомОбъектПапкиТМЦ(ВидНоменклатуры,Вид.Группа, Соединение, Узел);
			 Запрос.УстановитьПараметр("Вид", КатегорияНом);  
			 Результат = Запрос.Выполнить().Выбрать();  
			 Текущий= 0; 
			 Всего = Результат.количество();  
	
			 
			 Пока Результат.Следующий()  Цикл 
				Текущий = Текущий +1;		
				ПроцентВыполнения = (Текущий/Всего)*100;
				ПроцентВыполнения = Окр(ПроцентВыполнения,0);
						
				ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения, "Цены " + ВидНоменклатуры.Наименование+ " (" + строка(текущий) +" из "+ Строка(всего) +")");
				
				Если Результат.ТМЦ.ПометкаУдаления Тогда
					Продолжить;
				КонецЕсли;
				
				Если Результат.ТМЦ.Этогруппа Тогда
					Продолжить;
				КонецЕсли;
		        	
				Если Результат.Цена<=0 Тогда
					Продолжить;
				КонецЕсли;
								
				Если Результат.ТМЦ = Null Тогда
					Продолжить;
				КонецЕсли;	
				
				Номенклатура = ТМЦ(Соединение, Результат.ТМЦ, Узел);
								
				Если Номенклатура =Неопределено Тогда
					Продолжить;
				КонецЕсли;	
				
				Если Номенклатура.ПометкаУдаления Тогда
					Продолжить;
				КОнецЕсли;  
				
				Если Номенклатура.ЭтоГруппа Тогда
					Продолжить;
				КОнецЕсли;
				
				Если Номенклатура.НеЗагружать Тогда
					Продолжить;
				КОнецЕсли;

				
				
				Если Номенклатура.ВидНоменклатуры.ИспользоватьХарактеристики 
					и Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры Тогда
					СтрЦены =Новый Структура;
					СтрЦены.Вставить("Номенклатура", Номенклатура);
					СтрЦены.Вставить("Цена", Результат.Цена);
					Если Не ЕстьЦенаВМассиве(НоменклатураСХарактеристиками, Номенклатура, Результат.Цена) Тогда
				    	НоменклатураСХарактеристиками.Добавить(СтрЦены);
					КонецЕсли;	
					Продолжить;
				КонецЕсли;    
                							
				СтрОтбора = Новый Структура;
				СтрОтбора.Вставить("Номенклатура",Номенклатура);
				
				РезультатП = УЦ.Товары.НайтиСтроки(СтрОтбора);
				
				Если Не РезультатП.Количество() =0 Тогда
					Продолжить;
				КонецЕсли;	
				
				Если ЕстьЦена(Номенклатура, ,ДатаВыполнения, ВидЦены) Тогда
					Продолжить;
				КонецЕсли;
				
				Если УЦ.Товары.Количество()>=100 Тогда
					УЦ.ОбменДанными.Загрузка =Истина;
					УЦ.Записать(РежимЗаписидокумента.Запись);
					УЦ.ОбменДанными.Загрузка =Ложь;  
			
					Попытка	
						УЦ.Записать(РежимЗаписиДокумента.Проведение);
					Исключение      
					
					КонецПопытки;

					Если Не УЦ.Проведен Тогда
						УЦ.Дата = УЦ.Дата-1;
						Попытка	
							УЦ.Записать(РежимЗаписиДокумента.Проведение);
						Исключение      
						
						КонецПопытки;
					КонецЕсли;	

					УЦ = ПолучитьДокументЦены(Соединение, Видцены , ДатаВыполнения, Узел, ВидНоменклатуры  );

				КонецЕсли;
				
				СТ = УЦ.Товары.Добавить();
				СТ.ВидЦены = ВидЦены;                             
						
				Ст.Номенклатура = Номенклатура;    
				
				
				// Введем логику установки цены на упаковку
				резАнализаЦен = АнализЗаполненияПараметровЦен(Номенклатура, ВидЦены);
				Если резАнализаЦен.ЭтоДляУпаковки Тогда
					ст.Упаковка =резАнализаЦен.Упаковка; 
					ст.Цена = Результат.Цена * резАнализаЦен.КоэфЦены;
				Иначе			
					Ст.Упаковка =Ст.Номенклатура.ЕдиницаИзмерения; 
					Ст.Цена = Результат.Цена; 
				КонецЕсли;
                				
				Ст.ЦенаИзмененаВручную = Истина
			КонецЦикла;
		КонецЦикла;
		
		Если УЦ = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Если Не УЦ.Товары.Количество()=0 и Не УЦ.Проведен Тогда
					УЦ.ОбменДанными.Загрузка =Истина;
					УЦ.Записать(РежимЗаписидокумента.Запись);
					УЦ.ОбменДанными.Загрузка =Ложь;  
			
					Попытка	
						УЦ.Записать(РежимЗаписиДокумента.Проведение);
					Исключение      
					
					КонецПопытки;

					Если Не УЦ.Проведен Тогда
						УЦ.Дата = УЦ.Дата-1;
						Попытка	
							УЦ.Записать(РежимЗаписиДокумента.Проведение);
						Исключение      
						
						КонецПопытки;
					КонецЕсли;	
          КонецЕсли;
		  
		  ТекущийН = 0;
		  УЦ = Неопределено;
		  
		  ЗапросХар = Новый Запрос(
			"ВЫБРАТЬ
			|	ХарактеристикиНоменклатуры.Ссылка
			|ИЗ
			|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
			|ГДЕ
			|	ХарактеристикиНоменклатуры.Владелец = &Владелец");
			
		  Для каждого Стр из  НоменклатураСХарактеристиками Цикл	 
				ВсегоН = НоменклатураСХарактеристиками.Количество();
				ТекущийН = ТекущийН +1;		
				ПроцентВыполненияН = (ТекущийН/ВсегоН)*100;
				ПроцентВыполненияН = Окр(ПроцентВыполнения,0);
						
				ДлительныеОперации.СообщитьПрогресс(ПроцентВыполненияН, "Цены " + " (" + строка(текущийН) +" из "+ Строка(всегоН) +")");
				
				Если УЦ = Неопределено Тогда
					УЦ = ПолучитьДокументЦены(Соединение, Видцены , ДатаВыполнения, Узел, ,Стр.Номенклатура);
				КонецЕсли;
				
				ЗапросХар.УстановитьПараметр("Владелец", Стр.Номенклатура); 
				
				Рез = ЗапросХар.Выполнить();
				
				Если Рез.Пустой() Тогда 
					Продолжить;
				КонецЕсли;
					
				РезХар = Рез.Выбрать();
				
				Пока РезХар.следующий()	Цикл	
					
					Если РезХар.Ссылка.ПометкаУдаления Тогда 
							Продолжить;
					КонецЕсли;	
					
					СтрОтбора = Новый Структура;
					СтрОтбора.Вставить("Номенклатура",Номенклатура);
		            СтрОтбора.Вставить("Характеристика",РезХар.Ссылка);
					Результат = УЦ.Товары.НайтиСтроки(СтрОтбора);
		
					Если Не Результат.Количество() =0 Тогда
						Продолжить;
					КонецЕсли;	
					
					Если ЕстьЦена(Номенклатура, РезХар.Ссылка, ДатаВыполнения, ВидЦены) Тогда
						Продолжить;
					КонецЕсли;
					
					Если УЦ.Товары.Количество()>=100 Тогда
						УЦ.ОбменДанными.Загрузка =Истина;
						УЦ.Записать(РежимЗаписидокумента.Запись);
						УЦ.ОбменДанными.Загрузка =Ложь;  
				
						Попытка	
							УЦ.Записать(РежимЗаписиДокумента.Проведение);
						Исключение      
						
						КонецПопытки;

						Если Не УЦ.Проведен Тогда
							УЦ.Дата = УЦ.Дата-1;
							Попытка	
								УЦ.Записать(РежимЗаписиДокумента.Проведение);
							Исключение      
							
							КонецПопытки;
						КонецЕсли;	

						УЦ = ПолучитьДокументЦены(Соединение, Видцены , ДатаВыполнения, Узел, ВидНоменклатуры  );

					КонецЕсли;
			
					
						СТ = УЦ.Товары.Добавить();
						СТ.ВидЦены = ВидЦены;                             
						
						Ст.Номенклатура = Стр.Номенклатура;    
						Ст.Характеристика = РезХар.Ссылка;    
						
						резАнализаЦен = АнализЗаполненияПараметровЦен(Стр.Номенклатура, ВидЦены);

						Если резАнализаЦен.ЭтоДляУпаковки Тогда
							ст.Упаковка =резАнализаЦен.Упаковка; 
							ст.Цена = Стр.Цена * резАнализаЦен.КоэфЦены;
						Иначе			
							Ст.Упаковка =Ст.Номенклатура.ЕдиницаИзмерения; 
							Ст.Цена = Стр.Цена; 
						КонецЕсли;
						
						//Ст.Упаковка =Ст.Номенклатура.ЕдиницаИзмерения; 
						//Ст.Цена = Стр.Цена;
						
						Ст.ЦенаИзмененаВручную = Истина;
				КонецЦикла; 
			КонецЦикла;		
			
			Если УЦ= НЕопределено Тогда	
				 Продолжить;
			КонецЕсли;
			 
			Если Не Уц.Товары.Количество() =0  и Не УЦ.Проведен Тогда
					УЦ.ОбменДанными.Загрузка =Истина;
					УЦ.Записать(РежимЗаписидокумента.Запись);
					УЦ.ОбменДанными.Загрузка =Ложь;  
					Попытка	
						УЦ.Записать(РежимЗаписиДокумента.Проведение);
					Исключение      
					КонецПопытки;
				
				
					Если Не УЦ.Проведен Тогда
						УЦ.Дата = УЦ.Дата-86400;
						Попытка	
							УЦ.Записать(РежимЗаписиДокумента.Проведение);
						Исключение      
						КонецПопытки; 
					КонецЕсли;	
					
					Если Не УЦ.Проведен Тогда
						УЦ.Дата = УЦ.Дата-(2*86400);
						Попытка	
							УЦ.Записать(РежимЗаписиДокумента.Проведение);
						Исключение      
						КонецПопытки; 
					КонецЕсли;	
					
					Если Не УЦ.Проведен Тогда
						УЦ.Дата = УЦ.Дата-(3*86400);
						Попытка	
							УЦ.Записать(РежимЗаписиДокумента.Проведение);
						Исключение      
						КонецПопытки; 
					КонецЕсли;	
					
					Если Не УЦ.Проведен Тогда
						УЦ.Дата = УЦ.Дата-(4*86400);
						Попытка	
							УЦ.Записать(РежимЗаписиДокумента.Проведение);
						Исключение      
						КонецПопытки; 
					КонецЕсли;	   
					
					Если Не УЦ.Проведен Тогда
						УЦ.Дата = УЦ.Дата-(5*86400);
						Попытка	
							УЦ.Записать(РежимЗаписиДокумента.Проведение);
						Исключение      
						КонецПопытки; 
					КонецЕсли;	

            КонецЕсли;
КонецЦикла;
КонецПроцедуры	  

Функция АнализЗаполненияПараметровЦен(Номенклатура, ВидЦены)
	
	рез = Новый структура("ЭтоДляУпаковки, КоэфЦены, Упаковка", Ложь, 1, Неопределено);

	Если НЕ Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("4.1. Контактна корекція") Тогда
		Возврат рез;
	КонецЕсли;
	
	//Запрос = Новый Запрос("ВЫБРАТЬ
	//                    |	УпаковкиЕдиницыИзмерения.Ссылка,
	//                    |	УпаковкиЕдиницыИзмерения.Числитель,
	//                    |	УпаковкиЕдиницыИзмерения.Знаменатель
	//                    |ИЗ
	//                    |	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	//                    |ГДЕ
	//                    |	НЕ УпаковкиЕдиницыИзмерения.ПометкаУдаления
	//                    |	И УпаковкиЕдиницыИзмерения.Владелец = &НОменклатура");
	//Запрос.УстановитьПараметр("НОменклатура", НОменклатура);
	//Выборка = Запрос.Выполнить().Выбрать();
	//Если Выборка.Следующий() Тогда
	
	
	Если ЗначениеЗаполнено(Номенклатура.ОсновнаяУпаковка) Тогда
	
		рез.ЭтоДляУпаковки = Истина;
		Если ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Роздрібна") Тогда
			рез.КоэфЦены = Номенклатура.КвоВЯщике;
	        рез.Упаковка = Номенклатура.ЕдиницаИзмерения;
		Иначе	
		    рез.КоэфЦены = 1; 
			рез.Упаковка = Номенклатура.ОсновнаяУпаковка; 
		КонецЕсли;                      		
	КонецЕсли;
	
	Возврат рез;
	
КонецФункции

	

Функция ЕстьЦена(Номенклатура, Характеристика, Дата, ВидЦены)
Запрос = Новый Запрос;
Запрос.Текст =
 "ВЫБРАТЬ
 |	ЦеныНоменклатурыСрезПоследних.Цена
 |ИЗ
 |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
 |			&Дата,
 |			ВидЦены = &ВидЦены 
 |				И Номенклатура = &Номенклатура ";
 Если Характеристика = Неопределено Тогда
	 Запрос.Текст = Запрос.Текст + ") КАК ЦеныНоменклатурыСрезПоследних";
 Иначе 
	Запрос.Текст = Запрос.Текст + "	И Характеристика = &Характеристика) КАК ЦеныНоменклатурыСрезПоследних";
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
КонецЕсли;

Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
Запрос.УстановитьПараметр("Дата", Дата+10);
Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
Результат = Запрос.Выполнить().Выбрать();
Возврат Результат.Следующий();
КонецФункции

Функция ЕстьЦенаВМассиве(Массив, Номенклатура, Цена)
	Для каждого стр из Массив Цикл
		Если Стр.Номенклатура = Номенклатура Тогда     
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;	
    Возврат Ложь;
КонецФункции	

