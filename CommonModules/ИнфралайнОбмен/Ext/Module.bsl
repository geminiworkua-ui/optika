Функция Менеджеры(Соединение, Менеджер, Узел, ИмяМенеджера)
	
Если Менеджер.Сотрудники Тогда
	ТипПриемника ="Пользователи";
	ТипИсточника ="Справочник.Пользователи";	
	//Павлів Стефанія Михайлівна 
	Guid = ПолучитьGuid(Соединение,Менеджер);
	Если СокрЛп(Guid)=""  или Guid ="00000000-0000-0000-0000-000000000000" Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	   ЕстьВРегистре =  ЕстьЗапись(Guid, ТипПриемника, ТипИсточника,  Узел);
	   Если ЕстьВРегистре Тогда
		   ПользовательСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника,  Узел); 
		   попытка
			   ПользовательОбъект = ПользовательСсылка.ПолучитьОбъект();
		   Исключение
			   ПользовательОбъект = Неопределено;	
		   КонецПопытки;
		   
		   
		   Если ПользовательОбъект = Неопределено	
			   Тогда
			   ПользовательОбъект = Справочники.Пользователи.НайтиПоНаименованию(Строка(Менеджер.Наименование));
		   КонецЕсли;
		   
		   Если ПользовательОбъект = Неопределено Тогда
			   ПользовательОбъект = Справочники.Пользователи.СоздатьЭлемент(); 
			   ЕстьВРегистре = Ложь;
		   КонецЕсли;	
	   Иначе	
		   Пользователь = Справочники.Пользователи.НайтиПоНаименованию(Строка(Менеджер.Наименование));
		   Если Не ЗначениеЗаполнено(Пользователь) Тогда
			   ПользовательОбъект = Справочники.Пользователи.СоздатьЭлемент(); 
		   Иначе    
			   ПользовательОбъект = Пользователь.ПолучитьОбъект(); 
		   КонецЕсли;	
		   ЕстьВРегистре = Ложь;
	   КонецЕсли;   
	    ПользовательОбъект.Наименование = Менеджер.Наименование;
		ПользовательОбъект.ФизическоеЛицо = Физлица(Соединение, Менеджер, ПолКлиента(Соединение,Менеджер.Пол),Менеджер.ДеньРождения,Менеджер.ЕДРПОУ, узел);
		ПользовательОбъект.ПометкаУдаления = Ложь;
		ПользовательОбъект.Записать();
		
		Если Не ЕстьВРегистре Тогда 
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ПользовательОбъект.Ссылка, Guid , ТипПриемника,  Узел));
		КонецЕсли;  
		
		Возврат ПользовательОбъект.Ссылка;
Иначе	
	ТипПриемника ="Контрагенты";
	ТипИсточника ="Справочник.Пользователи";	
	 
	Guid = ПолучитьGuid(Соединение,Менеджер);

	Если СокрЛп(Guid)="" или Guid= "00000000-0000-0000-0000-000000000000" Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
     ЕстьВРегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника,  Узел); 
	 Если ЕстьВРегистре Тогда
		 
		ПользовательСсылка =  ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника,  Узел);
		ПользовательОбъект =  ПользовательСсылка.ПолучитьОбъект();
		Если ПользовательОбъект = неопределено Тогда
			ПользовательОбъект = Справочники.Пользователи.СоздатьЭлемент();
            ЕстьВРегистре = Ложь;
		КонецЕсли;	 
	Иначе	
		ПользовательОбъект = Справочники.Пользователи.СоздатьЭлемент();
	КонецЕсли;   
	    ПользовательОбъект.Наименование = Менеджер.Наименование;
		ПользовательОбъект.ФизическоеЛицо = Физлица(Соединение, Менеджер, ПолКлиента(Соединение,Менеджер.Пол),Менеджер.ДеньРождения,Менеджер.ЕДРПОУ, Узел);
		
		ПользовательОбъект.Записать();
		 Если Не ЕстьВРегистре Тогда
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ПользовательОбъект.Ссылка, Guid , ТипПриемника,  Узел));
		КонецЕсли;
		
		Возврат ПользовательОбъект.Ссылка;
КонецЕсли;
	
