#Область Организации
Функция Организация(Соединение, Организация, Узел,СтрОбмена= Неопределено)
ТипПриемника ="Фирмы";
ТипИсточника ="Справочник.Организации";	
   
Guid = ПолучитьGuid(Соединение,Организация.ссылка);
Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Справочники.Организации.ПустаяСсылка();
КонецЕсли;

ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел) ;	
Если ЕстьВРегистре Тогда
	ОргСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);   
	Попытка
		ОргОбъект = ОргСсылка.ПолучитьОбъект();   
	Исключение
		ОргОбъект = Неопределено;		
	КонецПопытки;

	Если ОргОбъект =Неопределено Тогда
		ОргОбъект = Справочники.Организации.СоздатьЭлемент(); 
		ЕстьВРегистре = Ложь; 
		УдалитьЗапись(ПолучитьСтруктуруЗаписи(ОргСсылка, Guid , ТипПриемника, Узел));
  	ИначеЕсли СтрОбмена= Неопределено Тогда
		Возврат ОргСсылка;   
	КонецЕсли;	 
	
Иначе	
	ОргОбъект = Справочники.Организации.СоздатьЭлемент(); 
	//ОргОбъект.Код          = Организация.Код;
КонецЕсли;   
    ОргОбъект.Наименование = Организация.Наименование;
	ОргОбъект.НаименованиеПолное = Организация.Наименование;   
	ОргОбъект.НаименованиеСокращенное = Организация.Наименование;
	ОргОбъект.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	ОргОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
	Попытка
		ОргОбъект.Записать();
		Если не ЕстьВРегистре Тогда	
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ОргОбъект.Ссылка, Guid , ТипПриемника, Узел));
		Конецесли; 

		Возврат ОргОбъект.Ссылка;
	Исключение	
       	Возврат Справочники.Организации.ПустаяСсылка();
    КонецПопытки;
КонецФункции	
 
Функция СписокОрганизации(Соединение, Узел, СтрОбмена)
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
"ВЫБРАТЬ  
|	Фирмы.Ссылка КАК Ссылка
|ИЗ
|	Справочник.Фирмы КАК Фирмы
|ГДЕ
|	НЕ Фирмы.ЭтоГруппа
|	И НЕ Фирмы.ПометкаУдаления";

Результат = Запрос.Выполнить().Выгрузить();

Всего = Результат.Количество();

Текущий =0;

Для каждого Стр из Результат Цикл 
	Текущий = Текущий +1;		
	ПроцентВыполнения = (Текущий/Всего)*100;
	ПроцентВыполнения = Окр(ПроцентВыполнения,0);
				
	ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП(Стр.Ссылка.Наименование));

	Организация(Соединение, Стр.Ссылка, Узел,СтрОбмена);
КонецЦикла;	
КонецФункции

