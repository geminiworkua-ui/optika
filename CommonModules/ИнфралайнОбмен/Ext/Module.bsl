Функция НайтиСоздатьУпаковкуНоменклатуры(Соединение, Номенклатура, Единица, Узел, ВидНОменклатуры = Неопределено)
	
 // ++ Боков А.А. 06.10.2025 
	Если ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("4.1. Контактна корекція")
		Тогда
		ЕИ = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2009");
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	УпаковкиЕдиницыИзмерения.Ссылка
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|ГДЕ
		|	УпаковкиЕдиницыИзмерения.Владелец = &Владелец
		|	И УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения = &ЕдиницаИзмерения
		|	И УпаковкиЕдиницыИзмерения.Знаменатель = &Знаменатель");
		Запрос.УстановитьПараметр("Владелец", Номенклатура);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕИ);
		Запрос.УстановитьПараметр("Знаменатель", Единица.КФФ);
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Упаковка = Результат.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если Упаковка = Неопределено Тогда
			Упаковка = справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();  
		КонецЕсли;	
		
		Упаковка.ТипИзмеряемойВеличины = перечисления.ТипыИзмеряемыхВеличин.Упаковка;
		Упаковка.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Конечная;
		Упаковка.ВесЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0301");
		Упаковка.ВысотаЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");
		Упаковка.ГлубинаЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");
		Упаковка.ШиринаЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");
		Упаковка.ЛинейныеРазмерыПредставление = "0 х 0 х 0";
		Упаковка.ОбъемЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0134");	
		Упаковка.Наименование = Единица.Наименование +" (1/"+ Формат(Единица.КФФ,"ЧГ=0")+" "+"пак." +")";
		Упаковка.Владелец = Номенклатура;
		Упаковка.ЕдиницаИзмерения = ЕИ;
		Упаковка.Числитель = 1; 
		Упаковка.Знаменатель = Единица.КФФ;  
		Упаковка.Записать();
		
		Возврат Упаковка.Ссылка;  
	Иначе	
	// -- Боков А.А.	
		
		ЕИ = ТМЦЕдиницы(Соединение, Единица, Узел);
		Упаковка = Неопределено;	
		Если ЕИ = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка() Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если ЕИ.код = "2102" Тогда
			ЕИ = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2110");
		КонецЕсли;	
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	УпаковкиЕдиницыИзмерения.Ссылка
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|ГДЕ
		|	УпаковкиЕдиницыИзмерения.Владелец = &Владелец
		|	И УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения = &ЕдиницаИзмерения
		|	И УпаковкиЕдиницыИзмерения.Числитель = &Числитель");
		Запрос.УстановитьПараметр("Владелец", Номенклатура);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕИ);
		Запрос.УстановитьПараметр("Числитель", Единица.КФФ);
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Упаковка = Результат.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если Упаковка = Неопределено Тогда
			Упаковка = справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();  
		КонецЕсли;	
		
		Если ЕИ.код = "2110" ИЛИ ЕИ.код = "2075" Тогда 
			Упаковка.ТипИзмеряемойВеличины = перечисления.ТипыИзмеряемыхВеличин.Упаковка;
			Упаковка.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Конечная;
			Упаковка.ВесЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0301");
			Упаковка.ВысотаЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");
			Упаковка.ГлубинаЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");
			Упаковка.ШиринаЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");
			Упаковка.ЛинейныеРазмерыПредставление = "0 х 0 х 0";
			Упаковка.ОбъемЕдиницаИзмерения = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0134");	
		КонецЕсли;
		
		Упаковка.Наименование = Единица.Наименование +" ("+ Формат(Единица.КФФ,"ЧГ=0")+" "+?(Единица.ТМЦЕдиница = null,"шт.", Единица.ТМЦЕдиница.Наименование) +")";
		Упаковка.Владелец = Номенклатура;
		Упаковка.ЕдиницаИзмерения = ЕИ;
		Упаковка.Числитель = Единица.КФФ;
		Упаковка.Знаменатель = 1;  
		Упаковка.Записать();
		
		Возврат Упаковка.Ссылка;  
		
	КонецЕсли;
	
