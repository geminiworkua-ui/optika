			СО = НомОбъект.ОсновнаяУпаковка.ПолучитьОбъект();
		ИНаче
			СО = СПравочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент()
		КонецЕсли;
		
		//++РУдикВВ
		Если НомОбъект.Ссылка.Пустая() Тогда
		попытка	
			НомОбъект.Записать(); 
		исключение 
