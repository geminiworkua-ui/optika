Процедура УдалитьДопАртикулы() 
НаборЗаписей = РегистрыСведений.СоответствияОбъектовИнформационныхБаз.СоздатьНаборЗаписей();

Запрос = Новый Запрос(
"ВЫБРАТЬ
|	НоменклатураПоставщиков.Ссылка
|ИЗ
|	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков");
Результат = Запрос.Выполнить().Выбрать();  
Текущий = 0;
Всего = Результат.Количество();

Пока Результат.Следующий() Цикл 
	Текущий = Текущий +1;
    ПроцентВыполнения = (Текущий/Всего)*100;
    ПроцентВыполнения = Окр(ПроцентВыполнения,0);
    СтрокаПр = " ("+Строка(текущий) +" из "	+Строка(Всего)+")"; 	
    ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП("/Доп.артикула (Удаление)/ " + Результат.Ссылка.Наименование) + СтрокаПр);
  
	НаборЗаписей.Отбор.УникальныйИдентификаторИсточника.Установить(Результат.Ссылка);
	НаборЗаписей.Записать();
	Зн = Результат.Ссылка.ПолучитьОбъект();
	Зн.Удалить();
КонецЦикла;	
