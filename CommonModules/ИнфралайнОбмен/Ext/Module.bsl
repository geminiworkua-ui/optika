   ИначеЕсли  Наименование ="Японія" Тогда
	    ссылка = справочники.СтраныМира.НайтиПоКоду("392");
   Иначе Возврат справочники.СтраныМира.ПустаяСсылка();
   КонецЕсли;	
	
	Если не ЕстьВРегистре тогда	
	ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid , ТипПриемника, Объект.Ссылка));
