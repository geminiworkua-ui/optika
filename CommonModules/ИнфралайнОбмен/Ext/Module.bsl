Функция Цена(Соединение, Категория, ТМЦ, Серия, Узел)
Если Узел.ДатаПерехода = Дата(1,1,1) Тогда	
ДатаВыполнения	= НачалоДня(ТекущаяДата());
Иначе
ДатаВыполнения	= НачалоДня(Узел.ДатаПерехода); 
КонецЕсли;

Запрос = Соединение.NewObject("Запрос");      
Если Серия =неопределено Тогда
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТМЦЦеныСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ТМЦЦены.СрезПоследних(
	|			&Дата, Категория = &Категория
	|			И ТМЦ = &ТМЦ ) КАК ТМЦЦеныСрезПоследних"; 

	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Категория",Категория);
	Запрос.УстановитьПараметр("ТМЦ",ТМЦ);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий()  Тогда
		Возврат Результат.Цена;
		Иначе Возврат 0;
	КонецЕсли;

Иначе
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТМЦЦеныСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ТМЦСерияЦены.СрезПоследних(
	|			&Дата, Категория = &Категория и  ТМЦСерия = &ТМЦСерия) КАК ТМЦЦеныСрезПоследних"; 

	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Категория",Категория);
	Запрос.УстановитьПараметр("ТМЦСерия",Серия);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий()  Тогда
		Возврат Результат.Цена;
		Иначе Возврат 0;
	КонецЕсли;
КонецЕсли;
	
