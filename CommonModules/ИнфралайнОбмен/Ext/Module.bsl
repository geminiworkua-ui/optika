   ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП("/Состав серий/ " + ТМЦКом.Ссылка.Наименование) + СтрокаПр);

   НовыйЭлемент =Ложь;
   //ТМЦСсылка = ТМЦ(Соединение, ТМЦКом.Владелец, Узел); 
   //Если ТМЦСсылка = Справочники.Номенклатура.ПустаяСсылка() Тогда
