Функция ЗначениеНабора(Соединение, Набор, Узел, СтрОбмена= Неопределено)
ТипПриемника ="СвойстваОбъектовНаборы";
ТипИсточника ="Справочник.СвойстваОбъектовНаборы";	
   
Guid = ПолучитьGuid(Соединение,Набор);
Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" или Guid = Неопределено Тогда
	Возврат Справочники.СвойстваОбъектовНаборы.ПустаяСсылка();
КонецЕсли;

ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел) ;	
Если ЕстьВРегистре Тогда
	
	НОссылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);   
	
	Если НОссылка =Неопределено Тогда 
		ЕстьВРегистре = Ложь;
	    УдалитьЗапись(ПолучитьСтруктуруЗаписи(НОСсылка, Guid , ТипПриемника, Узел));
		НООбъект = Неопределено; 
    Иначе
		НООбъект = НОСсылка.ПолучитьОбъект();   
		Если НООбъект = Неопределено Тогда
		ЕстьВРегистре = Ложь;
	    УдалитьЗапись(ПолучитьСтруктуруЗаписи(НОСсылка, Guid , ТипПриемника, Узел));
		КонецЕсли;
	КонецЕсли;
	
	Если НООбъект =Неопределено Тогда  
		НООбъект = Справочники.СвойстваОбъектовНаборы.СоздатьЭлемент(); 
	Иначе
		Если СтрОбмена= Неопределено Тогда 
			Возврат НОСсылка;
		КонецЕсли;	
	КОнецЕсли;	
Иначе	
	НООбъект = Справочники.СвойстваОбъектовНаборы.СоздатьЭлемент(); 
	НООбъект.Код          = Набор.Код;
КонецЕсли;   
   
	НООбъект.Наименование = Набор.Наименование; 
	НООбъект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(Набор.Наименование);
	НООбъект.Состав.Очистить();
	Для каждого Стр из Набор.Состав Цикл
		СтрНов = НООбъект.Состав.Добавить();
		СтрНов.Свойство = СвойствоОбъекта(Соединение, Стр.Свойство, Узел);
	КонецЦикла;	
	
	
	НоОбъект.ОбменДанными.Загрузка = Истина;
	НоОбъект.Записать();
		
	Если не ЕстьВРегистре тогда	
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НООбъект.Ссылка, Guid , ТипПриемника, Узел));
	Конецесли; 
		
	Возврат НООбъект.Ссылка;

КонецФункции	

