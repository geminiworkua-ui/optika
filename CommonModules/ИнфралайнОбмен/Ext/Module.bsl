Функция СформироватьНаименованиеХарактеристики(ХарОбъект) Экспорт
 	Наименование = ""; 
	
	Наименование = Наименование +?(ХарОбъект._Радіус 	= Справочники._Радіус.ПустаяСсылка()	,	"", " Рад: " + СокрЛП(ХарОбъект._Радіус.Наименование)	 + " ");
   	Наименование = Наименование +?(ХарОбъект._Сфера 	= Справочники._Сфера.ПустаяСсылка()		,	"", " Сф.: " + СокрЛП(ХарОбъект._Сфера.Наименование) 	 + " ");
  	Наименование = Наименование +?(ХарОбъект._Циліндр 	= Справочники._Циліндр.ПустаяСсылка()	,	"", " Ц. : " + СокрЛП(ХарОбъект._Циліндр.Наименование)	 + " ");
  	Наименование = Наименование +?(ХарОбъект._Вісь	 	= Справочники._Вісь.ПустаяСсылка()		,	"", " В. : " + СокрЛП(ХарОбъект._Вісь.Наименование)		 + " ");
	Наименование = Наименование +?(ХарОбъект._Аддідація = Справочники._Аддідація.ПустаяСсылка()	, 	"", " Ад.: " + СокрЛП(ХарОбъект._Аддідація.Наименование) + " ");
	Наименование = Наименование +?(ХарОбъект._Диаметр 	= Справочники._Диаметр.ПустаяСсылка()	,	"", " Д. : " + СокрЛП(ХарОбъект._Диаметр.Наименование)	 + " ");
	Наименование = Наименование +?(ХарОбъект._Дегресія 	= Справочники._Дегресія.ПустаяСсылка()	, 	"", " Дег: " + СокрЛП(ХарОбъект._Дегресія.Наименование)  + " ");
	Наименование = Наименование +?(ХарОбъект._Цвет 		= Справочники._Цвет.ПустаяСсылка()		,	"", " Цв.: " + СокрЛП(ХарОбъект._Цвет.Наименование)      + " ");

	Возврат Наименование;

