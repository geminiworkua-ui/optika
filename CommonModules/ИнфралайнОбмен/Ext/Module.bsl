Функция ЗначениеОбъекта(соединение, ЗО, Узел, СтрОбмена= Неопределено)   
Объект = Узел;	
Если Не ТипЗнч(ЗО) =Тип("COMОбъект") Тогда
      Возврат ЗО;
КонецЕсли;
  
ТипПриемника ="СвойстваОбъектовЗначения";
ТипИсточника ="Справочник.СвойстваОбъектовЗначения";	

Guid = ПолучитьGuid(Соединение,ЗО);
Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Или Guid = Неопределено Тогда
	Возврат ЗО;
КонецЕсли;
ЕстьВРегистре = Ложь;
ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Объект.Ссылка) ;	
Если ЕстьВРегистре Тогда
	ЗОссылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Объект.Ссылка);   
	Если  ЗОссылка =Неопределено Тогда
	    ЗООбъект = Неопределено;
	    ЕстьВРегистре = Ложь;
        УдалитьЗапись(ПолучитьСтруктуруЗаписи(ЗОСсылка, Guid , ТипПриемника, Объект.Ссылка));
    Иначе
		ЗООбъект = ЗОСсылка.ПолучитьОбъект();   
		Если ЗООбъект = Неопределено Тогда   
			 ЕстьВРегистре = Ложь;
        	 УдалитьЗапись(ПолучитьСтруктуруЗаписи(ЗОСсылка, Guid , ТипПриемника, Объект.Ссылка));
		 Иначе
			 Если СтрОбмена =Неопределено Тогда
				 Возврат ЗОссылка;  
			 КонецЕсли;	 
		КонецЕсли;
		 
	КонецЕсли;

	Если ЗООбъект =Неопределено Тогда 
		УдалитьЗапись(ПолучитьСтруктуруЗаписи(ЗОСсылка, Guid , ТипПриемника, Объект.Ссылка));
		ЗООбъект = Справочники.СвойстваОбъектовЗначения.СоздатьЭлемент(); 
		ЕстьВРегистре = Ложь;   
	КонецЕсли;	  
	
Иначе	
	ЗООбъект = Справочники.СвойстваОбъектовЗначения.СоздатьЭлемент(); 
КонецЕсли;   
   
	ЗООбъект.Наименование = ЗО.Наименование; 
	Попытка
		Если Не ЗО.Идентификатор = Неопределено Тогда
		ЗООбъект.Идентификатор   = ЗО.Идентификатор;
		КонецЕсли;
	Исключение
		
	КонецПопытки;

	
	ЗоОбъект.ОбменДанными.Загрузка = Истина;
		
	ЗоОбъект.Записать(); 
	Если не ЕстьВРегистре тогда	
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ЗООбъект.Ссылка, Guid , ТипПриемника, Объект.Ссылка));
	Конецесли; 
	
	Возврат ЗООбъект.Ссылка;

КОнецФункции

