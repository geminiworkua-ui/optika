Функция ОпределитьТипКОМ(Соединение, ИсходныйТипСОМ)
Типы = Новый Массив;

НедоступныйТип    = "<Недоступно по СОМ>";
МетаданныеСОМ    = Соединение.Метаданные();

Для Каждого Тип Из ИсходныйТипСОМ.Типы() Цикл
    
    МетаТип = МетаданныеСОМ.НайтиПоТипу(Тип);
    
    Если МетаТип = Неопределено Тогда // Это не документ, справочник и т.д.
        // Строковое представление на случай, если не получится определить Тип
        ТипСтрокой = Соединение.String(Тип);
        Если ПустаяСтрока(ТипСтрокой) Тогда
            ТипСтрокой = Неопределено;
        КонецЕсли;
        // Пробуем определить через XML
        Тип = XMLТипЗнч(ИсходныйТипСОМ.ПривестиЗначение());
        Если Тип <> Неопределено Тогда
            Тип = ИзXMLТипа(Тип);
        КонецЕсли;
        // Строковое представление пригодилось
        Если Тип = Неопределено Тогда
            Тип = ТипСтрокой;
        КонецЕсли;
        Если Тип = Неопределено Тогда
            Тип = НедоступныйТип;
        КонецЕсли;
    Иначе
        Тип = МетаТип.ПолноеИмя();
    КонецЕсли;
    
    Если Тип <> Неопределено И Типы.Найти(Тип) = Неопределено Тогда
        Типы.Добавить(Тип);
    КонецЕсли;
    
КонецЦикла;

Результат = СтрСоединить(Типы, ", ");
	
Возврат Результат;

