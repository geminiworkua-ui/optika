Функция БонуснаяПрограмма(Соединение, comОбъект, Узел, СтрОбмена= Неопределено)
ТипПриемника ="ДисконтныеСхемы";
ТипИсточника ="Справочник.БонусныеПрограммыЛояльности";
Guid = ПолучитьGuid(Соединение,comОбъект);
Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Справочники.БонусныеПрограммыЛояльности.ПустаяСсылка();
КонецЕсли;

ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел) ;	
Если ЕстьВРегистре Тогда
	Ссылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);   
	Попытка
		Объект = Ссылка.ПолучитьОбъект();   
	Исключение
		Объект = Неопределено;		
	КонецПопытки;

	Если Объект =Неопределено Тогда
		Объект = Справочники.БонусныеПрограммыЛояльности.СоздатьЭлемент(); 
		ЕстьВРегистре = Ложь; 
		УдалитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid , ТипПриемника, Узел));
  	ИначеЕсли СтрОбмена= Неопределено Тогда
		Возврат Ссылка;   
	КонецЕсли;	 
	
Иначе	
	Объект = Справочники.БонусныеПрограммыЛояльности.СоздатьЭлемент(); 
	
КонецЕсли;   
    Объект.Наименование = comОбъект.Наименование; 
	Объект.КурсКонвертацииБонусовВВалюту 	 = 1;
	Объект.МаксимальныйПроцентОплатыБонусами = 50;
	Объект.ВалютаКонвертацииБонусов 		 = Константы.ВалютаРегламентированногоУчета.Получить();
	Объект.НеНачислятьБаллыПриОплатеБонусами = Истина;
	Попытка
		Объект.Записать();
		Если не ЕстьВРегистре Тогда	
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Объект.Ссылка, Guid , ТипПриемника, Узел));
		Конецесли; 

		Возврат Объект.Ссылка;
	Исключение	
       	Возврат Справочники.БонусныеПрограммыЛояльности.ПустаяСсылка();
    КонецПопытки;


