Процедура ОстаткиСклада(Соединение, Склад, ТМЦ, ТМЦСсылка, Серия, СерияСсылка, УО, Узел) 
	Объект = Узел;
	СкладСсылка = Склады(Соединение, Склад.ссылка, Узел);
	Запрос = Соединение.NewObject("Запрос");
	Запрос.Текст = 
	 "ВЫБРАТЬ
	|	ТоварыОстатки.ТМЦ КАК ТМЦ,   
	|	ТоварыОстатки.Серия КАК Серия,
	|	ТоварыОстатки.КвоОстаток КАК КвоОстаток,
	|	ТоварыОстатки.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.Товары.Остатки(
	|			&Дата,
	|	Склад = &Склад 
	|	и ТМЦ = &ТМЦ ";
	Если Не Серия = Неопределено Тогда
		Запрос.Текст = 	Запрос.Текст +"   и Серия =&Серия ";
		Запрос.УстановитьПараметр("Серия", Серия.Ссылка); 
	Иначе
		Запрос.Текст = 	Запрос.Текст +"   и Серия =Значение(Справочник.ТМЦСерии.ПустаяСсылка) ";
	КОнецЕсли;		                       
	Запрос.Текст = 	Запрос.Текст +
	"  ) КАК ТоварыОстатки
	|	Где ТоварыОстатки.КвоОстаток >0 ";
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(объект.ДатаПерехода));
	Запрос.УстановитьПараметр("ТМЦ", ТМЦ);
	Запрос.УстановитьПараметр("Склад", Склад);
	Результат = Запрос.Выполнить().Выбрать(); 
	Пока Результат.Следующий() Цикл   
		 
		 Строка = УО.Товары.Добавить();		 
		 Строка.Номенклатура = ТМЦСсылка;
		 Строка.Характеристика = СерияСсылка;
         ПараметрыАналитики =Новый Структура;
		 ПараметрыАналитики.Вставить("Номенклатура", Строка.Номенклатура);
		 ПараметрыАналитики.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());				 
		 ПараметрыАналитики.Вставить("Характеристика", Строка.Характеристика);
		 ПараметрыАналитики.Вставить("Склад",СкладСсылка);
         Ключ = РегистрыСведений.АналитикаУчетаНоменклатуры.ЗначениеКлючаАналитики(ПараметрыАналитики);			 
		 Строка.АналитикаУчетаНоменклатуры =  Ключ;		 
		 Строка.Количество = Результат.КвоОстаток;
		 Строка.КоличествоУпаковок = Результат.КвоОстаток;  
		 Строка.Цена  = Результат.СуммаОстаток/Результат.КвоОстаток;
		 Строка.Сумма = Результат.СуммаОстаток;
		 Строка.СтавкаНДС = Строка.Номенклатура.СтавкаНДС;
	КонецЦикла;	 
	    		 
КонецПроцедуры

