			НомОбъект.ЕдиницаИзмерения  = БазоваяЕИ(Соединение, Тмц.Ссылка);
		КонецЕсли;
		
		Если НомОбъект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка() Тогда 
			НомОбъект.ЕдиницаИзмерения  =Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2009");
		КонецЕсли;   
	Конецесли;
	
	Если НомОбъект.КвоВЯщике > 0 
