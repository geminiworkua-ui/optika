Функция НайтиГруппу(Соединение, Родитель, Узел)
           
Если ЭтоКорневаяПапка(Соединение, Родитель) Тогда
	Возврат справочники.Номенклатура.ПустаяСсылка(); 
КонецЕсли;	
МассивИерархии = Новый Массив;     
Папка = Родитель.Родитель; 
СсылкаНаПапкуРодителя = РодительТМЦ(Соединение, Папка, Узел); 

//Пока Не ЭтоКорневаяПапка(Соединение, Папка) Цикл
//	МассивИерархии.Добавить(Папка.Наименование);
//	Папка = Папка.Родитель;
//КонецЦикла;

Запрос =Новый Запрос(
 "ВЫБРАТЬ
 |	Номенклатура.Ссылка
 |ИЗ
 |	Справочник.Номенклатура КАК Номенклатура
 |ГДЕ
 |	Номенклатура.ЭтоГруппа
 |	И (Номенклатура.НаименованиеDigger = &НаименованиеDigger
 |			ИЛИ Номенклатура.Наименование = &НаименованиеDigger)
 |	И НЕ Номенклатура.ПометкаУдаления
 |	И Номенклатура.Родитель = &Родитель");                       
Запрос.УстановитьПараметр("НаименованиеDigger", Родитель.Наименование);
Запрос.УстановитьПараметр("Родитель", СсылкаНаПапкуРодителя);
Результат = Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	Возврат Результат.Ссылка;
КонецЕсли;	
КонецФункции	

Функция ЭтоКорневаяПапка(Соединение, Родитель)
Guid = ПолучитьGuid(Соединение,Родитель);
Возврат  сокрЛП(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000";
КонецФункции

Функция РодительТМЦ(Соединение, Родитель, Узел, СтрОбмена =Неопределено)
	
ТипПриемника ="ТМЦ";
ТипИсточника ="Справочник.Номенклатура";	

Если ЭтоКорневаяПапка(Соединение, Родитель) Тогда
	Возврат справочники.Номенклатура.ПустаяСсылка()
КонецЕсли;	

Guid = ПолучитьGuid(Соединение,Родитель);

ЕстьВРегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел);

Если ЕстьВРегистре Тогда 
	ГруппаСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);  
	Если ГруппаСсылка =Неопределено Тогда
		 Группа = Неопределено;
	Иначе	 
		  Группа = ГруппаСсылка.ПолучитьОбъект();
	КонецЕсли;
		
	Если Группа = Неопределено Тогда 
		УдалитьЗапись(ПолучитьСтруктуруЗаписи(ГруппаСсылка, Guid , ТипПриемника, Узел)); 
		ГруппаСсылка = НайтиГруппу(Соединение, Родитель, Узел);
	
		Если Не ГруппаСсылка = Неопределено Тогда
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ГруппаСсылка, Guid , ТипПриемника, Узел));
			Возврат ГруппаСсылка;
		КонецЕсли;               
	
		Группа = справочники.Номенклатура.СоздатьГруппу();
        ЕстьВРегистре = Ложь;
	ИначеЕсли СтрОбмена = Неопределено  Тогда
		Возврат  ГруппаСсылка;
	КонецЕсли;	
Иначе
	ГруппаСсылка = НайтиГруппу(Соединение, Родитель, Узел);
	
	Если Не ГруппаСсылка = Неопределено Тогда
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ГруппаСсылка, Guid , ТипПриемника, Узел));
		Возврат ГруппаСсылка;
	КонецЕсли;               
	
	Группа = справочники.Номенклатура.СоздатьГруппу();
	
КонецЕсли;

	Группа.Наименование = Родитель.Наименование; 
	Группа.НаименованиеDigger = Родитель.Наименование;
	Если СокрЛП(Родитель.Родитель.Наименование) ="" Тогда
	Группа.Родитель =Справочники.Номенклатура.ПустаяСсылка()
	Иначе
	 Группа.Родитель = РодительТМЦ(Соединение, Родитель.Родитель, Узел, СтрОбмена);
	КонецЕсли;  
	
	Группа.ОбменДанными.Загрузка =Истина;
	Группа.Записать();	                         
	
    Если не ЕстьВРегистре Тогда
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Группа.Ссылка, Guid , ТипПриемника, Узел));
		попытка
			Соединение.ОбменDigger.УдалитьРегистрациюИзменений(Группа.Ссылка);	
		исключение
		конецпопытки;
				//

    КонецЕсли;

	Возврат Группа.Ссылка;
КонецФункции	

Процедура СписокГруппТМЦ(Соединение =Неопределено,  Узел= Неопределено) Экспорт
Если Узел =Неопределено Тогда
  Узел = ПолучитьУзел();
КонецЕсли;		
	
Если Соединение  =Неопределено Тогда
	Соединение = ПодключитьБазу (Узел); 
КонецЕсли;

//++РудикВВ
Если Узел.ТількиЗмінені тогда
		Запрос = Соединение.NewObject("Запрос"); 
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТМЦИзменения.Узел КАК Узел,
		|	ТМЦИзменения.НомерСообщения КАК НомерСообщения,
		|	ТМЦИзменения.Ссылка КАК Ссылка
