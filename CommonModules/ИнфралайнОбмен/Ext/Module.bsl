// Помещает файлы с диска в хранилище присоединенных файлов.
// 
// Параметры:
//  ВыбранныеФайлы                 - Массив - пути к файлам на диске.
//  ВладелецФайла                  - Ссылка на владельца файла.
//  НастройкиРаботыСФайлами        - Структура.
//  ПрисоединенныеФайлыМассив      - Массив (возвращаемое значение) - заполняется ссылками
//                                   на добавленные файлы.
//  ИдентификаторФормы             - УникальныйИдентификатор формы.
//
Функция ПоместитьВыбранныеФайлыВХранилище(Знач ФайлКартинки,
                                            Знач ВладелецФайла, Узел) Экспорт
										
	СведениеОфайле = РаботаСфайламиКлиентСервер.СведенияОФайле("ФайлСВерсией", ФайлКартинки); 

	ТипПриемника =СведениеОфайле.РасширениеБезТочки;
	
	Если ТипЗнч(ВладелецФайла) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры")
		Тогда                                                   
			ТипИсточника ="Справочник.ХарактеристикиНоменклатурыПрисоединенныеФайлы";	
		Иначе
			ТипИсточника ="Справочник.НоменклатураПрисоединенныеФайлы";	
	КонецЕсли;
	
	Guid = СведениеОфайле.ИмяБезРасширения;
	
	Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда 
		Если ТипЗнч(ВладелецФайла) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
			Возврат Справочники.ХарактеристикиНоменклатурыПрисоединенныеФайлы.ПустаяСсылка();
		Иначе
			Возврат Справочники.НоменклатураПрисоединенныеФайлы.ПустаяСсылка();             
		КонецЕсли;
	КонецЕсли;
								
	ЕстьВрегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел);
	
	Если ЕстьВРегистре Тогда	
	 Возврат ПолучитьОбъект(Guid, ТипПриемника, ТипИсточника, Узел);
	КонецЕсли;
											
	ОбщиеНастройки = ФайловыеФункцииСлужебныйКлиентСервер.ОбщиеНастройкиРаботыСФайлами();
				
	Файл = Новый Файл(ФайлКартинки.ПолноеИмя);
	
	ФайловыеФункцииСлужебныйКлиентСервер.ПроверитьВозможностьЗагрузкиФайла(Файл);
	
	Если ОбщиеНастройки.ИзвлекатьТекстыФайловНаСервере Тогда
		АдресВременногоХранилищаТекста = "";
	Иначе
		АдресВременногоХранилищаТекста =
			ФайловыеФункцииСлужебныйКлиентСервер.ИзвлечьТекстВоВременноеХранилище(
				ФайлКартинки.ПолноеИмя);
	КонецЕсли;
		
	БинДанные = Новый ДвоичныеДанные(Файл.ПолноеИмя);
		
	АдресВременногоХранилищаФайла = ПоместитьВоВременноеХранилище(БинДанные, Новый УникальныйИдентификатор);
		
			
	ПараметрыФайла = Новый Структура;
	ПараметрыФайла.Вставить("ВладелецФайлов",              ВладелецФайла);
	ПараметрыФайла.Вставить("Автор",                       ПараметрыСеанса.АвторизованныйПользователь);
	ПараметрыФайла.Вставить("ИмяБезРасширения",            СведениеОфайле.ИмяБезРасширения);
	ПараметрыФайла.Вставить("РасширениеБезТочки",          СведениеОфайле.РасширениеБезТочки);
	ПараметрыФайла.Вставить("ВремяИзменения",              СведениеОфайле.ВремяИзменения);
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", СведениеОфайле.ВремяИзмененияУниверсальное);
	
	 
	
	ФайлСсылка = ПрисоединенныеФайлы.ДобавитьПрисоединенныйФайл(
		ПараметрыФайла,
		АдресВременногоХранилищаФайла,
		АдресВременногоХранилищаТекста,
		ВладелецФайла.Описание);			                                             
		
	ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ФайлСсылка, Guid , ТипПриемника, Узел));
	Возврат ФайлСсылка; 
КонецФункции

//Поиск файла по имени в хранилище файлов
Функция ЕстьЭтотФайл(ИмяФайла)
Массив = СтрРазделить(ИмяФайла,".",Истина);
Если Массив.Количество()=0 Тогда
	Возврат Неопределено; 
КонецЕсли;	

Запрос = Новый Запрос(
"ВЫБРАТЬ
|	НоменклатураПоставщиковПрисоединенныеФайлы.ПутьКФайлу,
|	НоменклатураПоставщиковПрисоединенныеФайлы.Ссылка
|ИЗ
|	Справочник.НоменклатураПоставщиковПрисоединенныеФайлы КАК НоменклатураПоставщиковПрисоединенныеФайлы
|ГДЕ
|	НоменклатураПоставщиковПрисоединенныеФайлы.Наименование = &Наименование
|	И НоменклатураПоставщиковПрисоединенныеФайлы.Расширение = &Расширение
|
|ОБЪЕДИНИТЬ ВСЕ
|
|ВЫБРАТЬ
|	ХарактеристикиНоменклатурыПрисоединенныеФайлы.ПутьКФайлу,
|	ХарактеристикиНоменклатурыПрисоединенныеФайлы.Ссылка
|ИЗ
|	Справочник.ХарактеристикиНоменклатурыПрисоединенныеФайлы КАК ХарактеристикиНоменклатурыПрисоединенныеФайлы");  

Имя =Массив[0];

Если Массив.Количество()>=2 Тогда
	Расширение =Массив[1];
Иначе
	Расширение ="";
КонецЕсли;

Запрос.УстановитьПараметр("Наименование", Имя);
Запрос.УстановитьПараметр("Расширение", Расширение);
Результат = Запрос.Выполнить().Выбрать();

Если Результат.Следующий() Тогда
	Файл = Новый Файл(Результат.ПутьКФайлу); 
	Если Файл.Существует() Тогда
		Возврат Результат.ссылка;
	КонецЕсли;	
КонецЕсли;                                                         

Возврат Неопределено; 

КонецФункции
