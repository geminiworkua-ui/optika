Процедура ОстаткиПоБонусам(Соединение, Узел, СтрОбмена= Неопределено) 
ЗапросСхемы = Соединение.NewObject("Запрос");
ЗапросСхемы.Текст = 
"ВЫБРАТЬ
  |	ДисконтныеСхемы.Ссылка КАК Ссылка
  |ИЗ
  |	Справочник.ДисконтныеСхемы КАК ДисконтныеСхемы
  |ГДЕ
  |	НЕ ДисконтныеСхемы.ПометкаУдаления
  |	И ДисконтныеСхемы.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДисконтныхСхем.Бонусная)";   

Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
 "ВЫБРАТЬ
|	БонусыОстатки.Контрагент КАК Контрагент,
|	БонусыОстатки.Схема КАК Схема,
|	СУММА(БонусыОстатки.СуммаОстаток) КАК СуммаОстаток,
|	СУММА(БонусыОстатки.СуммаВалОстаток) КАК СуммаВалОстаток
|ПОМЕСТИТЬ Остатки
|ИЗ
|	РегистрНакопления.Бонусы.Остатки(&Дата, схема =&Схема) КАК БонусыОстатки
|
|СГРУППИРОВАТЬ ПО
|	БонусыОстатки.Схема,
|	БонусыОстатки.Контрагент
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ 
|	Остатки.Контрагент КАК Контрагент,
|	Остатки.Схема КАК Схема,
|   Остатки.СуммаОстаток как СуммаОстаток,
|	КО.Представление КАК Представление
|ИЗ
|	Остатки КАК Остатки
|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
|			Связь.Владелец КАК Владелец,
|			Связь.Представление КАК Представление
|		ИЗ
|			Справочник.Связь КАК Связь
|		ГДЕ
|			НЕ Связь.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииСвязи.Email)
|			И ТИПЗНАЧЕНИЯ(Связь.Владелец) = ТИП(Справочник.Контрагенты)) КАК КО
|		ПО Остатки.Контрагент = КО.Владелец";

Выборка = ЗапросСхемы.Выполнить().Выбрать();

Пока Выборка.следующий() Цикл
Запрос.установитьПараметр("Дата", Узел.ДатаПерехода); 
Запрос.установитьПараметр("Схема", Выборка.Ссылка); 

Результат = Запрос.Выполнить().Выгрузить();

БонуснаяПрограммаЛояльности = БонуснаяПрограмма(Соединение, Выборка.Ссылка, Узел);


ТЗ = новый ТаблицаЗначений();
ТЗ.Колонки.Добавить("Партнер", НОвый описаниеТипов("СправочникСсылка.Партнеры"));
ТЗ.Колонки.Добавить("Баллы", НОвый описаниеТипов("Число"));

Для Каждого Стр Из Результат Цикл
		НовСтр = ТЗ.Добавить();
		НовСтр.Партнер = Контрагенты(Соединение, Стр.Контрагент, Узел); 
			ВидКарт = ВидКартЛояльности(Соединение, Стр.Схема, БонуснаяПрограммаЛояльности, Узел);
			КартаЛояльности(Соединение, НовСтр.Партнер, ВидКарт, Стр.Контрагент, Стр.Представление, Узел);   
		НовСтр.Баллы = Стр.СуммаОстаток;    
КонецЦикла;	

ЧислоШагов = Окр(ТЗ.Количество()/50000 + 0.5, 0, РежимОкругления.Окр15как20);
МаксСтрока = ТЗ.Количество() - 1;

Для Шаг = 0 По ЧислоШагов Цикл
	
	Док = Документы.НачислениеИСписаниеБонусныхБаллов.СоздатьДокумент();
	Док.Дата = Узел.ДатаПерехода;
	Док.ВидПравила = перечисления.ВидыПравилНачисленияБонусныхБаллов.Начисление;
	Док.ПериодДействия =Перечисления.Периодичность.Год;
	Док.БонуснаяПрограммаЛояльности = БонуснаяПрограммаЛояльности;
	Док.КоличествоПериодовОтсрочкиНачалаДействия = 1;
	Док.ПериодОтсрочкиНачалаДействия = Перечисления.Периодичность.День;
	
	Для Инд = 50000 * Шаг По мин(1+50000 * (Шаг + 1), МаксСтрока) Цикл
        ЗаполнитьЗначенияСвойств(Док.Начисление.Добавить(),ТЗ[Инд]);
	КонецЦикла; 
	
	Если Не Док.Начисление.Количество()=0 Тогда
		Док.Записать();
	КонецЕсли;	
	
КонецЦикла;



КонецЦикла;	
