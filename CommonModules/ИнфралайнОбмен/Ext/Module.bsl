Функция КартаЛояльности(Соединение, Партнер, ВидКарт,comОбъект, Штрихкод, Узел, СтрОбмена= Неопределено)
ТипПриемника ="Контрагенты";
ТипИсточника ="Справочник.КартыЛояльности";
Guid = ПолучитьGuid(Соединение,comОбъект);
Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Справочники.КартыЛояльности.ПустаяСсылка();
КонецЕсли;

ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Узел) ;	
Если ЕстьВРегистре Тогда
	Ссылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Узел);   
	Попытка
		Объект = Ссылка.ПолучитьОбъект();   
	Исключение
		Объект = Неопределено;		
	КонецПопытки;

	Если Объект =Неопределено Тогда
		Объект = Справочники.КартыЛояльности.СоздатьЭлемент(); 
		ЕстьВРегистре = Ложь; 
		УдалитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid , ТипПриемника, Узел));  
		Ссылка = СоздатьНовуюКарту(Партнер, ВидКарт, Штрихкод);
        ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid , ТипПриемника, Узел));  
		Возврат Ссылка;
  	ИначеЕсли СтрОбмена= Неопределено Тогда
		Возврат Ссылка;   
	КонецЕсли;	 
Иначе	
	Запрос = Новый Запрос (
	"ВЫБРАТЬ
	|	КартыЛояльности.Ссылка
	|ИЗ
	|	Справочник.КартыЛояльности КАК КартыЛояльности
	|ГДЕ
	|	КартыЛояльности.Владелец = &Владелец
	|	И КартыЛояльности.Партнер = &Партнер");
	Запрос.УстановитьПараметр("Владелец",ВидКарт);
	Запрос.УстановитьПараметр("Партнер",Партнер);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.следующий()Тогда 
		Ссылка = ИзменитьКартУ(Результат.ссылка, Партнер, ВидКарт, Штрихкод);
	Иначе
		Ссылка = СоздатьНовуюКарту(Партнер, ВидКарт, Штрихкод);
	КонецЕсли;
	 ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid , ТипПриемника, Узел)); 
	 Возврат Ссылка; 
 КонецЕсли;	
    Ссылка = ИзменитьКартУ(ссылка, Партнер, ВидКарт, Штрихкод);    
	Возврат Ссылка; 
