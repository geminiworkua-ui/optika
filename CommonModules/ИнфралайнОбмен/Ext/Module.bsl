Функция ЗначенияРеквизитов_Получить(Соединение, Объект, Реквизит, Дата= Неопределено, ЗначениеПоУмолчанию= Неопределено) Экспорт
	Структура = Соединение.NewObject("Структура");
	Структура.Вставить("Объект", Объект);
	Структура.Вставить("Настройка", Соединение.ПланыВидовХарактеристик.ЗначенияРеквизитов[Реквизит].Ссылка);

		Если Дата= Неопределено ИЛИ Дата= Дата(1,1,1) Тогда 
		  	Результат= Соединение.РегистрыСведений.ЗначенияРеквизитов.ПолучитьПоследнее(ТекущаяДата(), Структура);
		Иначе 
		  	Результат = Соединение.РегистрыСведений.ЗначенияРеквизитов.ПолучитьПоследнее(Дата, Структура);
	КонецЕсли;
	
	Если ЗначениеНеЗаполнено(Результат.Значение) Тогда 
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат.Значение;
КонецФункции

Функция ЗначениеНеЗаполнено(Значение) Экспорт
	ТипЗначения = ТипЗнч(Значение);

	// Сначала примитивные типы
	Если Значение = Неопределено Тогда 
		Попытка Ссылка= Значение.Ссылка;
			Возврат Ссылка.Пустая();
		Исключение Возврат Истина; 
		КонецПопытки;
   
	ИначеЕсли Значение = NULL Тогда Возврат Истина;

	ИначеЕсли ТипЗначения = Тип("Строка") Тогда Возврат ПустаяСтрока(Значение);
		
	ИначеЕсли ТипЗначения = Тип("COMОбъект") Тогда Возврат Ложь;
			
	ИначеЕсли ТипЗначения = Тип("Число") Тогда Возврат Ложь; //(Значение = 0);

	ИначеЕсли ТипЗначения = Тип("Дата") Тогда Возврат (Значение = Дата('00010101'));

	ИначеЕсли ТипЗначения = Тип("МоментВремени") Тогда Возврат (Значение = Дата('00010101'));

	ИначеЕсли ТипЗначения = Тип("ВидДвиженияНакопления") Тогда Возврат ПустаяСтрока(Значение);

	ИначеЕсли ТипЗначения = Тип("Булево") Тогда Возврат Ложь;

	ИначеЕсли ТипЗначения = Тип("РежимПроведенияДокумента") Тогда

		Если Значение = РежимПроведенияДокумента.Неоперативный или Значение = РежимПроведенияДокумента.Оперативный тогда
			Возврат Ложь;
		КонецЕсли;

	ИначеЕсли Строка(ТипЗначения) = "Тип" Тогда Возврат Ложь;
		
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда Возврат (Значение.Получить() = Неопределено);
		
	Иначе
		Попытка		Т_Значение = Новый(ТипЗначения);
					Если Значение = Т_Значение Тогда Возврат Истина;
					КонецЕсли
		Исключение
			
		КонецПопытки;
	КонецЕсли;

	Возврат Ложь;
КонецФункции

