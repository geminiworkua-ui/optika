ТипПриемника ="Страны";
ТипИсточника ="Справочник.СтраныМира";	
   
Guid = ПолучитьGuid(Соединение,Страна); 

Если СокрЛП(Guid)=""  или Guid ="00000000-0000-0000-0000-000000000000" тогда
	возврат Справочники.СтраныМира.ПустаяСсылка();
КонецЕсли;

ЕстьВРегистре =ЕстьЗапись(Guid, ТипПриемника, ТипИсточника, Объект.Ссылка) ;	
Если ЕстьВРегистре Тогда 
	СтранаСсылка =ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника, Объект.Ссылка);
	Попытка
	СтранаОбъект = СтранаСсылка.ПолучитьОбъект();
	Исключение
	СтранаОбъект = Неопределено;
	КонецПопытки;
	Если СтранаОбъект = Неопределено Тогда
		УдалитьЗапись(ПолучитьСтруктуруЗаписи(СтранаСсылка, Guid , ТипПриемника, Объект.Ссылка));  
		ЗаписьУдалена = Истина;
        ЕстьВРегистре = Ложь;

	ИначеЕсли СтрОбмена= Неопределено Тогда
		Возврат СтранаСсылка; 
	КОнецЕсли;	
КонецЕсли;	
   СтранаОбъект = Справочники.СтраныМира.СоздатьЭлемент();  
   Наименование =СокрЛП(Страна.Наименование);
   Если Наименование ="Австрія" Тогда
	   ссылка =  справочники.СтраныМира.НайтиПоКоду("40");
   ИначеЕсли  Наименование ="Велика Британія" Тогда
	   ссылка =  справочники.СтраныМира.НайтиПоКоду("826");
   ИначеЕсли  Наименование ="Германія" или Наименование ="Німеччина" Тогда
	    ссылка =  справочники.СтраныМира.НайтиПоКоду("276");
   ИначеЕсли  Наименование ="Италия" или Наименование ="Італія" Тогда
	    Возврат справочники.СтраныМира.НайтиПоКоду("380");
   ИначеЕсли  Наименование ="Іспанія" Тогда
	    ссылка =  справочники.СтраныМира.НайтиПоКоду("724");
   ИначеЕсли  Наименование ="Китай" Тогда
	    ссылка =  справочники.СтраныМира.НайтиПоКоду("156");
   ИначеЕсли  Наименование ="Корея" Тогда
	    ссылка =  справочники.СтраныМира.НайтиПоКоду("410");
   ИначеЕсли  Наименование ="Росія" Тогда
	    ссылка =  справочники.СтраныМира.НайтиПоКоду("643");
   ИначеЕсли  Наименование ="США" Тогда
	    ссылка =  справочники.СтраныМира.НайтиПоКоду("840");
   ИначеЕсли  Наименование ="Туреччина" или Наименование ="Турция" Тогда
	    ссылка =  справочники.СтраныМира.НайтиПоКоду("792");
   ИначеЕсли  Наименование ="Україна" Тогда
	    ссылка =  справочники.СтраныМира.Украина;
