	ПартнерОбъект.Поставщик    = Контрагент.Поставщики; 
	
	ПартнерОбъект.Врач    	   = Контрагент.Врачи;  
	ПартнерОбъект.Сотрудник    = Контрагент.Сотрудники;  
	ПартнерОбъект.Производитель= Контрагент.Производители; 
	ПартнерОбъект.Диллер 	   = Контрагент.Диллеры;
	ПартнерОбъект.Больница     = Контрагент.Больницы;
	ПартнерОбъект.Мастер       = Контрагент.Мастера; 
	ПартнерОбъект.Бонусник     = Контрагент.Бонусники; 
	ПартнерОбъект.ПрочиеОтношения = ПартнерОбъект.Врач или ПартнерОбъект.Сотрудник или ПартнерОбъект.Производитель или ПартнерОбъект.Бонусник 
								или ПартнерОбъект.Диллер или ПартнерОбъект.Больница или ПартнерОбъект.Мастер;
								
	// ++ Боков							
	Попытка
	ПартнерОБъект.АрхивнаяМедИнформация	= Контрагент.Описание;						
	Исключение
	КонецПопытки;
	// -- Боков							
								
	ПартнерОбъект.ДатаРождения = Контрагент.ДеньРождения;  
	ПартнерОбъект.Пол = ПолКлиента(Соединение, Контрагент.пол);
	Если ПартнерОбъект.Поставщик Тогда 
		 ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	КонецЕсли;
	
	Если ПартнерОбъект.Больница Тогда 
		 ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	КонецЕсли;
	
	Если ПартнерОбъект.Диллер Тогда 
		 ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	КонецЕсли;
	
	Если ПартнерОбъект.Производитель Тогда 
		 ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	КонецЕсли;
	
	Если ПартнерОбъект.Сотрудник Тогда 
		 ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
	КонецЕсли;
	
	Если ПартнерОбъект.Врач Тогда 
		 ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
	КонецЕсли;
	
	Если ПартнерОбъект.Мастер Тогда 
		 ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
	КонецЕсли;

    Если ПартнерОбъект.клиент Тогда 
		 ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
	КонецЕсли;
 
	Если ПартнерОбъект.ЮрФизЛицо = перечисления.КомпанияЧастноеЛицо.ПустаяСсылка() Тогда
		Если Не ПартнерОбъект.ДатаРождения = Дата(1,1,1) 
			или Не ПартнерОбъект.Пол= перечисления.ПолФизическогоЛица.ПустаяСсылка() 
			Тогда ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
			Иначе ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
		КонецЕсли;
	КонецЕсли;
	
	ПартнерОбъект.Записать();  
	Если Не  ЕстьВРегистре Тогда
	ДобавитьЗапись(ПолучитьСтруктуруЗаписи(ПартнерОбъект.Ссылка, Guid , ТипПриемника, Узел));
	КонецЕсли;
	Если ПартнерОбъект.Сотрудник Тогда
		ФизЛица(Соединение,Контрагент.Сотрудник,ПолКлиента(Соединение,Контрагент.Пол),Контрагент.ДеньРождения, Контрагент.ЕДРПОУ, Узел); 
	КонецЕсли;
	КонтрагентЗн =ЗнКонтрагент(Соединение, Контрагент,ПартнерОбъект.Ссылка, Узел, СтрОбмена);
	ПартнерОбъект.КонтактнаяИнформация.Очистить(); 
	ПолучитьАдреса(Соединение, Контрагент, ПартнерОбъект);
	ПолучитьТелефоны(Соединение, Контрагент,ПартнерОбъект);  
	ПолучитьEmail(Соединение, контрагент, ПартнерОбъект);
	ПартнерОбъект.Записать();
	Возврат ПартнерОбъект.Ссылка;

КонецФункции	

Функция ЗнКонтрагент(Соединение, Контрагент, Партнер, Узел, СтрОбмена= Неопределено)
	
ТипПриемника ="Контрагенты";
ТипИсточника ="Справочник.Контрагент";	
 
Guid = ПолучитьGuid(Соединение,Контрагент);

Если СокрЛп(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Справочники.Контрагенты.ПустаяСсылка();
КонецЕсли;

ЕстьВРегистре = ЕстьЗапись(Guid, ТипПриемника, ТипИсточника,  Узел);
 
Если ЕстьВРегистре Тогда
	
	КонтрагентСсылка = ПолучитьОбъект(Guid,ТипПриемника, ТипИсточника,  Узел);
	
	Попытка	
		КонтрагентОбъект = КонтрагентСсылка.получитьОбъект();
	Исключение
		КонтрагентОбъект = Неопределено;	
	КонецПопытки;
	
	Если КонтрагентОбъект = Неопределено Тогда
		КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
		ЕстьВРегистре = Ложь;
	ИначеЕсли СтрОбмена= Неопределено Тогда
		Возврат КонтрагентСсылка; 
	КонецЕсли;	                  	

Иначе	
	КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
КонецЕсли;   
   	КонтрагентОбъект.Наименование = Контрагент.Наименование; 
	КонтрагентОбъект.НаименованиеПолное = Контрагент.ПНаименование;
	КонтрагентОбъект.КодПоЕДРПОУ = Контрагент.ЕДРПОУ; 
	КонтрагентОбъект.ПлательщикНДС = Контрагент.СНДС;  	
	Если КонтрагентОбъект.ПлательщикНДС Тогда 
	КонтрагентОбъект.ИННПлательщикаНДС =  Контрагент.Инн;
	КонецЕсли;          
    КонтрагентОбъект.Партнер   = Партнер; 
	Если Партнер.ЮрФизЛицо = перечисления.КомпанияЧастноеЛицо.Компания Тогда
    КонтрагентОбъект.ЮрФизЛицо = перечисления.ЮрФизЛицо.ЮрЛицо; 
	Иначе 
	КонтрагентОбъект.ЮрФизЛицо = перечисления.ЮрФизЛицо.ФизЛицо; 
	КонецЕсли;
	
	КонтрагентОбъект.Записать();
	Если Не ЕстьВРегистре Тогда
		ДобавитьЗапись(ПолучитьСтруктуруЗаписи(КонтрагентОбъект.Ссылка, Guid , ТипПриемника,  Узел));
	КонецЕсли;
	КонтрагентОбъект.КонтактнаяИнформация.Очистить();
	ПолучитьАдреса(Соединение, Контрагент, КонтрагентОбъект);
	ПолучитьТелефоны(Соединение, Контрагент, КонтрагентОбъект);  
	ПолучитьEmail(Соединение, контрагент, КонтрагентОбъект);
	
	Возврат КонтрагентОбъект.Ссылка;

КонецФункции	
 
Функция ПолКлиента(Соединение,Пол)  
	Значение =Неопределено;
	Если Пол= Соединение.Перечисления.Пол.Мужчина Тогда
		Возврат перечисления.ПолФизическогоЛица.Мужской;
	ИначеЕсли Пол=Соединение.Перечисления.Пол.Женщина Тогда
	    Возврат перечисления.ПолФизическогоЛица.Женский;
	Иначе
		Возврат перечисления.ПолФизическогоЛица.ПустаяСсылка();
    КонецЕсли;
КонецФункции	

Функция НайтиКонтрагента(Партнер)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Партнер = &Партнер"	);
	Запрос.УстановитьПараметр("Партнер", Партнер);
	рез = Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда
		Возврат Рез.ссылка;
	КонецЕсли;	
КонецФункции

Процедура СписокКонтрагенты(Соединение, Узел, СтрОбмена)
	//++РудикВВ
	Если Узел.ТількиЗмінені тогда
		Запрос = Соединение.NewObject("Запрос"); 
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтрагентыИзменения.Узел КАК Узел,
		|	КонтрагентыИзменения.НомерСообщения КАК НомерСообщения,
		|	КонтрагентыИзменения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты.Изменения КАК КонтрагентыИзменения
		|ГДЕ
		|	НЕ КонтрагентыИзменения.Ссылка.ЭтоГруппа
		|	И НЕ КонтрагентыИзменения.Ссылка.ПометкаУдаления";
	иначе
		//
		Запрос = Соединение.NewObject("Запрос");
		Запрос.Текст =	
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления";
	КонецЕсли;
Результат = Запрос.Выполнить().Выбрать();
Текущий =0;
Рез = Запрос.Выполнить().Выгрузить();
Всего = Рез.Количество();

Пока Результат.Следующий() Цикл    
	Текущий = Текущий +1;		
	ПроцентВыполнения = (Текущий/Всего)*100;
	ПроцентВыполнения = Окр(ПроцентВыполнения,0);
				
	ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,СокрЛП(Результат.ссылка.Наименование));
	Контрагент =	Контрагенты(Соединение, Результат.ссылка, Узел, СтрОбмена) ;
    //++РудикВВ
	Если ЗначениеЗаполнено(Контрагент) тогда
	Соединение.ОбменDigger.УдалитьРегистрациюИзменений( Результат.ссылка);	
	КонецЕсли;
	//
КонецЦикла;	
Конецпроцедуры	

#Область КонтактнаяИнформация

Процедура ПолучитьАдреса(Соединение, контрагент, Партнер) 
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
       "ВЫБРАТЬ
       |	Адреса.АдресДома КАК Адрес
       |ИЗ
       |	Справочник.Адреса КАК Адреса
       |ГДЕ
       |	Адреса.Владелец = &Владелец
       |	И НЕ Адреса.ПометкаУдаления"; 
Запрос.УстановитьПараметр("Владелец", Контрагент);	   
Выборка = Запрос.Выполнить().выбрать();

Пока Выборка.следующий() Цикл
	Представление =Выборка.Адрес.Наименование;
	Если Не СокрЛП(Представление)= "" Тогда
	КИ = Партнер.КонтактнаяИнформация.Добавить();
	Если ТипЗнч(Партнер) = Тип("СправочникОбъект.Партнеры") Тогда
		КИ.Вид = справочники.ВидыКонтактнойИнформации.АдресПартнера;
	Иначе
		КИ.Вид = справочники.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента;
	КонецЕсли;	
	КИ.тип =перечисления.ТипыКонтактнойИнформации.Адрес;
	КИ.Представление = СокрЛП(Представление);    
	 
	КонецЕсли;
КонецЦикла;	
КонецПроцедуры	

Процедура ПолучитьТелефоны(Соединение, контрагент, Партнер) 
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
       "ВЫБРАТЬ
       |	Связь.Ссылка КАК Ссылка
       |ИЗ
       |	Справочник.Связь КАК Связь
       |ГДЕ
       |	Связь.Владелец = &Владелец
       |	И НЕ Связь.ПометкаУдаления   
	   |     и ТипЗначения(Связь.Владелец) =Тип(справочник.Контрагенты) 
	   | И Не Связь.Категория =Значение(Справочник.КатегорииСвязи.Email)"; 
Запрос.УстановитьПараметр("Владелец", Контрагент);                      
Выборка = Запрос.Выполнить().выбрать();
пока Выборка.следующий() цикл 
	Представление = СокрЛП(Выборка.ссылка.Наименование); 
	Если Представление= "" Тогда
         Продолжить;
	КонецЕсли;	 
	Представление = СтрЗаменить(Представление,"+38","");
	Представление = СтрЗаменить(Представление,"-","");    
	Представление = СтрЗаменить(Представление,"_","");
    Строки  = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Представление, " ");

	Для Каждого Стр из Строки Цикл
		Если Не ЕстьНеЦифры(Стр) Тогда 	
			КИ = Партнер.КонтактнаяИнформация.Добавить(); 
			Если ТипЗнч(Партнер) = Тип("СправочникОбъект.Партнеры") Тогда
				КИ.Вид = справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
			Иначе                                                         
			    КИ.Вид = справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
			КонецЕсли;
			КИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			КИ.Представление = СокрЛП(Стр);  
		КонецЕсли;
    КонецЦикла
КонецЦикла;	
КонецПроцедуры	

Процедура ПолучитьEmail(Соединение, контрагент, Партнер) 
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = 
       "ВЫБРАТЬ
       |	Связь.Ссылка КАК Ссылка
       |ИЗ
       |	Справочник.Связь КАК Связь
       |ГДЕ
       |	Связь.Владелец = &Владелец
       |	И НЕ Связь.ПометкаУдаления 
	   |	И Связь.Категория = &категория"; 
Запрос.УстановитьПараметр("Владелец", Контрагент);	
Запрос.УстановитьПараметр("категория", Соединение.Справочники.КатегорииСвязи.EMail);	 
Выборка = Запрос.Выполнить().выбрать();
пока Выборка.следующий() цикл 
	Представление =Выборка.ссылка.Наименование;
	Если Не СокрЛП(Представление)= "" Тогда
	КИ = Партнер.КонтактнаяИнформация.Добавить();
	Если ТипЗнч(Партнер) = Тип("СправочникОбъект.Партнеры") Тогда
		КИ.Вид = справочники.ВидыКонтактнойИнформации.EmailПартнера;
	Иначе	
		КИ.Вид = справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
	КонецЕсли;	
	КИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
