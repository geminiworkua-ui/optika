	КонецЕсли;
	
	//УдалитьЛишниеУпаковки(НомОбъект.Ссылка, СО.Ссылка);
	
	
	НомОбъект.ВариантОформленияПродажи = перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
