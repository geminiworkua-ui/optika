Функция УточнитьСправочникПоРеквизиту(Реквизит)
	Запрос =Новый Запрос(
	 "ВЫБРАТЬ
	 |	СоответствеНазванияРеквизиту.Справочник
	 |ИЗ
	 |	РегистрСведений.СоответствеНазванияРеквизиту КАК СоответствеНазванияРеквизиту
	 |ГДЕ
	 |	СоответствеНазванияРеквизиту.Реквизит = &Реквизит");
	Запрос.УстановитьПараметр("Реквизит", Реквизит);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Справочник;
	КонецЕсли;	
КонецФункции	

