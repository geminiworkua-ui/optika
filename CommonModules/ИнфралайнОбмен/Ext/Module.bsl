Функция ПолучитьВидыТМЦ()  
   Запрос = Новый Запрос(
   "ВЫБРАТЬ
   |	СоответствиеВидаНоменклатурыГруппе.Группа,
   |	СоответствиеВидаНоменклатурыГруппе.ВидНоменклатуры
   |ИЗ
   |	РегистрСведений.СоответствиеВидаНоменклатурыГруппе КАК СоответствиеВидаНоменклатурыГруппе");
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ТМЦВид(Соединение, Категория,Тип, Узел, СтрОбмена = Неопределено)  
	
	
ТипПриемника ="Категория";
ТипИсточника ="Справочник.ВидыНоменклатуры";	

Если Категория = NULL Тогда
	Возврат NULL;
КОнецЕсли;	
	
 
Guid = ПолучитьGuid(Соединение,Категория);
Если СокрЛП(Guid)="" или Guid ="00000000-0000-0000-0000-000000000000" Тогда
	Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
КонецЕсли;	

