// Проверяет общий статус ответа и статус по каждому получателю.
Функция ОтветTurboSMSУспешный(Ответ, ТекстОшибки)
	
	Статус = Строка(Ответ.Получить("response_status"));
	Если Не СтрНачинаетсяС(Статус, "SUCCESS") Тогда
		ТекстОшибки = Статус;
		Возврат Ложь;
	КонецЕсли;
	
	Результаты = Ответ.Получить("response_result");
	Если ТипЗнч(Результаты) = Тип("Массив") Тогда
		Для Каждого РезультатПолучателя Из Результаты Цикл
			Если ТипЗнч(РезультатПолучателя) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			СтатусПолучателя = Строка(РезультатПолучателя.Получить("response_status"));
			Если ЗначениеЗаполнено(СтатусПолучателя)
				И СтатусПолучателя <> "OK"
				И Не СтрНачинаетсяС(СтатусПолучателя, "SUCCESS") Тогда
				ТекстОшибки = СтатусПолучателя;
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// --- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ---

Функция ПодставитьПараметрыВШаблон(Знач ТекстШаблона, Знач СтруктураПараметров)

	Результат = ТекстШаблона;

	Для Каждого КлючИЗначение Из СтруктураПараметров Цикл
		ИмяТега = "[" + КлючИЗначение.Ключ + "]";
		Результат = СтрЗаменить(Результат, ИмяТега, Строка(КлючИЗначение.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НормализоватьНомерТелефона(Знач ИсходныйНомер) Экспорт

	Если НЕ ЗначениеЗаполнено(ИсходныйНомер) Тогда
		Возврат "";
	КонецЕсли;

	// 1. Оставляем только цифры
	ТолькоЦифры = "";
	ДлинаСтроки = СтрДлина(ИсходныйНомер);
	
	Для Индекс = 1 По ДлинаСтроки Цикл
		Символ = Сред(ИсходныйНомер, Индекс, 1);
		Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда // '0'..'9'
			ТолькоЦифры = ТолькоЦифры + Символ;
		КонецЕсли;
	КонецЦикла;

	ДлинаЦифр = СтрДлина(ТолькоЦифры);

	// 2. Приводим к формату 380XXXXXXXXX (ровно 12 цифр)
	Если ДлинаЦифр = 10 И Лев(ТолькоЦифры, 1) = "0" Тогда
		Возврат "380" + Сред(ТолькоЦифры, 2);
	ИначеЕсли ДлинаЦифр = 12 И Лев(ТолькоЦифры, 3) = "380" Тогда
		Возврат ТолькоЦифры;
	ИначеЕсли ДлинаЦифр = 11 И Лев(ТолькоЦифры, 2) = "80" Тогда
		Возврат "3" + ТолькоЦифры;
	ИначеЕсли ДлинаЦифр = 9 И Лев(ТолькоЦифры, 1) <> "0" Тогда
		Возврат "380" + ТолькоЦифры;
	Иначе
		Возврат ТолькоЦифры;
	КонецЕсли;

КонецФункции  

