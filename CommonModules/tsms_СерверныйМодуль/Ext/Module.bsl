#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// --- 1. ЛОГИКА ДЛЯ ДНЕЙ РОЖДЕНИЯ (За N дней до ДР, например 7) ---
Процедура ОбработатьДниРождения(НастройкаОповещения)

	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	
	// Вычисляем целевую дату (сегодня + КоличествоДней)
	ЦелеваяДата = ТекущаяДата + (НастройкаОповещения.КоличествоДней * 86400);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Партнеры.Ссылка КАК Партнер,
		|	Партнеры.Наименование КАК НаименованиеКлиента,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ЕСТЬNULL(КИ.НомерТелефона, """") <> """"
		|				ТОГДА КИ.НомерТелефона
		|			ИНАЧЕ ПОДСТРОКА(ЕСТЬNULL(КИ.Представление, """"), 1, 100)
		|		КОНЕЦ) КАК Телефон,
		|	Партнеры.ДатаРождения КАК ДатаРождения
		|ИЗ
		|	Справочник.Партнеры КАК Партнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.КонтактнаяИнформация КАК КИ
		|		ПО Партнеры.Ссылка = КИ.Ссылка
		|			И (КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
		|ГДЕ
		|	НЕ Партнеры.ПометкаУдаления
		|	И Партнеры.ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
		|	И МЕСЯЦ(Партнеры.ДатаРождения) = МЕСЯЦ(&ЦелеваяДата)
		|	И ДЕНЬ(Партнеры.ДатаРождения) = ДЕНЬ(&ЦелеваяДата)
		|	И НЕ Партнеры.Ссылка В
		|				(ВЫБРАТЬ
		|					История.Партнер
		|				ИЗ
		|					РегистрСведений.tsms_ИсторияОтправкиОповещений КАК История
		|				ГДЕ
		|					История.ВидОповещения = &ВидОповещения
		|					И История.Период = &Сегодня)
		|
		|СГРУППИРОВАТЬ ПО
		|	Партнеры.Ссылка,
		|	Партнеры.Наименование,
		|	Партнеры.ДатаРождения";

	Запрос.УстановитьПараметр("ЦелеваяДата", ЦелеваяДата);
	Запрос.УстановитьПараметр("ВидОповещения", НастройкаОповещения.Ссылка);
	Запрос.УстановитьПараметр("Сегодня", ТекущаяДата);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		
		ПараметрыТекста = Новый Структура;
		ПараметрыТекста.Вставить("НаименованиеКлиента", Выборка.НаименованиеКлиента);
		ПараметрыТекста.Вставить("КоличествоДней", НастройкаОповещения.КоличествоДней);

		ОтправитьИЗафиксировать(Выборка.Партнер, Выборка.Телефон, НастройкаОповещения, ПараметрыТекста);
	 
	КонецЦикла;

КонецПроцедуры

// --- 2. ЛОГИКА ДЛЯ ПОКУПОК (Через N дней после покупки) ---
Процедура ОбработатьОповещенияПоПокупкам(НастройкаОповещения)

	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	ЕстьВидНоменклатуры = ЗначениеЗаполнено(НастройкаОповещения.ВидНоменклатуры);
	
	МассивГрупп = ГруппыНоменклатурыВида(НастройкаОповещения);
	ЕстьГруппыНоменклатуры = (МассивГрупп.Количество() > 0);
    //ДК: 29.10.2026
	ЕстьКаналПродаж = ЗначениеЗаполнено(НастройкаОповещения.КаналПродаж);
	//:ДК 29.10.2026
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Продажи.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
		|	Продажи.Период КАК Период,
		|	Продажи.Склад КАК Склад,
		|	Продажи.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ВТ_Продажи
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Продажи
		|ГДЕ
		|	(НЕ &ЕстьВидНоменклатуры
		|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры)
		|	И (НЕ &ЕстьГруппыНоменклатуры
		|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Номенклатура В ИЕРАРХИИ (&МассивГрупп))
		|	И Продажи.АналитикаУчетаНоменклатуры.Номенклатура.РежимЗамены = &ЗначениеРежимаЗамены 
		|	// ДК: 29.10.2026
		|	И (НЕ &ЕстьКаналПродаж
		|			ИЛИ Продажи.ДокументДвижения ССЫЛКА Документ.РеализацияТоваровУслуг
		|				И ВЫРАЗИТЬ(Продажи.ДокументДвижения КАК Документ.РеализацияТоваровУслуг).КаналПродаж = &КаналПродаж)
		|	// :ДК 29.10.2026
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Продажи.Партнер КАК Партнер,
		|	МАКСИМУМ(ВТ_Продажи.Период) КАК ДатаПокупки
		|ПОМЕСТИТЬ ВТ_Последние
		|ИЗ
		|	ВТ_Продажи КАК ВТ_Продажи
		|ГДЕ
		|	НЕ ВТ_Продажи.Партнер В
		|				(ВЫБРАТЬ
		|					История.Партнер
		|				ИЗ
		|					РегистрСведений.tsms_ИсторияОтправкиОповещений КАК История
		|				ГДЕ
		|					История.ВидОповещения = &ВидОповещения
		|					И История.Период = &Сегодня)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Продажи.Партнер
		|
		|ИМЕЮЩИЕ
		|	РАЗНОСТЬДАТ(МАКСИМУМ(ВТ_Продажи.Период), &Сегодня, ДЕНЬ) = &КоличествоДней
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КИ_ТЧ.Ссылка КАК Партнер,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КИ_ТЧ.НомерТелефона <> """"
		|				ТОГДА КИ_ТЧ.НомерТелефона
		|			ИНАЧЕ ПОДСТРОКА(КИ_ТЧ.Представление, 1, 100)
		|		КОНЕЦ) КАК Телефон
		|ПОМЕСТИТЬ ВТ_Телефоны
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК КИ_ТЧ
		|ГДЕ
		|	КИ_ТЧ.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТ_Последние.Партнер
		|			ИЗ
		|				ВТ_Последние)
		|	И КИ_ТЧ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|
		|СГРУППИРОВАТЬ ПО
		|	КИ_ТЧ.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Последние.Партнер КАК Партнер,
		|	Последние.Партнер.Наименование КАК НаименованиеКлиента,
		|	ЕСТЬNULL(Телефоны.Телефон, """") КАК Телефон,
		|	Продажи.Склад КАК Склад,
		|	Продажи.Номенклатура.Наименование КАК НаименованиеНоменклатуры
		|ИЗ
		|	ВТ_Последние КАК Последние
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Продажи КАК Продажи
		|		ПО (Продажи.Партнер = Последние.Партнер)
		|			И (Продажи.Период = Последние.ДатаПокупки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Телефоны КАК Телефоны
		|		ПО (Телефоны.Партнер = Последние.Партнер)";

	Запрос.УстановитьПараметр("ЕстьВидНоменклатуры", ЕстьВидНоменклатуры);
	Запрос.УстановитьПараметр("ВидНоменклатуры", НастройкаОповещения.ВидНоменклатуры);
	Запрос.УстановитьПараметр("ЕстьГруппыНоменклатуры", ЕстьГруппыНоменклатуры);
	Запрос.УстановитьПараметр("МассивГрупп", МассивГрупп);
	//ДК: 29.10.2026
	Запрос.УстановитьПараметр("ЕстьКаналПродаж", ЕстьКаналПродаж);
	Запрос.УстановитьПараметр("КаналПродаж", НастройкаОповещения.КаналПродаж);
	//:ДК 29.10.2026
	Запрос.УстановитьПараметр("ЗначениеРежимаЗамены", НастройкаОповещения.ЗначениеРежимаЗамены);
	Запрос.УстановитьПараметр("КоличествоДней", НастройкаОповещения.КоличествоДней);
	Запрос.УстановитьПараметр("ВидОповещения", НастройкаОповещения.Ссылка);
	Запрос.УстановитьПараметр("Сегодня", ТекущаяДата);

	Таблица = Запрос.Выполнить().Выгрузить();
	
	ОтправитьПоТаблицеПокупок(Таблица, НастройкаОповещения);

КонецПроцедуры

// --- 3. ЛОГИКА ДЛЯ ЛИНЗ (За N дней до окончания запаса) ---
// Включается флагом РасчетПоЗапасуЛинз в виде оповещения.
// Запас считается по последнему дню покупки клиента:
//   ЛинзВсего  = СУММА(Количество * КвоВЯщике)
//   Периодов   = Цел(ЛинзВсего / КоличествоГлаз)
//   Окончание  = ДатаПокупки + Периодов * РежимЗамены.КоличествоДней
//   Оповещение = Окончание - КоличествоДней (из вида оповещения)
Процедура ОбработатьОповещенияПоЗапасуЛинз(НастройкаОповещения)

	КоличествоГлаз    = 2;
	ГлубинаПоискаДней = 730; // покупки старше не рассматриваем
	
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	
	ДнейРежима = 0;
	Если ЗначениеЗаполнено(НастройкаОповещения.ЗначениеРежимаЗамены) Тогда
		ДнейРежима = НастройкаОповещения.ЗначениеРежимаЗамены.КоличествоДней;
	КонецЕсли;
	
	Если ДнейРежима <= 0 Тогда
		tsms_Логирование.Предупреждение(Перечисления.tsms_СобытияЛогирования.ОшибкаНастройки,
			СтрШаблон("Вид сповіщення ""%1"": не заповнено режим заміни або його ""Кількість днів""", 
				НастройкаОповещения.Ссылка),
			КонтекстЛога(НастройкаОповещения));
		Возврат;
	КонецЕсли;
	
	ЕстьВидНоменклатуры = ЗначениеЗаполнено(НастройкаОповещения.ВидНоменклатуры);
	
	МассивГрупп = ГруппыНоменклатурыВида(НастройкаОповещения);
	ЕстьГруппыНоменклатуры = (МассивГрупп.Количество() > 0);
    //ДК: 29.10.2026
	ЕстьКаналПродаж = ЗначениеЗаполнено(НастройкаОповещения.КаналПродаж);
	//:ДК 29.10.2026
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Продажи.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
		|	НАЧАЛОПЕРИОДА(Продажи.Период, ДЕНЬ) КАК ДатаПокупки,
		|	Продажи.Склад КАК Склад,
		|	Продажи.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		//ДК: 17.11.2026
		//|	Продажи.Количество * Продажи.АналитикаУчетаНоменклатуры.Номенклатура.КвоВЯщике КАК Линз
		|	ВЫБОР
		|		КОГДА &ПродажаВЛинзах
		|			ТОГДА Продажи.Количество
		|		ИНАЧЕ Продажи.Количество * Продажи.АналитикаУчетаНоменклатуры.Номенклатура.КвоВЯщике
		|	КОНЕЦ КАК Линз
		//:ДК 17.11.2026
		|ПОМЕСТИТЬ ВТ_Продажи
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Продажи
		|ГДЕ
		|	Продажи.Период >= &НачалоПоиска
		|	И Продажи.Количество > 0
		//ДК: 17.11.2026
		//|	И Продажи.АналитикаУчетаНоменклатуры.Номенклатура.КвоВЯщике > 0
		|	И (&ПродажаВЛинзах
		|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Номенклатура.КвоВЯщике > 0)
		//:ДК 17.11.2026
		|	И Продажи.АналитикаУчетаНоменклатуры.Номенклатура.РежимЗамены = &ЗначениеРежимаЗамены
		|	И (НЕ &ЕстьВидНоменклатуры
		|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры)
		|	И (НЕ &ЕстьГруппыНоменклатуры
		|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Номенклатура В ИЕРАРХИИ (&МассивГрупп))
		|	// ДК: 29.10.2026
		|	И (НЕ &ЕстьКаналПродаж
		|			ИЛИ Продажи.ДокументДвижения ССЫЛКА Документ.РеализацияТоваровУслуг
		|				И ВЫРАЗИТЬ(Продажи.ДокументДвижения КАК Документ.РеализацияТоваровУслуг).КаналПродаж = &КаналПродаж)
		|	// :ДК 29.10.2026
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Продажи.Партнер КАК Партнер,
		|	МАКСИМУМ(ВТ_Продажи.ДатаПокупки) КАК ДатаПокупки
		|ПОМЕСТИТЬ ВТ_Последние
		|ИЗ
		|	ВТ_Продажи КАК ВТ_Продажи
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Продажи.Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	П.Партнер КАК Партнер,
		|	П.ДатаПокупки КАК ДатаПокупки,
		|	СУММА(П.Линз) КАК ЛинзВсего
		|ПОМЕСТИТЬ ВТ_Линзы
		|ИЗ
		|	ВТ_Продажи КАК П
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Последние КАК Последние
		|		ПО (П.Партнер = Последние.Партнер)
		|			И (П.ДатаПокупки = Последние.ДатаПокупки)
		|
		|СГРУППИРОВАТЬ ПО
		|	П.Партнер,
		|	П.ДатаПокупки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// Периодов = Цел(ЛинзВсего / КоличествоГлаз)
		|// ВЫРАЗИТЬ округляет, поэтому при округлении вверх вычитаем 1
		|ВЫБРАТЬ
		|	Л.Партнер КАК Партнер,
		|	Л.ДатаПокупки КАК ДатаПокупки,
		|	Л.ЛинзВсего КАК ЛинзВсего,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(Л.ЛинзВсего / &КоличествоГлаз КАК ЧИСЛО(15, 0)) > Л.ЛинзВсего / &КоличествоГлаз
		|			ТОГДА ВЫРАЗИТЬ(Л.ЛинзВсего / &КоличествоГлаз КАК ЧИСЛО(15, 0)) - 1
		|		ИНАЧЕ ВЫРАЗИТЬ(Л.ЛинзВсего / &КоличествоГлаз КАК ЧИСЛО(15, 0))
		|	КОНЕЦ КАК Периодов
		|ПОМЕСТИТЬ ВТ_Периоды
		|ИЗ
		|	ВТ_Линзы КАК Л
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Пер.Партнер КАК Партнер,
		|	Пер.ДатаПокупки КАК ДатаПокупки,
		|	Пер.ЛинзВсего КАК ЛинзВсего,
		|	ДОБАВИТЬКДАТЕ(Пер.ДатаПокупки, ДЕНЬ, Пер.Периодов * &ДнейРежима) КАК ДатаОкончания
		|ПОМЕСТИТЬ ВТ_КОповещению
		|ИЗ
		|	ВТ_Периоды КАК Пер
		|ГДЕ
		|	Пер.Периодов > 0
		|	И ДОБАВИТЬКДАТЕ(Пер.ДатаПокупки, ДЕНЬ, Пер.Периодов * &ДнейРежима - &КоличествоДней) = &Сегодня
		|	И НЕ Пер.Партнер В
		|				(ВЫБРАТЬ
		|					История.Партнер
		|				ИЗ
		|					РегистрСведений.tsms_ИсторияОтправкиОповещений КАК История
		|				ГДЕ
		|					История.ВидОповещения = &ВидОповещения
		|					И История.Период = &Сегодня)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КИ_ТЧ.Ссылка КАК Партнер,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КИ_ТЧ.НомерТелефона <> """"
		|				ТОГДА КИ_ТЧ.НомерТелефона
		|			ИНАЧЕ ПОДСТРОКА(КИ_ТЧ.Представление, 1, 100)
		|		КОНЕЦ) КАК Телефон
		|ПОМЕСТИТЬ ВТ_Телефоны
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК КИ_ТЧ
		|ГДЕ
		|	КИ_ТЧ.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТ_КОповещению.Партнер
		|			ИЗ
		|				ВТ_КОповещению)
		|	И КИ_ТЧ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|
		|СГРУППИРОВАТЬ ПО
		|	КИ_ТЧ.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КО.Партнер КАК Партнер,
		|	КО.Партнер.Наименование КАК НаименованиеКлиента,
		|	ЕСТЬNULL(Телефоны.Телефон, """") КАК Телефон,
		|	Продажи.Склад КАК Склад,
		|	Продажи.Номенклатура.Наименование КАК НаименованиеНоменклатуры,
		|	КО.ЛинзВсего КАК ЛинзВсего,
		|	КО.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	ВТ_КОповещению КАК КО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Продажи КАК Продажи
		|		ПО (Продажи.Партнер = КО.Партнер)
		|			И (Продажи.ДатаПокупки = КО.ДатаПокупки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Телефоны КАК Телефоны
		|		ПО (Телефоны.Партнер = КО.Партнер)";

	Запрос.УстановитьПараметр("НачалоПоиска", ТекущаяДата - ГлубинаПоискаДней * 86400);
	Запрос.УстановитьПараметр("ЕстьВидНоменклатуры", ЕстьВидНоменклатуры);
	Запрос.УстановитьПараметр("ВидНоменклатуры", НастройкаОповещения.ВидНоменклатуры);
	Запрос.УстановитьПараметр("ЕстьГруппыНоменклатуры", ЕстьГруппыНоменклатуры);
	Запрос.УстановитьПараметр("МассивГрупп", МассивГрупп);
	//ДК: 29.10.2026
	Запрос.УстановитьПараметр("ЕстьКаналПродаж", ЕстьКаналПродаж);
	Запрос.УстановитьПараметр("КаналПродаж", НастройкаОповещения.КаналПродаж);
	//:ДК 29.10.2026
	Запрос.УстановитьПараметр("ЗначениеРежимаЗамены", НастройкаОповещения.ЗначениеРежимаЗамены);
	Запрос.УстановитьПараметр("КоличествоГлаз", КоличествоГлаз);
	Запрос.УстановитьПараметр("ДнейРежима", ДнейРежима);
	Запрос.УстановитьПараметр("КоличествоДней", НастройкаОповещения.КоличествоДней);
	//ДК: 17.11.2026
	Запрос.УстановитьПараметр("ПродажаВЛинзах", НастройкаОповещения.ПродажаВЛинзах = Истина);
	//:ДК 17.11.2026
	Запрос.УстановитьПараметр("ВидОповещения", НастройкаОповещения.Ссылка);
	Запрос.УстановитьПараметр("Сегодня", ТекущаяДата);

	Таблица = Запрос.Выполнить().Выгрузить();
	
	ОтправитьПоТаблицеПокупок(Таблица, НастройкаОповещения);

КонецПроцедуры

// Общая отправка по результату запроса покупок: одна отправка на клиента.
// Колонки: Партнер, НаименованиеКлиента, Телефон, Склад, НаименованиеНоменклатуры
// и, для линз, ЛинзВсего, ДатаОкончания.
Процедура ОтправитьПоТаблицеПокупок(Таблица, НастройкаОповещения)
	
	ЕстьДанныеЛинз = (Таблица.Колонки.Найти("ДатаОкончания") <> Неопределено);
	
	// Одна строка на клиента
	Клиенты = Таблица.Скопировать(, "Партнер, НаименованиеКлиента, Телефон");
	Клиенты.Свернуть("Партнер, НаименованиеКлиента, Телефон");
	
	КэшСкладов = Новый Соответствие;

	Для Каждого Клиент Из Клиенты Цикл
		
		СтрокиПокупки = Таблица.НайтиСтроки(Новый Структура("Партнер", Клиент.Партнер));
		
		// Товары последней покупки через запятую, склад - первый найденный
		Товары = Новый Массив;
		Склад  = Неопределено;
		Для Каждого СтрокаПокупки Из СтрокиПокупки Цикл
			Если Товары.Найти(СтрокаПокупки.НаименованиеНоменклатуры) = Неопределено Тогда
				Товары.Добавить(СтрокаПокупки.НаименованиеНоменклатуры);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Склад) Тогда
				Склад = СтрокаПокупки.Склад;
			КонецЕсли;
		КонецЦикла;
		
		Филиал = ДанныеФилиала(Склад, КэшСкладов);

		ПараметрыТекста = Новый Структура;
		ПараметрыТекста.Вставить("НаименованиеКлиента", Клиент.НаименованиеКлиента);
		ПараметрыТекста.Вставить("КоличествоДней", НастройкаОповещения.КоличествоДней);
		ПараметрыТекста.Вставить("Номенклатура", СтрСоединить(Товары, ", "));
		ПараметрыТекста.Вставить("ФіліяПокупки", Филиал.Наименование);
		ПараметрыТекста.Вставить("НомерТелефонуФіліїПокупки", Филиал.Телефон);
		ПараметрыТекста.Вставить("АдресаФіліїПокупки", Филиал.Адрес);
		
		Если ЕстьДанныеЛинз И СтрокиПокупки.Количество() > 0 Тогда
			ПараметрыТекста.Вставить("ДатаОкончания", Формат(СтрокиПокупки[0].ДатаОкончания, "ДФ=dd.MM.yyyy"));
			ПараметрыТекста.Вставить("КоличествоЛинз", Формат(СтрокиПокупки[0].ЛинзВсего, "ЧГ="));
		КонецЕсли;

		ОтправитьИЗафиксировать(Клиент.Партнер, Клиент.Телефон, НастройкаОповещения, ПараметрыТекста);

	КонецЦикла;
	
КонецПроцедуры

// Группы номенклатуры из ТЧ вида оповещения без пустых строк.
Функция ГруппыНоменклатурыВида(НастройкаОповещения)
	
	МассивГрупп = НастройкаОповещения.Ссылка.ГруппыНоменклатуры.ВыгрузитьКолонку("ГруппаНоменклатуры");
	
	Индекс = МассивГрупп.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если НЕ ЗначениеЗаполнено(МассивГрупп[Индекс]) Тогда
			МассивГрупп.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Возврат МассивГрупп;
	
КонецФункции

// Наименование, телефон и адрес склада (филиала) из ТЧ КонтактнаяИнформация.
// Кэширует результат, чтобы не читать один склад для каждого клиента.
Функция ДанныеФилиала(Склад, Кэш)
	
	Данные = Кэш.Получить(Склад);
	Если Данные <> Неопределено Тогда
		Возврат Данные;
	КонецЕсли;
	
	Данные = Новый Структура("Наименование, Телефон, Адрес", "", "", "");
	
	Если ЗначениеЗаполнено(Склад) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Склады.Наименование КАК Наименование,
			|	КИ.Тип КАК Тип,
			|	КИ.НомерТелефона КАК НомерТелефона,
			|	КИ.Представление КАК Представление
			|ИЗ
			|	Справочник.Склады КАК Склады
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады.КонтактнаяИнформация КАК КИ
			|		ПО (КИ.Ссылка = Склады.Ссылка)
			|ГДЕ
			|	Склады.Ссылка = &Склад
			|
			|УПОРЯДОЧИТЬ ПО
			|	КИ.НомерСтроки";
		Запрос.УстановитьПараметр("Склад", Склад);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Данные.Наименование = Выборка.Наименование;
			
			Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон
				И Данные.Телефон = "" Тогда
				// Для текста сообщения удобнее представление: +38 (097) 123-45-67
				Данные.Телефон = ?(ЗначениеЗаполнено(Выборка.Представление),
					Выборка.Представление, Выборка.НомерТелефона);
			ИначеЕсли Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес
				И Данные.Адрес = "" Тогда
				Данные.Адрес = Выборка.Представление;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Кэш.Вставить(Склад, Данные);
	Возврат Данные;
	
КонецФункции

// --- КАНАЛЫ ОТПРАВКИ ---

// Возвращает массив каналов в порядке приоритета (по порядку строк ТЧ КаналыОтправки).
// Если ТЧ пустая - по умолчанию Viber, затем SMS.
Функция ПолучитьКаналыОтправки(ВидОповещения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	К.Канал КАК Канал
		|ИЗ
		|	Справочник.tsms_ВидыОповещений.КаналыОтправки КАК К
		|ГДЕ
		|	К.Ссылка = &Ссылка
		|	И К.Канал <> ЗНАЧЕНИЕ(Перечисление.tsms_КаналыОтправки.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	К.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ВидОповещения);
	
	Каналы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Каналы.Найти(Выборка.Канал) = Неопределено Тогда
			Каналы.Добавить(Выборка.Канал);
		КонецЕсли;
	КонецЦикла;
	
	Если Каналы.Количество() = 0 Тогда
		Каналы.Добавить(Перечисления.tsms_КаналыОтправки.Viber);
		Каналы.Добавить(Перечисления.tsms_КаналыОтправки.SMS);
	КонецЕсли;
	
	Возврат Каналы;
	
КонецФункции

Функция ТекстДляКанала(Канал, НастройкаОповещения, ПараметрыТекста)
	
	Если Канал = Перечисления.tsms_КаналыОтправки.SMS Тогда
		Шаблон = НастройкаОповещения.ШаблонСообщения;
	ИначеЕсли Канал = Перечисления.tsms_КаналыОтправки.Viber Тогда
		Шаблон = НастройкаОповещения.ШаблонСообщенияViber;
	ИначеЕсли Канал = Перечисления.tsms_КаналыОтправки.Telegram Тогда
		Шаблон = НастройкаОповещения.ШаблонСообщенияTelegram;
	Иначе
		Шаблон = "";
	КонецЕсли;
	
	Возврат СокрЛП(ПодставитьПараметрыВШаблон(Шаблон, ПараметрыТекста));
	
КонецФункции

// --- ОТПРАВКА ---

//ДК: 16.11.2026
// Перебирает каналы по приоритету до первой успешной отправки.
// Viber, за которым сразу идёт SMS, отправляется одним гибридным запросом TurboSMS:
// SMS уйдёт только если Viber реально не будет доставлен.
// Карусель отправляется без гибрида: резервную SMS при недоставке шлёт ВыполнитьЭскалациюИРезервныеСМС.
Процедура ОтправитьИЗафиксировать(Партнер, Телефон, НастройкаОповещения, ПараметрыТекста)
	
	Запуск   = НастройкаОповещения.Запуск;
	Контекст = КонтекстЛога(НастройкаОповещения, Партнер);
	
	Запуск.Вставить("ПоследнийИДСообщения", "");
	
	Если НЕ ЗначениеЗаполнено(Телефон) Тогда
		Запуск.Пропущено = Запуск.Пропущено + 1;
		tsms_Логирование.Предупреждение(Перечисления.tsms_СобытияЛогирования.НетТелефона,
			СтрШаблон("Клієнт %1: не вказано номер телефону", Партнер), Контекст);
		Возврат;
	КонецЕсли;
	
	ПодготовленныйНомер = НормализоватьНомерТелефона(Телефон);
	Контекст.Вставить("НомерТелефона", Лев(ПодготовленныйНомер, 20));

	Если СтрДлина(ПодготовленныйНомер) <> 12 Или Не СтрНачинаетсяС(ПодготовленныйНомер, "380") Тогда
		Запуск.Пропущено = Запуск.Пропущено + 1;
		Контекст.Вставить("Подробности", СтрШаблон("Номер у картці клієнта: '%1'", Телефон));
		tsms_Логирование.Предупреждение(Перечисления.tsms_СобытияЛогирования.НекорректныйНомер,
			СтрШаблон("Клієнт %1: некоректний формат номера телефону", Партнер), Контекст);
		Возврат;
	КонецЕсли;
	
	МассивТелефонов = Новый Массив;
	МассивТелефонов.Добавить(ПодготовленныйНомер);
	
	КаналSMS      = Перечисления.tsms_КаналыОтправки.SMS;
	КаналViber    = Перечисления.tsms_КаналыОтправки.Viber;
	КаналTelegram = Перечисления.tsms_КаналыОтправки.Telegram;
	
	ТекстСМС      = ТекстДляКанала(КаналSMS, НастройкаОповещения, ПараметрыТекста);
	ТекстВайбер   = ТекстДляКанала(КаналViber, НастройкаОповещения, ПараметрыТекста);
	ТекстТелеграм = ТекстДляКанала(КаналTelegram, НастройкаОповещения, ПараметрыТекста);
	
	ПараметрыViber = Новый Структура;
	ПараметрыViber.Вставить("ИДКартинки", НастройкаОповещения.КартинкаViberИД);
	ПараметрыViber.Вставить("ТекстКнопки", НастройкаОповещения.КнопкаViberТекст);
	ПараметрыViber.Вставить("СсылкаКнопки", НастройкаОповещения.КнопкаViberСсылка);
	
	// Карусель: массив карточек в настройке
	Карусель = Неопределено;
	ЭтоКарусель = НастройкаОповещения.Свойство("Карусель", Карусель)
		И ТипЗнч(Карусель) = Тип("Массив") И Карусель.Количество() >= 2;
	Если ЭтоКарусель Тогда
		ПараметрыViber.Вставить("Карусель", Карусель);
	КонецЕсли;
	
	Каналы     = НастройкаОповещения.Каналы;
	Количество = Каналы.Количество();
	
	ОтправленныйТекст = "";
	КаналОтправки     = Неопределено;
	ИДСообщения       = "";
	ГибриднаяSMS      = "";
	РезервнаяСМС      = Ложь;
	
	Индекс = 0;
	Пока Индекс < Количество Цикл
		
		Канал = Каналы[Индекс];
		
		Если Канал = КаналViber И ТекстВайбер <> "" Тогда
			
			СледующийКаналSMS = (Индекс + 1 < Количество И Каналы[Индекс + 1] = КаналSMS);
			
			// Следующий по приоритету SMS - отправляем гибридно одним запросом (кроме карусели)
			ГибриднаяSMS = "";
			Если СледующийКаналSMS И Не ЭтоКарусель Тогда
				ГибриднаяSMS = ТекстСМС;
			КонецЕсли;
			
			Если ОтправитьЧерезTurboSMS(МассивТелефонов, ТекстВайбер, ГибриднаяSMS, ПараметрыViber, КаналViber, Контекст, ИДСообщения) Тогда
				ОтправленныйТекст = ТекстВайбер;
				КаналОтправки     = КаналViber;
				РезервнаяСМС      = (ЭтоКарусель И СледующийКаналSMS И ТекстСМС <> "");
				Прервать;
			КонецЕсли;
			// Запрос отклонён - идём к следующему каналу (в т.ч. к SMS отдельно)
			
		ИначеЕсли Канал = КаналSMS И ТекстСМС <> "" Тогда
			
			Если ОтправитьЧерезTurboSMS(МассивТелефонов, "", ТекстСМС, Неопределено, КаналSMS, Контекст, ИДСообщения) Тогда
				ОтправленныйТекст = ТекстСМС;
				КаналОтправки     = КаналSMS;
				Прервать;
			КонецЕсли;
			
		ИначеЕсли Канал = КаналTelegram И ТекстТелеграм <> "" Тогда
			
			Если ОтправитьЧерезTelegram(Партнер, Телефон, ТекстТелеграм) Тогда
				ОтправленныйТекст = ТекстТелеграм;
				КаналОтправки     = КаналTelegram;
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;

	// Неудачные попытки по каждому каналу уже записаны в лог в ОтправитьЧерезTurboSMS.
	Если КаналОтправки = Неопределено Тогда
		Запуск.Ошибок = Запуск.Ошибок + 1;
		Возврат;
	КонецЕсли;
	
	Запуск.Отправлено = Запуск.Отправлено + 1;
	Запуск.Вставить("ПоследнийИДСообщения", ИДСообщения);
	
	// --- Журнал сообщений (статусы, клики, эскалация, аналитика) ---
	ЭтоViber = (КаналОтправки = КаналViber);
	Сегодня  = НачалоДня(ТекущаяДатаСеанса());
	
	ДанныеЖурнала = Новый Структура;
	ДанныеЖурнала.Вставить("ИДСообщения", ИДСообщения);
	ДанныеЖурнала.Вставить("Партнер", Партнер);
	ДанныеЖурнала.Вставить("НомерТелефона", ПодготовленныйНомер);
	ДанныеЖурнала.Вставить("ВидОповещения", НастройкаОповещения.Ссылка);
	ДанныеЖурнала.Вставить("КаналПлановый", КаналОтправки);
	ДанныеЖурнала.Вставить("ТекстViber", ?(ЭтоViber, ТекстВайбер, ""));
	ДанныеЖурнала.Вставить("ТекстСМС", ?(ЭтоViber, ?(РезервнаяСМС, ТекстСМС, ГибриднаяSMS), ТекстСМС));
	ДанныеЖурнала.Вставить("РезервнаяСМС", РезервнаяСМС);
	ДанныеЖурнала.Вставить("ОтслеживатьКлики", ЭтоViber И (ЭтоКарусель
		Или ЗначениеЗаполнено(НастройкаОповещения.КнопкаViberТекст)
			И ЗначениеЗаполнено(НастройкаОповещения.КнопкаViberСсылка)));
	Если ЭтоViber И ЭтоКарусель Тогда
		ДанныеЖурнала.Вставить("ТипСообщения", Перечисления.tsms_ТипыViberСообщений.Карусель);
	КонецЕсли;
	
	// Эскалация: текст SMS фиксируем сейчас, чтобы через N дней клиент получил те же данные
	ЭскалацияВСМС = Ложь;
	Если ЭтоViber И НастройкаОповещения.Свойство("ЭскалацияВСМС", ЭскалацияВСМС) И ЭскалацияВСМС = Истина Тогда
		
		ШаблонЭскалации = "";
		НастройкаОповещения.Свойство("ШаблонСообщенияЭскалации", ШаблонЭскалации);
		ТекстЭскалации = СокрЛП(ПодставитьПараметрыВШаблон(Строка(ШаблонЭскалации), ПараметрыТекста));
		Если ТекстЭскалации = "" Тогда
			ТекстЭскалации = ТекстСМС;
		КонецЕсли;
		
		ЭскалацияЧерезДней = 0;
		НастройкаОповещения.Свойство("ЭскалацияЧерезДней", ЭскалацияЧерезДней);
		Если Не ЗначениеЗаполнено(ЭскалацияЧерезДней) Тогда
			ЭскалацияЧерезДней = 3;
		КонецЕсли;
		
		Если ТекстЭскалации <> "" Тогда
			ДанныеЖурнала.Вставить("ТекстСМСЭскалации", ТекстЭскалации);
			ДанныеЖурнала.Вставить("ЭскалироватьЧерезДней", ЭскалацияЧерезДней);
		КонецЕсли;
		
	КонецЕсли;
	
	// День рождения: после самой даты эскалация уже не нужна
	Если НастройкаОповещения.ВидСобытия = Перечисления.tsms_ВидыСобытийОповещений.ДеньРождения Тогда
		ДанныеЖурнала.Вставить("ДатаСобытия", Сегодня + НастройкаОповещения.КоличествоДней * 86400);
	КонецЕсли;
	
	// Ручная / тестовая отправка: способ, пользователь, ручная рассылка
	ЭтоРегламент = Истина;
	СпособОтправки = Неопределено;
	Если НастройкаОповещения.Свойство("СпособОтправки", СпособОтправки) И ЗначениеЗаполнено(СпособОтправки) Тогда
		ДанныеЖурнала.Вставить("СпособОтправки", СпособОтправки);
		ЭтоРегламент = Ложь;
	КонецЕсли;
	ДопДанныеЖурнала = Неопределено;
	Если НастройкаОповещения.Свойство("ДопДанныеЖурнала", ДопДанныеЖурнала)
		И ТипЗнч(ДопДанныеЖурнала) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из ДопДанныеЖурнала Цикл
			ДанныеЖурнала.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	tsms_Журнал.ЗаписатьСообщение(ДанныеЖурнала);
	
	// История (защита регламента от дублей) - только для регламентных отправок
	Если Не ЭтоРегламент Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.tsms_ИсторияОтправкиОповещений.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Сегодня;
	МенеджерЗаписи.Партнер = Партнер;
	МенеджерЗаписи.ВидОповещения = НастройкаОповещения.Ссылка;
	МенеджерЗаписи.ДатаОтправки = ТекущаяДатаСеанса();
	МенеджерЗаписи.НомерТелефона = ПодготовленныйНомер;
	МенеджерЗаписи.ТекстСообщения = ОтправленныйТекст;
	МенеджерЗаписи.Канал = КаналОтправки;
	
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		// Сообщение ушло, но не записалось в историю - завтра возможен дубль
		Контекст.Вставить("Канал", КаналОтправки);
		Контекст.Вставить("Подробности", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОшибкаЗаписиИстории,
			СтрШаблон("Клієнт %1: повідомлення відправлено, але не записано в історію", Партнер), Контекст);
	КонецПопытки;

КонецПроцедуры
//:ДК 16.11.2026

// Возвращает Истина, если TurboSMS принял сообщение. Неудача пишется в tsms_ЖурналЛогирования.
//ДК: 16.11.2026
//Функция ОтправитьЧерезTurboSMS(МассивТелефонов, ТекстВайбер, ТекстСМС, ПараметрыViber, Канал, Контекст)
Функция ОтправитьЧерезTurboSMS(МассивТелефонов, ТекстВайбер, ТекстСМС, ПараметрыViber, Канал, Контекст, ИДСообщения = "")
//:ДК 16.11.2026

	Если ТекстВайбер <> "" И ТекстСМС <> "" Тогда
		ОписаниеКанала = "viber+sms";
	ИначеЕсли ТекстВайбер <> "" Тогда
		ОписаниеКанала = "viber";
	Иначе
		ОписаниеКанала = "sms";
	КонецЕсли;
	
	КонтекстОшибки = Новый Структура;
	Для Каждого КлючИЗначение Из Контекст Цикл
		КонтекстОшибки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	КонтекстОшибки.Вставить("Канал", Канал);
	
	Партнер = Неопределено;
	Контекст.Свойство("Партнер", Партнер);
	
	Попытка
		Ответ = ИнтеграцияСТурбоСМС.ОтправитьСообщениеTurboSMSРасш(МассивТелефонов, ТекстВайбер, ТекстСМС, ПараметрыViber);
	Исключение
		КонтекстОшибки.Вставить("Подробности", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОшибкаОтправки,
			СтрШаблон("[%1] Клієнт %2: виняток під час відправки", ОписаниеКанала, Партнер), КонтекстОшибки);
		Возврат Ложь;
	КонецПопытки;
	
	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		КонтекстОшибки.Вставить("Подробности", СтрШаблон("Тип відповіді: %1", ТипЗнч(Ответ)));
		tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОшибкаОтправки,
			СтрШаблон("[%1] Клієнт %2: некоректна відповідь сервера TurboSMS", ОписаниеКанала, Партнер), КонтекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если ОтветTurboSMSУспешный(Ответ, ТекстОшибки) Тогда
		//ДК: 16.11.2026
		ИДСообщения = tsms_Журнал.ИДСообщенияИзОтвета(Ответ);
		//:ДК 16.11.2026
		Возврат Истина;
	КонецЕсли;
	
	КонтекстОшибки.Вставить("Подробности", ОтветВСтроку(Ответ));
	tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОшибкаОтправки,
		СтрШаблон("[%1] Клієнт %2: не вдалося відправити. Статус: %3", ОписаниеКанала, Партнер, ТекстОшибки),
		КонтекстОшибки);
	
	Возврат Ложь;
	
КонецФункции

// Ответ TurboSMS (Соответствие) в JSON-строку для поля Подробности.
Функция ОтветВСтроку(Ответ)
	
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
		ЗаписатьJSON(ЗаписьJSON, Ответ);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Возврат Строка(Ответ);
	КонецПопытки;
	
КонецФункции

// Базовый контекст для tsms_Логирование: запуск, вид оповещения и (необязательно) партнер.
Функция КонтекстЛога(НастройкаОповещения, Партнер = Неопределено)
	
	Контекст = Новый Структура;
	
	Запуск = Неопределено;
	Если НастройкаОповещения.Свойство("Запуск", Запуск) И ТипЗнч(Запуск) = Тип("Структура") Тогда
		Контекст.Вставить("ИдентификаторЗапуска", Запуск.ИдентификаторЗапуска);
	КонецЕсли;
	
	Контекст.Вставить("ВидОповещения", НастройкаОповещения.Ссылка);
	
	Если Партнер <> Неопределено Тогда
		Контекст.Вставить("Партнер", Партнер);
	КонецЕсли;
	
	Возврат Контекст;
	
КонецФункции

