//ДК: 16.11.2026
// Карточки карусели вида оповещения в формате TurboSMS.
// Возвращает Неопределено, если тип сообщения не "Карусель" или карточек меньше двух.
Функция КарусельВида(ВидОповещения) Экспорт
	
	Если ВидОповещения.ТипViberСообщения <> Перечисления.tsms_ТипыViberСообщений.Карусель Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат КарусельИзСтрок(ВидОповещения.КарточкиКарусели);
	
КонецФункции

// Строки - табличная часть КарточкиКарусели (объекта или данных формы).
Функция КарусельИзСтрок(Строки) Экспорт
	
	Карусель = Новый Массив;
	
	Для Каждого СтрокаКарточки Из Строки Цикл
		
		Карточка = Новый Структура;
		Карточка.Вставить("title", Лев(СокрЛП(СтрокаКарточки.Заголовок), 38));
		Карточка.Вставить("file_id", СтрокаКарточки.КартинкаИД);
		Карточка.Вставить("button_caption", Лев(СокрЛП(СтрокаКарточки.ТекстКнопки), 10));
		Карточка.Вставить("button_url", СокрЛП(СтрокаКарточки.СсылкаКнопки));
		
		Если ЗначениеЗаполнено(СтрокаКарточки.ТекстСсылки) И ЗначениеЗаполнено(СтрокаКарточки.АдресСсылки) Тогда
			Карточка.Вставить("link_caption", Лев(СокрЛП(СтрокаКарточки.ТекстСсылки), 12));
			Карточка.Вставить("link_url", СокрЛП(СтрокаКарточки.АдресСсылки));
		КонецЕсли;
		
		Карусель.Добавить(Карточка);
		
	КонецЦикла;
	
	Возврат ?(Карусель.Количество() >= 2 И Карусель.Количество() <= 5, Карусель, Неопределено);
	
КонецФункции
