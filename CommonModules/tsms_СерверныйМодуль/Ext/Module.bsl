#Область ПроцедурыРегламентногоЗадания

// Процедура вызывается регламентным заданием tsms_ОбработкаОповещений
Процедура ВыполнитьРассылкуОповещений() Экспорт

	ЗапросВиды = Новый Запрос;
	ЗапросВиды.Текст = 
		"ВЫБРАТЬ
		|	Виды.Ссылка КАК Ссылка,
		|	Виды.ВидСобытия КАК ВидСобытия,
		|	Виды.КоличествоДней КАК КоличествоДней,
		|	Виды.ВидНоменклатуры КАК ВидНоменклатуры,
		|	Виды.ЗначениеРежимаЗамены КАК ЗначениеРежимаЗамены,
		|	Виды.РасчетПоЗапасуЛинз КАК РасчетПоЗапасуЛинз,
		//ДК: 17.11.2026
		|	Виды.ПродажаВЛинзах КАК ПродажаВЛинзах,
		//:ДК 17.11.2026
		|	Виды.ШаблонСообщения КАК ШаблонСообщения,
		|	Виды.ШаблонСообщенияViber КАК ШаблонСообщенияViber,
		|	Виды.ШаблонСообщенияTelegram КАК ШаблонСообщенияTelegram,
		|	Виды.КартинкаViberИД КАК КартинкаViberИД,
		|	Виды.КнопкаViberТекст КАК КнопкаViberТекст,
		|	Виды.КнопкаViberСсылка КАК КнопкаViberСсылка,
		|	// ДК: 29.10.2026
		//ДК: 16.11.2026
		//|	Виды.КаналПродаж КАК КаналПродаж
		|	Виды.КаналПродаж КАК КаналПродаж,
		|	Виды.ЭскалацияВСМС КАК ЭскалацияВСМС,
		|	Виды.ЭскалацияЧерезДней КАК ЭскалацияЧерезДней,
		|	Виды.ШаблонСообщенияЭскалации КАК ШаблонСообщенияЭскалации
		//:ДК 16.11.2026
		|	// :ДК 29.10.2026
		|ИЗ
		|	Справочник.tsms_ВидыОповещений КАК Виды
		|ГДЕ
		|	Виды.Использовать = ИСТИНА";

	// Контекст запуска: общий для всех видов, счётчики накапливаются по ссылке
	Запуск = Новый Структура;
	Запуск.Вставить("ИдентификаторЗапуска", Новый УникальныйИдентификатор);
	Запуск.Вставить("Отправлено", 0);
	Запуск.Вставить("Ошибок", 0);
	Запуск.Вставить("Пропущено", 0);
	
	КонтекстЗапуска = Новый Структура("ИдентификаторЗапуска", Запуск.ИдентификаторЗапуска);
	
	tsms_Логирование.Информация(Перечисления.tsms_СобытияЛогирования.НачалоРассылки,
		"Початок розсилки", КонтекстЗапуска);
	
	//ДК: 16.11.2026
	// Сначала свежие статусы вчерашних сообщений, затем эскалация, затем новые оповещения
	Попытка
		tsms_Журнал.ОбновитьСтатусы();
		ВыполнитьЭскалациюИРезервныеСМС(Запуск.ИдентификаторЗапуска);
	Исключение
		КонтекстОшибки = Новый Структура("ИдентификаторЗапуска, Подробности",
			Запуск.ИдентификаторЗапуска, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.Эскалация,
			"Помилка оновлення статусів / ескалації", КонтекстОшибки);
	КонецПопытки;
	//:ДК 16.11.2026
	
	РезультатЗапроса = ЗапросВиды.Выполнить();
	ВыборкаВидов = РезультатЗапроса.Выбрать();

	Пока ВыборкаВидов.Следующий() Цикл
		
		// Собираем настройку в структуру, чтобы добавить к ней список каналов
		НастройкаОповещения = Новый Структура;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			НастройкаОповещения.Вставить(Колонка.Имя, ВыборкаВидов[Колонка.Имя]);
		КонецЦикла;
		НастройкаОповещения.Вставить("Каналы", ПолучитьКаналыОтправки(ВыборкаВидов.Ссылка));
		НастройкаОповещения.Вставить("Запуск", Запуск);
        //ДК: 16.11.2026
		НастройкаОповещения.Вставить("Карусель", КарусельВида(ВыборкаВидов.Ссылка));
		//:ДК 16.11.2026
		
		// Ошибка в одном виде не должна останавливать остальные
		Попытка
			
			Если НастройкаОповещения.ВидСобытия = Перечисления.tsms_ВидыСобытийОповещений.ДеньРождения Тогда
				ОбработатьДниРождения(НастройкаОповещения);
			ИначеЕсли НастройкаОповещения.ВидСобытия = Перечисления.tsms_ВидыСобытийОповещений.СрокПослеПокупки Тогда
				Если НастройкаОповещения.РасчетПоЗапасуЛинз Тогда
					ОбработатьОповещенияПоЗапасуЛинз(НастройкаОповещения);
				Иначе
					ОбработатьОповещенияПоПокупкам(НастройкаОповещения);
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			
			Запуск.Ошибок = Запуск.Ошибок + 1;
			
			Контекст = КонтекстЛога(НастройкаОповещения);
			Контекст.Вставить("Подробности", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОшибкаВыполнения,
				СтрШаблон("Помилка обробки виду сповіщення ""%1""", НастройкаОповещения.Ссылка), Контекст);
			
		КонецПопытки;

	КонецЦикла;
	
	Итог = СтрШаблон("Завершено. Відправлено: %1, помилок: %2, пропущено: %3",
		Запуск.Отправлено, Запуск.Ошибок, Запуск.Пропущено);
	
	Если Запуск.Ошибок > 0 Тогда
		tsms_Логирование.Предупреждение(Перечисления.tsms_СобытияЛогирования.ОкончаниеРассылки,
			Итог, КонтекстЗапуска);
	Иначе
		tsms_Логирование.Информация(Перечисления.tsms_СобытияЛогирования.ОкончаниеРассылки,
			Итог, КонтекстЗапуска);
	КонецЕсли;

КонецПроцедуры

//ДК: 16.11.2026
// Отправляет SMS по сообщениям из tsms_Журнал.КандидатыНаСМС:
// эскалация непрочитанных Viber и резервные SMS для недоставленных каруселей.
// ТолькоРезервные = Истина - без эскалации (для ежечасной обработки статусов).
Процедура ВыполнитьЭскалациюИРезервныеСМС(ИдентификаторЗапуска = Неопределено, ТолькоРезервные = Ложь) Экспорт
	
	Кандидаты = tsms_Журнал.КандидатыНаСМС(ТолькоРезервные);
	Если Кандидаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Клиент мог прочитать сообщение за минуту до эскалации - перечитываем статусы и отбираем заново
	tsms_Журнал.ОбновитьСтатусыПоСписку(Кандидаты.ВыгрузитьКолонку("ИДСообщения"));
	Кандидаты = tsms_Журнал.КандидатыНаСМС(ТолькоРезервные);
	
	КаналSMS   = Перечисления.tsms_КаналыОтправки.SMS;
	Эскалаций  = 0;
	Резервных  = 0;
	Ошибок     = 0;
	
	Для Каждого Кандидат Из Кандидаты Цикл
		
		Текст = СокрЛП(Кандидат.Текст);
		Если Текст = "" Или Не ЗначениеЗаполнено(Кандидат.НомерТелефона) Тогда
			Продолжить;
		КонецЕсли;
		
		Контекст = Новый Структура;
		Если ИдентификаторЗапуска <> Неопределено Тогда
			Контекст.Вставить("ИдентификаторЗапуска", ИдентификаторЗапуска);
		КонецЕсли;
		Контекст.Вставить("ВидОповещения", Кандидат.ВидОповещения);
		Контекст.Вставить("Партнер", Кандидат.Партнер);
		Контекст.Вставить("НомерТелефона", Кандидат.НомерТелефона);
		
		МассивТелефонов = Новый Массив;
		МассивТелефонов.Добавить(Кандидат.НомерТелефона);
		
		ИДНового = "";
		Если ОтправитьЧерезTurboSMS(МассивТелефонов, "", Текст, Неопределено, КаналSMS, Контекст, ИДНового) Тогда
			tsms_Журнал.ЗаписатьСМСПоИсходному(Кандидат.ИДСообщения, ИДНового, Текст, Кандидат.ЭтоЭскалация);
			Если Кандидат.ЭтоЭскалация Тогда
				Эскалаций = Эскалаций + 1;
			Иначе
				Резервных = Резервных + 1;
			КонецЕсли;
		Иначе
			// Ошибка уже в логе; сообщение останется кандидатом на следующий запуск
			Ошибок = Ошибок + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Эскалаций + Резервных + Ошибок > 0 Тогда
		КонтекстИтога = Новый Структура;
		Если ИдентификаторЗапуска <> Неопределено Тогда
			КонтекстИтога.Вставить("ИдентификаторЗапуска", ИдентификаторЗапуска);
		КонецЕсли;
		tsms_Логирование.Информация(Перечисления.tsms_СобытияЛогирования.Эскалация,
			СтрШаблон("Ескалацій відправлено: %1, резервних SMS: %2, помилок: %3", Эскалаций, Резервных, Ошибок),
			КонтекстИтога);
	КонецЕсли;
	
КонецПроцедуры
