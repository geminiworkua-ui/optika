// Настройка оповещения по ссылке на вид - в том же формате, что в ВыполнитьРассылкуОповещений.
Функция НастройкаОповещенияПоВиду(ВидОповещения) Экспорт
	
	Настройка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидОповещения,
		"ВидСобытия, КоличествоДней, ШаблонСообщения, ШаблонСообщенияViber, ШаблонСообщенияTelegram, "
		+ "КартинкаViberИД, КнопкаViberТекст, КнопкаViberСсылка, "
		+ "ЭскалацияВСМС, ЭскалацияЧерезДней, ШаблонСообщенияЭскалации");
	
	Запуск = Новый Структура;
	Запуск.Вставить("ИдентификаторЗапуска", Новый УникальныйИдентификатор);
	Запуск.Вставить("Отправлено", 0);
	Запуск.Вставить("Ошибок", 0);
	Запуск.Вставить("Пропущено", 0);
	Запуск.Вставить("ПоследнийИДСообщения", "");
	
	Настройка.Вставить("Ссылка", ВидОповещения);
	Настройка.Вставить("Каналы", ПолучитьКаналыОтправки(ВидОповещения));
	Настройка.Вставить("Запуск", Запуск);
	Настройка.Вставить("Карусель", КарусельВида(ВидОповещения));
	
	Возврат Настройка;
	
КонецФункции

// Отправляет одно сообщение по настройке. Возвращает message_id или "" при неудаче.
// В настройке должен быть заполнен СпособОтправки (Ручная / Тестовая).
Функция ОтправитьПоНастройке(Партнер, Телефон, НастройкаОповещения, ПараметрыТекста) Экспорт
	
	ОтправитьИЗафиксировать(Партнер, Телефон, НастройкаОповещения, ПараметрыТекста);
	
	Возврат НастройкаОповещения.Запуск.ПоследнийИДСообщения;
	
КонецФункции

// Параметры шаблона для ручной рассылки: клиент и филиал его последней покупки.
Функция ПараметрыТекстаРучнойРассылки(НаименованиеКлиента, Склад, КэшСкладов) Экспорт
	
	Филиал = ДанныеФилиала(Склад, КэшСкладов);
	
	ПараметрыТекста = Новый Структура;
	ПараметрыТекста.Вставить("НаименованиеКлиента", НаименованиеКлиента);
	ПараметрыТекста.Вставить("ФіліяПокупки", Филиал.Наименование);
	ПараметрыТекста.Вставить("НомерТелефонуФіліїПокупки", Филиал.Телефон);
	ПараметрыТекста.Вставить("АдресаФіліїПокупки", Филиал.Адрес);
	
	Возврат ПараметрыТекста;
	
КонецФункции

// Тексты сообщения по настройке без отправки (предпросмотр).
Функция ТекстыПоНастройке(НастройкаОповещения, ПараметрыТекста) Экспорт
	
	Тексты = Новый Структура;
	Тексты.Вставить("Viber", ТекстДляКанала(Перечисления.tsms_КаналыОтправки.Viber, НастройкаОповещения, ПараметрыТекста));
	Тексты.Вставить("СМС", ТекстДляКанала(Перечисления.tsms_КаналыОтправки.SMS, НастройкаОповещения, ПараметрыТекста));
	
	Возврат Тексты;
	
КонецФункции
