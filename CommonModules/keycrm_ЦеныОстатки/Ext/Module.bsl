// В РС keycrm_СоответствиеВариантов хранится последнее отправленное значение цены и остатка.
// Текущее значение сравнивается с отправленным прямо в запросе, в KeyCRM уходят только отличия.
// Поэтому неважно, как часто Диггер перепроводит документы: если цифра не изменилась - запроса не будет.

//ДК: 13.11.2026

#Область ПрограммныйИнтерфейс

// Выгружает цены вариантов.
//
// Параметры:
//  ТолькоИзменения - Булево - Истина: только отличающиеся от отправленных; Ложь: все по отбору
//  Отбор - Массив, Неопределено - элементы и группы номенклатуры (для ручной выгрузки)
//
// Возвращаемое значение:
//  Строка - итог для журнала (пустая строка, если отправлять нечего)
//
Функция ВыгрузитьЦены(Контекст, ТолькоИзменения, Отбор) Экспорт

	Параметры = Контекст.Настройка;

	Если Не ЗначениеЗаполнено(Параметры.ВидЦены) Тогда
		keycrm_Логирование.Ошибка("Цены", "В настройке обмена не указан вид цен", Контекст);
		Возврат "цены: не указан вид цен";
	КонецЕсли;

	Если Отбор = Неопределено Тогда
		Отбор = Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Цены.Номенклатура КАК Номенклатура,
		|	Цены.Характеристика КАК Характеристика,
		|	Цены.Цена КАК Цена
		|ПОМЕСТИТЬ ВтЦены
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены = &ВидЦены) КАК Цены
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вложенный.Номенклатура КАК Номенклатура,
		|	Вложенный.Характеристика КАК Характеристика,
		|	Вложенный.SKU КАК SKU,
		|	Вложенный.ИДВарианта КАК ИДВарианта,
		|	Вложенный.НоваяЦена КАК НоваяЦена
		|ИЗ
		|	(ВЫБРАТЬ
		|		Варианты.Номенклатура КАК Номенклатура,
		|		Варианты.Характеристика КАК Характеристика,
		|		Варианты.SKU КАК SKU,
		|		Варианты.ИДВарианта КАК ИДВарианта,
		|		Варианты.Цена КАК Цена,
		|		Варианты.ЦенаОтправлена КАК ЦенаОтправлена,
		|		ЕСТЬNULL(ЦеныХарактеристик.Цена, ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0)) КАК НоваяЦена
		|	ИЗ
		|		РегистрСведений.keycrm_СоответствиеВариантов КАК Варианты
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВтЦены КАК ЦеныХарактеристик
		|			ПО Варианты.Номенклатура = ЦеныХарактеристик.Номенклатура
		|				И Варианты.Характеристика = ЦеныХарактеристик.Характеристика
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВтЦены КАК ЦеныНоменклатуры
		|			ПО Варианты.Номенклатура = ЦеныНоменклатуры.Номенклатура
		|				И (ЦеныНоменклатуры.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|	ГДЕ
		|		(&БезОтбора
		|				ИЛИ Варианты.Номенклатура В ИЕРАРХИИ (&Отбор))) КАК Вложенный
		|ГДЕ
		|	Вложенный.НоваяЦена > 0
		|	И (НЕ &ТолькоИзменения
		|			ИЛИ НЕ Вложенный.ЦенаОтправлена
		|			ИЛИ Вложенный.Цена <> Вложенный.НоваяЦена)";
	Запрос.УстановитьПараметр("ВидЦены", Параметры.ВидЦены);
	Запрос.УстановитьПараметр("ТолькоИзменения", ТолькоИзменения);
	Запрос.УстановитьПараметр("БезОтбора", Отбор.Количество() = 0);
	Запрос.УстановитьПараметр("Отбор", Отбор);

	Изменения = Запрос.Выполнить().Выгрузить();
	Если Изменения.Количество() = 0 Тогда
		Возврат ?(ТолькоИзменения, "", "цены: нет данных для выгрузки");
	КонецЕсли;

	Отправлено = 0;
	Ошибок = 0;
	РазмерПачки = 100;
	Пачка = Новый Массив;

	Для Индекс = 0 По Изменения.Количество() - 1 Цикл

		Пачка.Добавить(Изменения[Индекс]);

		Если Пачка.Количество() = РазмерПачки Или Индекс = Изменения.Количество() - 1 Тогда

			МассивТел = Новый Массив;
			Для Каждого СтрокаПачки Из Пачка Цикл
				// Вариант указывается либо по id, либо по sku (оба сразу нельзя: sku - изменяемое поле)
				ТелоВарианта = Новый Структура;
				Если СтрокаПачки.ИДВарианта > 0 Тогда
					ТелоВарианта.Вставить("id", СтрокаПачки.ИДВарианта);
				Иначе
					ТелоВарианта.Вставить("sku", СокрЛП(СтрокаПачки.SKU));
				КонецЕсли;
				ТелоВарианта.Вставить("price", СтрокаПачки.НоваяЦена);
				МассивТел.Добавить(ТелоВарианта);
			КонецЦикла;

			Ответ = keycrm_API.ВыполнитьЗапрос(Контекст, "PUT", "/offers", Новый Структура("offers", МассивТел));

			Если Ответ.Успех Тогда
				ОтметитьОтправку(Пачка, "Цена");
				Отправлено = Отправлено + Пачка.Количество();
				keycrm_Логирование.Информация("Цены", "Отправлены цены: " + Формат(Пачка.Количество(), "ЧН=0; ЧГ=0")
					+ " вариантов", Контекст, , Ответ.ТелоЗапроса);
			Иначе
				Ошибок = Ошибок + 1;
				keycrm_Логирование.Ошибка("Цены", "Ошибка отправки цен (" + Формат(Пачка.Количество(), "ЧН=0; ЧГ=0")
					+ " вариантов)", Контекст, , Ответ.ОписаниеОшибки + Символы.ПС + Ответ.ТелоЗапроса);
			КонецЕсли;

			Пачка = Новый Массив;

		КонецЕсли;

	КонецЦикла;

	Возврат "цены: отправлено " + Формат(Отправлено, "ЧН=0; ЧГ=0")
		+ ?(Ошибок = 0, "", ", пачек с ошибками " + Формат(Ошибок, "ЧН=0; ЧГ=0"));

КонецФункции

// Выгружает свободные остатки вариантов на склад KeyCRM.
// Остаток = (ВНаличии - ВРезервеСоСклада - ВРезервеПодЗаказ) по складам из настройки, не меньше нуля.
//
// Параметры:
//  ТолькоИзменения - Булево - Истина: только отличающиеся от отправленных; Ложь: все по отбору
//  Отбор - Массив, Неопределено - элементы и группы номенклатуры (для ручной выгрузки)
//
Функция ВыгрузитьОстатки(Контекст, ТолькоИзменения, Отбор) Экспорт

	Параметры = Контекст.Настройка;

	Если Параметры.ИДСкладаKeyCRM <= 0 Тогда
		keycrm_Логирование.Ошибка("Остатки", "В настройке обмена не указан ID склада KeyCRM", Контекст);
		Возврат "остатки: не указан ID склада KeyCRM";
	КонецЕсли;

	Если Отбор = Неопределено Тогда
		Отбор = Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Характеристика КАК Характеристика,
		|	СУММА(Остатки.ВНаличииОстаток - Остатки.ВРезервеСоСкладаОстаток - Остатки.ВРезервеПодЗаказОстаток) КАК Доступно
		|ПОМЕСТИТЬ ВтОстатки
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(
		|			,
		|			&ВсеСклады
		|				ИЛИ Склад В (&Склады)) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура,
		|	Остатки.Характеристика
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вложенный.Номенклатура КАК Номенклатура,
		|	Вложенный.Характеристика КАК Характеристика,
		|	Вложенный.SKU КАК SKU,
		|	Вложенный.ИДВарианта КАК ИДВарианта,
		|	Вложенный.Остаток КАК ПрежнийОстаток,
		|	Вложенный.ОстатокОтправлен КАК ОстатокОтправлен,
		|	Вложенный.НовыйОстаток КАК НовыйОстаток
		|ИЗ
		|	(ВЫБРАТЬ
		|		Варианты.Номенклатура КАК Номенклатура,
		|		Варианты.Характеристика КАК Характеристика,
		|		Варианты.SKU КАК SKU,
		|		Варианты.ИДВарианта КАК ИДВарианта,
		|		Варианты.Остаток КАК Остаток,
		|		Варианты.ОстатокОтправлен КАК ОстатокОтправлен,
		|		ВЫБОР
		|			КОГДА ЕСТЬNULL(Остатки.Доступно, 0) > 0
		|				ТОГДА ЕСТЬNULL(Остатки.Доступно, 0)
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК НовыйОстаток
		|	ИЗ
		|		РегистрСведений.keycrm_СоответствиеВариантов КАК Варианты
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВтОстатки КАК Остатки
		|			ПО Варианты.Номенклатура = Остатки.Номенклатура
		|				И Варианты.Характеристика = Остатки.Характеристика
		|	ГДЕ
		|		(&БезОтбора
		|				ИЛИ Варианты.Номенклатура В ИЕРАРХИИ (&Отбор))) КАК Вложенный
		|ГДЕ
		|	(НЕ &ТолькоИзменения
		|			ИЛИ НЕ Вложенный.ОстатокОтправлен
		|			ИЛИ Вложенный.Остаток <> Вложенный.НовыйОстаток)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.keycrm_СоответствиеВариантов КАК Варианты
		|ГДЕ
		|	Варианты.ОстатокОтправлен
		|	И Варианты.Остаток > 0";
	Запрос.УстановитьПараметр("ВсеСклады", Параметры.Склады.Количество() = 0);
	Запрос.УстановитьПараметр("Склады", Параметры.Склады);
	Запрос.УстановитьПараметр("ТолькоИзменения", ТолькоИзменения);
	Запрос.УстановитьПараметр("БезОтбора", Отбор.Количество() = 0);
	Запрос.УстановитьПараметр("Отбор", Отбор);

	Пакет = Запрос.ВыполнитьПакет();

	Изменения = Пакет[1].Выгрузить();
	Если Изменения.Количество() = 0 Тогда
		Возврат ?(ТолькоИзменения, "", "остатки: нет данных для выгрузки");
	КонецЕсли;

	// Защита от массового обнуления (например, остатки прочитаны посреди загрузки из Диггера):
	// если обнуляется больше половины всех положительных остатков и это больше 100 позиций - не отправляем.
	Если ТолькоИзменения Тогда

		БылоПоложительных = 0;
		ВыборкаКоличества = Пакет[2].Выбрать();
		Если ВыборкаКоличества.Следующий() Тогда
			БылоПоложительных = ВыборкаКоличества.Количество;
		КонецЕсли;

		Обнуляется = 0;
		Для Каждого СтрокаИзменения Из Изменения Цикл
			Если СтрокаИзменения.ОстатокОтправлен И СтрокаИзменения.ПрежнийОстаток > 0
				И СтрокаИзменения.НовыйОстаток = 0 Тогда
				Обнуляется = Обнуляется + 1;
			КонецЕсли;
		КонецЦикла;

		Если Обнуляется > 100 И Обнуляется * 2 > БылоПоложительных Тогда
			keycrm_Логирование.Предупреждение("Остатки",
				"Выгрузка остатков пропущена: обнуляется " + Формат(Обнуляется, "ЧН=0; ЧГ=0") + " из "
				+ Формат(БылоПоложительных, "ЧН=0; ЧГ=0") + " позиций с остатком. Если это верно - выполните ""Выгрузить цены и остатки полностью"" из обработки",
				Контекст);
			Возврат "остатки: пропущены (массовое обнуление)";
		КонецЕсли;

	КонецЕсли;

	Отправлено = 0;
	Ошибок = 0;
	РазмерПачки = 500;
	Пачка = Новый Массив;

	Для Индекс = 0 По Изменения.Количество() - 1 Цикл

		Пачка.Добавить(Изменения[Индекс]);

		Если Пачка.Количество() = РазмерПачки Или Индекс = Изменения.Количество() - 1 Тогда

			МассивТел = Новый Массив;
			Для Каждого СтрокаПачки Из Пачка Цикл
				ТелоОстатка = Новый Структура;
				Если СтрокаПачки.ИДВарианта > 0 Тогда
					ТелоОстатка.Вставить("id", СтрокаПачки.ИДВарианта);
				Иначе
					ТелоОстатка.Вставить("sku", СокрЛП(СтрокаПачки.SKU));
				КонецЕсли;
				ТелоОстатка.Вставить("quantity", СтрокаПачки.НовыйОстаток);
				МассивТел.Добавить(ТелоОстатка);
			КонецЦикла;

			ТелоЗапроса = Новый Структура;
			ТелоЗапроса.Вставить("warehouse_id", Параметры.ИДСкладаKeyCRM);
			ТелоЗапроса.Вставить("stocks", МассивТел);

			Ответ = keycrm_API.ВыполнитьЗапрос(Контекст, "PUT", "/offers/stocks", ТелоЗапроса);

			Если Ответ.Успех Тогда
				ОтметитьОтправку(Пачка, "Остаток");
				Отправлено = Отправлено + Пачка.Количество();
				keycrm_Логирование.Информация("Остатки", "Отправлены остатки: " + Формат(Пачка.Количество(), "ЧН=0; ЧГ=0")
					+ " вариантов", Контекст, , Ответ.ТелоЗапроса);
			Иначе
				Ошибок = Ошибок + 1;
				keycrm_Логирование.Ошибка("Остатки", "Ошибка отправки остатков (" + Формат(Пачка.Количество(), "ЧН=0; ЧГ=0")
					+ " вариантов)", Контекст, , Ответ.ОписаниеОшибки + Символы.ПС + Ответ.ТелоЗапроса);
			КонецЕсли;

			Пачка = Новый Массив;

		КонецЕсли;

	КонецЦикла;

	Возврат "остатки: отправлено " + Формат(Отправлено, "ЧН=0; ЧГ=0")
		+ ?(Ошибок = 0, "", ", пачек с ошибками " + Формат(Ошибок, "ЧН=0; ЧГ=0"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запоминает в регистре соответствий отправленные значения.
//
// Параметры:
//  Пачка - Массив из СтрокаТаблицыЗначений - строки результата запроса
//  Вид   - Строка - "Цена" или "Остаток"
//
Процедура ОтметитьОтправку(Пачка, Вид)

	ДатаОтправки = ТекущаяДатаСеанса();

	НачатьТранзакцию();
	Попытка

		Для Каждого СтрокаПачки Из Пачка Цикл

			МЗ = РегистрыСведений.keycrm_СоответствиеВариантов.СоздатьМенеджерЗаписи();
			МЗ.Номенклатура   = СтрокаПачки.Номенклатура;
			МЗ.Характеристика = СтрокаПачки.Характеристика;
			МЗ.Прочитать();
			Если Не МЗ.Выбран() Тогда
				Продолжить;
			КонецЕсли;

			Если Вид = "Цена" Тогда
				МЗ.Цена           = СтрокаПачки.НоваяЦена;
				МЗ.ЦенаОтправлена = Истина;
				МЗ.ДатаЦены       = ДатаОтправки;
			Иначе
				МЗ.Остаток          = СтрокаПачки.НовыйОстаток;
				МЗ.ОстатокОтправлен = Истина;
				МЗ.ДатаОстатка      = ДатаОтправки;
			КонецЕсли;

			МЗ.Записать();

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

