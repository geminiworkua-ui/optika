Функция ТекстЗапросаДобавитьОтборПоРеквизитуЗначению(НаименованиеОбъекта, ТекстЗапроса, НаименованиеРеквизита)
	ТекстЗапроса = ВРег(ТекстЗапроса);
	Результат = СтрНайти(ТекстЗапроса, "ГДЕ "); 
	
	Если Результат =0 Тогда
		Возврат ТекстЗапроса +" ГДЕ " + НаименованиеОбъекта +"." +НаименованиеРеквизита +" = &" +НаименованиеРеквизита;
    Иначе
		Возврат ТекстЗапроса +" И " + НаименованиеОбъекта +"." +НаименованиеРеквизита +" = &" +НаименованиеРеквизита; 
	КонецЕсли;
	
КонецФункции 

