Функция СоздатьКонтактноеЛицоКонтрагентаСлужбыДоставки(СтруктураНастроек, СтруктураКонтактногоЛица) Экспорт

	Если СтруктураНастроек.Настройки.ДействиеПриНеуспешномПоискеПолучателя = "СоздатьПолучателя" Тогда 
		
		Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
			
			Возврат НайтиСоздатьЭлементСправочника(СтруктураКонтактногоЛица, "eComm_КонтактныеЛицаКонтрагентовДоставки");
			
		ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
			
			КонтактноеЛицоОбъект = Справочники.eComm_КонтактныеЛицаКонтрагентовДоставки.СоздатьЭлемент();
			КонтактноеЛицоОбъект.Владелец = СтруктураКонтактногоЛица.Контрагент;
			ЗаполнитьЗначенияСвойств(КонтактноеЛицоОбъект, СтруктураКонтактногоЛица);
			КонтактноеЛицоОбъект.УстановитьНовыйКод();
			
			НовАдрес = КонтактноеЛицоОбъект.Адреса.Добавить();
			НовАдрес.Адрес 			= СтруктураКонтактногоЛица.АдресДоставки;
			НовАдрес.ОсновнойАдрес 	= Истина;
			
			КонтактноеЛицоОбъект.Записать();
		
 		ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
			
			КонтактноеЛицоОбъект = Справочники.eComm_КонтактныеЛицаКонтрагентовДоставки.СоздатьЭлемент();
			КонтактноеЛицоОбъект.Владелец = СтруктураКонтактногоЛица.КонтрагентДоставки;
			ЗаполнитьЗначенияСвойств(КонтактноеЛицоОбъект, СтруктураКонтактногоЛица);
			КонтактноеЛицоОбъект.Записать();

		КонецЕсли;
		
		Возврат КонтактноеЛицоОбъект.Ссылка;
		
	КонецЕсли;

КонецФункции

Функция ВернутьМассивНомеровТелефонов(Телефон) Экспорт

	МассивНомеров = Новый Массив;
	
	ТелефонБезРазделителей = "";
	Для а = 1 По СтрДлина(Телефон) Цикл
		КодСимвола = КодСимвола(Сред(Телефон, а, 1));
		Цифра = Сред(Телефон, а, 1);
		Если (КодСимвола >= 48 И КодСимвола <= 57) Тогда
			ТелефонБезРазделителей = ТелефонБезРазделителей + Цифра;
		КонецЕсли; 
	КонецЦикла;
	
	МассивНомеров.Добавить(ТелефонБезРазделителей);
	
	ДлинаНомера = СтрДлина(ТелефонБезРазделителей);
	
	Если ДлинаНомера > 10 
		И Сред(ТелефонБезРазделителей, ДлинаНомера - 10, 1) = "8" Тогда 
		Для Сч = 10 По ДлинаНомера Цикл 
			МассивНомеров.Добавить(Прав(ТелефонБезРазделителей, Сч));
		КонецЦикла;
		
	ИначеЕсли ДлинаНомера = 10 Тогда 
		МассивНомеров.Добавить(	"8" + ТелефонБезРазделителей);
		МассивНомеров.Добавить("38" + ТелефонБезРазделителей);
	КонецЕсли;
	
	Возврат МассивНомеров;

КонецФункции

