#КонецОбласти

#Область Экспрес_накладные
// Перед созданием экспресс-накладной
Процедура ПередСозданиемЭкспрессНакладной(СтруктураНастроек, СтруктураЭкспрессНакладной, ЭкспрессНакладнаяВыборка, Отказ = Ложь, МассивОшибок) Экспорт
	
	Если ЗначениеЗаполнено(ЭкспрессНакладнаяВыборка.ТипПостОплаты) Тогда 
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	eComm_ЛимитыПослеплатыСрезПоследних.УчетнаяЗапись КАК УчетнаяЗапись,
			|	eComm_ЛимитыПослеплатыСрезПоследних.ТипПостоплаты КАК ТипПостоплаты,
			|	eComm_ЛимитыПослеплатыСрезПоследних.Сумма КАК Сумма
			|ПОМЕСТИТЬ ВрТабЛимиты
			|ИЗ
			|	РегистрСведений.eComm_ЛимитыПослеплаты.СрезПоследних(
			|			&Период,
			|			УчетнаяЗапись = &УчетнаяЗапись
			|				И ТипПостоплаты = &ТипПостоплаты) КАК eComm_ЛимитыПослеплатыСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	eComm_ПослеплатаОбороты.УчетнаяЗапись КАК УчетнаяЗапись,
			|	eComm_ПослеплатаОбороты.ТипПостоплаты КАК ТипПостоплаты,
			|	eComm_ПослеплатаОбороты.СуммаОборот КАК СуммаОборот
			|ПОМЕСТИТЬ ВрТабОборотыЗаПериод
			|ИЗ
			|	РегистрНакопления.eComm_Послеплата.Обороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			Период,
			|			УчетнаяЗапись = &УчетнаяЗапись
			|				И ТипПостоплаты = &ТипПостоплаты) КАК eComm_ПослеплатаОбороты
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕСТЬNULL(ВрТабОборотыЗаПериод.СуммаОборот, 0) КАК СуммаОборот,
			|	ЕСТЬNULL(ВрТабЛимиты.Сумма, 0) КАК СуммаЛимит
			|ИЗ
			|	ВрТабОборотыЗаПериод КАК ВрТабОборотыЗаПериод
			|		ПОЛНОЕ СОЕДИНЕНИЕ ВрТабЛимиты КАК ВрТабЛимиты
			|		ПО ВрТабОборотыЗаПериод.УчетнаяЗапись = ВрТабЛимиты.УчетнаяЗапись
			|			И ВрТабОборотыЗаПериод.ТипПостоплаты = ВрТабЛимиты.ТипПостоплаты
			|ГДЕ
			|	ЕСТЬNULL(ВрТабОборотыЗаПериод.СуммаОборот, 0) > ЕСТЬNULL(ВрТабЛимиты.Сумма, 0)
			|		И НЕ ЕСТЬNULL(ВрТабЛимиты.Сумма, 0) = 0";
		
		Запрос.УстановитьПараметр("Период"			, ЭкспрессНакладнаяВыборка.ДатаОтгрузки);
		Запрос.УстановитьПараметр("НачалоПериода"	, НачалоКвартала(ЭкспрессНакладнаяВыборка.ДатаОтгрузки));
		Запрос.УстановитьПараметр("КонецПериода"	, КонецКвартала(ЭкспрессНакладнаяВыборка.ДатаОтгрузки));
		Запрос.УстановитьПараметр("УчетнаяЗапись"	, СтруктураНастроек.Ссылка);
		Запрос.УстановитьПараметр("ТипПостоплаты"	, ЭкспрессНакладнаяВыборка.ТипПостОплаты);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Следующий() Тогда 
			
			Если НЕ ЗначениеЗаполнено(ЭкспрессНакладнаяВыборка.СуммаПостОплаты) 
				И ЗначениеЗаполнено(ЭкспрессНакладнаяВыборка.ДокументОснование) Тогда 
				СуммаПостОплаты = СуммаЗаказа(ЭкспрессНакладнаяВыборка.ДокументОснование);
			Иначе
				СуммаПостОплаты = ЭкспрессНакладнаяВыборка.СуммаПостОплаты;
			КонецЕсли;
			
			Если (РезультатЗапроса.СуммаОборот + СуммаПостОплаты) > РезультатЗапроса.СуммаЛимит Тогда 
			
				Отказ = Истина;
			
				МассивОшибок.Добавить(НСтр("ru = 'Достигнут лимит на отправку с постоплатой (" + РезультатЗапроса.СуммаОборот  + " из " + РезультатЗапроса.СуммаЛимит + "). Отправка не может быть совершена!!!'; 
											|uk = 'Досягнениий ліміт на відправку з післяплатою (" + РезультатЗапроса.СуммаОборот  + " з " + РезультатЗапроса.СуммаЛимит + "). Відправка не може бути здійснена!!!'")); 
			КонецЕсли;
		
		КонецЕсли;

	КонецЕсли;
	
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		
		ТехнологияДоставки = ЭкспрессНакладнаяВыборка.Ссылка.ТехнологияДоставки;
		
		// Для почтомата необходимы габариты
		//
		Если ЭтоДоставкаВПочтомат(ТехнологияДоставки) Тогда 
			Если ЭкспрессНакладнаяВыборка.НесколькоМест = Истина
				И СтруктураЭкспрессНакладной.Свойство("OptionsSeat")
				И ТипЗнч(СтруктураЭкспрессНакладной.OptionsSeat) = Тип("Массив")
				И СтруктураЭкспрессНакладной.OptionsSeat.Количество() > 0 Тогда 
				
				// Все правильно
				
			Иначе
				
				Отказ = Истина;
				
				МассивОшибок.Добавить(НСтр("ru = 'Для возможности совершения отправки необходимо указать габариты (Д x Ш x В)'; 
											|uk = 'Для можливості здійснення відправлення необхідно вказати габарити (Д x Ш x В)'"));
				
			КонецЕсли;
		КонецЕсли;
		
		// Для ручной доставки проверим выполнение требований
		//
		Если ЭкспрессНакладнаяВыборка.НесколькоМест
			И ЭкспрессНакладнаяВыборка.РучнаяОбработка = Истина Тогда 
			
			Если СтруктураЭкспрессНакладной.Свойство("OptionsSeat")
				И ТипЗнч(СтруктураЭкспрессНакладной.OptionsSeat) = Тип("Массив")
				И СтруктураЭкспрессНакладной.OptionsSeat.Количество() > 0 Тогда
				
				Для Каждого Место Из СтруктураЭкспрессНакладной.OptionsSeat Цикл 
					
					Если Место.volumetricLength > 120
						ИЛИ Место.volumetricWidth > 70
						ИЛИ Место.volumetricHeight > 70 
						ИЛИ Место.weight > 30 Тогда 
						
						Отказ = Истина;
				
						МассивОшибок.Добавить(НСтр("ru = 'Оформление отправок по категории ""Ручая обработка"" разрешено с длиной отправки (или одного места) от 1 до 120 см, ширина и высота до 70 см и весом (фактичестки или объемным) отправления (или одного места) от 0,1 до 30 кг'; 
													|uk = 'Оформлення відправлень з категорією ""Ручне оброблення"" дозволено з довжина відправлення (або одного місця) від 1 до 120 см, ширина та висота до 70 см та вагою (фактичною або об`ємною) відправлення (або одного місця) від 0,1 до 30 кг'"));

					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
				
				Отказ = Истина;
				
				МассивОшибок.Добавить(НСтр("ru = 'Оформление отправок по категории ""Ручая обработка"" разрешено с длиной отправки (или одного места) от 1 до 120 см, ширина и высота до 70 см и весом (фактичестки или объемным) отправления (или одного места) от 0,1 до 30 кг'; 
											|uk = 'Оформлення відправлень з категорією ""Ручне оброблення"" дозволено з довжина відправлення (або одного місця) від 1 до 120 см, ширина та висота до 70 см та вагою (фактичною або об`ємною) відправлення (або одного місця) від 0,1 до 30 кг'"));
			КонецЕсли;
			
			Если ЭкспрессНакладнаяВыборка.ЭтоАдреснаяОтправка
				ИЛИ ОтделениеНовойПочтыПоддерживаетРучнуюОбработку(СтруктураНастроек, ЭкспрессНакладнаяВыборка.Ссылка.ОтделениеОтправителя) Тогда 
				// Все правильно
			Иначе
				
				Отказ = Истина;
				
				МассивОшибок.Добавить(НСтр("ru = 'Оформление отправок по категории ""Ручая обработка"" разрешено только с/на грузовые отделения, пункты приема-видачи и адрес'; 
												|uk = 'Оформлення відправлень з категорією ""Ручне оброблення"" дозволено лише з/на вантажні відділення, пункти прийому-видачі та адресу'"));
			КонецЕсли;
			
			Если ЭкспрессНакладнаяВыборка.ЭтоАдреснаяДоставка
				ИЛИ ОтделениеНовойПочтыПоддерживаетРучнуюОбработку(СтруктураНастроек, ЭкспрессНакладнаяВыборка.Ссылка.ОтделениеПолучателя) Тогда 
				// Все правильно
			Иначе
				
				Отказ = Истина;
				
				МассивОшибок.Добавить(НСтр("ru = 'Оформление отправок по категории ""Ручая обработка"" разрешено только с/на грузовые отделения, пункты приема-видачи и адрес'; 
												|uk = 'Оформлення відправлень з категорією ""Ручне оброблення"" дозволено лише з/на вантажні відділення, пункти прийому-видачі та адресу'"));
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin 
		И СтруктураЭкспрессНакладной.Свойство("order_amount")
		И ЗначениеЗаполнено(СтруктураЭкспрессНакладной.order_amount) Тогда 
		
		СтруктураЭкспрессНакладной.order_amount = Окр(СтруктураЭкспрессНакладной.order_amount, 1);
		
	КонецЕсли;

КонецПроцедуры

// После создания экспресс-накладной
Процедура ПослеСозданияЭкспрессНакладной(СтруктураНастроек, СтруктураЭкспрессНакладной, СтруктураОтвета) Экспорт

	ЭНОбъект = СтруктураЭкспрессНакладной.ЭкспрессНакладная.ПолучитьОбъект();
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		ЭНОбъект.НомерТТН 					= СтруктураОтвета.IntDocNumber;
		ЭНОбъект.Идентификатор 				= СтруктураОтвета.Ref;
		ЭНОбъект.ПрогнозируемаяДатаДоставки = ПрогнозируемаяДатаДоставки(СтруктураНастроек, СтруктураОтвета);
		ЭНОбъект.СтоимостьДоставки			= СтруктураОтвета.CostOnSite;
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
	    ЭНОбъект.НомерТТН 					= СтруктураОтвета.barcode;
		ЭНОбъект.Идентификатор 				= СтруктураОтвета.uuid;
		ЭНОбъект.ПрогнозируемаяДатаДоставки = ПрогнозируемаяДатаДоставки(СтруктураНастроек, СтруктураОтвета);
		ЭНОбъект.СтоимостьДоставки			= СтруктураОтвета.deliveryPrice;
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
		ЭНОбъект.НомерТТН 					= СтруктураОтвета.number;
		ЭНОбъект.Идентификатор 				= СтруктураЭкспрессНакладной.НомерЗаказа;
		ЭНОбъект.ПрогнозируемаяДатаДоставки = ПрогнозируемаяДатаДоставки(СтруктураНастроек, СтруктураОтвета);
		ЭНОбъект.СтоимостьДоставки			= СтруктураОтвета.delivery_amount;
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда 
		ЭНОбъект.НомерТТН 					= СтруктураОтвета.barCode;
		ЭНОбъект.Идентификатор 				= СтруктураОтвета.parcelID;
		ЭНОбъект.ПрогнозируемаяДатаДоставки = ПрогнозируемаяДатаДоставки(СтруктураНастроек, СтруктураОтвета);
		ЭНОбъект.СтоимостьДоставки			= СтруктураОтвета.costServices;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭНОбъект.ТипПостОплаты)
		И НЕ ЗначениеЗаполнено(ЭНОбъект.СуммаПостОплаты) 
		И ЗначениеЗаполнено(ЭНОбъект.ДокументОснование) Тогда 
		ЭНОбъект.СуммаПостОплаты = СуммаЗаказа(ЭНОбъект.ДокументОснование);
	КонецЕсли;
	
	Если СтруктураНастроек.Настройки.Свойство("ЗаполнятьДополнительнуюИнформациюПоЗаказу")
		И СтруктураНастроек.Настройки.ЗаполнятьДополнительнуюИнформациюПоЗаказу = Истина 
		И НЕ ЗначениеЗаполнено(ЭНОбъект.ДополнительнаяИнформация) Тогда
		ЭНОбъект.ДополнительнаяИнформация = ДополнительнаяИнформацияПоЗаказу(СтруктураЭкспрессНакладной.ДокументОснование);
	КонецЕсли;
	
	Если СтруктураНастроек.Настройки.Свойство("ЗаполнятьОбщийВесОбъемПоЗаказу")
		И СтруктураНастроек.Настройки.ЗаполнятьОбщийВесОбъемПоЗаказу = Истина Тогда 
		ЗаполнитьВесОбъем(СтруктураНастроек, ЭНОбъект);
	КонецЕсли;

	НаборЗаписей = РегистрыНакопления.eComm_Послеплата.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Регистратор.Значение = ЭНОбъект.Ссылка;
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	Если ЗначениеЗаполнено(ЭНОбъект.ТипПостОплаты) Тогда 
		НовЗапись = НаборЗаписей.Добавить();
		НовЗапись.Период 		= ЭНОбъект.Дата;
		НовЗапись.УчетнаяЗапись = ЭНОбъект.УчетнаяЗапись;
		НовЗапись.ТипПостоплаты = ЭНОбъект.ТипПостОплаты;
		НовЗапись.Сумма 		= ЭНОбъект.СуммаПостОплаты;                       
	КонецЕсли;
	
	НаборЗаписей.Записать();
	
	// Только для "Укрпочта"
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта 
		И СтруктураОтвета.Свойство("parcels") 
		И ТипЗнч(СтруктураОтвета.parcels) = Тип("Массив") Тогда
		
		Если ЭНОбъект.НесколькоМест = Истина Тогда 
			Для Каждого ЭлементМассива Из СтруктураОтвета.parcels Цикл 
				СтрДанных = ЭНОбъект.Места[ЭлементМассива.parcelNumber -1];
				СтрДанных.Идентификатор = ЭлементМассива.uuid;
			КонецЦикла; 
		ИначеЕсли ЭНОбъект.НесколькоМест = Ложь
			И СтруктураОтвета.parcels.Количество() = 1 Тогда 
			ЭНОбъект.ИдентификаторМеста = СтруктураОтвета.parcels[0].uuid;
		ИначеЕсли СтруктураОтвета.parcels.Количество() > 1 Тогда 
			// Нештатное поведение
			ТекстОшибки = НСтр("ru = 'Нештатная работа API. Для документа с одним местом личный кабинет сохранил несколько мест. Обратитесь к разработчикам модуля.'; 
								|uk = 'Нештатна робота API. Для документа з одним місцем особистий кабінет зберіг декілька місць. Зверніться до розробників модуля.'");
			ЗаписьЖурналаРегистрации("eComm.Укрпочта.ПослеСозданияЭкспрессНакладной", УровеньЖурналаРегистрации.Ошибка, , , "" + ЭНОбъект.НомерТТН + " " + ТекстОшибки);
			Сообщить("" + ЭНОбъект.НомерТТН + " " + ТекстОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
	ЭНОбъект.Записать();
	
	ЗаполнитьСвязьЗаказ_Экспресснакладная(СтруктураЭкспрессНакладной.ЭкспрессНакладная, СтруктураЭкспрессНакладной.ДокументОснование);
	
	Справочники.eComm_УчетныеЗаписиСлужбДоставки.ОбновитьСтатусы(СтруктураНастроек, СтруктураЭкспрессНакладной.ЭкспрессНакладная);

КонецПроцедуры

Процедура ЗаполнитьВесОбъем(СтруктураНастроек, ЭкспрессНакладная)

	Если ЭкспрессНакладная.НесколькоМест Тогда
		// Не наш случай
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ЭкспрессНакладная.Вес)
			ИЛИ НЕ ЗначениеЗаполнено(ЭкспрессНакладная.Объем) Тогда 
			
			// Подсчитаем вес по заказу
			ОбщийВесОбъем = eCommДоставкаСервер.ВесОбъемТоваровЗаказа(ЭкспрессНакладная.ДокументОснование);
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭкспрессНакладная.Вес) Тогда 
			ЭкспрессНакладная.Вес = ОбщийВесОбъем.Вес;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭкспрессНакладная.Объем) Тогда
			ЭкспрессНакладная.Объем = ОбщийВесОбъем.Объем;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ПрогнозируемаяДатаДоставки(СтруктураНастроек, СтруктураОтвета)

	ПрогнозируемаяДатаДоставки = Дата('00010101'); 
	
	Попытка
		Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда
			ПрогнозируемаяДатаДоставки = Дата(СтруктураОтвета.EstimatedDeliveryDate + " 00:00:00");
		ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда
			ПрогнозируемаяДатаДоставкиСтрокой 	= СтрЗаменить(СтруктураОтвета.deliveryDate, "T", "");
			ПрогнозируемаяДатаДоставкиСтрокой 	= СтрЗаменить(ПрогнозируемаяДатаДоставкиСтрокой, ":", "");
			ПрогнозируемаяДатаДоставкиСтрокой 	= СтрЗаменить(ПрогнозируемаяДатаДоставкиСтрокой, "-", "");
			ПрогнозируемаяДатаДоставки 			= Дата(ПрогнозируемаяДатаДоставкиСтрокой);
		ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда 
			ПрогнозируемаяДатаДоставкиСтрокой 	= СтрЗаменить(СтруктураОтвета.delivery_date, "T", "");
			ПрогнозируемаяДатаДоставкиСтрокой 	= СтрЗаменить(ПрогнозируемаяДатаДоставкиСтрокой, ":", "");
			ПрогнозируемаяДатаДоставкиСтрокой 	= СтрЗаменить(ПрогнозируемаяДатаДоставкиСтрокой, "-", "");
			ПрогнозируемаяДатаДоставки 			= Дата(ПрогнозируемаяДатаДоставкиСтрокой);
		ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда
			ПрогнозируемаяДатаДоставки = Дата(СтруктураОтвета.estimatedDeliveryDate + " 00:00:00");
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат ПрогнозируемаяДатаДоставки;

КонецФункции

Процедура ЗаполнитьСвязьЗаказ_Экспресснакладная(ЭкспрессНакладная, ДокументОснование) Экспорт

	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда 
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.eComm_ЭкспрессНакладныеСпискаЗаказов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументОснование 	= ДокументОснование;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	eComm_ЭкспрессНакладная.Ссылка КАК ЭкспрессНакладная
			|ИЗ
			|	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
			|ГДЕ
			|	eComm_ЭкспрессНакладная.ДокументОснование = &ДокументОснование
			|	И eComm_ЭкспрессНакладная.ПометкаУдаления = ЛОЖЬ
			|
			|УПОРЯДОЧИТЬ ПО
			|	eComm_ЭкспрессНакладная.Дата УБЫВ";
		
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Следующий() Тогда 
			МенеджерЗаписи.ЭкспрессНакладная = РезультатЗапроса.ЭкспрессНакладная;
		Иначе
			МенеджерЗаписи.ЭкспрессНакладная = ЭкспрессНакладная;
		КонецЕсли;
		
	Иначе
		
		МенеджерЗаписи.ДокументОснование = ДокументОснование;
		МенеджерЗаписи.ЭкспрессНакладная = ЭкспрессНакладная;
		
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// НЕ ИСПОЛЬЗУЕТСЯ
Процедура ДобавитьКРеестру(СтруктураНастроек, ЭкспрессНакладная) 

	Возврат;
	
	Если СтруктураНастроек.Настройки.Свойство("ИспользоватьРеестры")
		И СтруктураНастроек.Настройки.ИспользоватьРеестры = Истина Тогда 
		
		Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
			
			СтруктураРеестра = Новый Структура;
			СтруктураРеестра.Вставить("Дата"	, НачалоДня(ЭкспрессНакладная.Дата));
			
			Реестр = НайтиРеестр(СтруктураНастроек, СтруктураРеестра);
			
			Справочники.eComm_УчетныеЗаписиСлужбДоставки.ДобавитьНакладнуюВРеестр(СтруктураНастроек, Реестр, ЭкспрессНакладная.Ссылка);
			
		ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
			
			СтруктураРеестра = Новый Структура;
			СтруктураРеестра.Вставить("ТипГруза", ЭкспрессНакладная.ТипГруза);
			СтруктураРеестра.Вставить("Дата"	, НачалоДня(ЭкспрессНакладная.Дата));
			
			Реестр = НайтиСоздатьРеестр(СтруктураНастроек, СтруктураРеестра);
			
			Справочники.eComm_УчетныеЗаписиСлужбДоставки.ДобавитьНакладнуюВРеестр(СтруктураНастроек, Реестр, ЭкспрессНакладная.Ссылка); 
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// После получения статуса экспресс-накладной
Процедура ПослеПолученияСтатусаЭкспрессНакладной(СтруктураНастроек, СтруктураЭкспрессНакладной, СтруктураОтвета) Экспорт

	СохраненныеДанные = СтруктураСохраняемыхДанных();
	
	МенеджерЗаписи = РегистрыСведений.eComm_СтатусыЭкспрессНакладных.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЭкспрессНакладная = СтруктураЭкспрессНакладной.ЭкспрессНакладная;
	МенеджерЗаписи.Прочитать();
	
	Если НЕ МенеджерЗаписи.Выбран() Тогда 
		МенеджерЗаписи.ЭкспрессНакладная = СтруктураЭкспрессНакладной.ЭкспрессНакладная;
	Иначе
		ЗаполнитьЗначенияСвойств(СохраненныеДанные, МенеджерЗаписи);
	КонецЕсли;
	
	ЗаполнитьОписаниеСтатуса(СтруктураНастроек, СтруктураЭкспрессНакладной, СтруктураОтвета, МенеджерЗаписи);
	ЗаполнитьСтатусДенежногоПеревода(СтруктураНастроек, СтруктураОтвета, МенеджерЗаписи);
	ЗаполнитьНачалоПлатногоХранения(СтруктураНастроек, СтруктураОтвета, МенеджерЗаписи);
	ЗаполнитьДатаПолучения(СтруктураНастроек, СтруктураОтвета, МенеджерЗаписи);
	ЗаполнитьДатаПрибытияНаСклад(СтруктураНастроек, СтруктураОтвета, МенеджерЗаписи);
	ЗаполнитьДнейХраненияНаСкладе(СтруктураНастроек, СтруктураОтвета, МенеджерЗаписи);
	ОтправитьСМССНомеромЭН(СтруктураНастроек, СтруктураОтвета, МенеджерЗаписи);
	
	Если ДанныеИзменены(СохраненныеДанные, МенеджерЗаписи) Тогда 
		
		МенеджерЗаписи.Записать();
		
		Если ЗначениеЗаполнено(СтруктураЭкспрессНакладной.ДокументОснование) Тогда 
			
			//СоздатьОбновитьПКО(СтруктураНастроек, СтруктураОтвета, МенеджерЗаписи, СтруктураЭкспрессНакладной.ДокументОснование);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция СтруктураСохраняемыхДанных()

	СтруктураДанных = Новый Структура();
	//СтруктураДанных.Вставить("ДокументОснование");
	СтруктураДанных.Вставить("ЭкспрессНакладная");
	СтруктураДанных.Вставить("Статус");
	СтруктураДанных.Вставить("ОписаниеСтатуса");
	СтруктураДанных.Вставить("НачалоПлатногоХранения");
	СтруктураДанных.Вставить("СтатусДенежногоПеревода");
	СтруктураДанных.Вставить("ДатаПрибытияНаСклад");
	СтруктураДанных.Вставить("ДнейХраненияНаСкладе");
	СтруктураДанных.Вставить("ДатаПолучения");
	
	Возврат СтруктураДанных;

КонецФункции

Процедура ЗарегистирироватьЕН(СтруктураНастроек, ДокументЕН, Отказ) Экспорт

	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда
		  Обработки["eComm_НоваяПочта"].ЗарегистрироватьДокумент(ДокументЕН, СтруктураНастроек, Отказ);
     КонецЕсли;
	
КонецПроцедуры	

Процедура ИзменитьЕН(СтруктураНастроек, ДокументЕН, Отказ) Экспорт

	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда
		  Обработки["eComm_НоваяПочта"].ИзменитьДокумент(ДокументЕН, СтруктураНастроек, Отказ);
