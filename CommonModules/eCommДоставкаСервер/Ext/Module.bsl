Функция АдресаКлиента(КонтрагентДоставки, КонтактноеЛицоКонтрагентаДоставки, СлужбаДоставки, ЭтоАдресОтделения) Экспорт

	Если КонтрагентДоставки.ТипКонтрагента = eCommДоставкаСервер.ТипКонтрагентаОрганизация(СлужбаДоставки) Тогда 
		// Адреса берем исключительно из справочника "Контрагенты доставки"
		ИмяСправочникаАдресов = "eComm_КонтрагентыДоставки";
		Клиент = КонтрагентДоставки;
	Иначе
		// Адреса берем исключительно из справочника "Контактные лица контрагентов доставки"
		ИмяСправочникаАдресов = "eComm_КонтактныеЛицаКонтрагентовДоставки";
		Клиент = КонтактноеЛицоКонтрагентаДоставки;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АдресаКлиента.Адрес КАК Адрес,
		|	АдресаКлиента.ОсновнойАдрес КАК ОсновнойАдрес
		|ИЗ
		|	Справочник." + ИмяСправочникаАдресов + ".Адреса КАК АдресаКлиента
		|ГДЕ
		|	АдресаКлиента.Ссылка = &Клиент
		|	И АдресаКлиента.Адрес.ЭтоАдресОтделения = &ЭтоАдресОтделения";
	
	Запрос.УстановитьПараметр("Клиент"				, Клиент);
	Запрос.УстановитьПараметр("ЭтоАдресОтделения"	, ЭтоАдресОтделения);
	
	МассивАдрсов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Адрес");
	
	Возврат МассивАдрсов;

