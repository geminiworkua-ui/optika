#Область ФОРМЫ

Процедура ЗаказПокупателя_ФормаДокумента_ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Если ИмяКонфигурации() = "BASSmallBusiness" Тогда 
		ГруппаДляРазмещенияРеквизита 	= "ГруппаПравоеОбъединение";
		Если НЕ Форма.Элементы.Найти("ГруппаТрекНомер") = Неопределено Тогда 
			ИмяСледующегоЭлемента		= "ГруппаТрекНомер";
		Иначе
			ИмяСледующегоЭлемента		= "ТрекНомер";
		КонецЕсли;
	Иначе
		ГруппаДляРазмещенияРеквизита 	= "СтраницаДоставка";
		ИмяСледующегоЭлемента			= "ГруппаСпособДоставкиПеревозчик";
	КонецЕсли;
	
	ОписаниеСтатуса = "";
	
	Если ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда 
		
		СписокНакладных = СписокЭкспрессНакладных(Форма.Объект.Ссылка);
		
		КоличествоЭкспрессНакладных = СписокНакладных.Количество();
		
		Если КоличествоЭкспрессНакладных > 0 Тогда 
			ОписаниеСтатуса = СписокНакладных[0].Представление;
		КонецЕсли;
		
		Если КоличествоЭкспрессНакладных > 1 Тогда 
			ОписаниеСтатуса = ОписаниеСтатуса + НСтр("ru = ' и еще '; uk = ' та ще '") + (КоличествоЭкспрессНакладных - 1) + НСтр("ru = ' накладных'; uk = ' накладних'");
		КонецЕсли;
		
	КонецЕсли;
	
	НоваяГруппа = Форма.Элементы.Вставить("eComm_Группа", Тип("ГруппаФормы"), Форма.Элементы[ГруппаДляРазмещенияРеквизита], Форма.Элементы[ИмяСледующегоЭлемента]); 
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	Элемент = Форма.Элементы.Добавить("eComm_ЭкспрессНакладная_Открыть", Тип("ДекорацияФормы"), НоваяГруппа);
	Элемент.Вид 			= ВидДекорацииФормы.Надпись;
	Элемент.Заголовок 		= ?(ЗначениеЗаполнено(ОписаниеСтатуса), "Статус накладной: " + ОписаниеСтатуса, "Отправить ЭН");
	Элемент.Гиперссылка 	= Истина;
	Элемент.Высота			= 1;
	Элемент.АвтомаксимальнаяВысота = Ложь;
	Элемент.РастягиватьПоВертикали = Ложь;
	Элемент.МаксимальнаяВысота = 1;
	
	Элемент.УстановитьДействие("Нажатие", "eComm_ЭкспрессНакладнаяНажатие");
	
	Элемент = Форма.Элементы.Добавить("eComm_ЭкспрессНакладная_Создать", Тип("ДекорацияФормы"), НоваяГруппа);
	Элемент.Вид 			= ВидДекорацииФормы.Картинка;
	Элемент.Подсказка 		= НСтр("ru = 'Добавить:'; uk = 'Додати:'");
	Элемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСлева;
	Элемент.Картинка 		= БиблиотекаКартинок.СоздатьЭлементСписка;
	Элемент.Гиперссылка 	= Истина;
	Элемент.Высота			= 1;
	Элемент.Ширина			= 3;
	Элемент.АвтомаксимальнаяВысота = Ложь;
	Элемент.РастягиватьПоВертикали = Ложь;
	Элемент.МаксимальнаяВысота = 1;
	Элемент.УстановитьДействие("Нажатие", "eComm_ЭкспрессНакладнаяНажатие");

КонецПроцедуры

Процедура ЗаполнитьГородОтделениеДоставки(Форма) Экспорт

	Если НЕ ЗначениеЗаполнено(Форма.Объект.ДокументОснование) 
		ИЛИ Метаданные.Справочники.Контрагенты.Реквизиты.Найти("eComm_НаселенныеПунктыДоставки") = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ЗапросТекст = "ВЫБРАТЬ
		|	Контрагенты.eComm_ГородДоставки КАК НаселенныйПунктПолучателя,
		|	Контрагенты.eComm_ОтделениеДоставки КАК ОтделениеПолучателя
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В
		|			(ВЫБРАТЬ
		|				ЗаказПокупателя.Контрагент КАК Контрагент
		|			ИЗ
		|				Документ.#ДокументЗаказ# КАК ЗаказПокупателя
		|			ГДЕ
		|				ЗаказПокупателя.Ссылка = &ДокументОснование)";
	
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "#ДокументЗаказ#", ВернутьИмяПрикладногоОбъекта("ЗаказКлиента"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросТекст;
	Запрос.УстановитьПараметр("ДокументОснование", Форма.Объект.ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(Форма.Объект, РезультатЗапроса);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти