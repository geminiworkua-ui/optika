#Область Регламетные_задания

Процедура ЗаданиеВыполнитьОбновление(УчетнаяЗапись, НаправлениеОбмена = "") Экспорт
	
	СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(УчетнаяЗапись);
	
	Если НаправлениеОбмена = "ОбновлениеСправочников" Тогда 
		
		Справочники.eComm_УчетныеЗаписиСлужбДоставки.ОбновитьСправочники(СтруктураНастроек);
		
	ИначеЕсли НаправлениеОбмена = "ОбновлениеСтатусовЭН" Тогда 
		
		Справочники.eComm_УчетныеЗаписиСлужбДоставки.ОбновитьСтатусы(СтруктураНастроек);

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Общего_назначения

Функция ИмяКонфигурации() Экспорт

	ИспользоватьВстроенныйОбработчик = Истина;
	
	МодульeCommСерверПереопределяемый = ОбщийМодуль("eCommСерверПереопределяемый");
	
	Если НЕ МодульeCommСерверПереопределяемый = Неопределено Тогда 
		ИмяКонфигурации = МодульeCommСерверПереопределяемый.ИмяКонфигурации(ИспользоватьВстроенныйОбработчик);
	КонецЕсли;
	
	Если НЕ ИспользоватьВстроенныйОбработчик = Ложь Тогда
		
		ИмяКонфигурации = Метаданные.Имя;
		
		Если ИмяКонфигурации = "УправлениеНебольшойФирмойДляУкраины" 
			ИЛИ ИмяКонфигурации = "УправлениеШвейнымПроизводствомДляУкраины" Тогда 
			ИмяКонфигурации = "BASSmallBusiness";
		ИначеЕсли ИмяКонфигурации = "УправлениеПроизводственнымПредприятиемДляУкраины" Тогда 
			ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины";
		ИначеЕсли ИмяКонфигурации = "BASERP" 
			ИЛИ ИмяКонфигурации = "BASКомплексноеУправлениеПредприятием" Тогда 
			ИмяКонфигурации = "BASУправлениеТорговлей";
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ИмяКонфигурации;
	
КонецФункции

Функция Установить_HTTPСоединение(СтруктураНастроек) Экспорт

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	
	//Соединение = eCommСерверПереопределяемый.Установить_HTTPСоединение(СтруктураНастроек, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда 
		
		Если СтруктураНастроек.Свойство("HTTP_ЗащищенноеСоединение")
			И СтруктураНастроек["HTTP_ЗащищенноеСоединение"] = Истина Тогда
			
			Если СтруктураНастроек.ТипПлатформы = "Windows" Тогда 
				ssl = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Новый СертификатыУдостоверяющихЦентровWindows());
			Иначе
				ssl = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
			КонецЕсли;
			
		Иначе
			
			ssl = Неопределено;
			
		КонецЕсли;
		
		Попытка
			Соединение = Новый HTTPСоединение(СтруктураНастроек.HTTP_Сервер, СтруктураНастроек.HTTP_Порт,,,,,ssl);
		Исключение
			Сообщить("Не удалось установить HTTP-соединение!!!");
			Соединение = Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Соединение;

КонецФункции

Функция ВернутьИмяПрикладногоОбъекта(ИмяОбъекта, ИспользоватьПолноеИмя = Ложь) Экспорт

	ОбрабатыватьВстроеннымОбработчиком = Истина;
	//Результат = eCommСерверПереопределяемый.ВернутьИмяПрикладногоОбъекта(ИмяОбъекта, ИспользоватьПолноеИмя = Ложь, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда 
		
		ИмяКонфигурации = ИмяКонфигурации();
		
		Если ИмяКонфигурации = "BASSmallBusiness" Тогда
			
			Если ИмяОбъекта = "ЗаказКлиента" Тогда 
				Результат = "ЗаказПокупателя";
			ИначеЕсли ИмяОбъекта = "СообщениеSMS" Тогда 
				Результат = "Событие";
			ИначеЕсли ИмяОбъекта = "ПоступлениеВКассу" Тогда 
				Результат = "ПоступлениеВКассу";
			ИначеЕсли ИмяОбъекта = "ОперацияПоПлатежнымКартам" Тогда 	
				Результат = "ОперацияПоПлатежнымКартам";
			ИначеЕсли ИмяОбъекта = "СписаниеБезналичныхДенежныхСредств" Тогда
				Результат = "";
			КонецЕсли;
			
		ИначеЕсли ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
			
			Если ИмяОбъекта = "ЗаказКлиента" Тогда 
				Результат = "ЗаказПокупателя";
			ИначеЕсли ИмяОбъекта = "СообщениеSMS" Тогда 
				Результат = "eComm_СообщениеSMS";
			ИначеЕсли ИмяОбъекта = "ПоступлениеВКассу" Тогда 
				Результат = "ПриходныйКассовыйОрдер";
			ИначеЕсли ИмяОбъекта = "ОперацияПоПлатежнымКартам" Тогда 
				Результат = "ОплатаОтПокупателяПлатежнойКартой";
			ИначеЕсли ИмяОбъекта = "ПлатежноеПоручениеИсходящее" Тогда
				Результат = "СписаниеБезналичныхДенежныхСредств";
			КонецЕсли;
			
		Иначе
		
			Если ИмяОбъекта = "ЗаказКлиента" Тогда 
				Результат = "ЗаказКлиента";
			ИначеЕсли ИмяОбъекта = "СообщениеSMS" Тогда 
				Результат = "СообщениеSMS";
			ИначеЕсли ИмяОбъекта = "ПоступлениеВКассу" Тогда 
				Результат = "ПриходныйКассовыйОрдер";
			ИначеЕсли ИмяОбъекта = "ОперацияПоПлатежнымКартам" Тогда 
				Результат = "ОперацияПоПлатежнойКарте";
			ИначеЕсли ИмяОбъекта = "СписаниеБезналичныхДенежныхСредств" Тогда
				Результат = "СписаниеБезналичныхДенежныхСредств";
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
				
КонецФункции

Функция ВернутьИмяРеквизитаОбъекта(ИмяОбъекта, ИмяРеквизита) Экспорт
	
	ОбрабатыватьВстроеннымОбработчиком = Истина;
	//Результат = eCommСерверПереопределяемый.ВернутьИмяРеквизитаОбъекта(ИмяОбъекта, ИмяРеквизита, ОбрабатыватьВстроеннымОбработчиком);
	
	Если НЕ ОбрабатыватьВстроеннымОбработчиком = Ложь Тогда 
		
		ИмяКонфигурации = ИмяКонфигурации();
		
		Если ИмяКонфигурации = "BASSmallBusiness" Тогда
			
			// Справочники
			Если ИмяОбъекта = "Номенклатура" Тогда
				Если ИмяРеквизита = "Вес" Тогда 
					Результат = "Вес";
				ИначеЕсли ИмяРеквизита = "Объем" Тогда 
					Результат = "Объем";
				ИначеЕсли ИмяРеквизита = "Длина" Тогда 
					Результат = "Длина";
				ИначеЕсли ИмяРеквизита = "Ширина" Тогда 
					Результат = "Ширина";
				ИначеЕсли ИмяРеквизита = "Высота" Тогда 
					Результат = "Высота";
				КонецЕсли;
			// Документы
			ИначеЕсли ИмяОбъекта = "ЗаказКлиента" Тогда 
				Если ИмяРеквизита = "Товары" Тогда 
					Результат = "Запасы";
				ИначеЕсли ИмяРеквизита = "НомерПоДаннымКлиента" Тогда 
					Результат = "НомерВходящегоДокумента";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "СообщениеSMS" Тогда 
				Если ИмяРеквизита = "ОтправлятьВТранслите" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "ДокументОснование" Тогда 
					Результат = "ДокументОснование";
				ИначеЕсли ИмяРеквизита = "ТекстСообщения" Тогда 
					Результат = "Содержание";
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
			
			// Справочники
			Если ИмяОбъекта = "Номенклатура" Тогда
				Если ИмяРеквизита = "Вес" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Объем" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Длина" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Ширина" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Высота" Тогда 
					Результат = "";
				КонецЕсли;
			// Документы
			ИначеЕсли ИмяОбъекта = "ЗаказКлиента" Тогда 
				Если ИмяРеквизита = "Товары" Тогда 
					Результат = "Товары";
				ИначеЕсли ИмяРеквизита = "НомерПоДаннымКлиента" Тогда 
					Результат = "НомерВходящегоДокументаЭлектронногоОбмена";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "СообщениеSMS" Тогда 
				Если ИмяРеквизита = "ОтправлятьВТранслите" Тогда 
					Результат = "ОтправлятьВТранслите";
				ИначеЕсли ИмяРеквизита = "ДокументОснование" Тогда 
					Результат = "ДокументОснование";
				ИначеЕсли ИмяРеквизита = "ТекстСообщения" Тогда 
					Результат = "ТекстСообщения";
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			// Справочники
			Если ИмяОбъекта = "Номенклатура" Тогда
				Если ИмяРеквизита = "Вес" Тогда 
					Результат = "ВесЧислитель";
				ИначеЕсли ИмяРеквизита = "Объем" Тогда 
					Результат = "ОбъемЧислитель";
				ИначеЕсли ИмяРеквизита = "Длина" Тогда 
					Результат = "ДлинаЧислитель";
				ИначеЕсли ИмяРеквизита = "Ширина" Тогда 
					Результат = "";
				ИначеЕсли ИмяРеквизита = "Высота" Тогда 
					Результат = "";
				КонецЕсли;
			// Документы
			ИначеЕсли ИмяОбъекта = "ЗаказКлиента" Тогда 
				Если ИмяРеквизита = "Товары" Тогда 
					Результат = "Товары";
				ИначеЕсли ИмяРеквизита = "НомерПоДаннымКлиента" Тогда 
					Результат = "НомерПоДаннымКлиента";
				КонецЕсли;
			ИначеЕсли ИмяОбъекта = "СообщениеSMS" Тогда 
				Если ИмяРеквизита = "ОтправлятьВТранслите" Тогда 
					Результат = "ОтправлятьВТранслите";
				ИначеЕсли ИмяРеквизита = "ДокументОснование" Тогда 
					Результат = "ВзаимодействиеОснование";
				ИначеЕсли ИмяРеквизита = "ТекстСообщения" Тогда 
					Результат = "ТекстСообщения";
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьУчетныеЗаписиСлужбы(СлужбаДоставки) Экспорт
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	eComm_УчетныеЗаписиСлужбДоставки.Ссылка как Служба
|ИЗ
|	Справочник.eComm_УчетныеЗаписиСлужбДоставки КАК eComm_УчетныеЗаписиСлужбДоставки
|ГДЕ
|	Не eComm_УчетныеЗаписиСлужбДоставки.ПометкаУдаления
|	И eComm_УчетныеЗаписиСлужбДоставки.СлужбаДоставки = &СлужбаДоставки"); 
Запрос.УстановитьПараметр("СлужбаДоставки", СлужбаДоставки);

Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Служба");
КонецФункции	

Функция Настройки(УчетнаяЗапись) Экспорт

	Возврат Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(УчетнаяЗапись);

КонецФункции

Функция ЗначениеНастройки(СтруктураНастроек, БлокНастроек, ИмяНастройки) Экспорт

	СтруктураБлокаНастроек = Неопределено;
	
	Если СтруктураНастроек.Свойство(БлокНастроек, СтруктураБлокаНастроек)
		И ТипЗнч(СтруктураБлокаНастроек) = Тип("Структура")
		И СтруктураБлокаНастроек.Свойство(ИмяНастройки) Тогда 
		
		Возврат СтруктураБлокаНастроек[ИмяНастройки];
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

КонецФункции

Функция ВернутьУчетнуюЗаписьПоУмолчанию(СлужбаДоставки, Организация = Неопределено, ЭквайринговыйТерминал = Неопределено) Экспорт
	
	Если Организация = Неопределено Тогда 
		Организация = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписиПоУмолчанию.УчетнаяЗапись КАК УчетнаяЗапись,
		|	УчетныеЗаписиПоУмолчанию.Отправитель КАК Отправитель,
		|	УчетныеЗаписиПоУмолчанию.КонтактноеЛицоОтправителя КАК КонтактноеЛицоОтправителя,
		|	1 КАК Приоритет
		|ИЗ
		|	РегистрСведений.eComm_ЗначенияУчетныхЗаписейДоставкиПоУмолчанию КАК УчетныеЗаписиПоУмолчанию
		|ГДЕ
		|	УчетныеЗаписиПоУмолчанию.СлужбаДоставки = &СлужбаДоставки
		|	И ВЫБОР
		|			КОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ УчетныеЗаписиПоУмолчанию.Организация = &Организация
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	eComm_УчетныеЗаписиСлужбДоставки.Ссылка,
		|	NULL,
		|	NULL,
		|	2
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписиСлужбДоставки КАК eComm_УчетныеЗаписиСлужбДоставки
		|ГДЕ
		|	eComm_УчетныеЗаписиСлужбДоставки.ОсновнаяУчетнаяЗапись = ИСТИНА
		|	И eComm_УчетныеЗаписиСлужбДоставки.СлужбаДоставки = &СлужбаДоставки
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
	
	Запрос.УстановитьПараметр("СлужбаДоставки"	, СлужбаДоставки);
	Запрос.УстановитьПараметр("Организация"		, Организация);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		
		Возврат РезультатЗапроса.УчетнаяЗапись;
		
	КонецЕсли;
	
КонецФункции

Функция ДанныеОтправителя(УчетнаяЗапись, СлужбаДоставки, Организация, ЭквайринговыйТерминал = Неопределено) Экспорт

	ДанныеОтправителя = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияПоУмолчанию.Отправитель КАК Отправитель,
		|	ЗначенияПоУмолчанию.КонтактноеЛицоОтправителя КАК КонтактноеЛицоОтправителя
		|ИЗ
		|	РегистрСведений.eComm_ЗначенияУчетныхЗаписейДоставкиПоУмолчанию КАК ЗначенияПоУмолчанию
		|ГДЕ
		|	ЗначенияПоУмолчанию.УчетнаяЗапись = &УчетнаяЗапись
		|	И ЗначенияПоУмолчанию.СлужбаДоставки = &СлужбаДоставки
		|	И ЗначенияПоУмолчанию.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("СлужбаДоставки"	, СлужбаДоставки);
	Запрос.УстановитьПараметр("УчетнаяЗапись"	, УчетнаяЗапись);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		ДанныеОтправителя = Новый Структура("Отправитель, КонтактноеЛицоОтправителя");
		ЗаполнитьЗначенияСвойств(ДанныеОтправителя, РезультатЗапроса);
	КонецЕсли;
	
	Возврат ДанныеОтправителя;
		
КонецФункции

Функция ВернутьЕдинственнуюУчетнуюЗапись() Экспорт               // Оставлено для совместимости

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_УчетныеЗаписиСлужбДоставки КАК УчетныеЗаписи
		|ГДЕ
		|	УчетныеЗаписи.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 1
		И РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.Ссылка;
	КонецЕсли;
	
КонецФункции

