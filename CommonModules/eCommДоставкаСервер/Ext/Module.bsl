Процедура ОтправитьСМССНомеромЭН(СтруктураНастроек, СтруктураОтвета, МенеджерЗаписи)

	Если НЕ СтруктураНастроек.Настройки.Свойство("СпособОтправкиСМС") 
		ИЛИ НЕ СтруктураНастроек.Настройки.СпособОтправкиСМС = "ОтправлятьВФоне" Тогда 
		// Не включена рассылка сообщений по изменению статуса экспресс-накладной
		Возврат;
	КонецЕсли;
		
	ШаблонСМС = СтруктураНастроек.Настройки.ШаблонСМС;
	Если НЕ ЗначениеЗаполнено(ШаблонСМС) Тогда
		// Без шаблона нечего рассылать
		Возврат;
	КонецЕсли;
	
	СтатусФоновойОтправкиСМС = Неопределено;
	Если НЕ СтруктураНастроек.Настройки.Свойство("СтатусФоновойОтправкиСМС", СтатусФоновойОтправкиСМС)
		ИЛИ НЕ МенеджерЗаписи.Статус = СтатусФоновойОтправкиСМС Тогда 
		// Вероятно старая структура настроек. Надо пересохраниться
		// В текущем статусе рассылка не нужна
		Возврат;
	КонецЕсли;
	
	МодульОтправкаSMS = МодульОтправкиSMS();
	Если МодульОтправкаSMS = Неопределено Тогда 
		// Вероятно это не УТ и не УНФ
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура("Ссылка, ДокументОснование, УчетнаяЗапись, ТелефонПолучателя");
	
	СтруктураЭкспрессНакладной 				= ВернутьЗначенияРеквизитовДокумента(МенеджерЗаписи.ЭкспрессНакладная, СтруктураРеквизитов);
	ИмяДокументаСообщениеSMS 				= ВернутьИмяПрикладногоОбъекта("СообщениеSMS");
	ИмяРеквизитаТекстСообщения				= ВернутьИмяРеквизитаОбъекта("СообщениеSMS", "ТекстСообщения");
	ОтправлятьВТранслите_ВРеквизитахФормы 	= ВернутьИмяРеквизитаОбъекта("СообщениеSMS", "ОтправлятьВТранслите") = "";

	Если КоличествоСМСПоЗаказу(СтруктураРеквизитов.ДокументОснование) > 0 Тогда 
		// Уже СМС отправляли
		Возврат;
	КонецЕсли;
	
	ДокументСМС = Документы[ИмяДокументаСообщениеSMS].СоздатьДокумент();
	
	ЗаполнитьСМСНаСервере(СтруктураНастроек, ДокументСМС, СтруктураЭкспрессНакладной, ШаблонСМС, ОтправлятьВТранслите_ВРеквизитахФормы);
	ДокументСМС.Записать();
	
	Если СтруктураНастроек.ИмяКонфигурации = "BASSmallBusiness" Тогда 
		ИмяТЧАдресаты = "Участники";
	ИначеЕсли СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
		ИмяТЧАдресаты = "Адресаты";
	ИначеЕсли СтруктураНастроек.ИмяКонфигурации = "BASУправлениеТорговлей" Тогда
		ИмяТЧАдресаты = "Адресаты";
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ДокументСМС[ИмяТЧАдресаты].Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
	
	НомераПолучателей = ДокументСМС[ИмяТЧАдресаты].ВыгрузитьКолонку("НомерДляОтправки");
	РезультатОтправки = МодульОтправкаSMS.ОтправитьSMS(НомераПолучателей, ДокументСМС[ИмяРеквизитаТекстСообщения], Неопределено, ОтправлятьВТранслите(ШаблонСМС));
	
	ПослеОтправкиСообщения(СтруктураНастроек, ДокументСМС, РезультатОтправки);
	
КонецПроцедуры

Процедура СоздатьОбновитьПКО(СтруктураНастроек, СтруктураОтвета, МенеджерЗаписи, ДокументОснование)

	Настройки = СтруктураНастроек.Настройки;
	
	Если Настройки.Свойство("СоздаватьПКО")
		И Настройки.СоздаватьПКО = Истина
		И ЗначениеЗаполнено(Настройки.СтатусСозданияПКО)
		И (МенеджерЗаписи.Статус = Настройки.СтатусСозданияПКО) Тогда
		
		ПриходныйКассовыйОрдер_Объект = Неопределено;
		
		//++
		Если СтруктураОтвета.Свойство("LastAmountTransferGM") 
			И ЗначениеЗаполнено(СтруктураОтвета.LastAmountTransferGM) Тогда 
			
			Попытка
				СуммаПлатежа = Число(СтруктураОтвета.LastAmountTransferGM);
			Исключение
				СуммаПлатежа = 0;
			КонецПопытки;
			
		Иначе
			СуммаПлатежа = 0;
		КонецЕсли;
		//--
		
		ИмяОбъекта_ПоступлениеВКассу = ВернутьИмяПрикладногоОбъекта("ПоступлениеВКассу");
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЗаказКлиента", ДокументОснование);
		Запрос.Текст = "ВЫБРАТЬ
			|	Ссылка,
			|	Проведен
			|ИЗ
			|	Документ." + ИмяОбъекта_ПоступлениеВКассу + " КАК ПоступлениеВКассу
			|ГДЕ
			|	ДокументОснование = &ЗаказКлиента
			//++
			|	И ВЫБОР
			|		КОГДА &СуммаПлатежа = 0
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ПоступлениеВКассу.СуммаДокумента = &СуммаПлатежа
			|		КОНЕЦ
			//--
			|";
		
		//++
		Запрос.УстановитьПараметр("СуммаПлатежа", СуммаПлатежа);
		//--	
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Если Не Выборка.Проведен Тогда
				ПриходныйКассовыйОрдер_Объект = Выборка.Ссылка.ПолучитьОбъект();
			КонецЕсли;
		Иначе
			ПриходныйКассовыйОрдер_Объект = Документы[ИмяОбъекта_ПоступлениеВКассу].СоздатьДокумент();
		КонецЕсли;
		
		Если ПриходныйКассовыйОрдер_Объект <> Неопределено Тогда
			
			ПриходныйКассовыйОрдер_Объект.Заполнить(ДокументОснование);
			ПриходныйКассовыйОрдер_Объект.Дата 		= ТекущаяДатаСеанса();
			ПриходныйКассовыйОрдер_Объект.Касса 	= Настройки.Касса;
			ПриходныйКассовыйОрдер_Объект.КассаККМ 	= Настройки.КассаККМ;
			
			Попытка
				ПриходныйКассовыйОрдер_Объект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение 
				ПриходныйКассовыйОрдер_Объект.Записать();
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ДанныеИзменены(СохраненныеДанные, МенеджерЗаписи)

	ДанныеИзменены = Ложь;
	
	Для Каждого КлючЗначение Из СохраненныеДанные Цикл 
		
		Если НЕ КлючЗначение.Значение = МенеджерЗаписи[КлючЗначение.Ключ] Тогда 
			
			ДанныеИзменены = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДанныеИзменены;

КонецФункции

// После удаления экспресс-накладной
Процедура ПослеУдаленияЭкспрессНакладной(СтруктураНастроек, СтруктураЭкспрессНакладной, СтруктураОтвета) Экспорт

	Справочники.eComm_УчетныеЗаписиСлужбДоставки.ОбновитьСтатусы(СтруктураНастроек, СтруктураЭкспрессНакладной.ЭкспрессНакладная);
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		
		МенеджерЗаписи = РегистрыСведений.eComm_СтатусыЭкспрессНакладных.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭкспрессНакладная = СтруктураЭкспрессНакладной.ЭкспрессНакладная;
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда
			СтруктураОтвета = Новый Структура("Status", "DELETED");
			СтруктураЭкспрессНакладной.Вставить("КодСтатуса", "");
			ЗаполнитьОписаниеСтатуса(СтруктураНастроек, СтруктураЭкспрессНакладной, СтруктураОтвета, МенеджерЗаписи);	
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	НаборЗаписей = РегистрыНакопления.eComm_Послеплата.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Регистратор.Значение = СтруктураЭкспрессНакладной.ЭкспрессНакладная;
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

#Область Работа_с_реестрами

Процедура ПослеДобавленияВРеестр(СтруктураНастроек, СтруктураЭкспрессНакладной) Экспорт

	МенеджерЗаписи = РегистрыСведений.eComm_Реестры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Реестр 				= СтруктураЭкспрессНакладной.Реестр;
	МенеджерЗаписи.ЭкспрессНакладная 	= СтруктураЭкспрессНакладной.ЭкспрессНакладная;
	МенеджерЗаписи.Записать();

КонецПроцедуры

Процедура ПослеУдаленияИзРеестра(СтруктураНастроек, СтруктураЭкспрессНакладной) Экспорт

	МенеджерЗаписи = РегистрыСведений.eComm_Реестры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЭкспрессНакладная = СтруктураЭкспрессНакладной.ЭкспрессНакладная;
	МенеджерЗаписи.Удалить();
	
	// Для Meest чтобы удалить последний документ реестра - необходимо удалить сам реестр
	// (запрещено редактировать реестр так чтобы в нем не осталось документов)
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest 
		И СтруктураЭкспрессНакладной.Свойство("УдалитьПустойРеестр")
		И СтруктураЭкспрессНакладной.УдалитьПустойРеестр = Истина Тогда 
		
		РеестрОбъект = СтруктураЭкспрессНакладной.Реестр.ПолучитьОбъект();
		РеестрОбъект.УстановитьПометкуУдаления(Истина);
		
		Сообщить("" + НСтр("ru = 'Удален реестр без накладных'; uk = 'Видалений реєстр без накладних'") + "(" + РеестрОбъект.Наименование + ")");
		
	КонецЕсли;

КонецПроцедуры

Процедура ПослеПечатиРеестра(СтруктураНастроек, СтруктураРеестра) Экспорт

	Попытка
		Если ТипЗнч(СтруктураРеестра) = Тип("Структура")
			И СтруктураРеестра.Свойство("Реестр") Тогда 
			
			РеестрОбъект = СтруктураРеестра.Реестр.ПолучитьОбъект();
			РеестрОбъект.ОбменДанными.Загрузка = Истина;
			РеестрОбъект.Распечатан = Истина;
			РеестрОбъект.Записать();
			
		КонецЕсли;
	Исключение
		
	КонецПопытки;

КонецПроцедуры

Функция НайтиСоздатьРеестр(СтруктураНастроек, СтруктураРеестра) Экспорт

	Реестр = НайтиРеестр(СтруктураНастроек, СтруктураРеестра);
	
	Если НЕ ЗначениеЗаполнено(Реестр) Тогда 
		Реестр = СоздатьРеестр(СтруктураНастроек, СтруктураРеестра);
	КонецЕсли;
	
	Возврат Реестр;
	
КонецФункции

Функция НайтиРеестр(СтруктураНастроек, СтруктураРеестра) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_Реестры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_Реестры КАК eComm_Реестры
		|ГДЕ
		|	eComm_Реестры.Владелец = &УчетнаяЗапись
		|	И eComm_Реестры.Дата = &Дата
		|	И eComm_Реестры.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|			КОГДА eComm_Реестры.Владелец.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.НоваяПочта)
		|				ТОГДА ИСТИНА
		|			КОГДА eComm_Реестры.Владелец.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Укрпочта)
		|				ТОГДА eComm_Реестры.Тип = &Тип
		|			КОГДА eComm_Реестры.Владелец.СлужбаДоставки = ЗНАЧЕНИЕ(Перечисление.eComm_СлужбыДоставки.Justin)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Дата"			, НачалоДня(СтруктураРеестра.Дата));
	Запрос.УстановитьПараметр("УчетнаяЗапись"	, СтруктураНастроек.УчетнаяЗапись);
	Запрос.УстановитьПараметр("Тип"				, ?(СтруктураРеестра.Свойство("ТипГруза"), СтруктураРеестра.ТипГруза, Неопределено));
		
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		
		Возврат РезультатЗапроса.Ссылка;
		
	КонецЕсли;
	
КонецФункции

Функция СоздатьРеестр(СтруктураНастроек, СтруктураРеестра) Экспорт

	РеестрОбъект = Справочники.eComm_Реестры.СоздатьЭлемент();
	РеестрОбъект.Владелец					= СтруктураНастроек.УчетнаяЗапись;
	РеестрОбъект.Дата 						= СтруктураРеестра.Дата;
	РеестрОбъект.Отправитель				= СтруктураРеестра.Отправитель;
	РеестрОбъект.КонтактноеЛицоОтправителя	= СтруктураРеестра.КонтактноеЛицоОтправителя;
	РеестрОбъект.ОтделениеОтправителя		= СтруктураРеестра.ОтделениеОтправителя;
	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		Если СтруктураРеестра.Свойство("Идентификатор") Тогда 
			// Для новой почты идентификатор уже известен
			РеестрОбъект.Наименование 	= "" + Формат(СтруктураРеестра.Дата, "ДФ=dd.MM.yyyy") + " / " + СтруктураРеестра.ОтделениеОтправителя + " / " + СтруктураРеестра.КонтактноеЛицоОтправителя;
			РеестрОбъект.Идентификатор 	= СтруктураРеестра.Идентификатор;
		КонецЕсли;
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Если СтруктураРеестра.Свойство("ТипГруза") Тогда
			// Для укрпочты
			РеестрОбъект.Наименование 	= "" + Формат(СтруктураРеестра.Дата, "ДФ=dd.MM.yyyy") + " (" + СтруктураРеестра.ТипГруза + ")" + " / " + СтруктураРеестра.ОтделениеОтправителя + " / " + СтруктураРеестра.КонтактноеЛицоОтправителя;
			РеестрОбъект.Тип 			= СтруктураРеестра.ТипГруза;
		КонецЕсли;
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда
		Если СтруктураРеестра.Свойство("Идентификатор") Тогда 
			// Для Justin идентификатор уже известен
			РеестрОбъект.Наименование 	= "" + Формат(СтруктураРеестра.Дата, "ДФ=dd.MM.yyyy") + " / " + СтруктураРеестра.ОтделениеОтправителя + " / " + СтруктураРеестра.КонтактноеЛицоОтправителя;
			РеестрОбъект.Идентификатор 	= СтруктураРеестра.Идентификатор;
		КонецЕсли;
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда
		Если СтруктураРеестра.Свойство("Идентификатор") Тогда 
			// Для Meest идентификатор уже известен
			РеестрОбъект.Наименование 	= "" + Формат(СтруктураРеестра.Дата, "ДФ=dd.MM.yyyy") + " / " + СтруктураРеестра.ОтделениеОтправителя + " / " + СтруктураРеестра.КонтактноеЛицоОтправителя;
			РеестрОбъект.Идентификатор 	= СтруктураРеестра.Идентификатор;
		КонецЕсли;
	КонецЕсли;
	РеестрОбъект.Записать();
	
	Реестр = РеестрОбъект.Ссылка;
	
	Возврат Реестр;
	
КонецФункции

