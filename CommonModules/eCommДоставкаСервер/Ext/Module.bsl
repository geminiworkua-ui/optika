Функция ФорматироватьНомер(Номер)
	
	// Берем первый приличный телефон и форматируем его
	//
	//  +38 (0XX) XXXXXXX доб. 999; +38 (0XX) XXX-XX-XX
	
	Результат = "";
	МассивТелефонов = РазложитьСтрокуВМассивПодстрок(Номер, ";");
	
	Для Каждого НомерТелефона Из МассивТелефонов Цикл 
		
		ПозДоб = Найти(ВРЕГ(НомерТелефона), "ДОБ.");
		Если ПозДоб <> 0 Тогда
		    НомерТелефона = СокрЛП(Лев(НомерТелефона, ПозДоб-1));
		КонецЕсли;
			
		НомерБезРазделителей = ТелефонБезРазделителей(НомерТелефона);
		
		Если ЗначениеЗаполнено(НомерБезРазделителей) Тогда 
			Результат = "+" + Лев(НомерБезРазделителей, 2) + "(" + Сред(НомерБезРазделителей, 3, 3) + ")" + Сред(НомерБезРазделителей, 6, 7);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

Функция ИндексИзСтроки(СтрокаПоиска) Экспорт

	ДлинаСтроки = СтрДлина(СтрокаПоиска);
	
	ИндексОбрабатывается	= Ложь;
	ТекущийИндекс			= "";
	
	МассивИндексов = Новый Массив;
	
	Для Сч = 1 По ДлинаСтроки Цикл 
		
		Символ 		= Сред(СтрокаПоиска, Сч, 1);
		КодСимвола 	= КодСимвола(Символ);
		
		Если (КодСимвола >= 48 И КодСимвола <= 57) Тогда 
			
			Если ИндексОбрабатывается = Ложь Тогда 
				// Это первый символ индекса
				ИндексОбрабатывается = Истина;
			КонецЕсли;
			
			ТекущийИндекс = ТекущийИндекс + Символ;
			
		Иначе
			
			ИндексОбрабатывается = Ложь;
			
			Если НЕ ТекущийИндекс = "" Тогда
				
				Если СтрДлина(ТекущийИндекс) = 5 Тогда
					// Строка в формате индекса
					МассивИндексов.Добавить(ТекущийИндекс);
				КонецЕсли;
				
				ТекущийИндекс = "";
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Будем считать что последний индекс в строке - это индекс получателя
	// Напр.: "Одесса, 65000, ул. ЖМ Радужный, Одесса, 65125, д. 8б";
	
	КоличествоЭлементовВМассиве = МассивИндексов.Количество();
	
	Если КоличествоЭлементовВМассиве > 0 Тогда 
		НайденныйИндекс = МассивИндексов[КоличествоЭлементовВМассиве-1];
	Иначе 
		НайденныйИндекс = "";
	КонецЕсли;
	
	Возврат НайденныйИндекс;

КонецФункции

Функция ОтделениеНовойПочтыПоддерживаетРучнуюОбработку(СтруктураНастроек, Отделение)

	//Оформлення відправлень з категорією «Ручне оброблення» дозволено лише з/на вантажні відділення, пункти прийому-видачі та адресу.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ОтделенияДоставки.ТипОтделения КАК ТипОтделения
		|ПОМЕСТИТЬ ВрТабТипОтделения
		|ИЗ
		|	Справочник.eComm_ОтделенияДоставки КАК eComm_ОтделенияДоставки
		|ГДЕ
		|	eComm_ОтделенияДоставки.Ссылка = &Отделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	eComm_ОбщиеСправочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_ОбщиеСправочники КАК eComm_ОбщиеСправочники
		|ГДЕ
		|	eComm_ОбщиеСправочники.СлужбаДоставки = Значение(Перечисление.eComm_СлужбыДоставки.НоваяПочта)
		|	И eComm_ОбщиеСправочники.Родитель = Значение(Справочник.eComm_ОбщиеСправочники.ТипыОтделений)
		//|	И eComm_ОбщиеСправочники.Наименование В (""Вантажне відділення"", ""Поштове відділення"")
		|	И eComm_ОбщиеСправочники.Наименование = ""Вантажне відділення""
		|	И eComm_ОбщиеСправочники.Ссылка В
		|			(ВЫБРАТЬ
		|				ВрТабТипОтделения.ТипОтделения КАК ТипОтделения
		|			ИЗ
		|				ВрТабТипОтделения КАК ВрТабТипОтделения)";
	
	Запрос.УстановитьПараметр("Отделение", Отделение);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

