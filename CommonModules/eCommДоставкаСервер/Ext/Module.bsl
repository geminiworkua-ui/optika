Процедура ЗаполнитьОписаниеСтатуса(СтруктураНастроек, СтруктураЭкспрессНакладной, СтруктураОтвета, МенеджерЗаписи)

	Если СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда
		
		Если НЕ СтруктураЭкспрессНакладной.КодСтатуса = СтруктураОтвета.StatusCode Тогда
			МенеджерЗаписи.Статус			= Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", СтруктураОтвета.StatusCode, Справочники.eComm_ОбщиеСправочники.СтатусыЭкспрессНакладных);
			МенеджерЗаписи.ОписаниеСтатуса	= СтруктураОтвета.Status;
		КонецЕсли;
		
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда
		
		Status = "";
		
		Если СтруктураОтвета.Свойство("Status") Тогда 
			
			Status = СтруктураОтвета.Status;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Status)
			И НЕ СтруктураЭкспрессНакладной.КодСтатуса = Status Тогда
			МенеджерЗаписи.Статус			= Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", Status, Справочники.eComm_ОбщиеСправочники.СтатусыЭкспрессНакладныхУкрпочта);
			МенеджерЗаписи.ОписаниеСтатуса	= МенеджерЗаписи.Статус;
		КонецЕсли;
		
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Justin Тогда
		
		statusOrder = "";
		
		Если ТипЗнч(СтруктураОтвета) = Тип("Структура")
			И СтруктураОтвета.Свойство("fields")
			И ТипЗнч(СтруктураОтвета.fields) = Тип("Структура")
			И СтруктураОтвета.fields.Свойство("statusOrder") 
			И ТипЗнч(СтруктураОтвета.fields.statusOrder) = Тип("Структура")
			И СтруктураОтвета.fields.statusOrder.Свойство("uuid") Тогда 
			
			Попытка
				statusOrder = СтруктураОтвета.fields.statusOrder.uuid;
			Исключение
				Сообщить("Ошибка преобразования кода статуса: " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(statusOrder)
			И НЕ СтруктураЭкспрессНакладной.КодСтатуса = statusOrder Тогда
			МенеджерЗаписи.Статус			= Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", statusOrder, Справочники.eComm_ОбщиеСправочники.СтатусыЭкспрессНакладныхJustin);
			МенеджерЗаписи.ОписаниеСтатуса	= МенеджерЗаписи.Статус;
		КонецЕсли;
		
	ИначеЕсли СтруктураНастроек.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.Meest Тогда
		
		eventCode = "";
		
		Если СтруктураОтвета.Свойство("eventCode") Тогда 
			
			Попытка
				eventCode = Формат(Число(СтруктураОтвета.eventCode), "ЧГ=0");
			Исключение
				Сообщить("Ошибка преобразования кода статуса: " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(eventCode)
			И НЕ СтруктураЭкспрессНакладной.КодСтатуса = eventCode Тогда
			МенеджерЗаписи.Статус			= Справочники.eComm_ОбщиеСправочники.НайтиПоРеквизиту("Идентификатор", eventCode, Справочники.eComm_ОбщиеСправочники.СтатусыЭкспрессНакладныхMeest);
			МенеджерЗаписи.ОписаниеСтатуса	= МенеджерЗаписи.Статус;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

