Функция ТелефонБезРазделителей(Телефон) Экспорт

	ТелефонБезРазделителей = "";
	Для а = 1 По СтрДлина(Телефон) Цикл
		КодСимвола = КодСимвола(Сред(Телефон, а, 1));
		Цифра = Сред(Телефон, а, 1);
		Если (КодСимвола >= 48 И КодСимвола <= 57) Тогда
			ТелефонБезРазделителей = ТелефонБезРазделителей + Цифра;
		КонецЕсли; 
	КонецЦикла;
	
	ДлинаНомера = СтрДлина(ТелефонБезРазделителей);
	
	Если ДлинаНомера = 12 
		И Лев(ТелефонБезРазделителей, 2) = "38" Тогда 
		Результат = ТелефонБезРазделителей;
	ИначеЕсли ДлинаНомера = 11 
		И Лев(ТелефонБезРазделителей, 1) = "8" Тогда 
		Результат = "3" + ТелефонБезРазделителей;
	ИначеЕсли ДлинаНомера = 10 Тогда 
		Результат = "38" + ТелефонБезРазделителей;
	Иначе
		Результат = "";
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ФамилияИмяОтчество(Знач ФИО) Экспорт
    
    СтруктураФИО = Новый Структура("Фамилия, Имя, Отчество");
    
    МассивПодстрок = РазложитьСтрокуВМассивПодстрок(ФИО, " ");
    
    Если МассивПодстрок.Количество() > 0 Тогда
        СтруктураФИО.Вставить("Фамилия", МассивПодстрок[0]);
        Если МассивПодстрок.Количество() > 1 Тогда
            СтруктураФИО.Вставить("Имя", МассивПодстрок[1]);
        КонецЕсли;
        Если МассивПодстрок.Количество() > 2 Тогда
            Отчество = "";
            Для Шаг = 2 По МассивПодстрок.Количество()-1 Цикл
                Отчество = Отчество + МассивПодстрок[Шаг] + " ";
            КонецЦикла;
			Отчество = Лев(Отчество, СтрДлина(Отчество) -1);
            СтруктураФИО.Вставить("Отчество", Отчество);
        КонецЕсли;
    КонецЕсли;
    
    Возврат СтруктураФИО;
    
КонецФункции

Функция СформироватьСообщениеУНФ(ШаблонСМС, ЭкспрессНакладная)

	МодульШаблоныСообщений = ОбщийМодуль("ШаблоныСообщений");
	
	Если МодульШаблоныСообщений = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ЭкспрессНакладная) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнительныеПараметры	= Новый Структура;
	Произвольные 			= Новый Соответствие;
	ДополнительныеПараметры.Вставить("ПроизвольныеПараметры", Произвольные);
	
	СообщениеСПараметром = МодульШаблоныСообщений.СформироватьСообщение(ШаблонСМС, ЭкспрессНакладная, Новый УникальныйИдентификатор, ДополнительныеПараметры);
	
	Возврат СообщениеСПараметром.Текст;

КонецФункции

Функция СформироватьСообщениеУТBAS(ШаблонСМС, ЭкспрессНакладная)

	МодульШаблоныСообщенийСервер 	= ОбщийМодуль("ШаблоныСообщенийСервер");
	МодульОтчетыКлиентСервер 		= ОбщийМодуль("ОтчетыКлиентСервер");
	
	Если МодульШаблоныСообщенийСервер = Неопределено
		ИЛИ МодульОтчетыКлиентСервер = Неопределено 
		ИЛИ НЕ ЗначениеЗаполнено(ЭкспрессНакладная) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстШаблонаSMS = ШаблонСМС.ТекстШаблонаSMS;
	
	СоответстиеПараметровТекстаСообщения = МодульШаблоныСообщенийСервер.ПараметрыТекстаСообщения(Ложь, Истина, Неопределено, "", "", "", ТекстШаблонаSMS);
	
	Для каждого ЭлементСоответствия Из СоответстиеПараметровТекстаСообщения Цикл
		
		Попытка
		
			МакетСКД 			= Документы.eComm_ЭкспрессНакладная.ПолучитьМакет("ДанныеШаблонаСообщений");
			АдресСхемы 			= ПоместитьВоВременноеХранилище(МакетСКД, Новый УникальныйИдентификатор);
			
			КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
			КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
			КомпоновщикНастроек.ЗагрузитьНастройки(МакетСКД.НастройкиПоУмолчанию);
			КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
			
			КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
			
			Для Каждого ВыбранноеПоле Из ЭлементСоответствия.Значение Цикл 
				МодульОтчетыКлиентСервер.ДобавитьВыбранноеПоле(КомпоновщикНастроек, ВыбранноеПоле);
			КонецЦикла;
			
			МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(МакетСКД, КомпоновщикНастроек.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
			ТекстЗапроса = МакетКомпоновкиДанных.НаборыДанных.Данные.Запрос;
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("eComm_ЭкспрессНакладная", ЭкспрессНакладная);
			
			ТаблицаВыводимыхПолей = Запрос.Выполнить().Выгрузить();
			
			Если ТаблицаВыводимыхПолей.Количество() > 0 Тогда 
				
				СтрокаДанныхШаблона 		= ТаблицаВыводимыхПолей[0];
				ТаблицаПараметровСообщения 	= МодульШаблоныСообщенийСервер.ПустаяТаблицаПараметровСообщения();
				МассивПараметров 			= СоответстиеПараметровТекстаСообщения.Получить("eComm_ЭкспрессНакладная");
				
				Если МассивПараметров <> Неопределено Тогда
					
					Для Каждого Параметр Из МассивПараметров Цикл
						Попытка
							МодульШаблоныСообщенийСервер.ДобавитьСтрокуТаблицуПараметров(ТаблицаПараметровСообщения, "eComm_ЭкспрессНакладная" + "." + Параметр, СтрокаДанныхШаблона[Параметр]);
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
				
				ТекстСообщения = МодульШаблоныСообщенийСервер.ВставитьПараметрыВСтрокуСогласноТаблицеПараметров(ТекстШаблонаSMS, ТаблицаПараметровСообщения);
				
				Возврат ТекстСообщения;
				
			КонецЕсли;
			
			Прервать;
			
		Исключение
			
			Возврат Неопределено
			
		КонецПопытки;
		
	КонецЦикла;

КонецФункции

Функция СформироватьСообщениеУТП(ШаблонСМС, ЭкспрессНакладная)

	Если НЕ ЗначениеЗаполнено(ЭкспрессНакладная) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстШаблонаSMS = ШаблонСМС.ТекстШаблонаSMS;
	
	СоответстиеПараметровТекстаСообщения = ПолучитьПараметрыТекстаСообщения(ТекстШаблонаSMS);
	
	Для каждого ЭлементСоответствия Из СоответстиеПараметровТекстаСообщения Цикл
		
		Попытка
		
			МакетСКД 			= Документы.eComm_ЭкспрессНакладная.ПолучитьМакет("ДанныеШаблонаСообщений");
			АдресСхемы 			= ПоместитьВоВременноеХранилище(МакетСКД, Новый УникальныйИдентификатор);
			
			КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
			КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
			КомпоновщикНастроек.ЗагрузитьНастройки(МакетСКД.НастройкиПоУмолчанию);
			КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
			
			КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
			
			Для Каждого ВыбранноеПоле Из ЭлементСоответствия.Значение Цикл 
				ВыбранныеПоляКД = КомпоновщикНастроек.Настройки.Выбор;
				ВыбранноеПолеКД = ВыбранныеПоляКД.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				ВыбранноеПолеКД.Поле = Новый ПолеКомпоновкиДанных(ВыбранноеПоле);
			КонецЦикла;
			
			МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(МакетСКД, КомпоновщикНастроек.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
			ТекстЗапроса = МакетКомпоновкиДанных.НаборыДанных.Данные.Запрос;
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("eComm_ЭкспрессНакладная", ЭкспрессНакладная);
			
			ТаблицаВыводимыхПолей = Запрос.Выполнить().Выгрузить();
			
			Если ТаблицаВыводимыхПолей.Количество() > 0 Тогда 
				
				СтрокаДанныхШаблона 		= ТаблицаВыводимыхПолей[0];
				ТаблицаПараметровСообщения = Новый ТаблицаЗначений;
				ТаблицаПараметровСообщения.Колонки.Добавить("Ключ");
				ТаблицаПараметровСообщения.Колонки.Добавить("Значение");
				МассивПараметров 			= СоответстиеПараметровТекстаСообщения.Получить("eComm_ЭкспрессНакладная");
				
				Если МассивПараметров <> Неопределено Тогда
					
					Для Каждого Параметр Из МассивПараметров Цикл
						Попытка
							НоваяСтрока = ТаблицаПараметровСообщения.Добавить();
							НоваяСтрока.Ключ = "eComm_ЭкспрессНакладная" + "." + Параметр;
							НоваяСтрока.Значение = СтрокаДанныхШаблона[Параметр];
						Исключение
						КонецПопытки;
					КонецЦикла;
					
				КонецЕсли;
				
				ТекстСообщения = ВставитьПараметрыВСтрокуСогласноТаблицеПараметров(ТекстШаблонаSMS, ТаблицаПараметровСообщения);
				
				Возврат ТекстСообщения;
				
			КонецЕсли;
			
			Прервать;
			
		Исключение
			
			Возврат Неопределено
			
		КонецПопытки;
		
	КонецЦикла;	

КонецФункции

Функция ВставитьПараметрыВСтрокуСогласноТаблицеПараметров(Знач ШаблонСтроки, ВставляемыеЗначения)
	
	Результат = ШаблонСтроки;
	Для Каждого Параметр Из ВставляемыеЗначения Цикл
		Результат = СтрЗаменить(Результат, "[" + Параметр.Ключ + "]",
		                       ?(ТипЗнч(Параметр.Значение) = Тип("Дата"),
		                       Формат(Параметр.Значение, "ДЛФ=DD"), Параметр.Значение));
	КонецЦикла;
						   
	Возврат Результат;
	
КонецФункции

Функция КоличествоСМСПоЗаказу(ЗаказПокупателя) Экспорт

	ИмяДокументаСообщениеSMS 		= eCommДоставкаСервер.ВернутьИмяПрикладногоОбъекта("СообщениеSMS");
	Если НЕ ЗначениеЗаполнено(ИмяДокументаСообщениеSMS) Тогда 
		Возврат 0;
	КонецЕсли;
	
	ИмяРеквизитаДокументОснование 	= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("СообщениеSMS", "ДокументОснование");
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СообщениеSMS.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ИмяДокументаСообщениеSMS + " КАК СообщениеSMS
		|ГДЕ
		|	СообщениеSMS." + ИмяРеквизитаДокументОснование + " = &ЗаказПокупателя";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатЗапроса.Количество();

КонецФункции

Функция СуммаЗаказа(ДокументОснование) Экспорт

	Запрос = Новый Запрос;
	ЗапросТекст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.СуммаДокумента КАК СуммаДокумента
		|ИЗ
		|	Документ.#ЗаказКлиента# КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка = &Ссылка";
	
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "#ЗаказКлиента#", eCommДоставкаСервер.ВернутьИмяПрикладногоОбъекта("ЗаказКлиента"));
	
	Запрос.Текст = ЗапросТекст;
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда 
	    Результат = РезультатЗапроса.СуммаДокумента;
	Иначе
		Результат = 0;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Исключительно для "Новая почта"
Функция ВесОбъемТоваровЗаказа(ДокументОснование) Экспорт

	СтруктураРезультата = Новый Структура("Вес, Объем", 0, 0);
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда 
		Возврат СтруктураРезультата;
	КонецЕсли;
	
	ИмяОбъектаЗаказКлиента 	= eCommДоставкаСервер.ВернутьИмяПрикладногоОбъекта("ЗаказКлиента");
	ИмяРеквизита_Товары 	= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары");
	ИмяРеквизита_Вес		= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Вес");
	ИмяРеквизита_Объем		= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Объем");
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	СУММА(#ИмяРеквизита_Вес# * ЗаказКлиентаТовары.Количество) КАК Вес,
		|	СУММА(#ИмяРеквизита_Объем# * ЗаказКлиентаТовары.Количество) КАК Объем,
		|	ЗаказКлиентаТовары.Номенклатура,
		|	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество
		|ИЗ
		|	Документ.#ИмяОбъектаЗаказКлиента#.#ИмяРеквизита_Товары# КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка = &ДокументОснование
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.Номенклатура
		|;";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаЗаказКлиента#"	, ИмяОбъектаЗаказКлиента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Товары#"	, ИмяРеквизита_Товары);
	
	Если ЗначениеЗаполнено(ИмяРеквизита_Вес) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Вес#"	, "ЗаказКлиентаТовары.Номенклатура." + ИмяРеквизита_Вес);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Вес#"	, "0");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяРеквизита_Объем) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Объем#"	, "ЗаказКлиентаТовары.Номенклатура." + ИмяРеквизита_Объем);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Объем#"	, "0");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	ТоварыЗаказаВыборка = Запрос.Выполнить().Выбрать();
	
	ОбщийВес 	= 0;
	ОбщийОбъем 	= 0;
	
	Пока ТоварыЗаказаВыборка.Следующий() Цикл  
		
		Если ЗначениеЗаполнено(ТоварыЗаказаВыборка.Вес) Тогда 
			ОбщийВес = ОбщийВес + ТоварыЗаказаВыборка.Вес;
		Иначе
			ОбщийВес = ОбщийВес + (0.1 * ТоварыЗаказаВыборка.Количество);
			//Сообщить("Для номенклатуры """ + ТоварыЗаказаВыборка.Номенклатура + """ будет использован вес по умолчанию 0.1 кг");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТоварыЗаказаВыборка.Объем) Тогда 
			ОбщийОбъем = ОбщийОбъем + ТоварыЗаказаВыборка.Объем;
		Иначе
			ОбщийОбъем = ОбщийОбъем + (0.0004 * ТоварыЗаказаВыборка.Количество);
			//Сообщить("Для номенклатуры """ + ТоварыЗаказаВыборка.Номенклатура + """ будет использован объем по умолчанию 0.0004 м3");
		КонецЕсли;
		
	КонецЦикла;

	Возврат Новый Структура("Вес, Объем", ОбщийВес, ОбщийОбъем);
	
КонецФункции

// Исключительно для "Укрпочта"
Функция ВесДлинаТоваровЗаказа(ДокументОснование) Экспорт

	СтруктураРезультата = Новый Структура("Вес, Длина", 0, 0);
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда 
		Возврат СтруктураРезультата;
	КонецЕсли;
	
	ИмяОбъектаЗаказКлиента 	= eCommДоставкаСервер.ВернутьИмяПрикладногоОбъекта("ЗаказКлиента");
	ИмяРеквизита_Товары 	= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары");
	ИмяРеквизита_Вес		= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Вес");
	ИмяРеквизита_Длина		= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Длина");
	ИмяРеквизита_Ширина		= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Ширина");
	ИмяРеквизита_Высота		= eCommДоставкаСервер.ВернутьИмяРеквизитаОбъекта("Номенклатура", "Высота");
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	СУММА(#ИмяРеквизита_Вес# * ЗаказКлиентаТовары.Количество) КАК Вес,
		|	СУММА(#ИмяРеквизита_Длина#) КАК Длина,
		|	СУММА(#ИмяРеквизита_Ширина#) КАК Ширина,
		|	СУММА(#ИмяРеквизита_Высота#) КАК Высота,
		|	ЗаказКлиентаТовары.Номенклатура,
		|	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество
		|ИЗ
		|	Документ.#ИмяОбъектаЗаказКлиента#.#ИмяРеквизита_Товары# КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка = &ДокументОснование
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.Номенклатура
		|;";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяОбъектаЗаказКлиента#"	, ИмяОбъектаЗаказКлиента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Товары#"	, ИмяРеквизита_Товары);
	
	Если ЗначениеЗаполнено(ИмяРеквизита_Вес) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Вес#"	, "ЗаказКлиентаТовары.Номенклатура." + ИмяРеквизита_Вес);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Вес#"	, "0");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяРеквизита_Длина) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Длина#"	, "ЗаказКлиентаТовары.Номенклатура." + ИмяРеквизита_Длина);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Длина#"	, "0");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяРеквизита_Ширина) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Ширина#"	, "ЗаказКлиентаТовары.Номенклатура." + ИмяРеквизита_Ширина);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Ширина#"	, "0");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяРеквизита_Ширина) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Высота#"	, "ЗаказКлиентаТовары.Номенклатура." + ИмяРеквизита_Высота);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяРеквизита_Высота#"	, "0");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	ТоварыЗаказаВыборка = Запрос.Выполнить().Выбрать();
	
	ОбщийВес 			= 0;
	МаксимальнаяДлина 	= 0;
	
	Пока ТоварыЗаказаВыборка.Следующий() Цикл  
		
		Если ЗначениеЗаполнено(ТоварыЗаказаВыборка.Вес) Тогда 
			ОбщийВес = ОбщийВес + ТоварыЗаказаВыборка.Вес;
		Иначе

		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТоварыЗаказаВыборка.Длина) Тогда 
			МаксимальнаяДлина = Макс(МаксимальнаяДлина, ТоварыЗаказаВыборка.Длина, ТоварыЗаказаВыборка.Ширина, ТоварыЗаказаВыборка.Высота);
		Иначе

		КонецЕсли;
		
	КонецЦикла;

	Возврат Новый Структура("Вес, Длина", ОбщийВес, МаксимальнаяДлина);
	
КонецФункции

Функция ДополнительнаяИнформацияПоЗаказу(ДокументОснование) Экспорт

	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда 
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ЗапросТекст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	ЗаказКлиентаТовары.Количество КАК Количество
		|ИЗ
		|	Документ.#ЗаказКлиента#.#Товары# КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка = &Ссылка";
	
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "#ЗаказКлиента#"	, ВернутьИмяПрикладногоОбъекта("ЗаказКлиента"));
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "#Товары#"		, ВернутьИмяРеквизитаОбъекта("ЗаказКлиента", "Товары"));
	
	Запрос.Текст = ЗапросТекст;
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Результат = "";
	Пока РезультатЗапроса.Следующий() Цикл 
		Результат = Результат + ?(ЗначениеЗаполнено(Результат), " ", "") + РезультатЗапроса.Номенклатура + " - " + РезультатЗапроса.Количество + ";";
	КонецЦикла;
	
	Возврат Лев(Результат, 100);

КонецФункции

Процедура ЗаполнитьСообщениеУНФ(ДанныеФормы, ТекстСообщения, СтруктураЭкспрессНакладной, ШаблонСМС)

	ДанныеФормы.Дата		= ТекущаяДата();
	ДанныеФормы.Автор 		= ПараметрыСеанса.ТекущийПользователь;
	//ДанныеФормы.Важность 	= Перечисления.ВариантыВажности.Обычная;
	ДанныеФормы.ВходящееИсходящееСобытие = Перечисления.ВходящееИсходящееСобытие.Исходящее;
	ДанныеФормы.ДокументОснование 		= СтруктураЭкспрессНакладной.ДокументОснование;
	ДанныеФормы.Содержание 				= ТекстСообщения;
	ДанныеФормы.ТипСобытия 				= Перечисления.ТипыСобытий.СообщениеSMS;
	ДанныеФормы.ХозяйственнаяОперация 	= Справочники.ХозяйственныеОперации.Событие;
	
	Участник = ДанныеФормы.Участники.Добавить();
	Участник.Контакт 			= СтруктураЭкспрессНакладной.ДокументОснование.Контрагент;
	Участник.КакСвязаться		= ТелефонБезРазделителей(СтруктураЭкспрессНакладной.ТелефонПолучателя);
	Участник.НомерДляОтправки 	= Участник.КакСвязаться;

КонецПроцедуры

Процедура ЗаполнитьСообщениеУТBAS(ДанныеФормы, ТекстСообщения, СтруктураЭкспрессНакладной, ШаблонСМС)

	ДанныеФормы.Дата					= ТекущаяДата();
	ДанныеФормы.Автор 					= ПараметрыСеанса.ТекущийПользователь;
	ДанныеФормы.ВзаимодействиеОснование = СтруктураЭкспрессНакладной.ДокументОснование;
	ДанныеФормы.ТекстСообщения			= ТекстСообщения;
	ДанныеФормы.ОтправлятьВТранслите	= ШаблонСМС.ОтправлятьВТранслите;
	
	Участник = ДанныеФормы.Адресаты.Добавить();
	Участник.Контакт 				= СтруктураЭкспрессНакладной.ДокументОснование.Партнер;
	Участник.ПредставлениеКонтакта 	= СтруктураЭкспрессНакладной.ДокументОснование.Партнер; 
	Участник.КакСвязаться			= ФорматироватьНомер(СтруктураЭкспрессНакладной.ТелефонПолучателя);
	Участник.НомерДляОтправки 		= ТелефонБезРазделителей(Участник.КакСвязаться);
	Участник.СостояниеСообщения		= Перечисления["СостоянияСообщенияSMS"].Исходящее;

КонецПроцедуры

Процедура ЗаполнитьСообщениеУТП(ДанныеФормы, ТекстСообщения, СтруктураЭкспрессНакладной, ШаблонСМС)

	ДанныеФормы.Дата					= ТекущаяДата();
	ДанныеФормы.ДокументОснование		= СтруктураЭкспрессНакладной.ДокументОснование;
	ДанныеФормы.ТекстСообщения			= ТекстСообщения;
	
	Участник = ДанныеФормы.Адресаты.Добавить();
	//Участник.Контакт 				= СтруктураЭкспрессНакладной.ДокументОснование.Партнер;
	Участник.НомерДляОтправки 		= ТелефонБезРазделителей(ФорматироватьНомер(СтруктураЭкспрессНакладной.ТелефонПолучателя));
	Участник.СостояниеСообщения		= Перечисления["eComm_СостоянияДокументаСообщениеSMS"].Исходящее;	

КонецПроцедуры

Функция ПолучитьПараметрыТекстаСообщения(ТекстСообщения) Экспорт

	МассивПараметров = Новый Массив;
	
	Текст = ТекстСообщения;
	Позиция = Найти(Текст, "[");
	Пока Позиция > 0 Цикл
		Текст = Сред(Текст, Позиция + 1);
		Позиция = Найти(Текст, "]");
		Если Позиция > 0 Тогда
			НайденныйПараметр = Лев(Текст,Позиция-1);
			Если МассивПараметров.Найти(НайденныйПараметр) = Неопределено Тогда
				МассивПараметров.Добавить(НайденныйПараметр);
			КонецЕсли;
			Текст = Сред(Текст, Позиция + 1);
		КонецЕсли;
		Позиция = Найти(Текст, "[");
	КонецЦикла;
	
	СоответствиеПараметров = Новый Соответствие;
	Для каждого ЭлементаМассиваПараметров Из МассивПараметров Цикл
	
		МассивРазобранныйПараметр = РазложитьСтрокуВМассивПодстрок(ЭлементаМассиваПараметров,".");
		Если МассивРазобранныйПараметр.Количество() <> 2 Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементСоответствия = СоответствиеПараметров.Получить(МассивРазобранныйПараметр[0]);
		Если ЭлементСоответствия = Неопределено Тогда
			МассивПараметровПоТипу = Новый Массив;
			МассивПараметровПоТипу.Добавить(МассивРазобранныйПараметр[1]);
			СоответствиеПараметров.Вставить(МассивРазобранныйПараметр[0], МассивПараметровПоТипу);
		Иначе
			ЭлементСоответствия.Добавить(МассивРазобранныйПараметр[1]);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат СоответствиеПараметров;
	
