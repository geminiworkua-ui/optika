Функция ТипКонтрагентаЧастноеЛицо(СлужбаДоставки) Экспорт

	Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта Тогда 
		Идентификатор 	= "PrivatePerson";
		Родитель 		= Справочники.eComm_ОбщиеСправочники.ТипыКонтрагентов;
	Иначе//Если СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта Тогда 
		Идентификатор 	= "INDIVIDUAL";
		Родитель 		= Справочники.eComm_ОбщиеСправочники.ТипыКонтрагентовУкрпочта;
	//Иначе
	//	Возврат Неопределено;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	eComm_ОбщиеСправочники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.eComm_ОбщиеСправочники КАК eComm_ОбщиеСправочники
		|ГДЕ
		|	eComm_ОбщиеСправочники.Идентификатор = &Идентификатор
		|	И eComm_ОбщиеСправочники.Родитель = &Родитель";
	
	Запрос.УстановитьПараметр("Идентификатор"	, Идентификатор);
	Запрос.УстановитьПараметр("Родитель"		, Родитель);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда 
		Возврат Результат.Ссылка;
	КонецЕсли;

