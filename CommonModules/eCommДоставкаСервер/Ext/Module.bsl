Функция СформироватьТекстЗапроса(СтруктураПоиска, НаименованиеОбъекта, ТипОбъект)
  ТекстЗапроса = ТекстЗапроса(НаименованиеОбъекта, ТипОбъект); 
  
  ТекстЗапроса = ТекстЗапросаИсключитьОтборПоРеквизитуБулево(НаименованиеОбъекта, ТекстЗапроса, "ПометкаУдаления");

  Если СтруктураПоиска.СлужбаДоставки Тогда	
  	ТекстЗапроса = ТекстЗапросаДобавитьОтборПоРеквизитуЗначению(НаименованиеОбъекта, ТекстЗапроса, "СлужбаДоставки");
  КонецЕсли;

  Если СтруктураПоиска.Идентификатор Тогда	  
	  ТекстЗапроса = ТекстЗапросаДобавитьОтборПоРеквизитуЗначению(НаименованиеОбъекта, ТекстЗапроса, "Идентификатор");
	  
	  //Если СтруктураПоиска.Владелец Тогда
	  //    Возврат ТекстЗапросаДобавитьОтборПоРеквизитуЗначению(НаименованиеОбъекта, ТекстЗапроса, "Владелец");
	  //КонецЕсли;
	  Возврат ТекстЗапроса;
  КонецЕсли;
  
  Если СтруктураПоиска.Наименование Тогда	  
	  ТекстЗапроса = ТекстЗапросаДобавитьОтборПоРеквизитуЗначению(НаименованиеОбъекта, ТекстЗапроса, "Наименование");
	  Если СтруктураПоиска.Владелец Тогда
	      Возврат ТекстЗапросаДобавитьОтборПоРеквизитуЗначению(НаименованиеОбъекта, ТекстЗапроса, "Владелец");
	  КонецЕсли;
	  Возврат ТекстЗапроса;
  КонецЕсли;

КонецФункции	

Процедура УстановитьПараметрыЗапроса(Запрос, СтруктураОбъекта, СтруктураПоиска)
  Если СтруктураПоиска.СлужбаДоставки Тогда	  
	  Запрос.УстановитьПараметр("СлужбаДоставки", СтруктураОбъекта["СлужбаДоставки"]); 
  КонецЕсли;
	
	
  Если СтруктураПоиска.Идентификатор Тогда	  
	  Запрос.УстановитьПараметр("Идентификатор", СтруктураОбъекта["Идентификатор"]); 
	  //Если СтруктураПоиска.Владелец Тогда
	  //    Запрос.УстановитьПараметр("Владелец", СтруктураОбъекта["Владелец"]); 
	  //КонецЕсли;
	  Возврат;
  КонецЕсли;
  
  Если СтруктураПоиска.Наименование Тогда	  
	  Запрос.УстановитьПараметр("Наименование", СтруктураОбъекта["Наименование"]);
	  
	  Если СтруктураПоиска.Владелец Тогда
		   Запрос.УстановитьПараметр("Владелец", СтруктураОбъекта["Владелец"]);
	  КонецЕсли;
	  Возврат;
  КонецЕсли;
	
КонецПроцедуры	

Функция СтруктураПоиска(СтруктураСправочника)
	СтрПоиска = Новый Структура;
	СтрПоиска.Вставить("Владелец"     , СтруктураСправочника.Свойство("Владелец"));
    СтрПоиска.Вставить("Идентификатор", СтруктураСправочника.Свойство("Идентификатор"));
    СтрПоиска.Вставить("Наименование" , СтруктураСправочника.Свойство("Наименование"));  
	СтрПоиска.Вставить("СлужбаДоставки" , СтруктураСправочника.Свойство("СлужбаДоставки"));
	Возврат СтрПоиска;
 КонецФункции

Функция НайтиСоздатьЭлементСправочника(СтруктураОбъекта, НазваниеОбъекта) Экспорт  
  Ссылка = НайтиЭлементСправочника(СтруктураОбъекта, НазваниеОбъекта);
  Если Не СтруктураОбъекта.Изменять Тогда
	  Возврат  Ссылка;
  КонецЕсли;
  
   Если Не Ссылка = Неопределено Тогда
	 	Объект = Ссылка.ПолучитьОбъект();
		Если Объект =Неопределено Тогда
			 Объект = Справочники[НазваниеОбъекта].СоздатьЭлемент();
		КонецЕсли;
   Иначе		   
		 Объект = Справочники[НазваниеОбъекта].СоздатьЭлемент();
   КонецЕсли;
	 
   ЗаполнитьЗначенияСвойств(Объект, СтруктураОбъекта);   
   Объект.ОбменДанными.Загрузка =Истина;
   Попытка
	   Объект.Записать();   
	   Возврат Объект.Ссылка;
   Исключение 
   КонецПопытки;	   
КонецФункции  

Функция НайтиСоздатьДокумент(СтруктураОбъекта, НазваниеОбъекта) Экспорт  
 Ссылка = НайтиДокумент(СтруктураОбъекта, НазваниеОбъекта);
  Если Не СтруктураОбъекта.Изменять Тогда
	  Возврат  Ссылка;
  КонецЕсли;
  
   Если Не Ссылка = Неопределено Тогда
	 	Объект = Ссылка.ПолучитьОбъект();
		Если Объект =Неопределено Тогда
			 Объект = Документы[НазваниеОбъекта].СоздатьДокумент();
		КонецЕсли;
   Иначе		   
		 Объект = Документы[НазваниеОбъекта].СоздатьДокумент();
   КонецЕсли;
	 
   ЗаполнитьЗначенияСвойств(Объект, СтруктураОбъекта);   
   Объект.ОбменДанными.Загрузка =Истина;
   Попытка
	   Объект.Записать();   
	   Возврат Объект.Ссылка;
   Исключение 
   КонецПопытки;	   
КонецФункции 

Функция НайтиОбъект(СтруктураОбъекта, НаименованиеОбъекта, ТипОбъекта) 
  СтрПоиска = СтруктураПоиска(СтруктураОбъекта);
	
  Запрос =Новый Запрос();	
  Запрос.Текст = СформироватьТекстЗапроса(СтрПоиска, НаименованиеОбъекта, ТипОбъекта);
  УстановитьПараметрыЗапроса(Запрос, СтруктураОбъекта, СтрПоиска);
  Результат = Запрос.Выполнить().Выбрать();
  ЭтоПервый = Истина;
  Пока Результат.Следующий() Цикл
	  Если ЭтоПервый Тогда
	      Запись =Результат.Ссылка;
		  ЭтоПервый = Ложь;
		  Продолжить;
	  КонецЕсли;
	  Об = Результат.ссылка.ПолучитьОбъект();
	  Если Об = Неопределено Тогда
		  Продолжить;
	  КонецЕсли;	 
	  Об.ПометкаУдаления  = Истина;
	  Об.ОбменДанными.Загрузка  = Истина;
	  Об.Записать();
  КонецЦикла;	  

  Возврат Запись;
  	  
КонецФункции	

Функция НайтиЭлементСправочника(СтруктураОбъекта, НаименованиеОбъекта);
 Возврат НайтиОбъект(СтруктураОбъекта, НаименованиеОбъекта, "Справочник");
КонецФункции 

Функция НайтиДокумент(СтруктураОбъекта, НаименованиеОбъекта)   
	СТруктураПоиска =Новый Структура;
	СТруктураПоиска.Вставить("Идентификатор", СтруктураОбъекта.Идентификатор);
  Возврат НайтиОбъект(СТруктураПоиска, НаименованиеОбъекта, "Документ");
КонецФункции	

