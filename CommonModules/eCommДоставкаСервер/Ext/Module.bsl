Процедура ПослеОтправкиСообщения(СтруктураНастроек, СообщениеСМС, РезультатОтправки)

	Если СтруктураНастроек.ИмяКонфигурации = "BASSmallBusiness" Тогда
		ПослеОтправкиСообщенияУНФ(СтруктураНастроек, СообщениеСМС, РезультатОтправки);
	ИначеЕсли СтруктураНастроек.ИмяКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" Тогда
		ПослеОтправкиСообщенияУТП(СтруктураНастроек, СообщениеСМС, РезультатОтправки);
	Иначе
		ПослеОтправкиСообщенияУТBAS(СтруктураНастроек, СообщениеСМС, РезультатОтправки);
	КонецЕсли;

