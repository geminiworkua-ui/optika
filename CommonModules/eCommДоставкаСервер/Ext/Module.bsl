Функция НайтиКонтрагентаСлужбыДоставки(СтруктураНастроек, СтруктураКонтрагента) Экспорт
	
	Если СтруктураКонтрагента.свойство("Идентификатор") Тогда    
		Возврат НайтиСоздатьЭлементСправочника(СтруктураКонтрагента, "eComm_КонтрагентыДоставки");	
	Иначе	
	
	
	// Имеет смысл только для Урпочты
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтрагентыДоставки.Ссылка КАК Ссылка,
		|	КонтрагентыДоставки.Телефон КАК Телефон
		|ИЗ
		|	Справочник.eComm_КонтрагентыДоставки КАК КонтрагентыДоставки
		|ГДЕ
		|	КонтрагентыДоставки.Владелец = &УчетнаяЗапись
		|	И КонтрагентыДоставки.Телефон В(&Телефоны)
		|	И ВЫБОР
		|			КОГДА &ПоискПоТелефонуФИО = ИСТИНА
		|				ТОГДА КонтрагентыДоставки.Наименование = &Наименование
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И НЕ КонтрагентыДоставки.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись"		, СтруктураНастроек.УчетнаяЗапись);
	Запрос.УстановитьПараметр("Телефоны"			, СтруктураКонтрагента.Телефон);
	Запрос.УстановитьПараметр("ПоискПоТелефонуФИО"	, ?(СтруктураНастроек.Настройки.СпособИдентификацииПолучателя = "ПоНомеруТелефонаФИО", Истина, Ложь));
	Запрос.УстановитьПараметр("Наименование"		, СтруктураКонтрагента.Наименование);
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда 
		Возврат РезультатЗапроса.Ссылка;
	КонецЕсли;

КонецФункции  

