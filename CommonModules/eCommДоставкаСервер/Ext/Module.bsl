Функция СписокЭкспрессНакладных(ЗаказКлиента) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_ЭкспрессНакладная.Ссылка КАК Ссылка,
		|	eComm_ЭкспрессНакладная.Дата КАК Дата,
		|	eComm_ЭкспрессНакладная.НомерТТН КАК НомерТТН,
		|	eComm_СтатусыЭкспрессНакладных.ОписаниеСтатуса КАК ОписаниеСтатуса
		|ИЗ
		|	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.eComm_СтатусыЭкспрессНакладных КАК eComm_СтатусыЭкспрессНакладных
		|		ПО (eComm_СтатусыЭкспрессНакладных.ЭкспрессНакладная = eComm_ЭкспрессНакладная.Ссылка)
		|ГДЕ
		|	eComm_ЭкспрессНакладная.ДокументОснование = &ДокументОснование
		|
		|УПОРЯДОЧИТЬ ПО
		|	eComm_ЭкспрессНакладная.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументОснование", ЗаказКлиента);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	СписокНакладных = Новый СписокЗначений;
	
	Пока РезультатЗапроса.Следующий() Цикл
		СписокНакладных.Добавить(РезультатЗапроса.Ссылка, РезультатЗапроса.НомерТТН + НСтр("ru = ' от '; uk = ' від '") + Формат(РезультатЗапроса.Дата, "ДФ=""дд-ММ-гггг""") + " (" + РезультатЗапроса.ОписаниеСтатуса + ")");
	КонецЦикла;
	
	Если СписокНакладных.Количество() = 0 Тогда 
		СписокНакладных.Добавить(Документы.eComm_ЭкспрессНакладная.ПустаяСсылка(),  НСтр("ru = 'Создать новую экспресс-накладную'; uk = 'Створити нову експрес-накладну'"));
	КонецЕсли;
	
	Возврат СписокНакладных;
	
КонецФункции

Функция ТребуетсяОграничениеСтатусов(УчетнаяЗапись, СостояниеЗаказаПокупателя, ДанныеВыбора) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	eComm_СостоянияЗаказовТорговойПлощадки.ОграничиватьДоступныеСостояния КАК ОграничиватьДоступныеСостояния
		|ИЗ
		|	Справочник.eComm_СостоянияЗаказовТорговойПлощадки КАК eComm_СостоянияЗаказовТорговойПлощадки
		|ГДЕ
		|	eComm_СостоянияЗаказовТорговойПлощадки.Владелец = &Владелец
		|	И eComm_СостоянияЗаказовТорговойПлощадки.СостояниеЗаказаПокупателя = &СостояниеЗаказаПокупателя
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	eComm_СостоянияЗаказовТорговойПлощадкиДоступныеСостояния.Ссылка КАК Ссылка,
		|	eComm_СостоянияЗаказовТорговойПлощадкиДоступныеСостояния.НомерСтроки КАК НомерСтроки,
		|	eComm_СостоянияЗаказовТорговойПлощадки.СостояниеЗаказаПокупателя КАК Состояние
		|ИЗ
		|	Справочник.eComm_СостоянияЗаказовТорговойПлощадки.ДоступныеСостояния КАК eComm_СостоянияЗаказовТорговойПлощадкиДоступныеСостояния
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.eComm_СостоянияЗаказовТорговойПлощадки КАК eComm_СостоянияЗаказовТорговойПлощадки
		|		ПО eComm_СостоянияЗаказовТорговойПлощадкиДоступныеСостояния.Состояние = eComm_СостоянияЗаказовТорговойПлощадки.Ссылка
		|ГДЕ
		|	eComm_СостоянияЗаказовТорговойПлощадкиДоступныеСостояния.Ссылка.СостояниеЗаказаПокупателя = &СостояниеЗаказаПокупателя
		|	И eComm_СостоянияЗаказовТорговойПлощадкиДоступныеСостояния.Ссылка.Владелец = &Владелец
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Владелец"					, УчетнаяЗапись);
	Запрос.УстановитьПараметр("СостояниеЗаказаПокупателя"	, СостояниеЗаказаПокупателя);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаТекСтатуса 			= МассивРезультатов[0].Выбрать();
	ВыборкаДоступныхСтатусов 	= МассивРезультатов[1].Выбрать();
	
	Если ВыборкаТекСтатуса.Следующий() 
		И ВыборкаТекСтатуса.ОграничиватьДоступныеСостояния = Истина Тогда 
		
		ДанныеВыбора = Новый СписокЗначений;
		Пока ВыборкаДоступныхСтатусов.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаДоступныхСтатусов.Состояние) Тогда 
				ДанныеВыбора.Добавить(ВыборкаДоступныхСтатусов.Состояние);
			КонецЕсли;
		КонецЦикла;
		
		Возврат Истина;

	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
		
КонецФункции

