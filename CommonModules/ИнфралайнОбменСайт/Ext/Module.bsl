#Область ПолучениеДанных      
Функция ПолучитьСписокКатегорий(Узел)

Структура = ПолучитьТекстЗапроса("ТоварныеКатегории",Узел);

ЗапросКатегории = Новый Запрос;
	
Если Не Узел = Неопределено Тогда
	ЗапросКатегории.УстановитьПараметр("Узел",Узел);		
КонецЕсли;
ЗапросКатегории.Текст = "ВЫБРАТЬ
                        |	ТоварныеКатегории" + Структура.ТекстСсылка + ".Ссылка КАК Ссылка
                        |ИЗ
                        |	Справочник.ТоварныеКатегории" + Структура.ТекстИзменения + " КАК ТоварныеКатегории" + Структура.ТекстУсловие;
ВыборкаКатегорий = ЗапросКатегории.Выполнить().Выгрузить();		

Возврат ВыборкаКатегорий;
КонецФункции

//Category - массив с категориями
Функция ПолучитьВсеКатегории(Узел = Неопределено,СписокУдаления) Экспорт
	
	Категории = Новый Массив;
	
	СписокКатегорий = ПолучитьСписокКатегорий(Узел);
		
	Для Каждого Строка Из СписокКатегорий Цикл
		
		Структура = ЗначениеСтруктурыСРодителем(Строка.Ссылка);
		
		Категории.Добавить(Структура);
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(Строка.Ссылка,Строка.Ссылка.Наименование,Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Категории;
	
КонецФункции 

Функция ЗначениеСтруктурыСРодителем(Ссылка)
	Структура = Новый Структура;
	УИД = ОпределитьУИД(Ссылка);
	УИДРодителя = ОпределитьУИД(Ссылка.Родитель);

	Структура.Вставить("Parent_ID",УИДРодителя);
	Структура.Вставить("ID",УИД);
	Структура.Вставить("Del",Ссылка.ПометкаУдаления);
	Структура.Вставить("Name_UA",Ссылка.Наименование);
	Структура.Вставить("Name_RU",ссылка.Name_UA); 
	//ЗначениеПеревода(Ссылка, 
	//										 Справочники.ДоступныеРеквизитыСайт.Наименование, 
	//										 Справочники.СтраныМира.НайтиПоКоду("643") // Россия
	//	)); //Получаем значения перевода

  Возврат Структура;
КонецФункции	

//Brand - массив с брендами
//Country - массив со странами
//Manufacturer - массив с производителями
Функция ПолучитьРазное (ТипДанных,Узел = Неопределено,СписокУдаления) Экспорт
	
	Запрос = Новый Запрос;
	
	Если ТипДанных = "Brand" Тогда
		Справочник = "Справочник.Марки";
	КонецЕсли;
	
	Если ТипДанных = "Country" Тогда 
		Справочник = "Справочник.СтраныМира";
	КонецЕсли;
	
	Если ТипДанных = "Manufacturer" Тогда 
		Справочник = "Справочник.Производители";
	КонецЕсли;
	
	МассивРазное = Новый Массив;
	
	Структура = ПолучитьТекстЗапроса("Разное",Узел);
	
	Если Не Узел = Неопределено Тогда
		Запрос.УстановитьПараметр("Узел",Узел);		
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	              |	Разное" + Структура.ТекстСсылка + ".Ссылка КАК Ссылка,
	              |	Разное" + Структура.ТекстСсылка + ".ПометкаУдаления КАК ПометкаУдаления,
	              |	Разное" + Структура.ТекстСсылка + ".Наименование КАК Наименование
	              |ИЗ
	              |	" + Справочник + Структура.ТекстИзменения +" КАК Разное" + Структура.ТекстУсловие;
	ВыборкаРазное = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из  ВыборкаРазное Цикл
		
		Структура = ПолучитьСтруктуруРазное(Строка.Ссылка);
		
		МассивРазное.Добавить(Структура);
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(Строка.Ссылка,Строка.Наименование,Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРазное;
	
КонецФункции


Функция ПолучитьСтруктуруРазное(Ссылка)
	Структура = Новый Структура;
	УИД = ОпределитьУИД(Ссылка);

	Структура.Вставить("ID",УИД);
	Структура.Вставить("Del",Ссылка.ПометкаУдаления);
	Структура.Вставить("Name_UA",Ссылка.Наименование);
	Структура.Вставить("Name_RU", ЗначениеПеревода(Ссылка, 
											 Справочники.ДоступныеРеквизитыСайт.Наименование, 
											 Справочники.СтраныМира.НайтиПоКоду("643") // Россия
		)); //Получаем значения перевода

КонецФункции	

//Property - массив со свойствами
Функция ПолучитьВсеСвойства(Узел = Неопределено,СписокУдаления) Экспорт 
	
	ЗапросСвойства = Новый Запрос;
	МассивСвойства = Новый Массив;
	
	ЗапросСвойства.Текст = "ВЫБРАТЬ
		                       |	СвойстваОбъектовНаборыСостав.Ссылка КАК Владелец,
		                       |	СвойстваОбъектовНаборыСостав.Свойство,
		                       |	СвойстваОбъектовНаборыСостав.Ссылка.ПометкаУдаления КАК ПометкаУдаления
		                       |ИЗ
		                       |	Справочник.СвойстваОбъектовНаборы.Состав КАК СвойстваОбъектовНаборыСостав";

	
	ВыборкаСвойства = ЗапросСвойства.Выполнить().Выгрузить();
	
	Для Каждого Строка Из  ВыборкаСвойства Цикл
		
		Структура = ПолучитьСтруктуруСвойств(Строка);		
		МассивСвойства.Добавить(Структура);
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(Строка.Владелец,Строка.Владелец.Наименование,Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	
	Возврат МассивСвойства;
	
КонецФункции 

Функция ПолучитьСтруктуруСвойств(Строка)
Структура = Новый Структура;
УИДВладелец = ОпределитьУИД(Строка.Владелец);
УИДСвойство = ОпределитьУИД(Строка.Свойство);
		
Структура.Вставить("Parent_ID",УИДВладелец);
Структура.Вставить("ID",УИДСвойство);
Структура.Вставить("Del",Строка.ПометкаУдаления);
Структура.Вставить("Name_UA",Строка.Свойство.Наименование);
Структура.Вставить("Name_RU",ЗначениеПеревода(Строка.Свойство, 
											 Справочники.ДоступныеРеквизитыСайт.Наименование, 
											 Справочники.СтраныМира.НайтиПоКоду("643") // Россия
		)); //Получаем значения перевода
КонецФункции	

//PropertyNomenclature - Свойства товаров
Функция ПолучитьСвойстваНоменклатуры(Узел = Неопределено,СписокУдаления) Экспорт //Нужно заполнить
	
	Запрос = Новый Запрос;
	МассивСвойства = Новый Массив;
	
	Структура = ПолучитьТекстЗапроса("СвойстваНоменклатуры",Узел);
	
	Если Не Узел = Неопределено Тогда
		Запрос.УстановитьПараметр("Узел",Узел);		
	КонецЕсли;
	
	//ЗАПРОС
	
	ВыборкаСвойства = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из  ВыборкаСвойства Цикл
		
		Структура = ПолучитьСтруктуруНоменклатура(Строка);
		
		МассивСвойства.Добавить(Структура);
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(Строка.Ссылка,Строка.Наименование,Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	
	Возврат МассивСвойства;
	
КонецФункции

