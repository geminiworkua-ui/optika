//CategoryPrice - массив с типами цен
Функция ПолучитьВидыЦен(Узел = Неопределено,СписокУдаления) Экспорт 
	
	ЗапросВидыЦен = Новый Запрос();
	
	ВидыЦен = Новый Массив;
	
	Структура = ПолучитьТекстЗапроса("ВидыЦен",Узел);
	
	ТекстУсловие = "
					|ГДЕ
	               	|	ВидыЦен.ОтправлятьНаСайт = ИСТИНА";
	
	Если Не Узел = Неопределено Тогда
		ЗапросВидыЦен.УстановитьПараметр("Узел",Узел);
		ТекстУсловие = "
						|ГДЕ
	                    |	ВидыЦен.Узел = &Узел                                                                                                                                        
						|	И ВидыЦен.Ссылка.ОтправлятьНаСайт = ИСТИНА";
	КонецЕсли;	
	
	ЗапросВидыЦен.Текст = "ВЫБРАТЬ
	                      |	ВидыЦен" + Структура.ТекстСсылка + ".Ссылка КАК Ссылка,
	                      |	ВидыЦен" + Структура.ТекстСсылка + ".ПометкаУдаления КАК ПометкаУдаления,
						  |	ВидыЦен" + Структура.ТекстСсылка + ".Идентификатор КАК Идентификатор,
	                      |	ВидыЦен" + Структура.ТекстСсылка + ".Наименование КАК Наименование
	                      |ИЗ
	                      |	Справочник.ВидыЦен" + Структура.ТекстИзменения + " КАК ВидыЦен" + ТекстУсловие;
	ВыборкаВидыЦен = ЗапросВидыЦен.Выполнить().Выгрузить();
	
	Для Каждого Строка Из ВыборкаВидыЦен Цикл
		
		Структура = ПолучитьСтруктуруВидаЦен(Строка);
				
		ВидыЦен.Добавить(Структура);
		
	    Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(Строка.Ссылка,Строка.Наименование,Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВидыЦен;
	
