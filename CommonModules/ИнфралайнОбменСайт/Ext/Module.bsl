Функция ОпределитьУзелОбмена(Ссылка) Экспорт
Запрос = Новый Запрос(
 "ВЫБРАТЬ
 |	СвойстваОбъектовСайт.сайт.Ссылка Как Ссылка
 |ИЗ
 |	РегистрСведений.СвойстваОбъектовСайт КАК СвойстваОбъектовСайт
 |ГДЕ
 |	СвойстваОбъектовСайт.Номенклатура = &Номенклатура
 |	И СвойстваОбъектовСайт.Характеристика = &Характеристика");
Если ТипЗнч(Ссылка) =  Тип("СправочникСсылка.Номенклатура")Тогда 
	Запрос.УстановитьПараметр("Номенклатура", Ссылка);
	Запрос.УстановитьПараметр("Характеристика", справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
	Запрос.УстановитьПараметр("Номенклатура", Ссылка.Владелец);
	Запрос.УстановитьПараметр("Характеристика", Ссылка);
