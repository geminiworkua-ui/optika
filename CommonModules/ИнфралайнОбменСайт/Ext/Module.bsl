//RestNomenclature - остатки
Функция ПолучитьОстатки(Узел = Неопределено,СписокУдаления) Экспорт
	
	Если Узел = Неопределено Тогда
		Возврат ПолучитьВсеОстатки(СписокУдаления);
	Иначе
		Возврат ПолучитьИзмененияОстатки(Узел,СписокУдаления);
	КонецЕсли;
	
КонецФункции

Функция ПолучитьВсеОстатки(СписокУдаления) 
	
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.Текст = "ВЫБРАТЬ
	                      |	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	                      |	ТоварыНаСкладахОстатки.ВНаличииОстаток - ТоварыНаСкладахОстатки.КОтгрузкеОстаток КАК Остаток
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, ) КАК ТоварыНаСкладахОстатки";
	ЗапросОстатки.УстановитьПараметр("Дата",ТекущаяДата());
	
	Выборка = ЗапросОстатки.Выполнить().Выгрузить();
	
	Возврат СформироватьСтруктуруОстатки(Выборка,Неопределено,СписокУдаления); 
	
КонецФункции

Функция ПолучитьИзмененияОстатки(Узел,СписокУдаления) 
	
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.Текст = "ВЫБРАТЬ
	                      |	ТоварыНаСкладахОстатки.Номенклатура,
	                      |	ТоварыНаСкладахОстатки.Характеристика,
	                      |	СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток - ТоварыНаСкладахОстатки.КОтгрузкеОстаток) КАК Остаток
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки(
	                      |			&Дата,
	                      |			Номенклатура В
	                      |					(ВЫБРАТЬ
	                      |						ТоварыДляПередачиНаСайтИзменения.Номенклатура
	                      |					ИЗ
	                      |						РегистрСведений.ТоварыДляПередачиНаСайт.Изменения КАК ТоварыДляПередачиНаСайтИзменения
	                      |					ГДЕ
	                      |						ТоварыДляПередачиНаСайтИзменения.Узел = &Узел
	                      |						И ТоварыДляПередачиНаСайтИзменения.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	                      |						И ТоварыДляПередачиНаСайтИзменения.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Остатки))
	                      |				ИЛИ Характеристика В
	                      |					(ВЫБРАТЬ
	                      |						ТоварыДляПередачиНаСайтИзменения.Характеристика
	                      |					ИЗ
	                      |						РегистрСведений.ТоварыДляПередачиНаСайт.Изменения КАК ТоварыДляПередачиНаСайтИзменения
	                      |					ГДЕ
	                      |						ТоварыДляПередачиНаСайтИзменения.Узел = &Узел
	                      |						И ТоварыДляПередачиНаСайтИзменения.Направление = ЗНАЧЕНИЕ(Перечисление.НаправлениеДляПередачи.Остатки))) КАК ТоварыНаСкладахОстатки
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ТоварыНаСкладахОстатки.Номенклатура,
	                      |	ТоварыНаСкладахОстатки.Характеристика";
	ЗапросОстатки.УстановитьПараметр("Узел",Узел);
	ЗапросОстатки.УстановитьПараметр("Дата",ТекущаяДата());
	
	Выборка = ЗапросОстатки.Выполнить().Выгрузить();
	
	Возврат	СформироватьСтруктуруОстатки(Выборка,Узел,СписокУдаления);
	
КонецФункции

Функция СформироватьСтруктуруОстатки(Выборка,Узел,СписокУдаления)
	
	Массив = Новый Массив;
	СтруктураПоиска = Новый Структура("Номенклатура");
	
	Для Каждого Строка Из Выборка Цикл
		
		Структура = Новый Структура;
		СтруктураПоиска.Номенклатура = Строка.Номенклатура;
		
		Дубли = Выборка.НайтиСтроки(СтруктураПоиска);
		Дубли.Удалить(0);
		КоличествоСтрок = Дубли.Количество() - 1;
		
		УИДНом = ОпределитьУИД(Строка.Номенклатура);
		Остаток = Строка.Остаток;
		
		Структура.Вставить("ID_Nom",УИДНом);
		Структура.Вставить("ID_Ser", ""); // Нет ничего по этому полю
				
		Если Не Узел = Неопределено Тогда 
			СписокУдаления.Добавить(ПолучитьНаборЗаписей(Строка.Регистратор, Строка.Номенклатура, РегистрыНакопления.ТоварыНаСкладах),Строка.Номенклатура.Наименование,Истина);
		КонецЕсли;
				
		Для Счетчик = 0 По КоличествоСтрок Цикл
			
			Остаток = Остаток + Дубли[Счетчик].Остаток;
		
			Если Не Узел = Неопределено Тогда
				СписокУдаления.Добавить(ПолучитьНаборЗаписей(Дубли[Счетчик].Регистратор, Строка.Номенклатура, РегистрыНакопления.ТоварыНаСкладах),Строка.Номенклатура.Наименование,Истина);
			КонецЕсли;
			
			Выборка.Удалить(Дубли[Счетчик]);
			
		КонецЦикла;
		
		Структура.Вставить("Rest",Остаток);
		
		Массив.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат Массив
	
КонецФункции
#КонецОбласти

//NomenclaturePicture - картинки к товарам
Функция ПолучитьКартинки (Узел,СписокУдаления) Экспорт

	Запрос = Новый Запрос;
	Массив = Новый Массив;
	
	Структура = ПолучитьТекстЗапроса("НоменклатураПрисоединенныеФайлы",Узел);
	
	Если Не Узел = Неопределено Тогда
		Запрос.УстановитьПараметр("Узел",Узел);
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураПрисоединенныеФайлы" + Структура.ТекстСсылка + ".Ссылка КАК Ссылка,
	               |	НоменклатураПрисоединенныеФайлы" + Структура.ТекстСсылка + ".ВладелецФайла КАК Владелец,
	               |	НоменклатураПрисоединенныеФайлы" + Структура.ТекстСсылка + ".ПометкаУдаления КАК ПометкаУдаления,
				   |	НоменклатураПрисоединенныеФайлы" + Структура.ТекстСсылка + ".Наименование КАК Наименование,
	               |	НоменклатураПрисоединенныеФайлы" + Структура.ТекстСсылка + ".Размер КАК Размер
	               |ИЗ
	               |	Справочник.НоменклатураПрисоединенныеФайлы" + Структура.ТекстИзменения + " КАК НоменклатураПрисоединенныеФайлы" + Структура.ТекстУсловие;
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Выборка Цикл
		
		УИДНом = ОпределитьУИД(Строка.Владелец);
		
		Структура = Новый Структура;
		Структура.Вставить("ID_Nom"			, УИДНом );
		Структура.Вставить("Del"			, Строка.ПометкаУдаления );
		Структура.Вставить("PictureName"	, Строка.Наименование );
		Структура.Вставить("PictureSize"	, Строка.Размер );
		Структура.Вставить("Picture"		, Base64Строка(ПрисоединенныеФайлы.ПолучитьДвоичныеДанныеФайла( Строка.Ссылка )));
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(Строка.Ссылка,Строка.Наименование,Истина);
		КонецЕсли;
		
		Массив.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат Массив;	
	
КонецФункции
