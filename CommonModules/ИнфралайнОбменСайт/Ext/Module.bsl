Функция  ОбработатьЗаписиКВрачу(Узел = Неопределено, СписокУдаления) Экспорт
		
    Запрос = Новый Запрос(	
	 "ВЫБРАТЬ
	 |	ЗаписьНаПриемИзменения.Ссылка
	 |ИЗ
	 |	Документ.ЗаписьНаПрием.Изменения КАК ЗаписьНаПриемИзменения
	 |ГДЕ
	 |	ЗаписьНаПриемИзменения.Узел = &Узел");
	Запрос.УстановитьПараметр("Узел", Узел);
	
	Результат =Запрос.Выполнить().Выбрать();
	
	МассивЗаписей = Новый Массив;
	Пока Результат.Следующий() Цикл		
		МассивЗаписей.Добавить(ПолучитьСтруктуруЗаписиКВрачу(Результат.Ссылка)); 
		//ИзменитьРасписание(Результат.ссылка);
		СписокУдаления.Добавить(Результат.Ссылка,Результат.Ссылка);
	КонецЦикла;	
	
	//Возврат Новый Структура("TableChange", МассивЗаписей); 
	  Возврат МассивЗаписей;
КонецФункции

Процедура ИзменитьРасписание(Ссылка)    
ДокументОбъект = Ссылка.РегистраторРасписания.ПолучитьОбъект();
Инд = число(Ссылка.НомерСтрокиРегистратораРасписания-1);                    
Если Ссылка.проведен Тогда

	 ДокументОбъект.РасписаниеПриема[Инд].ДокументЗаписи = Ссылка;
     ДокументОбъект.РасписаниеПриема[Инд].ЕстьЗапись = Истина;
	 ДокументОбъект.РасписаниеПриема[Инд].Номенклатура = Ссылка.Номенклатура;
    
 Иначе
	 Для каждого Стр из ДокументОбъект.РасписаниеПриема цикл
		 Если Не Стр.ДокументЗаписи = Ссылка
			 Тогда 
			  Продолжить;
			 Иначе  
			 Стр.ДокументЗаписи = неопределено;
			 Стр.ЕстьЗапись = ложь;      
			 Прервать;
		  КонецЕсли; 	 
		КонецЦикла;	 
 КонецЕсли;	 
 
 ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение); 

КонецПроцедуры	

Функция ПолучитьСтруктуруЗаписиКВрачу(Источник)
	Структура = Новый Структура;
	
	Структура.Вставить("TimeStart"	,Источник.ВремяНачала);
	//Структура.Вставить("TimeEnd"	,Источник.ВремяОкончания);
	Структура.Вставить("Doctor"		,Строка(Источник.Сотрудник.УникальныйИдентификатор()));
	Структура.Вставить("Shop"		,Строка(Источник.Подразделение.УникальныйИдентификатор()));
	Структура.Вставить("Position"	,Строка(Источник.Должность.УникальныйИдентификатор()));
	Структура.Вставить("Status"		,?(Источник.Проведен,"Время занято","Свободно"));
	Структура.Вставить("DocID"		,Строка(Источник.Ссылка.УникальныйИдентификатор()));
	Структура.Вставить("ClientID"	,Строка(Источник.Клиент.УникальныйИдентификатор()));

	Возврат  Структура;
КонецФункции	

Функция ОбработатьРасписаниеВрачей(Узел = неопределено, СписокУдаления) Экспорт
	
   МассивЗаписей = Новый Массив;
   
   Запрос = Новый Запрос(
   "ВЫБРАТЬ ПЕРВЫЕ 1
   |	СоставлениеРасписанияПриемаВрача.Ссылка
   |ИЗ
   |	Документ.СоставлениеРасписанияПриемаВрача КАК СоставлениеРасписанияПриемаВрача
   |
   |УПОРЯДОЧИТЬ ПО
   |	СоставлениеРасписанияПриемаВрача.Дата УБЫВ");
   //Запрос.УстановитьПараметр("Узел", Узел);
   
   Результат = Запрос.Выполнить().Выбрать();
   Пока Результат.Следующий() Цикл 
	 Источник = Результат.ссылка;  
		Для Каждого Строка Из Источник.РасписаниеПриема Цикл
			Если не Строка.Актуально  Тогда
				Продолжить;
			КонецЕсли;

			МассивЗаписей.Добавить(ПолучитьСтруктуруЗаписиРассписаниеВрачей(Строка, Источник));
					
		КонецЦикла;  
		СписокУдаления.Добавить(Результат.Ссылка, Результат.Ссылка);
	КонецЦикла;
	Возврат МассивЗаписей;
	//Возврат Новый Структура("TableChange", МассивЗаписей);
КонецФункции

Функция ПолучитьСтруктуруЗаписиРассписаниеВрачей(Строка, Источник)
