//PropertyNomenclature - Свойства товаров
Функция ПолучитьХарактеристики(Узел = Неопределено,СписокУдаления) Экспорт
	
	ЗапросХарактеристики = Новый Запрос;
	
	Если Узел = Неопределено Тогда
		ТекстЗапроса = "
						|ИЗ
						|	РегистрСведений.СвойстваОбъектов КАК СвойстваОбъектов
						//|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СвойстваОбъектовНаборы.Состав КАК СвойстваОбъектовНаборыСостав
						//|		ПО СвойстваОбъектов.Свойство = СвойстваОбъектовНаборыСостав.Свойство
	                    |ГДЕ
	                    |	ТИПЗНАЧЕНИЯ(СвойстваОбъектов.Объект) = ТИП(Справочник.Номенклатура)
	                    |	И СвойстваОбъектов.Свойство.Наименование <> ""Код бухгалтерии""";
	Иначе
		ТекстЗапроса = "
						|ИЗ
						|	РегистрСведений.СвойстваОбъектов КАК СвойстваОбъектов
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СвойстваОбъектов.Изменения КАК СвойстваОбъектовИзменения
						|		ПО СвойстваОбъектов.Объект = СвойстваОбъектовИзменения.Объект
						|			И СвойстваОбъектов.Свойство = СвойстваОбъектовИзменения.Свойство
						//|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СвойстваОбъектовНаборы.Состав КАК СвойстваОбъектовНаборыСостав
						//|		ПО СвойстваОбъектов.Свойство = СвойстваОбъектовНаборыСостав.Свойство
						|ГДЕ
						|	ТИПЗНАЧЕНИЯ(СвойстваОбъектов.Объект) = ТИП(Справочник.Номенклатура)
						|	И СвойстваОбъектов.Свойство.Наименование <> ""Код бухгалтерии""
						|	И СвойстваОбъектовИзменения.Узел = &Узел";
		ЗапросХарактеристики.УстановитьПараметр("Узел",Узел);
	КонецЕсли;
	
	ЗапросХарактеристики.Текст ="ВЫБРАТЬ
	                            |	СвойстваОбъектов.Объект КАК Ссылка,
	                            |	СвойстваОбъектов.Свойство КАК Свойство,
	                            |	СвойстваОбъектов.Свойство.ПометкаУдаления КАК ПометкаУдаления,
	                            |	СвойстваОбъектов.Значение КАК Значение" + ТекстЗапроса;
								//|	СвойстваОбъектовНаборыСостав.Ссылка КАК Владелец" + ТекстЗапроса;
	Выборка = ЗапросХарактеристики.Выполнить().Выгрузить();
	
	Возврат ЗаполнитьСтруктуруХарактеристик(Выборка,Узел,СписокУдаления);
 
КонецФункции

Функция ЗаполнитьСтруктуруХарактеристик(Выборка,Узел,СписокУдаления)
	
	МассивХарактеристик = Новый Массив;
	
	Для Каждого Строка Из Выборка Цикл
		
		УИДНом = ОпределитьУИД(Строка.Ссылка);
		УИДХар = ОпределитьУИД(Строка.Свойство);
		
		Структура = Новый Структура;
		Структура.Вставить("ID_Nom", УИДНом);
		Структура.Вставить("ID_Pro", УИДХар);
		Структура.Вставить("Del", Строка.ПометкаУдаления);
		Структура.Вставить("Name_UA", Строка.Свойство.Наименование);
		Структура.Вставить("Name_RU", ЗначениеПеревода(Строка.Ссылка, 
											 Справочники.ДоступныеРеквизитыСайт.Наименование, 
											 Справочники.СтраныМира.НайтиПоКоду("643"))); // Россия
		СтруктураОтбор = Новый Структура;
		СтруктураОтбор.Вставить("Объект",	Строка.Ссылка);
		СтруктураОтбор.Вставить("Свойство",	Строка.Свойство);
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(ПолучитьНаборЗаписей(СтруктураОтбор, Строка.Ссылка, РегистрыСведений.СвойстваОбъектов),Строка.Ссылка,Истина);
		КонецЕсли;
		
		МассивХарактеристик.Добавить(Структура);
	КонецЦикла;
	
	Возврат МассивХарактеристик;
	
КонецФункции

