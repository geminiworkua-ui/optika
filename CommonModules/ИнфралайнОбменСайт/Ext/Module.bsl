Функция ПолучитьСовместноПродаваемуюНоменклатуру(Номенклатура)
	
	Массив = Новый Массив;
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка КАК Предпосылка,
	               |	НоменклатураПродаваемаяСовместно.НоменклатураСледствие КАК Следствие
	               |ИЗ
	               |	РегистрСведений.НоменклатураПродаваемаяСовместно КАК НоменклатураПродаваемаяСовместно
	               |ГДЕ
	               |	(НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка = &Номенклатура
	               |			ИЛИ НоменклатураПродаваемаяСовместно.НоменклатураСледствие = &Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Результат Цикл
		
		Если Строка.Предпосылка = Номенклатура Тогда 
			УИД = Строка.Следствие.УникальныйИдентификатор();
		КонецЕсли;
		
		Если Строка.Следствие = Номенклатура Тогда 
			УИД = Строка.Предпосылка.УникальныйИдентификатор();
		КонецЕсли;
		
		Массив.Добавить(УИД);
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция ЗаполнитьСтруктуруНоменклатуры(Выборка,Узел,СписокУдаления)
	
	Массив = Новый Массив;
	
	Для Каждого Строка Из Выборка Цикл
		Если Не Строка.Ссылка.ЭтоГруппа Тогда
			УИДНом 				= ОпределитьУИД(Строка.Ссылка);
			УИДБренд 			= ОпределитьУИД(Строка.Марка);
			УИДПроизводитель 	= ОпределитьУИД(Строка.Производитель);
			УИДКатегория 		= ОпределитьУИД(Строка.ТоварнаяКатегория);
			
			Структура = Новый Структура;
			
			Структура.Вставить("ID", УИДНом);
			Структура.Вставить("Del", Строка.ПометкаУдаления);
			Структура.Вставить("ID_Brand", УИДБренд);
			Структура.Вставить("ID_Man", УИДПроизводитель);
			Структура.Вставить("ID_Cat", УИДКатегория);
			Структура.Вставить("PictureMain", Строка(Строка.Ссылка.ФайлКартинки.УникальныйИдентификатор())); // Нет в базе
			Структура.Вставить("BestSeller", Строка.Ссылка.BestSeller); // Нет в базе
			Структура.Вставить("Only_Box", Строка.Ссылка.ТолькоКоробка); //  Нет в базе
			Структура.Вставить("Accompanying", ПолучитьСовместноПродаваемуюНоменклатуру(Строка.Ссылка)); //  Нет в базе
			Структура.Вставить("Name_UA", Строка.Ссылка.НаименованиеПолное);        
			Наименование_Ru =   ЗначениеПеревода(Строка.Ссылка, 
											 Справочники.ДоступныеРеквизитыСайт.ПНаименование, 
											 Справочники.СтраныМира.НайтиПоКоду("643"));
			Структура.Вставить("Name_RU", ?(Наименование_Ru ="",Строка.Ссылка.НаименованиеПолное, Наименование_Ru)); // Россия
			Структура.Вставить("Description_UA", Строка.Описание); 
			
			Описание_Ru = ЗначениеПеревода(Строка.Ссылка, 
											 Справочники.ДоступныеРеквизитыСайт.Описание, 
											 Справочники.СтраныМира.НайтиПоКоду("643"));  
											 
			Структура.Вставить("Description_RU", ?(Описание_Ru ="",Строка.Описание, Описание_Ru));   // Россия
 //Нет поля в базе
			Структура.Вставить("Model_UA", Строка.Модель);      
			Модель_ru = ЗначениеПеревода(Строка.Ссылка, 
											 Справочники.ДоступныеРеквизитыСайт.Модель, 
											 Справочники.СтраныМира.НайтиПоКоду("643")); 
			Структура.Вставить("Model_RU", ?(Модель_ru ="",Строка.модель, Модель_Ru)); // Россия
			
			Массив.Добавить(Структура);
			
			Если Не Узел = Неопределено Тогда
				СписокУдаления.Добавить(Строка.Ссылка,Строка.Наименование,Истина);
			КонецЕсли;
		КонецЕсли;			
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции 

Функция ПолучитьВрачей(Узел = Неопределено,СписокУдаления) Экспорт
	
	ЗапросВрачи = Новый Запрос;
	МассивВрачи = Новый Массив;
	
	Если Узел = Неопределено Тогда 
		ЗапросВрачи.Текст = "ВЫБРАТЬ
		                    |	КадроваяРасстановкаСрезПоследних.ФизическоеЛицо КАК Врач,
		                    |	КадроваяРасстановкаСрезПоследних.Актуальность КАК Актуальность,
		                    |	КадроваяРасстановкаСрезПоследних.Регистратор КАК Регистратор
		                    |ИЗ
		                    |	РегистрСведений.КадроваяРасстановка.СрезПоследних(&Дата, ) КАК КадроваяРасстановкаСрезПоследних
		                    |ГДЕ
		                    |	КадроваяРасстановкаСрезПоследних.Должность.ЭтоВрач";
		ЗапросВрачи.УстановитьПараметр("Дата",ТекущаяДата());
	//ЗапросВрачи.УстановитьПараметр("Актуальность"	,Перечисления.СтатусыСотрудников.Актуальний);
	Иначе
		ЗапросВрачи.Текст = "ВЫБРАТЬ
		                    |	КадроваяРасстановкаСрезПоследних.ФизическоеЛицо КАК Врач,
		                    |	КадроваяРасстановкаСрезПоследних.Актуальность КАК Актуальность,
		                    |	КадроваяРасстановкаСрезПоследних.Регистратор КАК Регистратор
		                    |ИЗ
		                    |	РегистрСведений.КадроваяРасстановка.Изменения КАК КадроваяРасстановкаИзменения
		                    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяРасстановка.СрезПоследних(&Дата, ) КАК КадроваяРасстановкаСрезПоследних
		                    |		ПО КадроваяРасстановкаИзменения.Регистратор = КадроваяРасстановкаСрезПоследних.Регистратор
		                    |ГДЕ
		                    |	КадроваяРасстановкаИзменения.Узел = &Узел
		                    |	И КадроваяРасстановкаСрезПоследних.Должность.ЭтоВрач";
		ЗапросВрачи.УстановитьПараметр("Дата",НачалоДня(ТекущаяДата()));
		ЗапросВрачи.УстановитьПараметр("Узел",Узел);
	
	КонецЕсли;

	
	Выборка = ЗапросВрачи.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Выборка Цикл 
		
		Актуальность = ?(Строка.Актуальность = Перечисления.СтатусыСотрудников.Актуальний,Ложь,Истина);
		Структура = Новый Структура;
		
		УИД = ОпределитьУИД(Строка.Врач);
		
		Структура.Вставить("id"		,УИД);
		Структура.Вставить("name"	,Строка.Врач.Наименование); 
		Структура.Вставить("Del"	,Актуальность);
		
		МассивВрачи.Добавить(Структура);
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(ПолучитьНаборЗаписей(Строка.Регистратор, Строка.Врач,РегистрыСведений.КадроваяРасстановка),Строка.Врач.Наименование,Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивВрачи;
	
КонецФункции

Функция ПолучитьМагазины(Узел = Неопределено,СписокУдаления) Экспорт
	
	ЗапросМагазины = Новый Запрос;
	МассивМагазины = Новый Массив;
	
	Если Узел = Неопределено Тогда
		ЗапросМагазины.Текст = "ВЫБРАТЬ
	                       |	Склады.Ссылка КАК Магазин,
	                       |	Склады.ПометкаУдаления КАК ПометкаУдаления
	                       |ИЗ
	                       |	Справочник.Склады КАК Склады
	                       |ГДЕ
	                       |	Склады.ТипСклада = &ТипСклада";
	Иначе
		ЗапросМагазины.Текст = "ВЫБРАТЬ
		                       |	СкладыИзменения.Ссылка.Ссылка КАК Магазин,
		                       |	СкладыИзменения.Ссылка.ПометкаУдаления КАК ПометкаУдаления
		                       |ИЗ
		                       |	Справочник.Склады.Изменения КАК СкладыИзменения
		                       |ГДЕ
		                       |	СкладыИзменения.Ссылка.ТипСклада = &ТипСклада
		                       |	И СкладыИзменения.Узел = &Узел";
		ЗапросМагазины.УстановитьПараметр("Узел",Узел);
	КонецЕсли;
	
	ЗапросМагазины.УстановитьПараметр("ТипСклада"	,Перечисления.ТипыСкладов.РозничныйМагазин);
	
	Выборка = ЗапросМагазины.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Выборка Цикл 
		
		Структура = Новый Структура;
		
		УИД = ОпределитьУИД(Строка.Магазин);
		
		Структура.Вставить("id"		,УИД);
		Структура.Вставить("name"	,Строка.Магазин.Наименование);
		Структура.Вставить("Del"	,Строка.ПометкаУдаления);
		
		Если Не Узел = Неопределено Тогда
			СписокУдаления.Добавить(Строка.Магазин,Строка.Магазин.Наименование,Истина);
		КонецЕсли;
		
		МассивМагазины.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат МассивМагазины;
	
