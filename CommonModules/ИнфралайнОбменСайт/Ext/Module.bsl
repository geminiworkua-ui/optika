Процедура ЗарегистрироватьИзменениеНаУзлах(Ссылка, Направление) Экспорт
Узлы =  ИнфралайнСерверСервис.ПолучитьУзлыОбмена();
УзлыНом =ИнфралайнСерверСервис.ПолучитьУзлыОбменаНоменклатуры(Ссылка, Узлы);      
Для каждого Узел из УзлыНом Цикл
	НаборЗаписей =РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Номенклатура.Установить(Ссылка);
	НаборЗаписей.Отбор.Направление.Установить(Направление);   
    НаборЗаписей.Отбор.УзелРегистрации.Установить(Узел);
	НаборЗаписей.Прочитать();           
		
	Если НаборЗаписей.Количество() =0 Тогда
		Запись =НаборЗаписей.Добавить();
		Запись.Номенклатура 	= Ссылка;
		Запись.Направление 		= Направление;          
		Запись.УзелРегистрации  = Узел;
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
		
	Планыобмена.ЗарегистрироватьИзменения(Узел, НаборЗаписей);
	
КонецЦикла;

