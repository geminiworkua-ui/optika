Процедура ПроизвестиОбменПоНаправлению(Направление, Узел)
	
	СписокУдаления = Новый Массив;
	
	СО = СоответствияОбмена();
	ТипДанных = СО.Получить(Направление);
	Если Не ТипДанных = Неопределено Тогда	
		
		    Если Направление = "Товары" 			
				Тогда
				Результат = ПолучитьВсюНоменклатуру(Узел, СписокУдаления);   
			ИначеЕсли Направление = "Категории" 	
				Тогда
		        Результат = ПолучитьВсеКатегории(Узел, СписокУдаления);
			ИначеЕсли Направление = "Рубрикатор" 	
				Тогда
				Результат = ПолучитьРубрикатор(Узел, СписокУдаления);			
			ИначеЕсли Направление = "Производитель" 
				Тогда
				Результат = ПолучитьРазное(ТипДанных, Узел, СписокУдаления);  
			ИначеЕсли Направление = "Бренды" 		
				Тогда 
				Результат = ПолучитьРазное(ТипДанных, Узел, СписокУдаления);  
			ИначеЕсли Направление = "Страны"  		
				Тогда
				Результат = ПолучитьРазное(ТипДанных, Узел, СписокУдаления);  
			ИначеЕсли Направление = "Свойства" 		
				Тогда 
				Результат = ПолучитьСвойства(Узел, СписокУдаления); 
			ИначеЕсли Направление = "PropertyAs" 	
				Тогда
				Результат = ПолучитьСвойстваКак(Узел, СписокУдаления);   
			ИначеЕсли Направление = "НаборСвойств"  
				Тогда
				Результат = ПолучитьНаборСвойств(Узел, СписокУдаления);
			ИначеЕсли Направление = "КатегорииЦен"  				
				Тогда
				Результат = ПолучитьВидыЦен(Узел, СписокУдаления);
			ИначеЕсли Направление = "ХарактеристикиНоменклатуры" 
				Тогда
				Результат = ПолучитьХарактеристики(Узел, СписокУдаления);
			ИначеЕсли Направление = "ЦеныНоменклатуры" 
				Тогда
				Результат = ПолучитьЦеныНоменклатуры(Узел, СписокУдаления);
			ИначеЕсли Направление = "PriceNomenclature" 
				Тогда
				Результат = ПолучитьОстатки(Узел, СписокУдаления);
			ИначеЕсли Направление = "КартинкиНоменклатуры" 
				Тогда
				Результат = ПолучитьКартинки(Узел, СписокУдаления);    
			ИначеЕсли Направление = "ЗаписьКВрачу" 
				Тогда
				Результат = ОбработатьЗаписиКВрачу(Узел, СписокУдаления);	
			ИначеЕсли Направление = "РасписаниеВрачей" 
				Тогда
				Результат = ОбработатьЗаписиКВрачу(Узел, СписокУдаления);	
			КонецЕсли;
			
			СтруктураОтправки = СформироватьДанныеОчки(ТипДанных, Результат, Узел.Сайт); 
			ОтправитьДанныеОчки(СтруктураОтправки, Узел, ТипДанных, "", СписокУдаления);
	КонецЕсли;

КонецПроцедуры

