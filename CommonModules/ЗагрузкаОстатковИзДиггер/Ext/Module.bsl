//Формирование структуры для записив регистр обмена
//ссылка - объект Источник 8.3
//ID - Идентификатор приемника
//ТипПриемника - тип приемника 7.7
//Узел - узел обмена
&НаСервере
Функция ПолучитьСтруктуруЗаписи(Ссылка, ID, ТипПриемника, Узел)
	
	СтрЗаписи = Новый Структура;
	СтрЗаписи.Вставить("УникальныйИдентификаторПриемника", ID);
	СтрЗаписи.Вставить("УникальныйИдентификаторИсточника", Ссылка);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	ТипИсточника = ?(ОбъектМетаданных = Неопределено, Строка(ТипЗнч(Ссылка)), ОбъектМетаданных.ПолноеИмя());
	СтрЗаписи.Вставить("ТипПриемника", ТипПриемника); 
	СтрЗаписи.Вставить("ТипИсточника", ТипИсточника);
	СтрЗаписи.Вставить("УзелИнформационнойБазы", Узел); 
	//СтрЗаписи.Вставить("УникальныйИдентификаторИсточникаСтрокой",?(Ссылка= неопределено , "", Ссылка.УникальныйИдентификатор())); 
	СтрЗаписи.Вставить("УникальныйИдентификаторИсточникаСтрокой", ?(ЗначениеЗаполнено(Ссылка), Ссылка.УникальныйИдентификатор(), ""));
	СтрЗаписи.Вставить("ОбъектВыгруженПоСсылке", Ложь);
	Возврат СтрЗаписи; 
	
КонецФункции

&НаСервере
Функция  ПолучитьУзел() Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СтараяБаза.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.СтараБаза КАК СтараяБаза
	|ГДЕ
	|	НЕ СтараяБаза.ЭтотУзел");
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли; 
	
КонецФункции  


