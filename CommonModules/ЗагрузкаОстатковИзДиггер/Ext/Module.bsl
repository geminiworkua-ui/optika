	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Справочники.Склады.ПолучитьСсылку(
		Новый УникальныйИдентификатор(Выборка.UIDПриемника)
		);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Склады.Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ПометкаУдаления
	|	И Склады.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;	    
	
	Возврат Справочники.Склады.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция НайтиСерияПоUID(UID, Наименование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("UID", UID);
	Запрос.УстановитьПараметр("ТипПриемника", "Справочник.ХарактеристикиНоменклатуры");
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Соответствие.УникальныйИдентификаторПриемника КАК UIDПриемника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соответствие
	|ГДЕ
	|	Соответствие.УникальныйИдентификаторПриемника = &UID
	|	И Соответствие.ТипПриемника = &ТипПриемника";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(
		Новый УникальныйИдентификатор(Выборка.UIDПриемника)
		);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
	|	И ХарактеристикиНоменклатуры.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;	    
	
	Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция GUIDЗаполнен(GuidСтрокой)
	
	Возврат НЕ ПустаяСтрока(GuidСтрокой)
	И GuidСтрокой <> "00000000-0000-0000-0000-000000000000";
	
КонецФункции



