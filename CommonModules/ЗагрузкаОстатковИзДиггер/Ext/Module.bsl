

&НаСервере
Процедура ЗагрузитьОстаткиИзДиггер() Экспорт
	
	ИмяФайла   = "\\10.99.0.1\ftp\Обмін\Остатки_Диггер.json";
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ИмяФайла);     
	
	Данные = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	ТЗ = МассивСтруктурВТаблицуЗначений(Данные);
	
	///////////////////////////////////////////////////////////////
	ТЗКатегории = ТЗ.Скопировать();
	ТЗКатегории.Свернуть("UID_Категория, Категория","");  
	
	Для Каждого СтрокаТЗ Из ТЗКатегории Цикл	
		Категория = НайтиКатегорияПоUID(СтрокаТЗ.UID_Категория, СтрокаТЗ.Категория); 
		Если Категория.Пустая() Тогда 
			//Сообщить("Не знайден Виды номенклатуры: " + СтрокаТЗ.UID_Категория + " Наименование: " +  СтрокаТЗ.Категория);
			
			Если НЕ GUIDЗаполнен(СтрокаТЗ.UID_Категория) Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйВидыНоменклатуры = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
			НовыйВидыНоменклатуры.ОбменДанными.Загрузка = Истина;
			НовыйВидыНоменклатуры.Наименование = СтрокаТЗ.Категория;
			НовыйВидыНоменклатуры.Записать();
			
			Guid = Новый УникальныйИдентификатор(СтрокаТЗ.UID_Категория);
			
			Узел = ПолучитьУзел();
			
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НовыйВидыНоменклатуры.Ссылка, Guid, "ВидыНоменклатуры", Узел));
			
			Категория = НовыйВидыНоменклатуры.Ссылка;
			
		КонецЕсли;
		
	КонецЦикла;
	
	///////////////////////////////////////////////////////////////
	ТЗЕдиница = ТЗ.Скопировать();
	ТЗЕдиница.Свернуть("UID_Единица, Единица","");
	
	Для Каждого СтрокаТЗ Из ТЗЕдиница Цикл	
		Единица = НайтиЕдиницаПоUID(СтрокаТЗ.UID_Единица, СтрокаТЗ.Единица); 
		Если Единица.Пустая() Тогда 
			//Сообщить("Не знайдена Единица: " + СтрокаТЗ.UID_Единица + " Наименование: " +  СтрокаТЗ.Единица);
			
			Если НЕ GUIDЗаполнен(СтрокаТЗ.UID_Единица) Тогда
				Продолжить;
			КонецЕсли;
			
			//********************************************************************
			Наименование  = СтрокаТЗ.Единица;
			
			Если Наименование ="бабина" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2082");                      
			ИначеЕсли Наименование ="бочка" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2027");
			ИначеЕсли Наименование ="бут." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2061");
			ИначеЕсли Наименование ="грам" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0303");
			ИначеЕсли Наименование ="грн." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2454");	
			ИначеЕсли Наименование ="день" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0174");	
			ИначеЕсли Наименование ="КВт" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0420");	
			ИначеЕсли Наименование ="кг." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0301");	
			ИначеЕсли Наименование ="кег" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2009");	
			ИначеЕсли Наименование ="км." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0102");	
			ИначеЕсли Наименование ="комплект" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2938");	
			ИначеЕсли Наименование ="конт." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2049");	
			ИначеЕсли Наименование ="коробка" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2052");	
			ИначеЕсли Наименование ="літр" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0138");	
			ИначеЕсли Наименование ="м.кв." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0123");		
			ИначеЕсли Наименование ="м.куб." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0134");		
			ИначеЕсли Наименование ="м.пог." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");		
			ИначеЕсли Наименование ="метр" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0101");		
			ИначеЕсли Наименование ="мішок" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2060");
			ИначеЕсли Наименование ="пакет" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2110");
			ИначеЕсли Наименование ="пачка" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2112");
			ИначеЕсли Наименование ="Піддон" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2009");
			ИначеЕсли Наименование ="порція" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("3011");
			ИначеЕсли Наименование ="рулон" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2116");
			ИначеЕсли Наименование ="см." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0104");
			ИначеЕсли Наименование ="т." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0306");
			ИначеЕсли Наименование ="упак." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2110");
			ИначеЕсли Наименование ="цис." тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2073");
			ИначеЕсли Наименование ="час" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("0175");
			ИначеЕсли Наименование ="штука" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2009");
			ИначеЕсли Наименование ="ящик" тогда
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("2075");
			ИначеЕсли Наименование ="грн." тогда	
				ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("9999");
				Если Ссылка = справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка() Тогда
					НовыйЕдиница = справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
					НовыйЕдиница.Наименование = Наименование;
					НовыйЕдиница.Код ="9999";
					НовыйЕдиница.Записать();
					ссылка = НовыйЕдиница.Ссылка;
				КонецЕсли;
			Иначе ссылка = справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(Наименование);
			КонецЕсли;  
			//********************************************************************
			
			Guid = Новый УникальныйИдентификатор(СтрокаТЗ.UID_Единица);
			
			Узел = ПолучитьУзел();
			
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(Ссылка, Guid, "УпаковкиЕдиницыИзмерения", Узел));
			
			Единица = Ссылка;
			
			НовыйЕдиница = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
			НовыйЕдиница.ОбменДанными.Загрузка = Истина;
			НовыйЕдиница.Наименование = Наименование;
			НовыйЕдиница.Записать();
			
		КонецЕсли;
	КонецЦикла;
	
	///////////////////////////////////////////////////////////////
	ТЗ_ТМЦ = ТЗ.Скопировать();
	
	Для Индекс = -ТЗ_ТМЦ.Количество() По -1 Цикл
		
		Стр = ТЗ_ТМЦ.Получить(-Индекс - 1);
		
		Если Стр.Наименование = Неопределено
			ИЛИ ПустаяСтрока(Стр.Наименование) Тогда
			
			ТЗ_ТМЦ.Удалить(Стр);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбработанныеТМЦ = Новый Соответствие;

	ТоварБезХарактеристики = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар без характеристики");
	
	Для Каждого СтрокаТЗ Из ТЗ_ТМЦ Цикл
		
		// Уже обработали эту ТМЦ
		Если ОбработанныеТМЦ.Получить(СтрокаТЗ.UID_ТМЦ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;			
		ОбработанныеТМЦ.Вставить(СтрокаТЗ.UID_ТМЦ, Истина);
		
		Если НЕ GUIDЗаполнен(СтрокаТЗ.UID_ТМЦ) Тогда
			//Сообщить("Порожній UID ТМЦ: " + СтрокаТЗ.Наименование_ТМЦ);
			Продолжить;
		КонецЕсли;
		
		Номенклатура = НайтиНоменклатураПоUID(СтрокаТЗ.UID_ТМЦ, СтрокаТЗ.Наименование_ТМЦ);
		ВидНоменклатуры = НайтиКатегорияПоUID(СтрокаТЗ.UID_Категория, СтрокаТЗ.Категория);
		Единица = НайтиЕдиницаПоUID(СтрокаТЗ.UID_Единица, СтрокаТЗ.Единица);
		
		Если Номенклатура.Пустая() Тогда
			
			НовыйНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
			НовыйНоменклатура.ОбменДанными.Загрузка = Истина; 
			
			Если ЗначениеЗаполнено(СтрокаТЗ.ТМЦРодитель) Тогда
				Владелец = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЗ.ТМЦРодитель);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Владелец) Тогда
				НовыйНоменклатура.Родитель = Владелец;
			КонецЕсли;
			
			НовыйНоменклатура.Наименование = СтрокаТЗ.Наименование_ТМЦ;
			НовыйНоменклатура.НаименованиеDigger = СтрокаТЗ.Наименование_ТМЦ;
			
		Иначе
			
			НовыйНоменклатура = Номенклатура.ПолучитьОбъект();
			НовыйНоменклатура.ОбменДанными.Загрузка = Истина; 
			
		КонецЕсли; 
		
		Если НовыйНоменклатура.ЭтоГруппа Тогда 
			Продолжить;
		КонецЕсли; 
		
		// Исправления
		Если ЗначениеЗаполнено(СтрокаТЗ.ТМЦРодитель) Тогда
			Владелец = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЗ.ТМЦРодитель);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Владелец) Тогда
			НовыйНоменклатура.Родитель = Владелец;
		КонецЕсли;
		
		// 
		Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
			Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.ВидНоменклатуры) Тогда
				НовыйНоменклатура.ВидНоменклатуры = ВидНоменклатуры;
			КонецЕсли;
		Иначе
			НовыйНоменклатура.ВидНоменклатуры = ТоварБезХарактеристики; 
		КонецЕсли;
		
		//
		Если СтрокаТЗ.ТМЦПоСериям Тогда
			Если ЗначениеЗаполнено(НовыйНоменклатура.ВидНоменклатуры) 
				И НовыйНоменклатура.ВидНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры	Тогда
				НовыйНоменклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры;
				//ИначеЕсли ЗначениеЗаполнено(НовыйНоменклатура.ВидНоменклатуры) 
				//	И НовыйНоменклатура.ВидНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать	Тогда
				//	НовыйНоменклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
			КонецЕсли;
		Иначе                            
			НовыйНоменклатура.ВидНоменклатуры = ТоварБезХарактеристики;
			НовыйНоменклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
		КонецЕсли;
		
		//
		//Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.ТипНоменклатуры) Тогда
			Если СтрокаТЗ.Вид = "Товар" Тогда
				НовыйНоменклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
			ИначеЕсли СтрокаТЗ.Вид = "Послуга" Тогда
				НовыйНоменклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
			Иначе
				НовыйНоменклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
			КонецЕсли;
		//КонецЕсли;
		
		//
		//Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.ТипНоменклатуры) Тогда
		//	НовыйНоменклатура.ТипНоменклатуры = ВидНоменклатуры.ТипНоменклатуры;
		//КонецЕсли;
		
		//
		Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.ВариантОформленияПродажи)
			И НовыйНоменклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда 
			НовыйНоменклатура.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг; 
		КонецЕсли;
		
		//
		//Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.ГруппаДоступа) Тогда
			НовыйНоменклатура.ГруппаДоступа = НовыйНоменклатура.ВидНоменклатуры.ГруппаДоступа;
		//КонецЕсли;
		
		//
		Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.ЕдиницаИзмерения) Тогда
			НовыйНоменклатура.ЕдиницаИзмерения = Единица;
		КонецЕсли;
		
		//
		Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.СтавкаНДС) Тогда 
			Если СтрокаТЗ.НалоговаяГруппа = "Без ПДВ" Тогда
				НовыйНоменклатура.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
			ИначеЕсли СтрокаТЗ.НалоговаяГруппа = "Не ПДВ" Тогда
				НовыйНоменклатура.СтавкаНДС = Перечисления.СтавкиНДС.НеНДС;
			ИначеЕсли СтрокаТЗ.НалоговаяГруппа = "ПДВ 0%" Тогда
				НовыйНоменклатура.СтавкаНДС = Перечисления.СтавкиНДС.НДС0;
			ИначеЕсли СтрокаТЗ.НалоговаяГруппа = "ПДВ 20%" Тогда
				НовыйНоменклатура.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
			ИначеЕсли СтрокаТЗ.НалоговаяГруппа = "ПДВ 7%" Тогда
				НовыйНоменклатура.СтавкаНДС = Перечисления.СтавкиНДС.НДС7;
			Иначе
				НовыйНоменклатура.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
			КонецЕсли;
		КонецЕсли;
		
		// сюда постепенно будем добавлять остальные реквизиты
		// Марка 
		Если ТЗ.Колонки.Найти("Марка") <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.Марка)
				И ЗначениеЗаполнено(СтрокаТЗ.Марка) Тогда
				
				Марка = Справочники.Марки.НайтиПоНаименованию(СтрокаТЗ.Марка);
				Если НЕ ЗначениеЗаполнено(Марка) Тогда
					НовыйМарка = Справочники.Марки.СоздатьЭлемент();
					НовыйМарка.ОбменДанными.Загрузка = Истина;
					НовыйМарка.Наименование = СтрокаТЗ.Марка;
					НовыйМарка.Записать();
					Марка = НовыйМарка.Ссылка;
				КонецЕсли;
				
				НовыйНоменклатура.Марка = Марка;
			КонецЕсли;
		КонецЕсли;
		
		// Модель 
		Если ТЗ.Колонки.Найти("МодельUA") <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.Модель)
				И ЗначениеЗаполнено(СтрокаТЗ.МодельUA) Тогда
				НовыйНоменклатура.Модель = СтрокаТЗ.МодельUA;
			КонецЕсли;
		КонецЕсли;
		
		Если ТЗ.Колонки.Найти("МодельRU") <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(НовыйНоменклатура.Модель_RU)
				И ЗначениеЗаполнено(СтрокаТЗ.МодельRU) Тогда
				НовыйНоменклатура.Модель_RU = СтрокаТЗ.МодельRU;
			КонецЕсли;
		КонецЕсли;
		
		// Страна
