				//Сообщить("Не найдена дополнительная Номенклатура: " + Строка(ЗначениеРеквизита));
				Продолжить;
			КонецЕсли;
			
			// Проверяем, есть ли уже такая связь
			НаборЗаписей = РегистрыСведений.НоменклатураПродаваемаяСовместно.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НоменклатураПредпосылка.Установить(НовыйНоменклатура.Ссылка);
			НаборЗаписей.Отбор.НоменклатураСледствие.Установить(НоменклатураСледствие);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда
				
				Запись = НаборЗаписей.Добавить();
				
				Запись.НоменклатураПредпосылка = НовыйНоменклатура.Ссылка;
				Запись.НоменклатураСледствие = НоменклатураСледствие;
				Запись.ДобавленоАвтоматически = Истина;
				Запись.ВариантАнализа =	Перечисления.ВариантыАнализаНоменклатурыПродаваемойСовместно.РозничнаяТорговля;
				
				НаборЗаписей.Записать();
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	///////////////////////////////////////////////////////////////
	ТЗСклады = ТЗ.Скопировать();
	ТЗСклады.Свернуть("UID_Склад, Склад","");  
	
	Для Каждого СтрокаТЗ Из ТЗСклады Цикл	
		Склад = НайтиСкладПоUID(СтрокаТЗ.UID_Склад, СтрокаТЗ.Склад); 
		Если Склад.Пустая() Тогда 
			//Сообщить("Не знайден Склад: " + СтрокаТЗ.UID_Склад + " Наименование: " +  СтрокаТЗ.Склад);
			
			Если НЕ GUIDЗаполнен(СтрокаТЗ.UID_Склад) Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйСклад = Справочники.Склады.СоздатьЭлемент();
			НовыйСклад.ОбменДанными.Загрузка = Истина;
			НовыйСклад.Наименование = СтрокаТЗ.Склад;
			НовыйСклад.Записать();  
			
			Guid = Новый УникальныйИдентификатор(СтрокаТЗ.UID_Склад);
			
			Узел = ПолучитьУзел();
			
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НовыйСклад.Ссылка, Guid, "Склады", Узел));
			
			Склад = НовыйСклад.Ссылка;
			
		КонецЕсли;
	КонецЦикла;
	ТЗСклады = Неопределено;
	
	///////////////////////////////////////////////////////////////
	ТЗСерии = ТЗ.Скопировать();
	ТЗСерии.Свернуть("UID_Серия, Серия, СерияСвойство, СерияЗначение, UID_ТМЦ, Наименование_ТМЦ", "");
	
	Для Каждого СтрокаТЗ Из ТЗСерии Цикл
		
		Если НЕ GUIDЗаполнен(СтрокаТЗ.UID_Серия) Тогда
			Продолжить;
		КонецЕсли;
		
		Номенклатура = НайтиНоменклатураПоUID(СтрокаТЗ.UID_ТМЦ, СтрокаТЗ.Наименование_ТМЦ);
		Серия = НайтиСерияПоUID(СтрокаТЗ.UID_Серия, СтрокаТЗ.Серия);
		
		Если Серия.Пустая() Тогда
			
			НовыйСерия = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
			НовыйСерия.ОбменДанными.Загрузка = Истина;
			
			НовыйСерия.Владелец = Номенклатура;
			НовыйСерия.Наименование = СтрокаТЗ.Серия;
			// Записываем серию
			НовыйСерия.Записать();
			
			// Записываем соответствие UID
			Guid = Новый УникальныйИдентификатор(СтрокаТЗ.UID_Серия);
			
			Узел = ПолучитьУзел();
			
			ДобавитьЗапись(ПолучитьСтруктуруЗаписи(НовыйСерия.Ссылка, Guid, "ХарактеристикиНоменклатуры", Узел));
			
			Серия = НовыйСерия.Ссылка;
			
		Иначе
			
			НовыйСерия = Серия.ПолучитьОбъект();
			НовыйСерия.ОбменДанными.Загрузка = Истина;
			
			Если НЕ ЗначениеЗаполнено(НовыйСерия.Владелец) Тогда
				НовыйСерия.Владелец = Номенклатура.Ссылка;
				НовыйСерия.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
		// Свойство серии
		Свойство = Справочники.СвойстваОбъектов.НайтиПоНаименованию(СтрокаТЗ.СерияСвойство);
		
		Если НЕ ЗначениеЗаполнено(Свойство) Тогда
			//Сообщить("Не найдено свойство серии: " + СтрокаТЗ.СерияСвойство);
			Продолжить;
		КонецЕсли;
		
		
		// Проверяем, нет ли уже такого свойства
		ЕстьСвойство = Ложь;
		
 		Для Каждого СтрокаСостав Из НовыйСерия.Состав Цикл
			
			Если СтрокаСостав.Свойство = Свойство Тогда
				ЕстьСвойство = Истина;
				Прервать;
 			КонецЕсли;
			
 		КонецЦикла;
		
		// Добавляем только если свойства ещё нет
		Если НЕ ЕстьСвойство Тогда
			
			Значение = Справочники.СвойстваОбъектовЗначения.НайтиПоНаименованию(СтрокаТЗ.СерияЗначение);
			
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				//Сообщить("Не найдено значение свойства серии: "	+ СтрокаТЗ.СерияЗначение);
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = НовыйСерия.Состав.Добавить();
			НоваяСтрока.Свойство = Свойство;
			НоваяСтрока.Значение = Значение;
			
			НовыйСерия.Записать();
		КонецЕсли; 
		
	КонецЦикла;

	/////////////////////////////////////////////////////////////////
	//ТЗОстатки = ТЗ.Скопировать();
	//ТЗОстатки.Свернуть("UID_Серия, Серия, UID_ТМЦ, Наименование_ТМЦ, Склад, UID_Склад, Остаток", "КвоДоступно");
