&НаСервере
Функция НайтиКатегорияПоUID(UID, Наименование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("UID", UID);
	Запрос.УстановитьПараметр("ТипПриемника", "Справочник.ВидыНоменклатуры");
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Соответствие.УникальныйИдентификаторПриемника КАК UIDПриемника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соответствие
	|ГДЕ
	|	Соответствие.УникальныйИдентификаторПриемника = &UID
	|	И Соответствие.ТипПриемника = &ТипПриемника";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Справочники.ВидыНоменклатуры.ПолучитьСсылку(
		Новый УникальныйИдентификатор(Выборка.UIDПриемника)
		);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	НЕ ВидыНоменклатуры.ПометкаУдаления
	|	И ВидыНоменклатуры.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;	    
	
	Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	
