&НаСервере
Функция МассивСтруктурВТаблицуЗначений(Данные)
	
	ТЗ = Новый ТаблицаЗначений;
	
	// Собираем все возможные колонки
	Для Каждого СтруктураДанных Из Данные Цикл
		
		Для Каждого КлючЗначение Из СтруктураДанных Цикл
			
			Если ТЗ.Колонки.Найти(КлючЗначение.Ключ) = Неопределено Тогда
				ТЗ.Колонки.Добавить(КлючЗначение.Ключ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Заполняем строки
	Для Каждого СтруктураДанных Из Данные Цикл
		
		СтрокаТЗ = ТЗ.Добавить();
		
		Для Каждого КлючЗначение Из СтруктураДанных Цикл
			СтрокаТЗ[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЦикла;
		
	КонецЦикла;  
	
	Возврат ТЗ;
	
