#Область ПрограммныйИнтерфейс

// Создает контекст одного запуска обмена: настройки, соединение, счетчики, ограничение частоты запросов.
//
// Параметры:
//  ПараметрыНастройки - Структура - см. keycrm_Обмен.ПараметрыНастройки
//
Функция НовыйКонтекст(ПараметрыНастройки) Экспорт

	ЗапросовВМинуту = ПараметрыНастройки.ЗапросовВМинуту;
	Если ЗапросовВМинуту <= 0 Тогда
		ЗапросовВМинуту = 20;
	КонецЕсли;

	// Интервал между запросами в целых секундах (с округлением вверх)
	ИнтервалСек = Цел(60 / ЗапросовВМинуту);
	Если ИнтервалСек * ЗапросовВМинуту < 60 Тогда
		ИнтервалСек = ИнтервалСек + 1;
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("Настройка", ПараметрыНастройки);
	Контекст.Вставить("ИдентификаторЗапуска", Новый УникальныйИдентификатор);
	Контекст.Вставить("Соединение", Неопределено);
	Контекст.Вставить("ИнтервалМс", ИнтервалСек * 1000);
	Контекст.Вставить("ПоследнийЗапросМс", 0);
	Контекст.Вставить("КоличествоЗапросов", 0);

	Возврат Контекст;

КонецФункции

// Выполняет запрос к KeyCRM с соблюдением лимита частоты и повторами при 429 / сетевых ошибках.
//
// Параметры:
//  Контекст - Структура - см. НовыйКонтекст
//  Метод    - Строка - "GET", "POST", "PUT"
//  Ресурс   - Строка - путь после /v1, например "/products/12/offers"
//  Тело     - Структура, Соответствие, Неопределено - будет записано в JSON
//
// Возвращаемое значение:
//  Структура - Успех, КодСостояния, Данные (Соответствие/Массив/Неопределено), ТекстОтвета, ТелоЗапроса, ОписаниеОшибки
//
Функция ВыполнитьЗапрос(Контекст, Метод, Ресурс, Тело = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("ТекстОтвета", "");
	Результат.Вставить("ТелоЗапроса", "");
	Результат.Вставить("ОписаниеОшибки", "");

	Если Тело <> Неопределено Тогда
		Результат.ТелоЗапроса = ВJSON(Тело);
	КонецЕсли;

	МаксПопыток = 4;
	Ответ = Неопределено;

	Для НомерПопытки = 1 По МаксПопыток Цикл

		ВыдержатьИнтервал(Контекст);

		Попытка

			Если Контекст.Соединение = Неопределено Тогда
				Контекст.Соединение = Новый HTTPСоединение("openapi.keycrm.app", 443, , , , 60,
					Новый ЗащищенноеСоединениеOpenSSL);
			КонецЕсли;

			HTTPЗапрос = Новый HTTPЗапрос("/v1" + Ресурс);
			HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
			HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + СокрЛП(Контекст.Настройка.ТокенAPI));

			Если Тело <> Неопределено Тогда
				HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
				HTTPЗапрос.УстановитьТелоИзСтроки(Результат.ТелоЗапроса, КодировкаТекста.UTF8,
					ИспользованиеByteOrderMark.НеИспользовать);
			КонецЕсли;

			Контекст.КоличествоЗапросов = Контекст.КоличествоЗапросов + 1;

			Если Метод = "GET" Тогда
				Ответ = Контекст.Соединение.Получить(HTTPЗапрос);
			ИначеЕсли Метод = "POST" Тогда
				Ответ = Контекст.Соединение.ОтправитьДляОбработки(HTTPЗапрос);
			ИначеЕсли Метод = "PUT" Тогда
				Ответ = Контекст.Соединение.Записать(HTTPЗапрос);
			Иначе
				ВызватьИсключение "Неизвестный HTTP-метод: " + Метод;
			КонецЕсли;

			Контекст.ПоследнийЗапросМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

		Исключение

			Результат.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Контекст.Соединение = Неопределено;
			Контекст.ПоследнийЗапросМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

			Если НомерПопытки < МаксПопыток Тогда
				Пауза(5);
				Продолжить;
			КонецЕсли;

			Возврат Результат;

		КонецПопытки;

		Результат.КодСостояния = Ответ.КодСостояния;
		Результат.ТекстОтвета  = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если Результат.ТекстОтвета = Неопределено Тогда
			Результат.ТекстОтвета = "";
		КонецЕсли;

		Если Ответ.КодСостояния = 429 И НомерПопытки < МаксПопыток Тогда
			// Превышен лимит запросов - ждем и повторяем
			Пауза(СекундДоПовтора(Ответ));
			Продолжить;
		КонецЕсли;

		Прервать;

	КонецЦикла;

	Если ЗначениеЗаполнено(Результат.ТекстОтвета) Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Результат.ТекстОтвета);
			Результат.Данные = ПрочитатьJSON(ЧтениеJSON, Истина); // читаем в Соответствие
			ЧтениеJSON.Закрыть();
		Исключение
			Результат.Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Результат.Успех = (Результат.КодСостояния >= 200 И Результат.КодСостояния < 300);

	Если Не Результат.Успех Тогда
		Результат.ОписаниеОшибки = "HTTP " + Формат(Результат.КодСостояния, "ЧН=0; ЧГ=0") + ": "
			+ Лев(Результат.ТекстОтвета, 2000);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Безопасно получает значение из ответа (Соответствие). Для отсутствующего ключа и null возвращает Неопределено.
Функция Зн(Данные, Ключ) Экспорт

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Данные.Получить(Ключ);

КонецФункции

// Возвращает число из значения ответа (число или строка), иначе 0.
Функция ЧислоИз(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		Попытка
			Возврат Число(СтрЗаменить(СокрЛП(Значение), ",", "."));
		Исключение
			Возврат 0;
		КонецПопытки;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Возвращает строку из значения ответа, для Неопределено - пустую строку.
Функция СтрокаИз(Значение) Экспорт

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧРД=.");
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Возвращает массив элементов из ответа: сам ответ, если это массив, либо поле "data".
Функция МассивДанных(Данные) Экспорт

	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Возврат Данные;
	КонецЕсли;

	ПолеData = Зн(Данные, "data");
	Если ТипЗнч(ПолеData) = Тип("Массив") Тогда
		Возврат ПолеData;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Сериализует значение в строку JSON.
Функция ВJSON(Значение) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// MD5-хеш строки в виде 32 символов.
Функция ХешСтроки(Текст) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Текст);
	Возврат СтрЗаменить(Строка(Хеширование.ХешСумма), " ", "");

КонецФункции

// Идентификатор KeyCRM для подстановки в адрес.
Функция ИДСтрокой(Идентификатор) Экспорт
	Возврат Формат(Идентификатор, "ЧН=0; ЧГ=0");
КонецФункции

// Кодирует значение параметра для строки запроса.
Функция КодироватьПараметр(Значение) Экспорт
	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Преобразует дату KeyCRM (UTC, "2026-11-13T10:15:00.000000Z" или "2026-11-13 10:15:00") в местное время.
Функция ДатаИзСтрокиUTC(Знач Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) < 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Цифры = Лев(Значение, 19);
	Цифры = СтрЗаменить(Цифры, "-", "");
	Цифры = СтрЗаменить(Цифры, ":", "");
	Цифры = СтрЗаменить(Цифры, "T", "");
	Цифры = СтрЗаменить(Цифры, " ", "");

	Попытка
		Возврат МестноеВремя(Дата(Цифры));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

// Дата местного времени в строку UTC для фильтров KeyCRM: "2026-11-13 10:15:00".
Функция ДатаВСтрокуUTC(ДатаМестная) Экспорт
	Возврат Формат(УниверсальноеВремя(ДатаМестная), "ДФ='yyyy-MM-dd HH:mm:ss'");
КонецФункции

// Служебная: используется для паузы, когда код выполняется не в фоновом задании.
Процедура ПаузаВФоне(Секунд) Экспорт
	Пауза(Секунд);
КонецПроцедуры

// Пауза на указанное число секунд (ожидание завершения собственного фонового задания).
Процедура Пауза(Знач Секунд) Экспорт

	Если Секунд <= 0 Тогда
		Возврат;
	КонецЕсли;

	Секунд = Цел(Секунд) + ?(Секунд > Цел(Секунд), 1, 0);

	ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();

	Если ФоновоеЗадание = Неопределено Тогда
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(Секунд);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("keycrm_API.ПаузаВФоне", ПараметрыЗадания);
	КонецЕсли;

	Попытка
		ФоновоеЗадание.ОжидатьЗавершения(Секунд);
	Исключение
		// истечение времени ожидания - это и есть пауза
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыдержатьИнтервал(Контекст)

	Если Контекст.ПоследнийЗапросМс = 0 Тогда
		Возврат;
	КонецЕсли;

	ОсталосьМс = Контекст.ИнтервалМс - (ТекущаяУниверсальнаяДатаВМиллисекундах() - Контекст.ПоследнийЗапросМс);
	Если ОсталосьМс > 0 Тогда
		Пауза(ОсталосьМс / 1000);
	КонецЕсли;

КонецПроцедуры

Функция СекундДоПовтора(Ответ)

	Секунд = 0;

	Для Каждого Заголовок Из Ответ.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "retry-after" Тогда
			Секунд = ЧислоИз(Заголовок.Значение);
		КонецЕсли;
	КонецЦикла;

	Если Секунд <= 0 Или Секунд > 120 Тогда
		Секунд = 20;
	КонецЕсли;

	Возврат Секунд;

КонецФункции

#КонецОбласти

