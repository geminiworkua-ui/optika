


Процедура ЗаполнитьДанныеОбъектовНП(ЭтаФорма, ЭтотОБъект) экспорт

	П = Инфра_ОбщиеМодули.ПолучитьРеквизитыОбъектовНовойПочты(ЭтотОБъект);
	Этаформа.Элементы.ДекорацияРеквизитыПолучталя.Заголовок = П.Получатель;
	ЭтаФорма.Элементы.ДекорацияКомандаСоздатьОткрыть.Заголовок = П.Декларация;
	
КонецПроцедуры	


Процедура ОткрытьАдресНП(ОбъектСсылка, СкладОтправитель = Неопределено, СкладПолучатель = неопределено, ЗаказКлиента = неопределено) экспорт
	
	Если ТипЗнч(ОБъектСсылка) = Тип("ДокументСсылка.ПеремещениеТоваров")
		Тогда
		Инфра_ОбщиеМодули.СоздатьРеквизитыПеремещения(СкладОтправитель, СкладПолучатель, ОБъектСсылка);
	КонецЕсли;
	
	Если ТипЗнч(ОБъектСсылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		И  ЗначениеЗаполнено(ЗаказКлиента)
		Тогда
		Инфра_ОбщиеМодули.СоздатьКопиюРеквизитовДоставки(ОбъектСсылка, ЗаказКлиента);
	КонецЕсли;
    	
	Рез = Инфра_ОбщиеМодули.ПолучитьКлючЗаписиРеквизитовЗаписи(ОБъектСсылка); 
	Попытка
		П = Новый Структура("Ключ", Рез);
		ОткрытьФОрму("РегистрСведений.РеквизитыДоставки.Форма.ФормаЗаписи", П, , ,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		П = Новый Структура("ОБъектСсылка", ОБъектСсылка);
		ОткрытьФОрму("РегистрСведений.РеквизитыДоставки.Форма.ФормаЗаписи", П, , ,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецПопытки;
	
КонецПроцедуры	


Процедура ОткрытьДекларацию(ОБъектСсылка) Экспорт
	
	Рез = Инфра_ОбщиеМодули.ПолучитьСсылкуНаДекларации(ОБъектСсылка); 
	Если Рез = Неопределено или Рез.КОличество() = 0
		ТОгда 
		П = Новый Структура("Новый, ОБъектСсылка");	
		
	Иначе
		ДЛя каждого Запись из Рез цикл
			П = Новый Структура("Ключ", Запись);	
			ОткрытьФОрму("Документ.eComm_ЭкспрессНакладная.Форма.ФормаДокумента", П);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	

Функция ПроверкаСобытияОбновленияФормы(ИмяСобытия, параметр, ОбъектСсылка) Экспорт
	
	Рез = 	
	(ИмяСобытия = "Запись_РеквизитыДоставки"
	И Параметр.ОбъектВладелец = ОБъектСсылка)
	ИЛИ
	(ИмяСобытия = "Запись_ЭкспрессНакладная" 
	И Параметр.ДокументОснование = ОБъектСсылка);
	Возврат Рез
КонецФункции