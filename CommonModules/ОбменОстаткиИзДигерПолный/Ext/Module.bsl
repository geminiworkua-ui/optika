
&НаСервере
Процедура ЗагрузитьОстаткиИзДигерПолныйНаСервере() Экспорт
	          
	ИмяФайла   = "\\10.99.0.1\ftp\Обмін\Диггер_УТ_ТолькоОстатки.json"; 
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ИмяФайла);     
	
	Данные = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	ТЗ = МассивСтруктурВТаблицуЗначений(Данные);
	
	ТЗОстатки = ТЗ.Скопировать();
	ТЗОстатки.Свернуть("UID_Склад, Склад, UID_ТМЦ, Наименование_ТМЦ, UID_Серия, Серия, Остаток","КвоДоступно");
	
	ТЗСкладыВводОстатков = ТЗОстатки.Скопировать();
	ТЗСкладыВводОстатков.Свернуть("UID_Склад, Склад", "");
	
	ДатаЗагрузки = ТекущаяДата();
	ОрганизацияПоУмолчанию = Справочники.Организации.ОрганизацияПоУмолчанию();
	КомментарийЗагрузки = "Завантажено з дігер";
	
	КэшСкладов = Новый Соответствие;
	КэшНоменклатуры = Новый Соответствие;
	КэшСерий = Новый Соответствие;
	
	
	// Группируем остатки по складам
	ОстаткиПоСкладам = Новый Соответствие;
	
	Для Каждого СтрокаОстаток Из ТЗОстатки Цикл
		
		КлючСклада = Строка(СтрокаОстаток.UID_Склад);
		
		МассивОстатков = ОстаткиПоСкладам.Получить(КлючСклада);
		
		Если МассивОстатков = Неопределено Тогда
			МассивОстатков = Новый Массив;
			ОстаткиПоСкладам.Вставить(КлючСклада, МассивОстатков);
		КонецЕсли;
		
		МассивОстатков.Добавить(СтрокаОстаток);
		
	КонецЦикла;
	
	//////////////////////////////////////////////////////////////////////
	Для Каждого СтрокаСклад Из ТЗСкладыВводОстатков Цикл
		
		КлючСклада = Строка(СтрокаСклад.UID_Склад);
		
		
		// Ищем склад по UID
		Склад = КэшСкладов.Получить(КлючСклада);
		
		Если НЕ ЗначениеЗаполнено(Склад) Тогда
			
			Склад = НайтиСкладПоUID(СтрокаСклад.UID_Склад, СтрокаСклад.Склад);
			
			Если ЗначениеЗаполнено(Склад) Тогда
				КэшСкладов.Вставить(КлючСклада, Склад);
			КонецЕсли;
			
		КонецЕсли;
		
		
		Если НЕ ЗначениеЗаполнено(Склад) Тогда
			Продолжить;
		КонецЕсли;
		
		
		// Получаем только остатки текущего склада
		МассивОстатков = ОстаткиПоСкладам.Получить(КлючСклада);
		
		Если МассивОстатков = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		
		// Ищем существующий документ
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВводОстатков.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВводОстатков КАК ВводОстатков
		|ГДЕ
		|	ВводОстатков.ПометкаУдаления = ЛОЖЬ
		|	И ВводОстатков.Склад = &Склад
		|	И ПОДСТРОКА(ВводОстатков.Комментарий, 1, 100) = &Комментарий";
		
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.УстановитьПараметр(
		"Комментарий",
		КомментарийЗагрузки
		);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		
		Если Результат.Следующий() Тогда
			
			ДокументОстатков = Результат.Ссылка.ПолучитьОбъект();
			
			ДокументОстатков.ОбменДанными.Загрузка = Истина;
			ДокументОстатков.Дата = ТекущаяДата();
			ДокументОстатков.Товары.Очистить();
			
		Иначе
			
			ДокументОстатков = Документы.ВводОстатков.СоздатьДокумент();
			
			ДокументОстатков.ОбменДанными.Загрузка = Истина;
			ДокументОстатков.Дата = ДатаЗагрузки;
			ДокументОстатков.Организация = ОрганизацияПоУмолчанию;
			ДокументОстатков.Склад = Склад;
			ДокументОстатков.Подразделение = Склад.Подразделение;
			ДокументОстатков.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ОстаткиСобственныхТоваров;
			ДокументОстатков.Комментарий = КомментарийЗагрузки;
			
		КонецЕсли;
		
		
		// Заполняем товары
		Для Каждого СтрокаОстаток Из МассивОстатков Цикл
			
			// Номенклатура по UID
			КлючНоменклатуры = Строка(СтрокаОстаток.UID_ТМЦ);
			
			Номенклатура = КэшНоменклатуры.Получить(КлючНоменклатуры);
			
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				
				Номенклатура = НайтиНоменклатураПоUID(СтрокаОстаток.UID_ТМЦ, СтрокаОстаток.Наименование_ТМЦ);
				
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					КэшНоменклатуры.Вставить(КлючНоменклатуры, Номенклатура);
				КонецЕсли;
				
			КонецЕсли;
			
			
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			
			// Серия по UID
			Серия = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаОстаток.UID_Серия) Тогда
				
				КлючСерии =	Строка(СтрокаОстаток.UID_Серия);
				
				Серия =	КэшСерий.Получить(КлючСерии);
				
				Если НЕ ЗначениеЗаполнено(Серия) Тогда
					
					Серия = НайтиСерияПоUID(СтрокаОстаток.UID_Серия, СтрокаОстаток.Серия);
					
					Если ЗначениеЗаполнено(Серия) Тогда
						КэшСерий.Вставить(КлючСерии, Серия);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			НоваяСтрока = ДокументОстатков.Товары.Добавить();
			
			НоваяСтрока.Номенклатура =Номенклатура;
			НоваяСтрока.Характеристика = Серия;
			НоваяСтрока.Упаковка = Номенклатура.ЕдиницаИзмерения;
			НоваяСтрока.Количество = СтрокаОстаток.КвоДоступно;
			НоваяСтрока.КоличествоУпаковок = СтрокаОстаток.КвоДоступно;
			НоваяСтрока.СтавкаНДС = Номенклатура.СтавкаНДС;
			
		КонецЦикла;
		
		
		// Записываем один раз
		Если ДокументОстатков.Товары.Количество() > 0 Тогда
			
			Попытка
				ДокументОстатков.ОбменДанными.Загрузка = Ложь;
				ДокументОстатков.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ДокументОстатков.ОбменДанными.Загрузка = Истина;
				ДокументОстатков.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция МассивСтруктурВТаблицуЗначений(Данные)
	
	ТЗ = Новый ТаблицаЗначений;
	
	// Собираем все возможные колонки
	Для Каждого СтруктураДанных Из Данные Цикл
		
		Для Каждого КлючЗначение Из СтруктураДанных Цикл
			
			Если ТЗ.Колонки.Найти(КлючЗначение.Ключ) = Неопределено Тогда
				ТЗ.Колонки.Добавить(КлючЗначение.Ключ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Заполняем строки
	Для Каждого СтруктураДанных Из Данные Цикл
		
		СтрокаТЗ = ТЗ.Добавить();
		
		Для Каждого КлючЗначение Из СтруктураДанных Цикл
			СтрокаТЗ[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЦикла;
		
	КонецЦикла;  
	
	Возврат ТЗ;
	
КонецФункции

&НаСервере
Функция НайтиНоменклатураПоUID(UID, Наименование)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("UID", UID);
	Запрос.УстановитьПараметр("ТипПриемника", "Справочник.Номенклатура");
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Соответствие.УникальныйИдентификаторПриемника КАК UIDПриемника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соответствие
	|ГДЕ
	|	Соответствие.УникальныйИдентификаторПриемника = &UID
	|	И Соответствие.ТипПриемника = &ТипПриемника";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Справочники.Номенклатура.ПолучитьСсылку(
		Новый УникальныйИдентификатор(Выборка.UIDПриемника)
		);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И Номенклатура.НаименованиеDigger = &Наименование");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;	    
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция НайтиСкладПоUID(UID, Наименование)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("UID", UID);
	Запрос.УстановитьПараметр("ТипПриемника", "Справочник.Склады");
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Соответствие.УникальныйИдентификаторПриемника КАК UIDПриемника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соответствие
	|ГДЕ
	|	Соответствие.УникальныйИдентификаторПриемника = &UID
	|	И Соответствие.ТипПриемника = &ТипПриемника";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Справочники.Склады.ПолучитьСсылку(
		Новый УникальныйИдентификатор(Выборка.UIDПриемника)
		);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Склады.Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ПометкаУдаления
	|	И Склады.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;	    
	
	Возврат Справочники.Склады.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция НайтиСерияПоUID(UID, Наименование)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("UID", UID);
	Запрос.УстановитьПараметр("ТипПриемника", "Справочник.ХарактеристикиНоменклатуры");
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Соответствие.УникальныйИдентификаторПриемника КАК UIDПриемника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соответствие
	|ГДЕ
	|	Соответствие.УникальныйИдентификаторПриемника = &UID
	|	И Соответствие.ТипПриемника = &ТипПриемника";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
