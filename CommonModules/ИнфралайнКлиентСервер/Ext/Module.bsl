 // Приводит номер телефона к стандартному виду "+380671234567"
 Функция НормализованныйНомерТелефона(Телефон, ИсключитьПлюс = Неопределено) экспорт
	 
	 ИсхНомер = Строка(Телефон);
	 Если СтрДлина(ИсхНОмер) < 9 Тогда
		 Возврат "";
	 Иначе	 
		 мЗамен = Новый Массив;
		 мЗамен.Добавить(".");
		 мЗамен.Добавить(",");
		 мЗамен.Добавить(" ");
		 мЗамен.Добавить("-");
		 мЗамен.Добавить("(");
		 мЗамен.Добавить(")");
		 мЗамен.Добавить("[");
		 мЗамен.Добавить("]");
		 мЗамен.Добавить("{");
		 мЗамен.Добавить("}"); 
		 мЗамен.Добавить("—"); 
		 мЗамен.Добавить(Символы.ВК);
		 мЗамен.Добавить(Символы.ВТаб);
		 мЗамен.Добавить(Символы.НПП);
		 мЗамен.Добавить(Символы.ПС);
		 мЗамен.Добавить(Символы.ПФ);
		 мЗамен.Добавить(Символы.Таб);
		 Для Каждого Запись Из мЗамен Цикл
			 ИсхНОмер = СтрЗаменить(ИсхНОмер, Запись, "");
		 КонецЦикла;
		 
		 Если СтрДлина(ИсхНОмер) < 9 Тогда
			 Рез = "";
		 ИначеЕсли СтрДлина(ИсхНОмер) = 9  Тогда
			 Рез = "+380" + ИсхНОмер;
			 
		 ИначеЕсли СтрДлина(ИсхНОмер) = 10  Тогда
			 Рез = "+38" + ИсхНОмер;
		 ИначеЕсли СтрДлина(ИсхНОмер) = 11  Тогда
			 Рез = "+3" + ИсхНОмер;	 
			 
		 ИначеЕсли СтрДлина(ИсхНОмер) >= 12  Тогда
			 Рез = "+" + Прав(ИсхНОмер,12);	 
		 КонецЕсли;
		 
		 Если НЕ ИсключитьПлюс = Неопределено 
			 и ИсключитьПлюс = Истина Тогда
			Рез = СтрЗаменить(Рез, "+",""); 
			КонецЕсли;
		Возврат Рез;
	 КонецЕсли;
КонецФункции	 