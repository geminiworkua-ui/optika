Функция ПолучитьЗначение(Спр,Значение)
Если ТипЗнч(Значение) = Тип("Строка") Тогда 	
  	ЗначениеСправочника = Справочники[Спр].НайтиПоНаименованию(Значение);
	Если ЗначениеСправочника = Справочники[Спр].ПустаяСсылка() Тогда
		ЗначениеОб =Справочники[Спр].СоздатьЭлемент();
		ЗначениеОб.Наименование =СокрЛП(Значение);
		ЗначениеОб.Записать();
		Возврат ЗначениеОб.Ссылка;
	Иначе
		Возврат ЗначениеСправочника;
	КонецЕсли;	
ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
    ЗначениеСтр = Формат(Значение,"ЧН=0; ЧВН=; ЧГ=0");
	ЗначениеСправочника = Справочники[Спр].НайтиПоНаименованию(ЗначениеСтр);
    Если ЗначениеСправочника = Справочники[Спр].ПустаяСсылка() Тогда
		ЗначениеОб =Справочники[Спр].СоздатьЭлемент();
		ЗначениеОб.Наименование =СокрЛП(Значение);
		ЗначениеОб.Записать();
		Возврат ЗначениеОб.Ссылка;
	Иначе
		Возврат ЗначениеСправочника;
	КонецЕсли;
КонецЕсли;

