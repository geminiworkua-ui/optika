Функция СформироватьОтветЗаказ(Результат, Ссылка)
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("Result", Результат.Успех);
	СтруктураОтвета.Вставить("Description", Результат.Описание);
	
	Данные = Новый Структура();
	Данные.Вставить("ID", Строка(Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("Status", Строка(Ссылка.Статус));
	Данные.Вставить("Number", Формат(Ссылка.Номер, "ЧГ=0"));
	Данные.Вставить("Client_ID", Строка(Ссылка.Контрагент.УникальныйИдентификатор()));
	Данные.Вставить("PDF", Строка(ОбменСайт.ПолучитьPDF(Ссылка)));
	
	СтруктураОтвета.Вставить("Data", Данные);
	Возврат СтруктураОтвета;

