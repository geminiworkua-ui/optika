Процедура ЗаписатьЛог(Задание, Результат, ОбъектСсылка, Запрос, Ответ = Неопределено, Сайт) Экспорт
	СтрокаЛог = РегистрыСведений.ЛогированиеСайт.СоздатьМенеджерЗаписи();
	СтрокаЛог.Сайт = Сайт;
	СтрокаЛог.Время = ТекущаяДата();
	СтрокаЛог.Режим = Перечисления.СайтЛогиРежим.Получение;
	СтрокаЛог.ТипДанных = ?(Задание = "NewDoc", Перечисления.СайтЛогиТипДанных.Документы, Перечисления.СайтЛогиТипДанных.Контрагенты);
	СтрокаЛог.ДанныеВходящие = Запрос;
	СтрокаЛог.КодСтатуса = ?(Результат.Успех, "200", "500");
	СтрокаЛог.Статус = ?(Результат.Успех, Перечисления.СайтЛогиСтатусы.Успешно, Перечисления.СайтЛогиСтатусы.СОшибками);	
	СтрокаЛог.ДанныеИсходящие = Ответ;                  
	СтрокаЛог.Ссылка = ОбъектСсылка;
	СтрокаЛог.Записать();
КонецПроцедуры

