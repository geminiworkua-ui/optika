
#Область ОбработкаЗапроса

Функция ОбработатьЗапрос(ТелоЗапроса, ОбъектСсылка, JSON = Неопределено, Узел = Неопределено) Экспорт
	
	Если ТелоЗапроса.Свойство("order") Тогда
		ТелоЗапроса = ТелоЗапроса.order;
	КонецЕсли; 
	
	РезультатУзел = ПолучитьУзелОбмена(ТелоЗапроса.ID);
	
	Если РезультатУзел = Неопределено Тогда	
		Стр = Новый Структура;
		Стр.Вставить("Result", Ложь);
		ОшибкаУзла = Истина;   
		Возврат Стр
	Иначе
		ОшибкаУзла = Ложь;
	КонецЕсли;
	
	Узел = РезультатУзел;
	
	Если ОшибкаУзла Тогда
		Результат = ПолучитьСтрОтвета("Не найден УИД сайта " + ТелоЗапроса.ID, Ложь);
		ТелоОтвета = СформироватьОтветЗапись(Результат, ТелоЗапроса, Узел.Ссылка); 
		Возврат ВыполнитьОбработкуДанных(Результат, объектСсылка, ТелоЗапроса,ТелоОтвета, JSON, Узел) ;   
		Task =	ТелоЗапроса.Task;
	КонецЕсли; 
	
	Если ТелоЗапроса.Task 		= "NewDoc" Тогда
		Возврат ПолучитьСсылкуЗаказа(ТелоЗапроса,ОбъектСсылка, JSON, Узел);						
	ИначеЕсли ТелоЗапроса.Task 	= "NewClient" Тогда
		Возврат ПолучитьСсылкуКлиента(ТелоЗапроса,ОбъектСсылка, JSON, Узел); 					
	ИначеЕсли ТелоЗапроса.Task 	= "Booking" Тогда
		Возврат Забронировать(ТелоЗапроса, ОбъектСсылка, JSON, Узел); 			
	ИначеЕсли ТелоЗапроса.Task 	= "TableChange" Тогда 
		Возврат ПолучитьСсылкуЗаписи(ТелоЗапроса, ОбъектСсылка, JSON, Узел);
		//Если Не ЗаписьСсылка = Ложь Тогда
		//	Результат = ЗаполнитьЗапись(ЗаписьСсылка, ТелоЗапроса.Data[0], Узел);   
		//	ЗарегистириоватьДанныеПоУзлу(ЗаписьСсылка.Ссылка, УИД, ТипПриемника, ТипИсточника, Узел);
		
		//	Бит_сервер.ДобавитьЗапись(бит_сервер.ПолучитьСтруктуруЗаписи(ЗаписьСсылка.Ссылка, ТелоЗапроса.Data[0], "Сайт.ЗаказПокупателя", "ДокментСсылка.ЗаказПокупателя", Узел));	
		//Иначе
		//	Результат = ПолучитьСтрОтвета("Запись с данным ID не найдена");	
		//КонецЕсли;
		//ТелоОтвета = СформироватьОтветЗапись(Результат, ЗаписьСсылка.Ссылка);
		// ++ Боков А.А. 05.07.2025 	
	ИначеЕсли  ТелоЗапроса.Task = "GetClientBonuses" Тогда 
		Возврат РезультатПроверкиОстаткаБонусов(ТелоЗапроса, Узел);
		// -- Боков А.А. 
	ИначеЕсли  ТелоЗапроса.Task = "GetDescriptionOfSeries" Тогда 
		Возврат РезультатРасшифровкиСерий(ТелоЗапроса, Узел)
		
	КонецЕсли;
	
	ТелоОтветаJSON = СформироватьJSON(ТелоОтвета);
	ЗаписатьЛог(ТелоЗапроса.Task, Результат, ОбъектСсылка, JSON, ТелоОтветаJSON, Узел.Сайт);
	
	Возврат ТелоОтвета;
КонецФункции

Функция ВыполнитьОбработкуДанных(Результат, ОбъектСсылка,ТелоЗапроса, ТелоОтвета, JSON, Узел)
	ТелоОтветаJSON = СформироватьJSON(ТелоОтвета);  
	
	Если JSON ="" или JSON = Неопределено Тогда
		JSON = СформироватьJSON(ТелоЗапроса); 
	КонецЕсли;		  
	
	ЗаписатьЛог(ТелоЗапроса.Task, Результат, ОбъектСсылка, JSON, ТелоОтветаJSON, Узел.Сайт);
	Возврат ТелоОтвета;
КонецФункции

Процедура ЗарегистириоватьДанныеПоУзлу(Ссылка, УИД, ТипПриемника, ТипИсточника, Узел)
	Бит_сервер.ДобавитьЗапись(бит_сервер.ПолучитьСтруктуруЗаписи(Ссылка, УИД, ТипПриемника, ТипИсточника, Узел));	
КонецПроцедуры
	

#КонецОбласти

#Область ПолучениеОбъектов  

Функция ПолучитьУзлыОбмена() Экспорт
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	ОбменССайтомНовый.Ссылка
|ИЗ
|	ПланОбмена.ОбменССайтомНовый КАК ОбменССайтомНовый
|ГДЕ
|	НЕ ОбменССайтомНовый.ЭтотУзел");
Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции	

Функция ПолучитьУзлыОбменаНоменклатуры(Номенклатура, Узлы) Экспорт
Массив =Новый Массив;
Если Номенклатура = Неопределено Тогда
	Возврат Массив;
КонецЕсли;

Если Номенклатура = справочники.Номенклатура.ПустаяСсылка() Тогда
	Возврат Массив;
КонецЕсли;	
	
Для Каждого Узел Из Узлы Цикл
	Если НЕ Номенклатура.СайтLuxor = NULL 
		И Номенклатура.СайтLuxor 
		И Узел.СайтLuxor Тогда
		Массив.Добавить(Узел);
	КонецЕсли;
	
	Если НЕ Номенклатура.СайтPolaroid = NULL 
		И Номенклатура.СайтPolaroid 
		И Узел.СайтPolaroid Тогда
		Массив.Добавить(Узел);
	КонецЕсли;
КонецЦикла;

Возврат Массив;

КонецФункции	


//Определение узла обмена
Функция ПолучитьУзелОбмена(IDУзла)
Если Не IDУзла = "" Тогда  	
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ОбменССайтомНовый.Ссылка
	|ИЗ
	|	ПланОбмена.ОбменССайтомНовый КАК ОбменССайтомНовый
	|ГДЕ
	|	НЕ ОбменССайтомНовый.ПометкаУдаления
	|	И ОбменССайтомНовый.IDУзла = &IDУзла");
	Запрос.УстановитьПараметр("IDУзла", IDУзла);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий()  Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
КонецЕсли;	  

КонецФункции	

//Определение клиента
Функция ПолучитьСсылкуКлиента(ТелоЗапроса, ОбъектСсылка, JSON, Узел)
ТипПриемника = "Сайт.Клиент";
ТипИсточника = "СправочникСсылка.Контрагенты";	
Если  ТелоЗапроса.Свойство("Data") Тогда
	Дата = ТелоЗапроса.Data;
	
	Если Дата.Свойство("Client_ID") Тогда  
		Если Дата.Client_ID =""	Тогда
			Возврат НайтиСоздатьКонтрагента(ТелоЗапроса, ОбъектСсылка, JSON, Узел);
		КонецЕсли;
		
		ЕстьЗапись = ЕстьЗапись(Дата.Client_ID, ТипПриемника, ТипИсточника, Узел );
		Если ЕстьЗапись Тогда
			Ссылка = ПолучитьОбъект(Дата.Client_ID, ТипПриемника, ТипИсточника, Узел);
			ОбъектСсылка = Ссылка.ПолучитьОбъект();
			Если Не ОбъектСсылка = неопределено Тогда
				Результат = ЗаполнитьКлиента(ОбъектСсылка, Дата, Узел);   
			   	ТелоОтвета = СформироватьОтветЗапись(Результат,Дата, Узел); 
			Иначе 
				УдалитьОбъект(Дата.Client_ID, ТипПриемника, ТипИсточника, Узел);
				Возврат НайтиСоздатьКонтрагента(ТелоЗапроса, ОбъектСсылка, JSON, Узел);
	         КонецЕсли;
		Иначе	
			Возврат НайтиСоздатьКонтрагента(ТелоЗапроса, ОбъектСсылка, JSON, Узел);	
		КонецЕсли;
	Иначе
		
		Возврат НайтиСоздатьКонтрагента(ТелоЗапроса, объектСсылка, JSON, Узел);

	КонецЕсли;
КонецЕсли;

Возврат ВыполнитьОбработкуДанных(Результат, ОбъектСсылка, ТелоЗапроса, ТелоОтвета, JSON, Узел);	


КонецФункции

Функция НайтиСоздатьКонтрагента(ТелоЗапроса, ОбъектСсылка,  JSON, Узел)
	ТипПриемника = "Сайт.Клиент";
	ТипИсточника = "СправочникСсылка.Контрагенты";
	
	ОбъектСсылка = Неопределено;
	Результат = Неопределено;  
	
	Если ТелоЗапроса.Свойство("Data") Тогда
		Дата  = ТелоЗапроса.Data;    
	Иначе
		Дата  = ТелоЗапроса;
	КонецЕсли;

	Если Дата.свойство("Client_Phone") Тогда
		Если Не ТелоЗапроса.Data.Client_Phone =""  Тогда
		ОбъектСсылка = НайтиКонтрагентаПоТелефону(Дата.Client_Phone);
		КонецЕсли;
	КонецЕсли;


	Если ОбъектСсылка = Неопределено Тогда
		Если Дата.свойство("Client_EMail") Тогда
                ОбъектСсылка = НайтиКонтрагентаПоEmail(Дата.Client_EMail);
		КОнецЕсли;		
	КонецЕсли;	                                                           
 

	Если ОбъектСсылка = Неопределено Тогда 
		Справочники.Контрагенты.СоздатьЭлемент();  
		Результат = ЗаполнитьКлиента(ОбъектСсылка, Дата, Узел); 
		ЗарегистириоватьДанныеПоУзлу(ОбъектСсылка.Ссылка, ОбъектСсылка.Ссылка.УникальныйИдентификатор(), ТипПриемника, ТипИсточника, Узел); 
	   
	Иначе 
		Результат = СформироватьРезультат();
	КонецЕсли;	
                                                  

	ТелоОтвета = СформироватьОтветКлиента(Результат, Дата, ОбъектСсылка.Ссылка); 

	Возврат ВыполнитьОбработкуДанных(Результат,ОбъектСсылка.Ссылка, ТелоЗапроса, ТелоОтвета, JSON, Узел)

КонецФункции	

//Определение Заказа
Функция ПолучитьСсылкуЗаказа(ТелоЗапроса, ОбъектСсылка, JSON, Узел)   
ТелоДата = ТелоЗапроса.Data; 
ТипПриемника = "Сайт.ЗаказПокупателя";
ТипИсточника = "ДокументСсылка.ЗаказКлиента";

Если ТелоДата.Doc_ID = "" Или ТелоДата.Doc_ID = Неопределено Тогда
	ОбъектСсылка = Документы.ЗаказКлиента.СоздатьДокумент();
	Результат = ЗаполнитьЗаказ(ОбъектСсылка, ТелоДата, Узел);          
	ЗарегистириоватьДанныеПоУзлу(ОбъектСсылка.Ссылка, ОбъектСсылка.Ссылка.УникальныйИдентификатор(), ТипПриемника, ТипИсточника, Узел);
	ТелоОтвета = СформироватьОтветЗаказ(Результат, ОбъектСсылка.Ссылка); 
	Возврат ВыполнитьОбработкуДанных(Результат, ОбъектСсылка.Ссылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);	
КонецЕсли;

ЕстьЗапись = ЕстьЗапись(ТелоЗапроса.Doc_ID, ТипПриемника, ТипИсточника, Узел);  

Если ЕстьЗапись Тогда
	 Ссылка = ПолучитьОбъект(ТелоЗапроса.Doc_ID, ТипПриемника, ТипИсточника, Узел);  
	 Если Не Ссылка = Неопределено Тогда
		 ОбъектСсылка = Ссылка.ПолучитьОбъект();  
		 Если Не ОбъектСсылка =Неопределено Тогда
		 	Результат = ЗаполнитьЗаказ(ОбъектСсылка, ТелоДата, Узел); 
		 	ТелоОтвета = СформироватьОтветЗаказ(Результат, ОбъектСсылка.Ссылка);     
			Возврат ВыполнитьОбработкуДанных(Результат, ОбъектСсылка.ссылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);	
		КонецЕсли;
	КонецЕсли;
	
Иначе 
	 Результат = ПолучитьСтрОтвета("Заказ с данным ID не найден", Ложь);
     ТелоОтвета = СформироватьОтветЗаказ(Результат, ОбъектСсылка.Ссылка);  
	 Возврат ВыполнитьОбработкуДанных(Результат, ОбъектСсылка.ссылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);	
КонецЕсли;	 

КонецФункции

Функция ПолучитьСсылкуЗаписи(ТелоЗапроса, ОбъектСсылка,  JSON, Узел) 
	ТипПриемника = "Сайт.ЗаписьКВрачу";
	ТипИсточника = "ДокументСсылка.ЗаписьНаПрием";
	
	//Для каждого Строка из ТелоЗапроса.Data	Цикл 
	УИД = 	ТелоЗапроса.Data.Doc_ID;	
	
	Если УИД = "" Или УИД = Неопределено Тогда
		ОбъектСсылка = Документы.ЗаписьНаПрием.СоздатьДокумент();
		Результат = ЗаполнитьЗапись(ОбъектСсылка, ТелоЗапроса.Data, Узел);
		ЗарегистириоватьДанныеПоУзлу(ОбъектСсылка.Ссылка, ОбъектСсылка.Ссылка.УникальныйИдентификатор(), ТипПриемника, ТипИсточника, Узел);
		ТелоОтвета = СформироватьОтветЗапись(Результат, ОбъектСсылка.Ссылка);
		Возврат ВыполнитьОбработкуДанных(Результат, ОбъектСсылка.Ссылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);	
	КонецЕсли;
	
	ЕстьЗапись = ЕстьЗапись(УИД, ТипПриемника, ТипИсточника, Узел);
	Если ЕстьЗапись Тогда
		Ссылка = ПолучитьОбъект(УИД, ТипПриемника, ТипИсточника, Узел);
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Ссылка = ПолучитьОбъект(УИД, ТипПриемника, ТипИсточника, Узел);
			СсылкаОбъект = Ссылка.ПолучитьОбъект();
			Если СсылкаОбъект = Неопределено Тогда
				Результат = ПолучитьСтрОтвета("Запись с данным ID не найдена", Ложь);
				ТелоОтвета = СформироватьОтветЗапись(Результат, Ссылка.Ссылка);  
				Возврат ВыполнитьОбработкуДанных(Результат, ОбъектСсылка.ссылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);							
			КонецЕсли;
		КонецЕсли;
	Иначе
		Результат = ПолучитьСтрОтвета("Запись с данным ID не найдена", Ложь);
		ТелоОтвета = СформироватьОтветЗапись(Результат, ОбъектСсылка.Ссылка);  
		Возврат ВыполнитьОбработкуДанных(Результат, ОбъектСсылка.Ссылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);	
	КонецЕсли;
	//КонецЦикла;

КонецФункции
#КонецОбласти

#Область ЗаполнениеОбъектов

Функция ЗаполнитьКлиента(НовыйКонтрагент, ДанныеКлиента, Узел)
	Если НовыйКонтрагент =Неопределено Тогда
		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
	КонецЕсли;	
	НовыйКонтрагент.Партнер = ЗаполнитьПартнера(ДанныеКлиента, Узел);
	НовыйКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
	НовыйКонтрагент.Наименование = ДанныеКлиента.Client_Name;
	НовыйКонтрагент.НаименованиеПолное = НовыйКонтрагент.Наименование;
	НовыйКонтрагент.КонтактнаяИнформация.Очистить();
	Если Не СокрЛП(ДанныеКлиента.Client_Phone) =""  Тогда
		Контакт = НовыйКонтрагент.КонтактнаяИнформация.Добавить();
		Контакт.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		Контакт.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		Контакт.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		Контакт.Представление = ДанныеКлиента.Client_Phone;
	  	Контакт.НомерТелефона = ДанныеКлиента.Client_Phone; 
		ОбщегоНазначенияУТ.ЗаполнитьЗначенияПолейКИПоПредставлению(Контакт.Представление, Контакт.ЗначенияПолей, Контакт.Тип);
	КонецЕсли;  
	
	Если Не СокрЛП(ДанныеКлиента.Client_EMail) =""  Тогда
		ЭлПочта = НовыйКонтрагент.КонтактнаяИнформация.Добавить();
		ЭлПочта.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		ЭлПочта.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
		ЭлПочта.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
		ЭлПочта.Представление = ДанныеКлиента.Client_EMail;
		ЭлПочта.АдресЭП = ДанныеКлиента.Client_EMail;  
		ОбщегоНазначенияУТ.ЗаполнитьЗначенияПолейКИПоПредставлению(ЭлПочта.Представление, ЭлПочта.ЗначенияПолей, ЭлПочта.Тип);
	КонецЕсли;
	
	НовыйКонтрагент.ОбменДанными.Загрузка = Истина;
	
	НовыйКонтрагент.Записать(); 
	Результат = Новый Структура();
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("Описание", "Завдання [NewClient]");		
	Возврат Результат;
		
КонецФункции

Функция СформироватьРезультат()
	Результат = Новый Структура();
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("Описание", "Завдання [NewClient]");		
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьКлиентаПоЗаказу(НовыйКонтрагент, ДанныеЗаказа, Узел)  
	
	//НовыйКонтрагент.Партнер = 1;
	НовыйКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
	НовыйКонтрагент.Наименование = ДанныеЗаказа.Doc_Recipient;
	НовыйКонтрагент.НаименованиеПолное = НовыйКонтрагент.Наименование;
	НовыйКонтрагент.КонтактнаяИнформация.Очистить(); 
	
	Если ДанныеЗаказа.Свойство("Doc_RecipientPhone") Тогда
		Если Не СокрЛП(ДанныеЗаказа.Doc_RecipientPhone) =""  Тогда
			Контакт = НовыйКонтрагент.КонтактнаяИнформация.Добавить();
			Контакт.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Контакт.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
			Контакт.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
			Контакт.Представление = ДанныеЗаказа.Doc_RecipientPhone;
		  	Контакт.НомерТелефона = ДанныеЗаказа.Doc_RecipientPhone;
			ОбщегоНазначенияУТ.ЗаполнитьЗначенияПолейКИПоПредставлению(Контакт.Представление, Контакт.ЗначенияПолей, Контакт.Тип);
		КонецЕсли; 
	КонецЕсли;
	
	Если ДанныеЗаказа.Свойство("Doc_RecipientEmail") Тогда
		Если Не СокрЛП(ДанныеЗаказа.Doc_RecipientEmail) =""  Тогда
			Контакт = НовыйКонтрагент.КонтактнаяИнформация.Добавить();
			Контакт.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			Контакт.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
			Контакт.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
			Контакт.Представление = ДанныеЗаказа.Doc_RecipientEmail;
		  	Контакт.АдресЭП = ДанныеЗаказа.Doc_RecipientEmail;
			ОбщегоНазначенияУТ.ЗаполнитьЗначенияПолейКИПоПредставлению(Контакт.Представление, Контакт.ЗначенияПолей, Контакт.Тип);
		КонецЕсли;  
    КонецЕсли;
	
	НовыйКонтрагент.ОбменДанными.Загрузка = Истина;
	
	НовыйКонтрагент.Записать(); 
		
КонецПроцедуры

Функция ЗаполнитьЗаказ(Ссылка, ДанныеЗаказа, Узел)
	Если ТипЗнч(Ссылка) = Тип("ДокументОбъект.ЗаказКлиента") Тогда	
		ТекДокумент = Ссылка;   
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда		
		ТекДокумент = Ссылка.ПолучитьОбъект();
		Если ТекДокумент  =Неопределено Тогда
			ТекДокумент = Документы.ЗаказКлиента.СоздатьДокумент();
		КонецЕсли;
	Иначе
		 ТекДокумент = Документы.ЗаказКлиента.СоздатьДокумент();
	КонецЕсли;
	ТекДокумент.Узел = Узел; 
	ТекДокумент.Дата = ТекущаяДата();
	ТекДокумент.Приоритет =  ?(Не Справочники.Приоритеты.НайтиПоНаименованию("Середній").Пустая(),Справочники.Приоритеты.НайтиПоНаименованию("Середній"),Справочники.Приоритеты.НайтиПоНаименованию("Средний")); 
	ТекДокумент.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	ТекДокумент.ДатаСогласования = ТекущаяДата();
	ТекДокумент.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным;
	ТекДокумент.НомерПоДаннымКлиента = Формат(ДанныеЗаказа.Doc_Number,"ЧГ=0");
	ТекДокумент.ДатаПоДаннымКлиента = ТекущаяДата();
	
	ТекДокумент.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению;
	ТекДокумент.Склад = Узел.Склад;
	// + Боков
	//ТекДокумент.Склад = Справочники.Склады.НайтиПоНаименованию("Склад");
	// - 
	//ТекДокумент.Партнер =  ПолучитьПартнера(ДанныеЗаказа, Узел);
	ТекДокумент.ЭтоИнтернетМагазин = Истина;
		
	//Контрагент = НайтиКонтрагентаПоТелефону(ДанныеЗаказа.Doc_RecipientPhone);
	////Если Контрагент = Неопределено Тогда
	//Контрагент = ПолучитьКонтрагента(ДанныеЗаказа, Узел);   
	////КонецЕсли;
	//
	//Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда 
	//	ТекДокумент.Контрагент =  Контрагент; 
	//	ТекДокумент.Партнер    =  Контрагент.Партнер;
	//	Если ТекДокумент.Партнер = Справочники.Партнеры.ПустаяСсылка() Тогда
	//		 Партнер =  ПолучитьПартнера(ДанныеЗаказа, Узел);     
	//		 КонтрагентОб = Контрагент.ПолучитьОбъект();
	//		 КонтрагентОб.Партнер =  Партнер;
	//		 КонтрагентОб.ОбменДанными.Загрузка = Истина;
	//		 КонтрагентОб.Записать();
	//		 ТекДокумент.Партнер    =  Контрагент.Партнер;
	//   КонецЕсли;
	//Иначе
	//  Возврат Контрагент;
	//КонецЕсли;  
	
	Рез = НайтиСоздатьПартнера(ДанныеЗаказа.Doc_RecipientPhone, ДанныеЗаказа.Doc_Recipient);	
	ТекДокумент.Партнер = Рез.Партнер.Ссылка;
	ТекДокумент.Контрагент = Рез.Контрагент.Ссылка;
	
	
	ТекДокумент.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	
	ТекДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	ТекДокумент.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	
	// + Боков
	ТекДокумент.Подразделение = Узел.Сайт.Подразделение;
	// - Боков
	
	ТекДокумент.СуммаБонусовКСписанию = ДанныеЗаказа.Final_Total_Discount_Value;
	//
	
	ПромоИсп = Ложь;
	СуммаСкидки = 0;
	//Добавление товаров
	ТекДокумент.Товары.Очистить();  
	УзелОЛД = ОбменСайт.ПолучитьУзелСтаройБазы(); 
	СуммаДокумента = 0;
	Для Каждого Товар Из ДанныеЗаказа.Products Цикл 
		
		Стр = Новый Структура;
		Стр.Вставить("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
		Стр.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		Результат = Неопределено;
		ПолучитьТовар(Товар, Стр, Результат);
		
		Если Результат = Неопределено Тогда
			Результат = Новый Структура();
			Результат.Вставить("Успех", Ложь);
			Результат.Вставить("Описание", "Ошибка записи заказа: Позиция не найдена");
			Возврат Результат;
		ИначеЕсли Не  Результат.Успех Тогда
			Возврат Результат;

		КонецЕсли;
		 
		ТекТовар = ТекДокумент.Товары.Добавить();
		ПолучитьТовар(Товар, ТекТовар, Результат);
		
		Если  ТекТовар.Номенклатура.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
			ТекТовар.Упаковка = ТекТовар.Номенклатура.ОсновнаяУпаковка;
		Иначе
			ТекТовар.Упаковка = ТекТовар.Номенклатура.ЕдиницаИзмерения;
		КонецЕсли;
		
		ТекТовар.ДатаОтгрузки = ТекущаяДата();
		
		ТекТовар.КоличествоУпаковок = Товар.Quantity;
		ТекТовар.Количество = ТекТовар.КоличествоУпаковок; 
		Цена = ПолучитьЦену(ТекТовар.Номенклатура, ТекТовар.Характеристика, Узел);
		ТекТовар.Цена  = ?(Цена = Неопределено, Товар.Sum/Товар.Quantity, Цена);	
		ТекТовар.Сумма = Товар.Sum;
		ТекТовар.СуммаРучнойСкидки =  (ТекТовар.Цена* ТекТовар.Количество) - ТекТовар.Сумма;   
		ТекТовар.ВидЦены = Узел.ЦенаРозница;
		//ТекТовар.ПроцентРучнойСкидки = ТекТовар.СуммаРучнойСкидки/
		ТекТовар.СтавкаНДС = ТекТовар.Номенклатура.СтавкаНДС;
		
		Если Не ТекТовар.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда 
			
			ТекТовар.СуммаНДС = ТекТовар.Сумма - (ТекТовар.Сумма/(1 + Число(СтрЗаменить(ТекТовар.СтавкаНДС, "%", ""))/100));
		Иначе
			ТекТовар.СуммаНДС = 0;
		КонецЕсли;
		СуммаДокумента = СуммаДокумента + ТекТовар.Сумма;
		ТекТовар.СуммаСНДС = ТекТовар.Сумма;
		ТекТовар.Склад = Узел.Склад;
		ТекТовар.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		
		ТекТОвар.СуммаСтар =  ТОвар.OldSum;
		ТекТовар.СуммаСкидки = Товар.Discount;
		ТекТовар.ПроцентСкидки = ?(Товар.OldSum > 0, 100*Товар.Discount /Товар.OldSum,0);													//})
		
	КонецЦикла;
		
	ТекДокумент.СуммаДокумента = СуммаДокумента;	
	НуженДокДоставки = Ложь;   
	Если ДанныеЗаказа.Doc_DeliveryService = "UkrPost" Тогда
		ТекДокумент.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента;
		// ++ Долавлена конвертация адреса из юникода
		ТекДокумент.ПараметрыДоставки = "УКРПошта " + 
								ПреобразоватьЮникод(ДанныеЗаказа.Doc_BranchName) + 
								ПреобразоватьЮникод(ДанныеЗаказа.Doc_BranchCityName); 
								
		ТекДокумент.АдресДоставки = ТекДокумент.ПараметрыДоставки;						
		ТекДокумент.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.УкрПочта;						
								
								
	ИначеЕсли ДанныеЗаказа.Doc_DeliveryService = "NewPost" Тогда
	//	ЗаполнитьПараметрыДоставкиНоваяПочта(ДанныеЗаказа, ТекДокумент);
		ТекДокумент.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента;
		ТекДокумент.АдресДоставки = ДанныеЗаказа.Doc_BranchCityName + " " + ДанныеЗаказа.Doc_BranchName;
		ТекДокумент.ДополнительнаяИнформацияПоДоставке = ДанныеЗаказа.Doc_Recipient + " " + ДанныеЗаказа.Doc_RecipientPhone;
		ТекДокумент.ПараметрыДоставки = "НоваПошта " + ТекДокумент.АдресДоставки + ТекДокумент.ДополнительнаяИнформацияПоДоставке;
		
		ТекДокумент.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта;	
		
	КонецЕсли;
    	
	Попытка
		ТекДокумент.Записать(РежимЗаписиДокумента.Проведение);
		
		// отметим факт поступления
		РС = РегистрыСведений.РегистрацияСтатусовЗаказовИМ.СоздатьМенеджерЗаписи();
		РС.ЗаказКлиента = ТекДокумент.ссылка;
		РС.Статус = Перечисления.СтатусыОбработкиЗаказовИМ.Получен;
		РС.Сумма = СуммаДокумента;
		РС.Период = ТекущаяДата();
		РС.ДокОснование = ТекДокумент.ссылка;
		РС.Записать();
		
	Исключение
		ТекДокумент.Записать(РежимЗаписиДокумента.Запись);

		Результат = Новый Структура();
		Результат.Вставить("Успех", Ложь);
		Результат.Вставить("Описание", "Ошибка записи заказа: "+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	
	Если ДанныеЗаказа.Doc_DeliveryService = "NewPost" Тогда
	//	ЗаполнитьПараметрыДоставкиНоваяПочта(ДанныеЗаказа, ТекДокумент);
			
	ЗР = РегистрыСведений.РеквизитыДоставки.СоздатьМенеджерЗаписи();
	ЗР.ОбъектВладелец= ТекДокумент.Ссылка;
	ЗР.УчетнаяЗапись = Узел.УчетнаяЗаписьНоваяПочта;
	ЗР.ОтправительПоУмолчанию = Истина;
	ЗР.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта;
		
	ЗР.ПолучательФИО =  ДанныеЗаказа.Doc_Recipient;
	ЗР.ПолучательТелефон = прав(ИнфралайнКлиентСервер.НормализованныйНомерТелефона(ДанныеЗаказа.Doc_RecipientPhone),12);
	ЗР.ДоставкаКурьером = ДанныеЗаказа.Doc_DeliveryCourier;
	Если ЗР.ДоставкаКурьером Тогда
		ЗР.ТехнологияДоставки= Справочники.eComm_ОбщиеСправочники.НайтиПоКоду("000000170");
	Иначе	
		ЗР.ТехнологияДоставки= Справочники.eComm_ОбщиеСправочники.НайтиПоКоду("000000170");
	КонецЕсли;
	
	
	ЗР.ОтделениеПолучателя = НайтиОтделениеДоставки(ДанныеЗаказа.Doc_BranchID,Перечисления.eComm_СлужбыДоставки.НоваяПочта);
	ЗР.НаселенныйПунктПолучателя = НайтиНаселенныйПунктДоставки(ДанныеЗаказа.Doc_BranchCityID, Перечисления.eComm_СлужбыДоставки.НоваяПочта);
	Если Не СокрЛП(ДанныеЗаказа.Doc_RecipientAddress.Recipient_Street) = "" Тогда	
		ЗР.УлицаПолучателя = НайтиУлицу(ЗР.НаселенныйПунктПолучателя, СокрЛП(ДанныеЗаказа.Doc_RecipientAddress.Recipient_Street));  
		ЗР.НомерДомаПолучателя = ДанныеЗаказа.Doc_RecipientAddress.Recipient_House;
		ЗР.НомерКвартирыПолучателя = ДанныеЗаказа.Doc_RecipientAddress.Recipient_Ap;
		
	Иначе
		ЗР.УлицаПолучателя= Справочники.eComm_Улицы.ПустаяСсылка();
	КонецЕсли;
	
	ЗР.Записать();
	//
	
	КонецЕсли;
    	
	//   "StatusDescription": null
	Если ДанныеЗаказа.Doc_Pay = "COD" ИЛИ ДанныеЗаказа.Doc_Pay = "LiqPay" Тогда
		Если ДанныеЗаказа.Doc_Payed = true Тогда
			Результат = СоздатьДокументБезналОплаты(ТекДокумент, ДанныеЗаказа);
			// + Боков  ОТметим, что этот документ был оплачен и больше платить не надо
			ТекДокумент.ПолучитьОбъект();
			ТекДокумент.ОплаченПриСоздании = Истина;
			РезСозданияРеализации =  Инфра_ОбщиеМодули.СоздатьАвтореализациюИнтернетМагазин(ТекДокумент);
			
			Если РезСозданияРеализации = ложь
				Тогда
				ТекДокумент.ЕстьПроблемаФормированияОтгрузки = Истина;
			Иначе
				ТекДокумент.ЕстьПроблемаФормированияОтгрузки = Ложь;
				
				РС = РегистрыСведений.РегистрацияСтатусовЗаказовИМ.СоздатьМенеджерЗаписи();
				РС.ЗаказКлиента = ТекДокумент.ссылка;
				РС.Статус = Перечисления.СтатусыОбработкиЗаказовИМ.СформированоОбеспечение;
				РС.Период = ТекущаяДата(); 
				РС.Сумма = СуммаДокумента;
				РС.ДокОснование = ТекДокумент.ссылка;
				РС.Записать();
               				
				РС = РегистрыСведений.РегистрацияСтатусовЗаказовИМ.СоздатьМенеджерЗаписи();
				РС.ЗаказКлиента = ТекДокумент.ссылка;
				РС.Статус = Перечисления.СтатусыОбработкиЗаказовИМ.СформированаРеализация;
				РС.Сумма = СуммаДокумента;
				РС.Период = ТекущаяДата();
				РС.ДокОснование = ТекДокумент.ссылка;
				РС.Записать();
				
			КонецЕсли;
						
			ТекДокумент.Записать();
			// - Боков
			 			
			Если Не Результат.Успех Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
					
	Результат = Новый Структура();
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("Описание", "Завдання [New_Doc]");
		
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьПараметрыДоставкиНоваяПочта(ДанныеЗаказа, ТекДокумент) 
	
	ТекДокумент = Документы.ЗаказКлиента.СоздатьДокумент(); 	
	ТекДокумент.СлужбаДоставки = Перечисления.eComm_СлужбыДоставки.НоваяПочта;

	ТекДокумент.УчетнаяЗапись = eCommДоставкаСервер.ВернутьУчетнуюЗаписьПоУмолчанию(ТекДокумент.СлужбаДоставки);
	ТекДокумент.ОтделениеДоставки = НайтиОтделениеДоставки(ДанныеЗаказа.Doc_BranchID,ТекДокумент.СлужбаДоставки);
	ТекДокумент.НаселенныйПунктДоставки = НайтиНаселенныйПунктДоставки(ДанныеЗаказа.Doc_BranchCityID, ТекДокумент.СлужбаДоставки);
	ТекДокумент.ДоставкаКурьером = ДанныеЗаказа.Doc_DeliveryCourier;
	СтрКонтрагента =Новый Структура;
	СтрКонтрагента.Вставить("Имя", ДанныеЗаказа.Doc_Recipient);
	СтрКонтрагента.Вставить("Телефон", ДанныеЗаказа.Doc_RecipientPhone);  
	ТекДокумент.Получатель = НайтиПолучателяЗаказа(ТекДокумент, СтрКонтрагента); 
	Если ДанныеЗаказа.Doc_RecipientAddress =Неопределено Тогда
		Возврат;
	КонецЕсли;	             
	ТекДокумент.АдресПолучателя = НайтиАдресПолучателяЗаказа(ТекДокумент, ДанныеЗаказа.Doc_RecipientAddress); 
	
КОнецПроцедуры	

Функция НайтиОтделениеДоставки(Идентификатор, Службадоставки)
Запрос = Новый Запрос(
  "ВЫБРАТЬ
 |	eComm_ОтделенияДоставки.Ссылка
 |ИЗ
 |	Справочник.eComm_ОтделенияДоставки КАК eComm_ОтделенияДоставки
 |ГДЕ
 |	eComm_ОтделенияДоставки.Идентификатор = &Идентификатор
 |	И eComm_ОтделенияДоставки.СлужбаДоставки = &СлужбаДоставки
 |	И НЕ eComm_ОтделенияДоставки.ПометкаУдаления");
Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
Запрос.УстановитьПараметр("СлужбаДоставки", Службадоставки); 
