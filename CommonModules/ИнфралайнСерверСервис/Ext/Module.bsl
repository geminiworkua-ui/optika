Функция НайтиСоздатьПартнера(НомерТелефона, Наименование)
	УстановитьПРивилегированныйРежим(Истина);
	
	ТелефонПоиска = ИнфралайнКлиентСервер.НормализованныйНомерТелефона(НомерТелефона);
	//
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Партнеры.Ссылка КАК партнер,
	|	Партнеры.ОсновнойНомер
	|ИЗ
	|	Справочник.Партнеры КАК Партнеры
	|ГДЕ
	|	Партнеры.ОсновнойНомер = &ОсновнойНомер
	|	И НЕ Партнеры.ПометкаУдаления");
	
	Запрос.УстановитьПараметр("ОсновнойНомер", ТелефонПоиска);
	Результат = Запрос.Выполнить().Выбрать();                
	Если Результат.Следующий() Тогда
		партнер = Результат.партнер;
	Иначе
		Партнер = Справочники.Партнеры.СоздатьЭлемент();
		Партнер.Клиент = Истина;
		Партнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
		Партнер.ОсновнойНомер = ТелефонПоиска;
		Партнер.Наименование =  Наименование;
		Партнер.НаименованиеПолное = Наименование;     
		НовСтр = Партнер.КонтактнаяИнформация.Добавить();
		НовСтр.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
		НовСтр.НомерТелефона = НомерТелефона;
		НовСтр.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		
		Партнер.Записать();
	КонецЕсли;	
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Партнер = &Партнер
	|	И НЕ Контрагенты.ПометкаУдаления");
	
	Запрос.УстановитьПараметр("Партнер", Партнер.ссылка);
	Результат = Запрос.Выполнить().Выбрать();                
	Если Результат.Следующий() Тогда
		Контрагент = Результат.Контрагент;
	Иначе
		Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
		Контрагент.Партнер = партнер;
		Контрагент.ПлательщикНДС = ложь;
		Контрагент.Наименование = Наименование;
		Контрагент.НаименованиеПолное = Наименование;
		Контрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		НовСтр = Контрагент.КонтактнаяИнформация.Добавить();
		НовСтр.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
		НовСтр.НомерТелефона = НомерТелефона;
		НовСтр.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
        Контрагент.Записать();
	КонецЕсли;	
	
	П = Новый СТруктура("Партнер, Контрагент", Партнер, Контрагент);
    Возврат П;

КонецФункции


Функция ПолучитьКонтрагента(ДанныеЗаказа, Узел)
ТипПриемника = "Сайт.Клиент";
ТипИсточника = "СправочникСсылка.Контрагенты";	
	
Если Не ДанныеЗаказа.Свойство("Сlient_ID") Тогда 
	
	ЕстьЗапись  = ЕстьЗапись(ДанныеЗаказа.Client_ID, ТипПриемника, ТипИсточника, Узел);
	
	Если ЕстьЗапись Тогда
	 Ссылка = ПолучитьОбъект(ДанныеЗаказа.Client_ID, ТипПриемника, ТипИсточника, Узел); 
	 СсылкаОбъект = Ссылка.ПолучитьОбъект();
	 	Если СсылкаОбъект = Неопределено Тогда 
			 УдалитьОбъект(ДанныеЗаказа.Client_ID, ТипПриемника, ТипИсточника, Узел); 
        	 Возврат НайтиСоздатьКОнтрагентаПоЗаказу(ДанныеЗаказа, Узел);
		 Иначе  
			 ЗаполнитьКлиентаПоЗаказу(СсылкаОбъект, ДанныеЗаказа, Узел);
			 Возврат Ссылка;
	 	КонецЕсли;   
		
	 Иначе
		Возврат НайтиСоздатьКОнтрагентаПоЗаказу(ДанныеЗаказа, Узел);
	 КонецЕсли;

	
 Иначе
	 Возврат НайтиСоздатьКОнтрагентаПоЗаказу(ДанныеЗаказа, Узел);	
КонецЕсли;	
 
КонецФункции   

Функция НайтиСоздатьКОнтрагентаПоЗаказу(ДанныеЗаказа, Узел)
	Если ДанныеЗаказа.Свойство("Doc_RecipientPhone") Тогда
		Если Не СокрЛП(ДанныеЗаказа.Doc_RecipientPhone) ="" Тогда
	
			КонтрагентСсылка = НайтиКонтрагентаПоТелефону(ДанныеЗаказа.Doc_RecipientPhone);
			
		КонецЕсли;	
	КонецЕсли;
	
	Если КонтрагентСсылка = Неопределено Тогда                      
		Если ДанныеЗаказа.Свойство("Doc_RecipientEmail") Тогда
			КонтрагентСсылка = НайтиКонтрагентаПоEmail(ДанныеЗаказа.Doc_RecipientEmail);
		КонецЕсли;
	КонецЕсли;           
	
	Если КонтрагентСсылка = Неопределено Тогда 
    	Контрагент = Справочники.Контрагенты.СоздатьЭлемент(); 
		Партнер = Справочники.Партнеры.СоздатьЭлемент();
	Иначе
		 Контрагент = КонтрагентСсылка.ПолучитьОбъект();  
		 Если Контрагент =Неопределено Тогда
			  Контрагент = Справочники.Контрагенты.СоздатьЭлемент(); 
			  Партнер = Справочники.Партнеры.СоздатьЭлемент();
		  Иначе
			  Партнер = Контрагент.Партнер;
		  КонецЕсли;	  
	КонецЕсли;
		 
	Партнер.Клиент = Истина;
	Партнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
	Партнер.Наименование = ДанныеЗаказа.Doc_Recipient;
	Партнер.НаименованиеПолное = ДанныеЗаказа.Doc_Recipient;
	Партнер.ОбменДанными.Загрузка =Истина; 
	Партнер.КонтактнаяИнформация.Очистить();
	
	Если ДанныеЗаказа.Свойство("Doc_RecipientPhone") Тогда
		Если Не СокрЛП(ДанныеЗаказа.Doc_RecipientPhone) =""  Тогда
			Контакт = Партнер.КонтактнаяИнформация.Добавить();
			Контакт.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Контакт.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
			Контакт.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
			Контакт.Представление = ДанныеЗаказа.Doc_RecipientPhone;
		  	Контакт.НомерТелефона = ДанныеЗаказа.Doc_RecipientPhone;
			ОбщегоНазначенияУТ.ЗаполнитьЗначенияПолейКИПоПредставлению(Контакт.Представление, Контакт.ЗначенияПолей, Контакт.Тип);
		КонецЕсли;  
	КонецЕсли;
	
	Если ДанныеЗаказа.Свойство("Doc_RecipientEmail") Тогда
		Если Не СокрЛП(ДанныеЗаказа.Doc_RecipientEmail) =""  Тогда
			Контакт = Партнер.КонтактнаяИнформация.Добавить();
			Контакт.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			Контакт.Вид = Справочники.ВидыКонтактнойИнформации.EmailПартнера;
			Контакт.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.EmailПартнера;
			Контакт.Представление = ДанныеЗаказа.Doc_RecipientEmail;
		  	Контакт.АдресЭП = ДанныеЗаказа.Doc_RecipientEmail;
			ОбщегоНазначенияУТ.ЗаполнитьЗначенияПолейКИПоПредставлению(Контакт.Представление, Контакт.ЗначенияПолей, Контакт.Тип);
		КонецЕсли;  
	КонецЕсли;
	
	Партнер.Записать();
	Контрагент.Партнер = Партнер.ссылка;
	
	ЗаполнитьКлиентаПоЗаказу(Контрагент, ДанныеЗаказа, Узел);
	Возврат Контрагент.Ссылка

