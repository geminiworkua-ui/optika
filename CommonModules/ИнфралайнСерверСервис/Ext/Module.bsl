				Ссылка.Номенклатура = АльтСсылка;	
			Иначе
				Ссылка.Номенклатура = Неопределено;
			КонецЕсли;	
		КонецЕсли;
	Иначе 
		Ссылка.Номенклатура = Неопределено;
	КонецЕсли;

	
	Врач = ОпределитьСсылку(Строка.Doctor,"ФизическиеЛица", Узел);
