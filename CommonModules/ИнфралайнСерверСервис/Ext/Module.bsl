			КлиентОб.Клиент = Истина;
			КлиентОб.Наименование = ДанныеЗаказа.ClientFIO;
			КлиентОб.ОсновнойНомер = НомерТелефона;
			Телефон = Клиентоб.КонтактнаяИнформация.Добавить();
