Процедура ПолучитьТовар(Товар, ТекСтрока, Результат =Неопределено)
		Узлы = Новый Массив;
		Узлы.Добавить(ОбменСайт.ПолучитьУзелСтаройБазы());
		Рез = ОбменСайт.ПолучитьУзлыОбменаСайт();
		
		Для каждого Узел из Рез Цикл
			Узлы.Добавить(Узел);
		КонецЦикла;
                                                                         
		ТекСтрока.Номенклатура = ОпределитьНоменклатуру(Товар.ID_Nom, Узлы, Результат);	
			
		Если Результат.Успех Тогда
			ПолучитьХарактеристику(Товар, ТекСтрока);
	    КонецЕсли;
		
КонецПроцедуры	

Функция ОпределитьНоменклатуру(ID, Узлы, Результат)
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника как Ссылка
|ИЗ
|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
|ГДЕ
|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы В(&Узлы)
|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника = &УИД");
Запрос.УстановитьПараметр("УИД", Строка(ID));                                                                                           
Запрос.УстановитьПараметр("Узлы",Узлы);
Рез = Запрос.Выполнить().Выбрать();
Если Рез.Следующий() Тогда 
	Результат = Новый Структура();
	Результат.Вставить("Успех", Истина);
  	Возврат Рез.ссылка;
Иначе 	
    Результат = Новый Структура();
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Описание", "Не найден Товар: "+ ID);
КонецЕсли;	

КонецФункции

Процедура ПолучитьХарактеристику(Товар, ТекСтрока) 
Если Не Товар.ID_Ser = Неопределено Тогда
		Возврат;
		Узлы = Новый Массив;
		Узлы.Добавить(ОбменСайт.ПолучитьУзелСтаройБазы());
		Рез = ОбменСайт.ПолучитьУзлыОбменаСайт();
		
		Для каждого Узел из Рез Цикл
			Узлы.Добавить(Узел);
		КонецЦикла;

				
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
		|ГДЕ
		|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы В(&Узлы)
		|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника = &УИД");
		Запрос.УстановитьПараметр("УИД", Строка(Товар.ID_Ser));                                                                                           
		Запрос.УстановитьПараметр("Узлы",Узлы);
		Результат = Запрос.Выполнить().Выгрузить();
		Если Не Результат.Количество()=0 Тогда	
			ТекСтрока.Характеристика = Результат[0].УникальныйИдентификаторИсточника;
			Возврат;
        КонецЕсли;
КонецЕсли;	
	
Если Не Товар.Свойство("PropertySet") Тогда
		Возврат;
КонецЕсли;		
	
МассивСвойств = ПолучитьНаборСвойств(Товар, ТекСтрока.Номенклатура);

Если МассивСвойств.количество() =0 Тогда
	Возврат;
КонецЕсли;

Запрос = Новый Запрос(
"ВЫБРАТЬ
|	ХарактеристикиНоменклатуры.Ссылка
|ИЗ
|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
|ГДЕ
|	ХарактеристикиНоменклатуры.Владелец = &Владелец ");
Запрос.УстановитьПараметр("Владелец", ТекСтрока.Номенклатура);		 
Для каждого ЗначениеСвойства из МассивСвойств Цикл
	
	Для каждого КлючИЗначение из ЗначениеСвойства Цикл
		Запрос.Текст = Запрос.Текст + " и " + " ХарактеристикиНоменклатуры." + КлючИЗначение.Ключ + " =&"+ КлючИЗначение.Ключ;
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецЦикла;	
Результат = Запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	ТекСтрока.Характеристика = Результат.ссылка;
	Возврат;
Иначе
	НовХар = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Для каждого ЗначениеСвойства из МассивСвойств Цикл
		
		Для каждого КлючИЗначение из ЗначениеСвойства Цикл
			НовХар[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			НовХар.Наименование = НовХар.Наименование +?(СтрДлина(НовХар.Наименование)=0,"", " ");
			
			Если 	  КлючИЗначение.Ключ ="_Сфера" 		Тогда НовХар.Наименование = НовХар.Наименование + "Сф.: " + КлючИЗначение.Значение;
			ИначеЕсли КлючИЗначение.Ключ ="_Аддідація"  Тогда НовХар.Наименование = НовХар.Наименование + "Ад.: " + КлючИЗначение.Значение;	
			ИначеЕсли КлючИЗначение.Ключ ="_Циліндр" 	Тогда НовХар.Наименование = НовХар.Наименование + "Ц.: "  + КлючИЗначение.Значение;		
			ИначеЕсли КлючИЗначение.Ключ ="_Диаметр" 	Тогда НовХар.Наименование = НовХар.Наименование + "Д.: "  + КлючИЗначение.Значение;			
			ИначеЕсли КлючИЗначение.Ключ ="_Радіус" 	Тогда НовХар.Наименование = НовХар.Наименование + "Рад.: "+ КлючИЗначение.Значение;				
			ИначеЕсли КлючИЗначение.Ключ ="_Вісь" 		Тогда НовХар.Наименование = НовХар.Наименование + "В.: "  + КлючИЗначение.Значение;					
			ИначеЕсли КлючИЗначение.Ключ ="_Дегресія"   Тогда НовХар.Наименование = НовХар.Наименование + "Дег: " + КлючИЗначение.Значение;						
			ИначеЕсли КлючИЗначение.Ключ ="_Цвет" 		Тогда НовХар.Наименование = НовХар.Наименование + "Цв.: " + КлючИЗначение.Значение;
			КонецЕсли;
		КонецЦикла;
		
		НовХар.Наименование =СокрЛП(НовХар.Наименование);

	КонецЦикла;	    
	НовХар.ОбменДанными.Загрузка = Истина;   
	
	Если ТекСтрока.Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры Тогда
		НовХар.Владелец = ТекСтрока.Номенклатура;
	ИначеЕсли ТекСтрока.Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры Тогда 	
		НовХар.Владелец = ТекСтрока.Номенклатура.ВидНоменклатуры;
	КонецЕсли;	
	
	НовХар.Записать();
	ТекСтрока.Характеристика = НовХар.Ссылка;
	Возврат;
КонецЕсли;	

КонецПроцедуры

Функция ПолучитьНаборСвойств(Товар, Номенклатура)
	
	Если Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивСвойств = новый Массив;
	
	Если Товар.PropertySet = Неопределено Тогда
		Возврат МассивСвойств;
	КонецЕсли;
	
	Для каждого Стр из Товар.PropertySet Цикл 
		Свойство = ПолучитьЗначениеДопСвойств(Стр);
		
		Для каждого КлючИзначение из Свойство Цикл
			Если КлючИзначение.Значение = Неопределено Тогда
				Продолжить;
			Конецесли;	
		      МассивСвойств.Добавить(Свойство);
		  КонецЦикла;	                               
	КонецЦикла;	  
	ВОзврат  МассивСвойств;
КонецФункции

