Функция ОбработатьДату(Строка)
	Год = Лев(Строка, 4);
	Месяц = Сред(Строка, 6, 2);
	День = Сред(Строка, 9, 2);
	Время = Прав(Строка, 8);
	Дата = Дата(День + "." + Месяц + "." + Год + " " + Время);
	Возврат Дата;
КонецФункции

Функция Забронировать(ТелоЗапроса, ОбъектСсылка, JSON, Узел) 

ТипПриемника = "Сайт.Бронирование";
ТипИсточника = "ДокументСсылка.БронированиеСпециалиста";
ОбъектСсылка = Неопределено;	
ДанныеБрони = ТелоЗапроса.Data;	
Для каждого Строка из ДанныеБрони Цикл		
	Врач = ОпределитьСсылку(Строка.Doctor, "ФизическиеЛица", Узел);
	
	Если Врач = Неопределено Тогда
		Результат = Новый Структура();
		Результат.Вставить("Успех", Ложь);
		Результат.Вставить("Описание", "Не найден доктор: "+Строка.Doctor);   
		ТелоОтвета = СформироватьОтветБронь(Результат, Строка);
        Возврат ВыполнитьОбработкуДанных(Результат, ОбъектСсылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);
	КонецЕсли;  
	
	МестоПриема = ОпределитьСсылку(Строка.Shop,"СтруктураПредприятия", Узел);
	
	Если МестоПриема = Неопределено Тогда
		Результат = Новый Структура();
		Результат.Вставить("Успех", Ложь);
		Результат.Вставить("Описание", "Не найден магазин: "+Строка.Shop);
		ТелоОтвета = СформироватьОтветБронь(Результат, Строка);
        Возврат ВыполнитьОбработкуДанных(Результат,ОбъектСсылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);
	КонецЕсли;

	Бронь = Документы.БронированиеСпециалиста.СоздатьДокумент(); 

	Бронь.Врач 			 = Врач;
	Бронь.МестоПриема 	 = МестоПриема;
	Бронь.Дата			 = ТекущаяДата();
	Бронь.ВремяНачала 	 = Строка.TimeStart; 
	Бронь.Должность = ОпределитьСсылку(Строка.Position, "Должности", Узел);
	Бронь.Услуга    = ОпределитьСсылку(Строка.Service, "Номенклатура", Узел);;
	
	Попытка
		Бронь.Записать(); 
		
		ЗарегистириоватьДанныеПоУзлу(Бронь.Ссылка, Бронь.Ссылка.УникальныйИдентификатор(), ТипПриемника, ТипИсточника, Узел);
		Результат = Новый Структура();
		Результат.Вставить("Успех", Истина);
		Результат.Вставить("Описание", "Завдання [Booking]");
        ТелоОтвета = СформироватьОтветБронь(Результат, Строка);
		ОбъектСсылка = Бронь.Ссылка; 
        Возврат ВыполнитьОбработкуДанных(Результат, Бронь.Ссылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);

	Исключение
		Результат = Новый Структура();
		Результат.Вставить("Успех", Ложь);
		Результат.Вставить("Описание", "Ошибка бронирования: "+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТелоОтвета = СформироватьОтветБронь(Результат, Строка);
        Возврат ВыполнитьОбработкуДанных(Результат, ОбъектСсылка, ТелоЗапроса,ТелоОтвета, JSON, Узел);
	КонецПопытки;   
КонецЦикла;	
КонецФункции

Функция ОпределитьСсылку(УИД,Справочник, Узел) 
	Если Не СокрЛП(УИД) ="" Тогда
		Ссылка =Справочники[Справочник].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка 
		Если Ссылка.ПолучитьОбъект() = Неопределено
			Тогда Возврат Неопределено; 
		Иначе Возврат Ссылка;	
		КонецЕсли;	
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции   

