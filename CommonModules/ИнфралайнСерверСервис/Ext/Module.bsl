		Иначе	
			Узлы = Новый Массив;
			Узлы.Добавить(ОбменСайт.ПолучитьУзелСтаройБазы());
			АльтСсылка = ОпределитьНоменклатуру(Строка.Service, Узлы, Неопределено);
