Функция РезультатПроверкиОстаткаБонусов(ТелоЗапроса, Узел)
	
	Если ТелоЗапроса.Свойство("Data") Тогда
		Мрез = НОвый массив;
		Для каждого Запись из ТелоЗапроса.Data цикл
			ИсхНомер = Запись.Client_ID;
			НормализованныйНомер = строка(ИнфралайнКлиентСервер.НормализованныйНомерТелефона(ИсхНОмер));
			ЕстьОшибка = Ложь;
			Результат = "Задание GetClientBonuses";    
			П = Новый Структура;
			
			// проверим, что номер по стандарту
			Если НормализованныйНомер = "" Тогда
				ЕстьОшибка = Истина;
				Результат = "Номер не соответствует формату";
			КонецЕсли;
			
			// проверим, что такой клиент в принципе есть
			Если Не ЕстьОшибка тогда
				Запрос = Новый Запрос("ВЫБРАТЬ
				|	Партнеры.Ссылка
				|ИЗ
				|	Справочник.Партнеры КАК Партнеры
				|ГДЕ
				|	Партнеры.ОсновнойНомер = &ОсновнойНомер");
				Запрос.УстановитьПараметр("ОсновнойНомер", НормализованныйНомер);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() тогда
					Результат = "Клиент найден"; 
				Иначе
					ЕстьОшибка = Истина;
					Результат = "Клиент не найден";
				//	П.Вставить("Bonus_Balance",0); 

				КонецЕсли; 
			Конецесли;
			
			П.Вставить("Result", Не ЕстьОшибка);
			П.Вставить("Description", Результат);
			П.Вставить("Client_ID",Запись.Client_ID);
			П.Вставить("Client_ID_full", НормализованныйНомер);
			
			Если Не ЕстьОшибка Тогда
				П.Вставить("Bonus_Balance",0); 
				Дата = Текущаядата();
				//	ПользовательНайден = Ложь;
				ОстатокБаллов = 0;
				Запрос = Новый Запрос("ВЫБРАТЬ
				|	ЕСТЬNULL(БонусныеБаллыОстатки.НачисленоОстаток, 0) - ЕСТЬNULL(БонусныеБаллыОстатки.КСписаниюОстаток, 0) КАК СуммаБаллов
				|ИЗ
				|	РегистрНакопления.БонусныеБаллы.Остатки(&Дата, Партнер.ОсновнойНомер = &ОсновнойНОмер) КАК БонусныеБаллыОстатки
				|
				|СГРУППИРОВАТЬ ПО
				|	ЕСТЬNULL(БонусныеБаллыОстатки.НачисленоОстаток, 0) - ЕСТЬNULL(БонусныеБаллыОстатки.КСписаниюОстаток, 0)");
				Запрос.УстановитьПараметр("ОсновнойНомер", НормализованныйНомер);
				Запрос.УстановитьПараметр("Дата", Дата);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					П.Вставить("Bonus_Balance",Выборка.СуммаБаллов); 
				Иначе
					П.Вставить("Bonus_Balance",0); 
				КонецЕсли;
			КонецЕсли;
			
			//	П = Новый Структура;
			//П.Вставить("Data", Мрез);
			
			Если ЕстьОшибка тогда
				П.Вставить("Bonus_Balance",0); 
			КонецЕсли;
			
			мРез.Добавить(П);
			
		КонецЦикла;
		
		ППП = Новый Структура;
		ППП.Вставить("Result", Истина);
        ППП.Вставить("Data",  мРез);
		ППП.Вставить("Успех", Истина);
		
		ЗаписатьЛог(ТелоЗапроса.Task, ППП, Неопределено, СформироватьJSON(ТелоЗапроса), СформироватьJSON(ППП), Узел.Сайт);
		
		Возврат ППП; 
	КонецЕсли;
	
КонецФункции	

