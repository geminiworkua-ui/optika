Функция СформироватьОтветЗапись(Результат, Строка, Ссылка = Неопределено)    

	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("Result", Результат.Успех);
	СтруктураОтвета.Вставить("Description", Результат.Описание); 
	Если Ссылка = Неопределено
		И НЕ Строка = Неопределено
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Строка, "ID")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Строка, "Client_ID")
		Тогда
		Данные = Новый Структура;
		Данные.Вставить("ID"		, ?(ссылка = Неопределено, Строка.ID 		, 	Строка(Ссылка.УникальныйИдентификатор() 		)));
		Данные.Вставить("Client_ID"	, ?(ссылка = Неопределено, Строка.Client_ID	,	Строка(Ссылка.Клиент.УникальныйИдентификатор()	)));
		СтруктураОтвета.Вставить("Data", Данные);
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
