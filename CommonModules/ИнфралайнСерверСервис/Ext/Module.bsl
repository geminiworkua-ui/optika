Функция ЗаполнитьПартнера(ДанныеКлиента, Узел)
ТипПриемника = "Сайт.Клиент";
ТипИсточника = "СправочникСсылка.Партнеры";     

УИД =ДанныеКлиента.Client_ID;   
Если Не СокрЛП(УИД)="" Тогда
	ЕстьЗапись = ЕстьЗапись(ДанныеКлиента.Client_ID, ТипПриемника, ТипИсточника, Узел);
	Если ЕстьЗапись Тогда  
		Ссылка = ПолучитьОбъект(ДанныеКлиента.Client_ID, ТипПриемника, ТипИсточника, Узел); 
		СсылкаОбъект = Ссылка.ПолучитьОбъект();
		Если Не СсылкаОбъект = Неопределено Тогда
			Возврат Ссылка;
		Иначе
			УдалитьОбъект(ДанныеКлиента.Client_ID, ТипПриемника, ТипИсточника, Узел);
		КонецЕсли;
	КонецЕсли;	     
КонецЕсли;	

Партнер = Справочники.Партнеры.СоздатьЭлемент();
Партнер.Клиент = Истина;
Партнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
Если ДанныеКлиента.свойство("Doc_Recipient") Тогда
	Партнер.Наименование = ДанныеКлиента.Doc_Recipient;
	Партнер.НаименованиеПолное = ДанныеКлиента.Doc_Recipient;
ИначеЕсли ДанныеКлиента.свойство("Client_Name") Тогда
    Партнер.Наименование = ДанныеКлиента.Client_Name;
	Партнер.НаименованиеПолное = ДанныеКлиента.Client_Name;
КонецЕсли;

Если ДанныеКлиента.свойство("Client_EMail") Тогда
	Если Не СокрЛП(ДанныеКлиента.Client_EMail) ="" Тогда
		КИ = Партнер.КонтактнаяИнформация.Добавить();
		КИ.АдресЭП =  СокрЛП(ДанныеКлиента.Client_EMail);
		КИ.Тип=  Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailПартнера;
		КИ.Представление = СокрЛП(ДанныеКлиента.Client_EMail);  
		КИ.ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(КИ.Представление,КИ.Вид);
	КонецЕсли;	
КонецЕсли;

Если ДанныеКлиента.свойство("Client_Phone") Тогда
	Если Не СокрЛП(ДанныеКлиента.Client_Phone) ="" Тогда
		КИ = Партнер.КонтактнаяИнформация.Добавить();
		КИ.НомерТелефона =  СокрЛП(ДанныеКлиента.Client_Phone);
		КИ.Тип=  Перечисления.ТипыКонтактнойИнформации.Телефон;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
		КИ.Представление = СокрЛП(ДанныеКлиента.Client_Phone);  
		КИ.ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(КИ.Представление,КИ.Вид);
	КонецЕсли;
КонецЕсли;	


Если ДанныеКлиента.свойство("Client_City") Тогда
	Если Не СокрЛП(ДанныеКлиента.Client_City + ДанныеКлиента.Client_Region + ДанныеКлиента.Client_Street + ДанныеКлиента.Client_Ap) ="" Тогда
	
		КИ = Партнер.КонтактнаяИнформация.Добавить();
		КИ.Город =  СокрЛП(ДанныеКлиента.Client_City);
		КИ.Тип=  Перечисления.ТипыКонтактнойИнформации.Адрес;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресПартнера; 
		
		КИ.Регион = СокрЛП(ДанныеКлиента.Client_Region);
		КИ.
		КИ.Представление = СокрЛП(ДанныеКлиента.Client_City) +", "+ СокрЛП(ДанныеКлиента.Client_Region)  +", " +
						   СокрЛП(ДанныеКлиента.Client_Street) +", " +  СокрЛП(ДанныеКлиента.Client_Ap);  
		КИ.ЗначенияПолей = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияXMLПоПредставлению(КИ.Представление,КИ.Вид);
	КонецЕсли;	
КонецЕсли;
       

Партнер.ОбменДанными.Загрузка =Истина;
Партнер.Записать();    
Если Не СокрЛП(УИД)="" Тогда
   УИД = Партнер.Ссылка.УникальныйИдентификатор();
КонецЕсли;   
ЗарегистириоватьДанныеПоУзлу(Партнер.Ссылка, УИД, ТипПриемника, ТипИсточника, Узел);

Возврат Партнер.Ссылка;

