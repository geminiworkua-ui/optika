Функция РезультатРасшифровкиСерий(ТелоЗапроса, Узел)
	
	мРез = Новый Массив;	
	Если ТелоЗапроса.Свойство("Data") И ТелоЗапроса.Data.Количество() > 0 тогда
		
		Для Каждого Запись Из ТелоЗапроса.Data Цикл
			Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Запись.ID_Ser));
			Если Не Характеристика = Неопределено Тогда
				П = новый Структура("ID, ID_Ser, IDSname");
				П.ID_Ser = Запись.ID_Ser;
				П.ID = Строка(Характеристика.Владелец.УникальныйИдентификатор());
				П.IDSname = Характеристика.НаименованиеПолное; 
				
				Если ЗначениеЗаполнено(Характеристика.Владелец) 
					И ЗначениеЗаполнено(Характеристика.Владелец.СвойстваОбъектовНабор)
					Тогда
					мСвойств = новый Массив;
					Для каждого типХаракт из  Характеристика.Владелец.СвойстваОбъектовНабор.Состав цикл
						ПП = Новый Структура("ID_Pro, Name_UA", 
						Строка(ИнфралайнОбмен.ПолучитьУИД_ПоИмениСвойста(Строка(типХаракт.Свойство))),
						Строка(Характеристика[Строка(типХаракт.Свойство)]));
						мСвойств.Добавить(ПП);							
					КонецЦикла; 
					п.Вставить("Attributes", мСвойств);
				КонецЕсли;
				мРез.Добавить(П);
			КонецЕсли;
		КонецЦикла;	
		
	Иначе
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ХарактеристикиНоменклатуры.Ссылка,
		                      |	ХарактеристикиНоменклатуры.Владелец КАК Владелец,
		                      |	ХарактеристикиНоменклатуры.НаименованиеПолное
		                      |ИЗ
		                      |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		                      |ГДЕ
		                      |	НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
		                      |	И ХарактеристикиНоменклатуры.Владелец.РазрешенОбменСайт
		                      |	И ХарактеристикиНоменклатуры.Владелец.СайтLuxor");
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			П = новый Структура("ID, ID_Ser, IDSname");
			П.ID_Ser = Строка(Выборка.Ссылка.УникальныйИдентификатор());
			П.ID = Строка(Выборка.Владелец.УникальныйИдентификатор());
			П.IDSname = Выборка.НаименованиеПолное; 
			
			Если ЗначениеЗаполнено(Выборка.Владелец.СвойстваОбъектовНабор)
				Тогда
				мСвойств = новый Массив;
				Для каждого типХаракт из  Выборка.Владелец.СвойстваОбъектовНабор.Состав цикл
					ПП = Новый Структура("ID_Pro, Name_UA", 
					Строка(ИнфралайнОбмен.ПолучитьУИД_ПоИмениСвойста(Строка(типХаракт.Свойство))),
					Строка(Выборка.Ссылка[Строка(типХаракт.Свойство)]));
					мСвойств.Добавить(ПП);							
				КонецЦикла; 
				п.Вставить("Attributes", мСвойств);
			КонецЕсли;
			мРез.Добавить(П);
		КонецЦикла;
	КонецЕсли;	
	
	ППП = Новый Структура;
	ППП.Вставить("Result", Истина);
	ППП.Вставить("Data",  мРез);
	ППП.Вставить("Успех", Истина);
	
	ЗаписатьЛог(ТелоЗапроса.Task, ППП, Неопределено, СформироватьJSON(ТелоЗапроса), СформироватьJSON(ППП), Узел.Сайт);
	
	Возврат ППП;


