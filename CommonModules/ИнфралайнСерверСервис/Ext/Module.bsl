Функция ПолучитьПартнера(ДанныеЗаказа, Узел)
ТипПриемника = "Сайт.Клиент";
ТипИсточника = "СправочникСсылка.Партнеры";     

УИД =ДанныеЗаказа.Client_ID;  
Если Не СокрЛП(УИД)="" Тогда
	ЕстьЗапись = ЕстьЗапись(ДанныеЗаказа.Client_ID, ТипПриемника, ТипИсточника, Узел);
	Если ЕстьЗапись Тогда  
		Ссылка = ПолучитьОбъект(ДанныеЗаказа.Client_ID, ТипПриемника, ТипИсточника, Узел); 
		СсылкаОбъект = Ссылка.ПолучитьОбъект();
		Если Не СсылкаОбъект = Неопределено Тогда
			Возврат Ссылка;
		Иначе
			УдалитьОбъект(ДанныеЗаказа.Client_ID, ТипПриемника, ТипИсточника, Узел);
		КонецЕсли;
	КонецЕсли;	     
КонецЕсли;	
Партнер = Справочники.Партнеры.СоздатьЭлемент();
Партнер.Клиент = Истина;
Партнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
Партнер.Наименование = ДанныеЗаказа.Doc_Recipient;
Партнер.НаименованиеПолное = ДанныеЗаказа.Doc_Recipient;
Партнер.ОбменДанными.Загрузка =Истина;
Партнер.Записать();    
Если СокрЛП(УИД)="" Тогда
   УИД = Партнер.Ссылка.УникальныйИдентификатор();
КонецЕсли; 

Попытка
ЗарегистириоватьДанныеПоУзлу(Партнер.Ссылка, УИД, ТипПриемника, ТипИсточника, Узел);
Исключение

КонецПопытки;	
Возврат Партнер.Ссылка;
