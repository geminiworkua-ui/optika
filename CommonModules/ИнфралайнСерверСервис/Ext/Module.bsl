Функция ЗаполнитьЗапись(Ссылка, ТелоЗапроса , Узел)
	///////////////////////////////////  
	
	ДанныеЗаказа = ТелоЗапроса;  
	Строка = ТелоЗапроса; 
	
	ВремяНачала = ОбработатьДату(ДанныеЗаказа.TimeStart);
	
	
