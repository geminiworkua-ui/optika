// Общий модуль tsms_Журнал. Свойства: Сервер = Истина, Вызов сервера = Ложь, Привилегированный = Истина.
// Журнал сообщений TurboSMS: запись отправок, статусы, клики, кандидаты на SMS-эскалацию.

#Область ПрограммныйИнтерфейс

// Возвращает message_id первого получателя из ответа message/send.
Функция ИДСообщенияИзОтвета(Ответ) Экспорт
	
	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	
	Результаты = Ответ.Получить("response_result");
	Если ТипЗнч(Результаты) = Тип("Массив") И Результаты.Количество() > 0
		И ТипЗнч(Результаты[0]) = Тип("Соответствие") Тогда
		Возврат СокрЛП(Строка(Результаты[0].Получить("message_id")));
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Записывает отправленное сообщение в РС tsms_ЖурналСообщений.
// Данные - Структура с именами ресурсов регистра; обязателен ИДСообщения.
Процедура ЗаписатьСообщение(Данные) Экспорт
	
	Если Не Данные.Свойство("ИДСообщения") Или Не ЗначениеЗаполнено(Данные.ИДСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		МЗ = РегистрыСведений.tsms_ЖурналСообщений.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Данные);
		
		Если Не ЗначениеЗаполнено(МЗ.ДатаОтправки) Тогда
			МЗ.ДатаОтправки = ТекущаяДатаСеанса();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(МЗ.СпособОтправки) Тогда
			МЗ.СпособОтправки = Перечисления.tsms_СпособыОтправки.Регламентная;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(МЗ.ТипСообщения) Тогда
			МЗ.ТипСообщения = Перечисления.tsms_ТипыViberСообщений.Обычное;
		КонецЕсли;
		МЗ.Статус = Перечисления.tsms_СтатусыСообщений.Отправлено;
		
		МЗ.Записать();
		
	Исключение
		
		Контекст = Новый Структура("Подробности", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОшибкаЗаписиЖурнала,
			СтрШаблон("Повідомлення %1 відправлено, але не записано в журнал", Данные.ИДСообщения), Контекст);
		
	КонецПопытки;
	
КонецПроцедуры

// Запрашивает в TurboSMS статусы сообщений, которые ещё могут измениться,
// и клики по карточкам каруселей. Возвращает количество обновлённых записей.
Функция ОбновитьСтатусы(ГлубинаДней = 14) Экспорт
	
	Статусы = Перечисления.tsms_СтатусыСообщений;
	Граница = НачалоДня(ТекущаяДатаСеанса()) - ГлубинаДней * 86400;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Журнал.ИДСообщения КАК ИДСообщения
		|ИЗ
		|	РегистрСведений.tsms_ЖурналСообщений КАК Журнал
		|ГДЕ
		|	Журнал.ДатаОтправки >= &Граница
		|	И (Журнал.Статус В (&НезавершенныеСтатусы)
		|			ИЛИ Журнал.Статус = &СтатусПрочитано
		|				И Журнал.ОтслеживатьКлики
		|				И Журнал.ТипСообщения <> &ТипКарусель
		|				И Журнал.ДатаКлика = ДАТАВРЕМЯ(1, 1, 1))";
	
	Незавершенные = Новый Массив;
	Незавершенные.Добавить(Статусы.Отправлено);
	Незавершенные.Добавить(Статусы.Доставлено);
	Незавершенные.Добавить(Статусы.Неизвестно);
	
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("НезавершенныеСтатусы", Незавершенные);
	Запрос.УстановитьПараметр("СтатусПрочитано", Статусы.Прочитано);
	Запрос.УстановитьПараметр("ТипКарусель", Перечисления.tsms_ТипыViberСообщений.Карусель);
	
	ВсеИД = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИДСообщения");
	Обновлено = ОбновитьСтатусыПоСписку(ВсеИД);
	
	// Клики по карточкам каруселей - отдельным методом message/details
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Журнал.ИДСообщения КАК ИДСообщения
		|ИЗ
		|	РегистрСведений.tsms_ЖурналСообщений КАК Журнал
		|ГДЕ
		|	Журнал.ДатаОтправки >= &Граница
		|	И Журнал.ТипСообщения = &ТипКарусель
		|	И Журнал.Статус В(&ДоставленныеСтатусы)";
	
	Доставленные = Новый Массив;
	Доставленные.Добавить(Статусы.Доставлено);
	Доставленные.Добавить(Статусы.Прочитано);
	
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("ТипКарусель", Перечисления.tsms_ТипыViberСообщений.Карусель);
	Запрос.УстановитьПараметр("ДоставленныеСтатусы", Доставленные);
	
	ИДКаруселей = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИДСообщения");
	Если ИДКаруселей.Количество() > 0 Тогда
		ОбновитьКликиКаруселей(ИДКаруселей);
	КонецЕсли;
	
	Если ВсеИД.Количество() > 0 Тогда
		tsms_Логирование.Информация(Перечисления.tsms_СобытияЛогирования.ОбновлениеСтатусов,
			СтрШаблон("Оновлення статусів: запитано %1, оновлено %2", ВсеИД.Количество(), Обновлено));
	КонецЕсли;
	
	Возврат Обновлено;
	
КонецФункции

// Запрашивает статусы по массиву message_id. Возвращает количество обновлённых записей.
Функция ОбновитьСтатусыПоСписку(ВсеИД) Экспорт
	
	Обновлено = 0;
	
	Для Каждого Пачка Из РазбитьНаПачки(ВсеИД, 100) Цикл
		
		Попытка
			
			Элементы = ВызватьМетодTurboSMS("message/status.json", Пачка);
			Для Каждого Элемент Из Элементы Цикл
				Если ТипЗнч(Элемент) = Тип("Соответствие") И ПрименитьСтатус(Элемент) Тогда
					Обновлено = Обновлено + 1;
				КонецЕсли;
			КонецЦикла;
			
		Исключение
			
			Контекст = Новый Структура("Подробности", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОбновлениеСтатусов,
				"Помилка оновлення статусів повідомлень", Контекст);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Обновлено;
	
КонецФункции

// Сообщения, по которым пора отправить SMS:
//  - эскалация: Viber доставлен, не прочитан N дней, клиент после отправки ничего не купил;
//  - резервная SMS: Viber (карусель) не доставлен, а SMS гибридом не уходила.
// Возвращает таблицу: ИДСообщения, Партнер, НомерТелефона, ВидОповещения, ДатаОтправки, Текст, ЭтоЭскалация.
Функция КандидатыНаСМС(ТолькоРезервные = Ложь) Экспорт
	
	Статусы = Перечисления.tsms_СтатусыСообщений;
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Журнал.ИДСообщения КАК ИДСообщения,
		|	Журнал.Партнер КАК Партнер,
		|	Журнал.НомерТелефона КАК НомерТелефона,
		|	Журнал.ВидОповещения КАК ВидОповещения,
		|	Журнал.ДатаОтправки КАК ДатаОтправки,
		|	Журнал.ТекстСМСЭскалации КАК Текст,
		|	ИСТИНА КАК ЭтоЭскалация
		|ПОМЕСТИТЬ ВТ_Кандидаты
		|ИЗ
		|	РегистрСведений.tsms_ЖурналСообщений КАК Журнал
		|ГДЕ
		|	НЕ &ТолькоРезервные
		|	И Журнал.ДатаОтправки >= &Граница
		|	И НЕ Журнал.ЭскалацияВыполнена
		|	И Журнал.ЭскалироватьЧерезДней > 0
		|	И Журнал.КаналПлановый = &КаналViber
		|	И Журнал.КаналФактический <> &КаналSMS
		|	И Журнал.Статус = &СтатусДоставлено
		|	И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(Журнал.ДатаОтправки, ДЕНЬ), &Сегодня, ДЕНЬ) МЕЖДУ Журнал.ЭскалироватьЧерезДней И Журнал.ЭскалироватьЧерезДней + 2
		|	И (Журнал.ДатаСобытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ Журнал.ДатаСобытия >= &Сегодня)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Журнал.ИДСообщения,
		|	Журнал.Партнер,
		|	Журнал.НомерТелефона,
		|	Журнал.ВидОповещения,
		|	Журнал.ДатаОтправки,
		|	Журнал.ТекстСМС,
		|	ЛОЖЬ
		|ИЗ
		|	РегистрСведений.tsms_ЖурналСообщений КАК Журнал
		|ГДЕ
		|	Журнал.ДатаОтправки >= &ГраницаРезервных
		|	И Журнал.РезервнаяСМС
		|	И НЕ Журнал.ЭскалацияВыполнена
		|	И Журнал.Статус В(&СтатусыНеудачи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Кандидаты.ИДСообщения КАК ИДСообщения
		|ПОМЕСТИТЬ ВТ_СПокупкой
		|ИЗ
		|	ВТ_Кандидаты КАК Кандидаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Продажи
		|		ПО (Продажи.АналитикаУчетаПоПартнерам.Партнер = Кандидаты.Партнер)
		|			И (Продажи.Период > Кандидаты.ДатаОтправки)
		|			И (Продажи.Количество > 0)
		|ГДЕ
		|	Кандидаты.ЭтоЭскалация
		|	И Кандидаты.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
		|	И Продажи.Период >= &Граница
		|
		|СГРУППИРОВАТЬ ПО
		|	Кандидаты.ИДСообщения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Кандидаты.ИДСообщения КАК ИДСообщения,
		|	Кандидаты.Партнер КАК Партнер,
		|	Кандидаты.НомерТелефона КАК НомерТелефона,
		|	Кандидаты.ВидОповещения КАК ВидОповещения,
		|	Кандидаты.ДатаОтправки КАК ДатаОтправки,
		|	Кандидаты.Текст КАК Текст,
		|	Кандидаты.ЭтоЭскалация КАК ЭтоЭскалация
		|ИЗ
		|	ВТ_Кандидаты КАК Кандидаты
		|ГДЕ
		|	НЕ Кандидаты.ИДСообщения В
		|				(ВЫБРАТЬ
		|					ВТ_СПокупкой.ИДСообщения
		|				ИЗ
		|					ВТ_СПокупкой КАК ВТ_СПокупкой)";
	
	СтатусыНеудачи = Новый Массив;
	СтатусыНеудачи.Добавить(Статусы.Недоставлено);
	СтатусыНеудачи.Добавить(Статусы.Отклонено);
	
	Запрос.УстановитьПараметр("ТолькоРезервные", ТолькоРезервные);
	Запрос.УстановитьПараметр("Сегодня", Сегодня);
	Запрос.УстановитьПараметр("Граница", Сегодня - 30 * 86400);
	Запрос.УстановитьПараметр("ГраницаРезервных", Сегодня - 3 * 86400);
	Запрос.УстановитьПараметр("КаналViber", Перечисления.tsms_КаналыОтправки.Viber);
	Запрос.УстановитьПараметр("КаналSMS", Перечисления.tsms_КаналыОтправки.SMS);
	Запрос.УстановитьПараметр("СтатусДоставлено", Статусы.Доставлено);
	Запрос.УстановитьПараметр("СтатусыНеудачи", СтатусыНеудачи);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Отмечает исходное сообщение как эскалированное и записывает SMS в журнал
// (клиент, вид оповещения, ручная рассылка копируются из исходной записи).
Процедура ЗаписатьСМСПоИсходному(ИДИсходного, ИДНового, ТекстСМС, ЭтоЭскалация = Истина) Экспорт
	
	Попытка
		
		Исходная = РегистрыСведений.tsms_ЖурналСообщений.СоздатьМенеджерЗаписи();
		Исходная.ИДСообщения = ИДИсходного;
		Исходная.Прочитать();
		Если Не Исходная.Выбран() Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИДНового) Тогда
			
			Новая = РегистрыСведений.tsms_ЖурналСообщений.СоздатьМенеджерЗаписи();
			НеКопировать = "ИДСообщения, ДатаОтправки, Статус, СтатусTurboSMS, ПричинаОтклонения, ДатаДоставки, "
				+ "ДатаПрочтения, ДатаКлика, ДатаОбновленияСтатуса, ОтслеживатьКлики, ЭскалацияВыполнена, "
				+ "ИДСообщенияЭскалации, ИДИсходногоСообщения, ЭскалироватьЧерезДней, ТекстViber, ТекстСМС, "
				+ "ТекстСМСЭскалации, КаналПлановый, КаналФактический, ТипСообщения, СпособОтправки, "
				+ "РезервнаяСМС, ДатаСобытия, Пользователь";
			ЗаполнитьЗначенияСвойств(Новая, Исходная, , НеКопировать);
			
			Новая.ИДСообщения          = ИДНового;
			Новая.ДатаОтправки         = ТекущаяДатаСеанса();
			Новая.ИДИсходногоСообщения = ИДИсходного;
			Новая.ТекстСМС             = ТекстСМС;
			Новая.КаналПлановый        = Перечисления.tsms_КаналыОтправки.SMS;
			Новая.ТипСообщения         = Перечисления.tsms_ТипыViberСообщений.Обычное;
			Новая.Статус               = Перечисления.tsms_СтатусыСообщений.Отправлено;
			// Резервная SMS - часть исходной отправки, эскалация - отдельный способ
			Новая.СпособОтправки       = ?(ЭтоЭскалация,
				Перечисления.tsms_СпособыОтправки.Эскалация, Исходная.СпособОтправки);
			Новая.Записать();
			
		КонецЕсли;
		
		Исходная.ЭскалацияВыполнена   = Истина;
		Исходная.ИДСообщенияЭскалации = ИДНового;
		Исходная.Записать();
		
	Исключение
		
		Контекст = Новый Структура("Подробности", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОшибкаЗаписиЖурнала,
			СтрШаблон("SMS по повідомленню %1 відправлено, але не записано в журнал", ИДИсходного), Контекст);
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// POST {"messages": [...]} на указанный метод. Возвращает массив response_result.
Функция ВызватьМетодTurboSMS(АдресРесурса, МассивИД)
	
	Соединение = Новый HTTPСоединение("api.turbosms.ua",,,,, 30, Новый ЗащищенноеСоединениеOpenSSL);
	
	Результат = ИнтеграцияСТурбоСМС.ВызватьHTTPМетодНаСервере("POST", Соединение,
		АдресРесурса, Новый Структура("messages", МассивИД));
	
	Ответ = Неопределено;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("ОтветСервера", Ответ);
	КонецЕсли;
	
	Элементы = ?(ТипЗнч(Ответ) = Тип("Соответствие"), Ответ.Получить("response_result"), Неопределено);
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		ВызватьИсключение СтрШаблон("Некоректна відповідь %1", АдресРесурса);
	КонецЕсли;
	
	Возврат Элементы;
	
КонецФункции

Функция РазбитьНаПачки(Массив, РазмерПачки)
	
	Пачки = Новый Массив;
	Пачка = Новый Массив;
	
	Для Каждого Элемент Из Массив Цикл
		Пачка.Добавить(Элемент);
		Если Пачка.Количество() = РазмерПачки Тогда
			Пачки.Добавить(Пачка);
			Пачка = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	
	Если Пачка.Количество() > 0 Тогда
		Пачки.Добавить(Пачка);
	КонецЕсли;
	
	Возврат Пачки;
	
КонецФункции

Функция ПрименитьСтатус(Элемент)
	
	ИД        = СокрЛП(Строка(Элемент.Получить("message_id")));
	СтатусAPI = СокрЛП(Строка(Элемент.Получить("status")));
	
	Если ИД = "" Или СтатусAPI = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МЗ = РегистрыСведений.tsms_ЖурналСообщений.СоздатьМенеджерЗаписи();
	МЗ.ИДСообщения = ИД;
	МЗ.Прочитать();
	Если Не МЗ.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Статусы = Перечисления.tsms_СтатусыСообщений;
	
	ДатаСобытия = ДатаИзСтроки(Элемент.Получить("updated"));
	Если Не ЗначениеЗаполнено(ДатаСобытия) Тогда
		ДатаСобытия = ТекущаяДатаСеанса();
	КонецЕсли;
	ДатаКлика = ДатаИзСтроки(Элемент.Получить("click_time"));
	
	НовыйСтатус = СтатусПоAPI(СтатусAPI);
	
	// Клик означает, что сообщение прочитано
	Если ЗначениеЗаполнено(ДатаКлика) Тогда
		МЗ.ДатаКлика = ДатаКлика;
		НовыйСтатус  = Статусы.Прочитано;
	КонецЕсли;
	
	// Не понижаем уже зафиксированное прочтение
	Если МЗ.Статус = Статусы.Прочитано И НовыйСтатус = Статусы.Доставлено Тогда
		НовыйСтатус = Статусы.Прочитано;
	КонецЕсли;
	
	Если (НовыйСтатус = Статусы.Доставлено Или НовыйСтатус = Статусы.Прочитано)
		И Не ЗначениеЗаполнено(МЗ.ДатаДоставки) Тогда
		МЗ.ДатаДоставки = ДатаСобытия;
	КонецЕсли;
	
	Если НовыйСтатус = Статусы.Прочитано И Не ЗначениеЗаполнено(МЗ.ДатаПрочтения) Тогда
		МЗ.ДатаПрочтения = ?(ЗначениеЗаполнено(ДатаКлика), ДатаКлика, ДатаСобытия);
	КонецЕсли;
	
	КаналAPI = НРег(СокрЛП(Строка(Элемент.Получить("channel"))));
	Если КаналAPI = "viber" Тогда
		МЗ.КаналФактический = Перечисления.tsms_КаналыОтправки.Viber;
	ИначеЕсли КаналAPI = "sms" Тогда
		МЗ.КаналФактический = Перечисления.tsms_КаналыОтправки.SMS;
	КонецЕсли;
	
	МЗ.Статус                = НовыйСтатус;
	МЗ.СтатусTurboSMS        = Лев(СтатусAPI, 30);
	МЗ.ПричинаОтклонения     = Лев(СокрЛП(Строка(Элемент.Получить("rejected_status"))), 50);
	МЗ.ДатаОбновленияСтатуса = ТекущаяДатаСеанса();
	МЗ.Записать();
	
	Возврат Истина;
	
КонецФункции

// Читает message/details по каруселям и сохраняет клики по карточкам в РС tsms_КликиКарусели.
Процедура ОбновитьКликиКаруселей(ИДКаруселей)
	
	Для Каждого Пачка Из РазбитьНаПачки(ИДКаруселей, 50) Цикл
		
		Попытка
			
			Элементы = ВызватьМетодTurboSMS("message/details.json", Пачка);
			Для Каждого Элемент Из Элементы Цикл
				Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
					ПрименитьКликиКарусели(Элемент);
				КонецЕсли;
			КонецЦикла;
			
		Исключение
			
			Контекст = Новый Структура("Подробности", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОбновлениеСтатусов,
				"Помилка оновлення кліків каруселі", Контекст);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрименитьКликиКарусели(Элемент)
	
	ИД        = СокрЛП(Строка(Элемент.Получить("message_id")));
	БлокViber = Элемент.Получить("viber");
	
	Если ИД = "" Или ТипЗнч(БлокViber) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	Карточки = БлокViber.Получить("carousel");
	Если ТипЗнч(Карточки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Набор = РегистрыСведений.tsms_КликиКарусели.СоздатьНаборЗаписей();
	Набор.Отбор.ИДСообщения.Установить(ИД);
	
	ВсегоКликов = 0;
	Номер = 0;
	Для Каждого Карточка Из Карточки Цикл
		
		Номер = Номер + 1;
		Если ТипЗнч(Карточка) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = Набор.Добавить();
		Запись.ИДСообщения   = ИД;
		Запись.НомерКарточки = Номер;
		Запись.Заголовок     = Лев(Строка(Карточка.Получить("title")), 38);
		Запись.КликовКнопки  = ВЧисло(Карточка.Получить("button_clicks"));
		Запись.КликовСсылки  = ВЧисло(Карточка.Получить("link_clicks"));
		
		ВсегоКликов = ВсегоКликов + Запись.КликовКнопки + Запись.КликовСсылки;
		
	КонецЦикла;
	
	Набор.Записать();
	
	// Клик по карточке = сообщение прочитано
	Если ВсегоКликов > 0 Тогда
		МЗ = РегистрыСведений.tsms_ЖурналСообщений.СоздатьМенеджерЗаписи();
		МЗ.ИДСообщения = ИД;
		МЗ.Прочитать();
		Если МЗ.Выбран() И Не ЗначениеЗаполнено(МЗ.ДатаКлика) Тогда
			МЗ.ДатаКлика = ТекущаяДатаСеанса();
			МЗ.Статус    = Перечисления.tsms_СтатусыСообщений.Прочитано;
			Если Не ЗначениеЗаполнено(МЗ.ДатаПрочтения) Тогда
				МЗ.ДатаПрочтения = МЗ.ДатаКлика;
			КонецЕсли;
			МЗ.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция СтатусПоAPI(СтатусAPI)
	
	Статусы = Перечисления.tsms_СтатусыСообщений;
	
	Если СтатусAPI = "Delivered" Тогда
		Возврат Статусы.Доставлено;
	ИначеЕсли СтатусAPI = "Read" Тогда
		Возврат Статусы.Прочитано;
	ИначеЕсли СтатусAPI = "Expired" Или СтатусAPI = "Undelivered" Или СтатусAPI = "Failed" Тогда
		Возврат Статусы.Недоставлено;
	ИначеЕсли СтатусAPI = "Rejected" Или СтатусAPI = "Cancelled" Тогда
		Возврат Статусы.Отклонено;
	ИначеЕсли СтатусAPI = "Unknown" Тогда
		Возврат Статусы.Неизвестно;
	Иначе // Queued, Accepted, Sent
		Возврат Статусы.Отправлено;
	КонецЕсли;
	
КонецФункции

// "2026-11-13 10:05:00" -> Дата. Пустая дата, если строка не разобрана.
Функция ДатаИзСтроки(Знач Значение)
	
	Текст = СокрЛП(Строка(Значение));
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "-", ""), ":", ""), " ", "");
	
	Если СтрДлина(Текст) <> 14 Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Попытка
		Возврат Дата(Текст);
	Исключение
		Возврат '00010101';
	КонецПопытки;
	
КонецФункции

Функция ВЧисло(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Попытка
		Возврат Число(Строка(Значение));
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

