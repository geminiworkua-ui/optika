Процедура ОбрезкаЛога() Экспорт
	НачалоПериода = Дата(1,1,1);
	КонецПериода  = ТекущаяДата() - 30*24*60*60;
	НаборЗаписей  = РегистрыСведений.ЛогированиеСайт.СоздатьНаборЗаписей(); 
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЛогированиеСайт.Время
	|ИЗ
	|	РегистрСведений.ЛогированиеСайт КАК ЛогированиеСайт
	|ГДЕ
	|	ЛогированиеСайт.Время < &Период");
	Запрос.УстановитьПараметр("Период", КонецПериода);
	Результат=Запрос.Выполнить().Выбрать(); 
	
	Пока Результат.Следующий() Цикл
		НаборЗаписей.Отбор.Время.Установить(Результат.Время);
		НаборЗаписей.Записать();   
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСвязаннуюРеализациюОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	ДО = Источник.Ссылка;

	Если ДО.Статус = Перечисления.СтатусыПеремещенийТоваров.Принято
		Тогда 
		Набор = РегистрыСведений.ОтложенныеРеализации.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументПеремещения.Установить(ДО);
		Набор.Отбор.РеализацияОформлена.Установить(Ложь);
		Набор.Прочитать();
		Если Набор.Количество() тогда
			Для каждого Запись из Набор цикл
				ПОпытка
					ДР = Запись.ДокументРеализации.ПолучитьОбъект();
					ДР.Записать(режимЗаписиДокумента.Проведение);
					Набор.РеализацияОформлена = Истина;
				Исключение
				КонецПопытки;
			КонецЦикла;
			Набор.Записать();
		КонецЕсли;
	КонецЕсли;	
		
КонецПроцедуры
 