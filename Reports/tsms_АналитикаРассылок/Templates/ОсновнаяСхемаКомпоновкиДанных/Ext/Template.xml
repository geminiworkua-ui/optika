		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Журнал.ИДСообщения КАК ИДСообщения,
	Журнал.ДатаОтправки КАК ДатаОтправки,
	НАЧАЛОПЕРИОДА(Журнал.ДатаОтправки, ДЕНЬ) КАК День,
	НАЧАЛОПЕРИОДА(Журнал.ДатаОтправки, МЕСЯЦ) КАК Месяц,
	Журнал.Партнер КАК Партнер,
	Журнал.НомерТелефона КАК НомерТелефона,
	Журнал.ВидОповещения КАК ВидОповещения,
	Журнал.СпособОтправки КАК СпособОтправки,
	Журнал.РучнаяРассылка КАК РучнаяРассылка,
	Журнал.Пользователь КАК Пользователь,
	Журнал.КаналПлановый КАК КаналПлановый,
	Журнал.КаналФактический КАК КаналФактический,
	Журнал.ТипСообщения КАК ТипСообщения,
	Журнал.Статус КАК Статус,
	Журнал.ПричинаОтклонения КАК ПричинаОтклонения,
	1 КАК Отправлено,
	ВЫБОР
		КОГДА Журнал.Статус В (ЗНАЧЕНИЕ(Перечисление.tsms_СтатусыСообщений.Доставлено), ЗНАЧЕНИЕ(Перечисление.tsms_СтатусыСообщений.Прочитано))
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Доставлено,
	ВЫБОР
		КОГДА Журнал.Статус = ЗНАЧЕНИЕ(Перечисление.tsms_СтатусыСообщений.Прочитано)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Прочитано,
	ВЫБОР
		КОГДА Журнал.ДатаКлика &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Кликов,
	ВЫБОР
		КОГДА Журнал.Статус В (ЗНАЧЕНИЕ(Перечисление.tsms_СтатусыСообщений.Недоставлено), ЗНАЧЕНИЕ(Перечисление.tsms_СтатусыСообщений.Отклонено))
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК НеДоставлено,
	ВЫБОР
		КОГДА Журнал.КаналПлановый = ЗНАЧЕНИЕ(Перечисление.tsms_КаналыОтправки.Viber)
				И Журнал.КаналФактический = ЗНАЧЕНИЕ(Перечисление.tsms_КаналыОтправки.SMS)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК УшлоВСМСГибридом,
	ВЫБОР
		КОГДА Журнал.ЭскалацияВыполнена
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ДослановСМС
ИЗ
	РегистрСведений.tsms_ЖурналСообщений КАК Журнал
ГДЕ
	Журнал.ДатаОтправки МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И Журнал.СпособОтправки &lt;&gt; ЗНАЧЕНИЕ(Перечисление.tsms_СпособыОтправки.Тестовая)</query>
	</dataSet>
