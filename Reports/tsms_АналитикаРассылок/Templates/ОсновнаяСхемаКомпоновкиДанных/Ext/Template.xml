		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Журнал.ВидОповещения КАК ВидОповещения,
	Журнал.РучнаяРассылка КАК РучнаяРассылка,
	Клики.НомерКарточки КАК НомерКарточки,
	Клики.Заголовок КАК ЗаголовокКарточки,
	1 КАК СообщенийСКарточкой,
	Клики.КликовКнопки КАК КликовКнопки,
	Клики.КликовСсылки КАК КликовСсылки
ИЗ
	РегистрСведений.tsms_КликиКарусели КАК Клики
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.tsms_ЖурналСообщений КАК Журнал
		ПО Клики.ИДСообщения = Журнал.ИДСообщения
ГДЕ
	Журнал.ДатаОтправки МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
