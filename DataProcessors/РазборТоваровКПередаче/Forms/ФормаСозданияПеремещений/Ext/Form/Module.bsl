
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	//Если  НЕ Справочники.Склады.НайтиПоНаименованию(" Склад") = неопределено
	//	Тогда 
	//СкладОтправитель = Справочники.Склады.НайтиПоНаименованию(" Склад");
	//     КонецЕсли;
	
	
	ЗаполнитьТаблицуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыНаСкладахОстатки.Склад КАК Склад,
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
		|	ТоварыНаСкладахОстатки.Назначение КАК Назначение,
		|	ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(ТоварыНаСкладахОстатки.КОтгрузкеОстаток, 0) КАК Количество
		|ПОМЕСТИТЬ вт_ТоварыНаСкладе
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(, ) КАК ТоварыНаСкладахОстатки
		|ГДЕ
		|	ТоварыНаСкладахОстатки.Склад = &Склад
		|	И НЕ ТоварыНаСкладахОстатки.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказыНаПеремещениеОстатки.ЗаказНаПеремещение КАК ЗаказНаПеремещение,
		|	ЗаказыНаПеремещениеОстатки.Номенклатура КАК Номенклатура,
		|	ЗаказыНаПеремещениеОстатки.Характеристика КАК Характеристика,
		|	ЗаказыНаПеремещениеОстатки.КодСтроки КАК КодСтроки,
		|	ЕСТЬNULL(ЗаказыНаПеремещениеОстатки.ЗаказаноОстаток, 0) - ЕСТЬNULL(ЗаказыНаПеремещениеОстатки.КОформлениюОстаток, 0) КАК Количество,
		|	ПараметрыЗаказаНаПеремещение.Назначение КАК Назначение,
		|	ПараметрыЗаказаНаПеремещение.ЗаказКлиента КАК ЗаказКлиента,
		|	ПараметрыЗаказаНаПеремещение.СкладОтправитель,
		|	ПараметрыЗаказаНаПеремещение.СкладПолучатель
		|ПОМЕСТИТЬ вт_ЗаказыНаПеремещение
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЗаказНаПеремещениеТовары.Назначение КАК Назначение,
		|		ЗаказНаПеремещениеТовары.НомерСтроки КАК НомерСтроки,
		|		ЗаказНаПеремещениеТовары.Ссылка КАК ЗаказНаПеремещение,
		|		ЗаказНаПеремещениеТовары.Назначение.Заказ.Ссылка КАК ЗаказКлиента,
		|		ЗаказНаПеремещениеТовары.Ссылка.СкладОтправитель КАК СкладОтправитель,
		|		ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель КАК СкладПолучатель
		|	ИЗ
		|		Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары) КАК ПараметрыЗаказаНаПеремещение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыНаПеремещение.Остатки КАК ЗаказыНаПеремещениеОстатки
		|		ПО (ЗаказыНаПеремещениеОстатки.ЗаказНаПеремещение = ПараметрыЗаказаНаПеремещение.ЗаказНаПеремещение)
		|			И (ЗаказыНаПеремещениеОстатки.КодСтроки = ПараметрыЗаказаНаПеремещение.НомерСтроки)
		|ГДЕ
		|	ЗаказыНаПеремещениеОстатки.ЗаказНаПеремещение.СкладОтправитель = &Склад
		|	И НЕ ПараметрыЗаказаНаПеремещение.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|	И ВЫБОР
		|			КОГДА НЕ &СкладПолучатель = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|						И ПараметрыЗаказаНаПеремещение.СкладПолучатель = &СкладПолучатель
		|					ИЛИ &СкладПолучатель = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	вт_ЗаказыНаПеремещение.ЗаказНаПеремещение,
		|	вт_ЗаказыНаПеремещение.Номенклатура,
		|	вт_ЗаказыНаПеремещение.Характеристика,
		|	вт_ЗаказыНаПеремещение.КодСтроки КАК НомСтр,
		|	ВЫБОР
		|		КОГДА ОстатокНаСкладе.Количество <= вт_ЗаказыНаПеремещение.Количество
		|			ТОГДА ОстатокНаСкладе.Количество
		|		ИНАЧЕ вт_ЗаказыНаПеремещение.Количество
		|	КОНЕЦ КАК Заказано,
		|	вт_ЗаказыНаПеремещение.Назначение,
		|	вт_ЗаказыНаПеремещение.ЗаказКлиента,
		|	вт_ЗаказыНаПеремещение.СкладОтправитель,
		|	вт_ЗаказыНаПеремещение.СкладПолучатель
		|ИЗ
		|	вт_ЗаказыНаПеремещение КАК вт_ЗаказыНаПеремещение
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт_ТоварыНаСкладе.Номенклатура КАК Номенклатура,
		|			вт_ТоварыНаСкладе.Назначение КАК Назначение,
		|			вт_ТоварыНаСкладе.Количество КАК Количество,
		|			вт_ТоварыНаСкладе.Характеристика КАК Характеристика
		|		ИЗ
		|			вт_ТоварыНаСкладе КАК вт_ТоварыНаСкладе
		|		ГДЕ
		|			вт_ТоварыНаСкладе.Количество > 0) КАК ОстатокНаСкладе
		|		ПО вт_ЗаказыНаПеремещение.Номенклатура = ОстатокНаСкладе.Номенклатура
		|			И вт_ЗаказыНаПеремещение.Характеристика = ОстатокНаСкладе.Характеристика
		|			И вт_ЗаказыНаПеремещение.Назначение = ОстатокНаСкладе.Назначение
		|ГДЕ
		|	ВЫБОР
		|			КОГДА НЕ &ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)
		|					И вт_ЗаказыНаПеремещение.Номенклатура.ВидНоменклатуры В (&ВидНоменклатуры)
		|				ТОГДА ИСТИНА
		|			КОГДА &ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	вт_ЗаказыНаПеремещение.ЗаказНаПеремещение.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ вт_ТоварыНаСкладе
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ вт_ЗаказыНаПеремещение";
	
	Запрос.УстановитьПараметр("Склад", СкладОтправитель);
	Запрос.УстановитьПараметр("СкладПолучатель", СкладПолучатель); 
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры); 
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());

    ТЗ = новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();

	ЭтаФорма.Таблица.Очистить();
	ЭтаФорма.Таблица.Загрузить(ТЗ);
	
КонецПроцедуры	

&НаКлиенте
Процедура СкладОтправительПриИзменении(Элемент)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СкладПолучательПриИзменении(Элемент)
	ЗаполнитьТаблицуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОкПриИзменении(Элемент)
	
	ТекСтр = Элементы.Таблица.ТекущиеДанные;
	Если 
		ТекСтр.Ок = Истина
		Тогда ТекСтр.Отк = Ложь;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОтказПриИзменении(Элемент)
	
	ТекСтр = Элементы.Таблица.ТекущиеДанные;
	Если 
		ТекСтр.Отк = Истина
		Тогда ТекСтр.Ок = Ложь;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ВсеОк(Команда)
	Для каждого Стр из Таблица цикл
		Стр.Ок = Истина;
		Стр.Отк = Ложь;
	КонецЦикла
		
КонецПроцедуры

&НаКлиенте
Процедура ВсеОтк(Команда)
	Для каждого Стр из Таблица цикл
		Стр.Отк = Истина;
		Стр.Ок = Ложь;
	КонецЦикла
		
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорм(Команда)
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	ПрименитьНаСервере(); 
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПрименитьНаСервере()
	
	Автор = ПараметрыСеанса.ТекущийПользователь;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = ЭтаФорма.Таблица.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.СкладОтправитель,
	|	ТЗ.СкладПолучатель,
	|	ТЗ.ЗаказНаПеремещение,
	|	ТЗ.ЗаказКлиента,
	|	ТЗ.Номенклатура,
	|	ТЗ.Характеристика,
	|	ТЗ.Заказано КАК Количество,
	|	ТЗ.НомСтр,
	|	ТЗ.Назначение,
	|	ТЗ.Ок,
	|	ТЗ.Отк
	|ПОМЕСТИТЬ вт_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗ.СкладОтправитель,
	|	вт_ТЗ.СкладПолучатель
	|ИЗ
	|	вт_ТЗ КАК вт_ТЗ
	|ГДЕ
	|	вт_ТЗ.Ок
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ТЗ.СкладОтправитель,
	|	вт_ТЗ.СкладПолучатель";
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// создаем новый документ перемещения
		НовДок = Документы.ПеремещениеТоваров.СоздатьДокумент(); 
		НовДок.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
		НовДок.Дата = ТекущаяДата();
		НовДок.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		НовДок.ОрганизацияПолучатель = НовДок.Организация;
		НовДок.Статус = Перечисления.СтатусыПеремещенийТоваров.Отгружено;
		НовДок.СкладОтправитель = Выборка.СкладОтправитель;
		НовДок.СкладПолучатель = Выборка.СкладПолучатель;
		НовДок.ВидЦены = НовДок.СкладОтправитель.УчетныйВидЦены;
				
		НовДок.Ответственный = Автор;
		Текст = "Сформовоно обробкою користвачем " + строка(НовДок.Ответственный);
		НовДок.Комментарий = Текст;
		НовДок.ПеремещениеПоЗаказам = Истина;
		НовДок.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		НовДок.Подразделение = Выборка.СкладОтправитель.Подразделение;
		
		Запрос2 = Новый Запрос;
		Запрос2.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.СкладОтправитель,
		|	ТЗ.СкладПолучатель,
		|	ТЗ.ЗаказНаПеремещение,
		|	ТЗ.ЗаказКлиента,
		|	ТЗ.Номенклатура,
		|	ТЗ.Характеристика,
		|	ТЗ.Заказано КАК Количество,
		|	ТЗ.НомСтр,
		|	ТЗ.Назначение,
		|	ТЗ.Ок,
		|	ТЗ.Отк
		|ПОМЕСТИТЬ вт_ТЗ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|ГДЕ
		|	ТЗ.СкладОтправитель = &СкладОтправитель
		|	И ТЗ.СкладПолучатель = &СкладПолучатель
		|	И ТЗ.Ок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТЗ.СкладОтправитель,
		|	вт_ТЗ.СкладПолучатель,
		|	вт_ТЗ.ЗаказНаПеремещение,
		|	вт_ТЗ.ЗаказКлиента,
		|	вт_ТЗ.Номенклатура,
		|	вт_ТЗ.Характеристика,
		|	вт_ТЗ.Количество,
		|	вт_ТЗ.НомСтр КАК КодСтроки,
		|	вт_ТЗ.Назначение
		|ИЗ
		|	вт_ТЗ КАК вт_ТЗ
		|ГДЕ
		|	вт_ТЗ.Ок";
		Запрос2.УстановитьПараметр("ТЗ", ТЗ);
		Запрос2.УстановитьПараметр("СкладОтправитель", Выборка.СкладОтправитель);
		Запрос2.УстановитьПараметр("СкладПолучатель", Выборка.СкладПолучатель);
		Выборка2 = Запрос2.Выполнить().Выбрать();
		
		Пока Выборка2.Следующий() цикл
			ВыбДокумент = Выборка2.ЗаказНаПеремещение;
			ДокЗаказа = ВыбДокумент.ПолучитьОбъект();
			ДокЗаказа.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
			ДокЗаказа.Товары[Выборка2.КодСтроки-1].ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно;
			Текст = Строка(Выборка2.Номенклатура) + " " + Строка(Выборка2.Характеристика) + " підтверджено до переміщення " + формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " користувачем " + Строка(Автор); 
			ДокЗаказа.Комментарий = ДокЗаказа.Комментарий + Символы.ПС + Текст;
			ДокЗаказа.Записать(РежимЗаписиДокумента.Проведение);
			
			НовСтр = НовДок.Товары.Добавить();
			//заполнитьЗначенияСвойств(НовСтр,Выборка2);
			НовСтр.Номенклатура = Выборка2.Номенклатура;
			НовСтр.Назначение = Выборка2.Назначение;
			//НовСтр.НазначениеОтправителя = Выборка2.Назначение;
			НовСтр.Характеристика = Выборка2.Характеристика;
			НовСтр.ЗаказНаПеремещение = Выборка2.ЗаказНаПеремещение;
			НовСтр.Количество = Выборка2.Количество;
			НовСтр.КоличествоУпаковок = Выборка2.Количество;
			НовСтр.КодСтроки = Выборка2.КодСтроки;
			НовСтр.Упаковка = Выборка2.Номенклатура.ЕдиницаИзмерения; 
			НовСтр.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
			
			
			ПараметрыАналитики = Новый Структура;
			ПараметрыАналитики.Вставить("Номенклатура",Выборка2.Номенклатура);
			ПараметрыАналитики.Вставить("Характеристика",Выборка2.Характеристика);
			ПараметрыАналитики.Вставить("Серия",Справочники.СерииНоменклатуры.ПустаяСсылка());
			ПараметрыАналитики.Вставить("Склад",Выборка.СкладОтправитель);
			
			НовСтр.АналитикаУчетаНоменклатуры = РегистрыСведений.АналитикаУчетаНоменклатуры.ЗначениеКлючаАналитики(ПараметрыАналитики);			
			
			НовСтрВЗ = НовДок.ВидыЗапасов.Добавить();
			НовСтрВЗ.АналитикаУчетаНоменклатуры = НовСтр.АналитикаУчетаНоменклатуры;
			НовСтрВЗ.Количество =  НовСтр.Количество; 
			Реквизиты = Новый Структура("
			|Организация,
			|ТипЗапасов,
			|Комитент,
			|Контрагент,
			|Соглашение,
			|Договор,
			|Валюта,
			|НалоговоеНазначение,
			|НалоговоеНазначениеОрганизации,
			|Поставщик,
			|Предназначение,
			|Менеджер,
			|Подразделение,
			|Сделка,
			|Назначение,
			|ОбособленныйУчетТоваровПоСделке,
			|ВариантОбособленногоУчетаТоваров,
			|ВидЗапасов,
			|ГруппаФинансовогоУчета,
			|ГруппаПродукции,
			|ХозяйственнаяОперация
			|");
			ЗаполнитьЗначенияСвойств(Реквизиты, НовДок);
			Реквизиты.ОбособленныйУчетТоваровПоСделке = Истина;
			
			НовСтрВЗ.ВидЗапасов = Справочники.ВидыЗапасов.ВидЗапасовДокумента(НовДок.Организация,НовДок.ХозяйственнаяОперация,Реквизиты, Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_НеоблагаемаяХозДеятельность );
			НовСтрВЗ.Назначение = НовСтр.Назначение;
			
			Реквизиты = Новый Структура("
			|Организация,
			|ТипЗапасов,
			|Комитент,
			|Контрагент,
			|Соглашение,
			|Договор,
			|Валюта,
			|НалоговоеНазначение,
			|НалоговоеНазначениеОрганизации,
			|Поставщик,
			|Предназначение,
			|Менеджер,
			|Подразделение,
			|Сделка,
			|Назначение,
			|ОбособленныйУчетТоваровПоСделке,
			|ВариантОбособленногоУчетаТоваров,
			|ВидЗапасов,
			|ГруппаФинансовогоУчета,
			|ГруппаПродукции,
			|ХозяйственнаяОперация
			|");
			ЗаполнитьЗначенияСвойств(Реквизиты, НовДок);
			Реквизиты.ОбособленныйУчетТоваровПоСделке = Истина;
			Реквизиты.Назначение = Выборка2.Назначение;
			
			НовСтрВЗ.ВидЗапасов = Справочники.ВидыЗапасов.ВидЗапасовДокумента(НовДок.Организация,НовДок.ХозяйственнаяОперация,Реквизиты, Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_НеоблагаемаяХозДеятельность );
			
			НовСтрВЗ.ВидЗапасовПолучателя = НовСтрВЗ.ВидЗапасов;
		КонецЦикла;
		Если НовДок.Товары.Количество() =1 Тогда			
			НовДок.ЗаказНаПеремещение = Выборка2.ЗаказНаПеремещение;
		КонецЕсли;	   
		Попытка
			НовДок.Записать(РежимЗаписиДокумента.Проведение);
			// проинформируем пользователей
			//НаборЗаписей = РегистрыСведений.СообщенияПользователям.СоздатьНаборЗаписей(); 
			//НаборЗаписей.Отбор.Период.Установить(ТекущаяДата()); 
			//НовЗапись = НаборЗаписей.Добавить();
			//НовЗапись.ДокументСобытия = ДокЗаказа;
			//НовЗапись.Подразделение = ДокЗаказа.Подразделение;
			//Текст = "Погоджено замовлення на переміщення " + Строка(ДокЗаказа) + " " + Строка(ДокЗаказа.Товары[Стр.НомСтр-1].Номенклатура) + " " + Строка(ДокЗаказа.Товары[Стр.НомСтр-1].Характеристика) + " з магазіну " + Строка(ДокЗаказа.СкладОтправитель); 
			//НовЗапись.Сообщение = СокрЛП(Текст);
			//НовЗапись.Иницаитор = Автор;
			//НовЗапись.Важное = Истина;
			//НовЗапись.ДатаСоздания = ТекущаяДата();
			//НаборЗаписей.Записать(Истина);
		Исключение
			НовДок.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
	КонецЦикла;
	
	// выполним отмену перемещения 
	Для каждого Стр из Таблица цикл
		Если Стр.Отк = Истина Тогда
			ДокЗаказа = Стр.ЗаказНаПеремещение.ПолучитьОбъект();
			ДокЗаказа.Товары[Стр.НомСтр-1].Отменено = Истина;
			Текст = Строка(Стр.Номенклатура) + " " + Строка(Стр.Характеристика) + " відмовлено до переміщення " + формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " користувачем " + Строка(Автор); 
			ДокЗаказа.Комментарий = ДокЗаказа.Комментарий + Символы.ПС + Текст;
			ДокЗаказа.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

