&НаСервере
Процедура ОбновитьРаспределениеНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГрафикОтгрузкиТоваров.Регистратор КАК ЗаказНаПеремещение,
		|	ГрафикОтгрузкиТоваров.НомерСтроки КАК НомерСтроки,
		|	ГрафикОтгрузкиТоваров.Номенклатура КАК Номенклатура,
		|	ГрафикОтгрузкиТоваров.Характеристика КАК Характеристика,
		|	ГрафикОтгрузкиТоваров.Склад КАК СкладПолучатель,
		|	ГрафикОтгрузкиТоваров.Назначение КАК Назначение,
		|	ГрафикОтгрузкиТоваров.Период КАК ДатаПоставки,
		|	ГрафикОтгрузкиТоваров.КоличествоПодЗаказ + ГрафикОтгрузкиТоваров.КоличествоНеобеспечено + ЕСТЬNULL(СвободныеОстатки.ВРезервеСоСклада, 0) КАК Заказано,
		|	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК СвободныйОстаток
		|ИЗ
		|	РегистрНакопления.ГрафикОтгрузкиТоваров КАК ГрафикОтгрузкиТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СвободныеОстатки КАК СвободныеОстатки
		|		ПО ГрафикОтгрузкиТоваров.Регистратор = СвободныеОстатки.Регистратор
		|			И (СвободныеОстатки.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|			И ГрафикОтгрузкиТоваров.Номенклатура = СвободныеОстатки.Номенклатура
		|			И ГрафикОтгрузкиТоваров.Характеристика = СвободныеОстатки.Характеристика
		|			И ГрафикОтгрузкиТоваров.Склад = СвободныеОстатки.Склад
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &СкладПолучательРаспределение) КАК ТоварыНаСкладахОстатки
		|		ПО ГрафикОтгрузкиТоваров.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
		|			И ГрафикОтгрузкиТоваров.Характеристика = ТоварыНаСкладахОстатки.Характеристика
		|			И ГрафикОтгрузкиТоваров.Склад = ТоварыНаСкладахОстатки.Склад
		|			И ГрафикОтгрузкиТоваров.Назначение = ТоварыНаСкладахОстатки.Назначение
		|ГДЕ
		|	ГрафикОтгрузкиТоваров.Регистратор ССЫЛКА Документ.ЗаказНаПеремещение
		|	И ГрафикОтгрузкиТоваров.Склад = &СкладОтправительРаспределение
		|	И ВЫБОР
		|			КОГДА НЕ &ВидНоменклатурыРаспределение = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)
		|					И ГрафикОтгрузкиТоваров.Номенклатура.ВидНоменклатуры В (&ВидНоменклатурыРаспределение)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ &ВидНоменклатурыРаспределение = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)
		|		КОНЕЦ";
	Запрос.УстановитьПараметр("СкладОтправительРаспределение", СкладОтправительРаспределение);
	Запрос.УстановитьПараметр("ВидНоменклатурыРаспределение",  ВидНоменклатурыРаспределение);
	Запрос.УстановитьПараметр("СкладПолучательРаспределение",  СкладПолучательРаспределение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаРаспределение.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

