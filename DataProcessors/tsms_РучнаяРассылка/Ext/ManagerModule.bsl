#Область ПрограммныйИнтерфейс

// Фоновая отправка ручной рассылки (ДлительныеОперации.ВыполнитьВФоне).
// Параметры: ВидОповещения, РучнаяРассылка, ЭскалацияВСМС, Пользователь,
//            Получатели - ТаблицаЗначений (Партнер, Наименование, Телефон, Склад).
// Результат во временном хранилище: Соответствие "Телефон -> message_id" ("" - не отправлено).
Процедура ОтправитьВФоне(Параметры, АдресРезультата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Настройка = tsms_СерверныйМодуль.НастройкаОповещенияПоВиду(Параметры.ВидОповещения);
	Настройка.ЭскалацияВСМС = Параметры.ЭскалацияВСМС;
	Настройка.Вставить("СпособОтправки", Перечисления.tsms_СпособыОтправки.Ручная);
	Настройка.Вставить("ДопДанныеЖурнала", Новый Структура("Пользователь, РучнаяРассылка",
		Параметры.Пользователь, Параметры.РучнаяРассылка));
	
	Получатели = Параметры.Получатели;
	Всего      = Получатели.Количество();
	КэшСкладов = Новый Соответствие;
	Результат  = Новый Соответствие;
	Отправлено = 0;
	Ошибок     = 0;
	Номер      = 0;
	
	Для Каждого Получатель Из Получатели Цикл
		
		Номер = Номер + 1;
		
		ИДСообщения = "";
		Попытка
			ПараметрыТекста = tsms_СерверныйМодуль.ПараметрыТекстаРучнойРассылки(
				Получатель.Наименование, Получатель.Склад, КэшСкладов);
			ИДСообщения = tsms_СерверныйМодуль.ОтправитьПоНастройке(
				Получатель.Партнер, Получатель.Телефон, Настройка, ПараметрыТекста);
		Исключение
			Контекст = Новый Структура("ВидОповещения, НомерТелефона, Подробности",
				Параметры.ВидОповещения, Получатель.Телефон, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОшибкаОтправки,
				"Ручна розсилка: виняток під час відправки", Контекст);
		КонецПопытки;
		
		Результат.Вставить(Получатель.Телефон, ИДСообщения);
		Если ИДСообщения = "" Тогда
			Ошибок = Ошибок + 1;
		Иначе
			Отправлено = Отправлено + 1;
		КонецЕсли;
		
		Если Номер % 10 = 0 Или Номер = Всего Тогда
			ДлительныеОперации.СообщитьПрогресс(Окр(Номер / Всего * 100),
				СтрШаблон("Відправлено %1 з %2", Номер, Всего));
		КонецЕсли;
		
	КонецЦикла;
	
	// Итоги в карточке рассылки
	Попытка
		РассылкаОбъект = Параметры.РучнаяРассылка.ПолучитьОбъект();
		РассылкаОбъект.Отправлено = РассылкаОбъект.Отправлено + Отправлено;
		РассылкаОбъект.Ошибок     = РассылкаОбъект.Ошибок + Ошибок;
		РассылкаОбъект.Записать();
	Исключение
		tsms_Логирование.Ошибка(Перечисления.tsms_СобытияЛогирования.ОшибкаЗаписиЖурнала,
			"Ручна розсилка: не вдалося записати підсумки розсилки",
			Новый Структура("Подробности", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти
