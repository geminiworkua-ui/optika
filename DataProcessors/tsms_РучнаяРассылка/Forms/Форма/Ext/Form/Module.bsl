#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьПредупреждениеГородов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОповещенияПриИзменении(Элемент)
	
	ВидОповещенияПриИзмененииНаСервере();
	ОбновитьИтоги();
	
КонецПроцедуры

&НаСервере
Процедура ВидОповещенияПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(ВидОповещения) Тогда
		ЭскалацияВСМС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОповещения, "ЭскалацияВСМС");
	КонецЕсли;
	
	// Новый шаблон - новая рассылка
	РучнаяРассылка = Неопределено;
	ПроверитьПолучателей();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучателиОтправлятьПриИзменении(Элемент)
	
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗащитаОтСпамаПриИзменении(Элемент)
	
	ПроверитьПолучателейНаСервере();
	ОбновитьИтоги();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПолучателейНаСервере()
	
	ПроверитьПолучателей();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоПокупкам(Команда)
	
	ЗаполнитьПоПокупкамНаСервере();
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьГорода(Команда)
	
	СписокГородов = СписокГородовСкладов();
	Если СписокГородов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "У складах не заповнено місто в адресі. Використовуйте відбір за складами.");
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из СписокГородов Цикл
		ЭлементСписка.Пометка = (Города.НайтиПоЗначению(ЭлементСписка.Значение) <> Неопределено);
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьГородаЗавершение", ЭтотОбъект);
	СписокГородов.ПоказатьОтметкуЭлементов(Оповещение, "Міста");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьГородаЗавершение(Список, ДополнительныеПараметры) Экспорт
	
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Города.Очистить();
	Для Каждого ЭлементСписка Из Список Цикл
		Если ЭлементСписка.Пометка Тогда
			Города.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНомераИзТекста(Команда)
	
	Если ПустаяСтрока(ТекстНомеров) Тогда
		ПоказатьПредупреждение(, "Вставте номери телефонів у поле.");
		Возврат;
	КонецЕсли;
	
	ДобавитьНомераИзТекстаНаСервере();
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКлиента(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ДобавитьКлиентаЗавершение", ЭтотОбъект);
	ПоказатьВводЗначения(Оповещение, ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка"),
		"Клієнт", Тип("СправочникСсылка.Партнеры"));
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКлиентаЗавершение(Партнер, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьКлиентаНаСервере(Партнер);
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	Для Каждого Строка Из Получатели Цикл
		Если Строка.ИДСообщения = "" И Строка.Проверка <> ТекстНекорректныйНомер() Тогда
			Строка.Отправлять = Истина;
		КонецЕсли;
	КонецЦикла;
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
	
	Для Каждого Строка Из Получатели Цикл
		Строка.Отправлять = Ложь;
	КонецЦикла;
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСписок(Команда)
	
	Получатели.Очистить();
	РучнаяРассылка = Неопределено;
	ОписаниеОтбора = "";
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредпросмотр(Команда)
	
	ТекущиеДанные = Элементы.Получатели.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ВидОповещения) Тогда
		ПоказатьПредупреждение(, "Оберіть шаблон і рядок у списку отримувачів.");
		Возврат;
	КонецЕсли;
	
	ПоказатьПредпросмотрНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ТестоваяОтправка(Команда)
	
	Если Не ЗначениеЗаполнено(ВидОповещения) Или ПустаяСтрока(НомерДляТеста) Тогда
		ПоказатьПредупреждение(, "Оберіть шаблон і вкажіть номер для тесту.");
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Получатели.ТекущиеДанные;
	ИдентификаторСтроки = ?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.ПолучитьИдентификатор());
	
	ИДСообщения = ТестоваяОтправкаНаСервере(ИдентификаторСтроки);
	
	ПоказатьПредупреждение(, ?(ИДСообщения = "",
		"Тестове повідомлення не відправлено. Деталі — в журналі логування TurboSMS.",
		"Тестове повідомлення відправлено."));
	
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)
	
	Если Не ЗначениеЗаполнено(ВидОповещения) Тогда
		ПоказатьПредупреждение(, "Оберіть шаблон повідомлення.");
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(НазваниеРассылки) Тогда
		ПоказатьПредупреждение(, "Вкажіть назву розсилки.");
		Возврат;
	КонецЕсли;
	
	КОтправке = 0;
	БезКарточки = 0;
	Для Каждого Строка Из Получатели Цикл
		Если Строка.Отправлять И Строка.ИДСообщения = "" Тогда
			КОтправке = КОтправке + 1;
			Если Не ЗначениеЗаполнено(Строка.Партнер) Тогда
				БезКарточки = БезКарточки + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если КОтправке = 0 Тогда
		ПоказатьПредупреждение(, "Немає позначених отримувачів, яким ще не відправлено.");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон("Відправити %1 повідомлень за шаблоном ""%2""?", КОтправке, ВидОповещения);
	Если БезКарточки > 0 Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + СтрШаблон(
			"Увага: %1 номерів без картки клієнта — параметри шаблону (ім'я, філія) для них будуть порожні.",
			БезКарточки);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОтправитьПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ОтправитьНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = "Відправка повідомлень TurboSMS";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ОтправитьЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		// Задание отменено: часть сообщений могла уйти - подтягиваем по журналу
		ОбновитьСтатусыНаСервере();
		ОбновитьИтоги();
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбновитьСтатусыНаСервере();
		ОбновитьИтоги();
		ПоказатьПредупреждение(, "Помилка відправки: " + Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	ТекстИтога = ОбработатьРезультатОтправки(Результат.АдресРезультата);
	ОбновитьИтоги();
	ПоказатьПредупреждение(, ТекстИтога);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусы(Команда)
	
	ОбновитьСтатусыНаСервере(Истина);
	ОбновитьИтоги();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстНекорректныйНомер()
	
	Возврат "Некоректний номер";
	
КонецФункции

&НаКлиенте
Процедура ОбновитьИтоги()
	
	Всего = Получатели.Количество();
	Отмечено = 0;
	БезКарточки = 0;
	Некорректных = 0;
	Отправлено = 0;
	
	Для Каждого Строка Из Получатели Цикл
		Если Строка.Отправлять Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.Партнер) Тогда
			БезКарточки = БезКарточки + 1;
		КонецЕсли;
		Если Строка.Проверка = ТекстНекорректныйНомер() Тогда
			Некорректных = Некорректных + 1;
		КонецЕсли;
		Если Строка.ИДСообщения <> "" Тогда
			Отправлено = Отправлено + 1;
		КонецЕсли;
	КонецЦикла;
	
	Итоги = СтрШаблон("Всього: %1 / позначено: %2 / без картки: %3 / некоректних: %4 / відправлено: %5",
		Всего, Отмечено, БезКарточки, Некорректных, Отправлено);
	
КонецПроцедуры

// --- ГОРОДА ---

// Таблица "Склад - Город" по адресу из контактной информации склада.
&НаСервереБезКонтекста
Функция ГородаСкладов()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Склады.Ссылка КАК Склад,
		|	МАКСИМУМ(ЕСТЬNULL(КИ.Город, """")) КАК Город
		|ИЗ
		|	Справочник.Склады КАК Склады
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады.КонтактнаяИнформация КАК КИ
		|		ПО (КИ.Ссылка = Склады.Ссылка)
		|			И (КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
		|ГДЕ
		|	НЕ Склады.ЭтоГруппа
		|	И НЕ Склады.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	Склады.Ссылка";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокГородовСкладов()
	
	Список = Новый СписокЗначений;
	Для Каждого Строка Из ГородаСкладов() Цикл
		Город = СокрЛП(Строка.Город);
		Если Город <> "" И Список.НайтиПоЗначению(Город) = Неопределено Тогда
			Список.Добавить(Город);
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоЗначению();
	
	Возврат Список;
	
КонецФункции

&НаСервере
Процедура ОбновитьПредупреждениеГородов()
	
	БезГорода = 0;
	Для Каждого Строка Из ГородаСкладов() Цикл
		Если СокрЛП(Строка.Город) = "" Тогда
			БезГорода = БезГорода + 1;
		КонецЕсли;
	КонецЦикла;
	
	ПредупреждениеГорода = ?(БезГорода = 0, "", СтрШаблон(
		"Увага: у %1 складах не заповнено місто в адресі — у відбір за містом вони не потраплять. Надійніше обирати склади.",
		БезГорода));
	
КонецПроцедуры

// --- ЗАПОЛНЕНИЕ СПИСКА ---

&НаСервере
Процедура ЗаполнитьПоПокупкамНаСервере()
	
	ЕстьНачало       = ЗначениеЗаполнено(ПериодПокупки.ДатаНачала);
	ЕстьКонец        = ЗначениеЗаполнено(ПериодПокупки.ДатаОкончания);
	ЕстьСклады       = Склады.Количество() > 0;
	ЕстьГорода       = Города.Количество() > 0;
	ЕстьГруппы       = ГруппыНоменклатуры.Количество() > 0;
	ЕстьНоменклатура = Номенклатура.Количество() > 0;
	ЕстьВиды         = ВидыНоменклатуры.Количество() > 0;
	
	Если Не (ЕстьНачало Или ЕстьКонец Или ЕстьСклады Или ЕстьГорода Или ЕстьГруппы Или ЕстьНоменклатура Или ЕстьВиды) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Задайте хоча б один відбір (період, склади, товари).");
		Возврат;
	КонецЕсли;
	
	ТаблицаГородов = ГородаСкладов();
	
	// Склады выбранных городов
	СкладыГородов = Новый Массив;
	Если ЕстьГорода Тогда
		Для Каждого Строка Из ТаблицаГородов Цикл
			Если Города.НайтиПоЗначению(СокрЛП(Строка.Город)) <> Неопределено Тогда
				СкладыГородов.Добавить(Строка.Склад);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Продажи.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
		|	Продажи.Склад КАК Склад,
		|	Продажи.Период КАК Период
		|ПОМЕСТИТЬ ВТ_Продажи
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Продажи
		|ГДЕ
		|	Продажи.Количество > 0
		|	И НЕ Продажи.АналитикаУчетаПоПартнерам.Партнер.ПометкаУдаления
		|	И (НЕ &ЕстьНачало
		|			ИЛИ Продажи.Период >= &Начало)
		|	И (НЕ &ЕстьКонец
		|			ИЛИ Продажи.Период <= &Конец)
		|	И (НЕ &ЕстьСклады
		|			ИЛИ Продажи.Склад В (&Склады))
		|	И (НЕ &ЕстьГорода
		|			ИЛИ Продажи.Склад В (&СкладыГородов))
		|	И (НЕ &ЕстьГруппы
		|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Номенклатура В ИЕРАРХИИ (&Группы))
		|	И (НЕ &ЕстьНоменклатура
		|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Номенклатура В (&Номенклатура))
		|	И (НЕ &ЕстьВиды
		|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры В (&Виды))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Продажи.Партнер КАК Партнер,
		|	МАКСИМУМ(ВТ_Продажи.Период) КАК ДатаПокупки
		|ПОМЕСТИТЬ ВТ_Клиенты
		|ИЗ
		|	ВТ_Продажи КАК ВТ_Продажи
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Продажи.Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КИ_ТЧ.Ссылка КАК Партнер,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КИ_ТЧ.НомерТелефона <> """"
		|				ТОГДА КИ_ТЧ.НомерТелефона
		|			ИНАЧЕ ПОДСТРОКА(КИ_ТЧ.Представление, 1, 100)
		|		КОНЕЦ) КАК Телефон
		|ПОМЕСТИТЬ ВТ_Телефоны
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК КИ_ТЧ
		|ГДЕ
		|	КИ_ТЧ.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТ_Клиенты.Партнер
		|			ИЗ
		|				ВТ_Клиенты)
		|	И КИ_ТЧ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|
		|СГРУППИРОВАТЬ ПО
		|	КИ_ТЧ.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Клиенты.Партнер КАК Партнер,
		|	Клиенты.ДатаПокупки КАК ДатаПокупки,
		|	МАКСИМУМ(Продажи.Склад) КАК Склад,
		|	ЕСТЬNULL(Телефоны.Телефон, """") КАК Телефон
		|ИЗ
		|	ВТ_Клиенты КАК Клиенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Продажи КАК Продажи
		|		ПО (Продажи.Партнер = Клиенты.Партнер)
		|			И (Продажи.Период = Клиенты.ДатаПокупки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Телефоны КАК Телефоны
		|		ПО (Телефоны.Партнер = Клиенты.Партнер)
		|
		|СГРУППИРОВАТЬ ПО
		|	Клиенты.Партнер,
		|	Клиенты.ДатаПокупки,
		|	ЕСТЬNULL(Телефоны.Телефон, """")";
	
	Запрос.УстановитьПараметр("ЕстьНачало", ЕстьНачало);
	Запрос.УстановитьПараметр("Начало", ПериодПокупки.ДатаНачала);
	Запрос.УстановитьПараметр("ЕстьКонец", ЕстьКонец);
	Запрос.УстановитьПараметр("Конец", КонецДня(ПериодПокупки.ДатаОкончания));
	Запрос.УстановитьПараметр("ЕстьСклады", ЕстьСклады);
	Запрос.УстановитьПараметр("Склады", Склады.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ЕстьГорода", ЕстьГорода);
	Запрос.УстановитьПараметр("СкладыГородов", СкладыГородов);
	Запрос.УстановитьПараметр("ЕстьГруппы", ЕстьГруппы);
	Запрос.УстановитьПараметр("Группы", ГруппыНоменклатуры.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ЕстьНоменклатура", ЕстьНоменклатура);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ЕстьВиды", ЕстьВиды);
	Запрос.УстановитьПараметр("Виды", ВидыНоменклатуры.ВыгрузитьЗначения());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РежимЗаполнения = 1 Тогда
		Получатели.Очистить();
		РучнаяРассылка = Неопределено;
		ОписаниеОтбора = "";
	КонецЕсли;
	
	Добавлено = 0;
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Получатели.Добавить();
		НоваяСтрока.Отправлять  = Истина;
		НоваяСтрока.Партнер     = Выборка.Партнер;
		НоваяСтрока.Телефон     = Выборка.Телефон;
		НоваяСтрока.Склад       = Выборка.Склад;
		НоваяСтрока.ДатаПокупки = Выборка.ДатаПокупки;
		Добавлено = Добавлено + 1;
	КонецЦикла;
	
	// Текстовое описание отбора - для карточки рассылки
	Части = Новый Массив;
	Если ЕстьНачало Или ЕстьКонец Тогда
		Части.Добавить(СтрШаблон("період: %1 - %2",
			Формат(ПериодПокупки.ДатаНачала, "ДФ=dd.MM.yyyy; ДП=..."),
			Формат(ПериодПокупки.ДатаОкончания, "ДФ=dd.MM.yyyy; ДП=...")));
	КонецЕсли;
	Если ЕстьСклады Тогда
		Части.Добавить("склади: " + СтрСоединить(ЗначенияВСтроки(Склады), ", "));
	КонецЕсли;
	Если ЕстьГорода Тогда
		Части.Добавить("міста: " + СтрСоединить(ЗначенияВСтроки(Города), ", "));
	КонецЕсли;
	Если ЕстьГруппы Тогда
		Части.Добавить("групи: " + СтрСоединить(ЗначенияВСтроки(ГруппыНоменклатуры), ", "));
	КонецЕсли;
	Если ЕстьНоменклатура Тогда
		Части.Добавить("товари: " + СтрСоединить(ЗначенияВСтроки(Номенклатура), ", "));
	КонецЕсли;
	Если ЕстьВиды Тогда
		Части.Добавить("види: " + СтрСоединить(ЗначенияВСтроки(ВидыНоменклатуры), ", "));
	КонецЕсли;
	ДобавитьКОписаниюОтбора(СтрШаблон("Покупки (%1 клієнтів): %2", Добавлено, СтрСоединить(Части, "; ")));
	
	ПроверитьПолучателей();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначенияВСтроки(Список)
	
	Строки = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл
		Строки.Добавить(Строка(ЭлементСписка.Значение));
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

&НаСервере
Процедура ДобавитьКОписаниюОтбора(Текст)
	
	ОписаниеОтбора = ОписаниеОтбора + ?(ОписаниеОтбора = "", "", Символы.ПС) + Текст;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНомераИзТекстаНаСервере()
	
	// Разделители: перенос строки, запятая, точка с запятой, табуляция
	Текст = СтрЗаменить(ТекстНомеров, Символы.ВК, Символы.ПС);
	Текст = СтрЗаменить(Текст, ",", Символы.ПС);
	Текст = СтрЗаменить(Текст, ";", Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.Таб, Символы.ПС);
	
	Номера = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Если ПустаяСтрока(Часть) Тогда
			Продолжить;
		КонецЕсли;
		Номер = tsms_СерверныйМодуль.НормализоватьНомерТелефона(Часть);
		Если Номер = "" Тогда
			Номер = Лев(СокрЛП(Часть), 20); // попадёт в список как некорректный
		КонецЕсли;
		Если Номера.Найти(Номер) = Неопределено Тогда
			Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	
	Если Номера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПартнерыПоНомерам = НайтиПартнеровПоНомерам(Номера);
	
	Если РежимЗаполнения = 1 Тогда
		Получатели.Очистить();
		РучнаяРассылка = Неопределено;
		ОписаниеОтбора = "";
	КонецЕсли;
	
	Для Каждого Номер Из Номера Цикл
		НоваяСтрока = Получатели.Добавить();
		НоваяСтрока.Отправлять = Истина;
		НоваяСтрока.Телефон    = Лев(Номер, 20);
		НоваяСтрока.Партнер    = ПартнерыПоНомерам.Получить(Номер);
	КонецЦикла;
	
	ДобавитьКОписаниюОтбора(СтрШаблон("Список номерів: %1", Номера.Количество()));
	ТекстНомеров = "";
	
	ПроверитьПолучателей();
	
КонецПроцедуры

// Ищет клиентов по номерам: телефоны из карточек нормализуются тем же способом,
// что и вставленные номера. Возвращает Соответствие "Номер -> Партнер".
&НаСервереБезКонтекста
Функция НайтиПартнеровПоНомерам(Номера)
	
	Результат = Новый Соответствие;
	
	Искомые = Новый Соответствие;
	Для Каждого Номер Из Номера Цикл
		Если СтрДлина(Номер) = 12 И СтрНачинаетсяС(Номер, "380") Тогда
			Искомые.Вставить(Номер, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Если Искомые.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КИ.Ссылка КАК Партнер,
		|	ВЫБОР
		|		КОГДА КИ.НомерТелефона <> """"
		|			ТОГДА КИ.НомерТелефона
		|		ИНАЧЕ ПОДСТРОКА(КИ.Представление, 1, 100)
		|	КОНЕЦ КАК Телефон
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК КИ
		|ГДЕ
		|	КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|	И НЕ КИ.Ссылка.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Номер = tsms_СерверныйМодуль.НормализоватьНомерТелефона(Выборка.Телефон);
		Если Искомые.Получить(Номер) <> Неопределено И Результат.Получить(Номер) = Неопределено Тогда
			Результат.Вставить(Номер, Выборка.Партнер);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьКлиентаНаСервере(Партнер)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КИ.НомерТелефона <> """"
		|				ТОГДА КИ.НомерТелефона
		|			ИНАЧЕ ПОДСТРОКА(КИ.Представление, 1, 100)
		|		КОНЕЦ) КАК Телефон
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК КИ
		|ГДЕ
		|	КИ.Ссылка = &Партнер
		|	И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	Телефон = "";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Телефон) Тогда
		Телефон = Выборка.Телефон;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	НоваяСтрока = Получатели.Добавить();
	НоваяСтрока.Отправлять = Истина;
	НоваяСтрока.Партнер    = Партнер;
	НоваяСтрока.Телефон    = Лев(Телефон, 20);
	
	ПроверитьПолучателей();
	
КонецПроцедуры

// --- ПРОВЕРКА СПИСКА ---

// Нормализует номера, убирает дубли, дозаполняет последнюю покупку и город,
// применяет защиту от спама. Уже отправленные строки не трогает.
&НаСервере
Процедура ПроверитьПолучателей()
	
	// 1. Номера: нормализация, корректность, дубли (остаётся первая строка)
	Встреченные = Новый Соответствие;
	КУдалению   = Новый Массив;
	
	Для Каждого Строка Из Получатели Цикл
		
		Если Строка.ИДСообщения <> "" Тогда
			Встреченные.Вставить(Строка.Телефон, Истина);
			Продолжить;
		КонецЕсли;
		
		Номер = tsms_СерверныйМодуль.НормализоватьНомерТелефона(Строка.Телефон);
		Если Номер <> "" Тогда
			Строка.Телефон = Лев(Номер, 20);
		КонецЕсли;
		
		Если СтрДлина(Строка.Телефон) <> 12 Или Не СтрНачинаетсяС(Строка.Телефон, "380") Тогда
			Строка.Проверка   = ТекстНекорректныйНомер();
			Строка.Отправлять = Ложь;
		ИначеЕсли Встреченные.Получить(Строка.Телефон) <> Неопределено Тогда
			КУдалению.Добавить(Строка);
		Иначе
			Встреченные.Вставить(Строка.Телефон, Истина);
			Если Строка.Проверка = ТекстНекорректныйНомер() Тогда
				Строка.Проверка = "";
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из КУдалению Цикл
		Получатели.Удалить(Строка);
	КонецЦикла;
	
	// 2. Последняя покупка для клиентов, добавленных не из отбора по покупкам
	ДозаполнитьПоследниеПокупки();
	
	// 3. Город по складу
	ГородПоСкладу = Новый Соответствие;
	Для Каждого СтрокаГорода Из ГородаСкладов() Цикл
		ГородПоСкладу.Вставить(СтрокаГорода.Склад, СокрЛП(СтрокаГорода.Город));
	КонецЦикла;
	Для Каждого Строка Из Получатели Цикл
		Если ЗначениеЗаполнено(Строка.Склад) Тогда
			Город = ГородПоСкладу.Получить(Строка.Склад);
			Строка.Город = ?(Город = Неопределено, "", Город);
		КонецЕсли;
	КонецЦикла;
	
	// 4. Защита от спама
	ПрименитьЗащитуОтСпама();
	
КонецПроцедуры

&НаСервере
Процедура ДозаполнитьПоследниеПокупки()
	
	Партнеры = Новый Массив;
	Для Каждого Строка Из Получатели Цикл
		Если ЗначениеЗаполнено(Строка.Партнер) И Не ЗначениеЗаполнено(Строка.Склад) Тогда
			Партнеры.Добавить(Строка.Партнер);
		КонецЕсли;
	КонецЦикла;
	
	Если Партнеры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Продажи.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
		|	МАКСИМУМ(Продажи.Период) КАК ДатаПокупки
		|ПОМЕСТИТЬ ВТ_Последние
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Продажи
		|ГДЕ
		|	Продажи.АналитикаУчетаПоПартнерам.Партнер В (&Партнеры)
		|	И Продажи.Количество > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	Продажи.АналитикаУчетаПоПартнерам.Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Последние.Партнер КАК Партнер,
		|	Последние.ДатаПокупки КАК ДатаПокупки,
		|	МАКСИМУМ(Продажи.Склад) КАК Склад
		|ИЗ
		|	ВТ_Последние КАК Последние
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Продажи
		|		ПО (Продажи.АналитикаУчетаПоПартнерам.Партнер = Последние.Партнер)
		|			И (Продажи.Период = Последние.ДатаПокупки)
		|
		|СГРУППИРОВАТЬ ПО
		|	Последние.Партнер,
		|	Последние.ДатаПокупки";
	Запрос.УстановитьПараметр("Партнеры", Партнеры);
	
	Покупки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Покупки.Вставить(Выборка.Партнер, Новый Структура("Склад, ДатаПокупки", Выборка.Склад, Выборка.ДатаПокупки));
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого Строка Из Получатели Цикл
		Если ЗначениеЗаполнено(Строка.Партнер) И Не ЗначениеЗаполнено(Строка.Склад) Тогда
			Покупка = Покупки.Получить(Строка.Партнер);
			Если Покупка <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Строка, Покупка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьЗащитуОтСпама()
	
	Телефоны = Новый Массив;
	Для Каждого Строка Из Получатели Цикл
		Если Строка.ИДСообщения = "" И Строка.Проверка <> ТекстНекорректныйНомер() Тогда
			Телефоны.Добавить(Строка.Телефон);
		КонецЕсли;
	КонецЦикла;
	
	Недавние  = Новый Соответствие;
	ПоШаблону = Новый Соответствие;
	
	Если Телефоны.Количество() > 0 И (ИсключитьПолучавшихЗаДней > 0 Или ИсключитьПолучавшихШаблон) Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Журнал.НомерТелефона КАК НомерТелефона,
			|	МАКСИМУМ(ВЫБОР
			|			КОГДА Журнал.ДатаОтправки >= &ГраницаДней
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ) КАК Недавно,
			|	МАКСИМУМ(ВЫБОР
			|			КОГДА Журнал.ВидОповещения = &ВидОповещения
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ) КАК ЭтотШаблон
			|ИЗ
			|	РегистрСведений.tsms_ЖурналСообщений КАК Журнал
			|ГДЕ
			|	Журнал.НомерТелефона В (&Телефоны)
			|	И Журнал.СпособОтправки <> ЗНАЧЕНИЕ(Перечисление.tsms_СпособыОтправки.Тестовая)
			|
			|СГРУППИРОВАТЬ ПО
			|	Журнал.НомерТелефона";
		Запрос.УстановитьПараметр("Телефоны", Телефоны);
		Запрос.УстановитьПараметр("ВидОповещения", ВидОповещения);
		Запрос.УстановитьПараметр("ГраницаДней",
			НачалоДня(ТекущаяДатаСеанса()) - ИсключитьПолучавшихЗаДней * 86400);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Недавно И ИсключитьПолучавшихЗаДней > 0 Тогда
				Недавние.Вставить(Выборка.НомерТелефона, Истина);
			КонецЕсли;
			Если Выборка.ЭтотШаблон И ИсключитьПолучавшихШаблон И ЗначениеЗаполнено(ВидОповещения) Тогда
				ПоШаблону.Вставить(Выборка.НомерТелефона, Истина);
			КонецЕсли;
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
	Для Каждого Строка Из Получатели Цикл
		
		Если Строка.ИДСообщения <> "" Или Строка.Проверка = ТекстНекорректныйНомер() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПоШаблону.Получить(Строка.Телефон) <> Неопределено Тогда
			НоваяПроверка = "Вже отримував цей шаблон";
		ИначеЕсли Недавние.Получить(Строка.Телефон) <> Неопределено Тогда
			НоваяПроверка = СтрШаблон("Отримував повідомлення за останні %1 дн.", ИсключитьПолучавшихЗаДней);
		Иначе
			НоваяПроверка = "";
		КонецЕсли;
		
		// Отметку меняем только при изменении результата проверки - ручные правки пользователя сохраняются
		Если Строка.Проверка <> НоваяПроверка Тогда
			Строка.Проверка   = НоваяПроверка;
			Строка.Отправлять = (НоваяПроверка = "");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// --- ПРЕДПРОСМОТР И ТЕСТ ---

&НаСервере
Функция ПараметрыТекстаСтроки(ИдентификаторСтроки)
	
	Партнер = Неопределено;
	Склад   = Неопределено;
	
	Если ИдентификаторСтроки <> Неопределено Тогда
		Строка = Получатели.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Строка <> Неопределено Тогда
			Партнер = Строка.Партнер;
			Склад   = Строка.Склад;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Наименование = ?(ЗначениеЗаполнено(Партнер),
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партнер, "Наименование"), "");
	
	Возврат tsms_СерверныйМодуль.ПараметрыТекстаРучнойРассылки(Наименование, Склад, Новый Соответствие);
	
КонецФункции

&НаСервере
Процедура ПоказатьПредпросмотрНаСервере(ИдентификаторСтроки)
	
	ПараметрыТекста = ПараметрыТекстаСтроки(ИдентификаторСтроки);
	
	УстановитьПривилегированныйРежим(Истина);
	Настройка = tsms_СерверныйМодуль.НастройкаОповещенияПоВиду(ВидОповещения);
	Тексты    = tsms_СерверныйМодуль.ТекстыПоНастройке(Настройка, ПараметрыТекста);
	
	ПредпросмотрViber = Тексты.Viber;
	ПредпросмотрСМС   = Тексты.СМС;
	
КонецПроцедуры

&НаСервере
Функция ТестоваяОтправкаНаСервере(ИдентификаторСтроки)
	
	ПараметрыТекста = ПараметрыТекстаСтроки(ИдентификаторСтроки);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Настройка = tsms_СерверныйМодуль.НастройкаОповещенияПоВиду(ВидОповещения);
	Настройка.ЭскалацияВСМС = Ложь;
	Настройка.Вставить("СпособОтправки", Перечисления.tsms_СпособыОтправки.Тестовая);
	Настройка.Вставить("ДопДанныеЖурнала", Новый Структура("Пользователь", Пользователи.ТекущийПользователь()));
	
	Возврат tsms_СерверныйМодуль.ОтправитьПоНастройке(
		Справочники.Партнеры.ПустаяСсылка(), НомерДляТеста, Настройка, ПараметрыТекста);
	
КонецФункции

// --- ОТПРАВКА ---

&НаСервере
Функция ОтправитьНаСервере()
	
	ПроверитьПолучателей();
	
	// Получатели: отмеченные, корректные, ещё не отправленные
	ТаблицаПолучателей = Новый ТаблицаЗначений;
	ТаблицаПолучателей.Колонки.Добавить("Партнер");
	ТаблицаПолучателей.Колонки.Добавить("Наименование");
	ТаблицаПолучателей.Колонки.Добавить("Телефон");
	ТаблицаПолучателей.Колонки.Добавить("Склад");
	
	МассивПартнеров = Новый Массив;
	Для Каждого Строка Из Получатели Цикл
		Если Строка.Отправлять И Строка.ИДСообщения = "" И Строка.Проверка <> ТекстНекорректныйНомер() Тогда
			НоваяСтрока = ТаблицаПолучателей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Партнер, Телефон, Склад");
			НоваяСтрока.Наименование = "";
			Если ЗначениеЗаполнено(Строка.Партнер) Тогда
				МассивПартнеров.Добавить(Строка.Партнер);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если МассивПартнеров.Количество() > 0 Тогда
		Наименования = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивПартнеров, "Наименование");
		Для Каждого Строка Из ТаблицаПолучателей Цикл
			Если ЗначениеЗаполнено(Строка.Партнер) Тогда
				Наименование = Наименования.Получить(Строка.Партнер);
				Строка.Наименование = ?(Наименование = Неопределено, "", Наименование);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Карточка рассылки: одна на всё время работы с этим списком
	Если Не ЗначениеЗаполнено(РучнаяРассылка) Тогда
		РассылкаОбъект = Справочники.tsms_РучныеРассылки.СоздатьЭлемент();
		РассылкаОбъект.ДатаРассылки  = ТекущаяДатаСеанса();
		РассылкаОбъект.Автор         = Пользователи.ТекущийПользователь();
		РассылкаОбъект.ВидОповещения = ВидОповещения;
	Иначе
		РассылкаОбъект = РучнаяРассылка.ПолучитьОбъект();
	КонецЕсли;
	РассылкаОбъект.Наименование   = НазваниеРассылки;
	РассылкаОбъект.ОписаниеОтбора = ОписаниеОтбора;
	РассылкаОбъект.КоличествоПолучателей = РассылкаОбъект.КоличествоПолучателей + ТаблицаПолучателей.Количество();
	РассылкаОбъект.Записать();
	РучнаяРассылка = РассылкаОбъект.Ссылка;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ВидОповещения", ВидОповещения);
	ПараметрыПроцедуры.Вставить("РучнаяРассылка", РучнаяРассылка);
	ПараметрыПроцедуры.Вставить("ЭскалацияВСМС", ЭскалацияВСМС);
	ПараметрыПроцедуры.Вставить("Пользователь", Пользователи.ТекущийПользователь());
	ПараметрыПроцедуры.Вставить("Получатели", ТаблицаПолучателей);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "TurboSMS: ручна розсилка";
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.tsms_РучнаяРассылка.ОтправитьВФоне", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Функция ОбработатьРезультатОтправки(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Возврат "Не вдалося отримати результат відправки.";
	КонецЕсли;
	
	Отправлено = 0;
	Ошибок     = 0;
	
	Для Каждого Строка Из Получатели Цикл
		
		ИДСообщения = Результат.Получить(Строка.Телефон);
		Если ИДСообщения = Неопределено Или Строка.ИДСообщения <> "" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИДСообщения = "" Тогда
			Строка.СтатусОтправки = "Помилка відправки";
			Ошибок = Ошибок + 1;
		Иначе
			Строка.ИДСообщения    = ИДСообщения;
			Строка.СтатусОтправки = "Відправлено";
			Строка.Отправлять     = Ложь;
			Отправлено = Отправлено + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрШаблон("Відправлено: %1, помилок: %2. Деталі помилок — у журналі логування TurboSMS.",
		Отправлено, Ошибок);
	
КонецФункции

// Подтягивает из журнала статусы по строкам списка.
// ЗапроситьTurboSMS = Истина - сначала обновить статусы в TurboSMS.
&НаСервере
Процедура ОбновитьСтатусыНаСервере(ЗапроситьTurboSMS = Ложь)
	
	Если ЗапроситьTurboSMS Тогда
		tsms_Журнал.ОбновитьСтатусы();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РучнаяРассылка) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Журнал.НомерТелефона КАК НомерТелефона,
		|	Журнал.ИДСообщения КАК ИДСообщения,
		|	Журнал.Статус КАК Статус,
		|	Журнал.ДатаКлика КАК ДатаКлика
		|ИЗ
		|	РегистрСведений.tsms_ЖурналСообщений КАК Журнал
		|ГДЕ
		|	Журнал.РучнаяРассылка = &РучнаяРассылка
		|	И Журнал.СпособОтправки = ЗНАЧЕНИЕ(Перечисление.tsms_СпособыОтправки.Ручная)";
	Запрос.УстановитьПараметр("РучнаяРассылка", РучнаяРассылка);
	
	ПоТелефонам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоТелефонам.Вставить(Выборка.НомерТелефона, Новый Структура("ИДСообщения, Статус, ДатаКлика",
			Выборка.ИДСообщения, Выборка.Статус, Выборка.ДатаКлика));
	КонецЦикла;
	
	Для Каждого СтрокаПолучателя Из Получатели Цикл
		Данные = ПоТелефонам.Получить(СтрокаПолучателя.Телефон);
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПолучателя.ИДСообщения    = Данные.ИДСообщения;
		СтрокаПолучателя.Отправлять     = Ложь;
		СтрокаПолучателя.СтатусОтправки = Строка(Данные.Статус)
			+ ?(ЗначениеЗаполнено(Данные.ДатаКлика), ", клік", "");
	КонецЦикла;
	
КонецПроцедуры

