 КонецЕсли;
 ДатаСтрокой  = ДанныеЕН[0].DeliveryDate.date;
 ДатаСтрокой = Лев(ДатаСтрокой, 19);
 ДатаСтрокой =СтрЗаменить(ДатаСтрокой,"-","");
