Функция ПолучитьТипДокумента(TypeDocument,СлужбаДоставки)
Если TypeDocument ="InternetDocument" Тогда
	Возврат Справочники.eComm_ОбщиеСправочники.InternetDocument;
Иначе
	Запрос = Новый Запрос(
	 "ВЫБРАТЬ
	 |	eComm_ОбщиеСправочники.Ссылка
	 |ИЗ
	 |	Справочник.eComm_ОбщиеСправочники КАК eComm_ОбщиеСправочники
	 |ГДЕ
	 |	НЕ eComm_ОбщиеСправочники.ПометкаУдаления
	 |	И eComm_ОбщиеСправочники.Идентификатор = &Идентификатор
	 |	И eComm_ОбщиеСправочники.СлужбаДоставки = &СлужбаДоставки");
	Запрос.УстановитьПараметр("Идентификатор",TypeDocument); 
	Запрос.УстановитьПараметр("СлужбаДоставки",СлужбаДоставки);
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
	
	НовТип  =Справочники.eComm_ОбщиеСправочники.СоздатьЭлемент();
	НовТип.Родитель = Справочники.eComm_ОбщиеСправочники.ТипыДокументов;
	НовТип.Наименование = TypeDocument;
	
	НовТип.Идентификатор = TypeDocument;
	НовТип.СлужбаДоставки =СлужбаДоставки;
	НовТип.Записать();
	Возврат НовТип.Ссылка;  
КонецЕсли;	
КонецФункции              

// Строка дд.мм.гггг
Функция СтрДата( Строка)
  Длина = СтрДлина(Строка);
  Если Длина <10 тогда
	  Возврат Дата(1,1,1);
  КонецЕсли;
  Год = Сред(Строка,7, 4);
  День = Лев(Строка, 2);
  Месяц = Сред(Строка, 4,2);
  Возврат Дата(Год +Месяц +День);
КОнецФункции

Функция СтрДатаВремя( Строка)
  	
  Длина = СтрДлина(Строка);
  
  Если Сред(Строка, 3,1) ="."  Тогда
	  Возврат СтрДатаВремяП( Строка);
  КонецЕсли;	  
  
  Если Длина <10 тогда
	  Возврат Дата(1,1,1);
  КонецЕсли;
  
  Год = Сред(Строка,1, 4);
  День = Сред(Строка,9, 2);
  Месяц = Сред(Строка, 6,2);
  Час   = Сред(Строка,12,2);
  Минута   = Сред(Строка,15,2);
  Секунда   = Сред(Строка,18,2);
  Возврат Дата(Год +Месяц +День+ Час+Минута+Секунда);
КОнецФункции	


Функция СтрДатаВремяП( Строка)
  Длина = СтрДлина(Строка);
  Если Длина <10 тогда
	  Возврат Дата(1,1,1);
  КонецЕсли;
  Год = Сред(Строка,7, 4);
  День = Сред(Строка,1, 2);
  Месяц = Сред(Строка, 4,2);
  Час   = Сред(Строка,12,2);
  Минута   = Сред(Строка,15,2);
  Секунда   = Сред(Строка,18,2);
  Возврат Дата(Год +Месяц +День+ Час+Минута+Секунда);
КОнецФункции	


Функция СоздатьКонтрагентаВЛичномКабинете(СтруктураНастроек, СтруктураКонтрагента) Экспорт
 
 СтрКонтрагента =Новый Структура;
 СтрКонтрагента.Вставить("FirstName",СтруктураКонтрагента.Имя); 
 СтрКонтрагента.Вставить("MiddleName", СтруктураКонтрагента.Отчество); 
 СтрКонтрагента.Вставить("LastName", СтруктураКонтрагента.Фамилия); 
 Телефон = СтрЗаменить(СтруктураКонтрагента.Телефон, " ","");
 Телефон = СтрЗаменить(Телефон, "+","");
 СтрКонтрагента.Вставить("Phone", Телефон); 
 
 Если ЗначениеЗаполнено(СтруктураКонтрагента.Email) Тогда 
 	СтрКонтрагента.Вставить("Email", СтруктураКонтрагента.Email); 
 КонецЕсли;
 СтрКонтрагента.Вставить("CounterpartyType", СтруктураКонтрагента.ТипКонтрагента);
 СтрКонтрагента.Вставить("CounterpartyProperty", ?(СтруктураКонтрагента.Отправитель, "Sender", "Recipient"));
 
ТелоЗапроса = СформироватьСтрЗапрос("CounterpartyGeneral", "save", СтрКонтрагента, СтруктураНастроек);
ДанныеКонтрагента =	ВыполнитьЗапрос(ТелоЗапроса, СтруктураНастроек);   
Если ЗначениеЗаполнено(ДанныеКонтрагента) Тогда
	Для каждого Стр из ДанныеКонтрагента Цикл 	
		Возврат Стр.Ref;
	КонецЦикла;	
КонецЕсли;
КонецФункции

