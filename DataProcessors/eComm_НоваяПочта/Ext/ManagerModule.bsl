Функция ПолучитьСтруктуруОбмена(Настройки) 
	СтрОбмена = Новый Структура;
	Для каждого Настройка из Настройки Цикл
		 СтрОбмена.Вставить(Настройка.Значение, Настройка.Пометка);
	 КонецЦикла; 
	Возврат СтрОбмена 
КонецФункции	 

Процедура ОбновитьСправочники(СтруктураНастроек) Экспорт
СтрОбмена  = ПолучитьСтруктуруОбмена(СтруктураНастроек.Настройки.ОбновляемыеСправочники);

Если СтрОбмена.Регионы Тогда
	ОбновитьРегионы(СтруктураНастроек);
КонецЕсли;

Если СтрОбмена.НаселенныеПункты Тогда
	ОбновитьНаселенныеПункты(СтруктураНастроек);
КонецЕсли;

Если СтрОбмена.Улицы Тогда
	ОбновитьУлицы(СтруктураНастроек);
КонецЕсли;

Если СтрОбмена.Отделения Тогда
	ОбновитьОтделения(СтруктураНастроек);
КонецЕсли;

Если СтрОбмена.Контрагенты Тогда
	ОбновитьКонтрагентов(СтруктураНастроек);
КонецЕсли;   

Если СтрОбмена.КонтактныеЛицаКонтрагентов Тогда
	ОбновитьКонтактныеЛицаКонтрагентов(СтруктураНастроек);
КонецЕсли; 

Если СтрОбмена.Статусы Тогда
	ОбновитьСтатусыНакладных(СтруктураНастроек);
КонецЕсли;

Если СтрОбмена.ОбщиеСправочники Тогда
	ОбновитьОбшиеСпраовочники(СтруктураНастроек);
КонецЕсли;

КонецПроцедуры

Процедура ОбновитьРегионы(СтруктураНастроек) 
Данные = ЗапросОбласти(СтруктураНастроек);  
ЗарегистрироватьДанныеОбластей(Данные, СтруктураНастроек);	
КонецПроцедуры	

Процедура ОбновитьНаселенныеПункты(СтруктураНастроек)  

//Количество = КоличествоНаселенныеПункты(СтруктураНастроек);
//k =Цел(Количество/100)+1;   
k=1;
Пока k>0 Цикл 
	Страница = Формат(k,"ЧГ=0");
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("Страница", Страница);
	Данные = ЗапросНаселенныеПункты(СтруктураНастроек,СтруктураЗапроса); 
	
	Если Данные =Неопределено Тогда
		Прервать;
	КонецЕсли;   
	
	Если Данные.Количество() =0 Тогда
		Прервать;
	КонецЕсли;
	 k=k+1;
	ЗарегистрироватьНаселенныеПункты(Данные, СтруктураНастроек);
КонецЦикла;	
КонецПроцедуры	

Функция ЗапросГородов(СтруктураНастроек)
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	eComm_НаселенныеПунктыДоставки.Ссылка КАК Город,
|	eComm_НаселенныеПунктыДоставки.Идентификатор КАК Ref
|ИЗ
|	Справочник.eComm_НаселенныеПунктыДоставки КАК eComm_НаселенныеПунктыДоставки
|ГДЕ
|	eComm_НаселенныеПунктыДоставки.СлужбаДоставки = &СлужбаДоставки
|	И НЕ eComm_НаселенныеПунктыДоставки.ПометкаУдаления");
Запрос.УстановитьПараметр("СлужбаДоставки",СтруктураНастроек.СлужбаДоставки);
Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

Процедура ОбновитьУлицы(СтруктураНастроек) 
ДанныеГорода = ЗапросГородов(СтруктураНастроек);   

Для каждого Стр из ДанныеГорода Цикл 
	k =1;
	Пока k >0 Цикл 
		Страница = Формат(k,"ЧГ=0");
		Данные = ЗапросУлицы(Стр, СтруктураНастроек, Страница);
		Если Данные =Неопределено Тогда
			Прервать;
		КонецЕсли;   
		Если Данные.Количество() =0 Тогда
			Прервать;
		КонецЕсли;

		k = k+1;
		ЗарегистрироватьУлицы(Стр.Город, Данные, СтруктураНастроек);
	КонецЦикла;
КонецЦикла;	
КонецПроцедуры

Процедура ОбновитьОтделения(СтруктураНастроек)
ДанныеГорода = ЗапросГородов(СтруктураНастроек);   
Для каждого Стр из ДанныеГорода Цикл
	k =1;
 	Пока k>0 Цикл 
		Страница = Формат(k,"ЧГ=0");	
		Данные = ЗапросОтделения(Стр, СтруктураНастроек, Страница); 
		Если Данные =Неопределено Тогда
			Прервать;
		КонецЕсли;   
		Если Данные.Количество() =0 Тогда
			Прервать;
		КонецЕсли;

		k = k+1;
		
		ЗарегистрироватьОтделения(Данные, СтруктураНастроек, Стр.Город);
	КонецЦикла;
КонецЦикла;	
КонецПроцедуры

Процедура ОбновитьСтатусыНакладных(СтруктураНастроек)
СтрЗапрос =Новый Структура;   
СтрЗапрос.Вставить("Начало", НачалоДня(НачалоДня(ТекущаяДата())-1));
СтрЗапрос.Вставить("Конец", КонецДня(ТекущаяДата()));
СтрЗапрос.Вставить("Создан", ТекущаяДата());
ПолучитьСписокЕН(СтруктураНастроек, СтрЗапрос)	
КонецПроцедуры

Процедура ПолучитьДанныеТрекинга(СтруктураНастроек, ЭкспрессНакладная) экспорт
	
	// получим список Декларация к отслеживанию
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	eComm_ЭкспрессНакладная.НомерТТН КАК DocumentNumber,
	                      |	eComm_ЭкспрессНакладная.ТелефонОтправителя КАК Phone,
	                      |	eComm_ЭкспрессНакладная.УчетнаяЗапись КАК УчетнаяЗапись,
	                      |	eComm_ЭкспрессНакладная.УчетнаяЗапись.КлючAPI КАК УчетнаяЗаписьКлючAPI,
	                      |	eComm_ЭкспрессНакладная.Ссылка
	                      |ИЗ
	                      |	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.eComm_СтатусыЭкспрессНакладных КАК eComm_СтатусыЭкспрессНакладных
	                      |		ПО (eComm_СтатусыЭкспрессНакладных.ЭкспрессНакладная = eComm_ЭкспрессНакладная.Ссылка)
	                      |ГДЕ
	                      |	(eComm_ЭкспрессНакладная.Ссылка = &ЭкспрессНакладная
	                      |			ИЛИ &ЭкспрессНакладная = ЗНАЧЕНИЕ(Документ.eComm_ЭкспрессНакладная.ПустаяСсылка))
	                      |	И НЕ eComm_ЭкспрессНакладная.ПометкаУдаления
	                      |	И НЕ eComm_ЭкспрессНакладная.НомерТТН = """"
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	eComm_ЭкспрессНакладная.НомерТТН,
	                      |	eComm_ЭкспрессНакладная.ТелефонОтправителя,
	                      |	eComm_ЭкспрессНакладная.УчетнаяЗапись,
	                      |	eComm_ЭкспрессНакладная.УчетнаяЗапись.КлючAPI,
	                      |	eComm_ЭкспрессНакладная.Ссылка
	                      |ИТОГИ ПО
	                      |	УчетнаяЗаписьКлючAPI");
	
	Запрос.УстановитьПараметр("ЭкспрессНакладная", ?(ЭкспрессНакладная = неопределено, документы.eComm_ЭкспрессНакладная.ПустаяСсылка(), ЭкспрессНакладная.Ссылка));
	Выборка = Запрос.Выполнить().Выбрать(ОБходРезультатаЗапроса.ПоГруппировкам, "УчетнаяЗаписьКлючAPI");
	Пока Выборка.Следующий() цикл
		
		Выборка0 = Выборка.Выбрать();
		мDocuments = Новый Массив;
		сДокументов = новый Соответствие;
		Пока Выборка0.Следующий() цикл
			 мDocuments.Добавить(новый Структура("DocumentNumber, Phone", Выборка0.DocumentNumber,  Выборка0.Phone));
			 сДокументов.Вставить(Выборка0.DocumentNumber, Выборка0.Ссылка);
		КонецЦикла;
		
		СтруктураНастроек.Вставить("КлючAPI", Выборка.УчетнаяЗаписьКлючAPI);
		
		СтрДокумента = Новый Структура("Documents", мDocuments);
        ТелоЗапроса = СформироватьСтрЗапрос("TrackingDocumentGeneral", "getStatusDocuments", СтрДокумента, СтруктураНастроек);
		Данные = ВыполнитьЗапрос(ТелоЗапроса, СтруктураНастроек);
	
		Для каждого СтруктураОтвета из Данные цикл
		СтруктураЭкспрессНакладной = НОвый Структура();
		СтруктураЭкспрессНакладной.Вставить("ЭкспрессНакладная", сДокументов.Получить(СтруктураОтвета.Number));	
		СтруктураЭкспрессНакладной.Вставить("КодСтатуса", "");	
		СтруктураЭкспрессНакладной.Вставить("ДокументОснование", сДокументов.Получить(СтруктураОтвета.Number).ДокументОснование);	
		eCommДоставкаСервер.ПослеПолученияСтатусаЭкспрессНакладной(СтруктураНастроек, СтруктураЭкспрессНакладной, СтруктураОтвета)
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры
  
