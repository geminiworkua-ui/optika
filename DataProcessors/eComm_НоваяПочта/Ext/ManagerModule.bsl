				Если ДанныеГорода =Неопределено  Тогда 
					Если ДанныеГорода.количество()=0 Тогда
						 Продолжить;   
					КонецЕсли;	
				КонецЕсли;
                ЗарегистрироватьДанныеГородов(ДанныеГорода, СтруктураНастроек);                            
				
                Город = eCommДоставкаСервер.НайтиСоздатьНаселеныйПуктДоставки(СтрГорода); 
		 КонецЕсли;		
	 Иначе
		 Город =ГородЗапроса;
	 КонецЕсли;	 
			
			
		СтруктураСправочника = СформироватьСтруктуруОтделениеДоставки(Стр,СтруктураНастроек, Город); 
		Отделение = eCommДоставкаСервер.НайтиСоздатьОтделенияДоставки(СтруктураСправочника); 
		Отказ =Ложь;
	КонецЦикла;
	
