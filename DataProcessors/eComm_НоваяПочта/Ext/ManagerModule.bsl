Процедура ОбработатьДанныеКонтрагентов(СтруктураНастроек, ТипКонтрагента)
k=1;

Пока k>0 Цикл
 	СтруктураЗапроса =Новый Структура;
	СтруктураЗапроса.Вставить("CounterpartyProperty", ТипКонтрагента);
    СтруктураЗапроса.Вставить("Page", Формат(k,"ЧГ=0"));

  	ТелоЗапроса = СформироватьСтрЗапрос("CounterpartyGeneral", "getCounterparties", СтруктураЗапроса ,СтруктураНастроек );
  
	ДанныеКонтрагентов = ВыполнитьЗапрос(ТелоЗапроса, СтруктураНастроек);
	  
	Если ДанныеКонтрагентов = Неопределено Тогда
		  Прервать;
	КонецЕсли;
	  
	Если ДанныеКонтрагентов.количество() = 0 Тогда
		  Прервать;
	КонецЕсли; 
	  
	Для каждого Данные из ДанныеКонтрагентов Цикл  
  		СтруктураСправочника = СформироватьСтруктуруКонтрагента(Данные, СтруктураНастроек, ТипКонтрагента);
		Контрагент =eCommДоставкаСервер.НайтиСоздатьКонтрагентаСлужбыДоставки(СтруктураНастроек, СтруктураСправочника);  
		Если Контрагент = Неопределено или ТипКонтрагента ="Sender" Тогда
			СтруктураСправочника.Изменять =Истина;
		    Контрагент =eCommДоставкаСервер.НайтиСоздатьКонтрагентаСлужбыДоставки(СтруктураНастроек, СтруктураСправочника);  
		КонецЕсли;	
		АдресаКонтрагента(Данные, ТипКонтрагента, Контрагент, СтруктураНастроек);
    КонецЦикла;
    k=k+1;
	КонецЦикла;
КонецПроцедуры	
 
