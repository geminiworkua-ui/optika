Функция СформироватьСтруктуруКонтрагента(Данные,  СтруктураНастроек, ТипКонтрагента)
	Стр =Новый Структура;   
	Стр.Вставить("Идентификатор", Данные.Ref); 
	
	Стр.Вставить("СлужбаДоставки", СтруктураНастроек.СлужбаДоставки); 
	Стр.Вставить("Владелец", СтруктураНастроек.Ссылка);
	Стр.Вставить("Родитель", НайтиСозлатьРодителяКонтрагента(Данные, СтруктураНастроек));
	Стр.Вставить("Наименование",  Данные.Description); 
	Стр.Вставить("Изменять",  Ложь); 
	
	Если Не Данные.City = "00000000-0000-0000-0000-000000000000" и Не Данные.City = "" Тогда
		СтрНП = новый Структура;
		СтрНП.Вставить("Идентификатор"	, Данные.City);
		СтрНП.Вставить("Изменять"		, Ложь);
		СтрНП.Вставить("СлужбаДоставки" , СтруктураНастроек.СлужбаДоставки);
		Город = eCommДоставкаСервер.НайтиСоздатьНаселеныйПуктДоставки( СтрНП);
		Если Город=Неопределено Тогда
			СтрГорода =  СтрЗарпросаГорода(СтрНП);
			ДанныеГорода = ЗапросГородаДоставки(СтруктураНастроек, СтрГорода);
			ЗарегистрироватьДанныеГородов(ДанныеГорода, СтруктураНастроек); 
		КонецЕсли;	
		Стр.Вставить("НаселенныйПункт", eCommДоставкаСервер.НайтиСоздатьНаселеныйПуктДоставки( СтрНП));     
	КонецЕсли; 
	
	Если Не Данные.CounterpartyType ="Organization" Тогда 
		Если Данные.Свойство("FirstName") Тогда
		    Стр.Вставить("Имя"		, Данные.FirstName);
			Стр.Вставить("Фамилия"	, Данные.LastName);
			Стр.Вставить("Отчество" , Данные.MiddleName);  
		КонецЕсли;
	Иначе
		Если Данные.Свойство("OwnershipFormRef") Тогда
			СтрФС = Новый Структура;
			СтрФС.Вставить("Идентификатор"	, Данные.OwnershipFormRef);
			СтрФС.Вставить("Наименование"	, Данные.OwnershipFormDescription);
			СтрФС.Вставить("Изменять"		, Ложь);
			СтрФС.Вставить("СлужбаДоставки" , СтруктураНастроек.СлужбаДоставки);       
			ФС =  eCommДоставкаСервер.НайтиСоздатьОбщиийСправочник(СтрФС);
			Если ФС = Неопределено Тогда
				СтрФС.Изменять = Истина;	
				ФС =  eCommДоставкаСервер.НайтиСоздатьОбщиийСправочник(СтрФС);
            КонецЕсли;
	        Стр.Вставить("ФормаСобственности", ФС);        
		КонецЕсли;	
	КонецЕсли; 
	
	Стр.Вставить("ЕДРПОУ", Данные.EDRPOU);  
	
	СтрТК = Новый Структура;
	СтрТК.Вставить("Идентификатор", Данные.CounterpartyType);
	СтрТК.Вставить("Наименование", Данные.CounterpartyType);
	СтрТК.Вставить("СлужбаДоставки", СтруктураНастроек.СлужбаДоставки);
	СтрТК.Вставить("Изменять", Ложь);     
	ТК = eCommДоставкаСервер.НайтиСоздатьОбщиийСправочник(СтрТК);
	Если ТК =Неопределено Тогда
		СтрТК.Изменять =Истина;
		ТК = eCommДоставкаСервер.НайтиСоздатьОбщиийСправочник(СтрТК);
	КонецЕсли;	
		
	Стр.Вставить("ТипКонтрагента", ТК);  
	Стр.Вставить("Отправитель", "Sender" = ТипКонтрагента);
    Возврат Стр;
КонецФункции	 
  
