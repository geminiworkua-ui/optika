Функция ОформитьДокумент(ЭкспрессНакладная, СтруктураНастроек) Экспорт 

СтрДокумента = Новый Структура;	
СтрДокумента.Вставить("SenderWarehouseIndex"    , ЭкспрессНакладная.ОтделениеОтправителя.Ключ);
СтрДокумента.Вставить("RecipientWarehouseIndex" , ЭкспрессНакладная.ОтделениеПолучателя.Ключ);
СтрДокумента.Вставить("PayerType"				, ЭкспрессНакладная.ВидПлательщика.Идентификатор);
СтрДокумента.Вставить("PaymentMethod"			, ЭкспрессНакладная.ФормаОплаты.Идентификатор);
СтрДокумента.Вставить("DateTime"				, Формат(ЭкспрессНакладная.Дата,"ДФ=dd.MM.yyyy")); 
СтрДокумента.Вставить("CargoType"				, ЭкспрессНакладная.ТипГруза.Идентификатор);
СтрДокумента.Вставить("VolumeGeneral"			, ?(ЭкспрессНакладная.Объем= 0, 0.0004, ЭкспрессНакладная.Объем));
СтрДокумента.Вставить("Weight"					, ?(ЭкспрессНакладная.Объем= 0,  0.1, ЭкспрессНакладная.Объем));
СтрДокумента.Вставить("ServiceType"				, ЭкспрессНакладная.ТехнологияДоставки.Идентификатор);
СтрДокумента.Вставить("SeatsAmount"				, ?(ЭкспрессНакладная.КоличествоМест=0, 1, ЭкспрессНакладная.КоличествоМест));
СтрДокумента.Вставить("Description"				, ЭкспрессНакладная.ДополнительнаяИнформация);
СтрДокумента.Вставить("Cost"					, ЭкспрессНакладная.ОбъявленнаяСтоимость);
СтрДокумента.Вставить("CitySender"				, ЭкспрессНакладная.НаселенныйПунктОтправителя.Идентификатор);
СтрДокумента.Вставить("Sender"					, ЭкспрессНакладная.Отправитель.Идентификатор);
СтрДокумента.Вставить("SenderAddress"			, ЭкспрессНакладная.Отправитель.Идентификатор);
СтрДокумента.Вставить("ContactSender"			, ЭкспрессНакладная.КонтактноеЛицоОтправителя.Идентификатор);
СтрДокумента.Вставить("SendersPhone"			, "+"+ЭкспрессНакладная.КонтактноеЛицоОтправителя.Телефон);
СтрДокумента.Вставить("CityRecipient"			, ЭкспрессНакладная.НаселенныйПунктПолучателя.Идентификатор);
СтрДокумента.Вставить("Recipient"				, ЭкспрессНакладная.Получатель.Идентификатор);
СтрДокумента.Вставить("RecipientAddress"		, ЭкспрессНакладная.АдресПолучателя.Идентификатор);	
СтрДокумента.Вставить("ContactRecipient"		, ЭкспрессНакладная.КонтактноеЛицоПолучателя.Идентификатор);
СтрДокумента.Вставить("RecipientsPhone"			, "+"+ЭкспрессНакладная.КонтактноеЛицоПолучателя.Телефон);
ТелоЗапроса = СформироватьСтрЗапрос("InternetDocumentGeneral", "save", СтрДокумента, СтруктураНастроек);
ДанныеДокумент = ВыполнитьЗапрос(ТелоЗапроса, СтруктураНастроек);
Возврат ДанныеДокумент; 
КонецФункции

Функция ИзменитьДокумент(ЭкспрессНакладная, СтруктураНастроек, Отказ = Ложь) Экспорт 

СтрДокумента = Новый Структура;
СтрДокумента.Вставить("Ref",	ЭкспрессНакладная.Идентификатор);
СтрДокумента.Вставить("SenderWarehouseIndex"    , ЭкспрессНакладная.ОтделениеОтправителя.Ключ);
СтрДокумента.Вставить("RecipientWarehouseIndex" , ЭкспрессНакладная.ОтделениеПолучателя.Ключ);
СтрДокумента.Вставить("PayerType", ЭкспрессНакладная.ВидПлательщика.Идентификатор);
СтрДокумента.Вставить("PaymentMethod", ЭкспрессНакладная.ФормаОплаты.Идентификатор);
СтрДокумента.Вставить("DateTime", Формат(ЭкспрессНакладная.Дата,"ДФ=dd.MM.yyyy")); 
СтрДокумента.Вставить("CargoType", ЭкспрессНакладная.ТипГруза.Идентификатор);
СтрДокумента.Вставить("VolumeGeneral", ?(ЭкспрессНакладная.Объем= 0, 0.0004, ЭкспрессНакладная.Объем));
СтрДокумента.Вставить("Weight", ?(ЭкспрессНакладная.Объем= 0,  0.1, ЭкспрессНакладная.Объем));
СтрДокумента.Вставить("ServiceType", ЭкспрессНакладная.ТехнологияДоставки.Идентификатор);
СтрДокумента.Вставить("SeatsAmount", ЭкспрессНакладная.КоличествоМест);
СтрДокумента.Вставить("Description",	ЭкспрессНакладная.ДополнительнаяИнформация);

