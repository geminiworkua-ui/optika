Процедура ОбновитьКонтактныеЛицаКонтрагентов(СтруктураНастроек)

//МассивУчетныхЗаписей = eCommДоставкаСервер.ПолучитьУчетныеЗаписиСлужбы(Перечисления.eComm_СлужбыДоставки.НоваяПочта);

//Для каждого УчетнаяЗапись из МассивУчетныхЗаписей Цикл
  	МассивКонтрагентов = ПолучитьМассивКонтрагентов(СтруктураНастроек.Ссылка); 
	//СтруктураНастроек = eCommДоставкаСервер.Настройки(УчетнаяЗапись);

	Для Каждого Данные  из МассивКонтрагентов Цикл   
		K=1;
		Пока K>0 Цикл
			СтруктураЗапросаКЛ =Новый Структура;
		 	СтруктураЗапросаКЛ.Вставить("Ref", Данные.Ref);    
			Страница = Формат(K,"ЧГ=0"); 
		 	СтруктураЗапросаКЛ.Вставить("Page", Страница);
	     	ТелоЗапросаКЛ = СформироватьСтрЗапрос("CounterpartyGeneral", "getCounterpartyContactPersons", СтруктураЗапросаКЛ ,СтруктураНастроек );
		 	НаборДанныеКЛ = ВыполнитьЗапрос(ТелоЗапросаКЛ, СтруктураНастроек); 
		
			Если НаборДанныеКЛ = Неопределено Тогда
				 Прервать;
			КонецЕсли;
			
			Если НаборДанныеКЛ.количество() = 0 Тогда
				 Прервать;
			КонецЕсли;

			
		    Для каждого ДанныеКЛ из НаборДанныеКЛ Цикл
	      		СтруктураСправочника = СформироватьСтруктуруКонтактногоЛица(ДанныеКЛ, СтруктураНастроек, Данные.Контрагент);
	       		КонтактноеЛицо = eCommДоставкаСервер.НайтиСоздатьКонтактноеЛицоКонтрагентаСлужбыДоставки(СтруктураНастроек, СтруктураСправочника);
			КонецЦикла;
			K= K+1;
		КонецЦикла;	
	КонецЦикла;
//КонецЦикла;	
КонецПроцедуры

Функция ПолучитьМассивКонтрагентов(УчентаяЗапись)
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	eComm_КонтрагентыДоставки.Ссылка КАК Контрагент,
|	eComm_КонтрагентыДоставки.Идентификатор КАК Ref
|ИЗ
|	Справочник.eComm_КонтрагентыДоставки КАК eComm_КонтрагентыДоставки
|ГДЕ
|	НЕ eComm_КонтрагентыДоставки.ПометкаУдаления
|	И eComm_КонтрагентыДоставки.Владелец = &УчентаяЗапись
|	И НЕ eComm_КонтрагентыДоставки.ЭтоГруппа");

Запрос.УстановитьПараметр("УчентаяЗапись", УчентаяЗапись);
Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

