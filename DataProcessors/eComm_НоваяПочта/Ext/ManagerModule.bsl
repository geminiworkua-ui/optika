Процедура ОбновитьСтатусы(СтруктураНастроек, ЭкспрессНакладная = Неопределено) Экспорт  
	//Первая Регистрация
    Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	eComm_ЭкспрессНакладная.Ссылка
	|ИЗ
	|	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
	|ГДЕ
	|	eComm_ЭкспрессНакладная.Проведен
	|	И eComm_ЭкспрессНакладная.Идентификатор = """"
	|	И eComm_ЭкспрессНакладная.УчетнаяЗапись = &УчетнаяЗапись");
	Запрос.УстановитьПараметр("УчетнаяЗапись", СтруктураНастроек.Ссылка);
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		
		Документ = Результат.Сссылка.ПолучитьОбъект();
		
		Если Документ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗарегистрироватьДокумент(Документ, СтруктураНастроек);
	КонецЦикла;	
	
	//Ручная Корретировка	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	eComm_ЭкспрессНакладная.Ссылка
	|ИЗ
	|	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
	|ГДЕ
	|	eComm_ЭкспрессНакладная.Проведен
	|	И НЕ eComm_ЭкспрессНакладная.Идентификатор = """"
	|	И eComm_ЭкспрессНакладная.УчетнаяЗапись = &УчетнаяЗапись
	|	И eComm_ЭкспрессНакладная.РучнаяОбработка");
	Запрос.УстановитьПараметр("УчетнаяЗапись", СтруктураНастроек.Ссылка);
	
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		
		Документ = Результат.Сссылка.ПолучитьОбъект();
		
		Если Документ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПеререгистрироватьДокумент(Документ,  СтруктураНастроек);
	КонецЦикла;	
	
	//Ручная Корретировка	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	eComm_ЭкспрессНакладная.Ссылка
	|ИЗ
	|	Документ.eComm_ЭкспрессНакладная КАК eComm_ЭкспрессНакладная
	|ГДЕ
	|	eComm_ЭкспрессНакладная.ПометкаУдаления
	|	И НЕ eComm_ЭкспрессНакладная.Идентификатор = """"
	|	И eComm_ЭкспрессНакладная.УчетнаяЗапись = &УчетнаяЗапись
	|	И eComm_ЭкспрессНакладная.РучнаяОбработка");
	Запрос.УстановитьПараметр("УчетнаяЗапись", СтруктураНастроек.Ссылка);
	
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		
		Документ = Результат.Сссылка.ПолучитьОбъект();
		
		Если Документ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Отказ = Ложь;
		УдалитьДокумент(Документ, СтруктураНастроек, Отказ);
	КонецЦикла;	

	ОбновитьСтатусыНакладных(СтруктураНастроек);  
	
	ПолучитьДанныеТрекинга(СтруктураНастроек, ЭкспрессНакладная);
	
	
КонецПроцедуры

