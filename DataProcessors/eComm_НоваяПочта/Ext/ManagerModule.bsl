	СтрокаОтвета="";
	ОбработатьЗапрос(JSON, СтрокаОтвета, СтруктураНастроек);      
	Если Не СтрокаОтвета ="" Или Не СтрокаОтвета = Неопределено Тогда
		Попытка
			ОтветСтр = ЧтениеJson(СтрокаОтвета);  
		Исключение
			
		КонецПопытки;	
	КонецЕсли;	
КонецПроцедуры	

Функция ВыполнитьЗапрос(ТелоЗапроса, СтруктураНастроек)  
	
	ОтветСтр =Неопределено;                 
	
	ОбработкаЗапроса(ТелоЗапроса, ОтветСтр, СтруктураНастроек); 
	Если ОтветСтр = Неопределено
		Тогда Возврат Неопределено;
	КонецЕсли;
	
	Если ОтветСтр.success Тогда
		возврат ОтветСтр.data;
	КонецЕсли;
	
КонецФункции 

Функция КоличествоВЗапросе(ТелоЗапроса, СтруктураНастроек)  
	
	ОтветСтр =Неопределено;                 
	
	ОбработкаЗапроса(ТелоЗапроса, ОтветСтр, СтруктураНастроек); 
	Если ОтветСтр = Неопределено
