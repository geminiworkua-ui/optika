Функция СформироватьСтрЗапрос(modelName, calledMethod,methodProperties = Неопределено, СтруктураНастроек)
	
	СтруктураТела = Новый Структура;
	
	СтруктураТела.Вставить("apiKey", СтруктураНастроек.КлючAPI);
	СтруктураТела.Вставить("modelName", modelName);
	СтруктураТела.Вставить("calledMethod", calledMethod);  
	Если Не methodProperties = Неопределено Тогда
		СтруктураТела.Вставить("methodProperties", methodProperties);
	КонецЕсли;

	Возврат СформироватьJSON(СтруктураТела);
КонецФункции

Процедура ОбработатьЗапрос(ТелоЗапроса, ОтветСтрока, СтруктураНастроек)
	Ответ = СформироватьЗапрос(ТелоЗапроса, СтруктураНастроек);
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтветСтрока = ответ.ПолучитьТелоКакСтроку();   
КонецПроцедуры	
	
