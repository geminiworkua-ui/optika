
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписок();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура СписокРегионовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбратьЭлементСправочника(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРегионовВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ВыбратьЭлементСправочника(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Процедура ЗаполнитьСписок()

	ТекстXML = Обработки.eComm_Prom.ПолучитьМакет("Регионы").ПолучитьТекст();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстXML);
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда  //Определяем начало элемента
			
			Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
				
				Если ЧтениеXML.Значение = "uk" Тогда 
					НаименованиеНаУкраинском = Истина;
				ИначеЕсли ЧтениеXML.Значение = "ru" Тогда 
					НаименованиеНаРусском = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЧтениеXML.Имя = "id" Тогда 
				
				НовСтр = СписокРегионов.Добавить();
				НовСтр.РегионКод = ЧтениеXML.Значение;
				
				НаименованиеНаУкраинском 	= Ложь;
				НаименованиеНаРусском 		= Ложь;
				
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.Текст Тогда
			
			Если НаименованиеНаУкраинском Тогда 
				НовСтр.РегионUK = ЧтениеXML.Значение;
				НаименованиеНаУкраинском = Ложь;
			ИначеЕсли НаименованиеНаРусском Тогда 
				НовСтр.РегионRU = ЧтениеXML.Значение;
				НаименованиеНаРусском = Ложь;
			КонецЕсли;
			
		КонецЕсли ;
		
	КонецЦикла;
	
	СписокРегионов.Сортировать("РегионUK");

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЭлементСправочника(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("РегионProm", ТекДанные.РегионUK));

КонецПроцедуры


