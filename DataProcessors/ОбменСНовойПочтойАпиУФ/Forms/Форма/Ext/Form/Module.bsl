	РассчитатьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНаСервере()
	Если тзГорода.Количество() = 0 Тогда
		Сообщить("Заполните таблицы справочников НП!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ГородИз) Или Не ЗначениеЗаполнено(ГородВ) Тогда
		Сообщить("Заполните маршрут для расчета!");
		Возврат;
	КонецЕсли;
	РасчетнаяСтоимостьДоставки.Очистить();
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("КлючАПИ",Объект.КлючAPI);
	ПараметрыМетода.Вставить("РефИз",ГородИз);
	ПараметрыМетода.Вставить("РефВ", ГородВ);
	Если ГородИз = ГородВ Тогда
		Женерал = "
		|<GeneralDelivery>true</GeneralDelivery>";
	Иначе
		Женерал = "";
	КонецЕсли;
	Места = "";
	Если ТабПараметрыМестСтр.Количество() > 0 И сокрлп(ВидыГрузаВыб) = "Pallet" Тогда
		Места = Места + "
		|<OptionsSeat>";
		Для Каждого строка Из ТабПараметрыМестСтр Цикл
			Места = Места + "
			|<item>
			|<volumetricVolume>"+строка.Объем+"</volumetricVolume>
			|<volumetricWidth>"+строка.Ширина+"</volumetricWidth>
			|<volumetricLength>"+строка.Длина+"</volumetricLength>
			|<volumetricHeight>"+строка.Высота+"</volumetricHeight>
			|<weight>"+строка.Вес+"</weight>
			|</item>";
		Конеццикла;
		Места = Места + "
		|</OptionsSeat>";
	КонецЕсли;
	ПараметрыМетода.Вставить("Стоимость",СтрЗаменить(Стоимость,Символы.НПП,""));
	ПараметрыМетода.Вставить("Вес",СтрЗаменить(Расчет_Вес,Символы.НПП,""));
	ТекстЗапроса="<?xml version=""1.0"" encoding=""UTF-8"" ?>
	|<root>
	|<modelName>InternetDocument</modelName>
	|<calledMethod>getDocumentPrice</calledMethod>
	|    <methodProperties>
	|    <Sender>{Sender}</Sender>
	|    <CitySender>{CitySender}</CitySender>
	|    <CityRecipient>{CityRecipient}</CityRecipient>"+Женерал+"
	|    <Weight>{Weight}</Weight>"+Места+"
	|    <Cost>{Cost}</Cost>";
	
	Если не ПустаяСтрока(ServiceType) тогда
		ТекстЗапроса=ТекстЗапроса+"
		|    <ServiceType>{ServiceType}</ServiceType>";
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{ServiceType}",сокрлп(ServiceType) );
	КонецЕсли;
	
	Если не ПустаяСтрока(ВидыГрузаВыб) тогда
		ТекстЗапроса=ТекстЗапроса+"
		|    <CargoType>{CargoType}</CargoType>";
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{CargoType}",сокрлп(ВидыГрузаВыб) );
	конецесли;
	
	Если not ПустаяСтрока(SeatsAmount) then
		ТекстЗапроса=ТекстЗапроса+"    
		|<SeatsAmount>"+SeatsAmount+"</SeatsAmount>";
	КонецЕсли;
	
	Если ВидыГрузаВыб = "TiresWheels" Тогда
		ТекстЗапроса=ТекстЗапроса+"        
		|		<CargoDetails>
		|		<item>    
		|		<CargoDescription>"+СокрЛП(Шина)+"</CargoDescription>
		|		<Amount>"+SeatsAmount+"</Amount>
		|		</item>		
		|		</CargoDetails>";		
	Конецесли;
	
	Если RedeliveryCalculate then
		ТекстЗапроса=ТекстЗапроса+"        
		|		<RedeliveryCalculate>
		|          <CargoType>{CargoType}</CargoType>
		|          <Amount>{Amount}</Amount>
		|        </RedeliveryCalculate>";
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{CargoType}",сокрлп(CargoType));
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{Amount}",СтрЗаменить(""+Amount,символ(160),""));
	Конецесли;
	ТекстЗапроса=ТекстЗапроса+"
	|    </methodProperties>
	|<apiKey>{apiKey}</apiKey>
	|</root>";
	
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{CitySender}",ГородИз);
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{CityRecipient}",ГородВ);
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{Cost}",СтрЗаменить(Стоимость,Символы.НПП,""));
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{Weight}",СтрЗаменить(Вес,Символы.НПП,""));
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{apiKey}",Объект.КлючAPI);
	Если тзКонтрагентыОтправители.Количество() > 0 Тогда
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{Sender}",тзКонтрагентыОтправители[0].Идентификатор);
	Иначе
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"{Sender}","");
	КонецЕсли;
	
	ДокументДом  = ПолучитьОтветДОМ(ТочкаВхода,ТекстЗапроса);
	Если  ДокументДом = Неопределено тогда
		Сообщить("Ошибка при получении ответа, метод: getDocumentPrice");
		Возврат;
	КонецЕсли;
	Если не ЭтоУспех(ДокументДом) тогда
		ТекстИсключения = ВернутьЕрор(ДокументДом);
		Сообщить(ТекстИсключения+" getDocumentPrice");
		Возврат;
	КонецЕсли;
	Результат = новый Структура();
	РаспарситьОтвет("Обработать_getDocumentPrice", ДокументДом,Результат, "getDocumentPrice",ПараметрыМетода);		
	
КонецПроцедуры

