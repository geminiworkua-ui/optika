&НаКлиенте
Процедура Расчет_ГородОтправительОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Голова = Врег(ЛЕв(Текст,1));
	Хвост = Сред(Текст,2);
	Текст = Голова+Хвост;
	Города = новый СписокЗначений;
	лонг = СтрДлина(текст);
	Для Каждого строка Из СписокГородов Цикл
		Если Лев(Строка.Представление,лонг) = текст Тогда
			Города.Добавить(Строка.Значение,Строка.Представление);
		КонецЕсли;
	Конеццикла;
	
	
	СтруктураСтарыхЗначений = Новый Структура;
	СтруктураСтарыхЗначений.Вставить("ГородИз",ГородИз);
	СтруктураСтарыхЗначений.Вставить("Расчет_ГородОтправитель",Расчет_ГородОтправитель);
	
	
	Если Города.Количество() = 0 Тогда
		ГородИз 					= "";
		Расчет_ГородОтправитель 	= "";
	Иначе
		Оповещение = Новый ОписаниеОповещения("ВыборРасчет_ГородОтправитель", ЭтаФорма,СтруктураСтарыхЗначений);
		ПоказатьВыборИзСписка(Оповещение,Города);	
	КонецЕсли;
	
КонецПроцедуры

