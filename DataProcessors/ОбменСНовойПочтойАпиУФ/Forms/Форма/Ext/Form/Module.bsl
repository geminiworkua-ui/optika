&НаСервереБезКонтекста
Процедура Пауза(Сек = 1)
	СтартДата = ТекущаяДата();
	ТекДата = СтартДата;
	Пока ТекДата <= (СтартДата + Сек) цикл
		ТекДата = ТекущаяДата();
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура тзРеестрыЕНПечатьНакладных(Команда)
	ТекущийКлюч = Объект.КлючAPI;	
	
	Если СокрЛП(ТекущийКлюч) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	
	ПутьКФормеПечати = ПолучитьПолноеИмяФормы("ФормаПечати");
	
	
	Для Каждого Строка Из тзРеестрыЕН Цикл
		Если строка.Действие Тогда
			
			
			Строка.ДокументРаспечатан = Истина;
			СтруктураОтбора = Новый структура;
			СтруктураОтбора.Вставить("ЕНреф",СокрЛП(Строка.ЕНРеф));
			Строки = тзРеестрДоставок.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()>0 тогда
				Строки[0].ДокументРаспечатан = Истина;
			КонецЕсли;
			
			УРЛ = "https://my.novaposhta.ua/orders/printMarkings/orders[]/" + сокрЛП(Строка.НомерЕН) + "/type/Html/apiKey/" + ТекущийКлюч;  // pdf
			П = Новый Структура;	
			П.Вставить("УРЛ",УРЛ);
			П.Вставить("Заголовок",Строка.НомерРеестра);
			
			ФормаПечати = ОткрытьФорму(ПутьКФормеПечати,П ,ЭтаФорма,Новый УникальныйИдентификатор(),,,,РежимОткрытияОкнаФормы.Независимый);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

