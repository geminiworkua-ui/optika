&НаКлиенте
Процедура ЗагрузитьИОбновитьСправочники(Команда)
	
	
	Если ПустаяСтрока(Объект.КлючAPI) Тогда
		Сообщить("Укажите Ключ API");
		возврат;
	КонецЕсли;
	
	
	Если ТипЗнч(Команда) = Тип("Булево") Тогда
		
		СписокМетодов = ПолучитьСписокМетодов(Команда);
		
		ОчиститьТаблицы(Команда);
		
	Иначе
		
		СписокМетодов = ПолучитьСписокМетодов();
		
		ОчиститьТаблицы();
		
	КонецЕсли;
	
	
	НадписьСостояниеЗагрузки = "Импорт справочников";
	ЭтаФорма.ОбновитьОтображениеДанных(Элементы.НадписьСостояниеЗагрузки);
	
	инд = 0;
	
	Для Каждого ТекМетод из СписокМетодов Цикл
	
	
		инд = инд +1;
		НадписьСостояниеЗагрузки = "Импорт справочников: "+инд + " из " + СписокМетодов.Количество()+ ". "+ТекМетод.Представление;
		
		
		ЗаполнитьСправочникиНП(Неопределено,ТекМетод.Значение);
		
		ЭтаФорма.ОбновитьОтображениеДанных(Элементы.НадписьСостояниеЗагрузки);
		
		ОбработкаПрерыванияПользователя();
		
	КонецЦикла;
	
	НадписьСостояниеЗагрузки = "Сохранение данных ...";
	
	ЭтаФорма.ОбновитьОтображениеДанных(Элементы.НадписьСостояниеЗагрузки);
	
	//Если ЛОЖЬ Тогда
	
	ПроверитьПервыйЗапуск();
	тзКонтрагентыполучатели.Сортировать("Контрагент,ГородИмя");
	тзКонтрагентыОтправители.Сортировать("Контрагент,ГородИмя");
	тзКонтрагентыТретьеЛицо.Сортировать("Контрагент,ГородИмя");
	тзКонтактныеЛица.Сортировать("КонтактноеЛицо");
	тзАдресаКонтрагента.Сортировать("Город");
	
	СохранитьТаблицы();
	
	ЗаполнитьПредставлениеСсылок();	
	
	//КонецЕсли;
	
	НадписьСостояниеЗагрузки = "Загрузка и обновление справочников завершена";
	
	
	
	
	ЭтаФорма.ОбновитьОтображениеДанных(Элементы.НадписьСостояниеЗагрузки);
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьПредставлениеСсылок(ТолькоДанныеКонтрагентов = ЛОЖЬ)	
	
	
	Для Каждого ТекСтрока из тзКонтактныеЛица Цикл
		
		Отбор = Новый Структура("Идентификатор",ТекСтрока.Контрагент);
		
		СтрокиКонтрагенты = тзКонтрагентыОтправители.НайтиСтроки(Отбор);
		Если СтрокиКонтрагенты.Количество() = 0 Тогда
			СтрокиКонтрагенты = тзКонтрагентыполучатели.НайтиСтроки(Отбор);
		КонецЕсли;
		Если СтрокиКонтрагенты.Количество() = 0 Тогда 
			СтрокиКонтрагенты = тзКонтрагентыТретьеЛицо.НайтиСтроки(Отбор);
		КонецЕсли;
		
		
		Если СтрокиКонтрагенты.Количество() = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		ТекСтрока.КонтрагентИмя = СтрокиКонтрагенты[0].Контрагент;
		
	КонецЦикла;
	
	
	
	Для Каждого ТекСтрока из тзПараметрыКонтрагентов Цикл
		
		Отбор = Новый Структура("Идентификатор",ТекСтрока.Контрагент);
		
		
		СтрокиКонтрагенты = тзКонтрагентыОтправители.НайтиСтроки(Отбор);
		Если СтрокиКонтрагенты.Количество() = 0 Тогда
			СтрокиКонтрагенты = тзКонтрагентыполучатели.НайтиСтроки(Отбор);
		КонецЕсли;
		Если СтрокиКонтрагенты.Количество() = 0 Тогда 
			СтрокиКонтрагенты = тзКонтрагентыТретьеЛицо.НайтиСтроки(Отбор);
		КонецЕсли;
		
		
		Если СтрокиКонтрагенты.Количество() = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		ТекСтрока.КонтрагентИмя = СтрокиКонтрагенты[0].Контрагент;
		
	КонецЦикла;
	
	Для Каждого ТекСтрока из тзАдресаКонтрагента Цикл
		
		Отбор = Новый Структура("Идентификатор",ТекСтрока.Контрагент);
		
		
		СтрокиКонтрагенты = тзКонтрагентыОтправители.НайтиСтроки(Отбор);
		Если СтрокиКонтрагенты.Количество() = 0 Тогда
			СтрокиКонтрагенты = тзКонтрагентыполучатели.НайтиСтроки(Отбор);
		КонецЕсли;
		Если СтрокиКонтрагенты.Количество() = 0 Тогда 
			СтрокиКонтрагенты = тзКонтрагентыТретьеЛицо.НайтиСтроки(Отбор);
		КонецЕсли;
		
		
		Если СтрокиКонтрагенты.Количество() = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		ТекСтрока.КонтрагентИмя = СтрокиКонтрагенты[0].Контрагент;
		
	КонецЦикла;
	
	
	Если ТолькоДанныеКонтрагентов = ЛОЖЬ Тогда
		
		Для Каждого ТекСтрока из тзРегионы Цикл
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Идентификатор",ТекСтрока.AreaCenter);
			Строки = тзГорода.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()> 0 Тогда
				ТекСтрока.ЦГород = Строки[0].Наименование;
			КонецЕсли;
		КонецЦикла;
		
		
		Для Каждого ТекСтрока из тзГорода Цикл
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Идентификатор",ТекСтрока.Регион);
			Строки = тзРегионы.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()> 0 Тогда
				ТекСтрока.РегионИмя = Строки[0].Наименование;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекСтрока из тзУлицы Цикл
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Идентификатор",ТекСтрока.Город);
			Строки = тзГорода.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()> 0 Тогда
				ТекСтрока.ГородИмя = Строки[0].Наименование;
			КонецЕсли;
		КонецЦикла;
		
		
		
		Для Каждого ТекСтрока из тзОтделения Цикл
			
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Идентификатор",ТекСтрока.ГородРеф);
			Строки = тзГорода.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()> 0 Тогда
				ТекСтрока.Город = Строки[0].Наименование;
			КонецЕсли;
			
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Идентификатор",ТекСтрока.ТипОтделения);
			Строки = тзТипыОтделений.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()> 0 Тогда
				ТекСтрока.ТипОтделенияИмя = Строки[0].Наименование;
			КонецЕсли;
			
			
		КонецЦикла;
		
		
		Для Каждого ТекСтрока из тзПочтоматы Цикл
			
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Идентификатор",ТекСтрока.ГородРеф);
			Строки = тзГорода.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()> 0 Тогда
				ТекСтрока.Город = Строки[0].Наименование;
			КонецЕсли;
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Идентификатор",ТекСтрока.ТипОтделения);
			Строки = тзТипыОтделений.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()> 0 Тогда
				ТекСтрока.ТипОтделенияИмя = Строки[0].Наименование;
			КонецЕсли;
		КонецЦикла;
		
		
		
		Для Каждого ТекСтрока из тзИнтервалы Цикл
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Идентификатор",ТекСтрока.Город);
			Строки = тзГорода.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()> 0 Тогда
				ТекСтрока.ГородИмя = Строки[0].Наименование;
			КонецЕсли;
			
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаполнитьСписки();
	
	
КонецПроцедуры


&НаСервере
Процедура ЗаписатьТзВОбщиеНастройки(ИмяТЗ)
	
	КлючОбъекта  = "ОбменСНовойПочтойАпи20";
	КлючНастроек = ИмяТЗ;
	ИмяПользователя = ИмяПользователя();
	
