&НаСервере
Процедура СохранитьТаблицы()
	
	КлючОбъекта  = "ОбменСНовойПочтойАпи20";
	КлючНастроек = "";
	ИмяПользователя = "ОбщийПользователь";
	
	СтруктураНастроек = Новый Структура();
	//СтруктураНастроек.Вставить("ПутьКБазе",							Объект.ПутьКБазе);
	//СтруктураНастроек.Вставить("КлючAPI",							Объект.КлючAPI);
	
	СтруктураНастроек.Вставить("тзОтделения",						РеквизитФормыВЗначение("тзОтделения"));
	СтруктураНастроек.Вставить("тзПочтоматы",						РеквизитФормыВЗначение("тзПочтоматы"));
	СтруктураНастроек.Вставить("тзРегионы",							РеквизитФормыВЗначение("тзРегионы"));
