&НаСервере
Процедура тзКорзинаВосстановитьЭННаСервере()
	Текстрока = тзКорзина.НайтиПоИдентификатору(Элементы.тзКорзина.ТекущаяСтрока);
	Если ТекСтрока.Дата < НачалоДня(ТекущаяДата()-86400) Тогда
		Сообщить("Документ восстановить невозможно!");
	Иначе
		Если СокрЛП(Объект.КлючAPI) = "" Тогда
			Сообщить("Не внесен ключ API, функционал недоступен!");
			Возврат;
		КонецЕсли;
		ТекущийКлюч = Объект.КлючAPI;	
		ТекстЗапроса = "<?xml version=""1.0"" encoding=""UTF-8"" ?>
		|<file>
		|<apiKey>"+ТекущийКлюч+"</apiKey>
		|<calledMethod>cancelDeletion</calledMethod>
		|<methodProperties>
		|<DocumentRefs>"+СокрЛП(Текстрока.ЕНреф)+"</DocumentRefs>
		|</methodProperties>
		|<modelName>InternetDocument</modelName>
		|</file>
		|";
		Попытка
			ХМЛХТТП = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
		Исключение
			ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
		КонецПопытки;
		ХМЛХТТП.Open("POST", ТочкаВхода, Ложь);
		ХМЛХТТП.SetRequestHeader("Content-Type", "text/xml");
		ХМЛХТТП.Send(ТекстЗапроса);
		Ответ = ХМЛХТТП.ResponseText;
		Если СтрЧислоВхождений(Ответ,"<success>true</success>") > 0 Тогда
			Сообщить("Документ "+СокрЛП(ТекСтрока.НомерДок)+" восстановлен!");
			НоваяСтрока = тзРеестрДоставок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Текстрока);
			
			//Файл = Новый Файл(Объект.ПутьКБазе+"\Reestr.dbf");   //getAreas
			//Дбф = Новый Xbase;
			//Если Файл.Существует() Тогда
			//	Дбф.ОткрытьФайл(Файл.ПолноеИмя);
			//	Дбф.Первая();
			//	Пока Не ДБФ.ВКонце() Цикл
			//		Если СокрЛП(Дбф.REF) = СокрЛП(Текстрока.ЕНреф) Тогда
			//			Дбф.Del = "N";
			//			Дбф.Записать();
			//		КонецЕсли;
			//		Дбф.Следующая();
			//	конецЦикла;
			//	Дбф.ЗакрытьФайл();
			//КонецЕсли;
			
			
			БылоИзменение = ЛОЖЬ;
			
			Строки_тзReestr =  тзReestr.НайтиСтроки(новый Структура("REF",Текстрока.ЕНреф));
			Для Каждого ТекСтрокаСтроки_тзReestr из Строки_тзReestr Цикл
				ТекСтрокаСтроки_тзReestr.Del = "N";
		        БылоИзменение = Истина;
			КонецЦикла;
			
			Если БылоИзменение Тогда
				ЗаписатьТзВОбщиеНастройки("тзReestr");
			КонецЕсли;

			
			
			
			
			
			ЗаполнитьРеестры();
			ОбновитьСтатусы();
		Иначе
			Сообщить(СформироватьТекстОшибки(Ответ));
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

