	Конеццикла;
	СписокФормСобственности = новый СписокЗначений;
	Для Каждого строка Из тзФормыСобственности Цикл
		СписокФормСобственности.Добавить(Строка.Идентификатор,Строка.Наименование);
	Конеццикла;
	СписокТипов = новый СписокЗначений;
	Для Каждого строка Из тзТипыКонтрагентов Цикл
		СписокТипов.Добавить(Строка.Идентификатор,Строка.Наименование);
	Конеццикла;
	
	П.Вставить("СписокГородов", 			СписокГородов);
	П.Вставить("СписокВидов", 				СписокВидов);
	П.Вставить("СписокФормСобственности", 	СписокФормСобственности);
	П.Вставить("СписокТипов", 				СписокТипов);
	
	П.Вставить("ТекущийКлюч", 				ТекущийКлюч);
	П.Вставить("Идентификатор", 			сокрЛП(СтрокаКонтрагента.Идентификатор));
	П.Вставить("Контрагент", 				сокрЛП(СтрокаКонтрагента.Контрагент));
	П.Вставить("Город", 					сокрЛП(СтрокаКонтрагента.ГородИмя));
	П.Вставить("ГородАд", 					сокрЛП(СтрокаКонтрагента.ГородИмя));
	П.Вставить("ГородИн", 					сокрЛП(СтрокаКонтрагента.Город));
	П.Вставить("ФормаСобственности", 		сокрЛП(СтрокаКонтрагента.ФормаСобственности));
	П.Вставить("ФормаСобственностиИн", 		сокрЛП(СтрокаКонтрагента.ФормаСобственностиRef));
	П.Вставить("ТипКонтрагентаИн", 			сокрЛП(СтрокаКонтрагента.ТипКонтрагента));
	
	Отбор = новый структура;
	Отбор.Вставить("Идентификатор",СокрЛП(СтрокаКонтрагента.ТипКонтрагента));
	строки = тзТипыКонтрагентов.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		ТипКонтрагента = Строки[0].Наименование;
	Иначе
		ТипКонтрагента = СтрокаКонтрагента.ТипКонтрагента;
	КонецЕсли;
	
	П.Вставить("ТипКонтрагента",ТипКонтрагента);
	П.Вставить("Имя", 				 сокрЛП(СтрокаКонтрагента.Имя));
	П.Вставить("Фамилия", 			 сокрЛП(СтрокаКонтрагента.Фамилия));
	П.Вставить("Отчество", 			 сокрЛП(СтрокаКонтрагента.Отчество));
	П.Вставить("ЕДРПОУ",			 сокрЛП(СтрокаКонтрагента.ЕДРПОУ));
	П.Вставить("ВидКонтрагентаИн", 	 ВидКонтрагента);
	
	Отбор = новый структура;
	Отбор.Вставить("Идентификатор",ВидКонтрагента);
	строки = тзТипыПлательщиков.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		ВидКонтрагента = Строки[0].Наименование;
	Иначе
		ВидКонтрагента = ВидКонтрагента;
	КонецЕсли;
	
	П.Вставить("ВидКонтрагента", ВидКонтрагента);
	
	//ФормаКонтрагента.тзОшибки = тзОшибки;
	
	ПутьКФормеРедактирования = ПолучитьПолноеИмяФормы("ФормаКонтрагента");
	
	Оповещение = Новый ОписаниеОповещения("КонтрагентыИзменениеДанных", ЭтаФорма);
	
	ФормаКонтрагента = ОткрытьФорму(ПутьКФормеРедактирования,П ,ЭтаФорма,,,,Оповещение);
	
	
конецпроцедуры

