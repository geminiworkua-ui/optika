		Если строки.Количество() > 0 Тогда
			Sender_1 = Строки[0].Контрагент;
		конецЕсли;
		
		CitySender1 = СокрЛП(СтрокаТЗ.CSender);
		СтруктураПоиска.Вставить("Идентификатор",CitySender1);
		Строки = тзГорода.НайтиСтроки(СтруктураПоиска);
		Если строки.Количество() > 0 Тогда
			CitySender_1 = Строки[0].Наименование;
		конецЕсли;
		
		WarhousOut1 = СокрЛП(СтрокаТЗ.Warhous);
