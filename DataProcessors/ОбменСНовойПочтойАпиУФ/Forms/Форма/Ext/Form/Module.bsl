	СтруктураСтарыхЗначений = Новый Структура;
	СтруктураСтарыхЗначений.Вставить("ГородИз",ГородИз);
	СтруктураСтарыхЗначений.Вставить("Расчет_ГородОтправитель",Расчет_ГородОтправитель);
	
	Оповещение = Новый ОписаниеОповещения("ВыборРасчет_ГородОтправитель", ЭтаФорма,СтруктураСтарыхЗначений);
	ПоказатьВыборИзСписка(Оповещение,СписокГородов);	
КонецПроцедуры

&НаКлиенте 
Процедура ВыборРасчет_ГородОтправитель(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = Неопределено Тогда
		
		ГородИз				 = ПараметрыОповещения.ГородИз;
		Расчет_ГородОтправитель = ПараметрыОповещения.Расчет_ГородОтправитель;
		
		Возврат;
	КонецЕсли;
	
	ГородИз 				= Результат.Значение;
	Расчет_ГородОтправитель= Результат.Представление;
	
	ОбнулитьРасчетнаяСтоимостьДоставки();

	ЭтаФорма.ТекущийЭлемент = Элементы.Расчет_ГородПолучатель;
	
