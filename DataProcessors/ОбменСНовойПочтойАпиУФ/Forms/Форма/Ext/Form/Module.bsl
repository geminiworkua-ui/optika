&НаСервере
Процедура ПроставитьПечатьЕН()
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	ТекущийКлюч = Объект.КлючAPI;
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("КлючАПИ",ТекущийКлюч);
	Если тзРеестрДоставок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	//ТабДат = тзРеестрДоставок.Скопировать(,"Дата");
	
	ТабДат = РеквизитФормыВЗначение("тзРеестрДоставок").Скопировать(,"Дата");
	
	
	ТабДат.Сортировать("Дата Возр");
	ДатаС = Формат(ТабДат[0].Дата,"ДФ=dd.MM.yyyy");
	ДатаПо = Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	
	ТекстЗапроса = "<root>
	|<apiKey>"+СокрЛП(ТекущийКлюч)+"</apiKey>
	|<modelName>InternetDocument</modelName>
	|<calledMethod>getDocumentList</calledMethod>
	|<methodProperties>
	|<DateTimeFrom>"+ДатаС+"</DateTimeFrom>
	|<DateTimeTo>"+ДатаПо+"</DateTimeTo>
	|<GetFullList>1</GetFullList>
	|</methodProperties>
	|</root>";
	Если ТекстЗапроса = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	
	ДокументДом  = ПолучитьОтветДОМ(ТочкаВхода,ТекстЗапроса);
	Если  ДокументДом = Неопределено тогда
		Сообщить("Ошибка при получении списка документов!");
	КонецЕсли;
	Если не ЭтоУспех(ДокументДом) тогда
		ТекстИсключения = ВернутьЕрор(ДокументДом);
		Сообщить(ТекстИсключения+", ошибка при получениии списка документов");
	КонецЕсли;
	Результат = новый Структура();
	РаспарситьОтвет("Обработать_getDocumentListПечать", ДокументДом, Результат, "getDocumentList", ПараметрыМетода);
КонецПроцедуры

&НаСервере
Процедура ПроставитьПечатьРеестров()
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	ТекстЗапроса = 
	"<file>
	|<apiKey>"+СокрЛП(Объект.КлючAPI)+"</apiKey>
	|<modelName>ScanSheet</modelName>
	|<calledMethod>getScanSheetList</calledMethod>
	|</file>";
	Ответ=GetXMLResponserNewPost(ТекстЗапроса);
	Если СтрЧислоВхождений(Ответ,"<success>true</success>") Тогда
		Чтение=новый ЧтениеXML;
		Чтение.УстановитьСтроку(Ответ);
		РЕф = "";
		Печать = "0";
		Строки = Новый Массив;
		Пока Чтение.Прочитать() Цикл
			Если чтение.Имя="Ref" and чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента тогда
				чтение.Прочитать();
				РЕф = СокрЛП(чтение.Значение);
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("РефРеестра",Реф);
				Строки = тзРеестры.НайтиСтроки(СтруктураОтбора);
			ИначеЕсли чтение.Имя="Printed" and чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента тогда
				чтение.Прочитать();
				Печать = СокрЛП(чтение.Значение);
				Если Строки.Количество() > 0 Тогда
					Строки[0].Распечатан = ?(Печать = "0",Ложь,Истина);
				КонецЕсли;
			КонецЕсли;
		Конеццикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусы()
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	
	
	Если тзРеестрДоставок.Количество() > 0 Тогда
		//Кво = тзРеестрДоставок.Количество()-1;
		ТекущийКлюч = Объект.КлючAPI;
		ПараметрыМетода = Новый Структура;
