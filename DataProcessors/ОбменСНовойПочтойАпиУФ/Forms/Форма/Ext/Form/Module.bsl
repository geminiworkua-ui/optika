&НаКлиенте
Процедура ПроверитьФормуОплаты()
	
	Если PForm = "Cash"
		или PayerType = "ThirdPerson" и PForm = "NonCash"
		
		Тогда
		Возврат;
	КонецЕсли;
	
	Если PayerType = "Sender" Тогда
		Контрагент = Sender;
	ИначеЕсли PayerType = "Recipient" Тогда
		Контрагент = Recipient;
	ИначеЕсли PayerType = "ThirdPerson" Тогда
		Контрагент = Person3;
	Иначе
		Возврат;
	КонецЕсли;
		
	
	Строки = тзПараметрыКонтрагентов.НайтиСтроки(Новый Структура("Контрагент",Контрагент));
	Если Строки.Количество() = 0 Тогда
		
		PForm = "Cash";
		PForm_ = "Готівка";
		Сообщить("Форма оплаты ""Безготівковий"" не разрешена");
	
		Возврат;
	Иначе
		
		Строка = Строки[0];
		
	КонецЕсли;
	
	Если PForm = "NonCash" Тогда
		Если Строка.РасчетБезнал = ЛОЖЬ Тогда
			PForm = "Cash";
			PForm_ = "Готівка";
			Сообщить("Форма оплаты ""Безготівковий"" не разрешена");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


