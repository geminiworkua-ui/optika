&НаКлиенте 
Процедура УстановитьВидимостьПоТипуГруза()
	Элементы.ЭПалета.Доступность = Ложь;
	
	Элементы.Вес.Доступность = Истина;
	Элементы.Мест.Доступность = Истина;
	
	
	Если CargoType = "TiresWheels" Тогда
		Элементы.Объем.Видимость 			= Ложь;
		Элементы.ОписаниеГруза.Видимость 	= Истина;
		Элементы.Amount.Видимость 			= Истина;
		
		Элементы.Вес.Доступность = Ложь;
		Элементы.Мест.Доступность = Ложь;
	
		
	ИначеЕсли CargoType = "Pallet" Тогда
		Элементы.Объем.Видимость = Ложь;
		Элементы.ОписаниеГруза.Видимость = Истина;
		Элементы.Amount.Видимость = Истина;
		Элементы.ЭПалета.Доступность = Истина;
		
	ИначеЕсли CargoType = "Documents" Тогда
		Элементы.Объем.Видимость = Ложь;
		Элементы.ОписаниеГруза.Видимость = Ложь;
		Элементы.Amount.Видимость = Ложь;
	Иначе
		Элементы.Объем.Видимость = Истина;
		Элементы.ОписаниеГруза.Видимость = Ложь;
		Элементы.Amount.Видимость = Ложь;
	КонецЕсли;
	
	Если Расчет_Тип = "Грошовий переказ" тогда
		Элементы.Расчет_Количество.Видимость = Истина;
	Иначе		
		Элементы.Расчет_Количество.Видимость = ЛОЖЬ;
	конецЕсли;
	
	
	
	
	
КонецПроцедуры


&НаКлиенте 
Процедура ВыборCargoType_(Результат, ПараметрыОповещения) Экспорт
	Если Результат = Неопределено Тогда
		
		CargoType = "";
		CargoType_= "";
		
		Возврат;
	КонецЕсли;

	CargoType = Результат.Значение;
	CargoType_= Результат.Представление;
	
	CargoDesc = "";
	Amount = 0;	
	Вес = 0;
	Мест = 0;
	
	ТабПараметрыМестСтр.Очистить();
	УстановитьВидимостьПоТипуГруза();
	
	Элементы.ЭПалета.Доступность = ЛОЖЬ;
	ЭПалета = ЛОЖЬ;
	Если CargoType = "TiresWheels" Тогда
		Объем = 0;
		Элементы.Объем.Видимость 			= Ложь;
		Элементы.ОписаниеГруза.Видимость 	= Истина;
		Элементы.Amount.Видимость 			= Истина;

		
		DescriptionCargo = "Шини-Диски";
		
		
		Оповещение = Новый ОписаниеОповещения("ВыборCargoType_TiresWheels", ЭтаФорма);
		ПоказатьВыборИзМеню(Оповещение,сзШины,Элементы.ОписаниеГруза);	
		
	ИначеЕсли CargoType = "Pallet" Тогда
		Объем = 0;
		Элементы.Объем.Видимость = Ложь;
		Элементы.ОписаниеГруза.Видимость = Истина;
		Элементы.Amount.Видимость = Истина;
		Элементы.ЭПалета.Доступность = Истина;
		
		
		Оповещение = Новый ОписаниеОповещения("ВыборCargoType_Pallet", ЭтаФорма);
		ПоказатьВыборИзМеню(Оповещение,сзВидыПаллет,Элементы.ОписаниеГруза);	
	ИначеЕсли CargoType = "Documents" Тогда
		Объем = 0;
		Элементы.Объем.Видимость = Ложь;
		Элементы.ОписаниеГруза.Видимость = Ложь;
		Элементы.Amount.Видимость = Ложь;

		
		ОписаниеГруза = "";
		CargoDesc = "";
		Amount = 0;	
		
		СписокВеса = Новый СписокЗначений;
		СписокВеса.Добавить(0.1);
		СписокВеса.Добавить(0.5);
		СписокВеса.Добавить(1.0);

		Оповещение = Новый ОписаниеОповещения("ВыборCargoType_Documents", ЭтаФорма);
		ПоказатьВыборИзМеню(Оповещение,СписокВеса,Элементы.Вес);	
		
	Иначе
		Элементы.Объем.Видимость = Истина;
		Элементы.ОписаниеГруза.Видимость = Ложь;
		Элементы.Amount.Видимость = Ложь;

		
		ОписаниеГруза = "";
		CargoDesc = "";
		Amount = 0;
	КонецЕсли;
	
	Если Вес > 30 и CargoType = "Parcel" Тогда
		CargoType  = "Cargo";
		CargoType_ = "Вантаж";
		
		ВидыГрузаВыб 		= CargoType;
		Расчет_ВидГруза 	= CargoType_;
		
	ИначеЕсли Вес <= 30 и CargoType = "Cargo" Тогда	
		CargoType  = "Parcel";
		CargoType_ = "Посилка";
		
		ВидыГрузаВыб 		= CargoType;
		Расчет_ВидГруза 	= CargoType_;
			
			
			
			
	КонецЕсли;
	
	
	
	УстановитьВидимостьПоТипуГруза();
	УстановитьДоступностьПоПараметрамМест();
КонецПроцедуры

