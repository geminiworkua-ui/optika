&НаКлиенте 
Процедура ВыборРасчет_ВидГруза(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбнулитьРасчетнаяСтоимостьДоставки();
	
	Элементы.Расчет_Вес.РежимВыбораИзСписка = ЛОЖЬ;
	Элементы.Расчет_Вес.КнопкаВыбора = Истина;
	Элементы.Расчет_Вес.РедактированиеТекста = Истина;
	
	Элементы.ЭПалета.Доступность = ЛОЖЬ;
	
	
	ВидыГрузаВыб = Результат.Значение;
	Расчет_ВидГруза = Результат.Представление;
	ЭПалета = ЛОЖЬ;
	
	CargoType 	= Результат.Значение;
	CargoType_ 	= Результат.Представление;
	
	
	Если ВидыГрузаВыб = "TiresWheels" Тогда
		
		//ВидыГрузаВыб 		= "";
		//Расчет_ВидГруза 	= "";
		
		ВидыГрузаВыб 		= Результат.Значение;
		Расчет_ВидГруза 	= Результат.Представление;
		
		Оповещение = Новый ОписаниеОповещения("ВыборРасчет_ВидГрузаШиныДиски", ЭтаФорма);
		ПоказатьВыборИзМеню(Оповещение,сзШины);	
		
		
	ИначеЕсли  ВидыГрузаВыб = "Pallet" тогда
		Сообщить("Для расчета стоимости доставки палет необходимо ввести количество мест и параметры!");
		//CargoType 	= Результат.Значение;
		//CargoType_ 	= Результат.Представление;
		Объем 		= 0;
		
		Элементы.ЭПалета.Доступность = Истина;
		
		ВидыГрузаВыб 		= Результат.Значение;
		Расчет_ВидГруза 	= Результат.Представление;
		
		Оповещение = Новый ОписаниеОповещения("ВыборРасчет_ВидГрузаПалеты", ЭтаФорма);
		ПоказатьВыборИзМеню(Оповещение,сзВидыПаллет);	
		
	ИначеЕсли ВидыГрузаВыб =  "Documents" Тогда
		Элементы.Расчет_КоличествоМест.Заголовок = "Количество мест";
		Элементы.Расчет_Вес.Доступность = Истина;
		
		Элементы.Расчет_Вес.РежимВыбораИзСписка = Истина;
		Элементы.Расчет_Вес.КнопкаВыбора = ЛОЖЬ;
		Элементы.Расчет_Вес.РедактированиеТекста = ЛОЖЬ;
		
		Расчет_Вес = 0;
		
		Элементы.Расчет_Вес.СписокВыбора.Очистить();
		Элементы.Расчет_Вес.СписокВыбора.Добавить(0.1);
		Элементы.Расчет_Вес.СписокВыбора.Добавить(0.5);
		Элементы.Расчет_Вес.СписокВыбора.Добавить(1);
		
	Иначе
		
		Элементы.Расчет_КоличествоМест.Заголовок = "Количество мест";
		Элементы.Расчет_Вес.Доступность = Истина;
		
	КонецЕсли;
	
	
	Если Расчет_Вес > 30 и ВидыГрузаВыб = "Parcel" Тогда
		CargoType  = "Cargo";
		CargoType_ = "Вантаж";
		
		ВидыГрузаВыб 		= CargoType;
		Расчет_ВидГруза 	= CargoType_;
		
		
		
	ИначеЕсли Расчет_Вес <= 30 и ВидыГрузаВыб = "Cargo"	Тогда
		CargoType  = "Parcel";
		CargoType_ = "Посилка";
		
		ВидыГрузаВыб 		= CargoType;
		Расчет_ВидГруза 	= CargoType_;
		
		
		
		
		КонецЕсли;
	
	
	
	
КонецПроцедуры

