Процедура ВыборCargoType_TiresWheels(Результат, ПараметрыОповещения) Экспорт
	Если Результат <> Неопределено Тогда
		ОписаниеГруза = Результат.Представление;
		CargoDesc = Результат.Значение;
		Amount = 4;
		
		СтрокиШин = тзШины.НайтиСтроки(Новый Структура("Идентификатор",Результат.Значение));
		Если СтрокиШин.Количество() > 0 Тогда
			ВесШины = СтрокиШин[0].Вес;
			
			
			Вес = ВесШины*Amount;
			Мест = Amount;
		КонецЕсли;
		
		
		
	Иначе
		ОписаниеГруза = "";
		CargoDesc = "";
		Amount = 0;
	КонецЕсли;
КонецПроцедуры

