		ЭтаФорма.ТекущийЭлемент = Элементы.ТабПараметрыМестСтр;
		
		ТабПараметрыМестСтр.Очистить();
		МассивСтрок = тзВидыПаллет.НайтиСтроки(Новый Структура("Идентификатор",Результат.Значение));
		Если МассивСтрок.Количество() > 0 тогда
			
			НоваяСтрока = ТабПараметрыМестСтр.Добавить();
			НоваяСтрока.Вес = МассивСтрок[0].Вес;	
			Расчет_Вес = МассивСтрок[0].Вес;
		КонецЕсли;
		
		
		
	Иначе
		ОписаниеГруза = "";
		CargoDesc = "";
		Amount = 0;
	КонецЕсли;	
	
КонецПроцедуры

