&НаКлиенте
Функция ПроверитьВесНаМесто(Знач Вес_, Знач Мест_, ПроверкаТЧ= ЛОЖЬ)
	
	ВесНаМесто = Вес_/?(Мест_ = 0,1,Мест_); 
	
	Если ВесНаМесто > 1100 Тогда
		Сообщить("Вес одного места не может быть больше 1100 кг");
		Возврат 0;
	КонецЕсли;
	
	СтрокиСклад = тзОтделения.НайтиСтроки(Новый Структура("Идентификатор",WarhousIn));
	Если СтрокиСклад.Количество() = 0 Тогда
		СтрокиСклад = тзПочтоматы.НайтиСтроки(Новый Структура("Идентификатор",WarhousIn));
	КонецЕсли;
	
	Если СтрокиСклад.Количество() = 0 Тогда
		Возврат Вес_;
	КонецЕсли;
	
	МаксимальныйВесМеста = СтрокиСклад[0].МаксимальныйВесМеста;
	ОбщийМаксимальныйВес = СтрокиСклад[0].ОбщийМаксимальныйВес;
	
	
	Если МаксимальныйВесМеста <> 0 и ВесНаМесто > МаксимальныйВесМеста Тогда
		Сообщить("Отделение получателя имеет ограничение по весу до "+МаксимальныйВесМеста+" кг на одно место");
		Возврат 0;
	КонецЕсли;
	
	
	Если ПроверкаТЧ тогда 
		ПроверяемыйВес =  ТабПараметрыМестСтр.Итог("Вес");
	Иначе
		ПроверяемыйВес = Вес_;
	КонецЕсли;	
	
	
	Если ОбщийМаксимальныйВес <> 0 и ПроверяемыйВес > ОбщийМаксимальныйВес Тогда
		Сообщить("Отделение получателя имеет ограничение по весу до "+ОбщийМаксимальныйВес+" кг.");
		Возврат 0;
	КонецЕсли;
	
	
	Возврат Вес_;
	
КонецФункции


