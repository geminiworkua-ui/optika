		СтрокатзDraft.nomup 		= СокрЛП(НомерУпаковки);
		СтрокатзDraft.vnum 			= СокрЛП(ВНомерЗаказа);
		СтрокатзDraft.sday 			= ?(Суббота = Истина,"Y","N");
		СтрокатзDraft.floor 		= Этаж;
		СтрокатзDraft.epalet 		= ?(ЭПалета = Истина,"Y","N");
		СтрокатзDraft.Elevator 		= ?(Лифт = Истина,"Y","N");
		
		СтрокатзDraft.adddoc 		= СокрЛП(СопровДок);
		СтрокатзDraft.addinf 		= СокрЛП(ДопИнф);
		СтрокатзDraft.prefdeld 		= Формат(ЖДД);
		СтрокатзDraft.interval 		= Интервал;
		СтрокатзDraft.redelstr 		= СокрЛП(RedeliveryString);
		СтрокатзDraft.redelpay 		= СокрЛП(PayerRedel);
		СтрокатзDraft.redelsum 		= SumRedeliv;
		СтрокатзDraft.sameday 		= ?(ДеньВДень = Истина,"Y","N");
		СтрокатзDraft.takeatt 		= ?(ЛичноВРуки = Истина,"Y","N");
		СтрокатзDraft.sh 			= Признак;
		
		
		ЗаписатьТзВОбщиеНастройки("тзDraft");
		ШаблонРеф = Реф;
		Возврат(Наименование);		
	
	
КонецФункции


