&НаСервере
Процедура ПереименоватьУдалитьШаблонЧерновик(ИдентификаторТекущейСтроки,Признак,Наименование = "",Действие,ИмяТЧ);
	
	ТекСтрока = ЭтаФорма[ИмяТЧ].НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	CargoType = "";
	pform = "";
	
	//Дбф = Новый Xbase;
	//Файл = Новый Файл(Объект.ПутьКБазе+"\Draft.dbf");
	//CargoType = "";
	//pform = "";
	//Если Файл.Существует() Тогда
	//	Дбф.ОткрытьФайл(Файл.ПолноеИмя);
	//	Дбф.Первая();
	//	Пока Не Дбф.ВКонце() Цикл
	//		Если СокрЛП(Дбф.name) = СокрЛП(ТекСтрока.Наименование) И  СокрЛП(Дбф.sh) = Признак И СокрЛП(Дбф.recip) =  СокрЛП(ТекСтрока.Получатель)
	//			И  СокрЛП(Дбф.sender) =  СокрЛП(ТекСтрока.Отправитель) И  СокрЛП(Дбф.descargo) =  СокрЛП(ТекСтрока.Груз) Тогда
	//			Если Наименование = "" Тогда
	//				Дбф.Удалить();
	//			Иначе
	//				Дбф.name = Наименование;
	//				CargoType = СокрЛП(Дбф.cargtype);
	//				pform = сокрЛП(Дбф.pform);
	//			КонецЕсли;
	//			Дбф.Записать();
	//		КонецЕсли;
	//		Дбф.Следующая();
	//	КонецЦикла;
	//	Дбф.Сжать();
	//	Дбф.ЗакрытьФайл();
	//КонецЕсли;
	
	Отбор = новый Структура;
	Отбор.Вставить("name",СокрЛП(ТекСтрока.Наименование));
	Отбор.Вставить("sh",Признак);
	Отбор.Вставить("recip",СокрЛП(ТекСтрока.Получатель));
	Отбор.Вставить("sender", СокрЛП(ТекСтрока.Отправитель));
	Отбор.Вставить("descargo",СокрЛП(ТекСтрока.Груз));
	
	
	СтрокиТЗ = тзDraft.НайтиСтроки(Отбор);
	БылоИзменение = ЛОЖЬ;
	
	Для Каждого ТекСтрокаСтрокиТЗ из СтрокиТЗ Цикл
		Если Наименование = "" Тогда
			тзDraft.Удалить(ТекСтрокаСтрокиТЗ);
			БылоИзменение = Истина;
			
		Иначе
			ТекСтрокаСтрокиТЗ.name = Наименование;
			CargoType = СокрЛП(ТекСтрокаСтрокиТЗ.cargtype);
			pform = сокрЛП(ТекСтрокаСтрокиТЗ.pform);
			БылоИзменение = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если БылоИзменение Тогда
		ЗаписатьТзВОбщиеНастройки("тзDraft");
	КонецЕсли;

	
	
	
	Если Признак = "S" тогда
		Если Действие = "Удалить" Тогда
			Запрос = "<?xml version=""1.0"" encoding=""UTF-8"" ?>
			|<file>
			|<modelName>InternetDocumentTemplate</modelName>
			|<calledMethod>delete</calledMethod>                
			|<methodProperties>
			|<DocumentRefs><item>"+СокрЛП(ТекСтрока.Идентификатор)+"</item></DocumentRefs> 
			|</methodProperties>
			|<apiKey>"+Объект.КлючAPI+"</apiKey>
			|</file>";
			Ответтекст = GetXMLResponserNewPost(запрос);
			Если СтрЧислоВхождений(Ответтекст,"<success>true</success>") Тогда
				Сообщить("Шаблон удален!");
			Иначе
				Сообщить(СформироватьТекстОшибки(Ответтекст));
			КонецЕсли;
		иначеЕсли
			Действие = "Переименовать" Тогда
			Запрос = "<?xml version=""1.0"" encoding=""UTF-8"" ?>
			|<file>
			|<modelName>InternetDocumentTemplate</modelName>
			|<calledMethod>update</calledMethod>                
			|<methodProperties>
			|<Ref>"+СокрЛП(ТекСтрока.Идентификатор)+"</Ref>
			|<DescriptionTemplate>"+Наименование+"</DescriptionTemplate>
			|<PaymentMethod>"+pform+"</PaymentMethod>
			|<CargoType>"+CargoType+"</CargoType>
			|</methodProperties>
			|<apiKey>"+Объект.КлючAPI+"</apiKey>
			|</file>";
			Ответтекст = GetXMLResponserNewPost(запрос);
			Если СтрЧислоВхождений(Ответтекст,"<success>true</success>") Тогда
				Сообщить("Шаблон перименован!");
			Иначе
				Сообщить(СформироватьТекстОшибки(Ответтекст));
			КонецЕсли;
		КонецЕсли;
	Конецесли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаНаУдалениеЧерновика(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	структураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Действие",Истина);
	Строки = тзЧерновики.НайтиСтроки(СтруктураОтбора);
	
	
	Если Строки.Количество() = 0 Тогда 
		Сообщить("Выберите черновики для удаления");
		Возврат;
	КонецЕсли;
	
	
	Для Каждого ТекСтрока Из Строки Цикл
		ПереименоватьУдалитьШаблонЧерновик(ТекСтрока.ПолучитьИдентификатор(),"D",,"Удалить","тзЧерновики");
	КонецЦикла;
	ОбновитьШаблонЧерновик();
	
	
КонецПроцедуры

