		ИначеЕсли
			ServiceType = "WarehouseDoors" Тогда
			ServiceType = "WarehouseWarehouse";
			ServiceType_ = "Відділення-Відділення";
		КонецЕсли;
		УстановитьВидимостьПоДоставке();
	конецЕсли;
	
	
	П = Новый Структура;
	
	СписокКолонок = Новый СписокЗначений;
	
	СписокКолонок.Добавить("Наименование",		"Наименование",		Истина);
