		Элементы.RecipientAddress_.Видимость = Истина;
		
		WarhousOut_ = "";
		WarhousOut 	= "";
		WarhousIn_ 	= "";
		WarhousIn	= "";
		
		
		
		Элементы.ЖДД.Доступность = Истина;
		Элементы.ВДНачало.Доступность = Истина;
