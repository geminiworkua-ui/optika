		Оповещение = Новый ОписаниеОповещения("ВыборSender_Город", ЭтаФорма);
		ОткрытьФорму(ПутьКФормеРедактирования,П ,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		
	ИначеЕсли ServiceType = "DoorsWarehouse" Или ServiceType = "DoorsDoors"  Тогда
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Контрагент",Sender);
		Адреса = тзАдресаКонтрагента.НайтиСтроки(СтруктураОтбора);
		тмпСписокГородов = новый СписокЗначений;
		Для Каждого Эл из Адреса Цикл
			Если СокрЛП(Эл.ИДГорода) <> "00000000-0000-0000-0000-000000000000"  Тогда
				Если тмпСписокГородов.НайтиПоЗначению(СокрЛП(Эл.ИДГорода)) = Неопределено Тогда
					тмпСписокГородов.Добавить(СокрЛП(Эл.ИДГорода),СокрЛП(Эл.Город));
				КонецЕсли;
			КонецЕсли;
		Конеццикла;
		
			
			П = Новый Структура;
			
			СписокКолонок = Новый СписокЗначений;
			СписокКолонок.Добавить("Наименование","Наименование",Истина);
			СписокКолонок.Добавить("Идентификатор","Идентификатор",ЛОЖЬ);
			
			П.Вставить("ЗаголовокФормы","Выберите город отправителя");
			П.Вставить("СписокКолонок",СписокКолонок);
			П.Вставить("Данные",тмпСписокГородов);
			
			П.Вставить("ВидимостьКнопкиСоздания",ЛОЖЬ);
			
			П.Вставить("ВернутьРеф",Истина);
			
			ПутьКФормеРедактирования = ПолучитьПолноеИмяФормы("ФормаВыбораИзТЗ");
			Оповещение = Новый ОписаниеОповещения("ВыборSender_ГородПоАдресу", ЭтаФорма);
			ОткрытьФорму(ПутьКФормеРедактирования,П ,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		
		
		
		
	КонецЕсли;		
	
	
	//Выбор опций
	ОбнулитьДопУслуги();
	СтруктураОпций = ПолучитьСтруктуруОпций();
	//Если СтруктураОпций.Свойство("Плательщик3Лицо") Тогда
	//	Элементы.Person3_.Видимость = Истина;
	//Иначе
	//	Элементы.Person3_.Видимость = Ложь;
	//КонецЕсли;
	
	УстановитьВидимостьПоПлательщику();	
	
	Если СтруктураОпций.Свойство("РасчетБезнал") Тогда
		Элементы.PForm_.Доступность = Истина;
	Иначе
		PForm = "Cash";
		PForm_ = "Готівка";
		Элементы.PForm_.Доступность = Ложь;
	КонецЕсли;
	
	Если СтруктураОпций.Свойство("ДеньВДень") Тогда
		Элементы.ДеньВДень.Доступность = СтруктураОпций.ДеньВДень;
	Иначе
		Элементы.ДеньВДень.Доступность = ЛОЖЬ;
	КонецЕсли;
	
	Если СтруктураОпций.Свойство("ДоставкаВРуки") Тогда
		Элементы.ЛичноВРуки.Доступность = СтруктураОпций.ДоставкаВРуки;
	Иначе
		Элементы.ЛичноВРуки.Доступность = ЛОЖЬ;
	КонецЕсли;
	
	Если СтруктураОпций.Свойство("КонтрольОплаты") Тогда
		Элементы.КонтрольОплаты.Доступность = СтруктураОпций.КонтрольОплаты;
	Иначе
		Элементы.КонтрольОплаты.Доступность = ЛОЖЬ;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ВыборServiceType_(Результат, ПараметрыОповещения) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ServiceType 	= Результат.Значение;
	ServiceType_ 	= Результат.Представление;
	
	староеЗначение = ПараметрыОповещения.староеЗначение;	
	
	
	Если (староеЗначение = "WarehouseWarehouse" и ServiceType = "WarehouseDoors")
		Или (староеЗначение = "DoorsWarehouse" и ServiceType = "DoorsDoors")
		Или (староеЗначение = "WarehouseDoors" и ServiceType = "WarehouseWarehouse")
		Или (староеЗначение = "DoorsDoors" и ServiceType = "DoorsWarehouse") Тогда
		CityRecipient_ = "";
		CityRecipient = "";
		WarhousIn = "";
		WarhousIn_ = "";
		Recipient_ = "";
		Recipient = "";
		RecipientAddress = "";
		RecipientAddress_ = "";
		ContactRecipient_ = "";
		ContactRecipient = "";
		RecipientsPhone = "";
	ИначеЕсли (староеЗначение = "WarehouseWarehouse" и ServiceType = "DoorsWarehouse") 
		Или (староеЗначение = "DoorsDoors" и ServiceType = "WarehouseDoors") 
		Или (староеЗначение = "DoorsWarehouse" и ServiceType = "WarehouseWarehouse") 
		Или (староеЗначение = "WarehouseDoors" и ServiceType = "DoorsDoors") Тогда		
		CitySender_ = "";
		CitySender = "";
		WarhousOut = "";
		WarhousOut_ = "";
		Sender_ = "";
		Sender = "";
		SenderAddress = "";
		SenderAddress_ = "";
		ContactSender_ = "";
		ContactSender = "";
		SendersPhone = "";
	ИначеЕсли староеЗначение <> ServiceType Тогда
		CitySender_ = "";
		CitySender = "";
		WarhousOut = "";
		WarhousOut_ = "";
		Sender_ = "";
		Sender = "";
		SenderAddress = "";
		SenderAddress_ = "";
		ContactSender_ = "";
		ContactSender = "";
		SendersPhone = "";
		
		CityRecipient_ = "";
		CityRecipient = "";
		WarhousIn = "";
		WarhousIn_ = "";
		Recipient_ = "";
		Recipient = "";
		RecipientAddress = "";
		RecipientAddress_ = "";
		ContactRecipient_ = "";
		ContactRecipient = "";
		RecipientsPhone = "";
		
	КонецЕсли;
	
	
	Если Recipient_ = "Приватна особа - ввод по строке" Тогда
		Если НЕ (ServiceType = "WarehouseWarehouse" Или ServiceType = "DoorsWarehouse") Тогда
			Сообщить("На текущий момент ввод адреса по строке возможен только для доставки на отделение.");
			Если ServiceType = "DoorsDoors" Тогда
				ServiceType = "DoorsWarehouse";
				ServiceType_ = "Адреса-Відділення";
			ИначеЕсли ServiceType = "WarehouseDoors" Тогда
				ServiceType = "WarehouseWarehouse";
				ServiceType_ = "Відділення-Відділення";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	УстановитьВидимостьПоДоставке();
	
КонецПроцедуры

