				тзDraft.Удалить(ТекСтрока);
				БылоИзменение = Истина;
			КонецЕсли;
		КонецЦикла;
		
		
		
		XMLДокумент = Новый ЧтениеXML;
		XMLДокумент.УстановитьСтроку(Ответтекст);
		ПостроительДом = Новый ПостроительDOM;
		ДокументДом = ПостроительДом.Прочитать(XMLДокумент);
		Узел = ДокументДом.ПолучитьЭлементыПоИмени("Item");
		КоличествоЭлементов = Узел.Количество();
		Если КоличествоЭлементов > 0 тогда
			Item = Узел.Элемент(0);
			Пока не Item = неопределено цикл
				
				НоваяСтрокаТЗ = тзDraft.Добавить();
				
				Для Каждого Элемент_Item Из Item.ДочерниеУзлы Цикл
					Если Элемент_Item.ИмяУзла = "Ref" тогда
						НоваяСтрокаТЗ.Ref = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "DateTime" тогда
						Дат = СтрЗаменить(Элемент_Item.ТекстовоеСодержимое,"-","");
						Дат = Лев(Дат,8);
						НоваяСтрокаТЗ.datdoc = Дата(Дат);
					ИначеЕсли Элемент_Item.ИмяУзла = "Weight" тогда
						НоваяСтрокаТЗ.weight = Число(Элемент_Item.ТекстовоеСодержимое);
					ИначеЕсли Элемент_Item.ИмяУзла = "SeatsAmount" тогда
						НоваяСтрокаТЗ.site = Число(Элемент_Item.ТекстовоеСодержимое);
					ИначеЕсли Элемент_Item.ИмяУзла = "Cost" тогда
						НоваяСтрокаТЗ.zcost = Число(Элемент_Item.ТекстовоеСодержимое);
					ИначеЕсли Элемент_Item.ИмяУзла = "CitySender" тогда
						НоваяСтрокаТЗ.citysend = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "CityRecipient" тогда
						НоваяСтрокаТЗ.cityrecp = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "SenderAddress" тогда
						НоваяСтрокаТЗ.addsend = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "RecipientAddress" тогда
						НоваяСтрокаТЗ.addrecp = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "PayerType" тогда
						НоваяСтрокаТЗ.paytype = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "CargoType" тогда
						НоваяСтрокаТЗ.cargtype = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "Description" тогда
						НоваяСтрокаТЗ.cargdesc = Элемент_Item.ТекстовоеСодержимое;
						НоваяСтрокаТЗ.descargo = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "ServiceType" тогда
						НоваяСтрокаТЗ.servtype = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "PaymentMethod" тогда
						НоваяСтрокаТЗ.pform = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "Sender" тогда
						НоваяСтрокаТЗ.sender = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "ContactSender" тогда
						НоваяСтрокаТЗ.contsend = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "SendersPhone" тогда
						НоваяСтрокаТЗ.phonsend = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "Recipient" тогда
						НоваяСтрокаТЗ.recip = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "ContactRecipient" тогда
						НоваяСтрокаТЗ.contrecp = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "RecipientsPhone" тогда
						НоваяСтрокаТЗ.phonrecp = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "RecipientsPhone" тогда
						НоваяСтрокаТЗ.phonrecp = Элемент_Item.ТекстовоеСодержимое;
					ИначеЕсли Элемент_Item.ИмяУзла = "DescriptionTemplate" тогда
						НоваяСтрокаТЗ.name = Элемент_Item.ТекстовоеСодержимое;
						
					КонецЕсли;
					//Элемент_Item = Элемент_Item.СледующийСоседний;
				конецЦикла;
				Если НоваяСтрокаТЗ.servtype = "WarehouseWarehouse" тогда
					НоваяСтрокаТЗ.warsend = НоваяСтрокаТЗ.addsend;
					НоваяСтрокаТЗ.warrecp = НоваяСтрокаТЗ.addrecp;
				иначеЕсли НоваяСтрокаТЗ.servtype = "WarehouseDoors" тогда
					НоваяСтрокаТЗ.warsend = НоваяСтрокаТЗ.addsend;
				иначеЕсли НоваяСтрокаТЗ.servtype = "DoorsWarehouse" тогда
					НоваяСтрокаТЗ.warrecp = НоваяСтрокаТЗ.addrecp;	
				конецесли;
				НоваяСтрокаТЗ.sh = "S";
				БылоИзменение = Истина;
				Item = Item.СледующийСоседний;
			конеццикла;
		конецЕсли;
		
		Если БылоИзменение Тогда
			ЗаписатьТзВОбщиеНастройки("тзDraft");
		Конецесли;
	Конецесли;
	
	
конецпроцедуры

&НаКлиенте
Процедура Расчет_ОбратнаяДоставкаПриИзменении(Элемент)
	
	ОбнулитьРасчетнаяСтоимостьДоставки();
	
	
	Если Расчет_ОбратнаяДоставка Тогда
		Элементы.Расчет_Тип.Доступность = Истина;
		Элементы.Расчет_Количество.Доступность = Истина;
	иначе
		Элементы.Расчет_Тип.Доступность = Ложь;
		Элементы.Расчет_Количество.Доступность = Ложь;
		CargoType = "";
		Расчет_Тип = "";
		Расчет_Количество = 0;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура РаботаСЕНСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Элемент.ТекущаяСтраница = Элементы.Расчет Тогда
		Если CitySender <> "" Тогда
			ГородИз = CitySender;
			Расчет_ГородОтправитель = CitySender_;
		КонецЕсли;
		Если CityRecipient <> "" Тогда
			ГородВ = CityRecipient;
			Расчет_ГородПолучатель = CityRecipient_;
		КонецЕсли;
		Если CargoType <> "" Тогда
			//ГородВ = CargoType;
			Расчет_ВидГруза = CargoType_;
		КонецЕсли;
		Если ЗСтоимость <> 0 Тогда
			Расчет_СтоимостьГруза = ЗСтоимость;
		КонецЕсли;
		Если Мест <> 0 Тогда
			Расчет_КоличествоМест = Мест;
		КонецЕсли;
		Если Вес <> 0 Тогда
			//Расчет_Вес = Вес;
			
			//Максимальное занчение объемного или фактического
			
			Расчет_Вес= Макс(Вес,Объем);
			
		КонецЕсли;
		Если ServiceType_ <> "" Тогда
			Расчет_ТехнологияДоставки = ServiceType_;
		КонецЕсли;
		Если RedeliveryString <> "" Тогда
			Расчет_ОбратнаяДоставка = Истина;
			Если RedeliveryString <> "" тогда
				Расчет_Тип = RedeliveryString_;
			КонецЕсли;
			Расчет_Количество = Amount;
		КонецЕсли;
	ИначеЕсли Элемент.ТекущаяСтраница = Элементы.РегистрацияЕН Тогда
		Если СокрЛП(ТипПечати) = "" Или СокрЛП(ФорматПечати) = "" Тогда
			
			//	Сообщить("дописать");
			//ЭлементыФормы.КоманднаяПанель5.Кнопки.ДополнительныеФункции.Кнопки.ПечатьУмолчание.Доступность = Ложь;
		КонецЕсли;
		УстановитьВидимостьПоДоставке();
 		УстановитьВидимостьПоТипуГруза();
		УстановитьВидимостьПоПлательщику();	

		//Если СокрЛП(ЕНРефДок) <> "" Тогда
		//	ЭлементыФормы.Кнопка2.Заголовок = "Обновить";
		//Иначе
		//	ЭлементыФормы.Кнопка2.Заголовок = "Зарегистрировать";
		//КонецЕсли;
	//ИначеЕсли Элемент.ТекущаяСтраница = Элементы.РаботаСЕНДополнительныеУслуги Тогда
	//	Если PayerType="ThirdPerson" И PForm = "NonCash" Тогда
	//		Элементы.Person3_.Видимость = Истина;
	//	Иначе
	//		Элементы.Person3_.Видимость = Ложь;
	//	КонецЕсли;
	КонецЕсли;

	УстановитьДоступностьПоПараметрамМест();
	
КонецПроцедуры

