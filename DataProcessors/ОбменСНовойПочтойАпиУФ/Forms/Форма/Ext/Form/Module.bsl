&НаСервере
Процедура тзРеестрДоставокУдалитьЭННаСервере()
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	СписокУдаленных = Новый СписокЗначений;
	Для Каждого Строка из тзРеестрДоставок Цикл
		Если Строка.Действие Тогда
			СтруктураОтбора = новый структура;
			СтруктураОтбора.Вставить("ЕНреф",Строка.ЕНреф);
			
			РеестрыЕН = РеквизитФормыВЗначение("тзРеестрыЕН");
			//	СтрокиРеестра = тзРеестрыЕН.НайтиСтроки(структураОтбора);
			СтрокиРеестра = РеестрыЕН.НайтиСтроки(структураОтбора); 
			          
			
			Если СтрокиРеестра.Количество() > 0 тогда
				//				ТабРеф = тзРеестрыЕН.Скопировать(СтрокиРеестра);
				ТабРеф = РеестрыЕН.Скопировать(СтрокиРеестра);
				
				УдалитьИзРеестра(Объект.КлючAPI,ТабРеф);
			конецЕсли;
			СписокУдаленных.Добавить(СтруктураОтбора.ЕНреф);
			//Строка.Удален = "Y";
		КонецЕсли;
	КонецЦикла;
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("API20",Объект.КлючAPI);
	ПараметрыМетода.Вставить("СписокРеф",СписокУдаленных);
	ТекстЗапроса = ПолучитьЗапрос_deleteDoc(ПараметрыМетода);
	ДокументДом  = ПолучитьОтветДОМ(ТочкаВхода,ТекстЗапроса);
	Если ДокументДом = Неопределено тогда
		Сообщить("Ошибка при получении ответа, метод: insertDocumentsScanSheet");
	КонецЕсли;
	Если не  ЭтоУспех(ДокументДом) тогда
		ТекстИсключения = ВернутьЕрор(ДокументДом);
		Сообщить(ТекстИсключения+" deleteDoc");
	КонецЕсли;
	лВыполняемаяобработка = ПолучитьПроцедуруПоМетоду("deleteDoc");
	Если не ЗначениеЗаполнено(лВыполняемаяобработка) тогда
		Сообщить(ТекстИсключения = "Не назначен обработчик методу: deleteDoc");
	КонецЕсли;
	Результат = новый Структура();
	РаспарситьОтвет(лВыполняемаяобработка, ДокументДом,Результат, "deleteDoc",ПараметрыМетода);
	
	
	//ОбновитьСтатусы();
	
	тзРеестрДоставокОбновитьСтатусыНаСервере();
КонецПроцедуры

