КонецПроцедуры

&НаСервере 
Функция тзРеестрДоставокОтчетСформироватьФайлНаСервере(ПараметрыОповещения) 
	ТекущийКлюч = Объект.КлючAPI;
	
	Если СокрЛП(ТекущийКлюч) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат Неопределено;
	КонецЕсли;
	СписокДок = Новый СписокЗначений;
	Для Каждого строка Из тзРеестрДоставок Цикл
		Если Строка.Действие Тогда
			СписокДок.Добавить(строка.ЕНреф);
		КонецЕсли;
	Конеццикла;
	Доки = "";
	Если СписокДок.Количество() = 0 Тогда
		Сообщить("На выбраны документы для формирования отчета");
		Возврат Неопределено;
	Иначе
		Для Каждого Эл Из СписокДок Цикл
			Доки = Доки + "
			|<item>"+СокрЛП(Эл)+"</item>";
		Конеццикла;
	КонецЕсли;
	
	
	ФорматОтчета = ПараметрыОповещения.ФорматОтчета;
	
	ТекстЗапроса = "<?xml version=""1.0"" encoding=""UTF-8"" ?>
	|<file>
	|<apiKey>"+ТекущийКлюч+"</apiKey>
	|<calledMethod>generateReport</calledMethod>
	|<methodProperties>
	|<DateTime>"+Формат(ТекущаяДата(),"ДЛФ=Д")+"</DateTime>
	|<DocumentRefs>"+Доки+"
	|</DocumentRefs>
	|<Type>"+ФорматОтчета+"</Type>
	|</methodProperties>
	|<modelName>InternetDocument</modelName>
	|</file>
	|";
	
	Попытка
		
		ИмяФайлаЗаписи = ПолучитьИмяВременногоФайла(ФорматОтчета);
		
		
		//ИмяФайлаЗаписи = ПутьФайла + "\Zvit."+ФорматОтчета;
		Попытка
			ХМЛХТТП = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
		Исключение
			ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
		КонецПопытки;
		ХМЛХТТП.Open("POST", ТочкаВхода, Ложь);
		ХМЛХТТП.SetRequestHeader("Content-Type", "text/xml");
		ХМЛХТТП.Send(ТекстЗапроса);
		Буфер = ХМЛХТТП.ResponseBody();
		Поток = Новый COMОбъект("ADODB.Stream");	
		Поток.Type = 1;  //Бинарный	
		Поток.Mode = 3; 	
		Поток.Open();	
		Поток.Write(Буфер);
		//ИмяФайлаЗаписи = ПутьФайла;
		Файл = Новый Файл(ИмяФайлаЗаписи);
		Если Файл.Существует() Тогда
			УдалитьФайлы(ИмяФайлаЗаписи);
		КонецЕсли;
		Поток.SaveToFile(ИмяФайлаЗаписи);
		Поток.Close();
		
		
		//Сообщить("Записан файл "+ИмяФайлаЗаписи);
		Для Каждого строка Из тзРеестрДоставок Цикл
			Если Строка.Действие Тогда
				Строка.Действие = Ложь;
			КонецЕсли;
		Конеццикла;
		
		
		Двоичное=Новый ДвоичныеДанные(ИмяФайлаЗаписи);
		
		Возврат ПоместитьВоВременноеХранилище(Двоичное,Новый УникальныйИдентификатор());
		
		
		
		
	Исключение 
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	
КонецФункции


