						НоваяСтрока.length = СтрокаМест.Длина;
						НоваяСтрока.heigth = СтрокаМест.Высота;
					КонецЦикла;
					Для Каждого СтрокаФИО Из тзПолучатели Цикл
						НоваяСтрока = тзSeats.Добавить();
						НоваяСтрока.ApiKey = КлючAPI;
						НоваяСтрока.Ref = RefDoc;
						НоваяСтрока.fiorec = СтрокаФИО.ФИО;
						НоваяСтрока.Записать();
					КонецЦикла;				
				
					
				ЗаписатьТзВОбщиеНастройки("тзSeats");
					
				КонецЕсли;
				
				
				
				
				
				Строка = тзРеестрДоставок.Добавить();
				Строка.НомерДок = IntDocNumber;
				Строка.ВнНомер = ЗаказНомер;
				Строка.Дата = ТекущаяДата();
				Строка.Отправитель = СокрЛП(Sender_);
				Строка.Получатель = СокрЛП(Recipient_);
				Строка.ТелефонПолучателя = СокрЛП(RecipientsPhone);
				Строка.КонтактОтправителя = СокрЛП(ContactSender_);
				Строка.Вес = Вес;
				Строка.ОбявленнаяСтоимость = ЗСтоимость;
				Строка.Мест = Мест;
				Строка.Удален = "N";
				Строка.ЕНреф = RefDoc;
				Строка.ДатаДоставки = Дата(EstDocDate+" 00:00:00");
				Строка.СтоимостьДоставки = DelCost;
			
			
			
			
			тзРеестрДоставок.Сортировать("Дата Убыв, Получатель");
		КонецЕсли;	
	Иначе
		Элементы.НадписьНомерЕН.Заголовок = "Возникла ошибка создания";
		Сообщить("Регистрация ЕН
		|"+СформироватьТекстОшибки(Ответтекст));
	КонецЕсли;	
	ЗаполнитьРеестры();
	

КонецПроцедуры

&НаКлиенте
Процедура РегистрацияЕНЗарегистрировать(Команда)
	
	РегистрацияЕНЗарегистрироватьНаСервере();

КонецПроцедуры

&НаСервере
Процедура РегистрацияЕНЗарегистрироватьНаСервере()
	

	
	КлючAPI = Объект.КлючAPI;
	Если СокрЛП(КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	Если Вес = 0 И Объем = 0 Тогда
		Сообщить("Введите значение веса или объема отправления");
		Возврат;
	КонецЕсли;
	Метод = "save";
	РефДок = "";
	ЕНРефДок = "";
	IntDocNumber = "";
	Элементы.НадписьНомерЕН.Заголовок = "";
	
	Места = "";
	Если ТабПараметрыМестСтр.Количество() > 0 Тогда
		Места = Места + "
		|<OptionsSeat>";
		Для Каждого строка Из ТабПараметрыМестСтр Цикл
			Места = Места + "
			|<item>
			|<volumetricVolume>"+строка.Объем+"</volumetricVolume>
			|<volumetricWidth>"+строка.Ширина+"</volumetricWidth>
			|<volumetricLength>"+строка.Длина+"</volumetricLength>
			|<volumetricHeight>"+строка.Высота+"</volumetricHeight>
			|<weight>"+строка.Вес+"</weight>
			|</item>";
		Конеццикла;
		Места = Места + "
		|</OptionsSeat>";
	КонецЕсли;
	ДопУслуги = "";	
	Если сокрЛП(НомерУпаковки) <> "" Тогда
		ДопУслуги = ДопУслуги + "
		|	<PackingNumber>"+сокрЛП(НомерУпаковки)+"</PackingNumber>";
	КонецЕсли;
	Если сокрЛП(ВНомерЗаказа) <> "" Тогда
		ДопУслуги = ДопУслуги + "
		|	<InfoRegClientBarcodes>"+сокрЛП(ВНомерЗаказа)+"</InfoRegClientBarcodes>";
	КонецЕсли;
	Если Суббота Тогда
		ДопУслуги = ДопУслуги + "
		|	<SaturdayDelivery>1</SaturdayDelivery>";
	КонецЕсли;
	Если Этаж > 0 Тогда
		//ДопУслуги = ДопУслуги + "
		//|<NumberOfFloorsLifting>"+Этаж+"</NumberOfFloorsLifting>"; //пока не делаем
	конецЕсли;
	Если ЭПалета Тогда
		ДопУслуги = ДопУслуги + "
		|<ExpressPallet>1</ExpressPallet>";
	конецЕсли;
	Если Лифт Тогда
		ДопУслуги = ДопУслуги + "
		|<Elevator>1</Elevator>";
	конецЕсли;
	
	
	Если сокрЛП(СопровДок) <> "" Тогда
		ДопУслуги = ДопУслуги + "
		|	<AccompanyingDocuments>"+сокрЛП(СопровДок)+"</AccompanyingDocuments>";
	КонецЕсли;
	Если сокрЛП(ДопИнф) <> "" Тогда
		ДопУслуги = ДопУслуги + "
		|	<AdditionalInformation>"+сокрЛП(ДопИнф)+"</AdditionalInformation>";
	КонецЕсли;
	Если ЗначениеЗаполнено(ЖДД)  Тогда
		ДопУслуги = ДопУслуги + "
		|	<PreferredDeliveryDate>"+Формат(ЖДД,"ДФ=dd.MM.yyyy")+"</PreferredDeliveryDate>";
	КонецЕсли;
	Если ЗначениеЗаполнено(КонтрольОплаты)  Тогда
		ДопУслуги = ДопУслуги + "
		|	<AfterpaymentOnGoodsCost>"+стрЗаменить(КонтрольОплаты,Символы.НПП,"")+"</AfterpaymentOnGoodsCost>";
	КонецЕсли;
	Если ДеньВДень Тогда
		ДопУслуги = ДопУслуги + "
		|	<SameDayDelivery>1</SameDayDelivery>";
	КонецЕсли;
	Если ЛичноВРуки Тогда
		ДопУслуги = ДопУслуги + "
		|	<DeliveryByHand>1</DeliveryByHand>";
		Для Каждого Лицо Из тзПолучатели Цикл
			ДопУслуги = ДопУслуги + "
			|	<DeliveryByHandRecipients>"+Лицо.ФИО+"</DeliveryByHandRecipients>";
		Конеццикла;
	КонецЕсли;
	
	ОбратнаяДоставка = "";
	Если сокрЛП(RedeliveryString) <> "" Тогда 
		СуммаОД = "";
		Если RedeliveryString = "Money" Тогда
			Если SumRedeliv = 0 Тогда
				Сообщить("Сумма обратной доставки не указана!");
				Возврат;
			КонецЕсли;
			СуммаОД = "
			|	<RedeliveryString>"+СтрЗаменить(Строка(SumRedeliv),Символы.НПП,"")+"</RedeliveryString>";
		ИначеЕсли RedeliveryString = "Documents" Тогда
			Если СокрЛП(DescRedeliv) = "" Тогда
				Сообщить("Описание документов обратной доставки не указано!");
				Возврат;
			КонецЕсли;
			СуммаОД = "
			|	<RedeliveryString>"+DescRedeliv+"</RedeliveryString>";
		ИначеЕсли RedeliveryString = "Trays" Тогда
			Если тзПоддоныОбр.Итог("Количество") = 0 Тогда
				Сообщить("Количество поддонов для обратной доставки не указано!");
				Возврат;
			КонецЕсли;
			Поддоны = "";
			Для Каждого Под Из тзПоддоныОбр Цикл
				Поддоны = Поддоны + "
				|	<item>
				|	<Amount>"+Под.Количество+"</Amount>
				|	<CargoDescription>"+Под.ПоддонРеф+"</CargoDescription>
				|	</item>";
			КонецЦикла;
			СуммаОД = "
			|	<RedeliveryString>"+RedeliveryString_+"</RedeliveryString>
			|	<Trays>"+Поддоны+"
			|	</Trays>";
		КонецЕсли;
		ОбратнаяДоставка = ОбратнаяДоставка + "
		|	<BackwardDeliveryData>
		|	<item>
		|	<PayerType>"+сокрЛП(PayerRedel)+"</PayerType>
		|	<CargoType>"+сокрЛП(RedeliveryString)+"</CargoType>"+СуммаОД+"
		|	</item>
		|	</BackwardDeliveryData>";
	КонецЕсли;
	
	ОписаниеГрузаДет = "";
	Если CargoDesc <> "" И CargoDesc <> "Documents" Тогда
		ОписаниеГрузаДет = ОписаниеГрузаДет + "
		|<CargoDetails>
		|<item>
		|<CargoDescription>"+CargoDesc+"</CargoDescription>
		|<Amount>"+стрЗаменить(Строка(Amount),символы.НПП,"")+"</Amount>
		|</item>
		|</CargoDetails>";
	КонецЕсли;
	
	Лицо3 = "";
	Если PayerType="ThirdPerson" И PForm = "NonCash" Тогда
		Лицо3 = "
		|<ThirdPerson>"+Person3+"</ThirdPerson>";
	КонецЕсли;
	Адрес = "";
	Если ServiceType = "WarehouseWarehouse" Или ServiceType = "DoorsWarehouse" Тогда
		Если WarhousIn <> "" Тогда
			Адрес = сокрлп(WarhousIn);
		КонецЕсли;
	Иначе
		Адрес = сокрлп(RecipientAddress);
	КонецЕсли;
	БлокПолучателя = "";
	Если Не Recipient_ = "Приватна особа - ввод по строке" Тогда
		БлокПолучателя = БлокПолучателя + "
		|<CityRecipient>"+сокрлп(CityRecipient)+"</CityRecipient>
		|<Recipient>"+сокрлп(Recipient)+"</Recipient>
		|<RecipientAddress>"+Адрес+"</RecipientAddress>
		|<ContactRecipient>"+сокрлп(ContactRecipient)+"</ContactRecipient>";			
	Иначе
		Если ServiceType = "WarehouseWarehouse" Или ServiceType = "DoorsWarehouse" Тогда
			НомерОтделения = "";
			СтруктураНомера = Новый структура;
			СтруктураНомера.Вставить("Идентификатор",WarhousIn);
			СтрокиНомера = тзОтделения.НайтиСтроки(СтруктураНомера);
			Если СтрокиНомера.Количество() > 0 тогда
				НомерОтделения = СтрокиНомера[0].НомерОтделения;
			Иначе
				СтрокиНомера = тзПочтоматы.НайтиСтроки(СтруктураНомера);
				Если СтрокиНомера.Количество() > 0 тогда
					НомерОтделения = СтрокиНомера[0].НомерОтделения;
				КонецЕсли;
			КонецЕсли;
			БлокПолучателя = БлокПолучателя + "
			|<NewAddress>1</NewAddress>
			|<Recipient>"+сокрлп(WarhousIn)+"</Recipient>
			|<RecipientCityName>"+сокрлп(CityRecipient_)+"</RecipientCityName>
			|<RecipientArea></RecipientArea>
			|<RecipientAreaRegions></RecipientAreaRegions>
			|<RecipientAddressName>"+НомерОтделения+"</RecipientAddressName>
			|<RecipientHouse></RecipientHouse>
			|<RecipientFlat></RecipientFlat>
			|<RecipientName>"+сокрлп(ContactRecipient)+"</RecipientName>
			|<RecipientType>PrivatePerson</RecipientType>";
		Иначе
			Область = "";
			СтруктураГорода = Новый структура;
			СтруктураГорода.Вставить("Идентификатор",CityRecipient);
			СтрокиГорода = тзГорода.НайтиСтроки(СтруктураГорода);
			Если СтрокиГорода.Количество() > 0 Тогда
				структураОбласти = Новый Структура;
				СтруктураОбласти.Вставить("Идентификатор",СтрокиГорода[0].Регион);
				СтрокиОбласти = тзРегионы.НайтиСтроки(СтруктураОбласти);
				Если СтрокиОбласти.Количество() > 0 тогда
					Область = СтрокиОбласти[0].Наименование;
				КонецЕсли;
			КонецЕсли;
			БлокПолучателя = БлокПолучателя + "
			|<NewAddress>1</NewAddress>
			|<RecipientCityName>"+сокрлп(CityRecipient_)+"</RecipientCityName>
			|<RecipientArea>"+Область+"</RecipientArea>
			|<RecipientAreaRegions></RecipientAreaRegions>
		//	|<RecipientAddressName>"+СокрЛП(УлицаСтрока)+"</RecipientAddressName>
		//	|<RecipientHouse>"+СокрЛП(ДомСтрока)+"</RecipientHouse>
		//	|<RecipientFlat>"+СокрЛП(КвартираСтрока)+"</RecipientFlat>
			|<RecipientName>"+сокрлп(ContactRecipient)+"</RecipientName>
			|<RecipientType>PrivatePerson</RecipientType>";
		КонецЕсли;
	КонецЕсли;
	
	запрос=
	"<root>
	|<apiKey>[ВАШ КЛЮЧ]</apiKey>
	|<modelName>InternetDocument</modelName>
	|<calledMethod>"+Метод+"</calledMethod>
	|<methodProperties>
	|<MarketplacePartnerToken>c4132d2bf518-9f02-4911-f6fd-afa6f118</MarketplacePartnerToken>"+РефДок+"
	|<CargoType>{CargoType}</CargoType>"+ОписаниеГрузаДет+"
	|<Cost>{СтоимостьЗаказа}</Cost>
	|<DateTime>{ДатаНакладной}</DateTime>
	|<Description>{Описание}</Description>
	|<PayerType>{PayerType}</PayerType>"+Лицо3+"
	|<PaymentMethod>{Cash}</PaymentMethod>
	|<VolumeGeneral>{Объем}</VolumeGeneral>
	|<Weight>{Вес}</Weight>
	|<SeatsAmount>{Мест}</SeatsAmount>"+Места+"
	|<ServiceType>{ServiceType}</ServiceType>"+ДопУслуги+ОбратнаяДоставка+"
	|<CitySender>{CitySender}</CitySender>
	|<Sender>{Sender}</Sender>
	|<SenderAddress>{SenderAddress}</SenderAddress>
	|<ContactSender>{ContactSender}</ContactSender>
	|<SendersPhone>{SendersPhone}</SendersPhone>"+Блокполучателя+"
	|<RecipientsPhone>{RecipientsPhone}</RecipientsPhone>
	|</methodProperties>
	|</root>";
	Запрос=СтрЗаменить(Запрос,"[ВАШ КЛЮЧ]",КлючAPI);
	запрос=СтрЗаменить(запрос,"{CitySender}",сокрлп(CitySender));
	запрос=СтрЗаменить(запрос,"{Cash}",сокрлп(PForm));
	запрос=СтрЗаменить(запрос,"{Sender}",сокрлп(Sender));
	запрос=СтрЗаменить(запрос,"{ContactSender}",сокрлп(ContactSender));
	запрос=СтрЗаменить(запрос,"{SendersPhone}",SendersPhone);
	
	Если ServiceType = "WarehouseWarehouse" Или ServiceType = "WarehouseDoors" Тогда
		Если WarhousOut <> "" Тогда
			Запрос=СтрЗаменить(Запрос,"{SenderAddress}",сокрлп(WarhousOut));
		КонецЕсли;
	Иначе
		запрос=СтрЗаменить(запрос,"{SenderAddress}",сокрлп(SenderAddress));
	КонецЕсли;
	
	Если Не ЗначениеЗАполнено(Заказ) Тогда
		ЗаказДатаОтгрузки = ТекущаяДата();
		ЗаказСуммаДокумента = 0;
		ЗаказНомер = "";
	Иначе
		ЗаказДатаОтгрузки = Заказ.ДатаОтгрузки;
		ЗаказСуммаДокумента = Заказ.СуммаДокумента;
		ЗаказНомер = Заказ.Номер;
	КонецЕсли;
	
	запрос=СтрЗаменить(запрос,"{ДатаНакладной}",?(ДатаНакладной = Дата('00010101'),Формат(ЗаказДатаОтгрузки,"ДФ=dd.MM.yyyy"),Формат(ДатаНакладной,"ДФ=dd.MM.yyyy")));
	запрос=СтрЗаменить(запрос,"{СтоимостьЗаказа}",?(ЗСтоимость = 0,стрЗаменить(строка(ЗаказСуммаДокумента),Символы.НПП,""),стрЗаменить(строка(ЗСтоимость),Символы.НПП,"")));
	запрос=СтрЗаменить(запрос,"{PayerType}",PayerType);
	запрос=СтрЗаменить(запрос,"{ServiceType}",ServiceType);
	Если НЕ CargoType = "Cargo" Тогда
		запрос=СтрЗаменить(запрос,"{Объем}","");
		запрос=СтрЗаменить(запрос,"{Вес}",стрЗаменить(строка(Вес),Символы.НПП,""));
	Иначе
		Если Вес = 0 Тогда
			запрос=СтрЗаменить(запрос,"{Объем}",стрЗаменить(строка(Объем),Символы.НПП,""));
			запрос=СтрЗаменить(запрос,"{Вес}","");
		Иначе
			запрос=СтрЗаменить(запрос,"{Объем}","");
			запрос=СтрЗаменить(запрос,"{Вес}",стрЗаменить(строка(Вес),Символы.НПП,""));
		КонецЕсли;
	КонецЕсли;
	запрос=СтрЗаменить(запрос,"{Мест}",?(Мест = 0,"1",стрЗаменить(строка(Мест),Символы.НПП,"")));
	запрос=СтрЗаменить(запрос,"{Описание}",сокрлп(DescriptionCargo));
	Запрос=СтрЗаменить(Запрос,"{CargoType}",сокрлп(CargoType));
		
	Запрос=СтрЗаменить(Запрос,"{RecipientsPhone}",сокрлп(RecipientsPhone));
	
	Ответтекст=GetXMLResponserNewPost(запрос);
	
	Если СтрЧислоВхождений(Ответтекст,"<success>true</success>") then
		IntDocNumber = "";
		EstDocDate = Дата('00010101');
		DelCost = 0;
		ОтветФорма=("Накладная успешно создана!");
		Чтение=new ЧтениеXML;
		Чтение.УстановитьСтроку(Ответтекст);
		Пока (Чтение.Прочитать()) Цикл
			Если чтение.Имя="IntDocNumber" and чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента тогда
				чтение.Прочитать();
				IntDocNumber=чтение.Значение;
				DocNumber = IntDocNumber;
				//Список.Добавить(Значение,Имя);
			ИначеЕсли чтение.Имя="Ref" and чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента then
				чтение.Прочитать();
				RefDoc=чтение.Значение;
			ИначеЕсли чтение.Имя="EstimatedDeliveryDate" and чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента then
				чтение.Прочитать();
				EstDocDate=чтение.Значение;
			ИначеЕсли чтение.Имя="CostOnSite" and чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента then
				чтение.Прочитать();
				DelCost=?(чтение.Значение = "",0,Число(чтение.Значение));
			КонецЕсли;
		КонецЦикла;;
		Если Не ПустаяСтрока(IntDocNumber) Тогда
			Если Метод = "update" Тогда
				Элементы.НадписьНомерЕН.Заголовок = "Обновлена ЭН "+IntDocNumber;
			Иначе
				Элементы.НадписьНомерЕН.Заголовок = "Создана ЭН "+IntDocNumber;
			КонецЕсли;
			ЕНРефДок = RefDoc;
		
			Если Метод = "update" Тогда
				
				Строки = тзReestr.НайтиСтроки(Новый Структура("Ref",RefDoc));
				Если Строки.Количество() = 0 Тогда
					СтрокатзReestr = тзReestr.Добавить();
				Иначе
					СтрокатзReestr = Строки[0];
				КонецЕсли;
			Иначе
				СтрокатзReestr = тзReestr.Добавить();
			КонецЕсли;
		

				СтрокатзReestr.ApiKey = КлючAPI;
				СтрокатзReestr.NDoc = ЗаказНомер;
				СтрокатзReestr.DDoc = ТекущаяДата();
				СтрокатзReestr.Ref = RefDoc;
				СтрокатзReestr.EN = IntDocNumber;
				//
				Если ЗначениеЗаполнено(Заказ) Тогда
					СтрокатзReestr.vndocn = Заказ.Номер;
					СтрокатзReestr.vndocd = Заказ.Дата;
				КонецЕсли;
				СтрокатзReestr.cargtype = СокрЛП(CargoType);
				СтрокатзReestr.cargam = Amount;
				СтрокатзReestr.servtype = СокрЛП(ServiceType);
				СтрокатзReestr.volume = Объем;
				СтрокатзReestr.citysend = СокрЛП(CitySender);
				СтрокатзReestr.addsend = СокрЛП(SenderAddress);
				СтрокатзReestr.contsend = СокрЛП(ContactSender);
				СтрокатзReestr.phonsend = СокрЛП(SendersPhone);
				СтрокатзReestr.warsend = СокрЛП(WarhousOut);
				СтрокатзReestr.cargodes = СокрЛП(CargoDesc);
				СтрокатзReestr.addserv = ?(ДополнительныеУслуги = Истина,"Y","N");
				СтрокатзReestr.pform = СокрЛП(PForm);
