&НаКлиенте
Процедура тзЧерновикиЗагрузить(Команда)
	
	ТекСтрока = Элементы.тзЧерновики.ТекущаяСтрока;	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;       
	
	//ЭтаФорма.тзЧерновики.НайтиПоИдентификатору(ТекСтрока)

		ЗагрузитьШаблонЧерновик(ТекСтрока,"тзЧерновики",Истина);
		
		УдалитьСтрокуЧерновика(ТекСтрока);
		//тзЧерновики.Удалить(Элементы.тзЧерновики.ТекущаяСтрока);
		Для Каждого ТекСтрока из тзЧерновики Цикл
			ТекСтрока.Действие = ЛОЖЬ;
		КонецЦикла;
		//ТекСтрока.Действие = Истина;
		Элементы.РаботаСЕНСтраницы.ТекущаяСтраница = Элементы.РегистрацияЕН;
		УстановитьВидимостьПоДоставке();
	    УстановитьВидимостьПоТипуГруза();
		УстановитьВидимостьПоПлательщику();	
	УстановитьДоступностьПоПараметрамМест();
КонецПроцедуры

