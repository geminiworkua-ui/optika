	СтруктураНастроек.Вставить("тзТипыОтделений",					РеквизитФормыВЗначение("тзТипыОтделений"));
	СтруктураНастроек.Вставить("тзФормыСобственности",				РеквизитФормыВЗначение("тзФормыСобственности"));
	СтруктураНастроек.Вставить("тзТипыПлательщиков",				РеквизитФормыВЗначение("тзТипыПлательщиков"));
	СтруктураНастроек.Вставить("тзСпособыОплаты",					РеквизитФормыВЗначение("тзСпособыОплаты"));
	СтруктураНастроек.Вставить("тзВидыГруза",						РеквизитФормыВЗначение("тзВидыГруза"));
	СтруктураНастроек.Вставить("тзТехнологииДоставки",				РеквизитФормыВЗначение("тзТехнологииДоставки"));
	СтруктураНастроек.Вставить("тзОписанияГруза",					РеквизитФормыВЗначение("тзОписанияГруза"));
	СтруктураНастроек.Вставить("тзТипыКонтрагентов",				РеквизитФормыВЗначение("тзТипыКонтрагентов"));
