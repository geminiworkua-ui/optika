&НаКлиенте 
Процедура ВыборRedeliveryString_(Результат, ПараметрыОповещения) Экспорт
	
	DescRedeliv = "";
	SumRedeliv = 0;
	тзПоддоныОбр.Очистить();
	
	
	Если Результат = Неопределено Тогда
		
		RedeliveryString = "";
		PayerRedel = "";
		PayerRedel_ = "";
		
		Возврат;
	КонецЕсли;
	
	RedeliveryString  = Результат.Значение;
	RedeliveryString_ = Результат.Представление;
	
	
	Если RedeliveryString = "Documents" тогда
