&НаСервере
Процедура тзРеестрДоставокОбновитьСтатусыНаСервере()
	ТекущийКлюч = Объект.КлючAPI;
	
	Если СокрЛП(ТекущийКлюч) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	
	РеестрДоставок = РеквизитФормыВЗначение("тзРеестрДоставок");
	
	ТабДат = РеестрДоставок.Скопировать(,"Дата");
	
	//ТабДат = тзРеестрДоставок.Скопировать(,"Дата");
	ТабДат.Сортировать("Дата Возр");
	Если ТабДат.Количество() >  0 Тогда
		ДатаС = ТабДат[0].Дата;
		ДатаПо = ТекущаяДата();
	Иначе
		Возврат;
	КонецЕсли;
	ЗагрузитьСтарыеЕН(ДатаС,ДатаПо);
	ЗаполнитьРеестры();	
	//Отбор = Новый Структура;
	//Отбор.Вставить("Действие",Истина);
	ТабРеф = РеестрДоставок.Скопировать();//Отбор
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("API20",ТекущийКлюч);
	ПараметрыМетода.Вставить("ТабРеф",ТабРеф);
	ТекстЗапроса = ПолучитьЗапрос_getStatusDocuments(ПараметрыМетода);
	ДокументДом  = ПолучитьОтветДОМ(ТочкаВхода,ТекстЗапроса);
	Если  ДокументДом = Неопределено тогда
		Сообщить("Ошибка при получении ответа, метод: getStatusDocuments");
	КонецЕсли;
	Если не  ЭтоУспех(ДокументДом) тогда
		ТекстИсключения = ВернутьЕрор(ДокументДом);
		Сообщить(ТекстИсключения+" getStatusDocuments");
	КонецЕсли;
	лВыполняемаяобработка = ПолучитьПроцедуруПоМетоду("getStatusDocuments");
	Если не ЗначениеЗаполнено(лВыполняемаяобработка) тогда
		Сообщить(ТекстИсключения = "Не назначен обработчик методу: getStatusDocuments");
	КонецЕсли;
	Результат = новый Структура();
	РаспарситьОтвет(лВыполняемаяобработка, ДокументДом,Результат, "getStatusDocuments",ПараметрыМетода);
	
КонецПроцедуры

