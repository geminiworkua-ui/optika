&НаСервере
Процедура ЗагрузитьСправочникНаСервере()
	Метод = "";
	Файл = "";
	Таблица = Неопределено;
	Если Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "Регионы" Тогда
		Метод = "getAreas";
//		Файл = Новый Файл(Объект.ПутьКБазе+"\Areas.mxl");
		тзРегионы.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "Города" Тогда
		Метод = "getCities";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\Cities.mxl");
		тзГорода.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "Улицы" Тогда
		Метод = "getStreet";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\Streets.mxl");
		тзУлицы.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "Отделения" Или Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "Почтоматы" Тогда
		Метод = "getWarehouses";
		тзОтделения.Очистить();
		тзПочтоматы.Очистить();
		//Файл = Новый Файл(Объект.ПутьКБазе+"\whouseo.mxl");
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ТипыОтделений" Тогда
		Метод = "getWarehouseTypes";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\whtypes.mxl");
		тзТипыОтделений.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ФормыСобственности" Тогда
		Метод = "getOwnershipFormsList";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\ownform.mxl");
		тзФормыСобственности.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ТипыПлательщиков" Тогда
		Метод = "getTypesOfPayers";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\payertyp.mxl");
		тзТипыПлательщиков.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "СпособыОплаты" Тогда
		Метод = "getPaymentForms";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\payforms.mxl");
		тзСпособыОплаты.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ВидыГруза" Тогда
		Метод = "getCargoTypes";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\cargotyp.mxl");
		тзВидыГруза.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ТехнологияДоставки" Тогда
		Метод = "getServiceTypes";
//		Файл = Новый Файл(Объект.ПутьКБазе+"\servtype.mxl");
		тзТехнологииДоставки.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ОписанияГруза" Тогда
		Метод = "getCargoDescriptionList";
//		Файл = Новый Файл(Объект.ПутьКБазе+"\cargodes.mxl");
		тзОписанияГруза.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ТипыКонтрагентов" Тогда
		Метод = "getTypesOfCounterparties";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\counttyp.mxl");
		тзТипыКонтрагентов.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ВидыОбратнойДоставки" Тогда
		Метод = "getBackwardDeliveryCargoTypes";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\bdelct.mxl");
		тзВидыОбратнойДоставки.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ВидыПалет" Тогда
		Метод = "getPalletsList";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\pallets.mxl");
		тзВидыПаллет.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ПлательщикиОбратнойДоставки" Тогда
		Метод = "getTypesOfPayersForRedelivery";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\redevpt.mxl");
		тзТипыПлательщиковОбратнойДоставки.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ВременныеИнтервалы" Тогда
		Метод = "getTimeIntervals";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\timeint.mxl");
		тзИнтервалы.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ТипыШинДисков" Тогда
		Метод = "getTiresWheelsList";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\tires.mxl");
		тзШины.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "ТипыПоддонов" Тогда
		Метод = "getTraysList";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\trays.mxl");
		тзПоддоны.Очистить();
	ИначеЕсли Элементы.ГруппаСправочников.ТекущаяСтраница.Имя = "Ошибки" Тогда
		Метод = "getMessageCodeText";
	//	Файл = Новый Файл(Объект.ПутьКБазе+"\errors.mxl");
		тзОшибки.Очистить();
	КонецЕсли;
	ТаблицаМетодов = Новый ТаблицаЗначений;
	ТаблицаМетодов.Колонки.Добавить("Метод");
	ТаблицаМетодов.Колонки.Добавить("Файл");
	Строка = ТаблицаМетодов.Добавить();
	Строка.Метод = Метод;
	ЗаполнитьСправочникиНП(ТаблицаМетодов);
	
	
КонецПроцедуры

