&НаСервере
Процедура тзРеестрыОбновитьРеестрыНаСервере()
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из тзРеестры Цикл
		ТекстЗапроса = 
		"<file>
		|<apiKey>"+СокрЛП(Объект.КлючAPI)+"</apiKey>
		|<modelName>ScanSheet</modelName>
		|<calledMethod>getScanSheet</calledMethod>
		|<methodProperties>
		|<Ref>"+СокрЛП(Строка.РефРеестра)+"</Ref>
		|</methodProperties>
		|</file>";
		Ответ=GetXMLResponserNewPost(ТекстЗапроса);
		Если СтрЧислоВхождений(Ответ,"<success>true</success>") Тогда
			Чтение=новый ЧтениеXML;
			Чтение.УстановитьСтроку(Ответ);
			Пока Чтение.Прочитать() Цикл
				Если чтение.Имя="DateTime" and чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента тогда
					чтение.Прочитать();
					ДатаРеестра = СтрЗаменить(Лев(чтение.Значение,10),"-","");
					Строка.ДатаРеестра = ДатаРеестра;	
					//ИначеЕсли чтение.Имя="Description" and чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента тогда
					//	чтение.Прочитать();
					//	Строка.Наименование = чтение.Значение;
				КонецЕсли;
			Конеццикла;
		Иначе
			//Сообщить(ЭтотОбъект.СформироватьТекстОшибки(Ответ));
		КонецЕсли;
	Конеццикла;
	ПроставитьПечатьРеестров();
КонецПроцедуры

