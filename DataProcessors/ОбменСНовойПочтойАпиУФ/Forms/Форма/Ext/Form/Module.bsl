&НаКлиенте 
Процедура ВыборRecipient_ОрганизацияСоздание(НовыеДанные, ПараметрыОповещения) Экспорт
	Если НовыеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьКонтрагентов(НовыеДанные);
	Если НовыеДанные.Свойство("Контрагент") Тогда
		СтруктураОтбора = Новый структура;
		СтруктураОтбора.Вставить("Идентификатор",НовыеДанные.контрагент);
		СтрокиКонтрагента = тзконтрагентыПолучатели.НайтиСтроки(СтруктураОтбора);
		Если СтрокиКонтрагента.Количество() > 0 тогда
			Recipient = СтрокиКонтрагента[0].Идентификатор;
			Recipient_ = СтрокиКонтрагента[0].Контрагент;
			
			ПроверитьФормуОплаты();
			
			Если НовыеДанные.Свойство("Адрес") тогда
				СтруктураОтбора = Новый структура;
				СтруктураОтбора.Вставить("Идентификатор",НовыеДанные.Адрес);
				СтрокиАдреса = тзАдресаКонтрагента.НайтиСтроки(СтруктураОтбора);
				Если СтрокиАдреса.Количество() > 0 тогда
					CityRecipient = СтрокиАдреса[0].ИДГорода;
					CityRecipient_ = СтрокиАдреса[0].Город;
					//адрес?
					Если ServiceType = "WarehouseDoors" Или  ServiceType  =  "DoorsDoors" Тогда
						RecipientAddress = СтрокиАдреса[0].Идентификатор;
						RecipientAddress_ = СтрокиАдреса[0].Адрес;
					КонецЕсли;
				конецЕсли;
			КонецЕсли;
			Если НовыеДанные.Свойство("Контакт") тогда
				СтруктураОтбора = Новый структура;
				СтруктураОтбора.Вставить("Идентификатор",НовыеДанные.Контакт);
				СтрокиКонтакта = тзКонтактныеЛица.НайтиСтроки(СтруктураОтбора);
				Если СтрокиКонтакта.Количество() > 0 тогда
					ContactRecipient = СтрокиКонтакта[0].Идентификатор;
					ContactRecipient_ = СтрокиКонтакта[0].КонтактноеЛицо;
					RecipientsPhone = СтрокиКонтакта[0].Телефон;
				конецЕсли;
			КонецЕсли;
		конецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ВыборRecipient_(Результат, ПараметрыОповещения) Экспорт
	Если Результат = Неопределено Тогда
		
		Recipient = ""; 
		Recipient_ = "";
		
		Возврат;
	КонецЕсли;
	
	
	ContactRecipient 	= "";
	ContactRecipient_  = "";
	RecipientsPhone 	= "";
	
	
	//	Список.Добавить("PrivatePerson","Приватна особа - ввод по строке");
	//Список.Добавить("Organization","Организация - создать");
	
	
	//	"00000000-0000-0000-0000-000000000001" - Организация - создать
	//	"00000000-0000-0000-0000-000000000003" - Приватна особа - ввод по строке
	
	Строки = тзКонтрагентыПолучатели.НайтиСтроки(Новый Структура("Идентификатор",Результат));
	Если Строки.Количество() = 0 и 
		НЕ(Результат = "00000000-0000-0000-0000-000000000001" или Результат = "00000000-0000-0000-0000-000000000003") Тогда
		
		Recipient = ""; 
		Recipient_ = "";
		
		
		Возврат;
		
		
	КонецЕсли;
	
	Если Результат = "00000000-0000-0000-0000-000000000001" Тогда //Организация - создать
		П = Новый Структура;  	
		
		Recipient = "Organization"; 
		Recipient_ = "Организация - создать";  
		
		
		ОтборПриват = Новый Структура;
		ОтборПриват.Вставить("ТипКонтрагента","PrivatePerson");
		СтрокиПолучателя = тзКонтрагентыПолучатели.НайтиСтроки(ОтборПриват);
		Если СтрокиПолучателя.Количество() > 0 Тогда
