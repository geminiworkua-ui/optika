	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяСтрока = тзОписанияГруза.НайтиПоИдентификатору(Результат);
	
	DescriptionCargo = ВыбраннаяСтрока.Наименование;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеУслугиПриИзменении(Элемент)
	Если ДополнительныеУслуги = Истина Тогда
		Элементы.РаботаСЕНСтраницы.ТекущаяСтраница = Элементы.РаботаСЕНДополнительныеУслуги;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ContactRecipient_ОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Если Recipient_ = "Приватна особа - ввод по строке" Тогда
		ContactRecipient_ = Текст;
		ContactRecipient  = Текст;
	Иначе
		ContactRecipient_ = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ContactRecipient_НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	П = Новый Структура;
	
	СписокКолонок = Новый СписокЗначений;
	
	СписокКолонок.Добавить("КонтактноеЛицо","Контактное лицо",	Истина);
	СписокКолонок.Добавить("Телефон",		"Телефон",			Истина);
	СписокКолонок.Добавить("Фамилия",		"Фамилия",			Истина);
	СписокКолонок.Добавить("Имя",			"Имя",				Истина);
	СписокКолонок.Добавить("Отчество",		"Отчество",			Истина);
	СписокКолонок.Добавить("Идентификатор",	"Идентификатор",	ЛОЖЬ);
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Контрагент",Recipient);
	
	
	П.Вставить("ЗаголовокФормы",			"Выберите контактное лицо");
	П.Вставить("СписокКолонок",				СписокКолонок);
	П.Вставить("Данные",					тзКонтактныеЛица);
	П.Вставить("ВидимостьКнопкиСоздания",	Истина);
	П.Вставить("ВернутьРеф",				Истина);
	П.Вставить("Отбор",						СтруктураОтбора);
	
	
	ПутьКФормеРедактирования = ПолучитьПолноеИмяФормы("ФормаВыбораИзТЗ");
	Оповещение = Новый ОписаниеОповещения("ВыборRecipient_Контакт", ЭтаФорма);
	ОткрытьФорму(ПутьКФормеРедактирования,П,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте 
Процедура ВыборRecipient_КонтактСоздание(НовыеДанные, ПараметрыОповещения) Экспорт
	
	Если НовыеДанные = Неопределено Тогда
		
		ContactRecipient 	= "";
		ContactRecipient_  = "";
		RecipientsPhone 	= "";
		
		Возврат;
	КонецЕсли;
	
	ОбновитьКонтрагентов(НовыеДанные);
	Если НовыеДанные.Свойство("Контакт") Тогда
		СтруктураОтбора = Новый структура;
		СтруктураОтбора.Вставить("Идентификатор",НовыеДанные.Контакт);
		СтрокиКонтакта = тзКонтактныеЛица.НайтиСтроки(СтруктураОтбора);
		Если СтрокиКонтакта.Количество() > 0 тогда
			ContactRecipient  = СтрокиКонтакта[0].Идентификатор;
			ContactRecipient_ = СтрокиКонтакта[0].КонтактноеЛицо;
			RecipientsPhone   = СтрокиКонтакта[0].Телефон;
		конецЕсли; 
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте 
Процедура ВыборRecipient_Контакт(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = Неопределено Тогда
		
		
		ContactRecipient 	= "";
		ContactRecipient_  = "";
		RecipientsPhone 	= "";
		
		Возврат;
	КонецЕсли;
	
	
	Строки = тзКонтактныеЛица.НайтиСтроки(Новый Структура("Идентификатор",Результат));
	Если Строки.Количество() = 0 и Результат <> "00000000-0000-0000-0000-000000000000" Тогда
		Возврат;
	КонецЕсли;
	
	
	
	
	Если Результат <> "00000000-0000-0000-0000-000000000000" Тогда
		ContactRecipient 	= Строки[0].Идентификатор;
		ContactRecipient_  = Строки[0].КонтактноеЛицо;
		RecipientsPhone 	= Строки[0].Телефон;
	Иначе
		
		
		П = Новый Структура;  	
		
		
		ОтборПриват = Новый Структура;
		ОтборПриват.Вставить("ТипКонтрагента","PrivatePerson");
		СтрокиПолучателя = тзКонтрагентыПолучатели.НайтиСтроки(ОтборПриват);
		Если СтрокиПолучателя.Количество() > 0 Тогда
			П.Вставить("ПриватнаОсобаИн", 			СтрокиПолучателя[0].Идентификатор);
		КонецЕсли;
		СписокВидов = новый СписокЗначений;
		Для Каждого строка Из тзТипыПлательщиков Цикл
			СписокВидов.Добавить(Строка.Идентификатор,Строка.Наименование);
			Если строка.Идентификатор = "Recipient" тогда
				П.Вставить("ВидКонтрагента", 			Строка.Наименование);
				П.Вставить("ВидКонтрагентаИн", 			Строка.Идентификатор);
			КонецЕсли;
		Конеццикла;	
		СписокТипов = новый СписокЗначений;
		Для Каждого строка Из тзТипыКонтрагентов Цикл
			СписокТипов.Добавить(Строка.Идентификатор,Строка.Наименование);
		Конеццикла;
		
		
		СписокФормСобственности = новый СписокЗначений;
		Для Каждого строка Из тзФормыСобственности Цикл
			СписокФормСобственности.Добавить(Строка.Идентификатор,Строка.Наименование);
		Конеццикла;
		
		П.Вставить("Город", 					CityRecipient_);
		
		П.Вставить("Идентификатор", 			Recipient);
		П.Вставить("СписокГородов", 			СписокГородов);
		П.Вставить("СписокВидов", 				СписокВидов);
		П.Вставить("СписокФормСобственности", 	СписокФормСобственности);
		П.Вставить("СписокТипов", 				СписокТипов);
		П.Вставить("ТекущийКлюч", 				Объект.КлючAPI);
		
		
		структураИн = Новый Структура;
		Если Recipient = "PrivatePerson" тогда
			СтруктураИн.Вставить("Контрагент","Приватна особа");
			строкаКонтрагента = тзКонтрагентыполучатели.НайтиСтроки(СтруктураИн)[0];
		Иначе
			СтруктураИн.Вставить("Идентификатор",Recipient);
			строкаКонтрагента = тзКонтрагентыполучатели.НайтиСтроки(СтруктураИн)[0];
		КонецЕсли;
		
		
		Если Recipient_ = "Приватна особа" Тогда
			П.Вставить("ТипКонтрагента",   СписокТипов.НайтиПоЗначению("PrivatePerson").Представление);
			П.Вставить("ТипКонтрагентаИн", СписокТипов.НайтиПоЗначению("PrivatePerson").Значение);
			П.Вставить("ТекущаяСтраница", "СтраницаКонтактноеЛицо");
			П.Вставить("ЭтоКонтрагентЧастноеЛицо", 	Истина);
			
			
		ИначеЕсли сокрЛП(СтрокаКонтрагента.ТипКонтрагента) = "Organization" Тогда
			П.Вставить("ТипКонтрагента", СписокТипов.НайтиПоЗначению("Organization").Представление);
			П.Вставить("ТипКонтрагентаИн",  СписокТипов.НайтиПоЗначению("Organization").Значение);
			П.Вставить("Контрагент",  строкаКонтрагента.Контрагент);
			П.Вставить("ФормаСобственности",  строкаКонтрагента.ФормаСобственности);
			
			П.Вставить("ТекущаяСтраница", "СтраницаКонтактноеЛицо");
		ИначеЕсли сокрЛП(СтрокаКонтрагента.ТипКонтрагента) = "PrivatePerson" Тогда
			П.Вставить("ТипКонтрагента",  СписокТипов.НайтиПоЗначению("PrivatePerson").Представление);
			П.Вставить("ТипКонтрагентаИн",  СписокТипов.НайтиПоЗначению("PrivatePerson").Значение);
			П.Вставить("ТекущаяСтраница", "СтраницаКонтрагент");
		КонецЕсли;
		
		
		
		
		ПутьКФормеРедактирования = ПолучитьПолноеИмяФормы("ФормаКонтрагента");
		
		Оповещение = Новый ОписаниеОповещения("ВыборRecipient_КонтактСоздание", ЭтаФорма);
		
		ФормаКонтрагента = ОткрытьФорму(ПутьКФормеРедактирования,П ,ЭтаФорма,,,,Оповещение);
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте 
Процедура ВыборRecipient_Склад(Результат, ПараметрыОповещения) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Строки = тзОтделения.НайтиСтроки(Новый Структура("Идентификатор",Результат));
	
	Если Строки.Количество() = 0 Тогда
		Строки = тзПочтоматы.НайтиСтроки(Новый Структура("Идентификатор",Результат));
	КонецЕсли;
	
	Если Строки.Количество() <> 0 Тогда
		WarhousIn_ = Строки[0].Наименование;
		WarhousIn  = Строки[0].Идентификатор;
	КонецЕсли;
	
	Если Вес <> 0 Тогда 
		Вес = ПроверитьВесНаМесто(Вес, Мест);
	КонецЕсли;
	
	Если ПараметрыОповещения <> Неопределено Тогда
		Если ТипЗнч(ПараметрыОповещения) = Тип("Структура") Тогда
			
			ПродолжитьВыборКонтакта = ЛОЖЬ;
			ПараметрыОповещения.Свойство("ПродолжитьВыборКонтакта",ПродолжитьВыборКонтакта);
			
			Если ПродолжитьВыборКонтакта = Ложь Тогда
				
				ТекущийЭлемент = Элементы.ContactRecipient_;				
				Сообщить("Введите ФИО и телефон контактного лица получателя!");
				
				Возврат;
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	П = Новый Структура;
	
	СписокКолонок = Новый СписокЗначений;
	
	СписокКолонок.Добавить("КонтактноеЛицо","Контактное лицо",	Истина);
	СписокКолонок.Добавить("Телефон",		"Телефон",			Истина);
	СписокКолонок.Добавить("Фамилия",		"Фамилия",			Истина);
	СписокКолонок.Добавить("Имя",			"Имя",				Истина);
	СписокКолонок.Добавить("Отчество",		"Отчество",			Истина);
	СписокКолонок.Добавить("Идентификатор",	"Идентификатор",	ЛОЖЬ);
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Контрагент",Recipient);
	
	
	П.Вставить("ЗаголовокФормы",			"Выберите контактное лицо");
	П.Вставить("СписокКолонок",				СписокКолонок);
	П.Вставить("Данные",					тзКонтактныеЛица);
	П.Вставить("ВидимостьКнопкиСоздания",	Истина);
	П.Вставить("ВернутьРеф",				Истина);
	П.Вставить("Отбор",						СтруктураОтбора);
	
	
	ПутьКФормеРедактирования = ПолучитьПолноеИмяФормы("ФормаВыбораИзТЗ");
	Оповещение = Новый ОписаниеОповещения("ВыборRecipient_Контакт", ЭтаФорма);
	ОткрытьФорму(ПутьКФормеРедактирования,П,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); //,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	
	
	
КонецПроцедуры

&НаКлиенте 
Процедура ВыборRecipient_Город(Результат, ПараметрыОповещения) Экспорт
	Если Результат = Неопределено Тогда
		
		RecipientAddress 	= "";
		RecipientAddress_ = "";
		
		WarhousIn 	= "";
		WarhousIn_ 	= "";
		
		Возврат;
	КонецЕсли;
	
	ВыбраннаяСтрока = тзГорода.НайтиПоИдентификатору(Результат);
	
	CityRecipient 	= ВыбраннаяСтрока.Идентификатор;
	CityRecipient_ = ВыбраннаяСтрока.Наименование;  
	
	
	
	П = Новый Структура;
	
	СписокКолонок = Новый СписокЗначений;
	
	СписокКолонок.Добавить("Наименование","Наименование",Истина);
	СписокКолонок.Добавить("НаименованиеRU","Наименование RU",Истина);
	СписокКолонок.Добавить("НомерОтделения","Номер отделения",Истина);
	СписокКолонок.Добавить("ТипОтделенияИмя","Тип отделения",Истина);
	СписокКолонок.Добавить("Идентификатор","Идентификатор",ЛОЖЬ);
	
	П.Вставить("ЗаголовокФормы","Выберите отделение");
	П.Вставить("СписокКолонок",СписокКолонок);
	П.Вставить("Данные",тзОтделения);
	П.Вставить("Данные2",тзПочтоматы);
	
	П.Вставить("ВернутьРеф",Истина);
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ГородРеф",CityRecipient);
	
	П.Вставить("Отбор",СтруктураОтбора);
	
	
	ПутьКФормеРедактирования = ПолучитьПолноеИмяФормы("ФормаВыбораИзТЗ");
	Оповещение = Новый ОписаниеОповещения("ВыборRecipient_Склад", ЭтаФорма);
	ОткрытьФорму(ПутьКФормеРедактирования,П,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); //,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	
	
КонецПроцедуры

&НаКлиенте 
Процедура ВыборRecipient_Адрес(Результат, ПараметрыОповещения) Экспорт
	Если Результат = Неопределено Тогда
		
		RecipientAddress 	= "";
		RecipientAddress_ = "";
		
		Возврат;
	КонецЕсли;
	
	
	Строки = тзАдресаКонтрагента.НайтиСтроки(Новый Структура("Идентификатор",Результат));
	Если Строки.Количество() = 0 и Результат <> "00000000-0000-0000-0000-000000000000" Тогда
		
		RecipientAddress 	= "";
		RecipientAddress_ = "";
		
		Возврат;
	КонецЕсли;
	
	
	Если  Результат = "00000000-0000-0000-0000-000000000000" Тогда
		
		
		П = Новый Структура;  	
		
		
		СтруктураПоискаКонтрагента = Новый структура;
		СтруктураПоискаКонтрагента.Вставить("Идентификатор",Recipient);
		СтрокаКонтрагента = тзКонтрагентыПолучатели.НайтиСтроки(СтруктураПоискаКонтрагента);
		Если СтрокаКонтрагента.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		СписокВидов = новый СписокЗначений;
		Для Каждого строка Из тзТипыПлательщиков Цикл
			СписокВидов.Добавить(Строка.Идентификатор,Строка.Наименование);
			Если строка.Идентификатор = "Recipient" тогда
				П.Вставить("ВидКонтрагента", 			Строка.Наименование);
				П.Вставить("ВидКонтрагентаИн", 			Строка.Идентификатор);
			КонецЕсли;
		Конеццикла;	
		
		
		
		СписокТипов = новый СписокЗначений;
		Для Каждого строка Из тзТипыКонтрагентов Цикл
			СписокТипов.Добавить(Строка.Идентификатор,Строка.Наименование);
			Если строка.Идентификатор = СтрокаКонтрагента[0].ТипКонтрагента тогда
				П.Вставить("ТипКонтрагента", Строка.Наименование);
				П.Вставить("ТипКонтрагентаИн", Строка.Идентификатор);
			КонецЕсли;
		Конеццикла;
		
		
		СписокФормСобственности = новый СписокЗначений;
		Для Каждого строка Из тзФормыСобственности Цикл
			СписокФормСобственности.Добавить(Строка.Идентификатор,Строка.Наименование);
			Если строка.Наименование = СтрокаКонтрагента[0].ФормаСобственности Тогда
				П.Вставить("ФормаСобственности",  строка.Наименование);
				П.Вставить("ФормаСобственностиИн", строка.Идентификатор);
			КонецЕсли;
		Конеццикла;	
		
		П.Вставить("Контрагент", 		Recipient_);
		П.Вставить("ГородАд", 			CityRecipient_);
		П.Вставить("Город", 			CityRecipient_);
		П.Вставить("ГородИн", 			CityRecipient);
		П.Вставить("ТекущаяСтраница", 	"СтраницаАдрес");
		П.Вставить("Идентификатор", 	Recipient);
		П.Вставить("СписокВидов", 		СписокВидов);
		П.Вставить("СписокТипов", 		СписокТипов);
		П.Вставить("ТекущийКлюч", 		Объект.КлючAPI);
		
		
		
		ПутьКФормеРедактирования = ПолучитьПолноеИмяФормы("ФормаКонтрагента");
		
		Оповещение = Новый ОписаниеОповещения("ВыборRecipient_АдресСоздание", ЭтаФорма);
		
		ФормаКонтрагента = ОткрытьФорму(ПутьКФормеРедактирования,П ,ЭтаФорма,,,,Оповещение);
		
		
		
		
	Иначе
		
		RecipientAddress = Строки[0].Идентификатор;
		RecipientAddress_ = Строки[0].Адрес;
		
		
		
		П = Новый Структура;
		
		СписокКолонок = Новый СписокЗначений;
		
		СписокКолонок.Добавить("КонтактноеЛицо","Контактное лицо",	Истина);
		СписокКолонок.Добавить("Телефон",		"Телефон",			Истина);
		СписокКолонок.Добавить("Фамилия",		"Фамилия",			Истина);
