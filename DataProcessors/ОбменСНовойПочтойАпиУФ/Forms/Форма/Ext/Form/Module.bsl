Процедура тзРеестрДоставокПечатьВыборКаталога(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	
	Строки = тзРеестрДоставок.НайтиСтроки(Новый Структура("Действие",Истина));
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	
	Для каждого Строка Из Строки Цикл
			
			имя = СтрЗаменить(ПараметрыОповещения.Пвар,"print","");
			
			ИмяФайлаЗаписи = Результат[0]+"\"+СокрЛП(Строка.НомерДок)+имя+".pdf";
			
			АдресФайла = тзРеестрДоставокПечатьСформироватьФайлНаСервере(СокрЛП(Строка.ЕНРеф),ПараметрыОповещения);
			
			Если АдресФайла = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			Двоичное = ПолучитьИзВременногоХранилища(АдресФайла);
			Двоичное.Записать(ИмяФайлаЗаписи);
			Сообщить("Записан файл "+ИмяФайлаЗаписи);
			
			
			
			Строка.ДокументРаспечатан = Истина;
			СтруктураОтбора = Новый структура;
			СтруктураОтбора.Вставить("ЕНреф",СокрЛП(Строка.ЕНРеф));
			Строки = тзРеестрыЕН.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество()>0 тогда
				Строки[0].ДокументРаспечатан = Истина;
			КонецЕсли;
			
	КонецЦикла;
	
	
	
	
	
КонецПроцедуры

&НаСервере 
Функция тзРеестрДоставокПечатьСформироватьФайлНаСервере(ЕНРеф,ПараметрыОповещения) 
	
	
	Для каждого Строка Из тзРеестрДоставок Цикл
		Если Строка.Действие тогда
			ТекстЗапроса = "<?xml version=""1.0"" encoding=""UTF-8"" ?>
			|<root>
			|<apiKey>"+ПараметрыОповещения.ТекущийКлюч+"</apiKey>
			|<modelName>InternetDocument</modelName>
			|<calledMethod>"+ПараметрыОповещения.Пвар+"</calledMethod>
			|<methodProperties>
			|<DocumentRefs>";
			ТекстЗапроса = ТекстЗапроса + "
			|<item>"+ЕНРеф+"</item>";		
			ТекстЗапроса = ТекстЗапроса +"
			|</DocumentRefs>
			|<Type>pdf</Type>
			|</methodProperties>
			|</root>			
			|";
			Попытка
				//ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
				Попытка
					ХМЛХТТП = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
				Исключение
					ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
				КонецПопытки;
				
				ХМЛХТТП.Open("POST", ТочкаВхода, Ложь);
				ХМЛХТТП.SetRequestHeader("Content-Type", "text/xml");
				ХМЛХТТП.Send(ТекстЗапроса);
				//XMLДокумент = Новый ЧтениеXML;
				//XMLДокумент.УстановитьСтроку(ХМЛХТТП.ResponseText);
				//Сообщить(ХМЛХТТП.ResponseText);
				Буфер = ХМЛХТТП.ResponseBody();
				Поток = Новый COMОбъект("ADODB.Stream");	
				Поток.Type = 1;  //Бинарный	
				Поток.Mode = 3; 	
				Поток.Open();	
				Поток.Write(Буфер);
				
				//имя = СтрЗаменить(ПараметрыОповещения.Пвар,"print","");
				//
				//ИмяФайлаЗаписи = ПутьФайла+"\"+СокрЛП(Строка.НомерДок)+имя+".pdf";
				
				ИмяФайлаЗаписи = ПолучитьИмяВременногоФайла("pdf");
				
				Файл = Новый Файл(ИмяФайлаЗаписи);
				Если Файл.Существует() Тогда
					УдалитьФайлы(ИмяФайлаЗаписи);
				КонецЕсли;
				Поток.SaveToFile(ИмяФайлаЗаписи);
				Поток.Close();
				
				
				
				
			//	Сообщить("Записан файл "+ИмяФайлаЗаписи);
				
				
				Двоичное=Новый ДвоичныеДанные(ИмяФайлаЗаписи);
				
				Возврат ПоместитьВоВременноеХранилище(Двоичное,Новый УникальныйИдентификатор());
				
				
			Исключение 
				Сообщить(ОписаниеОшибки());
				
				Возврат Неопределено;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура тзРеестрДоставокПечать(формат,Пвар)
	
	ТекущийКлюч = Объект.КлючAPI;
	ПутьКФормеПечати = ПолучитьПолноеИмяФормы("ФормаПечати");
	
	Если СокрЛП(ТекущийКлюч) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	
	Строки = тзРеестрДоставок.НайтиСтроки(Новый Структура("Действие",Истина));
	Если Строки.Количество() = 0 Тогда
		Сообщить("укажите ЕН для печати");
		Возврат;
	КонецЕсли;
	
	
	Если формат = "HTML" Тогда
		Для каждого Строка Из Строки Цикл
			Если строка.Действие тогда
				//printMarkings
				УРЛ = "https://my.novaposhta.ua/orders/"+Пвар+"/orders[]/"+СокрЛП(Строка.ЕНРеф)+"/type/html/apiKey/"+ТекущийКлюч;
				
				П = Новый Структура;	
				П.Вставить("УРЛ",УРЛ);
				П.Вставить("Заголовок",Строка.НомерДок);
				ФормаПечати = ОткрытьФорму(ПутьКФормеПечати,П ,ЭтаФорма,Новый УникальныйИдентификатор(),,,,РежимОткрытияОкнаФормы.Независимый);
				
				Строка.ДокументРаспечатан = Истина;
				СтруктураОтбора = Новый структура;
				СтруктураОтбора.Вставить("ЕНреф",СокрЛП(Строка.ЕНРеф));
				Строки = тзРеестрыЕН.НайтиСтроки(СтруктураОтбора);
				Если Строки.Количество()>0 тогда
					Строки[0].ДокументРаспечатан = Истина;
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли формат = "PDF" Тогда
		
		
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		Диалог.Заголовок = "Выберите путь для записи файла";
		Диалог.ПолноеИмяФайла = "";
		Диалог.МножественныйВыбор = Ложь;
		Диалог.Каталог = "";
		
		Структура = Новый Структура;
		Структура.Вставить("ТекущийКлюч",ТекущийКлюч);
		Структура.Вставить("Пвар",Пвар);
		
		Оповещение = Новый ОписаниеОповещения("тзРеестрДоставокПечатьВыборКаталога", ЭтаФорма,Структура);
		Диалог.Показать(Оповещение);
		
		
		
	ИначеЕсли формат = "ZEBRA" Тогда
		Для каждого Строка Из Строки Цикл
			Если строка.Действие тогда
				УРЛ = "https://my.novaposhta.ua/orders/printMarkings/orders/"+СокрЛП(Строка.ЕНРеф)+"/type/html/apiKey/"+ТекущийКлюч+"/zebra/zebra";
				П = Новый Структура;	
				П.Вставить("УРЛ",УРЛ);
				П.Вставить("Заголовок",Строка.НомерДок);
				
				ФормаПечати = ОткрытьФорму(ПутьКФормеПечати,П ,ЭтаФорма,Новый УникальныйИдентификатор(),,,,РежимОткрытияОкнаФормы.Независимый);
				Строка.ДокументРаспечатан = Истина;
				СтруктураОтбора = Новый структура;
				СтруктураОтбора.Вставить("ЕНреф",СокрЛП(Строка.ЕНРеф));
				Строки = тзРеестрыЕН.НайтиСтроки(СтруктураОтбора);
				Если Строки.Количество()>0 тогда
					Строки[0].ДокументРаспечатан = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
КонецПроцедуры

