&НаСервере
Процедура РассчитатьДатуДоставкиНаСервере()
	
	Расчет_Дата = "";
	
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	запрос=
	"<root>
	|<apiKey>[ВАШ КЛЮЧ]</apiKey>
	|<modelName>InternetDocument</modelName>
	|<calledMethod>getDocumentDeliveryDate</calledMethod>
	|<methodProperties>
	|<MarketplacePartnerToken>c4132d2bf518-9f02-4911-f6fd-afa6f118</MarketplacePartnerToken>
	|<CargoType>{CargoType}</CargoType>
	|<Cost>{СтоимостьЗаказа}</Cost>
	|<DateTime>{ДатаНакладной}</DateTime>
	|<Description>{Описание}</Description>
	|<PayerType>{PayerType}</PayerType>
	|<PaymentMethod>{Cash}</PaymentMethod>
//	|<VolumeGeneral>{Объем}</VolumeGeneral>
	|<Weight>{Вес}</Weight>
	|<SeatsAmount>{Мест}</SeatsAmount>
	|<ServiceType>{ServiceType}</ServiceType>
	|<CitySender>{CitySender}</CitySender>
	|<Sender>{Sender}</Sender>
	|<SenderAddress>{SenderAddress}</SenderAddress>
	|<ContactSender>{ContactSender}</ContactSender>
	|<SendersPhone>{SendersPhone}</SendersPhone>
	|<CityRecipient>{CityRecipient}</CityRecipient>
	|<Recipient>{Recipient}</Recipient>
	|<RecipientAddress>{RecipientAddress}</RecipientAddress>
	|<ContactRecipient>{ContactRecipient}</ContactRecipient>
	|<RecipientsPhone>{RecipientsPhone}</RecipientsPhone>
	|</methodProperties>
	|</root>";
	Запрос=СтрЗаменить(Запрос,"[ВАШ КЛЮЧ]",Объект.КлючAPI);
	запрос=СтрЗаменить(запрос,"{CitySender}",сокрлп(ГородИз));
	//запрос=СтрЗаменить(запрос,"{CargoType}",CargoType);
	запрос=СтрЗаменить(запрос,"{Cash}",сокрлп(PForm));
	запрос=СтрЗаменить(запрос,"{Sender}",сокрлп(Sender));
	запрос=СтрЗаменить(запрос,"{ContactSender}",сокрлп(ContactSender));
	запрос=СтрЗаменить(запрос,"{SendersPhone}",SendersPhone);
	Если ServiceType = "WarehouseWarehouse" Или ServiceType = "WarehouseDoors" Тогда
		Если WarhousOut <> "" Тогда
			Запрос=СтрЗаменить(Запрос,"{SenderAddress}",сокрлп(WarhousOut));
		КонецЕсли;
	Иначе
		запрос=СтрЗаменить(запрос,"{SenderAddress}",сокрлп(SenderAddress));
	КонецЕсли;	
	запрос=СтрЗаменить(запрос,"{ДатаНакладной}",Формат(ДатаНакладной,"ДФ=dd.MM.yyyy"));
	запрос=СтрЗаменить(запрос,"{СтоимостьЗаказа}",Расчет_СтоимостьГруза);//?(ЗСтоимость = 0,стрЗаменить(строка(Заказ.СуммаДокумента),Символы.НПП,""),стрЗаменить(строка(ЗСтоимость),Символы.НПП,"")));
	запрос=СтрЗаменить(запрос,"{PayerType}",PayerType);
	запрос=СтрЗаменить(запрос,"{ServiceType}",ServiceType);
	запрос=СтрЗаменить(запрос,"{Вес}",Расчет_Вес);//?(Вес = 0,"2",стрЗаменить(строка(Вес),Символы.НПП,"")));
	запрос=СтрЗаменить(запрос,"{Мест}",Расчет_КоличествоМест);//?(Мест = 0,"1",стрЗаменить(строка(Мест),Символы.НПП,"")));
	запрос=СтрЗаменить(запрос,"{Описание}",сокрлп(DescriptionCargo));
	Запрос=СтрЗаменить(Запрос,"{CargoType}",ВидыГрузаВыб);//сокрлп(CargoType));	
	Запрос=СтрЗаменить(Запрос,"{Recipient}",сокрлп(Recipient));
	Запрос=СтрЗаменить(Запрос,"{CityRecipient}",сокрлп(ГородВ));	
	Если ServiceType = "WarehouseWarehouse" Или ServiceType = "DoorsWarehouse" Тогда
		Если WarhousIn <> "" Тогда
			Запрос=СтрЗаменить(Запрос,"{RecipientAddress}",сокрлп(WarhousIn));
		КонецЕсли;
	Иначе
		Запрос=СтрЗаменить(Запрос,"{RecipientAddress}",сокрлп(RecipientAddress));
	КонецЕсли;		
	Запрос=СтрЗаменить(Запрос,"{ContactRecipient}",сокрлп(ContactRecipient));
	Запрос=СтрЗаменить(Запрос,"{RecipientsPhone}",сокрлп(RecipientsPhone));
	
	
	
	Ответтекст=GetXMLResponserNewPost(запрос);
	Если СтрЧислоВхождений(Ответтекст,"<success>true</success>") Тогда
		ДатаП = Дата('00010101');
		Чтение=new ЧтениеXML;
		Чтение.УстановитьСтроку(Ответтекст);
		Пока(Чтение.Прочитать()) Цикл
			Если чтение.Имя="date" И чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
				чтение.Прочитать();
				ДатаП=Дата(Лев(СтрЗаменить(чтение.Значение,"-",""),8));
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ДатаП = Дата('00010101') Тогда
			Расчет_Дата = ДатаП;
		КонецЕсли;
	Иначе
		Сообщить(СформироватьТекстОшибки(Ответтекст));
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписки()
	
	СписокГородов.Очистить();
	Для Каждого Строка Из тзГорода Цикл
		СписокГородов.Добавить(Строка.Идентификатор,Строка.Наименование);
	Конеццикла;
	
	сзТехнологииДоставки.Очистить();
	Для Каждого Строка Из тзТехнологииДоставки Цикл
		сзТехнологииДоставки.Добавить(Строка.Идентификатор,Строка.Наименование);
	Конеццикла;
	
	
	сзВидыОбратнойДоставки.Очистить();
	Для Каждого Строка Из тзВидыОбратнойДоставки Цикл
		
		Если Строка.Идентификатор = "Other" Тогда
			Продолжить;
		КонецЕсли;
		
		сзВидыОбратнойДоставки.Добавить(Строка.Идентификатор,Строка.Наименование);
	Конеццикла;
	
	сзВидыГруза.Очистить();
	Для Каждого Строка Из тзВидыГруза Цикл
		сзВидыГруза.Добавить(Строка.Идентификатор,Строка.Наименование);
	Конеццикла;
	
	сзШины.Очистить();
	Для Каждого Строка Из тзШины Цикл
		сзШины.Добавить(Строка.Идентификатор,Строка.Наименование);
	Конеццикла;
	
	сзВидыПаллет.Очистить();
	Для Каждого Строка Из тзВидыПаллет Цикл
		сзВидыПаллет.Добавить(Строка.Идентификатор,Строка.Наименование);
	Конеццикла;
	
	сзКонтрагентыТретьеЛицо.Очистить();
	Для Каждого Строка Из тзКонтрагентыТретьеЛицо Цикл
		сзКонтрагентыТретьеЛицо.Добавить(Строка.Идентификатор,Строка.Контрагент + ", "+Строка.ГородИмя);
	Конеццикла;
	
	
	
	
КонецПроцедуры

