	СтруктураНастроек.Вставить(ИмяТЗ,	РеквизитФормыВЗначение(ИмяТЗ));
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта,  КлючНастроек, СтруктураНастроек, , ИмяПользователя);
	
