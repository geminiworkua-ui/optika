	ВДНачало = Результат.Значение.ИнтервалНачало;
	ВДКонец  = Результат.Значение.ИнтервалКонец;
	Интервал = Результат.Представление;
	ВремяДоставки = Результат.Представление;	
	
КонецПроцедуры

