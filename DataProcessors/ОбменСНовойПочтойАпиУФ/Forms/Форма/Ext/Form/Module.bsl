&НаКлиенте
Процедура тзШаблоныЗагрузить(Команда)
	
	ТекСтрока = Элементы.тзШаблоны.ТекущаяСтрока;	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	

		ЗагрузитьШаблонЧерновик(ТекСтрока,"тзШаблоны");
		
		Для Каждого ТекСтрокатзШаблоны из тзШаблоны Цикл
			ТекСтрокатзШаблоны.Действие = ЛОЖЬ;
		КонецЦикла;
		
		ТекущаяСтрока = тзШаблоны.НайтиПоИдентификатору(ТекСтрока);
		
		ТекущаяСтрока.Действие = Истина;
		
		Элементы.РаботаСЕНСтраницы.ТекущаяСтраница = Элементы.РегистрацияЕН;
		ОбнулитьДопУслуги();
		СтруктураОпций = ПолучитьСтруктуруОпций();
		
		
		//Если СтруктураОпций.Свойство("Плательщик3Лицо") Тогда
		//	Элементы.Person3_.Видимость = Истина;
		//Иначе
		//	Элементы.Person3_.Видимость = Ложь;
		//КонецЕсли;
		
		УстановитьВидимостьПоПлательщику();
		
		Если СтруктураОпций.Свойство("РасчетБезнал") Тогда
			Элементы.PForm_.Доступность = Истина;
		Иначе
			PForm = "Cash";
			PForm_ = "Готівка";
			Элементы.PForm_.Доступность = Ложь;
		КонецЕсли;
		
		Если СтруктураОпций.Свойство("ДеньВДень") Тогда
			Элементы.ДеньВДень.Доступность = СтруктураОпций.ДеньВДень;
		Иначе
			Элементы.ДеньВДень.Доступность = ЛОЖЬ;
		КонецЕсли;
		
		Если СтруктураОпций.Свойство("ДоставкаВРуки") Тогда
			Элементы.ЛичноВРуки.Доступность = СтруктураОпций.ДоставкаВРуки;
		Иначе
			Элементы.ЛичноВРуки.Доступность = ЛОЖЬ;
		КонецЕсли;
		
		Если СтруктураОпций.Свойство("КонтрольОплаты") Тогда
			Элементы.КонтрольОплаты.Доступность = СтруктураОпций.КонтрольОплаты;
		Иначе
			Элементы.КонтрольОплаты.Доступность = ЛОЖЬ;
		КонецЕсли;
		
		УстановитьВидимостьПоДоставке();
 		УстановитьВидимостьПоТипуГруза();
		УстановитьВидимостьПоПлательщику();	
		УстановитьДоступностьПоПараметрамМест();

	
КонецПроцедуры

