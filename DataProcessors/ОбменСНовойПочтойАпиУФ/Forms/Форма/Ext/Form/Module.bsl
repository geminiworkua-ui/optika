&НаКлиенте
Процедура ПриОткрытии(Отказ)
 	УстановитьВидимостьПоДоставке();	
	УстановитьВидимостьПоТипуГруза();
	УстановитьВидимостьПоПлательщику();	
	УстановитьДоступностьПоПараметрамМест();
	Расчет_ОбратнаяДоставкаПриИзменении(Неопределено);
	
	Элементы.тзПоддоныОбр.Видимость = ЛОЖЬ;
	НадоВыбрать = ПриОткрытииСервер();
	Если НадоВыбрать Тогда
		//Форма = ПолучитьФорму("ВнешняяОбработка.ОбменСНовойПочтойАпиУФ.Форма.ФормаВыбораКлюча");
		//Ключ = ОткрытьФормуМодально("Обработка.ОбменСНовойПочтойАпиУФ.Форма.ФормаВыбораКлюча");
		//Объект.КлючAPI = Ключ; 
		Сообщить("Для роботи необхідно заповнити ключ доступу (API)");
	КонецЕсли;
	Если Объект.КлючAPI = "" Тогда
		Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.Настройки;
	КонецЕсли;	
		
КонецПроцедуры

Функция ПриОткрытииСервер()
	//LVI
	ЗапросКлюча = Новый Запрос();
	ЗапросКлюча.Текст = "ВЫБРАТЬ
	                    |	Пользователи.КлючиНП.(
	                    |		Ключ КАК Ключ
	                    |	)
	                    |ИЗ
	                    |	Справочник.Пользователи КАК Пользователи
	                    |ГДЕ
	                    |	Пользователи.Ссылка = &Ссылка";
	ЗапросКлюча.УстановитьПараметр("Ссылка", ПараметрыСеанса.ТекущийПользователь);
	РезультатКлючи = ЗапросКлюча.Выполнить().Выгрузить();
	Если Не РезультатКлючи.Количество() = 0 И Не РезультатКлючи[0].КлючиНП.Количество() = 0 Тогда
		Если РезультатКлючи[0].КлючиНП.Количество() > 1 Тогда
			Возврат Истина;	
		Иначе
			Объект.КлючAPI = РезультатКлючи[0].КлючиНП[0].Ключ; 
		КонецЕсли;
	Иначе
		Сообщить("Для текущего пользователя не настроен API ключ! Для работы заполните его вручную");
		Объект.КлючAPI = "";
	КонецЕсли;
	Возврат Ложь;	
КонецФункции 

&НаКлиенте
Процедура ЖДДПриИзменении(Элемент)
	 ПроверитьЖДД();

		
		
		Список = новый СписокЗначений;
		структураОтбора = Новый структура;
		СтруктураОтбора.Вставить("Город",СокрЛП(CityRecipient));
		Интервалы = тзИнтервалы.НайтиСтроки(структураотбора);
		Для Каждого Эл из Интервалы Цикл
			Список.Добавить(Эл,"С "+Эл.ИнтервалНачало+" по "+Эл.ИнтервалКонец);
		КонецЦикла;
		Список.СортироватьПоПредставлению();
		
		
		Оповещение = Новый ОписаниеОповещения("ВыборИнтервалаДоставки", ЭтаФорма);
		ПоказатьВыборИзМеню(Оповещение,Список);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЖДД()
	Если ЖДД > Дата(1,1,1) Тогда
		
		 
		Если ЖДД < НачалоДня(ТекущаяДата()) Тогда
			
			Сообщить("Желаемая дата доставки не может быть меньше текущей");
			
			ЖДД = "";
			Возврат;
		КонецЕсли;
		
		
		Если (ServiceType = "WarehouseDoors" или ServiceType = "DoorsDoors")  и ЖДД = НачалоДня(ТекущаяДата()) Тогда
			Сообщить("Желаемая дата доставки не может быть меньше равна текущей для доставки до дверей");
			ЖДД = "";
			Возврат;
			
		КонецЕсли;

		
	конецЕсли;
	
	Если ДатаНакладной > Дата(1,1,1) и ЖДД > Дата(1,1,1) Тогда
		
		Если ДатаНакладной+5*24*3600 < ЖДД Тогда
			Сообщить("Желаемая дата доставки не должна превышать 5 дней с даты создания ЕН");
			ЖДД = "";
			Возврат;
		КонецЕсли
		
		
		
	КонецЕсли;
	
		
		
КонецПроцедуры

