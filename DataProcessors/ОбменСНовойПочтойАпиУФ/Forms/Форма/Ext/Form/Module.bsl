&НаКлиенте
Процедура УстановитьВидГрузаПоВесу(ЭтоРасчет = ЛОЖЬ)
	
	Если ЭтоРасчет = ЛОЖЬ Тогда
		
		Если Вес > 30 и CargoType = "Parcel" Тогда
			CargoType  = "Cargo";
			CargoType_ = "Вантаж";
			
		ИначеЕсли Вес <=30 и CargoType = "Cargo" Тогда
			CargoType  = "Parcel";
			CargoType_ = "Посилка";
		КонецЕсли;
		
		
	Иначе
		Если Расчет_Вес > 30 и CargoType = "Parcel" Тогда
			CargoType  = "Cargo";
			CargoType_ = "Вантаж";
			
			ВидыГрузаВыб 		= CargoType;
			Расчет_ВидГруза 	= CargoType_;
			
		ИначеЕсли Расчет_Вес <=30 и CargoType = "Cargo" Тогда
			
			CargoType  = "Parcel";
			CargoType_ = "Посилка";
			
			ВидыГрузаВыб 		= CargoType;
			Расчет_ВидГруза 	= CargoType_;
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры





