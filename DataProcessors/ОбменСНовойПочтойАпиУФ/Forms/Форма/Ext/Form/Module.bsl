	КонецЦикла;
	СтруктураПараметров.Вставить("Владелец",Владелец);
	Если тзТипыОтделений.Количество() = 0 Тогда		
		Если СтрЧислоВхождений(СтруктураПараметров.Description,"Поштомат") = 0 Тогда
