&НаСервере
Процедура тзРеестрыУдалитьРеестрыНаСервере()
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	ТекущийКлюч = Объект.КлючAPI;
	МассивРеестров = новый Массив;
	Для Каждого Строка Из тзРеестры Цикл
		Если строка.Действие тогда
			МассивРеестров.Добавить(строка.РефРеестра);
		КонецЕсли;
	Конеццикла;
	Если МассивРеестров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("API20",ТекущийКлюч);
	ПараметрыМетода.Вставить("МассивРеестров",МассивРеестров);
	ТекстЗапроса = ПолучитьЗапрос_deleteScanSheet(ПараметрыМетода);
	ДокументДом  = ПолучитьОтветДОМ(ТочкаВхода,ТекстЗапроса);
	Если  ДокументДом = Неопределено тогда
		Сообщить("Ошибка при получении ответа, метод: deleteScanSheet");
	КонецЕсли;
	Если не  ЭтоУспех(ДокументДом) тогда
		ТекстИсключения = ВернутьЕрор(ДокументДом);
		Сообщить(ТекстИсключения+" deleteScanSheet");
	КонецЕсли;
	лВыполняемаяобработка = ПолучитьПроцедуруПоМетоду("deleteScanSheet");
	Результат = новый Структура();
	РаспарситьОтвет(лВыполняемаяобработка, ДокументДом,Результат, "deleteScanSheet",ПараметрыМетода);
	
КонецПроцедуры

