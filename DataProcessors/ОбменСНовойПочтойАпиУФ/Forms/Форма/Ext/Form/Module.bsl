&НаКлиенте
Процедура тзКонтактныеЛицаИзменить(Команда)
	
	
	
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	
	СтрокаКонтакта = тзКонтактныеЛица.НайтиПоИдентификатору(Элементы.тзКонтактныеЛица.ТекущаяСтрока);
	
	
	П = Новый Структура;  	
	П.Вставить("Идентификатор", 				СтрокаКонтакта.Контрагент);
	
	СтрокаКонтрагента = Неопределено;
	ВидКонтрагента = Неопределено;
	Отбор = Новый структура;
	Отбор.Вставить("Идентификатор",СтрокаКонтакта.Контрагент);
	СтрокиКонтрагента = тзКонтрагентыПолучатели.НайтиСтроки(Отбор);
	Если СтрокиКонтрагента.Количество()>0 Тогда
		СтрокаКонтрагента = СтрокиКонтрагента[0];
		ВидКонтрагента = "Recipient";
	Иначе
		СтрокиКонтрагента = тзКонтрагентыОтправители.НайтиСтроки(Отбор);
		Если СтрокиКонтрагента.Количество()>0 Тогда
			СтрокаКонтрагента = СтрокиКонтрагента[0];
			ВидКонтрагента = "Sender";
		иначе
			СтрокиКонтрагента = тзКонтрагентыТретьеЛицо.НайтиСтроки(Отбор);
			Если СтрокиКонтрагента.Количество()>0 Тогда
				СтрокаКонтрагента = СтрокиКонтрагента[0];
				ВидКонтрагента = "ThirdPerson";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не СтрокаКонтрагента = Неопределено тогда
		Если СтрокаКонтрагента.ТипКонтрагента = "PrivatePerson" Тогда
			П.Вставить("Фамилия",  СтрокаКонтакта.Фамилия);
			П.Вставить("Имя",СтрокаКонтакта.Имя);
			П.Вставить("Отчество", СтрокаКонтакта.Отчество);
			П.Вставить("Телефон", СтрокаКонтакта.Телефон);
			П.Вставить("Email", СтрокаКонтакта.Email);
		Иначе
			П.Вставить("ФамилияКонтакт", СтрокаКонтакта.Фамилия);
			П.Вставить("ИмяКонтакт", СтрокаКонтакта.Имя);
			П.Вставить("ОтчествоКонтакт", СтрокаКонтакта.Отчество);
			П.Вставить("ТелефонКонтакт", СтрокаКонтакта.Телефон);
			П.Вставить("EmailКонтакт", СтрокаКонтакта.Email);
		КонецЕсли;
