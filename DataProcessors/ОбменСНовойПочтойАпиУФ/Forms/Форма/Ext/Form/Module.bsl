		Возврат;
	КонецЕсли;
	
	ИмяФайлаЗаписи = Результат[0] + "\Zvit."+ ПараметрыОповещения.ФорматОтчета;
	
	
	Двоичное = ПолучитьИзВременногоХранилища(АдресФайла);
	Двоичное.Записать(ИмяФайлаЗаписи);
	Сообщить("Записан файл "+ИмяФайлаЗаписи);
	
