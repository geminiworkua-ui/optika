	Отбор.Вставить("sender",СокрЛП(Строка.Отправитель));
	Отбор.Вставить("recip", СокрЛП(Строка.Получатель));
	Отбор.Вставить("descargo",СокрЛП(Строка.Груз));
	Если Черновик = Неопределено Тогда
		Отбор.Вставить("Ref", СокрЛП(Строка.Идентификатор));
	КонецЕсли;	
	
	
	БылоИзменение = Ложь;
	
	СтрокитзDraft = тзDraft.НайтиСтроки(Отбор);
	Для Каждого ТекСтрокатзDraft из СтрокитзDraft Цикл
		СтруктураОтбора = Новый структура;
		CargoType =  СокрЛП(ТекСтрокатзDraft.cargtype);
		СтруктураОтбора.Вставить("Идентификатор",CargoType);
		МассивСтрок = тзВидыГруза.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			CargoType_ = МассивСтрок[0].Наименование;
		КонецЕсли;
		CargoDesc = СокрЛП(ТекСтрокатзDraft.cargdesc);
		Amount = ТекСтрокатзDraft.cargam;
		
		Если CargoType = "TiresWheels" Тогда
			СтруктураОтбора.Вставить("Идентификатор",CargoDesc);
			МассивСтрок = тзШины.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 тогда
				ОписаниеГруза = МассивСтрок[0].Наименование;
			КонецЕсли;
		ИначеЕсли CargoType = "Pallet" Тогда
			СтруктураОтбора.Вставить("Идентификатор",CargoDesc);
			МассивСтрок = тзВидыПаллет.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 тогда
				ОписаниеГруза = МассивСтрок[0].Наименование;
			КонецЕсли;
		КонецЕсли;
		
		ServiceType = СокрЛП(ТекСтрокатзDraft.servtype);
		СтруктураОтбора.Вставить("Идентификатор",ServiceType);
		МассивСтрок = тзТехнологииДоставки.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			ServiceType_ = МассивСтрок[0].Наименование;
		КонецЕсли;
		
		Вес = ТекСтрокатзDraft.weight;
		Мест = ТекСтрокатзDraft.site;
		Объем = ТекСтрокатзDraft.volume;
		Sender = СокрЛП(ТекСтрокатзDraft.sender);
		СтруктураОтбора.Вставить("Идентификатор",Sender);
		МассивСтрок = тзКонтрагентыОтправители.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			Sender_ = МассивСтрок[0].Контрагент;
		КонецЕсли;
		
		CitySender = СокрЛП(ТекСтрокатзDraft.citysend);
		СтруктураОтбора.Вставить("Идентификатор",CitySender);
		МассивСтрок = тзГорода.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			CitySender_ = МассивСтрок[0].Наименование;
		КонецЕсли;
		
		SenderAddress = СокрЛП(ТекСтрокатзDraft.addsend);
		СтруктураОтбора.Вставить("Идентификатор",SenderAddress);
		МассивСтрок = тзАдресаКонтрагента.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			SenderAddress_ = МассивСтрок[0].Адрес;
		КонецЕсли;
		
		ContactSender = СокрЛП(ТекСтрокатзDraft.contsend);
		СтруктураОтбора.Вставить("Идентификатор",ContactSender);
		МассивСтрок = тзКонтактныеЛица.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			ContactSender_ = МассивСтрок[0].КонтактноеЛицо;
		КонецЕсли;
		
		SendersPhone = СокрЛП(ТекСтрокатзDraft.phonsend);
		WarhousOut = СокрЛП(ТекСтрокатзDraft.warsend);
		Если WarhousOut <> "" Тогда
			СтруктураОтбора.Вставить("Идентификатор",WarhousOut);
			МассивСтрок = тзОтделения.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 тогда
				WarhousOut_ = МассивСтрок[0].Наименование;
			КонецЕсли;
		КонецЕсли;
		
		DescriptionCargo = СокрЛП(ТекСтрокатзDraft.descargo);
		ДополнительныеУслуги = ?(ТекСтрокатзDraft.addserv = "Y",Истина,Ложь);
		
		PForm = СокрЛП(ТекСтрокатзDraft.pform);
		СтруктураОтбора.Вставить("Идентификатор",PForm);
		МассивСтрок = тзСпособыОплаты.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			PForm_ = МассивСтрок[0].Наименование;
		КонецЕсли;
		
		ДатаНакладной = ?(ТекСтрокатзDraft.datdoc<ТекущаяДата(),ТекущаяДата(),ТекСтрокатзDraft.datdoc);
		ЗСтоимость = ТекСтрокатзDraft.zcost;
		
		PayerType = СокрЛП(ТекСтрокатзDraft.paytype);
		СтруктураОтбора.Вставить("Идентификатор",PayerType);
		МассивСтрок = тзТипыПлательщиков.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			PayerType_ = МассивСтрок[0].Наименование;
		КонецЕсли;
		
		Recipient = СокрЛП(ТекСтрокатзDraft.recip);
		СтруктураОтбора.Вставить("Идентификатор",Recipient);
		МассивСтрок = тзКонтрагентыПолучатели.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			Recipient_ = МассивСтрок[0].Контрагент;
		КонецЕсли;
		
		CityRecipient = СокрЛП(ТекСтрокатзDraft.cityrecp);
		СтруктураОтбора.Вставить("Идентификатор",CityRecipient);
		МассивСтрок = тзГорода.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			CityRecipient_ = МассивСтрок[0].Наименование;
		КонецЕсли;
		
		RecipientAddress = СокрЛП(ТекСтрокатзDraft.addrecp);
		СтруктураОтбора.Вставить("Идентификатор",RecipientAddress);
		МассивСтрок = тзАдресаКонтрагента.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			RecipientAddress_ = МассивСтрок[0].Адрес;
		КонецЕсли;
		
		ContactRecipient = СокрЛП(ТекСтрокатзDraft.contrecp);
		СтруктураОтбора.Вставить("Идентификатор",ContactRecipient);
		МассивСтрок = тзКонтактныеЛица.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			ContactRecipient_ = МассивСтрок[0].КонтактноеЛицо;
		КонецЕсли;
		
		RecipientsPhone = СокрЛП(ТекСтрокатзDraft.phonrecp);
		WarhousIn = СокрЛП(ТекСтрокатзDraft.warrecp);
		Если WarhousIn <> "" Тогда
			СтруктураОтбора.Вставить("Идентификатор",WarhousIn);
			МассивСтрок = тзОтделения.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 тогда
				WarhousIn_ = МассивСтрок[0].Наименование;
			Иначе
				МассивСтрок = тзПочтоматы.НайтиСтроки(СтруктураОтбора);
				Если МассивСтрок.Количество() > 0 тогда
					WarhousIn_ = МассивСтрок[0].Наименование;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		НомерУпаковки = СокрЛП(ТекСтрокатзDraft.nomup);
		ВНомерЗаказа = СокрЛП(ТекСтрокатзDraft.vnum);
		Суббота = ?(ТекСтрокатзDraft.sday ="Y",Истина,Ложь);
		Этаж = ТекСтрокатзDraft.floor;
		Лифт = ?(ТекСтрокатзDraft.Elevator = "Y",Истина,Ложь);
		
		ЭПалета = ?(ТекСтрокатзDraft.epalet = "Y",Истина,Ложь);
		СопровДок = СокрЛП(ТекСтрокатзDraft.adddoc);
		ДопИнф = СокрЛП(ТекСтрокатзDraft.addinf);
		ЖДД = ТекСтрокатзDraft.prefdeld;
		
		Интервал = СокрЛП(ТекСтрокатзDraft.interval);
		Если Интервал <> "" Тогда
			СтруктураИнтервала = Новый структура;
			СтруктураИнтервала.Вставить("Город",CityRecipient);
			СтруктураИнтервала.Вставить("НомерИнтервала",Интервал);
			МассивСтрок = тзИнтервалы.НайтиСтроки(СтруктураИнтервала);
			Если МассивСтрок.Количество() > 0 Тогда
				ВДНачало = МассивСтрок[0].ИнтервалНачало;
				ВДКонец = МассивСтрок[0].ИнтервалКонец;
				ВремяДоставки = "С "+ МассивСтрок[0].ИнтервалНачало+" по "+ МассивСтрок[0].ИнтервалКонец;
				
			КонецЕсли;
		КонецЕсли;
		
		RedeliveryString = СокрЛП(ТекСтрокатзDraft.redelstr);
		СтруктураОтбора.Вставить("Идентификатор",RedeliveryString);
		МассивСтрок = тзВидыОбратнойДоставки.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			RedeliveryString_ = МассивСтрок[0].Наименование;
		Иначе
			RedeliveryString_ = "";
		КонецЕсли;
		
		PayerRedel = СокрЛП(ТекСтрокатзDraft.redelpay);
		СтруктураОтбора.Вставить("Идентификатор",PayerRedel);
		МассивСтрок = тзТипыПлательщиков.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 тогда
			PayerRedel_ = МассивСтрок[0].Наименование;
		Иначе
			PayerRedel_ = "";
		КонецЕсли;
		
		SumRedeliv = ТекСтрокатзDraft.redelsum;
		ДеньВДень = ?(ТекСтрокатзDraft.sameday = "Y",Истина,Ложь);
		ЛичноВРуки = ?(ТекСтрокатзDraft.takeatt = "Y",Истина,Ложь);
		
			
		Если НЕ(CargoType = "TiresWheels" или  CargoType = "Pallet")  Тогда
			Объем = 0;
			Amount = 0;
		КонецЕсли;	
		
		Если Черновик = Истина Тогда
			тзDraft.Удалить(ТекСтрокатзDraft);
			
			БылоИзменение = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если БылоИзменение Тогда
		ЗаписатьТзВОбщиеНастройки("тзDraft");
	КонецЕсли;
	
	
	
	
	
	
	
	
Конецпроцедуры

&НаКлиенте
Процедура тзЧерновикиВыбратьВсе(Команда)
	Для Каждого строка Из тзЧерновики Цикл
		Строка.Действие = Не Строка.Действие;
	Конеццикла;
КонецПроцедуры

&НаКлиенте
Процедура тзЧерновикиПереименовать(Команда)
	
	ТекСтрока = Элементы.тзЧерновики.ТекущаяСтрока;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
	Наименование = тзЧерновики.НайтиПоИдентификатору(ТекСтрока).Наименование;
	
	Подсказка = "Введите новое наименование черновика!";
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаНаименованияЧерновика",ЭтаФорма);
	ПоказатьВводСтроки(Оповещение,Наименование, Подсказка, 50, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаНаименованияЧерновика(Строка, Параметры) Экспорт
	Если НЕ Строка = Неопределено Тогда
		ТекСтрока = Элементы.тзЧерновики.ТекущаяСтрока;
		
		Если ТекСтрока = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПереименоватьУдалитьШаблонЧерновик(ТекСтрока,"D",Строка,"Переименовать","тзЧерновики");
		ОбновитьШаблонЧерновик();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаписатьШаблонНаПочту(Наименование)
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат("");
	КонецЕсли;
	Если Наименование = "update" тогда
		Метод = "update";
		Реф = "
		|<Ref>"+СокрЛП(ШаблонРеф)+"</Ref>";
	иначе
		Метод = "save";
		Реф = "
		|<DescriptionTemplate>"+Наименование+"</DescriptionTemplate>";
	КонецЕсли;
	//Если ЗначениеЗаполнено(Заказ) Тогда
	//	ДатаНак = ?(ДатаНакладной = Дата('00010101'),Формат(Заказ.ДатаОтгрузки,"ДФ=dd.MM.yyyy"),Формат(ДатаНакладной,"ДФ=dd.MM.yyyy"));
	//Иначе
	//	ДатаНак = ?(ДатаНакладной = Дата('00010101'),Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy"),Формат(ДатаНакладной,"ДФ=dd.MM.yyyy"));
	//конецЕсли;
	
	ДатаНак = ?(ДатаНакладной = Дата('00010101'),Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy"),Формат(ДатаНакладной,"ДФ=dd.MM.yyyy"));
	
	Баркод = "";
	Если сокрЛП(ВНомерЗаказа) <> "" Тогда
		Баркод = "
		|		<InfoRegClientBarcodes>"+сокрЛП(ВНомерЗаказа)+"</InfoRegClientBarcodes>";
	КонецЕсли;
	запрос=
	"<?xml version=""1.0"" encoding=""UTF-8"" ?>
	|<file>
	|<apiKey>"+Объект.КлючAPI+"</apiKey>
	|<modelName>InternetDocumentTemplate</modelName>
	|<calledMethod>"+Метод+"</calledMethod>
	|<methodProperties>"+Реф+"                                                                                  
	|<PayerType>"+СокрЛП(PayerType)+"</PayerType>
	|<PaymentMethod>"+СокрЛП(PForm)+"</PaymentMethod>
	|<DateTime>"+ДатаНак+"</DateTime>
	|<CargoType>"+CargoType+"</CargoType>
	|<VolumeGeneral>{Объем}</VolumeGeneral>
	|<Weight>{Вес}</Weight>
	|<ServiceType>"+ServiceType+"</ServiceType>
	|<SeatsAmount>"+Строка(Мест)+"</SeatsAmount>
	|<Description>"+DescriptionCargo+"</Description>
	|<Cost>"+формат(ЗСтоимость,"ЧГ=")+"</Cost>
	|<CitySender>"+сокрЛП(CitySender)+"</CitySender>
	|<Sender>"+СокрЛП(Sender)+"</Sender>
	|<SenderAddress>{АдресОтправителя}</SenderAddress>
	|<ContactSender>"+СокрЛП(ContactSender)+"</ContactSender>
	|<SendersPhone>"+СокрЛП(SendersPhone)+"</SendersPhone>
	|<CityRecipient>"+СокрЛП(CityRecipient)+"</CityRecipient>
	|<Recipient>"+сокрЛП(Recipient)+"</Recipient>
	|<RecipientAddress>{АдресПолучателя}</RecipientAddress>
	|<ContactRecipient>"+сокрЛП(ContactRecipient)+"</ContactRecipient>
	|<RecipientsPhone>"+СокрЛП(RecipientsPhone)+"</RecipientsPhone>"+Баркод+"
	|<MarketplacePartnerToken>c4132d2bf518-9f02-4911-f6fd-afa6f118</MarketplacePartnerToken>
	|</methodProperties>
	|</file>";
	Если НЕ CargoType = "Cargo" Тогда
		запрос=СтрЗаменить(запрос,"{Объем}","");
		запрос=СтрЗаменить(запрос,"{Вес}",стрЗаменить(строка(Вес),Символы.НПП,""));
	Иначе
		Если Вес = 0 Тогда
			запрос=СтрЗаменить(запрос,"{Объем}",стрЗаменить(строка(Объем),Символы.НПП,""));
			запрос=СтрЗаменить(запрос,"{Вес}","");
		Иначе
			запрос=СтрЗаменить(запрос,"{Объем}","");
			запрос=СтрЗаменить(запрос,"{Вес}",стрЗаменить(строка(Вес),Символы.НПП,""));
		КонецЕсли;
	КонецЕсли;
	Если ServiceType = "WarehouseWarehouse" Или ServiceType = "WarehouseDoors" тогда
		запрос=СтрЗаменить(запрос,"{АдресОтправителя}",WarhousOut);
		Если ServiceType = "WarehouseWarehouse" Тогда
			запрос=СтрЗаменить(запрос,"{АдресПолучателя}",WarhousIn);
		иначе
			запрос=СтрЗаменить(запрос,"{АдресПолучателя}",RecipientAddress);
		конецЕсли;
	Иначе
		запрос=СтрЗаменить(запрос,"{АдресОтправителя}",SenderAddress);
		Если ServiceType = "DoorsWarehouse" Тогда
			запрос=СтрЗаменить(запрос,"{АдресПолучателя}",WarhousIn);
		иначе
			запрос=СтрЗаменить(запрос,"{АдресПолучателя}",RecipientAddress);
		конецЕсли;
	конецЕсли;
	
	Ответтекст = GetXMLResponserNewPost(запрос);
	Если СтрЧислоВхождений(Ответтекст,"<success>true</success>") Тогда
		Реф = "";
		Чтение=new ЧтениеXML;
		Чтение.УстановитьСтроку(Ответтекст);
		Пока(Чтение.Прочитать()) Цикл
			Если чтение.Имя="Ref" И чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
				чтение.Прочитать();
				Реф=чтение.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат(Реф);
	Иначе
		Если Ответтекст = "" Тогда
			Сообщить("Неизвестная ошибка при отправке запроса");
			Возврат "";
		Иначе	
			Сообщить(СформироватьТекстОшибки(Ответтекст));
			Возврат("");
		КонецЕсли;
	КонецЕсли;
КонецФункции


