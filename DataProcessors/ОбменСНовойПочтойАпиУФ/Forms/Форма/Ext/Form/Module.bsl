&НаКлиенте 
Процедура КонтрагентыВыборДействия(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Результат.Значение = "Удалить" Тогда
		
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаНаУдалениеКонтрагента", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Вы действительно хотите удалить контрагента?", Режим, 0); 
		
		
	Иначе	
		
		
		Если Элементы.ГруппаКонтрагентов.ТекущаяСтраница.Имя = "Получатели" Тогда
			ТекСтрока = Элементы.тзКонтрагентыПолучатели.ТекущаяСтрока;
			ИзменитьДанныеКонтрагента(ТекСтрока,"Recipient",Результат.Значение);
		ИначеЕсли Элементы.ГруппаКонтрагентов.ТекущаяСтраница.Имя = "Отправители" Тогда
			ТекСтрока = Элементы.тзКонтрагентыОтправители.ТекущаяСтрока;
			ИзменитьДанныеКонтрагента(ТекСтрока,"Sender",Результат.Значение);
		ИначеЕсли Элементы.ГруппаКонтрагентов.ТекущаяСтраница.Имя = "ТретьеЛицо" Тогда
			ТекСтрока = Элементы.тзКонтрагентыТретьеЛицо.ТекущаяСтрока;
			ИзменитьДанныеКонтрагента(ТекСтрока,"ThirdPerson",Результат.Значение);
		КонецЕсли; 	
		
		
	КонецЕсли
	
	
	
КонецПроцедуры

&НаКлиенте 
Процедура ПослеЗакрытияВопросаНаУдалениеКонтрагента(Результат, ПараметрыОповещения) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ГруппаКонтрагентов.ТекущаяСтраница.Имя = "Получатели" Тогда
		ТекСтрока = Элементы.тзКонтрагентыПолучатели.ТекущаяСтрока;
		УдалитьДанныеКонтрагента(ТекСтрока,"Recipient","Удалить");
	ИначеЕсли Элементы.ГруппаКонтрагентов.ТекущаяСтраница.Имя = "Отправители" Тогда
		ТекСтрока = Элементы.тзКонтрагентыОтправители.ТекущаяСтрока;
		УдалитьДанныеКонтрагента(ТекСтрока,"Sender","Удалить");
	ИначеЕсли Элементы.ГруппаКонтрагентов.ТекущаяСтраница.Имя = "ТретьеЛицо" Тогда
		ТекСтрока = Элементы.тзКонтрагентыТретьеЛицо.ТекущаяСтрока;
		УдалитьДанныеКонтрагента(ТекСтрока,"ThirdPerson","Удалить");
	КонецЕсли; 	
	
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПолноеИмяФормы(ИмяФормы)
	
	СимволТочка = ".";
	ПозицияТочки = СтрДлина(ЭтаФорма.ИмяФормы);
	Пока Сред(ЭтаФорма.ИмяФормы, ПозицияТочки, 1) <> СимволТочка Цикл ПозицияТочки = ПозицияТочки - 1; КонецЦикла; 
	Возврат Лев(ЭтаФорма.ИмяФормы, ПозицияТочки) + ИмяФормы;
	
КонецФункции

&НаСервере
Процедура УдалитьДанныеКонтрагента(ТекСтрокаИдентификатор,ВидКонтрагента,Действие,ПутьКФормеРедактирования ="")
	Если СокрЛП(Объект.КлючAPI) = "" Тогда
		Сообщить("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	ТекущийКлюч = Объект.КлючAPI;
	
	Если ВидКонтрагента = "Recipient" Тогда
		СтрокаКонтрагента = тзКонтрагентыПолучатели.НайтиПоИдентификатору(ТекСтрокаИдентификатор);
	ИначеЕсли ВидКонтрагента = "Sender" Тогда
		СтрокаКонтрагента = тзКонтрагентыОтправители.НайтиПоИдентификатору(ТекСтрокаИдентификатор);
	ИначеЕсли ВидКонтрагента = "ThirdPerson" Тогда
		СтрокаКонтрагента = тзКонтрагентыТретьеЛицо.НайтиПоИдентификатору(ТекСтрокаИдентификатор);
	Иначе
		Возврат;
	КонецЕсли; 	
	
	
	
	
	Если ВидКонтрагента <> "Sender" Тогда
		Идентификатор = Строка(СтрокаКонтрагента.Идентификатор);
		ТекстЗАпроса = "<?xml version=""1.0"" encoding=""UTF-8"" ?>
		|<file>
		|<apiKey>"+ТекущийКлюч+"</apiKey>
		|<calledMethod>delete</calledMethod>
		|<methodProperties>
		|<Ref>"+Идентификатор+"</Ref>
		|</methodProperties>
		|<modelName>Counterparty</modelName>
		|</file>
		|";
		Попытка
			ХМЛХТТП = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
		Исключение
			ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
		КонецПопытки;
		ХМЛХТТП.Open("POST", ТочкаВхода, Ложь);
		ХМЛХТТП.SetRequestHeader("Content-Type", "text/xml");
		ХМЛХТТП.Send(ТекстЗапроса);
		Ответ = ХМЛХТТП.ResponseText;
		Если СтрЧислоВхождений(Ответ,"<success>true</success>") > 0 Тогда
			СтруктураДанных = новый Структура;
			СтруктураДанных.Вставить("Контрагент", Истина);
			СтруктураДанных.Вставить("Контакт",Истина);
			СтруктураДанных.Вставить("Адрес",Истина);
			ОбновитьКонтрагентов(СтруктураДанных);
			Сообщить("Контрагент "+СтрокаКонтрагента.Контрагент+"удален!");
		Иначе
			Сообщить(СформироватьТекстОшибки(ТекстЗапроса));
		КонецЕсли;
	Иначе
		Сообщить("Удалить контрагента - отправителя самостоятельно невозможно, обратитесь к вашему менеджеру!");
	КонецЕсли;
конецпроцедуры

