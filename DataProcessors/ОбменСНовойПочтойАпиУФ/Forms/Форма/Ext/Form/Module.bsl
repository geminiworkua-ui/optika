Процедура тзЧерновикиУдалить(Команда)
	
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаНаУдалениеЧерновика", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, "Вы хотите удалить выбранный(е) черновик(и)?", Режим, 0);	
	
	
КонецПроцедуры

