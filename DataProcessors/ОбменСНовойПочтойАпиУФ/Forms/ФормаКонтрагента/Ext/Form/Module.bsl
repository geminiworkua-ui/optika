&НаКлиенте
Процедура ГородОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Голова = Врег(ЛЕв(Текст,1));
	Хвост = Сред(Текст,2);
	Текст = Голова+Хвост;
	Города = новый СписокЗначений;
	лонг = СтрДлина(текст);
	Для Каждого строка Из СписокГородов Цикл
		Если Лев(Строка.Представление,лонг) = текст Тогда
			Города.Добавить(Строка.Значение,Строка.Представление);
		КонецЕсли;
	Конеццикла;
	
	СтруктураСтарыхЗначений = Новый Структура;
	СтруктураСтарыхЗначений.Вставить("Город",Город);
	СтруктураСтарыхЗначений.Вставить("ГородИн",ГородИн);
	СтруктураСтарыхЗначений.Вставить("ГородАд",ГородАд);
	
	
	Если Города.Количество() = 0 Тогда
		Город = "";
		ГородИн = "";
		ГородАд = "";
	Иначе
		Оповещение = Новый ОписаниеОповещения("ВыборГорода", ЭтаФорма,СтруктураСтарыхЗначений);
		ПоказатьВыборИзСписка(Оповещение,Города);	
	КонецЕсли;

