
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Дата = ТекущаяДата();
	ПодобратьПараметрыКТК();
	ПерезаполнитьАнализПродаж();
	
	ЭтаФорма.Склад = Справочники.Склады.НайтиПоНаименованию(" Склад");
	
	
КонецПроцедуры

 &НаСервере
 Процедура ПодобратьПараметрыКТК()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыКТКСрезПоследних.КТК_сезон,
		|	ПараметрыКТКСрезПоследних.КТК_БС
		|ИЗ
		|	РегистрСведений.ПараметрыКТК.СрезПоследних(&Дата, ) КАК ПараметрыКТКСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", ЭтаФорма.Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЭтаФорма.КТК_БС = Выборка.КТК_БС;
		ЭтаФорма.КТК_Сезон = Выборка.КТК_Сезон; 
		
	Иначе
		Сообщить("На указанную дату не определены параметры клакссификации товаров для управления ассортиментом");
		
		
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
			ЭтаФорма.Элементы.СтраницаАнализМарки.Видимость = Ложь;
		ЭтаФорма.Элементы.СтраницаАнализОстатков.Видимость = Ложь;
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьАнализПродаж()
	
	Если ЭтаФорма.ВариантОбработки = "Магазин" 
		Тогда  СформироватьАнализМагазина();
	ИначеЕсли
		ЭтаФорма.ВариантОбработки = "Марка" 
		Тогда  СформироватьАнализМарки();
	КонецЕсли;
	
	ПересобратьСводнуюТаблицуПоСкладу();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьАнализМагазина()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Бренд КАК Марка,
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.БС,
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Сезон,
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Максимум,
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Норма
		|ПОМЕСТИТЬ вт_ПланОстатков
		|ИЗ
		|	РегистрСведений.ПараметрыОбеспеченияАссортиментом.СрезПоследних(&Дата, ) КАК ПараметрыОбеспеченияАссортиментомСрезПоследних
		|ГДЕ
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Магазин = &Магазин
		|	И ПараметрыОбеспеченияАссортиментомСрезПоследних.ВидНоменклатуры = &ВидНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СвободныеОстаткиОстатки.Номенклатура,
		|	СвободныеОстаткиОстатки.Характеристика,
		|	СвободныеОстаткиОстатки.ВНаличииОстаток КАК Остаток,
		|	ВЫБОР
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.РейтингПродаж = &БС
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.КоллекцияНоменклатуры = &Сезон
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|	КОНЕЦ КАК КТК,
		|	СвободныеОстаткиОстатки.Номенклатура.Марка КАК Марка
		|ПОМЕСТИТЬ вт_ОстТоваровНаСкладе
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(&Дата, ) КАК СвободныеОстаткиОстатки
		|ГДЕ
		|	СвободныеОстаткиОстатки.Склад = &Магазин
		|	И СвободныеОстаткиОстатки.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФормаПланПеремещений.Марка,
		|	ФормаПланПеремещений.Номенклатура,
		|	ФормаПланПеремещений.Характеристика,
		|	ФормаПланПеремещений.Количество,
		|	ФормаПланПеремещений.КТК,
		|	ФормаПланПеремещений.ИзНаличия
		|ПОМЕСТИТЬ вт_ПланПеремещений
		|ИЗ
		|	&ФормаПланПеремещений КАК ФормаПланПеремещений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ПланОстатков.Марка,
		|	вт_ПланОстатков.БС КАК ОстПланБС,
		|	вт_ПланОстатков.Сезон КАК ОстПланСезон,
		|	вт_ПланОстатков.Максимум КАК ОстПланМакс,
		|	вт_ПланОстатков.Норма КАК ОстПланОбычн,
		|	ЕСТЬNULL(вт_ПланОстатков.БС, 0) + ЕСТЬNULL(вт_ПланОстатков.Сезон, 0) + ЕСТЬNULL(вт_ПланОстатков.Норма, 0) КАК ОстПланВсего,
		|	NULL КАК ЗаказБС,
		|	NULL КАК ЗаказСезон,
		|	NULL КАК ЗаказОбычн,
		|	NULL КАК ЗаказВсего,
		|	NULL КАК ОстФактБС,
		|	NULL КАК ОстФактСезон,
		|	NULL КАК ОстФактОбычн,
		|	NULL КАК ОстФактВсего
		|ПОМЕСТИТЬ вт_ПервОбъединение
		|ИЗ
		|	вт_ПланОстатков КАК вт_ПланОстатков
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	вт_ПланПеремещений.Марка,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	ВЫБОР
		|		КОГДА вт_ПланПеремещений.КТК = ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|			ТОГДА ЕСТЬNULL(вт_ПланПеремещений.Количество, 0)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА вт_ПланПеремещений.КТК = ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|			ТОГДА ЕСТЬNULL(вт_ПланПеремещений.Количество, 0)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА вт_ПланПеремещений.КТК = ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|			ТОГДА ЕСТЬNULL(вт_ПланПеремещений.Количество, 0)
		|	КОНЕЦ,
		|	ЕСТЬNULL(вт_ПланПеремещений.Количество, 0),
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	вт_ПланПеремещений КАК вт_ПланПеремещений
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	вт_ОстТоваровНаСкладе.Марка,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	ВЫБОР
		|		КОГДА вт_ОстТоваровНаСкладе.КТК = ЗНАЧЕНИЕ(перечисление.КТК.БС)
		|			ТОГДА ЕСТЬNULL(вт_ОстТоваровНаСкладе.Остаток, 0)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА вт_ОстТоваровНаСкладе.КТК = ЗНАЧЕНИЕ(перечисление.КТК.Сезон)
		|			ТОГДА ЕСТЬNULL(вт_ОстТоваровНаСкладе.Остаток, 0)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА вт_ОстТоваровНаСкладе.КТК = ЗНАЧЕНИЕ(перечисление.КТК.Обычн)
		|			ТОГДА ЕСТЬNULL(вт_ОстТоваровНаСкладе.Остаток, 0)
		|	КОНЕЦ,
		|	ЕСТЬNULL(вт_ОстТоваровНаСкладе.Остаток, 0)
		|ИЗ
		|	вт_ПланОстатков КАК вт_ПланОстатков
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ОстТоваровНаСкладе КАК вт_ОстТоваровНаСкладе
		|		ПО вт_ПланОстатков.Марка = вт_ОстТоваровНаСкладе.Марка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ПервОбъединение.Марка,
		|	СУММА(вт_ПервОбъединение.ЗаказБС) КАК ЗаказБС,
		|	СУММА(вт_ПервОбъединение.ЗаказСезон) КАК ЗаказСезон,
		|	СУММА(вт_ПервОбъединение.ЗаказОбычн) КАК ЗаказОбычн,
		|	СУММА(вт_ПервОбъединение.ЗаказВсего) КАК ЗаказВсего,
		|	СУММА(вт_ПервОбъединение.ОстФактБС) КАК ОстФактБС,
		|	СУММА(вт_ПервОбъединение.ОстФактСезон) КАК ОстФактСезон,
		|	СУММА(вт_ПервОбъединение.ОстФактОбычн) КАК ОстФактОбычн,
		|	СУММА(вт_ПервОбъединение.ОстФактВсего) КАК ОстФактВсего,
		|	СУММА(ЕСТЬNULL(вт_ПервОбъединение.ОстФактБС, 0) + ЕСТЬNULL(вт_ПервОбъединение.ЗаказБС, 0)) КАК ОстНовБС,
		|	СУММА(ЕСТЬNULL(вт_ПервОбъединение.ОстФактСезон, 0) + ЕСТЬNULL(вт_ПервОбъединение.ЗаказСезон, 0)) КАК ОстНовСезон,
		|	СУММА(ЕСТЬNULL(вт_ПервОбъединение.ОстФактОбычн, 0) + ЕСТЬNULL(вт_ПервОбъединение.ЗаказОбычн, 0)) КАК ОстНовОбычн,
		|	СУММА(ЕСТЬNULL(вт_ПервОбъединение.ОстФактВсего, 0) + ЕСТЬNULL(вт_ПервОбъединение.ЗаказВсего, 0)) КАК ОстНовВсего,
		|	СУММА(вт_ПервОбъединение.ОстПланБС) КАК ОстПланБС,
		|	СУММА(вт_ПервОбъединение.ОстПланСезон) КАК ОстПланСезон,
		|	СУММА(вт_ПервОбъединение.ОстПланМакс) КАК ОстПланМакс,
		|	СУММА(вт_ПервОбъединение.ОстПланОбычн) КАК ОстПланОбычн,
		|	СУММА(вт_ПервОбъединение.ОстПланВсего) КАК ОстПланВсего
		|ИЗ
		|	вт_ПервОбъединение КАК вт_ПервОбъединение
		|ГДЕ
		|	НЕ вт_ПервОбъединение.Марка ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ПервОбъединение.Марка";
	
	
	Запрос.УстановитьПараметр("Дата", ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("Магазин", ЭтаФорма.Магазин);
	Запрос.УстановитьПараметр("Сезон", ЭтаФорма.КТК_Сезон);   
	Запрос.УстановитьПараметр("БС", ЭтаФорма.КТК_БС);

    Запрос.УстановитьПараметр("ВидНоменклатуры", ЭтаФорма.ВидНоменклатуры);
	Запрос.УстановитьПараметр("ФормаПланПеремещений", ЭтаФорма.ТаблицаЗаказов.Выгрузить());

	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	ЭтаФорма.ТаблицаАнализа.Очистить();
	ЭтаФорма.ТаблицаАнализа.Загрузить(ТЗ);
	
	Для каждого Стр из ЭтаФорма.ТаблицаАнализа цикл
		
		Если число(Стр.ОстНовВсего) > число(стр.ОстПланМакс)
			Тогда
			Стр.ПревышениеМакс = число(Стр.ОстНовВсего) - число(стр.ОстПланМакс);
		КонецЕсли;
		
     КонецЦикла;
		
	
	
	
	
	
КонецПроцедуры	

&НаСервере
Процедура СформироватьАнализМарки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Бренд КАК Марка,
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.БС,
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Сезон,
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Максимум,
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Норма,
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Магазин
		|ПОМЕСТИТЬ вт_ПланОстатков
		|ИЗ
		|	РегистрСведений.ПараметрыОбеспеченияАссортиментом.СрезПоследних(&Дата, ) КАК ПараметрыОбеспеченияАссортиментомСрезПоследних
		|ГДЕ
		|	ПараметрыОбеспеченияАссортиментомСрезПоследних.Магазин.ТипСклада = &ТипСклада
		|	И ПараметрыОбеспеченияАссортиментомСрезПоследних.ВидНоменклатуры = &ВидНоменклатуры
		|	И ПараметрыОбеспеченияАссортиментомСрезПоследних.Бренд = &Марка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СвободныеОстаткиОстатки.Номенклатура,
		|	СвободныеОстаткиОстатки.Характеристика,
		|	СвободныеОстаткиОстатки.ВНаличииОстаток КАК Остаток,
		|	ВЫБОР
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.РейтингПродаж = &БС
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.КоллекцияНоменклатуры = &Сезон
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|	КОНЕЦ КАК КТК,
		|	СвободныеОстаткиОстатки.Номенклатура.Марка КАК Марка,
		|	СвободныеОстаткиОстатки.Склад КАК Магазин
		|ПОМЕСТИТЬ вт_ОстТоваровНаСкладе
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(&Дата, ) КАК СвободныеОстаткиОстатки
		|ГДЕ
		|	СвободныеОстаткиОстатки.Склад.ТипСклада = &ТипСклада
		|	И СвободныеОстаткиОстатки.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|	И СвободныеОстаткиОстатки.Номенклатура.Марка = &Марка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФормаПланПеремещений.Марка,
		|	ФормаПланПеремещений.Номенклатура,
		|	ФормаПланПеремещений.Характеристика,
		|	ФормаПланПеремещений.Количество,
		|	ФормаПланПеремещений.КТК,
		|	ФормаПланПеремещений.ИзНаличия,
		|	ФормаПланПеремещений.Магазин
		|ПОМЕСТИТЬ вт_ПланПеремещений
		|ИЗ
		|	&ФормаПланПеремещений КАК ФормаПланПеремещений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ПланОстатков.БС КАК ОстПланБС,
		|	вт_ПланОстатков.Сезон КАК ОстПланСезон,
		|	вт_ПланОстатков.Максимум КАК ОстПланМакс,
		|	вт_ПланОстатков.Норма КАК ОстПланОбычн,
		|	ЕСТЬNULL(вт_ПланОстатков.БС, 0) + ЕСТЬNULL(вт_ПланОстатков.Сезон, 0) + ЕСТЬNULL(вт_ПланОстатков.Норма, 0) КАК ОстПланВсего,
		|	NULL КАК ЗаказБС,
		|	NULL КАК ЗаказСезон,
		|	NULL КАК ЗаказОбычн,
		|	NULL КАК ЗаказВсего,
		|	NULL КАК ОстФактБС,
		|	NULL КАК ОстФактСезон,
		|	NULL КАК ОстФактОбычн,
		|	NULL КАК ОстФактВсего,
		|	вт_ПланОстатков.Магазин КАК Магазин
		|ПОМЕСТИТЬ вт_ПервОбъединение
		|ИЗ
		|	вт_ПланОстатков КАК вт_ПланОстатков
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	ВЫБОР
		|		КОГДА вт_ПланПеремещений.КТК = ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|			ТОГДА ЕСТЬNULL(вт_ПланПеремещений.Количество, 0)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА вт_ПланПеремещений.КТК = ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|			ТОГДА ЕСТЬNULL(вт_ПланПеремещений.Количество, 0)
		|	КОНЕЦ,
		|	ВЫБОР
