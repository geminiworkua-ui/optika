&НаСервере
Процедура ПересобратьСводнуюТаблицуПоСкладу()
	
		Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СвободныеОстаткиОстатки.Номенклатура,
		|	СвободныеОстаткиОстатки.Характеристика,
		|	СвободныеОстаткиОстатки.ВНаличииОстаток КАК Остаток,
		|	ВЫБОР
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.РейтингПродаж = &БС
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.КоллекцияНоменклатуры = &Сезон
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|	КОНЕЦ КАК КТК,
		|	СвободныеОстаткиОстатки.Номенклатура.Марка КАК Марка,
		|	СвободныеОстаткиОстатки.Склад КАК Магазин
		|ПОМЕСТИТЬ вт_ОстТоваровНаСкладе
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(&Дата, ) КАК СвободныеОстаткиОстатки
		|ГДЕ
		|	СвободныеОстаткиОстатки.Склад.ТипСклада = &ТипСкладаСклад
		|	И СвободныеОстаткиОстатки.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|	И СвободныеОстаткиОстатки.Номенклатура.Марка = &Марка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СвободныеОстаткиОстатки.Номенклатура,
		|	СвободныеОстаткиОстатки.Характеристика,
		|	СвободныеОстаткиОстатки.ВНаличииОстаток КАК Остаток,
		|	ВЫБОР
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.РейтингПродаж = &БС
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.КоллекцияНоменклатуры = &Сезон
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|	КОНЕЦ КАК КТК,
		|	СвободныеОстаткиОстатки.Номенклатура.Марка КАК Марка,
		|	СвободныеОстаткиОстатки.Склад КАК Магазин
		|ПОМЕСТИТЬ вт_ОстТоваровВМагазинах
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(&Дата, ) КАК СвободныеОстаткиОстатки
		|ГДЕ
		|	СвободныеОстаткиОстатки.Склад.ТипСклада = &ТипСкладаМагазин
		|	И СвободныеОстаткиОстатки.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|	И СвободныеОстаткиОстатки.Номенклатура.Марка = &Марка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФормаПланПеремещений.Марка,
		|	ФормаПланПеремещений.Номенклатура,
		|	ФормаПланПеремещений.Характеристика,
		|	ФормаПланПеремещений.Количество,
		|	ФормаПланПеремещений.КТК,
		|	ФормаПланПеремещений.ИзНаличия,
		|	ФормаПланПеремещений.Магазин
		|ПОМЕСТИТЬ вт_ПланПеремещений
		|ИЗ
		|	&ФормаПланПеремещений КАК ФормаПланПеремещений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА вт_ПланПеремещений.КТК = ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|			ТОГДА ЕСТЬNULL(вт_ПланПеремещений.Количество, 0)
		|	КОНЕЦ КАК БС,
		|	ВЫБОР
		|		КОГДА вт_ПланПеремещений.КТК = ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|			ТОГДА ЕСТЬNULL(вт_ПланПеремещений.Количество, 0)
		|	КОНЕЦ КАК Сезон,
		|	ВЫБОР
		|		КОГДА вт_ПланПеремещений.КТК = ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|			ТОГДА ЕСТЬNULL(вт_ПланПеремещений.Количество, 0)
		|	КОНЕЦ КАК Обычн,
		|	ЕСТЬNULL(вт_ПланПеремещений.Количество, 0) КАК Всего,
		|	""План переміщень"" КАК Показатель
		|ПОМЕСТИТЬ вт_ПервОбъединение
		|ИЗ
		|	вт_ПланПеремещений КАК вт_ПланПеремещений
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА вт_ОстТоваровНаСкладе.КТК = ЗНАЧЕНИЕ(перечисление.КТК.БС)
		|			ТОГДА ЕСТЬNULL(вт_ОстТоваровНаСкладе.Остаток, 0)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА вт_ОстТоваровНаСкладе.КТК = ЗНАЧЕНИЕ(перечисление.КТК.Сезон)
		|			ТОГДА ЕСТЬNULL(вт_ОстТоваровНаСкладе.Остаток, 0)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА вт_ОстТоваровНаСкладе.КТК = ЗНАЧЕНИЕ(перечисление.КТК.Обычн)
		|			ТОГДА ЕСТЬNULL(вт_ОстТоваровНаСкладе.Остаток, 0)
		|	КОНЕЦ,
		|	ЕСТЬNULL(вт_ОстТоваровНаСкладе.Остаток, 0),
		|	""Залишки на складі""
		|ИЗ
		|	вт_ОстТоваровНаСкладе КАК вт_ОстТоваровНаСкладе
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА вт_ОстТоваровВМагазинах.КТК = ЗНАЧЕНИЕ(перечисление.КТК.БС)
		|			ТОГДА ЕСТЬNULL(вт_ОстТоваровВМагазинах.Остаток, 0)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА вт_ОстТоваровВМагазинах.КТК = ЗНАЧЕНИЕ(перечисление.КТК.Сезон)
		|			ТОГДА ЕСТЬNULL(вт_ОстТоваровВМагазинах.Остаток, 0)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА вт_ОстТоваровВМагазинах.КТК = ЗНАЧЕНИЕ(перечисление.КТК.Обычн)
		|			ТОГДА ЕСТЬNULL(вт_ОстТоваровВМагазинах.Остаток, 0)
		|	КОНЕЦ,
		|	ЕСТЬNULL(вт_ОстТоваровВМагазинах.Остаток, 0),
		|	""Залишки в магазінах""
		|ИЗ
		|	вт_ОстТоваровВМагазинах КАК вт_ОстТоваровВМагазинах
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(вт_ПервОбъединение.БС) КАК БС,
		|	СУММА(вт_ПервОбъединение.Сезон) КАК Сезон,
		|	СУММА(вт_ПервОбъединение.Обычн) КАК Обычн,
		|	СУММА(вт_ПервОбъединение.Всего) КАК Всего,
		|	вт_ПервОбъединение.Показатель
		|ИЗ
		|	вт_ПервОбъединение КАК вт_ПервОбъединение
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ПервОбъединение.Показатель";
	
	
	Запрос.УстановитьПараметр("Дата", ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("Марка", ЭтаФорма.Марка);
	Запрос.УстановитьПараметр("Сезон", ЭтаФорма.КТК_Сезон);   
	Запрос.УстановитьПараметр("БС", ЭтаФорма.КТК_БС);
	Запрос.УстановитьПараметр("ТипСкладаСклад", Перечисления.ТипыСкладов.ОптовыйСклад);
	Запрос.УстановитьПараметр("ТипСкладаМагазин", Перечисления.ТипыСкладов.РозничныйМагазин);
    Запрос.УстановитьПараметр("ВидНоменклатуры", ЭтаФорма.ВидНоменклатуры);
	Запрос.УстановитьПараметр("ФормаПланПеремещений", ЭтаФорма.ТаблицаЗаказов.Выгрузить());

	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	ЭтаФорма.ТаблицаПланСклада.Очистить();
	ЭтаФорма.ТаблицаПланСклада.Загрузить(ТЗ);
	
   БСит = 0;
   СезонИт = 0;
   ОбычнИт = 0;
   ВсегоИт = 0;
	
	// собрать план по складу
	Для каждого Стр из ЭтаФорма.ТаблицаПланСклада цикл
		
		Если Стр.Показатель = "Залишки на складі"
			Тогда  
			БСит    = БСит    + число(Стр.БС);
			СезонИт = СезонИт + число(Стр.Сезон);
			ОбычнИт = ОбычнИт + число(Стр.Обычн);
			ВсегоИт = ВсегоИт + число(Стр.Всего)
			
		ИначеЕсли Стр.Показатель = "План переміщень"
			Тогда  
			БСит    = БСит    - число(СТр.БС);
			СезонИт = СезонИт - число(Стр.Сезон);
			ОбычнИт = ОбычнИт - число(Стр.Обычн);
			ВсегоИт = ВсегоИт - число(Стр.Всего)
		
		КонецЕсли;
		
	КонецЦикла;
	
		НовСтр = ЭтаФорма.ТаблицаПланСклада.Добавить();
	    НовСтр.Показатель = "План залишку на складі";
		НовСтр.БС = БСит;
		НовСтр.Сезон = СезонИт;
		НовСтр.Обычн = ОбычнИт;
		НовСтр.Всего = ВсегоИт;
		
	// 	Собрать план по магазинам
	
		БСит = 0;
   		СезонИт = 0;
   		ОбычнИт = 0;
   		ВсегоИт = 0;

	
	Для каждого Стр из ЭтаФорма.ТаблицаПланСклада цикл
		
		Если Стр.Показатель = "Залишки в магазінах"
			Тогда  
			БСит    = БСит    + СТр.БС;
			СезонИт = СезонИт + Стр.Сезон;
			ОбычнИт = ОбычнИт + Стр.Обычн;
			ВсегоИт = ВсегоИт + Стр.Всего
			
		ИначеЕсли Стр.Показатель = "План переміщень"
			Тогда  
			БСит    = БСит    + СТр.БС;
			СезонИт = СезонИт + Стр.Сезон;
			ОбычнИт = ОбычнИт + Стр.Обычн;
			ВсегоИт = ВсегоИт + Стр.Всего		
		КонецЕсли; 
	КонецЦикла;
	
		НовСтр = ЭтаФорма.ТаблицаПланСклада.Добавить();
	    НовСтр.Показатель = "План залишків в магазінах";
		НовСтр.БС = БСит;
		НовСтр.Сезон = СезонИт;
		НовСтр.Обычн = ОбычнИт;
		НовСтр.Всего = ВсегоИт;

КонецПроцедуры	

&НаКлиенте
Процедура ТаблицаАнализа2Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтр = Элементы.ТаблицаАнализа2.ТекущиеДанные;
	
	Если Поле.Имя = "ТаблицаАнализаЗаказБС1"
		Тогда ИндКТК = 1;
	ИначеЕсли Поле.Имя = "ТаблицаАнализаЗаказСезон1"
		Тогда ИндКТК = 2;		
	ИначеЕсли Поле.Имя = "ТаблицаАнализаЗаказОбычн1"
		Тогда ИндКТК = 3;		
	Иначе
		Возврат
	КонецЕсли;
	
	Если Поле.Имя = "ТаблицаАнализаЗаказБС1"
		Тогда Норма = ТекСтр.ОстПланБС;
	ИначеЕсли Поле.Имя = "ТаблицаАнализаЗаказСезон1"
		Тогда Норма = ТекСтр.ОстПланСезон;	
	ИначеЕсли Поле.Имя = "ТаблицаАнализаЗаказОбычн1"
		Тогда Норма = ТекСтр.ОстПланОбычн;		
	Иначе
		Возврат
	КонецЕсли;
	
	
	П = новый Структура;
	П.Вставить("ВидНоменклатуры", ЭтаФорма.ВидНоменклатуры);
	П.Вставить("Магазин", ТекСтр.Магазин); 
	П.Вставить("Склад", ЭтаФорма.Склад); 
	П.Вставить("индКТК", ИндКТК);
	П.Вставить("Марка", ЭтаФорма.Марка);
	
   	
	АдресВХ = ПодобратьРесурсТоваровДлляЗаполненияФормы2(П);
	
	П = Новый Структура;
	П.Вставить("ВидНоменклатуры", ЭтаФорма.ВидНоменклатуры);
	П.Вставить("Магазин", ТекСтр.Магазин);
	П.Вставить("индКТК", ИндКТК);
	П.Вставить("АдресВХ", АдресВХ);
	П.Вставить("Норма", Норма);
	П.Вставить("Максимум", ТекСтр.ОстПланМакс);
	П.Вставить("Марка", ЭтаФорма.Марка);
	П.Вставить("Склад", ЭтаФорма.Склад);
	
	
	ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
	ОткрытьФорму("Обработка.ПополнениеАссортимента.Форма.ФормаВыбораПараметров",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

