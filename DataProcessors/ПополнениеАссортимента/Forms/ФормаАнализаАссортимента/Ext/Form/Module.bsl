		|	СУММА(ЕСТЬNULL(ПеремещСклад.ЗаказСклад, 0)) КАК ЗаказСклад,
		|	СУММА(ЕСТЬNULL(ПланЗаказ.ЗаказЗакупка, 0)) КАК ЗаказЗакупка
		|ИЗ
		|	вт_НоменклатураОтбор КАК вт_НоменклатураОтбор
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт_ОстТоваровНаСкладеОбщий.Номенклатура КАК Номенклатура,
		|			вт_ОстТоваровНаСкладеОбщий.Характеристика КАК Характеристика,
		|			вт_ОстТоваровНаСкладеОбщий.Остаток КАК ОстМагазин
		|		ИЗ
		|			вт_ОстТоваровНаСкладеОбщий КАК вт_ОстТоваровНаСкладеОбщий
		|		ГДЕ
		|			вт_ОстТоваровНаСкладеОбщий.Склад = &Магазин) КАК ОстатокМагазин
		|		ПО вт_НоменклатураОтбор.Номенклатура = ОстатокМагазин.Номенклатура
		|			И вт_НоменклатураОтбор.Характеристика = ОстатокМагазин.Характеристика
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт_ОстТоваровНаСкладеОбщий.Номенклатура КАК Номенклатура,
		|			вт_ОстТоваровНаСкладеОбщий.Характеристика КАК Характеристика,
		|			вт_ОстТоваровНаСкладеОбщий.Остаток КАК ОстСклад
		|		ИЗ
		|			вт_ОстТоваровНаСкладеОбщий КАК вт_ОстТоваровНаСкладеОбщий
		|		ГДЕ
		|			вт_ОстТоваровНаСкладеОбщий.Склад = &Склад) КАК ОстатокСклад
		|		ПО вт_НоменклатураОтбор.Номенклатура = ОстатокСклад.Номенклатура
		|			И вт_НоменклатураОтбор.Характеристика = ОстатокСклад.Характеристика
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт_ПланПеремещений.Номенклатура КАК Номенклатура,
		|			вт_ПланПеремещений.Характеристика КАК Характеристика,
		|			вт_ПланПеремещений.Количество КАК ЗаказСклад
		|		ИЗ
		|			вт_ПланПеремещений КАК вт_ПланПеремещений
		|		ГДЕ
		|			вт_ПланПеремещений.ИзНаличия) КАК ПеремещСклад
		|		ПО вт_НоменклатураОтбор.Номенклатура = ПеремещСклад.Номенклатура
		|			И вт_НоменклатураОтбор.Характеристика = ПеремещСклад.Характеристика
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт_ПланПеремещений.Номенклатура КАК Номенклатура,
		|			вт_ПланПеремещений.Характеристика КАК Характеристика,
		|			вт_ПланПеремещений.Количество КАК ЗаказЗакупка
		|		ИЗ
		|			вт_ПланПеремещений КАК вт_ПланПеремещений
		|		ГДЕ
		|			НЕ вт_ПланПеремещений.ИзНаличия) КАК ПланЗаказ
		|		ПО вт_НоменклатураОтбор.Номенклатура = ПланЗаказ.Номенклатура
		|			И вт_НоменклатураОтбор.Характеристика = ПланЗаказ.Характеристика
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_НоменклатураОтбор.Номенклатура,
		|	вт_НоменклатураОтбор.Характеристика,
		|	вт_НоменклатураОтбор.КТК";
	
	Запрос.УстановитьПараметр("Дата", ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("Склад", ЭтаФорма.Склад);
	Запрос.УстановитьПараметр("Сезон", ЭтаФорма.КТК_Сезон);   
	Запрос.УстановитьПараметр("БС", ЭтаФорма.КТК_БС); 
	Запрос.УстановитьПараметр("КТК", КТК); 
	Запрос.УстановитьПараметр("Марка", Марка); 
    Запрос.УстановитьПараметр("ВидНоменклатуры", ЭтаФорма.ВидНоменклатуры);
	Запрос.УстановитьПараметр("ФормаПланПеремещений", ЭтаФорма.ТаблицаЗаказов.Выгрузить());

	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	АдресВХ = ПоместитьВоВременноеХранилище(ТЗ, ЭтаФорма.УникальныйИдентификатор);
	
	Возврат АдресВХ;
	
