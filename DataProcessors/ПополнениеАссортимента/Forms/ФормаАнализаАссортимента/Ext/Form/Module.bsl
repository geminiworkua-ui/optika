		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|	КОНЕЦ КАК КТК
		|ПОМЕСТИТЬ вт_НоменклатураМарка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО Номенклатура.ХарактеристикаМногооборотнаяТара = ХарактеристикиНоменклатуры.Ссылка
		|ГДЕ
		|	Номенклатура.Марка = &Марка
		|	И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_НоменклатураМарка.Номенклатура КАК Номенклатура,
		|	вт_НоменклатураМарка.Характеристика КАК Характеристика,
		|	вт_НоменклатураМарка.КТК КАК КТК
		|ПОМЕСТИТЬ вт_НоменклатураОтбор
		|ИЗ
		|	вт_НоменклатураМарка КАК вт_НоменклатураМарка
		|ГДЕ
		|	вт_НоменклатураМарка.КТК = &КТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СвободныеОстаткиОстатки.Номенклатура,
		|	СвободныеОстаткиОстатки.Характеристика,
		|	СвободныеОстаткиОстатки.ВНаличииОстаток КАК Остаток,
		|	ВЫБОР
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.РейтингПродаж = &БС
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.КоллекцияНоменклатуры = &Сезон
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|	КОНЕЦ КАК КТК,
		|	СвободныеОстаткиОстатки.Номенклатура.Марка КАК Марка,
		|	СвободныеОстаткиОстатки.Склад,
		|	СвободныеОстаткиОстатки.Номенклатура.РейтингПродаж,
		|	СвободныеОстаткиОстатки.Номенклатура.КоллекцияНоменклатуры
		|ПОМЕСТИТЬ вт_ОстТоваровНаСкладеОбщий
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(
		|			&Дата,
		|			(Склад = &Магазин
		|				ИЛИ Склад = &Склад)
		|				И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|				И Номенклатура.Марка = &Марка) КАК СвободныеОстаткиОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФормаПланПеремещений.Марка,
		|	ФормаПланПеремещений.Номенклатура,
		|	ФормаПланПеремещений.Характеристика,
		|	ФормаПланПеремещений.Количество,
		|	ФормаПланПеремещений.КТК,
		|	ФормаПланПеремещений.ИзНаличия
		|ПОМЕСТИТЬ вт_ПланПеремещений
		|ИЗ
		|	&ФормаПланПеремещений КАК ФормаПланПеремещений
		|ГДЕ
		|	ФормаПланПеремещений.Марка = &Марка
		|	И ФормаПланПеремещений.КТК = &КТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_НоменклатураОтбор.Номенклатура,
		|	вт_НоменклатураОтбор.Характеристика,
		|	вт_НоменклатураОтбор.КТК,
		|	СУММА(ЕСТЬNULL(ОстатокМагазин.ОстМагазин, 0)) КАК ОстМагазин,
		|	СУММА(ЕСТЬNULL(ОстатокСклад.ОстСклад, 0)) КАК ОстСклад,
		|	СУММА(ЕСТЬNULL(ПеремещСклад.ЗаказСклад, 0)) КАК ЗаказСклад,
		|	СУММА(ЕСТЬNULL(ПланЗаказ.ЗаказЗакупка, 0)) КАК ЗаказЗакупка
		|ИЗ
		|	вт_НоменклатураОтбор КАК вт_НоменклатураОтбор
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт_ОстТоваровНаСкладеОбщий.Номенклатура КАК Номенклатура,
		|			вт_ОстТоваровНаСкладеОбщий.Характеристика КАК Характеристика,
		|			вт_ОстТоваровНаСкладеОбщий.Остаток КАК ОстМагазин
		|		ИЗ
		|			вт_ОстТоваровНаСкладеОбщий КАК вт_ОстТоваровНаСкладеОбщий
		|		ГДЕ
		|			вт_ОстТоваровНаСкладеОбщий.Склад = &Магазин) КАК ОстатокМагазин
		|		ПО вт_НоменклатураОтбор.Номенклатура = ОстатокМагазин.Номенклатура
		|			И вт_НоменклатураОтбор.Характеристика = ОстатокМагазин.Характеристика
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт_ОстТоваровНаСкладеОбщий.Номенклатура КАК Номенклатура,
		|			вт_ОстТоваровНаСкладеОбщий.Характеристика КАК Характеристика,
		|			вт_ОстТоваровНаСкладеОбщий.Остаток КАК ОстСклад
		|		ИЗ
		|			вт_ОстТоваровНаСкладеОбщий КАК вт_ОстТоваровНаСкладеОбщий
		|		ГДЕ
		|			вт_ОстТоваровНаСкладеОбщий.Склад = &Склад) КАК ОстатокСклад
		|		ПО вт_НоменклатураОтбор.Номенклатура = ОстатокСклад.Номенклатура
		|			И вт_НоменклатураОтбор.Характеристика = ОстатокСклад.Характеристика
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт_ПланПеремещений.Номенклатура КАК Номенклатура,
		|			вт_ПланПеремещений.Характеристика КАК Характеристика,
		|			вт_ПланПеремещений.Количество КАК ЗаказСклад
		|		ИЗ
		|			вт_ПланПеремещений КАК вт_ПланПеремещений
		|		ГДЕ
		|			вт_ПланПеремещений.ИзНаличия) КАК ПеремещСклад
		|		ПО вт_НоменклатураОтбор.Номенклатура = ПеремещСклад.Номенклатура
		|			И вт_НоменклатураОтбор.Характеристика = ПеремещСклад.Характеристика
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			вт_ПланПеремещений.Номенклатура КАК Номенклатура,
		|			вт_ПланПеремещений.Характеристика КАК Характеристика,
		|			вт_ПланПеремещений.Количество КАК ЗаказЗакупка
		|		ИЗ
		|			вт_ПланПеремещений КАК вт_ПланПеремещений
		|		ГДЕ
		|			НЕ вт_ПланПеремещений.ИзНаличия) КАК ПланЗаказ
		|		ПО вт_НоменклатураОтбор.Номенклатура = ПланЗаказ.Номенклатура
		|			И вт_НоменклатураОтбор.Характеристика = ПланЗаказ.Характеристика
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_НоменклатураОтбор.Номенклатура,
		|	вт_НоменклатураОтбор.Характеристика,
		|	вт_НоменклатураОтбор.КТК";
	
	Запрос.УстановитьПараметр("Дата", ЭтаФорма.Дата);
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("Склад", ЭтаФорма.Склад);
	Запрос.УстановитьПараметр("Сезон", ЭтаФорма.КТК_Сезон);   
	Запрос.УстановитьПараметр("БС", ЭтаФорма.КТК_БС); 
	Запрос.УстановитьПараметр("КТК", КТК); 
	Запрос.УстановитьПараметр("Марка", Марка); 
    Запрос.УстановитьПараметр("ВидНоменклатуры", ЭтаФорма.ВидНоменклатуры);
	Запрос.УстановитьПараметр("ФормаПланПеремещений", ЭтаФорма.ТаблицаЗаказов.Выгрузить());

	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	АдресВХ = ПоместитьВоВременноеХранилище(ТЗ, ЭтаФорма.УникальныйИдентификатор);
	
	Возврат АдресВХ;
	
КонецФункции	

&НаКлиенте
Процедура ТаблицаАнализаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтр = Элементы.ТаблицаАнализа.ТекущиеДанные;
	
	Если Поле.Имя = "ТаблицаАнализаЗаказБС"
		Тогда ИндКТК = 1;
	ИначеЕсли Поле.Имя = "ТаблицаАнализаЗаказСезон"
		Тогда ИндКТК = 2;		
	ИначеЕсли Поле.Имя = "ТаблицаАнализаЗаказОбычн"
		Тогда ИндКТК = 3;		
	Иначе
		Возврат
	КонецЕсли;
	
	Если Поле.Имя = "ТаблицаАнализаЗаказБС"
		Тогда Норма = ТекСтр.ОстПланБС;
	ИначеЕсли Поле.Имя = "ТаблицаАнализаЗаказСезон"
		Тогда Норма = ТекСтр.ОстПланСезон;	
	ИначеЕсли Поле.Имя = "ТаблицаАнализаЗаказОбычн"
		Тогда Норма = ТекСтр.ОстПланОбычн;		
	Иначе
		Возврат
	КонецЕсли;
	
	
	П = новый Структура;
	П.Вставить("ВидНоменклатуры", ЭтаФорма.ВидНоменклатуры);
	П.Вставить("Магазин", ЭтаФорма.Магазин); 
	П.Вставить("Склад", ЭтаФорма.Склад); 
	П.Вставить("индКТК", ИндКТК);
	П.Вставить("Марка", ТекСтр.Марка);
	
   	
	АдресВХ = ПодобратьРесурсТоваровДлляЗаполненияФормы(П);
	
	П = Новый Структура;
	П.Вставить("ВидНоменклатуры", ЭтаФорма.ВидНоменклатуры);
	П.Вставить("Магазин", ЭтаФорма.Магазин);
	П.Вставить("индКТК", ИндКТК);
	П.Вставить("АдресВХ", АдресВХ);
	П.Вставить("Норма", Норма);
	П.Вставить("Максимум", ТекСтр.ОстПланМакс);
	П.Вставить("Марка", ТекСтр.Марка);
	П.Вставить("Склад", ЭтаФорма.Склад);
	
	
	
	ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
	ОткрытьФорму("Обработка.ПополнениеАссортимента.Форма.ФормаВыбораПараметров",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = неопределено 
		Тогда
			
		М = неопределено;
		КТК	  = неопределено;
		Марка= неопределено;	
		Магазин = неопределено;
		СкладОтправитель = неопределено;
		
		Результат.Свойство("М",М);  
		Результат.Свойство("КТК", КТК);
		Результат.Свойство("Марка", Марка);
		Результат.Свойство("Магазин", Магазин);
		Результат.Свойство("СкладОтправитель", СкладОтправитель);
		
		// Затычка
	    СкладОтправитель = ЭтаФорма.Склад;
		
		
		Кол = ЭтаФорма.ТаблицаЗаказов.Количество();
				
		Для Инн = 0 по Кол - 1 цикл
			Инд = Кол - Инн - 1;
			
			Если 
			ЭтаФорма.ТаблицаЗаказов[Инд].КТК = КТК
			И
			ЭтаФорма.ТаблицаЗаказов[Инд].Марка = Марка
			И
			ЭтаФорма.ТаблицаЗаказов[Инд].Магазин = Магазин
				
			//И
			//ЭтаФорма.ТаблицаЗаказов[Инд].СкладОтправитель = СкладОтправитель
			Тогда
			ЭтаФорма.ТаблицаЗаказов.Удалить(Инд);
		КонецЕсли;
		КонецЦикла;
        		
		Для каждого Запись из М цикл
			
			Номенклатура     = неопределено;
			Характеристика   = неопределено;
			Количество       = неопределено;
			ИзНаличия        = неопределено;
			
			С = Запись;
			НовСтр = ЭтаФорма.ТаблицаЗаказов.Добавить();
			С.Свойство("Номенклатура", НовСтр.Номенклатура);
			С.Свойство("Характеристика", НовСтр.Характеристика); 
			С.Свойство("Количество", НовСтр.Количество);
			С.Свойство("ИзНаличия", НовСтр.ИзНаличия);
			НовСтр.КТК = КТК;
			НовСтр.Магазин = Магазин;
			НовСтр.Марка = Марка;
			НовСтр.СкладОтправитель = СкладОтправитель;
			
		КонецЦикла;
		
		ПерезаполнитьАнализПродаж();
		
	КонецЕсли;
	
КонецПроцедуры

