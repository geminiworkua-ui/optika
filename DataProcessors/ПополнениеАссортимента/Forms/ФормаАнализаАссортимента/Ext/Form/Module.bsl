&НаСервере
Функция СоздатьДокумент(ИзНаличия)
	
	// проверим, есть ли такие данніе для созлания
	
	Надо = ложь;
	Для каждого Стр из ЭтаФорма.ТаблицаЗаказов цикл
		Если Стр.ИзНаличия = ИзНаличия Тогда Надо = Истина
		КонецЕсли;
	КонецЦикла;	
		
		Если Надо = Ложь Тогда Возврат Неопределено КонецЕсли;
			
	ДокументОбъект = Документы.ЗаказНаПеремещение.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДата();
	ДокументОбъект.Организация = справочники.Организации.ОрганизацияПоУмолчанию();
	ДокументОбъект.ОрганизацияПолучатель = справочники.Организации.ОрганизацияПоУмолчанию();
	
	//ДокументОбъект.Подразделение = Справочники.СтруктураПредприятия.НайтиПоНаименованию("
	ДокументОбъект.СкладОтправитель = ЭтаФорма.Склад;
	ДокументОбъект.СкладПолучатель = ЭтаФорма.Магазин;
	ДокументОбъект.Комментарий = "Сформиовано обробкою керування асортиментом " + Строка(формат(ЭтаФорма.Дата,"ДФ='dd.MM.yyyy HH:mm'"));
	
	
	Если ИзНаличия = Истина
		Тогда
		ДокументОбъект.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	Иначе
		ДокументОбъект.Статус = Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
	КонецЕсли;
	
    ДокументОбъект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаДоНашегоСклада;
	ДокументОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	Для каждого Стр из ЭтаФорма.ТаблицаЗаказов цикл
		Если Стр.ИзНаличия = ИзНаличия Тогда
			НовСтр =  ДокументОбъект.Товары.Добавить();
			НовСтр.Номенклатура = Стр.Номенклатура;
			
			Если ЗначениеЗаполнено(Стр.Характеристика) 
				ТОгда 
				НовСтр.Характеристика = Стр.Характеристика 
			КонецЕсли;
			
			НовСтр.Количество = Стр.Количество;  
			НовСтр.КоличествоУпаковок = Стр.Количество; 
			НовСтр.Упаковка = Стр.Номенклатура.ЕдиницаИзмерения;
			НовСтр.НачалоОтгрузки = ЭтаФорма.Дата + 24*60*60;
			НовСтр.ОкончаниеПоступления = ЭтаФорма.Дата + 2* 24*60*60;
					
			
			Если ИзНаличия = Истина
				Тогда
				НовСтр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
			Иначе
				НовСтр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Требуется;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
		
	 ДокументОбъект.Записать();
	 
	 Возврат  ДокументОбъект.Ссылка;
	
		
КонецФункции

