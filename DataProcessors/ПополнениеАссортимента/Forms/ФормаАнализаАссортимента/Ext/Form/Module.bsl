		|	СУММА(ЕСТЬNULL(вт_ПервОбъединение.ОстФактОбычн, 0) + ЕСТЬNULL(вт_ПервОбъединение.ЗаказОбычн, 0)) КАК ОстНовОбычн,
		|	СУММА(ЕСТЬNULL(вт_ПервОбъединение.ОстФактВсего, 0) + ЕСТЬNULL(вт_ПервОбъединение.ЗаказВсего, 0)) КАК ОстНовВсего,
