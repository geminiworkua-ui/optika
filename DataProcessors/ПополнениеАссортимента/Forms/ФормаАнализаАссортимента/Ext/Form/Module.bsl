	П.Свойство("индКТК", ИндКТК);
	П.Свойство("Марка", Марка);
	П.Свойство("Магазин", Магазин);
	
			Если ИндКТК = 1 Тогда КТК = перечисления.КТК.БС;
	ИначеЕсли ИндКТК = 2 Тогда КТК = перечисления.КТК.Сезон;
	ИначеЕсли ИндКТК = 3 Тогда КТК = перечисления.КТК.Обычн;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
		|	ВЫБОР
		|		КОГДА Номенклатура.РейтингПродаж = &БС
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|		КОГДА Номенклатура.КоллекцияНоменклатуры = &Сезон
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|	КОНЕЦ КАК КТК
		|ПОМЕСТИТЬ вт_НоменклатураМарка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО Номенклатура.ХарактеристикаМногооборотнаяТара = ХарактеристикиНоменклатуры.Ссылка
		|ГДЕ
		|	Номенклатура.Марка = &Марка
		|	И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
