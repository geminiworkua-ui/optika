		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_НоменклатураМарка.Номенклатура КАК Номенклатура,
		|	вт_НоменклатураМарка.Характеристика КАК Характеристика,
		|	вт_НоменклатураМарка.КТК КАК КТК
		|ПОМЕСТИТЬ вт_НоменклатураОтбор
		|ИЗ
		|	вт_НоменклатураМарка КАК вт_НоменклатураМарка
		|ГДЕ
		|	вт_НоменклатураМарка.КТК = &КТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СвободныеОстаткиОстатки.Номенклатура,
		|	СвободныеОстаткиОстатки.Характеристика,
		|	СвободныеОстаткиОстатки.ВНаличииОстаток КАК Остаток,
		|	ВЫБОР
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.РейтингПродаж = &БС
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.БС)
		|		КОГДА СвободныеОстаткиОстатки.Номенклатура.КоллекцияНоменклатуры = &Сезон
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КТК.Сезон)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КТК.Обычн)
		|	КОНЕЦ КАК КТК,
		|	СвободныеОстаткиОстатки.Номенклатура.Марка КАК Марка,
		|	СвободныеОстаткиОстатки.Склад,
		|	СвободныеОстаткиОстатки.Номенклатура.РейтингПродаж,
		|	СвободныеОстаткиОстатки.Номенклатура.КоллекцияНоменклатуры
		|ПОМЕСТИТЬ вт_ОстТоваровНаСкладеОбщий
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(
		|			&Дата,
		|			(Склад = &Магазин
		|				ИЛИ Склад = &Склад)
		|				И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|				И Номенклатура.Марка = &Марка) КАК СвободныеОстаткиОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФормаПланПеремещений.Марка,
		|	ФормаПланПеремещений.Номенклатура,
		|	ФормаПланПеремещений.Характеристика,
		|	ФормаПланПеремещений.Количество,
		|	ФормаПланПеремещений.КТК,
		|	ФормаПланПеремещений.ИзНаличия
		|ПОМЕСТИТЬ вт_ПланПеремещений
		|ИЗ
		|	&ФормаПланПеремещений КАК ФормаПланПеремещений
		|ГДЕ
		|	ФормаПланПеремещений.Марка = &Марка
		|	И ФормаПланПеремещений.КТК = &КТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_НоменклатураОтбор.Номенклатура,
		|	вт_НоменклатураОтбор.Характеристика,
		|	вт_НоменклатураОтбор.КТК,
		|	СУММА(ЕСТЬNULL(ОстатокМагазин.ОстМагазин, 0)) КАК ОстМагазин,
