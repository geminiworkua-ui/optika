&НаКлиенте
Процедура ТаблицаПодбораЗаказСкладНПриИзменении(Элемент)
	
	// сверим новое кличество с соатком на складе. Если есть превышение, сократим
	
	ТекСтр = Элементы.ТаблицаПодбора.ТекущиеДанные;
	ТекСтр.ЗаказСкладН = мин( ТекСтр.ЗаказСкладН, ТекСтр.ОстСклад);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
    //ЗаполнитьЗначенияСвойств(ЭтаФорма,Параметры);
	//
	ЭтаФорма.Магазин = Параметры.Магазин;
	ЭтаФорма.АдресВХ = Параметры.АдресВХ;
	ЭтаФорма.индКТК = Параметры.индКТК;
	ЭтаФорма.Максимум = Параметры.Максимум;
	ЭтаФорма.Норма = Параметры.Норма;
	ЭтаФорма.Марка = Параметры.Марка;
	ЭтаФорма.Склад = Параметры.Склад;
	
	ТЗ = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресВХ);
	
	ЭтаФорма.ТаблицаПодбора.Загрузить(ТЗ);
		
	Для Каждого Стр из ЭтаФорма.ТаблицаПодбора цикл
		
		Стр.ЗаказСкладН = Стр.ЗаказСклад;
		Стр.ЗаказЗакупкаН = Стр.ЗаказЗакупка;
	КонецЦикла;
	
	Если      Число(ИндКТК) = 1 Тогда ЭтаФорма.КТК = Перечисления.КТК.БС;
	ИначеЕсли число(ИндКТК) = 2 Тогда ЭтаФорма.КТК = перечисления.КТК.Сезон;
	ИначеЕсли число(ИндКТК) = 3 Тогда ЭтаФорма.КТК = перечисления.КТК.Обычн;
	КонецЕсли;
		
	
КонецПроцедуры

&НаКлиенте
Процедура ПересобратьИтоги()
	
	вр_Магазин = 0;
	вр_ЗаказЗакупкаВсего = 0;
	вр_ЗаказПеремещВсего = 0;
	вр_ПревышениеМаксимума = 0;
	
	Для каждого Стр из ЭтаФорма.ТаблицаПодбора цикл
		вр_Магазин = вр_Магазин + Стр.ОстМагазин;	
		вр_ЗаказЗакупкаВсего = вр_ЗаказЗакупкаВсего + Стр.ЗаказЗакупкаН;
		   вр_ЗаказПеремещВсего = вр_ЗаказПеремещВсего + Стр.ЗаказСкладН;
	КонецЦикла;
	   
	ЭтаФорма.ЗаказЗакупкаВсего =  вр_ЗаказЗакупкаВсего;  
	ЭтаФорма.ЗаказПеремещВсего =  вр_ЗаказПеремещВсего;
	ЭтаФорма.ОстМагазинВсего =    вр_Магазин;
	
	ЭтаФорма.ОстЦелевой = число(ЭтаФорма.ЗаказЗакупкаВсего) + число(ЭтаФорма.ЗаказПеремещВсего) + число(ЭтаФорма.ОстМагазинВсего);
	
	ЭтаФорма.ПревышениеМаксимума = ЭтаФорма.ОстЦелевой - Норма;

	
КонецПроцедуры	 

&НаКлиенте
Процедура ТаблицаПодбораПриИзменении(Элемент)
	ПересобратьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПересобратьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ПринятьЗакрыть()
	
	КТК = ЭтаФорма.КТК;
	Магазин = ЭтаФорма.Магазин;
	Марка = ЭтаФорма.Марка;
	Склад = ЭтаФорма.Склад;
	
	М = новый Массив;
	
	Для каждого Стр из ЭтаФорма.ТаблицаПодбора цикл
		Если Стр.ЗаказСкладН > 0 Тогда
			С = Новый Структура;
			С.Вставить("Номенклатура", Стр.Номенклатура);
			С.Вставить("Характеристика", Стр.Характеристика); 
			С.Вставить("Количество", Стр.ЗаказСкладН);
			С.Вставить("ИзНаличия", Истина);
			С.Вставить("КТК", КТК);
			С.Вставить("Марка", Марка);
			С.Вставить("Магазин", Магазин);
			С.Вставить("СкладОтправитель", Склад);
			М.Добавить(С);
		КонецЕсли;
		
		Если Стр.ЗаказЗакупкаН > 0 Тогда
			С = Новый Структура;
			С.Вставить("Номенклатура", Стр.Номенклатура);
			С.Вставить("Характеристика", Стр.Характеристика); 
			С.Вставить("Количество", Стр.ЗаказЗакупкаН);
			С.Вставить("ИзНаличия", Ложь);
			С.Вставить("КТК", КТК);
			С.Вставить("Марка", Марка);
			С.Вставить("Магазин", Магазин);
			С.Вставить("СкладОтправитель", Склад);
			М.Добавить(С);
		КонецЕсли;
	КонецЦикла;
	П = новый Структура;
	П.Вставить("М",М);  
	П.Вставить("КТК", КТК);
	П.Вставить("Марка", Марка);
	П.Вставить("Магазин", Магазин);
	П.Вставить("СкладОтправитель", Склад);
	
	ЭтаФорма.Закрыть(П);	
	
	
	КонецПроцедуры	

&НаКлиенте
Процедура ПрименитьЗакрыть(Команда)
		ПринятьЗакрыть();
КонецПроцедуры

