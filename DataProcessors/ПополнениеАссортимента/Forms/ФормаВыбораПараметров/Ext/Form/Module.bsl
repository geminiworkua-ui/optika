&НаКлиенте
Процедура ТаблицаПодбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтр = Элементы.ТаблицаПодбора.ТекущиеДанные;
	
	Если Поле.Имя = "ТаблицаПодбораПлюсЗаказ"
		Тогда
	    ТекСтр.ЗаказЗакупкаН = ТекСтр.ЗаказЗакупкаН + 1;
	КонецЕсли;
	
	Если Поле.Имя = "ТаблицаПодбораПлюсСклад"
		Тогда
		ТекСтр.ЗаказСкладН = мин(ТекСтр.ЗаказСкладН + 1, ТекСтр.ОстСклад);
		
	КонецЕсли;
	
	
КонецПроцедуры


