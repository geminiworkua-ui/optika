
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
	
	// временно онецПроцедуры 
	
	ЭтаФорма.Подразделение = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Львів Ашан");
	ПервичнаяИнициализация();

	
	
КонецПроцедуры	
	
&НаСервере
Процедура ПервичнаяИнициализация()
	
	ТекущийПокупатель = неопределено;       
	Подразделение = неопределено;
		
	ЗаписиКврачу.Параметры.УстановитьЗначениеПараметра("Клиент", ТекущийПокупатель);
	ЗаказыКлиента.Параметры.УстановитьЗначениеПараметра("Клиент", ТекущийПокупатель);
    РекомендацииОкулиста.Параметры.УстановитьЗначениеПараметра("Клиент", ТекущийПокупатель);
    РаписаниеОкулиста.Параметры.УстановитьЗначениеПараметра("МестоПриема", Подразделение);
    ЗаказыКлиентов.Параметры.УстановитьЗначениеПараметра("Подразделение", Подразделение);

	ГрафикРаботыНаТекущийДень.Параметры.УстановитьЗначениеПараметра("Подразделение", Подразделение);
    ГрафикРаботыНаТекущийДень.Параметры.УстановитьЗначениеПараметра("СтатусЗанятости", Перечисления.СтатусыЗанятости.Работа);
	
	ТабельРабочегоВремени.Параметры.УстановитьЗначениеПараметра("Подразделение", Подразделение);

	ДвиженияПоКассам.Параметры.УстановитьЗначениеПараметра("Подразделение", Подразделение);
	ДвиженияПоКассам.Параметры.УстановитьЗначениеПараметра("ДатаНачала", НачалоДня(ТекущаяДата()));
    ДвиженияПоКассам.Параметры.УстановитьЗначениеПараметра("ДатаОкончания", КонецДня(ТекущаяДата()));  
	
	ПодборТовара.Параметры.УстановитьЗначениеПараметра("Период",ТекущаяДата()); 
	
	
	      	
КонецПроцедуры	


&НаСервере
Процедура УстановкаПараметровДинамическихСписковНаСервере(П)
	
	ТекущийПокупатель = неопределено;       
	Подразделение = неопределено;
	П.Свойство("Клиент", ТекущийПокупатель);
	П.Вставить("Подразделение", Подразделение);

		
	ЗаписиКврачу.Параметры.УстановитьЗначениеПараметра("Клиент", ТекущийПокупатель);
	ЗаказыКлиента.Параметры.УстановитьЗначениеПараметра("Клиент", ТекущийПокупатель);
    РекомендацииОкулиста.Параметры.УстановитьЗначениеПараметра("Клиент", ТекущийПокупатель);
    РаписаниеОкулиста.Параметры.УстановитьЗначениеПараметра("МестоПриема", Подразделение);
    ЗаказыКлиентов.Параметры.УстановитьЗначениеПараметра("Подразделение", Подразделение);

	ГрафикРаботыНаТекущийДень.Параметры.УстановитьЗначениеПараметра("Подразделение", Подразделение);
    ГрафикРаботыНаТекущийДень.Параметры.УстановитьЗначениеПараметра("СтатусЗанятости", Перечисления.СтатусыЗанятости.Работа);
	
	ТабельРабочегоВремени.Параметры.УстановитьЗначениеПараметра("Подразделение", Подразделение);

	ДвиженияПоКассам.Параметры.УстановитьЗначениеПараметра("Подразделение", Подразделение);
	ДвиженияПоКассам.Параметры.УстановитьЗначениеПараметра("ДатаНачала", НачалоДня(ТекущаяДата()));
    ДвиженияПоКассам.Параметры.УстановитьЗначениеПараметра("ДатаОкончания", КонецДня(ТекущаяДата()));  
	
	ПодборТовара.Параметры.УстановитьЗначениеПараметра("Период",ТекущаяДата()); 
	
	
	      	
КонецПроцедуры	


&НаКлиенте
Процедура ОбновитьВыборПокупателя()
	
	Если ЗначениеЗаполнено(ЭтаФорма.Клиент)
		Тогда
		П = Новый Структура;
		П.Вставить("Клиент",ЭтаФорма.Клиент);
		П.Вставить("Подразделение", ЭтаФорма.Подразделение);
		УстановкаПараметровДинамическихСписковНаСервере(П);
    КонецЕсли;
	
	КонецПроцедуры	

