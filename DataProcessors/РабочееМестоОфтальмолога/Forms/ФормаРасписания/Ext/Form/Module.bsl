
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Врач = параметрыСеанса.ТекущийПользователь.ФизическоеЛицо;	
	
	ИД = параметрыСеанса.РабочееМестоКлиента;
	
	ТЗ = РегистрыСведений.ПривязкиСотрудников.СоздатьМенеджерЗаписи();
	ТЗ.ИдентификаторКомпьютера = ИД;
	ТЗ.Сотрудник = ПараметрыСеанса.ТекущийПользователь;
	ТЗ.Прочитать();
	Если ТЗ.Выбран()
		Тогда ЭтаФорма.Магазин = ТЗ.Подразделение;
	КонецЕсли;
     	
	ЭтаФорма.Дата = Текущаядата();
	УстановитьПараметрыОтбора();
	 
	
КонецПроцедуры





&НаСервере
Процедура УстановитьПараметрыОтбора()
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Магазин) Тогда
		ОтборПоМагазину = Ложь;
	Иначе
		Магазин =  ЭтаФорма.Магазин;
		ОтборПоМагазину = Истина;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Врач) Тогда
		ОтборПоВрачу = Ложь;
	Иначе
		Врач = ЭтаФорма.Врач;
		ОтборПоВрачу = Истина;
	КонецЕсли;
	
	ЭтаФорма.РасписаниеНаДень.Параметры.УстановитьЗначениеПараметра("ОтборПоМагазину", ОтборПоМагазину);
    ЭтаФорма.РасписаниеНаДень.Параметры.УстановитьЗначениеПараметра("ОтборПоВрачу", ОтборПоВрачу);
	ЭтаФорма.РасписаниеНаДень.Параметры.УстановитьЗначениеПараметра("Магазин", Магазин);
	ЭтаФорма.РасписаниеНаДень.Параметры.УстановитьЗначениеПараметра("Врач", Врач);
	ЭтаФорма.РасписаниеНаДень.Параметры.УстановитьЗначениеПараметра("ВремяНачалаПриема", НачалоДня(ЭтаФорма.Дата));
	ЭтаФорма.РасписаниеНаДень.Параметры.УстановитьЗначениеПараметра("ВремяОкончанияПриема", КонецДня(ЭтаФорма.Дата));
	
	ЭтаФорма.ИсторияРаботы.Параметры.УстановитьЗначениеПараметра("ДатаНачала", началоДня(Дата));
	ЭтаФорма.ИсторияРаботы.Параметры.УстановитьЗначениеПараметра("ДатаОкончания", КонецДня(Дата));
	ЭтаФорма.ИсторияРаботы.Параметры.УстановитьЗначениеПараметра("Исполнитель", ПараметрыСеанса.ТекущийПользователь);
	
КонецПроцедуры

