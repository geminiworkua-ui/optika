&НаКлиенте
Процедура ВыполнитьОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено
		
		Тогда
		Обновлять = Неопределено;
		П = Результат;
		П.Свойство("Обновлять", Обновлять);
		
		Если Обновлять = Истина
			Тогда
			Элементы.РасписаниеНаДень.Обновить();
			Элементы.ИсторияРаботы.Обновить();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

