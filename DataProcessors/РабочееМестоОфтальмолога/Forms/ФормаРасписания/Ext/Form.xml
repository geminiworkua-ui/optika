			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	РегистрСведенийРасписаниеПриемаВрача.Регистратор,
	РегистрСведенийРасписаниеПриемаВрача.НомерСтроки,
	РегистрСведенийРасписаниеПриемаВрача.Активность,
	РегистрСведенийРасписаниеПриемаВрача.ВремяНачалаПриема,
	РегистрСведенийРасписаниеПриемаВрача.ВремяОкончанияПриема,
	РегистрСведенийРасписаниеПриемаВрача.Врач,
	РегистрСведенийРасписаниеПриемаВрача.МестоПриема,
	РегистрСведенийРасписаниеПриемаВрача.КодСтроки,
	РегистрСведенийРасписаниеПриемаВрача.Должность,
	РегистрСведенийРасписаниеПриемаВрача.ЕстьЗапись,
	РегистрСведенийРасписаниеПриемаВрача.ЗаписьНаПрием,
	РегистрСведенийРасписаниеПриемаВрача.ЗаписьНаПрием.Клиент КАК Пациент,
	РегистрСведенийРасписаниеПриемаВрача.ВремяНачалаПриема КАК ВремяНачалаПриема1,
	РегистрСведенийРасписаниеПриемаВрача.Номенклатура
ИЗ
	РегистрСведений.РасписаниеПриемаВрача КАК РегистрСведенийРасписаниеПриемаВрача
ГДЕ
	ВЫБОР
			КОГДА РегистрСведенийРасписаниеПриемаВрача.Врач = &amp;Врач
					ИЛИ &amp;ОтборПоВрачу = ЛОЖЬ
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
	И ВЫБОР
			КОГДА РегистрСведенийРасписаниеПриемаВрача.МестоПриема = &amp;Магазин
					ИЛИ &amp;ОтборПоМагазину = ЛОЖЬ
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
	И РегистрСведенийРасписаниеПриемаВрача.ВремяНачалаПриема &gt;= &amp;ВремяНачалаПриема
	И РегистрСведенийРасписаниеПриемаВрача.ВремяОкончанияПриема &lt;= &amp;ВремяОкончанияПриема</QueryText>
