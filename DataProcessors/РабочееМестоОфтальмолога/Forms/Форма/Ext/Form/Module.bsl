&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Подразделение") 
		Тогда
		Магазин = Параметры.Подразделение;  
	КонецЕсли; 
	
	Если Параметры.Свойство("Номенклатура") 
		И значениеЗаполнено(Параметры.Номенклатура)
		Тогда  
		Номенклатура = Параметры.Номенклатура
	КонецЕсли;
	
	Если Параметры.Свойство("Пациент") 
		Тогда
		Пациент = Параметры.Пациент;  
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПациентПриИзменении(Элемент)
	   ПациентПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПациентПриИзмененииНаКлиенте();
	
	КарточкиПациента.Параметры.УстановитьЗначениеПараметра("Пациент", Пациент);
	НазначенияКурсовЛечений.Параметры.УстановитьЗначениеПараметра("Пациент", Пациент);
	ИсторияПоказателей.Параметры.УстановитьЗначениеПараметра("Пациент", Пациент); 
	
	Пол = ПолФизлицаНаСервере(Пациент);
	Возраст = ВозрастФизлицаНаСервере(Пациент);
    ВажнаяМедИнформация = МедИнфоНаСервере(Пациент);
	Если ЗначениеЗаполнено(ВажнаяМедИнформация)
		Тогда
		Элементы.ВажнаяМедИнформация.Видимость = Истина; 
	Иначе
		Элементы.ВажнаяМедИнформация.Видимость = Ложь; 
        КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВозрастФизлицаНаСервере(Пациент)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РАЗНОСТЬДАТ(Партнеры.ДатаРождения, &ТекДата, ГОД) КАК Возраст
		|ИЗ
		|	Справочник.Партнеры КАК Партнеры
		|ГДЕ
		|	Партнеры.Ссылка = &Пациент";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Пациент", Пациент);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда
		Возр =  РезультатЗапроса.Возраст;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Возр) И Возр > 98 Тогда
		 Возр = Неопределено;
	КонецЕсли;
	
	Возврат Возр; 	
КонецФункции	

&НаСервере
Функция ПолФизлицаНаСервере(Пациент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Партнеры.Пол КАК Пол
		|ИЗ
		|	Справочник.Партнеры КАК Партнеры
		|ГДЕ
		|	Партнеры.Ссылка = &Пациент";
	Запрос.УстановитьПараметр("Пациент", Пациент);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда
		Пол = РезультатЗапроса.Пол;
	КонецЕсли;
    Возврат Пол;
	
КонецФункции

&НаСервере
Функция МедИнфоНаСервере(Пациент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПОДСТРОКА(Партнеры.ВажнаяМедИнформация, 0, 100) КАК МедИнфо
		|ИЗ
		|	Справочник.Партнеры КАК Партнеры
		|ГДЕ
		|	Партнеры.Ссылка = &Пациент";
	Запрос.УстановитьПараметр("Пациент", Пациент);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		МедИнфо = ВыборкаДетальныеЗаписи.МедИнфо;
	КонецЕсли;
    Возврат МедИнфо;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПациентПриИзмененииНаКлиенте();
	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКарточкуПациента(Команда)
	
	Если ЗначениеЗаполнено(Пациент) 
		Тогда
		П = Новый Структура;
		П.Вставить("Пациент", Пациент);
		П.Вставить("Подразделение", Магазин);
		П.Вставить("Номенклатура", Номенклатура);
        	
		ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
		ОткрытьФорму("Документ.КарточкаПациента.ФормаОбъекта",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	Иначе
		Текст = "ru = 'Не выбран пациент. Создание карточки невозможно.'; uk = 'Не обрано паціента. Створення картки неможливо.'";
		Сообщить(Нстр(Текст),);
		КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.КарточкиПациента.Обновить();
	Элементы.НазначенияКурсовЛечений.Обновить();
	Элементы.ИсторияПоказателей.Обновить();
	
КонецПроцедуры




&НаКлиенте
Процедура НазначитьКурсЛечения(Команда)

	Если ЗначениеЗаполнено(Пациент) 
		Тогда
		П = Новый Структура;
		П.Вставить("Пациент", Пациент);
		П.Вставить("Подразделение", ЭтаФорма.Магазин);

		ОписаниеОповещения2  = Новый ОписаниеОповещения("ВыполнитьОповещение2",ЭтотОбъект);
		ОткрытьФорму("Документ.НазначениеКурсаЛечения.ФормаОбъекта",П,ЭтаФорма,,,,ОписаниеОповещения2,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИНаче
		Текст = "ru = 'Не выбран пациент. Назначение курса лечения невозможно.'; uk = 'Не обрано паціента. Призначення курсу лікування неможливо.'";
		Сообщить(Нстр(Текст),);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОповещение2(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.КарточкиПациента.Обновить();
	Элементы.НазначенияКурсовЛечений.Обновить();
	Элементы.ИсторияПоказателей.Обновить();

КонецПроцедуры
