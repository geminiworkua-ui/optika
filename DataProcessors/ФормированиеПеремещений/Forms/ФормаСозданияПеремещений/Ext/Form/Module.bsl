
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки КАК ЗаказНаПеремещение,
		|	ТоварыКОтгрузкеОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыКОтгрузкеОстатки.Характеристика КАК Характеристика,
		|	ТоварыКОтгрузкеОстатки.Назначение КАК Назначение,
		|	ТоварыКОтгрузкеОстатки.Склад КАК СкладОтправитель,
		|	ТоварыКОтгрузкеОстатки.Получатель КАК СкладПолучатель,
		|	СУММА(ТоварыКОтгрузкеОстатки.ВРезервеОстаток) КАК Заказано,
		|	ВложенныйЗапрос.ВНаличииОстаток КАК ВНаличииОстаток
		|ПОМЕСТИТЬ вт_базатоваров
		|ИЗ
		|	РегистрНакопления.ТоварыКОтгрузке.Остатки(, ) КАК ТоварыКОтгрузкеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
		|			СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
		|			СвободныеОстаткиОстатки.Склад КАК Склад,
		|			СУММА(СвободныеОстаткиОстатки.ВНаличииОстаток) КАК ВНаличииОстаток
		|		ИЗ
		|			РегистрНакопления.СвободныеОстатки.Остатки КАК СвободныеОстаткиОстатки
		|		
		|		СГРУППИРОВАТЬ ПО
		|			СвободныеОстаткиОстатки.Номенклатура,
		|			СвободныеОстаткиОстатки.Характеристика,
		|			СвободныеОстаткиОстатки.Склад) КАК ВложенныйЗапрос
		|		ПО (ВложенныйЗапрос.Номенклатура = ТоварыКОтгрузкеОстатки.Номенклатура)
		|			И (ВложенныйЗапрос.Характеристика = ТоварыКОтгрузкеОстатки.Характеристика)
		|			И (ВложенныйЗапрос.Склад = ТоварыКОтгрузкеОстатки.Склад)
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ТоварыКОтгрузкеОстатки.ДокументОтгрузки) = ТИП(Документ.ЗаказНаПеремещение)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыКОтгрузкеОстатки.Получатель,
		|	ТоварыКОтгрузкеОстатки.Склад,
		|	ТоварыКОтгрузкеОстатки.Характеристика,
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки,
		|	ТоварыКОтгрузкеОстатки.Номенклатура,
		|	ТоварыКОтгрузкеОстатки.Назначение,
		|	ВложенныйЗапрос.ВНаличииОстаток
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	вт_базатоваров.ЗаказНаПеремещение КАК ЗаказНаПеремещение,
		|	вт_базатоваров.Номенклатура КАК Номенклатура,
		|	вт_базатоваров.Характеристика КАК Характеристика,
		|	вт_базатоваров.СкладОтправитель КАК СкладОтправитель,
		|	вт_базатоваров.СкладПолучатель КАК СкладПолучатель,
		|	вт_базатоваров.Заказано КАК Заказано,
		|	ВложенныйЗапрос.ЗаказКлиента КАК ЗаказКлиента,
		|	ВложенныйЗапрос.НомерСтроки КАК НомСтр,
		|	ВложенныйЗапрос.Назначение КАК Назначение,
		|	вт_базатоваров.ВНаличииОстаток КАК ОстатокМагазин,
		|	ВЫБОР
		|		КОГДА ВложенныйЗапрос1.ИсточникОбеспеченияПотребностей = вт_базатоваров.СкладОтправитель
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Стандарт
		|ИЗ
		|	вт_базатоваров КАК вт_базатоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЗаказНаПеремещениеТовары.НомерСтроки КАК НомерСтроки,
		|			ЗаказНаПеремещениеТовары.Ссылка КАК ЗаказНаПеремещение,
		|			ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
		|			ЗаказНаПеремещениеТовары.Характеристика КАК Характеристика,
		|			ЗаказНаПеремещениеТовары.Назначение КАК Назначение,
		|			ЗаказНаПеремещениеТовары.Назначение.Заказ.Ссылка КАК ЗаказКлиента
		|		ИЗ
		|			Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
		|		ГДЕ
		|			ЗаказНаПеремещениеТовары.Ссылка.Проведен) КАК ВложенныйЗапрос
		|		ПО вт_базатоваров.Номенклатура = ВложенныйЗапрос.Номенклатура
		|			И вт_базатоваров.Характеристика = ВложенныйЗапрос.Характеристика
		|			И вт_базатоваров.ЗаказНаПеремещение = ВложенныйЗапрос.ЗаказНаПеремещение
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СхемыОбеспечения.СхемаОбеспечения КАК СхемаОбеспечения,
		|			СхемыОбеспечения.Склад КАК Склад,
		|			СхемыОбеспечения.СпособОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей КАК ИсточникОбеспеченияПотребностей
		|		ИЗ
		|			РегистрСведений.СхемыОбеспечения КАК СхемыОбеспечения) КАК ВложенныйЗапрос1
		|		ПО вт_базатоваров.Номенклатура.СхемаОбеспечения = ВложенныйЗапрос1.СхемаОбеспечения
		|			И вт_базатоваров.СкладПолучатель = ВложенныйЗапрос1.Склад
		|ГДЕ
		|	ВЫБОР
		|			КОГДА НЕ &СкладОтправитель = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|						И вт_базатоваров.СкладОтправитель = &СкладОтправитель
		|					ИЛИ &СкладОтправитель = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА НЕ &СкладПолучатель = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|						И вт_базатоваров.СкладПолучатель = &СкладПолучатель
		|					ИЛИ &СкладПолучатель = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	вт_базатоваров.ЗаказНаПеремещение.Дата УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ вт_базатоваров";
	
	Запрос.УстановитьПараметр("СкладОтправитель", СкладОтправитель);
	Запрос.УстановитьПараметр("СкладПолучатель", СкладПолучатель); 
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());

    ТЗ = новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();

	ЭтаФорма.Таблица.Очистить();
	ЭтаФорма.Таблица.Загрузить(ТЗ);
	
КонецПроцедуры	

&НаКлиенте
Процедура СкладОтправительПриИзменении(Элемент)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СкладПолучательПриИзменении(Элемент)
	ЗаполнитьТаблицуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОкПриИзменении(Элемент)
	
	ТекСтр = Элементы.Таблица.ТекущиеДанные;
	Если 
		ТекСтр.Ок = Истина
		Тогда ТекСтр.Отк = Ложь;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОтказПриИзменении(Элемент)
	
	ТекСтр = Элементы.Таблица.ТекущиеДанные;
	Если 
		ТекСтр.Отк = Истина
		Тогда ТекСтр.Ок = Ложь;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ВсеОк(Команда)
	Для каждого Стр из Таблица цикл
		Стр.Ок = Истина;
		Стр.Отк = Ложь;
	КонецЦикла
		
КонецПроцедуры

&НаКлиенте
Процедура ВсеОтк(Команда)
	Для каждого Стр из Таблица цикл
		Стр.Отк = Истина;
		Стр.Ок = Ложь;
	КонецЦикла
		
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорм(Команда)
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	ПрименитьНаСервере(); 
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПрименитьНаСервере()
	
	УстановитьПривилегированныйрежим(Истина);
	                                         
	Автор = ПараметрыСеанса.ТекущийПользователь;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = ЭтаФорма.Таблица.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.СкладОтправитель,
	|	ТЗ.СкладПолучатель,
	|	ТЗ.ЗаказНаПеремещение,
	|	ТЗ.ЗаказКлиента,
	|	ТЗ.Номенклатура,
	|	ТЗ.Характеристика,
	|	ТЗ.Заказано КАК Количество,
	|	ТЗ.НомСтр,
	|	ТЗ.Назначение,
	|	ТЗ.Ок,
	|	ТЗ.Отк
	|ПОМЕСТИТЬ вт_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ТЗ.СкладОтправитель,
	|	вт_ТЗ.СкладПолучатель
	|ИЗ
	|	вт_ТЗ КАК вт_ТЗ
	|ГДЕ
	|	вт_ТЗ.Ок
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ТЗ.СкладОтправитель,
	|	вт_ТЗ.СкладПолучатель";
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// создаем новый документ перемещения
		НовДок = Документы.ПеремещениеТоваров.СоздатьДокумент(); 
		НовДок.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
		НовДок.Дата = ТекущаяДата();
		НовДок.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		НовДок.ОрганизацияПолучатель = НовДок.Организация;
		НовДок.Статус = Перечисления.СтатусыПеремещенийТоваров.Отгружено;
		НовДок.СкладОтправитель = Выборка.СкладОтправитель;
		НовДок.СкладПолучатель = Выборка.СкладПолучатель;
		НовДок.ВидЦены = НовДок.СкладОтправитель.УчетныйВидЦены;
				
		НовДок.Ответственный = Автор;
		Текст = "Сформовоно обробкою користувачем " + строка(НовДок.Ответственный);
		НовДок.Комментарий = Текст;
		НовДок.ПеремещениеПоЗаказам = Истина;
		НовДок.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		НовДок.Подразделение = Выборка.СкладОтправитель.Подразделение;
		
		Запрос2 = Новый Запрос;
		Запрос2.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.СкладОтправитель,
		|	ТЗ.СкладПолучатель,
		|	ТЗ.ЗаказНаПеремещение,
		|	ТЗ.ЗаказКлиента,
		|	ТЗ.Номенклатура,
		|	ТЗ.Характеристика,
		|	ТЗ.Заказано КАК Количество,
		|	ТЗ.НомСтр,
		|	ТЗ.Назначение,
		|	ТЗ.Ок,
		|	ТЗ.Отк
		|ПОМЕСТИТЬ вт_ТЗ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|ГДЕ
		|	ТЗ.СкладОтправитель = &СкладОтправитель
		|	И ТЗ.СкладПолучатель = &СкладПолучатель
		|	И ТЗ.Ок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТЗ.СкладОтправитель,
		|	вт_ТЗ.СкладПолучатель,
		|	вт_ТЗ.ЗаказНаПеремещение,
		|	вт_ТЗ.ЗаказКлиента,
		|	вт_ТЗ.Номенклатура,
		|	вт_ТЗ.Характеристика,
		|	вт_ТЗ.Количество,
		|	вт_ТЗ.НомСтр КАК КодСтроки,
		|	вт_ТЗ.Назначение
		|ИЗ
		|	вт_ТЗ КАК вт_ТЗ
		|ГДЕ
		|	вт_ТЗ.Ок";
		Запрос2.УстановитьПараметр("ТЗ", ТЗ);
		Запрос2.УстановитьПараметр("СкладОтправитель", Выборка.СкладОтправитель);
		Запрос2.УстановитьПараметр("СкладПолучатель", Выборка.СкладПолучатель);
		Выборка2 = Запрос2.Выполнить().Выбрать();
		
		Пока Выборка2.Следующий() цикл
			
			ВыбДокумент = Выборка2.ЗаказНаПеремещение;
			ДокЗаказа = ВыбДокумент.ПолучитьОбъект();
			ДокЗаказа.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
			ДокЗаказа.Товары[Выборка2.КодСтроки-1].ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
			Текст = Строка(Выборка2.Номенклатура) + " " + Строка(Выборка2.Характеристика) + " підтверджено до переміщення " + формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " користувачем " + Строка(Автор); 
			ДокЗаказа.Комментарий = ДокЗаказа.Комментарий + Символы.ПС + Текст;
			ДокЗаказа.Записать(РежимЗаписиДокумента.Проведение);
			
			НовСтр = НовДок.Товары.Добавить();
			//заполнитьЗначенияСвойств(НовСтр,Выборка2);
			НовСтр.Номенклатура = Выборка2.Номенклатура;
			НовСтр.Назначение = Выборка2.Назначение;
			//НовСтр.НазначениеОтправителя = Выборка2.Назначение;
            НовСтр.Характеристика = Выборка2.Характеристика;
           	НовСтр.ЗаказНаПеремещение = Выборка2.ЗаказНаПеремещение;
            НовСтр.Количество = Выборка2.Количество;
			НовСтр.КоличествоУпаковок = Выборка2.Количество;
            НовСтр.КодСтроки = Выборка2.КодСтроки;
            НовСтр.Упаковка = Выборка2.Номенклатура.ЕдиницаИзмерения; 
			НовСтр.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
					
			
			ПараметрыАналитики = Новый Структура;
			ПараметрыАналитики.Вставить("Номенклатура",Выборка2.Номенклатура);
			ПараметрыАналитики.Вставить("Характеристика",Выборка2.Характеристика);
			ПараметрыАналитики.Вставить("Серия",Справочники.СерииНоменклатуры.ПустаяСсылка());
			ПараметрыАналитики.Вставить("Склад",Выборка.СкладОтправитель);
			
			НовСтр.АналитикаУчетаНоменклатуры = РегистрыСведений.АналитикаУчетаНоменклатуры.ЗначениеКлючаАналитики(ПараметрыАналитики);			
			
			НовСтрВЗ = НовДок.ВидыЗапасов.Добавить();
			НовСтрВЗ.АналитикаУчетаНоменклатуры = НовСтр.АналитикаУчетаНоменклатуры;
			НовСтрВЗ.Количество =  НовСтр.Количество; 
			Реквизиты = Новый Структура("
			|Организация,
			|ТипЗапасов,
			|Комитент,
			|Контрагент,
			|Соглашение,
			|Договор,
			|Валюта,
			|НалоговоеНазначение,
			|НалоговоеНазначениеОрганизации,
			|Поставщик,
			|Предназначение,
			|Менеджер,
			|Подразделение,
			|Сделка,
			|Назначение,
			|ОбособленныйУчетТоваровПоСделке,
			|ВариантОбособленногоУчетаТоваров,
			|ВидЗапасов,
			|ГруппаФинансовогоУчета,
			|ГруппаПродукции,
			|ХозяйственнаяОперация
			|");
			ЗаполнитьЗначенияСвойств(Реквизиты, НовДок);
			Реквизиты.ОбособленныйУчетТоваровПоСделке = Истина;
			
			НовСтрВЗ.ВидЗапасов = Справочники.ВидыЗапасов.ВидЗапасовДокумента(НовДок.Организация,НовДок.ХозяйственнаяОперация,Реквизиты, Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_НеоблагаемаяХозДеятельность );
			НовСтрВЗ.Назначение = НовСтр.Назначение;
			
			Реквизиты = Новый Структура("
			|Организация,
			|ТипЗапасов,
			|Комитент,
			|Контрагент,
			|Соглашение,
			|Договор,
			|Валюта,
			|НалоговоеНазначение,
			|НалоговоеНазначениеОрганизации,
			|Поставщик,
			|Предназначение,
			|Менеджер,
			|Подразделение,
			|Сделка,
			|Назначение,
			|ОбособленныйУчетТоваровПоСделке,
			|ВариантОбособленногоУчетаТоваров,
			|ВидЗапасов,
			|ГруппаФинансовогоУчета,
			|ГруппаПродукции,
			|ХозяйственнаяОперация
			|");
			ЗаполнитьЗначенияСвойств(Реквизиты, НовДок);
			Реквизиты.ОбособленныйУчетТоваровПоСделке = Истина;
			Реквизиты.Назначение = Выборка2.Назначение;
			
			НовСтрВЗ.ВидЗапасов = Справочники.ВидыЗапасов.ВидЗапасовДокумента(НовДок.Организация,НовДок.ХозяйственнаяОперация,Реквизиты, Справочники.НалоговыеНазначенияАктивовИЗатрат.НДС_НеоблагаемаяХозДеятельность );
			
			НовСтрВЗ.ВидЗапасовПолучателя = НовСтрВЗ.ВидЗапасов;
			
			
		КонецЦикла;
		если НовДок.Товары.Количество() =1 Тогда			
	           НовДок.ЗаказНаПеремещение = Выборка2.ЗаказНаПеремещение;
		КонецЕсли;	   
		Попытка
			
		НовДок.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		НовДок.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
	
	КонецЦикла;
	
	// выполним отмену перемещения 
	
	Для каждого Стр из Таблица цикл
		
		Если Стр.Отк = Истина
			Тогда
			ДокЗаказа = Стр.ЗаказНаПеремещение.ПолучитьОбъект();
			ДокЗаказа.Товары[Стр.НомСтр-1].Отменено = Истина;
			Текст = Строка(Стр.Номенклатура) + " " + Строка(Стр.Характеристика) + " відмовлено до переміщення " + формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " користувачем " + Строка(Автор); 
			ДокЗаказа.Комментарий = ДокЗаказа.Комментарий + Символы.ПС + Текст;
			ДокЗаказа.Записать(РежимЗаписиДокумента.Проведение);
			
			// проинформируем пользователей про отмену заказа
			
			НовЗапись = РегистрыСведений.СообщенияПользователям.СоздатьМенеджерЗаписи(); 
			
			НовЗапись.Идентификатор = Новый УникальныйИдентификатор;
			НовЗапись.ДокументСобытия = ДокЗаказа;
			НовЗапись.Прочитано = Ложь;
			НовЗапись.Подразделение = ДокЗаказа.Подразделение;
			Текст = "Не погоджено замовлення на переміщення " + Строка(ДокЗаказа) + " " + Строка(ДокЗаказа.Товары[Стр.НомСтр-1].Номенклатура) + " " + Строка(ДокЗаказа.Товары[Стр.НомСтр-1].Характеристика) + " з магазіну " + Строка(ДокЗаказа.СкладОтправитель); 
			НовЗапись.Сообщение = СокрЛП(Текст);
			НовЗапись.Инициатор = Автор;
			НовЗапись.Важное = Истина;
			НовЗапись.ДатаСоздания = ТекущаяДата();
			НовЗапись.Записать();
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

