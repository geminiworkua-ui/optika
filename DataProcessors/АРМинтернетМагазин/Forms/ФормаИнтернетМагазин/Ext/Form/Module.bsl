Процедура ОбновитьСписокЗавершение(Результат, ДополнительныеПараметры) Экспорт
ЗаполнитьЗадачиФискализацииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтр = Элементы.СписокЗаказы.ТекущиеДанные;
	Если 
		(Поле.Имя = "СписокЗаказыКоманда"
		и 
		ТекСтр.Команда = "Обробити")
		или 
 	    (Поле.Имя = "СписокЗаказыСформированоОбеспечение"  
		И
		ТекСтр.СформированаРеализация = Ложь)
		
		Тогда
		Ссылка = ТекСтр.Ссылка;
		ОткрытьПодборИМ(Ссылка);
		Элементы.СписокЗаказы.Обновить();
		
	ИначеЕсли
		(Поле.Имя = "СписокЗаказыСформированаРеализация"  
		И
		ТекСтр.СформированоОбеспечение = Истина
		И 
		ТекСтр.СформированаРеализация = Ложь )
		ИЛИ 
		(Поле.Имя = "СписокЗаказыКоманда"
		и 
		ТекСтр.Команда = "Сформувати реалізацію")
        			
		Тогда
		Ссылка = ТекСтр.Ссылка;
		СформироватьРеализацииНаСервере(Ссылка); 
		Элементы.СписокЗаказы.Обновить();
		
	ИначеЕсли
		Поле.Имя = "СписокЗаказыСсылка"
		Тогда
		П = новый Структура ("Ключ", ТекСтр.Ссылка);
		ОткрытьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", П);
		
	ИначеЕсли	
		Поле.Имя = "СписокЗаказыСтатусИМ"
		Тогда
		П = новый Структура ("ЗаказКлиента", ТекСтр.Ссылка);
		ОткрытьФорму("Обработка.АРМинтернетМагазин.Форма.ФормаИсторииСтатусов", П, ЭтаФорма,,,,,);
		
	ИначеЕсли
		Поле.Имя = "СписокЗаказыПартнер"
		Тогда
		ПоказатьЗначение(, ТекСтр.Партнер);
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыЗаказа(ДокОбъект)

	М = новый Массив;
	Для каждого Стр из ДокОбъект.Товары цикл
		п = Новый Структура("Номенклатура, Характеристика, Количество");
		ЗаполнитьЗначенияСвойств(П, Стр);
		М.Добавить(П);
	КонецЦикла;
	
	Стат = РегистрыСведений.РегистрацияСтатусовЗаказовИМ.СрезПоследних(ТекущаяДата(),Новый структура("ЗаказКлиента",ДокОбъект));
		
	Если Стат.Количество() > 0
		И
		Стат[0].Статус = Перечисления.СтатусыОбработкиЗаказовИМ.Обрабатывается
		И НЕ Стат[0].Пользователь = ПараметрыСеанса.ТекущийПользователь
		Тогда 
		Сообщить("Вказане замовлення обробляється користувачем " + строка(Стат[0].Пользователь));
		Возврат Неопределено
	Иначе
		
		Если Стат.Количество() = 0
			Тогда 
			РС = РегистрыСведений.РегистрацияСтатусовЗаказовИМ.СоздатьМенеджерЗаписи();
			РС.Пользователь = ПараметрыСеанса.ТекущийПользователь;
			РС.ЗаказКлиента = ДокОбъект.ссылка;
			РС.ДокОснование = ДокОбъект.ссылка;
			РС.Период = ТекущаяДата();
			РС.Статус = Перечисления.СтатусыОбработкиЗаказовИМ.Обрабатывается;
			РС.Записать();
		КонецЕсли;
		
		ПП = Новый Структура("М, ДокОбъект");
		ПП.М = М;
		ПП.ДокОбъект = ДокОбъект;
		Возврат ПП;
		
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Процедура ОткрытьПодборИМ(ДокОбъект)

	ПП = ПолучитьПараметрыЗаказа(ДокОбъект);
	
	Если НЕ ПП = Неопределено 
		Тогда
		ОповещениеОВыбореОбеспечения = Новый ОписаниеОповещения("ОповещениеОВыбореОбеспечения", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ФормаВыбораИсточникаОбеспеченияИМ",ПП,ЭтаФорма,,,,ОповещениеОВыбореОбеспечения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОповещениеОВыбореОбеспечения(Результат, ДополнительныеПараметры) Экспорт      // Боков
	
	Если  НЕ Результат = НЕопределено
		Тогда	
	
	ДО = Неопределено;
	М =  Неопределено;
	ПараметрыДоставки = Неопределено;
		
	Результат.Свойство("М", М);
	Результат.Свойство("ДокОбъект", ДО);

		МРез = ОформитьРезервированиеНаСервере(М, ДО);
		
        ДокОбъект = ДО.ПолучитьОбъект();
		
		ДокОбъект.Товары.Очистить();
		Для каждого Стр из Мрез цикл
			НовСтр = ДокОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр);
			НовСтр.СтавкаНДС = СтавкаБезНДСНаСервере();
			НовСтр.ДатаОтгрузки = ТекущаяДата();
		КонецЦикла;
	        	
		ДокОбъект.Статус = СтатусЗаказаКобесп(); 
		ДокОбъект.СформированоОбеспечение = Истина;
		ДокОбъект.ПараметрыДоставки = ПараметрыДоставки;
		ДокОбъект.Записать();
		
		РС = РегистрыСведений.РегистрацияСтатусовЗаказовИМ.СоздатьМенеджерЗаписи();
		РС.ЗаказКлиента = ДО.ссылка;
		РС.Статус = Перечисления.СтатусыОбработкиЗаказовИМ.СформированоОбеспечение;
		РС.Период = ТекущаяДата();
		РС.Пользователь = ПараметрыСеанса.ТекущийПользователь;
		РС.ДокОснование = ДО.ссылка;
		РС.Записать();
        	
	КонецЕсли;
	
	Элементы.СписокЗаказы.Обновить();
	
КонецПроцедуры

&НаСервере
Функция СтавкаБезНДСНаСервере()
    Возврат Перечисления.СтавкиНДС.БезНДС;
КонецФункции

&НаСервере
Функция ОформитьРезервированиеНаСервере(М, ДО)
	
	ДокОбъект = ДО.ПолучитьОбъект();
	
// получим тиаблицу из ВХ и свернем дубли строки
    ТЗ = ДокОбъект.Товары.выгрузить();
	ТЗ.Очистить();
	Для каждого Запись из ДокОбъект.Товары цикл
	    НовСтр = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Запись);
	КонецЦикла;
    
	ТЗ.Свернуть("Номенклатура, Характеристика, ВариантОбеспечения", "Количество, Сумма, СуммаНДС, СуммаСНДС, Цена");
	
	Для каждого Стр из ТЗ цикл
		Если стр.Количество > 0 Тогда
		Стр.Цена = Стр.Сумма / стр.Количество;
		КонецЕсли;
	КонецЦикла;
	
//	Разберем данные массива, посмистим их в таблицу
	
    ТЗМ = Новый ТаблицаЗначений;
	ТЗМ.Колонки.Добавить("Номенклатура", новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗМ.Колонки.Добавить("Характеристика", новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗМ.Колонки.Добавить("Количество", новый ОписаниеТипов("Число")); 
	ТЗМ.Колонки.Добавить("Склад", новый ОписаниеТипов("СправочникСсылка.Склады")); 
    Для каждого Запись из М цикл
	    НовСтр = ТЗМ.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Запись);
	КонецЦикла;

//  Обойдем все сттроки формы, 

 	ТЗИ = Новый ТаблицаЗначений;
 	ТЗИ = ДокОбъект.Товары.выгрузить();
	ТЗИ.Очистить();
	
	Для каждого Стр из ТЗ цикл
		
		СтрНужно = Стр.Количество;	
		
		Для каждого СтрМ из ТЗМ цикл
			Если 
				Стр.Номенклатура = СтрМ.Номенклатура
				И
				Стр.Характеристика = СтрМ.Характеристика
				Тогда
				НовСтр = ТЗИ.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, Стр);
				Кол = мин(СтрМ.Количество,СтрНужно);
				НовСтр.Количество = Кол;
				НовСтр.КоличествоУпаковок = Кол;
				НовСтр.Склад = СтрМ.Склад;
				СтрНужно = СтрНужно - Кол; 
				Стр.Сумма = Кол * Стр.Цена;
				Стр.СуммаСНДС = Стр.Сумма;
				Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;		
			КонецЕсли;	
		КонецЦикла;
		
		Если СтрНужно > 0
			   Тогда
			   НовСтр = ТЗИ.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, Стр);
				Кол = СтрНужно;
				НовСтр.Количество = Кол;
				НовСтр.КоличествоУпаковок = Кол;
				НовСтр.Склад = Справочники.Склады.НайтиПоНаименованию(" Склад");
				СтрНужно = СтрНужно - Кол; 
				Стр.Сумма = Кол * Стр.Цена;
				Стр.СуммаСНДС = Стр.Сумма;
				
				Если НовСтр.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга
					Тогда 
				    Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется;	
				Иначе			
					Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно;
				КонецЕсли;
										
         КонецЕсли;
		
		
	КонецЦикла;
	
	Мрез = Новый Массив;
	Для каждого Стр из ТЗИ цикл
		П = новый Структура;
		Для каждого Кол из ТЗИ.Колонки цикл
			Имя = строка(Кол.Имя);
			П.Вставить(Имя, Стр[Имя]);
		КонецЦикла;
		Мрез.Добавить(П);
	КонецЦикла;
		
	Возврат Мрез;	
		
КонецФункции

&НаСервере
Процедура СформироватьРеализацииНаСервере(ДокОбъект)
	
	ДО = ДокОбъект.ПолучитьОбъект();
	
	Для каждого Стр из ДО.Товары цикл
		Стр.ВариантОбеспечения = СтатусЗаказаКОтгрузке();  
		Стр.Склад = ДО.Склад;
	КонецЦикла;
	
	ДО.Записать(РежимЗаписиДокумента.Проведение);
	
	// сначала соберем Весь пакет складов
	Исх = ДО.Товары;
	
	ТЗ = ДО.Товары.выгрузить();
	ТЗ.Очистить();
	ТЗсклады = Новый ТаблицаЗначений;
	ТЗсклады.Колонки.Добавить("Склад",новый ОписаниеТипов("СправочникСсылка.Склады"));  
	
	Для каждого Запись из Исх цикл
		НовСтр = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Запись); 
		
		НовСклад = ТЗсклады.Добавить();
		НовСклад.Склад = Запись.Склад;
		
	КонецЦикла;
	
	ТЗсклады.Свернуть("Склад");
	
	ЕстьОшибкиВыполнения = Ложь;
	
	Для каждого Стр из ТЗСклады цикл
		
		Если  ЗначениеЗаполнено(Стр.Склад.СкладОтгрузкиИМ)
			ТОгда
			// значит надо сделать предварительное перемещение
			СкладОтгрузки = Стр.Склад.СкладОтгрузкиИМ;
			
			Перемещение = Документы.ПеремещениеТоваров.СоздатьДокумент();
			Перемещение.СкладОтправитель = Стр.Склад;
			Перемещение.СкладПолучатель = Стр.Склад.СкладОтгрузкиИМ;
			Перемещение.Комментарий = "На виконання";
		Для каждого СтрТЧ из ТЗ цикл
	
			Если СтрТЧ.Склад = Стр.Склад Тогда
				НовСтр = Перемещение.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, СтрТЧ);
			КонецЕсли;
		КонецЦикла;
            Перемещение.Записать(РежимЗаписиДокумента.Проведение);

			
			Режим = РежимЗаписиДокумента.Запись;
		
		Иначе
			НужнаЗаписьРегистр = Ложь;
			СкладОтгрузки = Стр.Склад;
			Режим = РежимЗаписиДокумента.Проведение;
		КонецЕсли;
				
		Реализация = документы.РеализацияТоваровУслуг.СоздатьДокумент();
		
		Реализация.Менеджер = ПараметрыСеанса.АвторизованныйПользователь; 
		Реализация.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();     
		Реализация.Валюта = ДО.Валюта;
		Реализация.ВалютаВзаиморасчетов = ДО.Валюта;
		Реализация.РеализацияПоЗаказам = Истина;
		Реализация.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
		Реализация.ЗаказКлиента = ДО.Ссылка;
		Реализация.Склад = Стр.Склад;  
		Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		Реализация.Партнер = ДО.Партнер;                   
		Реализация.КартаЛояльности = ДО.КартаЛояльности;
		Реализация.Контрагент = ?(ДО.КартаЛояльности.Контрагент = Справочники.Контрагенты.ПустаяСсылка(), бит_сервер.НайтиКонтрагента(ДО.Партнер),ДО.КартаЛояльности.Контрагент);
		Реализация.Подразделение = ДО.Склад.Подразделение;
		Реализация.Касса = ДО.Касса;      
		Реализация.Валюта = ДО.Валюта;
		Реализация.ПараметрыДоставки = До.ПараметрыДоставки;
		//	Реализация.БанковскийСчет = ЗаказКлиента.БанковскийСчет;
		Реализация.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным;
		Реализация.Дата = ТекущаяДата();
		//	Реализация.ДатаОтгрузки = бит_сервер.ДатаОтгрузки(ЗаказКлиента);
		Реализация.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		
		Реализация.Товары.Очистить();
		
		Для каждого СтрТЧ из ТЗ цикл
			Если СтрТЧ.Склад = Стр.Склад Тогда
				НовСтр = Реализация.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, СтрТЧ);
				НовСтр.КодСтроки = СтрТЧ.КодСтроки;
			КонецЕсли;
			
		КонецЦикла;
		
		Реализация.СуммаДокумента = Реализация.Товары.Итог("Сумма");
		Реализация.СуммаВзаиморасчетов = Реализация.СуммаДокумента;
				
		Попытка
			Реализация.Записать(РежимЗаписиДокумента.Проведение);
			Инфра_ОбщиеМодули.СоздатьКопиюРеквизитовДоставки(Реализация.Ссылка, Реализация.ЗаказКлиента);			
			
		Исключение
			//	Реализация.Записать(РежимЗаписиДокумента.Запись);
			Сообщить("Не удалось провести реализацию. Необходимо проврить корректность заполнения цепочки документов");
			ЕстьОшибкиВыполнения = Истина;
		КонецПопытки;
		
		Если НужнаЗаписьРегистр Тогда
			Запись = РегистрыСведений.ОтложенныеРеализации.СоздатьМенеджерЗаписи();
			Запись.ДокументПеремещения = Перемещение.Ссылка;
			Запись.ДокументРеализации = Реализация.Ссылка;
			Запись.Записать(Истина);
		КонецЕсли;

	КонецЦикла;
	
	Если 
		ЕстьОшибкиВыполнения = Истина
		Тогда
		ДО.ЕстьПроблемаФормированияОтгрузки= Истина;
	Иначе
		ДО.СформированаРеализация = Истина;
		
		РС = РегистрыСведений.РегистрацияСтатусовЗаказовИМ.СоздатьМенеджерЗаписи();
		РС.ЗаказКлиента = ДО.ссылка;
		РС.Статус = Перечисления.СтатусыОбработкиЗаказовИМ.СформированаРеализация;
		РС.Период = ТекущаяДата();
		РС.Пользователь = ПараметрыСеанса.ТекущийПользователь;
		РС.ДокОснование = Реализация.Ссылка;
		РС.Записать();
        
		
	КонецЕсли;
	ДО.Записать(РежимЗаписиДокумента.Запись);
	
	
КонецПроцедуры	

