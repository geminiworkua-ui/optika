	ЗаполнитьОжидаемымПоступлениемНаСервере(ЭтаФорма.ОтборСклад);
	ОбновитьИтогиТаблиц();

КонецПроцедуры


&НаСервере
Процедура ОформитьПоступленниеДенегНаСервере(М)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для каждого Стр из М цикл
		
	П = Новый Структура("Показатель", Справочники.Показатели.КассаИнтернетМагазина);
	КассаИнтернетМагазина = РегистрыСведений.ЗначенияПоказателей.СрезПоследних(ТекущаяДата(),П)[0].ЛюбаяС;
	
	П = Новый Структура("Показатель", Справочники.Показатели.СтатьяЗатратКомиссияНП);
	СтатьяЗатратКомиссияНП = РегистрыСведений.ЗначенияПоказателей.СрезПоследних(ТекущаяДата(),П)[0].ЛюбаяС;

	П = Новый Структура("Показатель", Справочники.Показатели.СтатьяДДСкомиссияНП);
	СтатьяДДСкомиссияНП = РегистрыСведений.ЗначенияПоказателей.СрезПоследних(ТекущаяДата(),П)[0].ЛюбаяС;
	
	П = Новый Структура("Показатель", Справочники.Показатели.КонтрагентНП);
	КонтрагентНП = РегистрыСведений.ЗначенияПоказателей.СрезПоследних(ТекущаяДата(),П)[0].ЛюбаяС;

	
	//П = Новый Структура("Партнер, ЮридическоеФизическоеЛицо"); 
	//П.Партнер = Стр.Покупатель;
	//П.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	
	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("Партнер", Стр.Покупатель);
	
	
	ПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
	ПКО.Дата = ТекущаяДата(); 
	ПКО.Касса =  КассаИнтернетМагазина;
	ПКО.Подразделение = Стр.ЗаказКлиента.Подразделение;
	ПКО.Кассир = ПараметрыСеанса.ТекущийПользователь;
	ПКО.Комментарий = "Створено обробкою користувачем " + строка(ПКО.Кассир);
    ПКО.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	ПКО.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	ПКО.Валюта = Справочники.Валюты.НайтиПоКоду("980");
	ПКО.ДокументОснование =  Стр.Реализация;
    ПКО.Контрагент = Контрагент;
	ПКО.КурсКонвертации = 1; 
	ПКО.ПринятоОт = Строка(Контрагент);
	ПКО.Основание = Строка("Надходження оплати згідно документа " + строка(Стр.Реализация) + " за замовденням " + строка(Стр.ЗаказКлиента));
	ПКО.СтатьяДвиженияДенежныхСредств = справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;
	ПКО.СуммаДокумента = Стр.СуммаВсего;   
	ПКО.ДокументРТУ = Стр.Реализация;
	
	НовСтр = ПКО.РасшифровкаПлатежа.Добавить();
	НовСтр.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("980");
	НовСтр.Заказ = Стр.ЗаказКлиента;
	НовСтр.Организация =  ПКО.Организация;
	НовСтр.ОснованиеПлатежа = Стр.ЗаказКлиента;
	НОвСтр.СтатьяДвиженияДенежныхСредств = справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;
    НовСтр.Сумма = Стр.СуммаВсего;
			
	ПКО.Записать(РежимЗаписиДокумента.Проведение);
	
	Сообщить("Створено " + строка(ПКО.Ссылка));
	
	// сформируем записи 	
	РС = РегистрыСведений.РегистрацияСтатусовЗаказовИМ.СоздатьМенеджерЗаписи();
	РС.ЗаказКлиента = Стр.ЗаказКлиента;
	РС.Статус = Перечисления.СтатусыОбработкиЗаказовИМ.Оплачен;
	РС.Сумма = Стр.СуммаВсего;
	РС.Период = ТекущаяДата();
	РС.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	РС.ДокОснование = ПКО.Ссылка;
	РС.Записать();
		
	
	//соззадаим расходный ордер на комиссию новой почты
	
	РКО = Документы.РасходныйКассовыйОрдер.СоздатьДокумент();
	РКО.Дата = ТекущаяДата();
	РКО.Касса = КассаИнтернетМагазина;
    РКО.Подразделение = Стр.ЗаказКлиента.Подразделение;
	РКО.Кассир = ПараметрыСеанса.ТекущийПользователь;
	РКО.Валюта = Справочники.Валюты.НайтиПоКоду("980");
	РКО.ДокументРТУ = Стр.Реализация;
	РКО.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	РКО.СуммаДокумента = Стр.КомиссияНП;
	РКО.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств;
	РКО.Контрагент = КонтрагентНП;
	
	РКО.Основание = Строка("Реєстрація утримання комісії Нової пошти за відправку грошей за документом " + строка(Стр.Реализация) + " за замовденням " + строка(Стр.ЗаказКлиента));
	
	Нстр = РКО.РасшифровкаПлатежа.Добавить();
	Нстр.СтатьяДвиженияДенежныхСредств = СтатьяДДСкомиссияНП;
	Нстр.СтатьяРасходов = СтатьяЗатратКомиссияНП;
	НСтр.Комментарий = "Комісія НП за док " + строка(Стр.Реализация);
	Нстр.Сумма = Стр.СуммаВсего;
	Нстр.АналитикаРасходов = Стр.ЗаказКлиента.Подразделение;
	НСтр.Подразделение = Стр.ЗаказКлиента.Подразделение;
	НСтр.ПериодВозникновенияРасхода = Текущаядата();	
	
	РКО.Записать(РежимЗаписиДокумента.Проведение);
    Сообщить("Створено " + строка(РКО.Ссылка));
    
	КонецЦикла;
	
	// Вставити вміст обробника.
КонецПроцедуры


&НаКлиенте
Процедура ОформитьПоступленниеДенег(Команда)
	
	М = Новый Массив;
	
	Для каждого Стр из ЭтаФорма.ТаблицаДеньгиКПолучению цикл
		Если Стр.Отметка = Истина
			Тогда
			П = Новый Структура;
			П.Вставить("ЗаказКлиента", Стр.ЗаказКлиента);
			П.Вставить("Реализация", Стр.Реализация);
			П.Вставить("Покупатель", Стр.Покупатель);
			П.Вставить("СуммаВсего", Стр.СуммаВсего);
			П.Вставить("СуммаКполучению", Стр.СуммаКполучению);
			П.Вставить("КомиссияНП", Стр.КомиссияНП);
			М.Добавить(П);			
		КонецЕсли;
	КонецЦикла;  
	
	Если М.Количество() > 0 Тогда 
		ОформитьПоступленниеДенегНаСервере(М);
	КонецЕсли;
	
	ЗаполнитьОжидаемымПоступлениемНаСервере(ЭтаФорма.ОтборСклад);
	ОбновитьИтогиТаблиц();

КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.СтПериод.ДатаОкончания = ТекущаяДата();
	ЭтаФорма.СтПериод.ДатаНачала =  НачалоДня(ТекущаяДата()) - 10*24*60*60;
	
	ЭтаФорма.СписокЗаказы.Параметры.УстановитьЗначениеПараметра("ТекДата",конецдня(ТекущаяДата()) + 1*24*60*60 ); 
	
КонецПроцедуры


&НаКлиенте
Процедура ПоказатьОтправленныеПриИзменении(Элемент)
	УстановитьПараметрыОтборовИОформление();
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьПараметрыОтборовИОформление();
	Мдатаначало = текущаядата();
    ЭтаФорма.ПодключитьОбработчикОжидания( "ОбновлениеСписка", 30);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеСписка()
	
	Элементы.СписокЗаказы.Обновить();
	Элементы.ЗаказыКотправке.Обновить();
	
	
КонецПроцедуры





&НаСервере
Процедура ЗаполнитьЗадачиФискализацииНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриходныйКассовыйОрдер.Организация,
		|	ПриходныйКассовыйОрдер.Касса,
		|	ПриходныйКассовыйОрдер.Контрагент.Партнер КАК Покупатель,
		|	ПриходныйКассовыйОрдер.ДокументРТУ КАК Реализация,
		|	ПриходныйКассовыйОрдер.ДокументРТУ.ЗаказКлиента КАК ЗаказКлиента,
		|	ПриходныйКассовыйОрдер.Ссылка КАК ДокументОснование,
		|	""Ч/з НовуПошту"" КАК ВидПоступления,
		|	ПриходныйКассовыйОрдер.СуммаДокумента КАК Сумма,
		|	ПриходныйКассовыйОрдер.Основание КАК Комментарий
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
		|ГДЕ
		|	ПриходныйКассовыйОрдер.ДокументРТУ.ЗаказКлиента.ЭтоИнтернетМагазин
		|	И ПриходныйКассовыйОрдер.Проведен
		|	И ПриходныйКассовыйОрдер.ЧекККМ.Валюта ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка.Организация,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка.ЭквайринговыйТерминал.БанковскийСчет,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка.Контрагент.Партнер,
		|	NULL,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Заказ,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка,
		|	""Через сайт"",
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Сумма,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка.Комментарий
		|ИЗ
		|	Документ.ОперацияПоПлатежнойКарте.РасшифровкаПлатежа КАК ОперацияПоПлатежнойКартеРасшифровкаПлатежа
		|ГДЕ
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка.Проведен
		|	И ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка.ЧекККМ.Валюта ЕСТЬ NULL
		|	И ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Заказ.ЭтоИнтернетМагазин";
	
	Запрос.УстановитьПараметр("ХозяйственнаяОперация", справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента);
	
	ТаблицаЗадачиФискализации.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры	

