&НаКлиенте
Процедура УстановитьПараметрыОтборовИОформление()
	
	ЭтаФорма.ЗаказыКотправке.Параметры.УстановитьЗначениеПараметра("Склад", ЭтаФорма.ОтборСклад); 
	ЭтаФорма.ЗаказыКотправке.Параметры.УстановитьЗначениеПараметра("Выполнено", ЭтаФорма.ПоказатьОтправленные); 
	
	ЭтаФорма.СписокАвтооформлениеЗаказов.Параметры.УстановитьЗначениеПараметра("ОтборТолькоПроблемные", ЭтаФорма.ТолькоПроблемные);
	ЭтаФорма.СписокАвтооформлениеЗаказов.Параметры.УстановитьЗначениеПараметра("ДатаНач", ЭтаФорма.СтПериод.ДатаНачала);
    ЭтаФорма.СписокАвтооформлениеЗаказов.Параметры.УстановитьЗначениеПараметра("ДатаКон", КонецДня(ЭтаФорма.СтПериод.ДатаОкончания));
	

КонецПроцедуры


&НаСервере
Процедура ЗаполнитьОжидаемымПоступлениемНаСервере(СкладОтбор)
	
	
	//П = Новый Структура("Показатель", "КомиссияНП_базСумма");	
	//КомиссияНП_базСумма = Инфра_ОбщиеМодули.ЗначениеПоказателя(П);	
	//П = Новый Структура("Показатель", "КомиссияНП_процент");
	//КомиссияНП_процент = Инфра_ОбщиеМодули.ЗначениеПоказателя(П);
	УстановитьПривилегированныйРежим(Истина);
	
	
	П = Новый Структура("Показатель", Справочники.Показатели.КомиссияНП_базСумма);
	КомиссияНП_базСумма = РегистрыСведений.ЗначенияПоказателей.СрезПоследних(ТекущаяДата(),П)[0].число;

	П = Новый Структура("Показатель", Справочники.Показатели.КомиссияНП_процент);
	КомиссияНП_процент = РегистрыСведений.ЗначенияПоказателей.СрезПоследних(ТекущаяДата(),П)[0].Число;
    	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента КАК ЗаказКлиента,
		|	СУММА(РасчетыСКлиентамиОстатки.КОплатеОстаток) КАК КОплатеОстаток,
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента.Партнер КАК ЗаказКлиентаПартнер,
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента.Склад КАК ЗаказКлиентаСклад
		|ПОМЕСТИТЬ вт_остатки
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами.Остатки(&ТекДата, ЗаказКлиента.ЭтоИнтернетМагазин = ИСТИНА) КАК РасчетыСКлиентамиОстатки
		|ГДЕ
		|	РасчетыСКлиентамиОстатки.КОплатеОстаток > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента,
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента.Партнер,
		|	РасчетыСКлиентамиОстатки.ЗаказКлиента.Склад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_остатки.ЗаказКлиента КАК ЗаказКлиента,
		|	ВложенныйЗапрос.РТУ КАК Реализация,
		|	ВложенныйЗапрос.Партнер КАК Покупатель,
		|	ВложенныйЗапрос.Дата,
		|	ВложенныйЗапрос.Склад КАК СкладОтправитель,
		|	ВложенныйЗапрос.ОстатокКОплате КАК СуммаВсего,
		|	0 КАК КомиссияНП,
		|	0 КАК СуммаКПолучению
		|ПОМЕСТИТЬ вт_сборка
		|ИЗ
		|	вт_остатки КАК вт_остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			РеализацияТоваровУслуг.ЗаказКлиента КАК ЗаказКлиента,
		|			РеализацияТоваровУслуг.Дата КАК Дата,
		|			СУММА(РеализацияТоваровУслуг.СуммаДокумента) КАК СуммаДокумента,
		|			РеализацияТоваровУслуг.Партнер КАК Партнер,
		|			РеализацияТоваровУслуг.Склад КАК Склад,
		|			СУММА(ОплатыПоПТУ.СуммаПоступившейОплаты) КАК СуммаПоступившейОплаты,
		|			СУММА(ЕСТЬNULL(РеализацияТоваровУслуг.СуммаДокумента, 0) - ЕСТЬNULL(ОплатыПоПТУ.СуммаПоступившейОплаты, 0)) КАК ОстатокКОплате,
		|			РеализацияТоваровУслуг.Ссылка КАК РТУ
		|		ИЗ
		|			Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					ПриходныйКассовыйОрдер.ДокументРТУ КАК ДокументОснование,
		|					СУММА(ПриходныйКассовыйОрдер.СуммаДокумента) КАК СуммаПоступившейОплаты
		|				ИЗ
		|					Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
		|				ГДЕ
		|					ПриходныйКассовыйОрдер.Проведен
		|				
		|				СГРУППИРОВАТЬ ПО
		|					ПриходныйКассовыйОрдер.ДокументРТУ) КАК ОплатыПоПТУ
		|				ПО РеализацияТоваровУслуг.Ссылка = ОплатыПоПТУ.ДокументОснование
		|		ГДЕ
		|			РеализацияТоваровУслуг.Проведен
		|		
		|		СГРУППИРОВАТЬ ПО
		|			РеализацияТоваровУслуг.Ссылка,
		|			РеализацияТоваровУслуг.Партнер,
		|			РеализацияТоваровУслуг.ЗаказКлиента,
		|			РеализацияТоваровУслуг.Дата,
		|			РеализацияТоваровУслуг.Склад) КАК ВложенныйЗапрос
		|		ПО вт_остатки.ЗаказКлиента = ВложенныйЗапрос.ЗаказКлиента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_сборка.ЗаказКлиента,
		|	вт_сборка.Реализация,
		|	вт_сборка.Покупатель,
		|	вт_сборка.Дата,
		|	вт_сборка.СкладОтправитель,
		|	вт_сборка.СуммаВсего,
		|	вт_сборка.КомиссияНП,
		|	вт_сборка.СуммаКПолучению
		|ИЗ
		|	вт_сборка КАК вт_сборка
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &СкладОтправитель = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			КОГДА НЕ &СкладОтправитель = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|					И вт_сборка.СкладОтправитель = &СкладОтправитель
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	И вт_сборка.СуммаВсего > 0";
	
	Запрос.УстановитьПараметр("ТекДата", КонецДня(ТекущаяДата())+1);
	Запрос.УстановитьПараметр("СкладОтправитель", СкладОтбор);
	
	ТЗ = новый ТаблицаЗначений;
	ТЗ =  Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр из ТЗ цикл
		Если 
			Стр.СуммаВсего > 0
			Тогда
			Стр.КомиссияНП = Стр.СуммаВсего * КомиссияНП_процент + КомиссияНП_базСумма;
			Стр.СуммаКПолучению = Стр.СуммаВсего - Стр.КомиссияНП;
		КонецЕсли;
	КонецЦикла;
	
	ЭтаФорма.ТаблицаДеньгиКПолучению.Загрузить(ТЗ);
    
КонецПроцедуры


&НаКлиенте
