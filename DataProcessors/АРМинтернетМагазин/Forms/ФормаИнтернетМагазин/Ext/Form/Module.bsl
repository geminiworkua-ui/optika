&НаСервере
Функция СформироватьЧекККМНаСервере(Идентификатор)
	Строка = ТаблицаЗадачиФискализации.НайтиПоИдентификатору(Идентификатор);
	
	КассаККМ =ПолучитьКассуККМ(); 
	Если КассаККМ = Неопределено Тогда 
		
		Сообщить("Нет настроек Кассы для рабочего места");	
		Возврат Неопределено;
	КонецЕсли;
	
	СостояниеКассовойСмены = РозничныеПродажи.ПолучитьСостояниеКассовойСмены(КассаККМ);
	
	Если Не СостояниеКассовойСмены.СтатусКассовойСмены  = Перечисления.статусыКассовойСмены.Открыта Тогда
		Сообщить("Кассовая смена не открыта");
		Возврат Неопределено;
	Конецесли; 
	ДокументОбъект = Строка.ДокументОснование.ПолучитьОбъект();
	ДокументОбъект.ЧекККМ = СформироватьЧекПоЗаказу(Строка, КассаККМ, СостояниеКассовойСмены);
	ДокументОбъект.Записать(); 	
	Возврат ДокументОбъект.ЧекККМ;
	
КонецФункции

Функция ПолучитьКассуККМ()
Запрос = Новый запрос (
"ВЫБРАТЬ
|	НастройкиРМККассыККМ.КассаККМ
|ИЗ
|	Справочник.НастройкиРМК.КассыККМ КАК НастройкиРМККассыККМ
|ГДЕ
|	НастройкиРМККассыККМ.Ссылка.РабочееМесто = &РабочееМесто");
Запрос.УстановитьПараметр("РабочееМесто", ПараметрыСеанса.РабочееМестоКлиента);
Результат =запрос.Выполнить().Выбрать();
Если Результат.Следующий() Тогда
	Возврат Результат.КассаККМ;
КонецЕсли;	
КонецФункции

Функция СформироватьЧекПоЗаказу(Строка, КассаККМ, СостояниеКассовойСмены)
    ЧекККМ = Документы.ЧекККМ.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ЧекККМ,СостояниеКассовойСмены);
	
	Если ТипЗнч(Строка.ДокументОснование) =Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		ЧекККМ.ПолученоНаличными = Строка.ДокументОснование.СуммаДокумента;
		ЧекККМ.Товары.Загрузить(Строка.Реализация.Товары.Выгрузить());
        ЧекККМ.СкидкиНаценки.Загрузить(Строка.Реализация.СкидкиНаценки.Выгрузить());
	Иначе
		Оплата = ЧекККМ.ОплатаПлатежнымиКартами.Добавить();
		Оплата.КодАвторизации = Строка.ДокументОснование.КодАвторизации;
	    Оплата.НомерПлатежнойКарты =Строка.ДокументОснование.НомерПлатежнойКарты;
		Оплата.ЭквайринговыйТерминал =Строка.ДокументОснование.ЭквайринговыйТерминал;    
		Оплата.Сумма = Строка.ДокументОснование.СуммаДокумента;  
		ЧекККМ.Товары.Загрузить(Строка.ЗаказКлиента.Товары.Выгрузить());
		ЧекККМ.СкидкиНаценки.Загрузить(Строка.ЗаказКлиента.СкидкиНаценки.Выгрузить());

	КонецЕсли;
	
			
	ЧекККМ.Статус = Неопределено;
	ЧекККМ.Дата = ТекущаяДата();
	ЧекККМ.ДокументОснование = Строка.ЗаказКлиента;  
	ЧекККМ.Партнер = Строка.ЗаказКлиента.Партнер;
	ЧекККМ.КартаЛояльности = Строка.ЗаказКлиента.КартаЛояльности;
	ЧекККМ.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат ЧекККМ.Ссылка;
КонецФункции	

&НаКлиенте
Процедура СформироватьЧекККМ(Команда)
	
	Если НЕ Элементы.ТаблицаЗадачиФискализации.ТекущаяСтрока = Неопределено Тогда
		
		ЧекККМ = СформироватьЧекККМНаСервере(Элементы.ТаблицаЗадачиФискализации.ТекущаяСтрока);
		Если ЧекККМ = неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбновитьСписокЗавершение", ЭтотОбъект);
		Парам = Новый Структура;
		Парам.Вставить("Ключ", ЧекККМ);
		ОткрытьФорму("Документ.ЧекККМ.Форма.ФормаДокументаРМК", Парам, ,,, , ОповещениеОЗакрытии,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

