
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СтруктураКонтактногоЛица") Тогда
		
		Если ТипЗнч(Параметры.СтруктураКонтактногоЛица) = Тип("Структура")
			И Параметры.СтруктураКонтактногоЛица.Свойство("ТипКонтрагента") Тогда 
			
			Если Параметры.СтруктураКонтактногоЛица.ТипКонтрагента = Документы.eComm_ЭкспрессНакладная.ТипКонтрагентаЧастноеЛицо() Тогда 
				ТипКонтрагентаСтрокой = "PrivatePerson";
			ИначеЕсли Параметры.СтруктураКонтактногоЛица.ТипКонтрагента = Документы.eComm_ЭкспрессНакладная.ТипКонтрагентаОрганизация() Тогда
				ТипКонтрагентаСтрокой = "Organization";
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.СтруктураКонтактногоЛица);
			
			Если Параметры.СтруктураКонтактногоЛица.Свойство("Телефон")
				И ТипЗнч(Параметры.СтруктураКонтактногоЛица.Телефон) = Тип("Массив") 
				И Параметры.СтруктураКонтактногоЛица.Телефон.Количество() > 0 Тогда 
				Телефон = Параметры.СтруктураКонтактногоЛица.Телефон[0];
			КонецЕсли;
			
		КонецЕсли;
		
		УчетнаяЗапись = Параметры.СтруктураКонтактногоЛица.УчетнаяЗапись;
		ТипКонтрагентаПриИзмененииНаСервере();
		
	Иначе
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ТипКонтрагентаПриИзменении(Элемент)
	
	ТипКонтрагентаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЗакрыть(Команда)
	
	Успешно = ЗаписатьЗакрытьНаСервере();
	
	Если Успешно = Истина Тогда 
		ПараметрыЗакрытия = Новый Структура("Получатель, КонтактноеЛицоПолучателя, ТипПолучателя, Телефон", Получатель, КонтактноеЛицоПолучателя, ТипКонтрагента, Телефон);
		Закрыть(ПараметрыЗакрытия);
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаСервере
Функция ЗаписатьЗакрытьНаСервере()
	
	НачатьТранзакцию();
	ЕстьОшибка = Ложь;
	
	Попытка
		
		Если НЕ ТипКонтрагентаСтрокой = "PrivatePerson" Тогда 
			
			КонтрагентОбъект = Справочники.eComm_КонтрагентыДоставки.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(КонтрагентОбъект, ЭтаФорма, "Наименование, ТипКонтрагента, ФормаСобственности, ЕДРПОУ");
			КонтрагентОбъект.Владелец = УчетнаяЗапись;
			КонтрагентОбъект.УстановитьНовыйКод();
			КонтрагентОбъект.Записать();
			
			КонтрагентСсылка = КонтрагентОбъект.Ссылка;
			
		Иначе
			
			КонтрагентСсылка = Документы.eComm_ЭкспрессНакладная.ПолучательЧастноеЛицо(УчетнаяЗапись);
			
		КонецЕсли;
		
		КонтактноеЛицо = Справочники.eComm_КонтактныеЛицаКонтрагентовДоставки.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(КонтактноеЛицо, ЭтаФорма);
		КонтактноеЛицо.Владелец = КонтрагентСсылка;
		КонтактноеЛицо.УстановитьНовыйКод();
		КонтактноеЛицо.Записать();
		
		Получатель 					= КонтрагентСсылка;
		КонтактноеЛицоПолучателя 	= КонтактноеЛицо.Ссылка;
		
	Исключение
		
		ЕстьОшибка = Истина;
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки;

	Если НЕ ЕстьОшибка Тогда 
		ЗафиксироватьТранзакцию();
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
	
	Возврат НЕ ЕстьОшибка;
	
КонецФункции

&НаСервере
Процедура ТипКонтрагентаПриИзмененииНаСервере()

	Если ТипКонтрагентаСтрокой = "PrivatePerson" Тогда 
		ТипКонтрагента = Документы.eComm_ЭкспрессНакладная.ТипКонтрагентаЧастноеЛицо();
		Элементы.ГруппаОрганизация.Видимость = Ложь;
	ИначеЕсли ТипКонтрагентаСтрокой = "Organization" Тогда 
		ТипКонтрагента = Документы.eComm_ЭкспрессНакладная.ТипКонтрагентаОрганизация();
		Элементы.ГруппаОрганизация.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры


