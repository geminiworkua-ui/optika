// Куда: Обработки -> keycrm_ОбменСKeyCRM -> Формы -> Форма -> Модуль формы (новый модуль)
// Кнопки операций создаются программно, в редакторе формы их рисовать не нужно.
// В свойствах формы нужно назначить только обработчик события ПриСозданииНаСервере.

//ДК: 13.11.2026

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.Настройка) Тогда
		АктивнаяНастройка = keycrm_Обмен.АктивнаяНастройка();
		Если ЗначениеЗаполнено(АктивнаяНастройка) Тогда
			Объект.Настройка = АктивнаяНастройка;
		КонецЕсли;
	КонецЕсли;

	ДобавитьКомандыОбмена();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключаемый_ВыполнитьОперацию(Команда)

	// Имя команды = "Команда" + имя операции
	Операция = Сред(Команда.Имя, 8);

	Если Операция = "ОткрытьЖурнал" Тогда
		ОткрытьФорму("РегистрСведений.keycrm_ЖурналЛогирования.ФормаСписка");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Настройка) Тогда
		ПоказатьПредупреждение(, "Выберите настройку обмена");
		Возврат;
	КонецЕсли;

	Если Операция = "Сопоставление" Тогда
		ТекстВопроса = "Прочитать все варианты товаров из KeyCRM и сопоставить их с номенклатурой 1С по SKU?
			|В KeyCRM ничего не изменяется.";
	ИначеЕсли Операция = "ТоварыПолностью" Тогда
		ТекстВопроса = "Выгрузить в KeyCRM ВСЕ карточки товаров по отбору (без отбора - по отбору из настройки)?
			|Несопоставленные товары будут созданы. При большом количестве это займет много времени.";
	ИначеЕсли Операция = "ЦеныОстаткиПолностью" Тогда
		ТекстВопроса = "Выгрузить в KeyCRM цены и остатки по ВСЕМ сопоставленным вариантам по отбору?";
	ИначеЕсли Операция = "Изменения" Тогда
		ТекстВопроса = "Выполнить обычный обмен сейчас (только изменения, как по расписанию)?";
	ИначеЕсли Операция = "Заказы" Тогда
		ТекстВопроса = "Загрузить новые заказы из KeyCRM сейчас?";
	Иначе
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияОперации", ЭтотОбъект, Операция);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеПодтвержденияОперации(Результат, Операция) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, ЗапуститьОперациюНаСервере(Операция));

КонецПроцедуры

&НаСервере
Функция ЗапуститьОперациюНаСервере(Операция)

	Отбор = Новый Массив;
	Для Каждого СтрокаОтбора Из Объект.ОтборНоменклатуры Цикл
		Если ЗначениеЗаполнено(СтрокаОтбора.Номенклатура) Тогда
			Отбор.Добавить(СтрокаОтбора.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Операция);
	ПараметрыЗадания.Добавить(Отбор);
	ПараметрыЗадания.Добавить(Объект.Настройка);

	Попытка
		// Ключ не дает запустить вторую ручную операцию, пока выполняется первая
		ФоновыеЗадания.Выполнить("keycrm_Обмен.ВыполнитьОбмен", ПараметрыЗадания,
			"keycrm_РучнаяОперация", "KeyCRM: " + Операция);
	Исключение
		Возврат "Не удалось запустить операцию (возможно, предыдущая еще выполняется):"
			+ Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "Операция запущена в фоновом режиме." + Символы.ПС
		+ "Ход выполнения и результат смотрите в журнале обмена (кнопка ""Открыть журнал"").";

КонецФункции

&НаСервере
Процедура ДобавитьКомандыОбмена()

	Группа = Элементы.Добавить("ГруппаОперацииОбмена", Тип("ГруппаФормы"), ЭтаФорма);
	Группа.Вид         = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок   = "Операции (выполняются в фоне)";
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	ДобавитьКомандуОбмена(Группа, "Сопоставление", "1. Сопоставить товары с KeyCRM по SKU");
	ДобавитьКомандуОбмена(Группа, "ТоварыПолностью", "2. Выгрузить товары полностью (по отбору)");
	ДобавитьКомандуОбмена(Группа, "ЦеныОстаткиПолностью", "3. Выгрузить цены и остатки полностью (по отбору)");
	ДобавитьКомандуОбмена(Группа, "Изменения", "Выполнить обмен сейчас (только изменения)");
	ДобавитьКомандуОбмена(Группа, "Заказы", "Загрузить заказы сейчас");
	ДобавитьКомандуОбмена(Группа, "ОткрытьЖурнал", "Открыть журнал");

КонецПроцедуры

&НаСервере
Процедура ДобавитьКомандуОбмена(Группа, ИмяОперации, Заголовок)

	КомандаФормы = Команды.Добавить("Команда" + ИмяОперации);
	КомандаФормы.Заголовок = Заголовок;
	КомандаФормы.Действие  = "Подключаемый_ВыполнитьОперацию";

	Кнопка = Элементы.Добавить("Кнопка" + ИмяОперации, Тип("КнопкаФормы"), Группа);
	Кнопка.ИмяКоманды = КомандаФормы.Имя;

КонецПроцедуры

#КонецОбласти

