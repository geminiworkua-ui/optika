
/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УчетнаяЗапись", УчетнаяЗапись);
	
	ЭтоУТП = eCommСервер.ИмяКонфигурации() = "УправлениеТорговымПредприятиемДляУкраины";
	Элементы.ГруппаНастройки.Видимость 			= ЭтоУТП;
	Элементы.ЭквайринговыйТерминал.Видимость 	= НЕ ЭтоУТП;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ eCommСервер.ИмяКонфигурации() = "УправлениеТорговымПредприятиемДляУкраины" Тогда 
		
		ПроверяемыеРеквизиты.Добавить("ЭквайринговыйТерминал");
		
	Иначе
		
		ПроверяемыеРеквизиты.Добавить("ДатаРеестра");
		ПроверяемыеРеквизиты.Добавить("Организация");
		ПроверяемыеРеквизиты.Добавить("Счет");
		
		Если ФормироватьДокументОплатыКомиссии = Истина Тогда 
			ПроверяемыеРеквизиты.Добавить("Контрагент");
			ПроверяемыеРеквизиты.Добавить("СчетКонтрагента");
			ПроверяемыеРеквизиты.Добавить("ДоговорЭквайринга");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ИмяФайлаИмпортНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Фильтр = НСтр("ru = 'Файл реестра Excel'; uk = 'Файл реєстру Excel'") + "(.xls, *.xlsx)|*.xls;*.xlsx";
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Фильтр                      = Фильтр;
	ДиалогВыбораФайла.Заголовок                   = НСтр("ru = 'Выберите файл Excel для загрузки данных'; uk = 'Виберіть файл Excel для завантаження даних'");
	ДиалогВыбораФайла.ПредварительныйПросмотр     = Ложь;
	ДиалогВыбораФайла.ИндексФильтра               = 0;
	ДиалогВыбораФайла.ПолноеИмяФайла              = Элемент.ТекстРедактирования;
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Ложь;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ИмяФайлаИмпорт = ДиалогВыбораФайла.ПолноеИмяФайла;
		ПрочитатьОплатыНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОплаты(Команда)
	
	ПрочитатьОплатыНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьДокументы(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ОформитьДокументыНаСервере();
	
	// Перечитаем
	ТаблицаДанных.Очистить();
	ПрочитатьОплатыНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	ФормироватьДокументОплатыКомиссии = ЗначениеЗаполнено(Контрагент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорЭквайрингаПриИзменении(Элемент)
	
	ДоговорЭквайрингаПриИзмененииНаСервере();
	
КонецПроцедуры


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ ФОРМЫ

&НаКлиенте
Процедура ИмпортВыпискиКлиент(Отказ = Ложь)

	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		
		ТекстПредупреждения = "Выберите файл " + ИмяФайлаИмпорт;	
		ПоказатьПредупреждение(,ТекстПредупреждения,,);
		
		АдресХранилищаФайла = "";
		Результат = ПоместитьФайл(АдресХранилищаФайла, ИмяФайлаИмпорт, , Истина);
		
	#Иначе
		
		АдресХранилищаФайла = "";
		Результат = ПоместитьФайл(АдресХранилищаФайла, ИмяФайлаИмпорт, , Ложь);
		
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОплатыНаКлиенте()

	Отказ = Ложь;
	
	ИмпортВыпискиКлиент(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ТаблицаДанных.Количество() > 0 Тогда
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("АдресХранилищаФайла", АдресХранилищаФайла);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, ПараметрыОповещения); // Прописываем название процедуры-обработчика.
		
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Очистить таблицу данных?'; uk = 'Очистити таблицю даних?'"), РежимДиалогаВопрос.ОКОтмена, 0, КодВозвратаДиалога.ОК);
		
	Иначе
		
		ПрочитатьОплатыНаСервере();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Ответ, ДопПараметры = Неопределено) Экспорт

	Если НЕ Ответ = КодВозвратаДиалога.ОК Тогда 
		Возврат;
	КонецЕсли;
	
	ТаблицаДанных.Очистить();
	
	ПрочитатьОплатыНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПрочитатьОплатыНаСервере()
	
	Настройки = eCommСервер.Настройки(УчетнаяЗапись);
	
	Обработки.eComm_Rozetka.ПрочитатьОплаты(Настройки, ЭтаФорма, АдресХранилищаФайла);
		
КонецПроцедуры

&НаСервере
Процедура ОформитьДокументыНаСервере()

	Настройки = eCommСервер.Настройки(УчетнаяЗапись);

	Настройки.Вставить("ЭквайринговыйТерминал", ЭквайринговыйТерминал);
	
	Данные = РеквизитФормыВЗначение("ТаблицаДанных");
	
	// Только для УТП-подобных конфигураций
	ПараметрыЗаполнения = Новый Структура("Организация, Счет, Контрагент, ДоговорЭквайринга, СчетКонтрагента, ДоговорКонтрагента, ВидОплаты, ОтражатьВУправленческомУчете, ОтражатьВБухгалтерскомУчете, ФормироватьДокументОплатыКомиссии");
	ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ЭтаФорма);
	
	Обработки.eComm_Rozetka.ОформитьОплаты(Настройки, Данные, ПараметрыЗаполнения);

КонецПроцедуры

&НаСервере
Процедура ДоговорЭквайрингаПриИзмененииНаСервере()
	
	Контрагент = ДоговорЭквайринга.Эквайрер;
	
КонецПроцедуры










