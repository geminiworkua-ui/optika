#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);

КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Количество() =0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.РежимЗаписи = РежимзаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	ВидыЦен = ЭтотОбъект.Отбор.Регистратор.Значение.ВидыЦен.Выгрузить().ВыгрузитьКолонку("ВидЦены");
	
	МассивУзлов =Новый Массив;
	
	Для Каждого Вид из ВидыЦен Цикл
		Если Вид.ОтправлятьНаСайт = ПланыОбмена.ОбменССайтомНовый.ПустаяСсылка() Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Вид.ОтправлятьНаСайт = ПланыОбмена.ОбменССайтомНовый.ЭтотУзел() Тогда
			Продолжить;
		КонецЕсли;	
				
		Рез= МассивУзлов.Найти(Вид.ОтправлятьНаСайт);
		
		Если Рез =Неопределено Тогда
			 МассивУзлов.Добавить(Вид.ОтправлятьНаСайт);  
		КОнецЕсли;	 
	КонецЦикла;	
	
	Узлы = ИнфралайнСерверСервис.ПолучитьУзлыОбмена();
			
	ТЗ =ЭтотОбъект.Отбор.Регистратор.Значение.Товары.Выгрузить();
	ТЗ.Свернуть("Номенклатура");
	Для Каждого Узел из  МассивУзлов Цикл
		Для каждого Стр из ТЗ Цикл
				
			УзлыНом =ИнфралайнСерверСервис.ПолучитьУзлыОбменаНоменклатуры(Стр.Номенклатура, Узлы);
			
			Если УзлыНом.Количество()=0 Тогда
				Продолжить;
			КонецЕсли;	
			
			Рез = УзлыНом.Найти(Узел);		
			Если Рез = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Не Стр.Номенклатура.РазрешенОбменСайт Тогда
				Продолжить;
			КонецЕсли;	
			НаборЗаписей = РегистрыСведений.ТоварыДляПередачиНаСайт.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Номенклатура.Установить(Стр.Номенклатура);
			НаборЗаписей.Отбор.Направление.Установить(Перечисления.НаправлениеДляПередачи.Цены);
			НаборЗаписей.Отбор.УзелРегистрации.Установить(Узел);
           	НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда 
			 	Запись = НаборЗаписей.Добавить();
			 	Запись.Номенклатура = Стр.Номенклатура;
			 	Запись.Направление = Перечисления.НаправлениеДляПередачи.Цены;
				Запись.УзелРегистрации = Узел;
			 	НаборЗаписей.Записать(Истина);		
			КонецЕсли;
			
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, НаборЗаписей); 
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти

#КонецЕсли
