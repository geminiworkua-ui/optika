
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	Если Параметры.Свойство("Продукция") Тогда
		Запись.Продукция = Параметры.Продукция;
	КонецЕсли;
	
	Если Параметры.Свойство("Период") Тогда
		Запись.Период = Параметры.Период;	
	КонецЕсли;
	
	
	Если Параметры.Свойство("Номенклатура") Тогда
		Запись.Номенклатура = Параметры.Номенклатура;
	КонецЕсли;
	
	Если Параметры.Свойство("Характеристика") Тогда
		Запись.Характеристика = Параметры.Характеристика;
	КонецЕсли;   
	
	Если Параметры.Свойство("Процент") Тогда
		Запись.Процент = Параметры.Процент;
	КонецЕсли;
	
	Если Параметры.Свойство("Брутто") Тогда
		Запись.Кво = Параметры.Брутто;
	КонецЕсли;
	
	Если Параметры.Свойство("Нетто") Тогда
		Запись.Кво_Нетто = Параметры.Нетто;
	КонецЕсли;
	
	Если Параметры.Свойство("Пользователь") Тогда
		Запись.Пользователь = Параметры.Пользователь;
	КонецЕсли;

КонецПроцедуры
