
Процедура ЗафиксироватьИзменениеСтатуса(УчетнаяЗапись, ИнтернетТовар, Статус = "not_on_display") Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.eComm_ТоварыКИзменениюСтатусов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УчетнаяЗапись	= УчетнаяЗапись;
		МенеджерЗаписи.ИнтернетТовар 	= ИнтернетТовар;
		МенеджерЗаписи.Статус			= Статус;
		МенеджерЗаписи.Записать(Истина);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Сообщить(ТекстОшибки);
		ЗаписьЖурналаРегистрации("eComm.ОшибкаПром",УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

КонецПроцедуры