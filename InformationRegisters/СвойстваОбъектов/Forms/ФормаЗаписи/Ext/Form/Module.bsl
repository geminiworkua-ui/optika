
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	Если Параметры.Свойство("Объект") Тогда
		Запись.Продукция = Параметры.Объект;
	КонецЕсли;
	
	Если Параметры.Свойство("Период") Тогда
		Запись.Период = Параметры.Период;	
	КонецЕсли;
	
	Если Параметры.Свойство("Пользователь") Тогда
		Запись.Пользователь = Параметры.Пользователь;
	КонецЕсли;

	Если Параметры.Свойство("НЕАктуальна") Тогда
		Запись.НЕАктуальна = Параметры.НЕАктуальна;	
	КонецЕсли;
	
	Если Параметры.Свойство("Свойство") Тогда
		Запись.Свойство = Параметры.Свойство;	
	КонецЕсли;
	
	Если Параметры.Свойство("Значение") Тогда
		Запись.Значение = Параметры.Значение;	
	КонецЕсли;


КонецПроцедуры
