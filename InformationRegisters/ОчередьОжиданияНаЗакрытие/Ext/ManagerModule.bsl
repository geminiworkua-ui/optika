Процедура ПопыткаЗаполнитьОчередь() экспорт

	Запрос = новый Запрос("ВЫБРАТЬ
	                      |	ОчередьОжиданияНаЗакрытие.Заказ КАК Заказ
	                      |ИЗ
	                      |	РегистрСведений.ОчередьОжиданияНаЗакрытие КАК ОчередьОжиданияНаЗакрытие");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() цикл 
		
		Попытка
			ДО = Выборка.Заказ.ПолучитьОБъект();
			ДО.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт;
			ДО.Записать(РежимЗаписиДокумента.Проведение);
			Заказ = ДО.Ссылка;
			
			Набор = РегистрыСведений.ОчередьОжиданияНаЗакрытие.СоздатьНаборЗаписей();
    		Набор.Отбор.Заказ.Установить(Выборка.Заказ);
			Набор.Прочитать();
			Набор.Очистить();
			Набор.Записать();
			
			
		Исключение
		КонецПопытки;
		
	КонецЦикла	
	
		
КонецПроцедуры	