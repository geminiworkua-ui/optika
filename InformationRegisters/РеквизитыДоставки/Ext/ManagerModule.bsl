Функция СтруктураДанныхЗаписи(Ссылка)  экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	РеквизитыДоставки.ОбъектВладелец,
	                      |	РеквизитыДоставки.СлужбаДоставки,
	                      |	РеквизитыДоставки.ТехнологияДоставки,
	                      |	РеквизитыДоставки.УчетнаяЗапись,
	                      |	РеквизитыДоставки.ПолучательФИО,
	                      |	РеквизитыДоставки.ПолучательФамилия,
	                      |	РеквизитыДоставки.ПолучательИмя,
	                      |	РеквизитыДоставки.ПолучательОтчество,
	                      |	РеквизитыДоставки.ПолучательТелефон,
	                      |	РеквизитыДоставки.НаселенныйПунктПолучателя,
	                      |	РеквизитыДоставки.УлицаПолучателя,
	                      |	РеквизитыДоставки.ОтделениеПолучателя,
	                      |	РеквизитыДоставки.ДоставкаКурьером,
	                      |	РеквизитыДоставки.НомерДомаПолучателя,
	                      |	РеквизитыДоставки.НомерКвартирыПолучателя,
	                      |	РеквизитыДоставки.ПараметрыДоставкиСтрокой,
	                      |	РеквизитыДоставки.НаселенныйПунктОтправителя,
	                      |	РеквизитыДоставки.ОтправительПоУмолчанию,
	                      |	РеквизитыДоставки.ОтделениеОтправителя,
	                      |	РеквизитыДоставки.ФизическоеЛицоОтправитель
	                      |ИЗ
	                      |	РегистрСведений.РеквизитыДоставки КАК РеквизитыДоставки
	                      |ГДЕ
	                      |	РеквизитыДоставки.ОбъектВладелец = &ОбъектВладелец");
	
	 Запрос.УстановитьПараметр("ОбъектВладелец", Ссылка);
	 ТЗ = Запрос.Выполнить().Выгрузить();
	 М = ОБщегоНазначения.ТаблицаЗначенийВМассив(ТЗ);
	 Если М.Количество() > 0
		 Тогда
		 Возврат М[0];
	 КонецЕсли;
	 
 КонецФункции   
 
Функция СтруктураПараметровСозданияЕН() экспорт
	 УстановитьПРивилегированныйРежим(Истина);

	П = новый структура("ПоРеквизитамДоставки, СлужбаДоставки, ТехнологияДоставки, УчетнаяЗапись, ПолучательФИО, ПолучательФамилия, ПолучательИмя, ПолучательОтчество, ПолучательТелефон, НаселенныйПунктПолучателя, УлицаПолучателя,
	| ОтделениеПолучателя,  ДоставкаКурьером, НомерДомаПолучателя,  НомерКвартирыПолучателя, ОбъектВладелец");
	
	Возврат П;
КонецФункции	
	