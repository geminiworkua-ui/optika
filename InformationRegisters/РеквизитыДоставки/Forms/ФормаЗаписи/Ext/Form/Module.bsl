
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	если Параметры.Свойство("ОБъектСсылка")
		ТОгда
		Запись.ОбъектВладелец = Параметры.ОБъектСсылка;
	КонецЕсли;
	ПолучитьРеквизитыДекларации();
	
	Если ТипЗнч(Запись.ОбъектВладелец) = Тип("СправочникСсылка.Склады")
		Тогда
		Элементы.ФормаСоздатьЭкспрессНакладную.Видимость = Ложь;
	КонецЕсли;

	// Вставити вміст обробника.
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастройкаВидимостиДоступности();// Вставити вміст обробника.
КонецПроцедуры

&НаКлиенте
Процедура ДоставкаКурьеромПриИзменении(Элемент)
	НастройкаВидимостиДоступности();// Вставити вміст обробника.
    Если Запись.ДоставкаКурьером = Истина Тогда
		Запись.ТехнологияДоставки = ДоставкаДоДвери();
	Иначе	
		Запись.ТехнологияДоставки = ДоставкаОТделениеОТделение();
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДоставкаДоДвери()
	Возврат Справочники.eComm_ОбщиеСправочники.НайтиПоКоду("000000169");
КонецФункции

&НаСервереБезКонтекста
Функция ДоставкаОТделениеОТделение()
	Возврат Справочники.eComm_ОбщиеСправочники.НайтиПоКоду("000000170");
КонецФункции

&НаКлиенте
Процедура НастройкаВидимостиДоступности()
	
	Элементы.ОтделениеПолучателя.Видимость = НЕ Запись.ДоставкаКурьером;
	Элементы.ГруппаАдреснаяДоставка.Видимость =  Запись.ДоставкаКурьером;;
    Элементы.ГруппаРеквизитыОтправителя.Видимость = НЕ Запись.ОтправительПоУмолчанию;  
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	П = НОвый Структура("ОбъектВладелец", Запись.ОбъектВладелец);
	Оповестить("Запись_РеквизитыДоставки", П);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
		
	Запись.ПараметрыДоставкиСтрокой = Строка(Запись.СлужбаДоставки) + ", " +
							Строка(Запись.ТехнологияДоставки) + " " + 
							Строка(Запись.НаселенныйПунктПолучателя)+ " " + 
							Строка(Запись.ОтделениеПолучателя) + " " + 
							Строка(Запись.УлицаПолучателя)   + " " + 
							Строка(Запись.НомерДомаПолучателя)  + " " + 
							Строка(Запись.НомерКвартирыПолучателя) + " " + 
							Строка(Запись.ПолучательФИО) + " " + 
							Строка(Запись.ПолучательТелефон);

КонецПроцедуры

Процедура ЗаполнитьДанныеОтправителя(СтрЕН, УченаяЗапись)  
СтруктураНастроек = Справочники.eComm_УчетныеЗаписиСлужбДоставки.Настройки(Запись.УчетнаяЗапись);
ДанныеЗаполнения =  СтруктураНастроек.ДанныеЗаполнения;

СтрЕН.Вставить("Отправитель", ДанныеЗаполнения.Отправитель);
СтрЕН.Вставить("ОтделениеОтправителя", ДанныеЗаполнения.ОтделениеОтправителя);
СтрЕН.Вставить("АдресОтправителя", ДанныеЗаполнения.АдресОтправителя);
СтрЕН.Вставить("ТелефонОтправителя", ДанныеЗаполнения.ТелефонОтправителя);	
КонецПроцедуры	

&НаКлиенте
Процедура СоздатьЭкспрессНакладную(Команда)
	
	мЭкспрессНакладных = Инфра_ОбщиеМодули.ПолучитьСсылкуНаДекларации(Запись.ОбъектВладелец);
	Если мЭкспрессНакладных.Количество() = 0 ТОгда
		П = новый структура("ПоРеквизитамДоставки, СлужбаДоставки, ТехнологияДоставки, УчетнаяЗапись, ПолучательФИО, ПолучательФамилия, ПолучательИмя, ПолучательОтчество, ПолучательТелефон, НаселенныйПунктПолучателя, УлицаПолучателя,
		| ОтделениеПолучателя,  ДоставкаКурьером, НомерДомаПолучателя,  НомерКвартирыПолучателя, ОбъектВладелец,
		| НаселенныйПунктОтправителя, ОтделениеОтправителя, ФизическоеЛицоОтправитель, ОтправительПоУмолчанию"); 
		ЗаполнитьЗначенияСвойств(П, Запись);    
	Иначе
		п = Новый Структура("Ключ",мЭкспрессНакладных[0]);
	КонецЕсли;
	ОткрытьФорму("Документ.eComm_ЭкспрессНакладная.Форма.ФормаДокумента", П, ЭтаФорма, ,,,,РежимОткрытияокнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СтруктураПараметровСозданияЕН() 
	УстановитьПРивилегированныйРежим(Истина);
	П = РегистрыСведений.РеквизитыДоставки.СтруктураПараметровСозданияЕН();
КонецФункции	

&НаКлиенте
Процедура ОтправительПоУмолчаниюПриИзменении(Элемент)
	НастройкаВидимостиДоступности();
КонецПроцедуры

&НаСервере
Процедура ПолучитьРеквизитыДекларации()
    УстановитьПРивилегированныйРежим(Истина);
	мЭкспрессНакладных = Инфра_ОбщиеМодули.ПолучитьСсылкуНаДекларации(Запись.ОбъектВладелец);
	Если мЭкспрессНакладных.Количество() = 0 ТОгда
		Элементы.ФормаСоздатьЭкспрессНакладную.Заголовок = "Створити екпресс накладну";
	Иначе
		Элементы.ФормаСоздатьЭкспрессНакладную.Заголовок = "Відкрити створену екпресс накладну " + Строка(мЭкспрессНакладных[0].НомерТТН);
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ЭкспрессНакладная"
		И Параметр.ДокументОснование = Запись.ОбъектВладелец
		ТОгда
	    ПолучитьРеквизитыДекларации();
	КонецЕсли;

КонецПроцедуры
