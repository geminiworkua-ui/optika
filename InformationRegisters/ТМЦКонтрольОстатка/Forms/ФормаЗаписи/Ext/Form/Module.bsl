
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	Если Параметры.Свойство("Склад") Тогда
		Запись.Склад = Параметры.склад;
	КонецЕсли;
	
	Если Параметры.Свойство("Период") Тогда
		Запись.Период = Параметры.Период;	
	КонецЕсли;
	
	Если Параметры.Свойство("Номенклатура") Тогда
		Запись.Номенклатура = Параметры.Номенклатура;	
	КонецЕсли;
	
	Если Параметры.Свойство("Характеристика") Тогда
		Запись.Характеристика = Параметры.Характеристика;	
	КонецЕсли;
	
	Если Параметры.Свойство("Максимум") Тогда
		Запись.Кво_Макс = Параметры.Максимум;	
	КонецЕсли;
	
	Если Параметры.Свойство("Минимум") Тогда
		Запись.Кво_Мин = Параметры.Минимум;	
	КонецЕсли;
	
	Если Параметры.Свойство("НЕАктуальна") Тогда
		Запись.НЕАктуальна = Параметры.НЕАктуальна;	
	КонецЕсли;
	
	Если Параметры.Свойство("Пользователь") Тогда
		Запись.Пользователь = Параметры.Пользователь;
	КонецЕсли;

КонецПроцедуры
