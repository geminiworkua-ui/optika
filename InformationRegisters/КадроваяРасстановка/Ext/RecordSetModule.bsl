Процедура ПослеЗаписи(Отказ)
Если ОбменДанными.Загрузка Тогда
		Возврат;
КонецЕсли;
	
Узлы = ИнфралайнСерверСервис.ПолучитьУзлыОбмена();

	Для Каждого Узел из Узлы Цикл
		Для каждого Запись из ЭтотОБъект Цикл
			Если Не Запись.Активность Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не Запись.Должность.ЭтоВрач Тогда
				Продолжить;
			КонецЕсли;
	        ЗарегистрироватьЗапись(Запись, Узел);
            Продолжить;
		  КонецЦикла;
	КонецЦикла;
                     
КОнецПроцедуры

Процедура  ЗарегистрироватьЗапись(Запись, Узел)
   
Набор = РегистрыСведений.КадроваяРасстановка.СоздатьНаборЗаписей(); 
                    
Набор.Отбор.Регистратор.Установить(Запись.Регистратор);
Набор.Отбор.ФизическоеЛицо.Установить(Запись.ФизическоеЛицо);                    
Набор.Отбор.Подразделение.Установить(Запись.Подразделение);                    
Набор.Отбор.Должность.Установить(Запись.Должность);                    
Набор.Отбор.Актуальность.Установить(Запись.Актуальность);                    
Набор.Отбор.ВидКадровогоДвижения.Установить(Запись.ВидКадровогоДвижения);                    
Набор.Прочитать();
Если Набор.Количество()= 0 Тогда
	Возврат;  
КонецЕсли;	
ПланыОбмена.ЗарегистрироватьИзменения(Узел, Набор);

КОнецПроцедуры	