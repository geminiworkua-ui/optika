
#Область ОбработкаЗапроса

Функция POSTAll(Запрос)                                                                                     
	Узел =Неопределено;                                              
	ОбъектСсылка = Неопределено;
	ТелоЗапроса = ИнфралайнСерверСервис.ПрочитатьJSONТело(Запрос.ПолучитьТелоКакСтроку()); 
	ТелоОтвета = ИнфралайнСерверСервис.ОбработатьЗапрос(ТелоЗапроса, ОбъектСсылка, Запрос.ПолучитьТелоКакСтроку(), Узел);
	ТелоОтветаJSON = ИнфралайнСерверСервис.СформироватьJSON(ТелоОтвета);
	//ИнфралайнСерверСервис.ЗаписатьЛог(ТелоЗапроса.Task, Новый Структура("Успех", Истина), ОбъектСсылка, Запрос.ПолучитьТелоКакСтроку(), ТелоОтветаJSON, Узел.Сайт);

	Если ТелоОтвета.Result Тогда
		Ответ = Новый HTTPСервисОтвет(200);
	Иначе 
		Ответ = Новый HTTPСервисОтвет(500);
	КонецЕсли;
	Ответ.УстановитьТелоИзСтроки(ТелоОтветаJSON);

	Возврат Ответ;
КонецФункции

Функция GETAll(Запрос)
	ТелоОтвета = ИнфралайнСерверСервис.ОбработатьЗапрос(Запрос);
	ТелоОтветаJSON = ИнфралайнСерверСервис.СформироватьJSON(ТелоОтвета);
	Если ТелоОтвета.Успех Тогда
		Ответ = Новый HTTPСервисОтвет(200);
	Иначе 
		Ответ = Новый HTTPСервисОтвет(500);
	КонецЕсли;
	Ответ.УстановитьТелоИзСтроки(ТелоОтветаJSON);

	Возврат Ответ;
КонецФункции

#КонецОбласти

