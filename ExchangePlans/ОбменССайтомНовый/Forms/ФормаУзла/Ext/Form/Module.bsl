Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)        
	УстановитьПривилегированныйРежим(Истина);
    КодЯзыка  =Локализация.КодЯзыкаИнтерфейса();
	Элементы.НастройкаОбменаОбъект.СписокВыбора.Очистить();
	Список = ОбменСайт.СоответствияОбменаДляСЗ(КодЯзыка);
	Для каждого Эл из Список Цикл
		Элементы.НастройкаОбменаОбъект.СписокВыбора.Добавить(Эл.Ключ, Эл.Значение);
	КонецЦикла; 
	
	СписокВидовЦен.Параметры.УстановитьЗначениеПараметра("ОТправлятьНаСайт", ОБъект.Ссылка);
	
	
	
КонецПроцедуры
