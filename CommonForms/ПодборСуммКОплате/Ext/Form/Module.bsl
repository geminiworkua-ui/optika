
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ЗаказКлиента = Параметры.ЗаказКлиента;
	ЭтаФорма.Склад = Параметры.Склад;
    СобратьОстаткикОплате();
	
	// ++ Боков А.А. 15.09.2025 
	БонуснаяПрограммаЛояльности = Справочники.БонусныеПрограммыЛояльности.НайтиПоНаименованию("БП LUXOR 10% 5% ");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(БонусныеБаллыОстатки.НачисленоОстаток) КАК НачисленоОстаток,
		|	СУММА(БонусныеБаллыОстатки.КСписаниюОстаток) КАК КСписаниюОстаток
		|ИЗ
		|	РегистрНакопления.БонусныеБаллы.Остатки(
		|			&ТекДата,
		|			Партнер = &Партнер
		|				И БонуснаяПрограммаЛояльности = &БонуснаяПрограммаЛояльности) КАК БонусныеБаллыОстатки";
	Запрос.УстановитьПараметр("Партнер", ЭтаФорма.ЗаказКлиента.Партнер);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("БонуснаяПрограммаЛояльности", БонуснаяПрограммаЛояльности);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		//Olga
		ЭтаФорма.СуммаБонусовОстаток = ВыборкаДетальныеЗаписи.НачисленоОстаток - ВыборкаДетальныеЗаписи.КСписаниюОстаток;
		ЭтаФорма.СуммаБонусовДоступно = ЭтаФорма.СуммаБонусовОстаток;
		
		//ЭтаФорма.СуммаБонусовОстаток = ВыборкаДетальныеЗаписи.КСписаниюОстаток;
	КонецЕсли;
	
	Элементы.Сертификаты.ВысотаВСтрокахТаблицы = 4;
	
КонецПроцедуры

&НаСервере
Процедура СобратьОстаткикОплате()

	УстановитьПривилегированныйРежим(Истина);
	
	ТЗ = новый ТаблицаЗначений;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ЧекККМТовары.Номенклатура КАК Номенклатура,
	                      |	ЧекККМТовары.Характеристика КАК Характеристика,
	                      |	ЧекККМТовары.Сумма КАК Сумма,
	                      |	ЧекККМТовары.КоличествоУпаковок КАК КоличествоУпаковок
	                      |ПОМЕСТИТЬ вт_Чеки
	                      |ИЗ
	                      |	Документ.ЧекККМ.Товары КАК ЧекККМТовары
	                      |ГДЕ
	                      |	ЧекККМТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	                      |	И ЧекККМТовары.Ссылка.ДокументОснование = &Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЧекККМВозвратТовары.Номенклатура,
	                      |	ЧекККМВозвратТовары.Характеристика,
	                      |	-1 * ЧекККМВозвратТовары.Сумма,
	                      |	-ЧекККМВозвратТовары.КоличествоУпаковок
	                      |ИЗ
	                      |	Документ.ЧекККМВозврат.Товары КАК ЧекККМВозвратТовары
	                      |ГДЕ
	                      |	ЧекККМВозвратТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	                      |	И ЧекККМВозвратТовары.Ссылка.ЧекККМ.ДокументОснование = &Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	вт_Чеки.Номенклатура,
	                      |	вт_Чеки.Характеристика,
	                      |	СУММА(вт_Чеки.Сумма) КАК СуммаОплаты,
	                      |	СУММА(вт_Чеки.КоличествоУпаковок) КАК КоличествоОплаты
	                      |ПОМЕСТИТЬ вт_оплаты
	                      |ИЗ
	                      |	вт_Чеки КАК вт_Чеки
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	вт_Чеки.Номенклатура,
	                      |	вт_Чеки.Характеристика
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	                      |	ЗаказКлиентаТовары.Характеристика КАК Характеристика,
	                      |	ЗаказКлиентаТовары.ПреемникПлатежаН КАК ПреемникПлатежаН,
	                      |	ЗаказКлиентаТовары.ПреемникПлатежаХ КАК ПреемникПлатежаХ,
	                      |	СУММА(ЗаказКлиентаТовары.КоличествоУпаковок) КАК КоличествоЗаказа,
	                      |	СУММА(ЗаказКлиентаТовары.Сумма) КАК СуммаЗаказа
	                      |ПОМЕСТИТЬ вт_товары
	                      |ИЗ
	                      |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	                      |ГДЕ
	                      |	ЗаказКлиентаТовары.Ссылка = &Ссылка
	                      |	И НЕ ЗаказКлиентаТовары.Отменено
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ЗаказКлиентаТовары.Номенклатура,
	                      |	ЗаказКлиентаТовары.Характеристика,
	                      |	ЗаказКлиентаТовары.ПреемникПлатежаН,
	                      |	ЗаказКлиентаТовары.ПреемникПлатежаХ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	вт_товары.Номенклатура,
	                      |	вт_товары.Характеристика,
	                      |	вт_товары.ПреемникПлатежаН,
	                      |	вт_товары.ПреемникПлатежаХ,
	                      |	вт_товары.КоличествоЗаказа,
	                      |	вт_товары.СуммаЗаказа,
	                      |	ЕСТЬNULL(вт_оплаты.СуммаОплаты, 0) КАК СуммаОплаты,
	                      |	ЕСТЬNULL(вт_оплаты.КоличествоОплаты, 0) КАК КоличествоОплаты
	                      |ПОМЕСТИТЬ вт_ЧистыеОплаты
	                      |ИЗ
	                      |	вт_товары КАК вт_товары
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ вт_оплаты КАК вт_оплаты
	                      |		ПО вт_товары.Номенклатура = вт_оплаты.Номенклатура
	                      |			И вт_товары.Характеристика = вт_оплаты.Характеристика
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	вт_ЧистыеОплаты.Номенклатура,
	                      |	вт_ЧистыеОплаты.Характеристика,
	                      |	СУММА(вт_ЧистыеОплаты.КоличествоОплаты) КАК КоличествоОплаты,
	                      |	СУММА(вт_ЧистыеОплаты.СуммаОплаты) КАК СуммаОплаты
	                      |ПОМЕСТИТЬ вт_ЗаказыОплаты
	                      |ИЗ
	                      |	вт_ЧистыеОплаты КАК вт_ЧистыеОплаты
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	вт_ЧистыеОплаты.Номенклатура,
	                      |	вт_ЧистыеОплаты.Характеристика
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ВЫБОР
	                      |		КОГДА вт_товары.ПреемникПлатежаН = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |			ТОГДА вт_товары.Номенклатура
	                      |		ИНАЧЕ вт_товары.ПреемникПлатежаН
	                      |	КОНЕЦ КАК Номенклатура,
	                      |	ВЫБОР
	                      |		КОГДА вт_товары.ПреемникПлатежаХ = ЗНАЧЕНИЕ(Справочник.ХАРАКТЕРИСТИКИНоменклатуры.ПустаяСсылка)
	                      |			ТОГДА вт_товары.Характеристика
	                      |		ИНАЧЕ вт_товары.ПреемникПлатежаХ
	                      |	КОНЕЦ КАК Характеристика,
	                      |	вт_товары.КоличествоЗаказа,
	                      |	вт_товары.СуммаЗаказа,
	                      |	вт_товары.КоличествоЗаказа - вт_ЗаказыОплаты.КоличествоОплаты КАК КоличествоОплаты,
	                      |	вт_товары.СуммаЗаказа - вт_ЗаказыОплаты.СуммаОплаты КАК СуммаОплаты,
	                      |	вт_ЗаказыОплаты.КоличествоОплаты КАК КоличествоОплачено,
	                      |	вт_ЗаказыОплаты.СуммаОплаты КАК СуммаОплачено
	                      |ПОМЕСТИТЬ ВТ_ТоварыКОплате
	                      |ИЗ
	                      |	вт_товары КАК вт_товары
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ вт_ЗаказыОплаты КАК вт_ЗаказыОплаты
	                      |		ПО вт_товары.Номенклатура = вт_ЗаказыОплаты.Номенклатура
	                      |			И вт_товары.Характеристика = вт_ЗаказыОплаты.Характеристика
	                      |ГДЕ
	                      |	вт_товары.СуммаЗаказа > вт_ЗаказыОплаты.СуммаОплаты
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	вт_ТоварыКОплате.Номенклатура КАК Номенклатура,
	                      |	вт_ТоварыКОплате.Характеристика КАК Характеристика,
	                      |	вт_ТоварыКОплате.КоличествоЗаказа КАК КоличествоЗаказа,
	                      |	вт_ТоварыКОплате.СуммаЗаказа КАК СуммаЗаказ,
	                      |	ВЫБОР
	                      |		КОГДА вт_ТоварыКОплате.СуммаЗаказа > вт_ТоварыКОплате.СуммаОплачено
	                      |			ТОГДА ИСТИНА
	                      |		ИНАЧЕ ЛОЖЬ
	                      |	КОНЕЦ КАК Платим,
	                      |	вт_ТоварыКОплате.СуммаЗаказа - вт_ТоварыКОплате.СуммаОплачено КАК Остаток,
	                      |	вт_ТоварыКОплате.КоличествоОплаты КАК КоличествоЧек,
	                      |	вт_ТоварыКОплате.СуммаОплаты КАК СуммаЧек,
	                      |	вт_ТоварыКОплате.КоличествоОплачено КАК КоличествоОплачено,
	                      |	вт_ТоварыКОплате.СуммаОплачено КАК СуммаОплачено,
	                      |	ПодборКассыККМ.КассаККМ КАК КассаККМ,
	                      |	вт_ТоварыКОплате.СуммаЗаказа / вт_ТоварыКОплате.КоличествоЗаказа КАК Цена,
	                      |	ИСТИНА КАК НуженЧек
	                      |ИЗ
	                      |	ВТ_ТоварыКОплате КАК вт_ТоварыКОплате
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ПривязкаСПДСрезПоследних.КассаККМ КАК КассаККМ,
	                      |			ПривязкаСПДСрезПоследних.ГруппаНоменклатурыДляРРО КАК ГруппаНоменклатурыДляРРО
	                      |		ИЗ
	                      |			РегистрСведений.ПривязкаСПД.СрезПоследних(&Дата, Магазин = &Склад) КАК ПривязкаСПДСрезПоследних) КАК ПодборКассыККМ
	                      |		ПО вт_ТоварыКОплате.Номенклатура.ВидНоменклатуры.ГруппаНоменклатурыДляРРО = ПодборКассыККМ.ГруппаНоменклатурыДляРРО");
    Запрос.УстановитьПараметр("Ссылка", ЗаказКлиента); 
	Запрос.УстановитьПараметр("Склад", Склад); 
	Запрос.УстановитьПараметр("Дата", ТекущаяДата()); 
	ТЗ = Запрос.Выполнить().Выгрузить();
			
	ОстаткиКОплате.Загрузить(ТЗ);
	РасчетИтогов();	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

&НаСервере
Процедура РасчетИтогов()

	Для каждого Стр из ОстаткиКОплате цикл
	Стр.КоличествоЧек = ?(Стр.Платим, Стр.КоличествоЧек,0);
	Стр.СуммаЧек 	  = ?(Стр.Платим, Стр.СуммаЧек,0); 
	Если Стр.Платим Тогда 
		СтрВозврат = ОпределитьКассуККМ(Стр.Номенклатура, Склад, Стр.НуженЧек);
		Стр.КассаККМ= СтрВозврат.КассаККМ;
	Иначе
      Стр.КассаККМ = ПредопределенноеЗначение("Справочник.КассыККМ.ПустаяСсылка");
	КонецЕсли;
КонецЦикла;
	
	СуммаЗаказано = ОстаткиКОплате.Итог("СуммаЗаказ");
	Оплачено   = ОстаткиКОплате.Итог("СуммаОплачено");
	Остаток    = ОстаткиКОплате.Итог("Остаток");
	СуммаЧек   = ОстаткиКОплате.Итог("СуммаЧек");


КонецПроцедуры	
 
&НаКлиенте
Процедура ОстаткиКОплатеПлатимПриИзменении(Элемент)
	 
	 ТекСтр = Элементы.ОстаткиКОплате.ТекущиеДанные;
	 
	 Если ТекСтр.Платим Тогда 
		 ТекСтр.СуммаЧек = ТекСтр.Остаток; 
		 ТекСтр.КоличествоЧек = ТекСтр.КоличествоЗаказа - ТекСтр.КоличествоОплачено;
		 СтрВозврат = ОпределитьКассуККМ(ТекСтр.Номенклатура, Склад, ТекСтр.НуженЧек);
		 ТекСтр.КассаККМ= СтрВозврат.КассаККМ;
		 ТекСтр.Кассир= СтрВозврат.КассирПоУмолчанию;
		 ТекСтр.НуженЧек = Истина;
	 Иначе              
		 ТекСтр.СуммаЧек = 0;
		 ТекСтр.КоличествоЧек = 0;
		 ТекСтр.НуженЧек = Ложь;
		 ТекСтр.КассаККМ = ПредопределенноеЗначение("Справочник.КассыККМ.ПустаяСсылка");
	 КонецЕсли;
	 
	 РасчетИтогов()	 
 КонецПроцедуры   
 
 &НаСервере
 Функция ОпределитьКассуККМ(Номенклатура, Склад, НуженЧек) 
	 Возврат Инфра_ОбщиеМодули.ОпределитьКассуККМ(Номенклатура, Склад, НуженЧек);
 КонецФункции	 

&НаКлиенте
Процедура ОстаткиКОплатеСуммаЧекПриИзменении(Элемент)
	
	ТекСтр = ЭтаФорма.Элементы.ОстаткиКОплате.ТекущиеДанные;	 
	ТекСтр.СуммаЧек = мин(Число(ТекСтр.СуммаЧек), число(ТекСтр.Остаток));
	Если ТекСтр.Цена > 0
		Тогда
		ТекСтр.КоличествоЧек = ТекСтр.СуммаЧек/ТекСтр.Цена;
	КонецЕсли;
	
	РасчетИтогов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьЗакрыть(Команда)
	 ЭтаФорма.Закрыть(Новый Структура("ТаблицаЧеков", РаспределитьПоЧекам(ЗаказКлиента))); 
КонецПроцедуры

Функция ПолучитьСтруктуруЗаписи()
мсДанных = Новый Массив;  
ТЗ = РеквизитФормыВЗначение("ОстаткиКОплате");
Для Каждого СтрокаТЗ Из ТЗ Цикл 	
	Если СтрокаТЗ.Платим Тогда
		стСтрокаТаблицы = Новый Структура;
		Для Каждого ИмяКолонки Из ТЗ.Колонки Цикл 
		    стСтрокаТаблицы.Вставить(ИмяКолонки.Имя, СтрокаТЗ[ИмяКолонки.Имя]);
		КонецЦикла;   
		мсДанных.Добавить(стСтрокаТаблицы);
	КонецЕсли;
КонецЦикла;
Возврат  мсДанных; 
КонецФункции	

&НаКлиенте
Процедура ОстаткиКОплатеКоличествоЧекПриИзменении(Элемент)

	ТекСтр = ЭтаФорма.Элементы.ОстаткиКОплате.ТекущиеДанные;
	ОстатокКолич = ТекСтр.КоличествоЗаказа - ТекСтр.КоличествоОплачено;
	ТекСтр.СуммаЧек = мин(ТекСтр.КоличествоЧек, ОстатокКолич) * ТекСтр.Цена;
	РасчетИтогов();
	
КонецПроцедуры


&НаСервере
Функция РаспределитьПоЧекам(Заказ)
	ТЗОстатки = ОстаткиКОплате.Выгрузить();
	возврат Инфра_ОбщиеМодули.РаспределитьПоЧекам(Заказ, ПараметрыСеанса.РабочееМестоКлиента, ТЗОстатки);
КонецФункции	

&НаСервере
Функция СоздатьЧекПоОтбору(СтрокиЗаказа, Заказ)
	Возврат Инфра_ОбщиеМодули.СоздатьЧекПоОтбору(СтрокиЗаказа, Заказ);
КонецФункции

&НаКлиенте
Процедура ОстаткиКОплатеНуженЧекПриИзменении(Элемент)
	
	 ТекСтр = Элементы.ОстаткиКОплате.ТекущиеДанные;
	 
	 Если ТекСтр.Платим Тогда 
		 ТекСтр.СуммаЧек = ТекСтр.Остаток; 
		 ТекСтр.КоличествоЧек = ТекСтр.КоличествоЗаказа - ТекСтр.КоличествоОплачено;
		 СтрВозврат = ОпределитьКассуККМ(ТекСтр.Номенклатура, Склад, ТекСтр.НуженЧек);
		 ТекСтр.КассаККМ= СтрВозврат.КассаККМ;
		 //ТекСтр.КассирПоУмолчанию= СтрВозврат.КассирПоУмолчанию;
	 Иначе              
		 ТекСтр.СуммаЧек = 0;
		 ТекСтр.КоличествоЧек = 0;
		 ТекСтр.КассаККМ = ПредопределенноеЗначение("Справочник.КассыККМ.ПустаяСсылка");
	 КонецЕсли; 
	 
КонецПроцедуры

&НаКлиенте
Процедура БонусыСписыватьПриИзменении(Элемент)
	
	//БонусыСписвать = ЭтаФОрма.СуммаБонусовДоступно;
	  //Olga
	Если  СуммаБонусовДоступно > 0 Тогда
		Если БонусыСписывать Тогда 
		  БонусыСписано = ?((СуммаБонусовДоступно - Остаток) > 0, Остаток, СуммаБонусовДоступно);
		  СуммаБонусовОстаток = СуммаБонусовДоступно - БонусыСписано;
		Иначе
		  БонусыСписано = 0;
		  СуммаБонусовОстаток = СуммаБонусовДоступно;
		КонецЕсли;
	КонецЕсли;
	
