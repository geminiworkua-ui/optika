
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Магазин 			= Параметры.Магазин;
	Номенклатура 		= Параметры.Номенклатура;
    Характеристика 		= Параметры.Характеристика; 
	Количество			= Параметры.Количество;
	
	// - М - структура с данными выбора по выбранной номенклатуре
	М = Параметры.М;
		
	ЗаполнитьСвободныеОстатки(М);
	
	ОстатокКЗаказу = Количество;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвободныеОстатки(М)
	
	Таблица.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СвободныеОстаткиОстатки.Склад КАК Магазин,
	|	ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0) КАК СвобОстаток
	|ПОМЕСТИТЬ вт_Остатки
	|ИЗ
	|	РегистрНакопления.СвободныеОстатки.Остатки(
	|			&Дата,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика) КАК СвободныеОстаткиОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	СвободныеОстаткиОстатки.Склад,
	|	ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	вт_Остатки.Магазин,
	|	вт_Остатки.СвобОстаток,
	|	0 КАК КоличествоВыбор,
	|	ЛОЖЬ КАК Выб
	|ИЗ
	|	вт_Остатки КАК вт_Остатки
	|ГДЕ
	|	вт_Остатки.СвобОстаток > 0";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	// - проставим параметры выбора, полученные из исходной формы.
	
	Для Инд = 0 по М.Количество() - 1 цикл
		
		П = М[Инд];
		иск_Номенклатура 			= неопределено;	
		иск_Характеристика			= неопределено;	
		иск_Количество     			= неопределено;
		иск_СкладИсточник           = неопределено;
		иск_Склад                   = неопределено;
		
		П.Свойство("Номенклатура", иск_Номенклатура);
		П.Свойство("Характеристика", иск_Характеристика);
		П.Свойство("КоличествоУпаковок", иск_Количество);
		П.Свойство("СкладИсточник", иск_СкладИсточник);
		Если 
			НЕ иск_СкладИсточник = Справочники.ВариантыИсточниковОбеспечения.ИзНаличия
            И
			НЕ иск_СкладИсточник = Справочники.ВариантыИсточниковОбеспечения.ПодЗаказ
            И
			ЗначениеЗаполнено(иск_СкладИсточник) 
			И 
			ЗначениеЗаполнено(иск_СкладИсточник.СкладИсточник)
			И
			НЕ иск_СкладИсточник.СкладИсточник = Магазин
			
			Тогда
			иск_Склад = иск_СкладИсточник.СкладИсточник;		
					
			Для каждого Стр из ТЗ цикл
				Если 
					Номенклатура = иск_Номенклатура
					И
					Характеристика = иск_Характеристика
					И
					Стр.Магазин = иск_Склад
					Тогда
					Стр.КоличествоВыбор = мин(Число(Стр.СвобОстаток),число(иск_Количество));
					Если 
						Стр.КоличествоВыбор > 0 Тогда
						Стр.Выб = Истина
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла; 
			
		ИначеЕсли	
			иск_СкладИсточник = Справочники.ВариантыИсточниковОбеспечения.ИзНаличия
			ИЛИ
			иск_СкладИсточник.СкладИсточник = Магазин			
			Тогда
					
			Для каждого Стр из ТЗ цикл
				Если 
					Номенклатура = иск_Номенклатура
					И
					Характеристика = иск_Характеристика
					И
					Стр.Магазин = Магазин
					
					Тогда
					СвобОстМагазин = Стр.СвобОстаток;
					КоличествоВыборМагазин = мин(Число(Стр.СвобОстаток),число(иск_Количество)); 
					Инд = тз.Индекс(Стр);
					ТЗ.Удалить(Инд);
					Если 
						КоличествоВыборМагазин > 0 
						Тогда
						ВыбНаличие = Истина
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла; 
            			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Для каждого Стр из ТЗ цикл
		Если Стр.Магазин = Магазин
			ТОгда
			СвобОстМагазин = Стр.СвобОстаток;
			Инд = тз.Индекс(Стр);
			ТЗ.Удалить(Инд);
		КонецЕсли;
	КонецЦикла;	
	
	Таблица.Загрузить(ТЗ);           	
КонецПроцедуры	

&НаКлиенте
Процедура ТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	
КонецПроцедуры


&НаКлиенте
Процедура ПересобратьИтоги()
	// Пересчитаем выбранное количество
	Выбрано = 0;
	Для каждого Стр из Таблица цикл
		
		Если Стр.КоличествоВыбор > 0 Тогда
			Выбрано = Выбрано + Стр.КоличествоВыбор;
		КонецЕсли;
	КонецЦикла;
	ВыбраноКоличество = Выбрано;	
	
	Если  Количество = ВыбраноКоличество 
		Тогда 	ВсеПодобрано = Истина
	Иначе   ВсеПодобрано = Ложь
	КонецЕсли;
	
	ОстатокКЗаказу =  Количество - ВыбраноКоличество - КоличествоВыборМагазин;
	
КонецПроцедуры	


&НаКлиенте
Процедура ТаблицаВыбПриИзменении(Элемент)
	
	ТекСтр = Элементы.Таблица.ТекущиеДанные;
	
	Если ТекСтр.Выб = Истина
		Тогда ТекСтр.КоличествоВыбор = Мин(ТекСтр.СвобОстаток,(Количество - ВыбраноКоличество - КоличествоВыборМагазин));
		Если ТекСтр.КоличествоВыбор = 0
			ТОгда
			ТекСтр.Выб = Ложь;
		КонецЕсли;
	ИначеЕсли ТекСтр.Выб = Ложь
		Тогда  ТекСтр.КоличествоВыбор = 0;
	КонецЕсли;
	
	ПересобратьИтоги();

	
КонецПроцедуры

&НаСервере
Функция ИсточникОбеспеченияПоСкладу(Склад)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВариантыИсточниковОбеспечения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВариантыИсточниковОбеспечения КАК ВариантыИсточниковОбеспечения
		|ГДЕ
		|	ВариантыИсточниковОбеспечения.СкладИсточник = &СкладИсточник";
	
	Запрос.УстановитьПараметр("СкладИсточник", Склад);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сп = Выборка.Ссылка
	КонецЕсли;
	
	Возврат Сп;

КонецФункции

&НаСервереБезКонтекста
Функция ИсточникОбеспеченияПоставщику()
    Возврат Справочники.ВариантыИсточниковОбеспечения.ПодЗаказ;
КонецФункции

&НаСервереБезКонтекста
Функция ИсточникОбеспеченияИзНаличия()
    Возврат Справочники.ВариантыИсточниковОбеспечения.ИзНаличия;
КонецФункции

&НаКлиенте
Процедура ПринятьЗакрыть(Команда)
	
	ПП = Новый Структура; 
	
	ПП.Вставить("Номенклатура", Номенклатура);
	ПП.Вставить("Характеристика", Характеристика); 
	
	// добавим всех из ТЧ
	М = Новый Массив;
	Для каждого Стр из Таблица цикл
		Если Стр.КоличествоВыбор > 0
			Тогда
			П = Новый Структура;
			П.Вставить("Склад", ИсточникОбеспеченияПоСкладу(Стр.Магазин));
			П.Вставить("Количество", Стр.КоличествоВыбор);
			М.Добавить(П);
		КонецЕсли;
	КонецЦикла;
	
	// Добавим если есть поставщику
	
	Если КоличествоВыборМагазин>0
		Тогда
		П = Новый Структура;
		П.Вставить("Склад", ИсточникОбеспеченияИзНаличия());
		П.Вставить("Количество", КоличествоВыборМагазин);
		М.Добавить(П);	
	КонецЕсли;
	
	Если ОстатокКЗаказу >0
		Тогда
		П = Новый Структура;
		П.Вставить("Склад", ИсточникОбеспеченияПоставщику());
		П.Вставить("Количество", ОстатокКЗаказу);
		М.Добавить(П);	
	КонецЕсли;
	
	
	ПП.Вставить("М", М);
	
	Закрыть(ПП);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыбНаличияПриИзменении(Элемент)
	
	Если ВыбНаличие = Ложь
		Тогда
		КоличествоВыборМагазин = 0
	ИначеЕсли
		ВыбНаличие = Истина
        И
		мин(ОстатокКЗаказу, СвобОстМагазин) > 0
		Тогда
		КоличествоВыборМагазин = мин(ОстатокКЗаказу, СвобОстМагазин)
	ИначеЕсли	
		ВыбНаличие = Истина
        И
		мин(ОстатокКЗаказу, СвобОстМагазин) = 0
		Тогда
		КоличествоВыборМагазин = 0;
		ВыбНаличие = Ложь
	КонецЕсли;
	
	ПересобратьИтоги();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПересобратьИтоги();
КонецПроцедуры
