Процедура ОтправитьНоменклатуруУслуг(Отказ)
	
	Для Каждого Сайт Из МассивУзловОбмена() Цикл
		
		ПолныйОбмен = ?(ВариантВыгрузки = 2, Истина, Ложь);
		
		Если Сайт.Пустая() Тогда
			Возврат;
		КонецЕсли;
		
		Узел = Сайт;               
		ТипДанных = "ListOfMedService";        
		СписокУдаления = Новый Массив;
		МассивПакета = ОбменСайт.ПолучитьСписокУслуг(Узел);		
		
			СтруктураОтправки = Новый Структура();   
			СтруктураОтправки = ОбменСайт.СформироватьДанныеОчки(ТипДанных, МассивПакета, Сайт);
			ОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Сайт, ТипДанных, "", СписокУдаления, Отказ);
			Если Не Отказ Тогда
				Возврат;
			КонецЕсли;	
	
	КонецЦикла;
	
КонецПроцедуры


Процедура ОтправитьВрачиНаСервере(Отказ) 
	Для Каждого Сайт Из МассивУзловОбмена() Цикл

	ПолныйОбмен = ?(ВариантВыгрузки = 2, Истина, Ложь);
	
	Если Сайт.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Узел = Сайт;               
	ТипДанных = "Doctors";        
	СписокУдаления = Новый Массив;
	Данные = ОбменСайт.ПолучитьВрачей(ПолныйОбмен, Узел, СписокУдаления);		
	РазмерМассива = Данные.Количество();      
	Если РазмерМассива = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КоличПакетов = Окр(Данные.Количество() / Узел.ШагОтправкиЦены,0, РежимОкругления.Окр15как20);  
	
	Если КоличПакетов = 0 Тогда
		КоличПакетов =1;
	КонецЕсли;
	
	Для НомерПакета = 0 по КоличПакетов-1 цикл
		МассивПакета =СформироватьПакет(НомерПакета, Данные, РазмерМассива, ТипДанных);
		СтруктураОтправки = Новый Структура();   
		СтруктураОтправки = ОбменСайт.СформироватьДанныеОчки(ТипДанных, МассивПакета, Сайт);
		ОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Сайт, ТипДанных, "", СписокУдаления, Отказ);
		Если Не Отказ Тогда
			Возврат;
		КонецЕсли;	
	КонецЦикла; 
	КонецЦикла;
КонецПроцедуры  

