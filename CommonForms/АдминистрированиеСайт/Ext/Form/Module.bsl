Функция СформироватьПакет(НомерПакета, Данные, РазмерМассива, ТипДанных)
МассивПакета = Новый Массив;   
Если ТипДанных = "RestNomenclature" Тогда
	ШагОтправки = Сайт.ШагОтправкиОстатки;
ИначеЕсли ТипДанных = "PriceNomenclature" Тогда
	ШагОтправки = Сайт.ШагОтправкиЦены;
ИначеЕсли ТипДанных = "NomenclaturePicture" Тогда
	ШагОтправки = Сайт.ШагОтправкиКартинки;
ИначеЕсли ТипДанных = "Nomenclature" Тогда
	ШагОтправки = Сайт.ШагОтправкиОписание;	
ИначеЕсли ТипДанных = "WorkTime" Тогда
	ШагОтправки = 1000;	
Иначе
	ШагОтправки = Сайт.ШагОтправкиВсе;
КонецЕсли;

Для Инд = НомерПакета*ШагОтправки по мин((НомерПакета+1)*ШагОтправки-1, РазмерМассива-1) 	Цикл
	МассивПакета.Добавить(Данные[Инд]); 
КонецЦикла;

Возврат МассивПакета;
КонецФункции	

