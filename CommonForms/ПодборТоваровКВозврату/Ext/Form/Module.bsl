Процедура ПолучитьЗначениеКассовойСмены(ЧекВозврат, Отказ)
	Отказ  =Ложь;
	Запрос  = Новый Запрос(
	 "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	 |	КассоваяСмена.Ссылка
	 |ИЗ
	 |	Документ.КассоваяСмена КАК КассоваяСмена
	 |ГДЕ
	 |	КассоваяСмена.КассаККМ = &КассаККМ
	 |	И КассоваяСмена.СтатусКассовойСмены = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
	 |	И КассоваяСмена.Дата > &Дата
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	КассоваяСмена.НачалоКассовойСмены УБЫВ");   
	Запрос.УстановитьПараметр("КассаККМ", ЧекВозврат.КассаККМ);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		ЧекВозврат.КассоваяСмена = Результат.ссылка;
		Возврат;
	КонецЕсли;
	Отказ = Истина;
КонецПроцедуры	 


&НаКлиенте
Процедура ОстаткиКОплатеВозвращаемПриИзменении(Элемент)
	 ТекСтр = Элементы.ОстаткиКОплате.ТекущиеДанные;
	 
	 Если ТекСтр.Возвращаем Тогда 
		 ТекСтр.СуммаВозврат = ТекСтр.СуммаРеализации; 
		 ТекСтр.КоличествоВозврат = ТекСтр.КоличествоРеализации;
	 Иначе              
		 ТекСтр.СуммаВозврат  = 0;
		 ТекСтр.КоличествоВозврат = 0;
	 КонецЕсли;
	 
	 РасчетИтогов()	 
КонецПроцедуры


&НаКлиенте
Процедура ОстаткиКОплатеКоличествоВозвратПриИзменении(Элемент)
	ТекСтр = ЭтаФорма.Элементы.ОстаткиКОплате.ТекущиеДанные;	 
	Если ТекСтр.КоличествоВозврат >ТекСтр.КоличествоРеализаци Тогда
		 ТекСтр.КоличествоВозврат = ТекСтр.КоличествоРеализаци;
	Иначе	 
		Если ТекСтр.Цена > 0 Тогда                                                            
			СуммаВозврат = ТекСтр.СуммаРеализации - (ТекСтр.цена*ТекСтр.КоличествоВозврат); 
			ТекСтр.СуммаВозврат =?(СуммаВозврат>=0, СуммаВозврат, ТекСтр.СуммаРеализации);   		
			ТекСтр.КоличествоВозврат = ?(СуммаВозврат>=0, ТекСтр.КоличествоВозврат, ТекСтр.КоличествоРеализации);
		Иначе
			ТекСтр.СуммаВозврат =0;
		КонецЕсли;
	 КонецЕсли;
	РасчетИтогов();
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиКОплатеСуммаВозвратПриИзменении(Элемент)
	ТекСтр = ЭтаФорма.Элементы.ОстаткиКОплате.ТекущиеДанные;	 
	Если ТекСтр.СуммаВозврат > ТекСтр.СуммаРеализации Тогда  
		Если ТекСтр.Цена > 0 Тогда 
			ТекСтр.СуммаВозврат = ТекСтр.СуммаРеализации - (ТекСтр.цена*ТекСтр.КоличествоВозврат); 
		КонецЕсли;
	Иначе
		Если ТекСтр.Цена > 0 Тогда 
			ТекСтр.КоличествоВозврат = ТекСтр.СуммаВозврат/ТекСтр.цена; 
		Иначе
			ТекСтр.КоличествоВозврат = 0;
		КонецЕсли;
     КонецЕсли;
	РасчетИтогов();
КонецПроцедуры


