&НаКлиенте
Процедура ПринятьЗакрыть(Команда)  

	// ++ Боков Проверим, что по строкам, где указан возврат заполнена причина возврата
	ЕстьОшибки = Ложь;
	Если ТипВозврата = "ВозвратТоваров" ТОгда
		
		Для каждого Стр из ОстаткиКВозврату цикл
			Если Стр.Возвращаем
				И
				Не ЗначениеЗаполнено(Стр.ПричинаВозврата)
				ТОгда
				Текст = "Для товару " + Строка(Стр.Номенклатура) + " " +  Строка(Стр.Характеристика) + " не визначена причина повернення!";
				Сообщить(СокрЛП(Текст));  
				ЕстьОшибки = Истина;
			КонецЕсли;
		КонецЦикла;  
	КонецЕсли;
	
	ЕстьПозицииКВозврату = Ложь;
	Для каждого Стр из ОстаткиКВозврату цикл
		Если Стр.Возвращаем ТОгда
			ЕстьПозицииКВозврату = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьПозицииКВозврату Тогда
		Текст = "Не визначено жодної позиції до повернення";
		Сообщить(СокрЛП(Текст));  
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки
		ТОгда
		
		// -- Боков
		
		РаспределитьПоВозврату();
		Если Не Незакрывать Тогда 
			СтрЗакрытия = Новый Структура;
			СтрЗакрытия.Вставить("ТаблицаДокументов", ВыгрузитьДокументы());
			СтрЗакрытия.Вставить("СообщенияОбработки", ВыгрузитьСообщенияОбработки());  
			
			Закрыть(СтрЗакрытия);    
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВыгрузитьСообщенияОбработки()
	Возврат ДокументыВозврата.Выгрузить().ВыгрузитьКолонку("СообщенияОбработки");
КонецФункции

Функция ВыгрузитьДокументы()
	Возврат ДокументыВозврата.Выгрузить().ВыгрузитьКолонку("ДокументВозврата");
КонецФункции


Процедура РаспределитьПоВозврату()
	Если ТипВозврата ="ВозвратТоваров" Тогда
		СоздатьДокументыВозврата();
	ИначеЕсли ТипВозврата = "ВозвратОплаты" Тогда
		СоздатьЧекиВозврата();
	Конецесли;
КонецПроцедуры

Процедура СоздатьДокументыВозврата()   
	Отказ = Ложь;
	Для Каждого Стр из ДокументыВозврата Цикл
		СтрПоиска=Новый Структура;
		СтрПоиска.Вставить("ДокументРеализации", стр.ДокументРеализации);
		СтрПоиска.Вставить("Возвращаем", Истина); 
		Строки = ОстаткиКВозврату.НайтиСтроки(СтрПоиска);
		Если Не Строки.Количество()=0 Тогда
		      СоздатьДокументВозврат(Стр, Строки, Отказ);  
			  Если Отказ Тогда
				  НеЗакрывать = Истина;
				  Возврат;
			  КонецЕсли;  
		КонецЕсли; 	  
	КонецЦикла;	  
КонецПроцедуры	

Процедура СоздатьДокументВозврат(СтрокаДокументов, СтрокиТоваров, Отказ)
	
	ДокВозврат = Документы.ВозвратТоваровОтКлиента.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ДокВозврат, СтрокаДокументов.ДокументРеализации);
	ДокВозврат.Дата = ТекущаяДата();
	ДокВозврат.ДокументРеализации = СтрокаДокументов.ДокументРеализации;
	ДокВозврат.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	ДокВозврат.ПричинаВозврата = "Відмова клієнта";  
	Для каждого Стр Из СтрокиТоваров Цикл
		СтрТов = ДокВозврат.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТов, Стр); 
		СтрТов.Количество = Стр.КоличествоВозврат;
		СтрТов.КоличествоУпаковок = Стр.КоличествоВозврат;
		СтрТов.Сумма = стр.СуммаВозврат;   
		// ++ Боков А.А. 25.08.2025 
		СтрТов.ПричинаВозврата = Стр.ПричинаВозврата;
		// -- Боков А.А.
		СтрТов.АналитикаУчетаНоменклатуры = РегистрыСведений.АналитикаУчетаНоменклатуры.ЗначениеКлючаАналитики(ПараметрыАналитики(Стр, ДокВозврат.Склад));
		СтавкаНДСЧИслом = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(СтрТов.СтавкаНДС);
		ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрТов.Сумма, СтавкаНДСЧИслом ,ДокВозврат.ЦенаВключаетНДС);
	КонецЦикла; 
	
	Если Не ДокВозврат.Товары.Количество() = 0	 Тогда
		// ++ Боков механизм клиент сервера не срабатывает
		//ДокВозврат.СуммаДокумента = ЦенообразованиеКлиентСервер.ПолучитьСуммуДокумента(ДокВозврат.Товары, ДокВозврат.ЦенаВключаетНДС);	
		ДокВозврат.СуммаДокумента = ДокВозврат.Товары.Итог("Сумма");  
		// -- Боков
		
		ДокВозврат.Номер ="";
		ДокВозврат.Записать(РежимЗаписиДокумента.Проведение);                         
		//СтрокаДокументов.СообщенияОбработки ="За документом "+Строка(СтрокаДокументов.ДокументРеализации) + " оформлено повернення товарів " +Строка(ДокВозврат.Ссылка); 
		СтрокаДокументов.ДокументВозврата= ДокВозврат.Ссылка;  
	Иначе
		//СтрокаДокументов.СообщенияОбработки ="За документом "+Строка(СтрокаДокументов.ДокументРеализации) + " не оформлено поверненя"; 
	КонецЕсли;		

КонецПроцедуры	

Функция ПараметрыАналитики(Стр, Склад)
ПараметрыАналитики = Новый Структура;
ПараметрыАналитики.Вставить("Номенклатура", Стр.Номенклатура);
ПараметрыАналитики.Вставить("Характеристика", Стр.Характеристика); 
ПараметрыАналитики.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка()); 
ПараметрыАналитики.Вставить("Склад", Склад);
Возврат ПараметрыАналитики; 
КонецФункции	

Процедура СоздатьЧекиВозврата()                         
   Отказ = Ложь;	
   Для Каждого Стр из ДокументыВозврата Цикл
		СтрПоиска=Новый Структура;
		СтрПоиска.Вставить("ДокументРеализации", стр.ДокументРеализации);
		СтрПоиска.Вставить("Возвращаем", Истина); 
		Строки = ОстаткиКВозврату.НайтиСтроки(СтрПоиска);
		Если Не Строки.Количество()=0 Тогда
		      СоздатьДокументЧекВозврат(Стр, Строки, Отказ);    
			  Если Отказ Тогда 
				  НеЗакрывать = Истина;
				  Возврат;
			  Конецесли;	  
		КонецЕсли;
	КонецЦикла;	  

КонецПроцедуры	

Процедура СоздатьДокументЧекВозврат(СтрокаДокументов, СтрокиТоваров,Отказ)
	
	Док = Документы.ЧекККМВозврат.СоздатьДокумент(); 
	ЗаполнитьЗначенияСвойств(Док, СтрокаДокументов.ДокументРеализации);
	Док.Дата = ТекущаяДата();   
	
	Док.Статус = Перечисления.СтатусыЧековККМ.Отложен;
	Док.ДокументОснование = ЗаказКлиента;   
	Док.Номер ="";
	Док.ДокументОснование =  ЗаказКлиента;
	док.ЧекККМ =СтрокаДокументов.ДокументРеализации; 
	Для каждого Строка из СтрокиТоваров Цикл     
		Если Строка.Возвращаем Тогда
			СтрТов = Док.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТов, Строка); 
			СтрТов.Количество = Строка.КоличествоВозврат;
			СтрТов.КоличествоУпаковок = Строка.КоличествоВозврат;   
			СтрТов.Сумма = Строка.СуммаВозврат;
			СтавкаНДСЧИслом = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(СтрТов.СтавкаНДС);
			ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрТов.Сумма, СтавкаНДСЧИслом ,Док.ЦенаВключаетНДС);
		КонецЕсли;
	КонецЦикла; 
	
	Если Не Док.Товары.Количество() = 0	 Тогда
		Док.СуммаДокумента = ЦенообразованиеКлиентСервер.ПолучитьСуммуДокумента(Док.Товары, Док.ЦенаВключаетНДС);
		ПолучитьЗначениеКассовойСмены(Док, Отказ); 
		Если Отказ Тогда
			Сообщить("За касою " + Строка(Док.КассаККМ) + " не відкрито косової зміни. Оформлити документи поверння оплати не можливо");
			Возврат; 
		КонецЕсли;	
		
		ПроверкаНаНаличиеДенегВКассеККМ(Док, Отказ);  
		
		Если Отказ Тогда   
			Сообщить("В касі " + Строка(Док.КассаККМ) + " не має коштів. Оформлити документи поверння оплати не можливо");
			Возврат; 
		КонецЕсли;	
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		СтрокаДокументов.ДокументВозврата= Док.Ссылка;     
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПроверкаНаНаличиеДенегВКассеККМ(ЧекВозврат, Отказ)
	
	Если ЧекВозврат.КассаККМ.БезПроверкиОстаткаПриВозврате Тогда
		Возврат;
	КонецЕсли;	
	
	Запрос =Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДенежныеСредстваВКассахККМОстатки.СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваВКассахККМ.Остатки(&Дата, КассаККМ = &КассаККМ) КАК ДенежныеСредстваВКассахККМОстатки");
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("КассаККМ", ЧекВозврат.КассаККМ);
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Остаток = Результат.СуммаОстаток;
	Иначе Остаток =0;
	Конецесли;
	
	Если ЧекВозврат.СуммаДокумента > Остаток Тогда
		Отказ = Истина;
	Иначе
		Отказ = Ложь;
	КонецЕсли;	
	
КонецПроцедуры	


&НаСервере
Функция ПолучитьКассыРМК()

	 УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
"ВЫБРАТЬ
|	НастройкиРМККассыККМ.КассаККМ
|ИЗ
|	Справочник.НастройкиРМК.КассыККМ КАК НастройкиРМККассыККМ
|ГДЕ
|	НастройкиРМККассыККМ.Ссылка.РабочееМесто = &РабочееМесто");
Запрос.УстановитьПараметр("РабочееМесто", ПараметрыСеанса.РабочееМестоКлиента);
Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КассаККМ");
Возврат Результат;	
КонецФункции

&НаСервере
Функция РаспределитьПоЧекам(Заказ)
МассивЧеков = Новый Массив;
КассыРМК = ПолучитьКассыРМК();
Для Каждого КассаРМК из КассыРМК Цикл 
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("КассаККМ", КассаРМК);
	СтруктураПоиска.Вставить("Платим", Истина);
	
	НайденныеСтроки = ОстаткиКВозврату.НайтиСтроки(СтруктураПоиска);	
	ЧекПоТоварам = СоздатьЧекПоОтбору(НайденныеСтроки, Заказ);
	Если Не ЧекПоТоварам = Неопределено и Не ЧекПоТоварам = Документы.ЧекККМ.ПустаяСсылка() Тогда	
		МассивЧеков.Добавить(ЧекПоТоварам);
	КонецЕсли;
КонецЦикла;
Возврат  МассивЧеков;
КонецФункции	

&НаСервере
Функция СоздатьЧекПоОтбору(СтрокиЗаказа, Заказ)
	
	УстановитьПривилегированныйРежим(Истина);

	НовыйЧек = Документы.ЧекККМ.СоздатьДокумент();  
	Если СтрокиЗаказа.Количество()=0 Тогда
		Возврат Неопределено;
	КОнецЕсли;	 
	КассаККМ = СтрокиЗаказа[0].КассаККМ;
	НовыйЧек.ДокументОснование = Заказ;
	НовыйЧек.НомерЧекаККМ = "";
	НовыйЧек.Архивный = Ложь;
	НовыйЧек.Статус = Неопределено;
	
	НовыйЧек.ПолученоНаличными = 0;
	
	СостояниеКассовойСмены = РозничныеПродажи.ПолучитьСостояниеКассовойСмены(КассаККМ);
	ЗаполнитьЗначенияСвойств(НовыйЧек, СостояниеКассовойСмены);
	
	
	Для каждого Стр из СтрокиЗаказа Цикл
		СтрТЧ =НовыйЧек.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТЧ, Стр);  
		СтрТЧ.Количество = Стр.КоличествоЧек;
		СтрТЧ.КоличествоУпаковок = Стр.КоличествоЧек;
		СтрТЧ.Цена = Стр.Цена;
		СтрТЧ.Сумма = Стр.СуммаЧек;
		СтрТЧ.Штрихкод = ЗаполнитьШтрихкод(Стр.Номенклатура, Стр.Характеристика);
		СтрТЧ.СуммаБонусныхБалловКСписанию = 0;
		СтрТЧ.СуммаБонусныхБалловКСписаниюВВалюте = 0; 
		СтрТЧ.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		Если СтрТЧ.продавец = Справочники.Пользователи.ПустаяСсылка() Тогда
			СтрТЧ.продавец = Заказ.Менеджер;
		КонецЕсли;	 
	КонецЦикла;	 
	
	Для каждого Стр из Заказ.скидкиНаценки Цикл
		СтрТЧ =НовыйЧек.СкидкиНаценки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТЧ, Стр);
	КонецЦикла;	 
	
	если НовыйЧек.СкидкиНаценки.Количество()=0
		Тогда
		НовыйЧек.СкидкиРассчитаны = Ложь;
	Иначе
		НовыйЧек.СкидкиРассчитаны = Истина;
	КонецЕсли;	 
	НовыйЧек.ДокументОснование = Заказ;
	НовыйЧек.Партнер = Заказ.Партнер;                
	НовыйЧек.Организация = КассаККМ.Владелец;
	НовыйЧек.КартаЛояльности = Заказ.КартаЛояльности;
	НовыйЧек.СуммаДокумента = Заказ.СуммаДокумента;  
	НовыйЧек.Статус = Перечисления.СтатусыЧековККМ.ТоварЗарезервирован;
	НовыйЧек.Дата = ТекущаяДата();
	НовыйЧек.Записать(РежимЗаписиДокумента.Проведение);
	Возврат НовыйЧек.Ссылка;
КонецФункции
 
 &НаСервере
 Функция ЗаполнитьШтрихкод(Номенклатура, Характеристика)
	 Если Характеристика = справочники.ХарактеристикиНоменклатуры.ПустаяСсылка() Или
		 Характеристика = Неопределено Тогда
		 
		 Запрос	= Новый Запрос(
		 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	ШтрихкодыНоменклатуры.Штрихкод
		 |ИЗ
		 |	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		 |ГДЕ
		 |	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура");
		 Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		 Рез =Запрос.Выполнить().Выбрать();
