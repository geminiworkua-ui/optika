Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	
КонецПроцедуры


&НаКлиенте
Процедура ВыбратьЗакрыть(Команда)
	
	П = Новый Структура;
	П.Вставить("Карточка",ВыборКарточки);
	П.Вставить("НомерСтроки", ВыбранныйНомерСтроки);
	ЭтаФорма.Закрыть(П);	
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.СписокКоллекцияРецептов.Параметры.УстановитьЗначениеПараметра("Пациент", Параметры.Пациент);
		
	
КонецПроцедуры


&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ТекСтр = Элементы.СписокКоллекцияРецептов.ТекущиеДанные;
	
	Если НЕ ТекСтр = неопределено
		Тогда
		ВыборКарточки = ТекСтр.Карточка; 
		ВыбранныйНомерСтроки = ТекСтр.НомерСтроки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СтрокаВструктуру(Карточка, НомерСтроки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КарточкаПациентаНазначенияОчки.Ссылка,
		|	КарточкаПациентаНазначенияОчки.НомерСтроки,
		|	КарточкаПациентаНазначенияОчки.ВидНазначения,
		|	КарточкаПациентаНазначенияОчки.Комментарий,
		|	КарточкаПациентаНазначенияОчки.OD_sph,
		|	КарточкаПациентаНазначенияОчки.OS_sph,
		|	КарточкаПациентаНазначенияОчки.OD_cyl,
		|	КарточкаПациентаНазначенияОчки.OS_cyl,
		|	КарточкаПациентаНазначенияОчки.OD_ax,
		|	КарточкаПациентаНазначенияОчки.OS_ax,
		|	КарточкаПациентаНазначенияОчки.OD_ADD,
		|	КарточкаПациентаНазначенияОчки.OS_ADD,
		|	КарточкаПациентаНазначенияОчки.OD_PDR,
		|	КарточкаПациентаНазначенияОчки.OS_PDL,
		|	КарточкаПациентаНазначенияОчки.OD_инсет,
		|	КарточкаПациентаНазначенияОчки.OS_инсет,
		|	КарточкаПациентаНазначенияОчки.OD_ВС,
		|	КарточкаПациентаНазначенияОчки.OS_ВС,
		|	КарточкаПациентаНазначенияОчки.OD_visus,
		|	КарточкаПациентаНазначенияОчки.OS_visus,
		|	КарточкаПациентаНазначенияОчки.Бинокулярно,
		|	КарточкаПациентаНазначенияОчки.Представление
		|ИЗ
		|	Документ.КарточкаПациента.НазначенияОчки КАК КарточкаПациентаНазначенияОчки
		|ГДЕ
		|	КарточкаПациентаНазначенияОчки.Ссылка.Ссылка = &Карточка
		|	И КарточкаПациентаНазначенияОчки.НомерСтроки = &НомерСтроки";
	
	Запрос.УстановитьПараметр("Карточка", Карточка);
	Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	ПП = Новый Структура;
	ПП = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТЗ[0]);
	Возврат ПП;

КонецФункции


&НаКлиенте
Процедура СписокКоллекцияРецептовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтр = Элементы.СписокКоллекцияРецептов.ТекущиеДанные;
	
	Если НЕ ТекСтр = неопределено
		Тогда
		Карточка = ТекСтр.Карточка; 
		НомерСтроки = ТекСтр.НомерСтроки;
		П = СтрокаВструктуру(Карточка, НомерСтроки);
	
		ЭтаФорма.Закрыть(П); 
		
	КонецЕсли;
	
КонецПроцедуры

