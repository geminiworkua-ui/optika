Функция ЗначениеМодели()  
	Для каждого Стр из Элементы.Модель.СписокВыбора Цикл
		Если СТр.Представление = МодельПредставление Тогда
			Возврат Стр.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Элементы.Модель.СписокВыбора[0].Значение;
КонецФункции	

&НаКлиенте
Процедура ТестУстройства(Команда)

		РезультатТеста    = Неопределено;

	ВходныеПараметры  = Неопределено;
	ВыходныеПараметры = Неопределено;

	времПараметрыУстройства = Новый Структура();
	времПараметрыУстройства.Вставить("ТипСоединения"             , ТипСоединения);
	времПараметрыУстройства.Вставить("IP"                        , IP);
	времПараметрыУстройства.Вставить("ПортIP"                    , ПортIP);
	времПараметрыУстройства.Вставить("Порт"                      , Порт);
	времПараметрыУстройства.Вставить("Скорость"                  , Скорость);
	времПараметрыУстройства.Вставить("Модель"                    , Модель);
	времПараметрыУстройства.Вставить("МерчантИД"                 , МерчантИД);

	времПараметрыУстройства.Вставить("ТаблицаСоответствийНалоговыхГрупп", ПолучитьПараметрыИзТаблицыСоответствий());


	АктивированДемоРежим = "";
	Dest = "";
	
	Если  ТипСоединения = 0 Тогда
		
		Dest = "COM"+Строка(Порт);
		
	ИначеЕсли ТипСоединения =1 Тогда

		Dest = СокрЛП(IP);
	иначе
		Dest = "demo";
		АктивированДемоРежим = "Активовано"
	КонецЕсли;	
			
	//ВыходныеПараметры = Новый Структура;
    ПараметрыПодключения = Новый Структура;
    Ответ = ПодключаемоеОборудованиеВебЧек.ТестУстройства(,времПараметрыУстройства,ПараметрыПодключения,ВыходныеПараметры);

	Если Ответ Тогда
			РезультатТеста = НСтр("ru = 'Присоединен банковский терминал: '; uk = 'Під''єднано банківський термінал: '")+ВыходныеПараметры[1] +" "+ВыходныеПараметры[2] +НСтр("ru = ' по интерфейсу  '; uk = ' по інтерфейсу  '") + Dest; 
	Иначе
		Результат = Ложь;
			РезультатТеста = Нстр("ru = 'Ошибка подключения устройства по интерфейсу '; uk = 'Помилка під''єднання присторою по інтерфейсу '""Помилка під'єднання присторою по інтерфейсу  ") +Dest;
	КонецЕсли;


	ТекстСообщения = РезультатТеста;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);

КонецПроцедуры

 &НаКлиенте	
Функция ВыполнитьКомандуЭкв(Объект,Команда,ВходныеПараметры = неопределено) Экспорт
	ПЕРЕМ РезультатВыполнения,ВыходныеПараметры;
	
	СтруктураПараметров = Новый Структура("Результат, ВыходныеПараметры,ВходныеПараметры,Команда", РезультатВыполнения, ВыходныеПараметры,ВходныеПараметры,Команда);
	ОбработатьРезультатВыполненияПоследнейКомандыЭкв (Объект,СтруктураПараметров);
	Возврат СтруктураПараметров;
КонецФункции

&НаКлиенте
Функция СоздатьОбъектЭкв (Параметры =неопределено) 
	Экспорт
	ПЕрем Драйвер;
	
	Попытка
		Драйвер =  Новый COMОбъект("WebCheck.ClassCardserv");	
		
		Сообщить("Підключено WebCheck.ClassCardserv");
		Параметры =  Новый Структура("FN,MerchantID,Dest,type","","","","");
		ОбъектЕкв = Новый Структура("Драйвер,ПараметрыЭкв",Драйвер,Параметры);
		мФРОбъектСоздан = Истина;
		
	Исключение		
		Сообщить("Помилка підключення компоненти WebCheck.ClassCardserv, оновить ПРРО.");
	КонецПопытки;
	Возврат ОбъектЕкв;
КонецФункции

&НаКлиенте	
Функция ОбработатьРезультатВыполненияПоследнейКомандыЭкв (Объект,СтруктураРезультата) Экспорт
	перем СтрокаXML;
	СтруктураРезультата.Результат = Истина;
	ОтветФРБулево = ложь;		
	СтрокаXML = ПолучитьXMLкомандыЭкв(Объект,СтруктураРезультата);
	СтрокаXMLОтвет = "";
	Если СтруктураРезультата.Команда = "purchase" или СтруктураРезультата.Команда = "refund"  или СтруктураРезультата.Команда = "cashback" или СтруктураРезультата.Команда = "audit" или СтруктураРезультата.Команда = "verify" или СтруктураРезультата.Команда = "identify" или СтруктураРезультата.Команда = "getMerchantList" или СтруктураРезультата.Команда = "withdrawal"   Тогда
		ОтветФРБулево=Объект.Драйвер.CardServ(СтрокаXML);	
		СтрокаXMLОтвет = Объект.Драйвер.StatusBarXML();
	КонецЕсли;	
	
	Если не ОтветФРБулево Тогда
		СтруктураРезультата.Результат = Ложь;
	КонецЕсли;	
	
	СтруктураПараметров = Новый Структура;	
	
	Если СтрДлина(СтрокаXMLОтвет)=0 Тогда
		
		Сообщить("Помилка !!!!!!!!!!!!!!!!!");
		Сообщить("Відповідь пристрою" +ОтветФРБулево );	
		Сообщить("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!");
		
	КонецЕсли;	
	
	
	
	
	//Сообщить("начало ответ регистратора "+ СтруктураРезультата.Команда);
	//сообщить(СтрокаXMLОтвет);
	//сообщить("Конец ответ регистратора "+ СтруктураРезультата.Команда);
	//
	Если СтрДлина(СтрокаXMLОтвет)>0 Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXMLОтвет);
		//ЧтениеXML.ПерейтиКСодержимому();
		
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.Имя = "Parameters" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда  
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					СтруктураПараметров.Вставить(ЧтениеXML.Имя,ЧтениеXML.Значение);	
				КонецЦикла;	
			КонецЕсли;
		КонецЦикла;	
		СтруктураПараметров.Вставить("err","0");
		
		
		СтруктураРезультата.ВыходныеПараметры = СтруктураПараметров;
	КонецЕсли;
	
	возврат 0;	
КонецФункции 

&НаКлиенте	
Функция ПолучитьXMLкомандыЭкв(Объект,СтруктураКоманды)	
	СтрокаКоманда = СтруктураКоманды.Команда;	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("InputParameters");
	ЗаписьXML.ЗаписатьНачалоЭлемента("Parameters");
	ЗаписьXML.ЗаписатьАтрибут("type" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметры.type));
	ЗаписьXML.ЗаписатьАтрибут("dest" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметры.dest));
	ЗаписьXML.ЗаписатьАтрибут("merchantid" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметры.merchantid));
	
	
	
	Если СтрокаКоманда ="purchase"  Тогда
		ЗаписьXML.ЗаписатьАтрибут("amount" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметры.amount));
		ЗаписьXML.ЗаписатьАтрибут("submerchant" ,  "");
		ЗаписьXML.ЗаписатьАтрибут("method" ,  XMLСтрока("purchase"));
		
		
	иначеесли СтрокаКоманда ="refund"   Тогда
		ЗаписьXML.ЗаписатьАтрибут("amount" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметры.amount));
		ЗаписьXML.ЗаписатьАтрибут("RRN" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметры.СтрокаRRN));
		ЗаписьXML.ЗаписатьАтрибут("submerchant" ,  XMLСтрока(""));
		ЗаписьXML.ЗаписатьАтрибут("method" ,  XMLСтрока("refund"));
		
	иначеесли СтрокаКоманда ="withdrawal"   Тогда
		ЗаписьXML.ЗаписатьАтрибут("invoicenumber" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметры.invoicenumber));
		ЗаписьXML.ЗаписатьАтрибут("method" ,  XMLСтрока("withdrawal"));
		
	иначеесли СтрокаКоманда ="cashback"  Тогда
		ЗаписьXML.ЗаписатьАтрибут("amount" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметры.amount));
		ЗаписьXML.ЗаписатьАтрибут("amountCash" ,  XMLСтрока(СтруктураКоманды.ВходныеПараметры.amountCash));
		ЗаписьXML.ЗаписатьАтрибут("submerchant" ,  XMLСтрока(""));
		ЗаписьXML.ЗаписатьАтрибут("method" ,  XMLСтрока("Cashback"));		
	иначеесли СтрокаКоманда ="audit"  Тогда		
		ЗаписьXML.ЗаписатьАтрибут("method" ,  XMLСтрока("audit"));				
	иначеесли СтрокаКоманда ="identify"  Тогда
		ЗаписьXML.ЗаписатьАтрибут("method" ,  XMLСтрока("identify"));
	иначеесли СтрокаКоманда ="getMerchantList"  Тогда
		ЗаписьXML.ЗаписатьАтрибут("method" ,  XMLСтрока("getmerchantlist"));		
	иначеесли СтрокаКоманда ="verify"  Тогда
		ЗаписьXML.ЗаписатьАтрибут("method" ,  XMLСтрока("verify"));
	КонецЕсли;		
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	Возврат ЗаписьXML.Закрыть();	
КонецФункции


