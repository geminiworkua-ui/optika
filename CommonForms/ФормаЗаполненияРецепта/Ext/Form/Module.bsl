
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтаФорма.Пациент = Параметры.Пациент;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОповещение7(Результат, ДополнительныеПараметры) Экспорт
	
	Если  Результат = неопределено
		ТОгда
		
		Сообщить("Немає даних для заповнення");
		Иначе
			ЗаполнитьПараметрыРецепта(Результат);
			НастроитьВидимостьПолейРецепта();		
		КонецЕсли;
		
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыРецепта(Результат)
	Если ЗначениеЗаполнено(Результат) Тогда
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыРецептаНаОчки(Команда)
	
    П = Новый Структура;
	П.Вставить("Пациент", ЭтаФорма.Пациент);
	ОписаниеОповещения7  = Новый ОписаниеОповещения("ВыполнитьОповещение7",ЭтотОбъект);
	ОткрытьФорму( "ОбщаяФорма.ФормаВыбораРецептаНаОчки", П,ЭтаФорма,,,,ОписаниеОповещения7,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПрименить(Команда)

	П = Новый Структура;
	
	П.Вставить("ВидНазначения", ВидНазначения );
	
	П.Вставить("OD_sph", 	OD_sph   );
	П.Вставить("OD_cyl", 	OD_cyl   );	
	П.Вставить("OD_ax",  	OD_ax    );	
	П.Вставить("OD_ADD", 	OD_ADD   );
	П.Вставить("OD_PDR", 	OD_PDR	 );	
	П.Вставить("OD_инсет", 	OD_инсет );
	П.Вставить("OD_ВС", 	OD_ВС	 );
		
	П.Вставить("OS_sph", 	OS_sph	 );
	П.Вставить("OD_cyl", 	OD_cyl   );
	П.Вставить("OS_ax", 	OS_ax	 );	
	П.Вставить("OS_ADD", 	OS_ADD   );
	П.Вставить("OS_PDL", 	OS_PDL   );
    П.Вставить("OS_инсет", 	OS_инсет );
    П.Вставить("OS_ВС", 	OS_ВС    );
	
	П.Вставить("НазначениеОчки_DP",  НазначениеОчки_DP      );
	П.Вставить("НазначениеОчки_CVD", НазначениеОчки_CVD     );
	П.Вставить("НазначениеОчки_PT",  НазначениеОчки_PT      );
	П.Вставить("НазначениеОчки_FFA", НазначениеОчки_FFA     );
	П.Вставить("НазначениеОчкиКомментарий", НазначениеОчкиКомментарий   );
	П.Вставить("КомментарийКЗаказуНаОчки",КомментарийКЗаказуНаОчки    );
	
	П.Вставить("СтороннийВрач", СтороннийВрач);
	
	ЭтаФорма.Закрыть(П);
	
КонецПроцедуры


&НаСервере
Функция ПолучитьВидНазначения(ВидНазначения)
	
	Если 
		ВидНазначения = Перечисления.ВидыНазначенийОчкиЛинзы.ОчкиДляДали
		Тогда 
		Рез = 1
		
	ИначеЕсли
		ВидНазначения = Перечисления.ВидыНазначенийОчкиЛинзы.ОчкиДляБлизи
		Тогда 
		Рез = 2
		
	ИначеЕсли
		ВидНазначения = Перечисления.ВидыНазначенийОчкиЛинзы.МКЛ
		Тогда 
		Рез = 3
		
	ИначеЕсли
		ВидНазначения = Перечисления.ВидыНазначенийОчкиЛинзы.НЛ
		Тогда 
		Рез = 4
	КонецЕсли;
	
	Возврат Рез
	
КонецФункции

&НаКлиенте
Процедура НастроитьВидимостьПолейРецепта()
	
	Рез = ПолучитьВидНазначения(ЭтаФорма.ВидНазначения);
	
	Если Рез = 1 Тогда
		Элементы.OD_инсет.Видимость = Ложь;
		Элементы.OS_инсет.Видимость = Ложь;
		Элементы.OD_ВС.Видимость = Ложь;
		Элементы.OS_ВС.Видимость = Ложь;
		Элементы.OD_PDR.Видимость = Истина;
		Элементы.OS_PDL.Видимость = Истина;
		
		
	ИначеЕсли Рез = 2 Тогда   
		Элементы.OD_инсет.Видимость = Истина;
		Элементы.OS_инсет.Видимость = Истина;
		Элементы.OD_ВС.Видимость = Ложь;
		Элементы.OS_ВС.Видимость = Ложь;
		Элементы.OD_PDR.Видимость = Истина;
		Элементы.OS_PDL.Видимость = Истина;
		
	ИначеЕсли Рез = 3 Тогда
		Элементы.OD_инсет.Видимость = Ложь;
		Элементы.OS_инсет.Видимость = Ложь;
		Элементы.OD_ВС.Видимость = Истина;
		Элементы.OS_ВС.Видимость = Истина;
		Элементы.OD_PDR.Видимость = Ложь;
		Элементы.OS_PDL.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНазначенияПриИзменении(Элемент)
	НастроитьВидимостьПолейРецепта();

КонецПроцедуры


