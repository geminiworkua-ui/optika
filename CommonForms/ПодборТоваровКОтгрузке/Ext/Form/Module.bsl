		КонецЕсли;
	КонецЦикла;
	
	П = Новый Структура;
	П.Вставить("М",М);
	П.Вставить("ЗаказКлиента",ЭтаФорма.ЗаказКлиента);
	
	Ссыль = ОформитьРеализациюНаСервере(П);
	
	ЭтаФорма.Закрыть(М);	
		
