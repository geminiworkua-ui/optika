
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ЗаказКлиента = Параметры.ЗаказКлиента;
	ЭтаФорма.Склад = Параметры.Склад;
    СобратьОстаткиКОтгрузке();

КонецПроцедуры

&НаСервере
Процедура СобратьОстаткиКОтгрузке()

	УстановитьПривилегированныйРежим(Истина);
	
	ТЗ = новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЧекККМТовары.Номенклатура КАК Номенклатура,
	               |	ЧекККМТовары.Характеристика КАК Характеристика,
	               |	ЧекККМТовары.Сумма + ЧекККМТовары.СуммаБонусныхБалловКСписанию КАК Сумма,
	               |	ЧекККМТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	ЧекККМТовары.Упаковка
	               |ПОМЕСТИТЬ вт_Чеки
	               |ИЗ
	               |	Документ.ЧекККМ.Товары КАК ЧекККМТовары
	               |ГДЕ
	               |	ЧекККМТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	               |	И ЧекККМТовары.Ссылка.ДокументОснование = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЧекККМВозвратТовары.Номенклатура,
	               |	ЧекККМВозвратТовары.Характеристика,
	               |	-1 * ЧекККМВозвратТовары.Сумма,
	               |	-ЧекККМВозвратТовары.КоличествоУпаковок,
	               |	ЧекККМВозвратТовары.Упаковка
	               |ИЗ
	               |	Документ.ЧекККМВозврат.Товары КАК ЧекККМВозвратТовары
	               |ГДЕ
	               |	ЧекККМВозвратТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит)
	               |	И ЧекККМВозвратТовары.Ссылка.ЧекККМ.ДокументОснование = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	вт_Чеки.Номенклатура,
	               |	вт_Чеки.Характеристика,
	               |	СУММА(вт_Чеки.Сумма) КАК СуммаОплаты,
	               |	СУММА(вт_Чеки.КоличествоУпаковок) КАК КоличествоОплаты
	               |ПОМЕСТИТЬ вт_оплаты
	               |ИЗ
	               |	вт_Чеки КАК вт_Чеки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	вт_Чеки.Номенклатура,
	               |	вт_Чеки.Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	               |	ЗаказКлиентаТовары.Характеристика КАК Характеристика,
	               |	ЗаказКлиентаТовары.ПреемникПлатежаН КАК ПреемникПлатежаН,
	               |	ЗаказКлиентаТовары.ПреемникПлатежаХ КАК ПреемникПлатежаХ,
	               |	СУММА(ЗаказКлиентаТовары.КоличествоУпаковок) КАК КоличествоЗаказа,
	               |	СУММА(ЗаказКлиентаТовары.Сумма) КАК СуммаЗаказа,
	               |	ЗаказКлиентаТовары.Упаковка
	               |ПОМЕСТИТЬ вт_товары
	               |ИЗ
	               |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Ссылка = &Ссылка
	               |	И НЕ ЗаказКлиентаТовары.Отменено
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаТовары.Номенклатура,
	               |	ЗаказКлиентаТовары.Характеристика,
	               |	ЗаказКлиентаТовары.ПреемникПлатежаН,
	               |	ЗаказКлиентаТовары.ПреемникПлатежаХ,
	               |	ЗаказКлиентаТовары.Упаковка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	вт_товары.Номенклатура,
	               |	вт_товары.Характеристика,
	               |	вт_товары.ПреемникПлатежаН,
	               |	вт_товары.ПреемникПлатежаХ,
	               |	вт_товары.КоличествоЗаказа,
	               |	вт_товары.СуммаЗаказа,
	               |	ЕСТЬNULL(вт_оплаты.СуммаОплаты, 0) КАК СуммаОплаты,
	               |	ЕСТЬNULL(вт_оплаты.КоличествоОплаты, 0) КАК КоличествоОплаты,
	               |	вт_товары.Упаковка
	               |ПОМЕСТИТЬ вт_ЧистыеОплаты
	               |ИЗ
	               |	вт_товары КАК вт_товары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт_оплаты КАК вт_оплаты
	               |		ПО вт_товары.Номенклатура = вт_оплаты.Номенклатура
	               |			И вт_товары.Характеристика = вт_оплаты.Характеристика
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	вт_товары.Номенклатура,
	               |	вт_товары.Характеристика,
	               |	вт_товары.ПреемникПлатежаН,
	               |	вт_товары.ПреемникПлатежаХ,
	               |	вт_товары.КоличествоЗаказа,
	               |	вт_товары.СуммаЗаказа,
	               |	ЕСТЬNULL(вт_оплаты.СуммаОплаты, 0),
	               |	ЕСТЬNULL(вт_оплаты.КоличествоОплаты, 0),
	               |	вт_товары.Упаковка
	               |ИЗ
	               |	вт_товары КАК вт_товары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт_оплаты КАК вт_оплаты
	               |		ПО вт_товары.ПреемникПлатежаН = вт_оплаты.Номенклатура
	               |			И вт_товары.ПреемникПлатежаХ = вт_оплаты.Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	вт_ЧистыеОплаты.Номенклатура,
	               |	вт_ЧистыеОплаты.Характеристика,
	               |	СУММА(вт_ЧистыеОплаты.КоличествоОплаты) КАК КоличествоОплаты,
	               |	СУММА(вт_ЧистыеОплаты.СуммаОплаты) КАК СуммаОплаты,
	               |	вт_ЧистыеОплаты.Упаковка
	               |ПОМЕСТИТЬ вт_ЗаказыОплаты
	               |ИЗ
	               |	вт_ЧистыеОплаты КАК вт_ЧистыеОплаты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	вт_ЧистыеОплаты.Номенклатура,
	               |	вт_ЧистыеОплаты.Характеристика,
	               |	вт_ЧистыеОплаты.Упаковка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫБОР
	               |		КОГДА вт_товары.ПреемникПлатежаН = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |			ТОГДА вт_товары.Номенклатура
	               |		ИНАЧЕ вт_товары.ПреемникПлатежаН
	               |	КОНЕЦ КАК Номенклатура,
	               |	ВЫБОР
	               |		КОГДА вт_товары.ПреемникПлатежаХ = ЗНАЧЕНИЕ(Справочник.ХАРАКТЕРИСТИКИНоменклатуры.ПустаяСсылка)
	               |			ТОГДА вт_товары.Характеристика
	               |		ИНАЧЕ вт_товары.ПреемникПлатежаХ
	               |	КОНЕЦ КАК Характеристика,
	               |	вт_товары.КоличествоЗаказа КАК КоличествоЗаказа,
	               |	вт_товары.СуммаЗаказа КАК СуммаЗаказа,
	               |	вт_товары.КоличествоЗаказа - вт_ЗаказыОплаты.КоличествоОплаты КАК КоличествоОплаты,
	               |	вт_товары.СуммаЗаказа - вт_ЗаказыОплаты.СуммаОплаты КАК СуммаОплаты,
	               |	вт_ЗаказыОплаты.КоличествоОплаты КАК КоличествоОплачено,
	               |	вт_ЗаказыОплаты.СуммаОплаты КАК СуммаОплачено,
	               |	вт_товары.Упаковка
	               |ПОМЕСТИТЬ ВТ_ТоварыКОплате
	               |ИЗ
	               |	вт_товары КАК вт_товары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт_ЗаказыОплаты КАК вт_ЗаказыОплаты
	               |		ПО вт_товары.Номенклатура = вт_ЗаказыОплаты.Номенклатура
	               |			И вт_товары.Характеристика = вт_ЗаказыОплаты.Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	вт_ТоварыКОплате.Номенклатура КАК Номенклатура,
	               |	вт_ТоварыКОплате.Характеристика КАК Характеристика,
	               |	вт_ТоварыКОплате.КоличествоЗаказа КАК КоличествоЗаказ,
	               |	вт_ТоварыКОплате.СуммаЗаказа КАК СуммаЗаказ,
	               |	ВЫБОР
	               |		КОГДА вт_ТоварыКОплате.СуммаЗаказа > вт_ТоварыКОплате.СуммаОплачено
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Платим,
	               |	вт_ТоварыКОплате.СуммаЗаказа - вт_ТоварыКОплате.СуммаОплачено КАК Остаток,
	               |	ЕСТЬNULL(вт_ТоварыКОплате.КоличествоОплаты, 0) КАК КоличествоЧек,
	               |	ЕСТЬNULL(вт_ТоварыКОплате.СуммаОплаты, 0) КАК СуммаЧек,
	               |	ЕСТЬNULL(вт_ТоварыКОплате.КоличествоОплачено, 0) КАК КоличествоОплачено,
	               |	ЕСТЬNULL(вт_ТоварыКОплате.СуммаОплачено, 0) КАК СуммаОплачено,
	               |	ПодборКассыККМ.КассаККМ КАК КассаККМ,
	               |	ЕСТЬNULL(ГотовностьОтгрузки.ЗаказаноОстаток, 0) КАК КоличествоОстатокКОтгрузке,
	               |	ЕСТЬNULL(ГотовностьОтгрузки.Готово, 0) КАК КоличествоДоступноКОтгрузке,
	               |	ЕСТЬNULL(ГотовностьОтгрузки.СуммаОтгружено, 0) КАК СуммаОтгружено,
	               |	вт_ТоварыКОплате.СуммаЗаказа - ЕСТЬNULL(вт_ТоварыКОплате.СуммаОплаты, 0) КАК СуммаОстатокКОплате,
	               |	0 КАК РазрешеноОтгружатьКолич,
	               |	0 КАК СуммаОплатыНеобходима,
	               |	вт_ТоварыКОплате.СуммаЗаказа / вт_ТоварыКОплате.КоличествоЗаказа КАК Цена,
	               |	ЕСТЬNULL(ГотовностьОтгрузки.ВРезервеОстаток, 0) КАК ВРезервеОстаток,
	               |	ЕСТЬNULL(ГотовностьОтгрузки.КОтгрузкеОстаток, 0) КАК КОтгрузкеОстаток,
	               |	ГотовностьОтгрузки.КоличествоОтгружено,
	               |	вт_ТоварыКОплате.Упаковка
	               |ПОМЕСТИТЬ вт_Финал
	               |ИЗ
	               |	ВТ_ТоварыКОплате КАК вт_ТоварыКОплате
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ПривязкаСПДСрезПоследних.КассаККМ КАК КассаККМ,
	               |			ПривязкаСПДСрезПоследних.ГруппаНоменклатурыДляРРО КАК ГруппаНоменклатурыДляРРО
	               |		ИЗ
	               |			РегистрСведений.ПривязкаСПД.СрезПоследних(&Дата, Магазин = &Склад) КАК ПривязкаСПДСрезПоследних) КАК ПодборКассыККМ
	               |		ПО вт_ТоварыКОплате.Номенклатура.ВидНоменклатуры.ГруппаНоменклатурыДляРРО = ПодборКассыККМ.ГруппаНоменклатурыДляРРО
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВложенныйЗапрос.ЗаказКлиентаСсылка КАК ЗаказКлиентаСсылка,
	               |			ВЫБОР
	               |				КОГДА ВложенныйЗапрос.Готово = 0
	               |					ТОГДА 1
	               |				КОГДА ВложенныйЗапрос.Готово > 0
	               |						И ВложенныйЗапрос.ЗаказаноОстаток > ВложенныйЗапрос.Готово
	               |					ТОГДА 2
	               |				КОГДА ВложенныйЗапрос.Готово > 0
	               |						И ВложенныйЗапрос.ЗаказаноОстаток = ВложенныйЗапрос.Готово
	               |					ТОГДА 3
	               |				ИНАЧЕ 0
	               |			КОНЕЦ КАК СтатусГотовности,
	               |			ВложенныйЗапрос.ЗаказаноОстаток КАК ЗаказаноОстаток,
	               |			ВложенныйЗапрос.Готово КАК Готово,
	               |			ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |			ВложенныйЗапрос.Характеристика КАК Характеристика,
	               |			СУММА(ВложенныйЗапрос.СуммаОтгружено) КАК СуммаОтгружено,
	               |			СУММА(ВложенныйЗапрос.КоличествоОтгружено) КАК КоличествоОтгружено,
	               |			ВложенныйЗапрос.ВРезервеОстаток КАК ВРезервеОстаток,
	               |			ВложенныйЗапрос.КОтгрузкеОстаток КАК КОтгрузкеОстаток
	               |		ИЗ
	               |			(ВЫБРАТЬ
	               |				ВложенныйЗапрос.ЗаказКлиентаСсылка КАК ЗаказКлиентаСсылка,
	               |				СУММА(ВложенныйЗапрос.ЗаказаноОстаток) КАК ЗаказаноОстаток,
	               |				СУММА(ВложенныйЗапрос.Готово) КАК Готово,
	               |				ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |				ВложенныйЗапрос.Характеристика КАК Характеристика,
	               |				ВложенныйЗапрос.СуммаОтгружено КАК СуммаОтгружено,
	               |				ВложенныйЗапрос.КоличествоОтгружено КАК КоличествоОтгружено,
	               |				ВложенныйЗапрос.ВРезервеОстаток КАК ВРезервеОстаток,
	               |				ВложенныйЗапрос.КОтгрузкеОстаток КАК КОтгрузкеОстаток
	               |			ИЗ
	               |				(ВЫБРАТЬ
	               |					ЗаказыКлиентовОстатки.ЗаказКлиента.Ссылка КАК ЗаказКлиентаСсылка,
	               |					ЗаказыКлиентовОстатки.Номенклатура КАК Номенклатура,
	               |					ЗаказыКлиентовОстатки.Характеристика КАК Характеристика,
	               |					ЗаказыКлиентовОстатки.Склад КАК Склад,
	               |					ЗаказыКлиентовОстатки.ЗаказаноОстаток КАК ЗаказаноОстаток,
	               |					ТоварыНаСкладахОстатки.ВНаличииОстаток КАК ВНаличииОстаток,
	               |					НарядНаРаботыТовары.Ссылка.Статус КАК Статус,
	               |					ВложенныйЗапрос.СтатусНаряда КАК СтатусНаряда,
	               |					ЗаказыКлиентовОстатки.Номенклатура.ВидНоменклатуры КАК НоменклатураВидНоменклатуры,
	               |					ВЫБОР
	               |						КОГДА ЗаказыКлиентовОстатки.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.РоботиМастера)
	               |								И ВложенныйЗапрос.СтатусНаряда = ЗНАЧЕНИЕ(Перечисление.СтатусДокументаНарядНаРаботу.Выполнен)
	               |							ТОГДА ЗаказыКлиентовОстатки.ЗаказаноОстаток
	               |						КОГДА ЗаказыКлиентовОстатки.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.УслугиВрача)
	               |							ТОГДА ЗаказыКлиентовОстатки.ЗаказаноОстаток
	               |						КОГДА ЗаказыКлиентовОстатки.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	               |								И НЕ ВложенныйЗапрос.СтатусНаряда ЕСТЬ NULL
	               |								И ВложенныйЗапрос.СтатусНаряда = ЗНАЧЕНИЕ(Перечисление.СтатусДокументаНарядНаРаботу.Выполнен)
	               |							ТОГДА ТоварыНаСкладахОстатки.ВНаличииОстаток
	               |						КОГДА ЗаказыКлиентовОстатки.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	               |								И ВложенныйЗапрос.СтатусНаряда ЕСТЬ NULL
	               |							ТОГДА ТоварыНаСкладахОстатки.ВНаличииОстаток
	               |						ИНАЧЕ 0
	               |					КОНЕЦ КАК Готово,
	               |					ЗаказыКлиентовОстатки.Номенклатура.ВидНоменклатуры.ТипНоменклатуры КАК НоменклатураВидНоменклатурыТипНоменклатуры,
	               |					ВыручкаИСебестоимостьПродаж.СуммаВыручки КАК СуммаОтгружено,
	               |					ВыручкаИСебестоимостьПродаж.Количество КАК КоличествоОтгружено,
	               |					ТоварыКОтгрузкеОстатки.ВРезервеОстаток КАК ВРезервеОстаток,
	               |					ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток КАК КОтгрузкеОстаток
	               |				ИЗ
	               |					РегистрНакопления.ЗаказыКлиентов.Остатки КАК ЗаказыКлиентовОстатки
	               |						ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(, ) КАК ТоварыНаСкладахОстатки
	               |						ПО ЗаказыКлиентовОстатки.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	               |							И ЗаказыКлиентовОстатки.Характеристика = ТоварыНаСкладахОстатки.Характеристика
	               |							И ЗаказыКлиентовОстатки.ЗаказКлиента = ТоварыНаСкладахОстатки.Назначение.Заказ
	               |						ЛЕВОЕ СОЕДИНЕНИЕ Документ.НарядНаРаботы.Товары КАК НарядНаРаботыТовары
	               |						ПО ЗаказыКлиентовОстатки.ЗаказКлиента = НарядНаРаботыТовары.Ссылка.ЗаказКлиента
	               |							И ЗаказыКлиентовОстатки.Номенклатура = НарядНаРаботыТовары.Номенклатура
	               |							И ЗаказыКлиентовОстатки.Характеристика = НарядНаРаботыТовары.Характеристика
	               |						ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |							НарядНаРаботы.Ссылка КАК НарядНаРаботы,
	               |							НарядНаРаботы.Статус КАК СтатусНаряда,
	               |							НарядНаРаботы.ЗаказКлиента.Ссылка КАК ЗаказКлиентаСсылка
	               |						ИЗ
	               |							Документ.НарядНаРаботы КАК НарядНаРаботы) КАК ВложенныйЗапрос
	               |						ПО ЗаказыКлиентовОстатки.ЗаказКлиента = ВложенныйЗапрос.ЗаказКлиентаСсылка
	               |						ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК ВыручкаИСебестоимостьПродаж
	               |						ПО ЗаказыКлиентовОстатки.ЗаказКлиента = ВыручкаИСебестоимостьПродаж.ЗаказКлиента
	               |							И ЗаказыКлиентовОстатки.Номенклатура = ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Номенклатура
	               |							И ЗаказыКлиентовОстатки.Характеристика = ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Характеристика
	               |						ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.Остатки КАК ТоварыКОтгрузкеОстатки
	               |						ПО ЗаказыКлиентовОстатки.Номенклатура = ТоварыКОтгрузкеОстатки.Номенклатура
	               |							И ЗаказыКлиентовОстатки.Характеристика = ТоварыКОтгрузкеОстатки.Характеристика
	               |							И ЗаказыКлиентовОстатки.ЗаказКлиента = ТоварыКОтгрузкеОстатки.ДокументОтгрузки
	               |				ГДЕ
	               |					ЗаказыКлиентовОстатки.ЗаказКлиента.Ссылка = &Ссылка) КАК ВложенныйЗапрос
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				ВложенныйЗапрос.ЗаказКлиентаСсылка,
	               |				ВложенныйЗапрос.Номенклатура,
	               |				ВложенныйЗапрос.Характеристика,
	               |				ВложенныйЗапрос.СуммаОтгружено,
	               |				ВложенныйЗапрос.КоличествоОтгружено,
	               |				ВложенныйЗапрос.ВРезервеОстаток,
	               |				ВложенныйЗапрос.КОтгрузкеОстаток) КАК ВложенныйЗапрос
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВложенныйЗапрос.ЗаказКлиентаСсылка,
	               |			ВЫБОР
	               |				КОГДА ВложенныйЗапрос.Готово = 0
	               |					ТОГДА 1
	               |				КОГДА ВложенныйЗапрос.Готово > 0
	               |						И ВложенныйЗапрос.ЗаказаноОстаток > ВложенныйЗапрос.Готово
	               |					ТОГДА 2
	               |				КОГДА ВложенныйЗапрос.Готово > 0
	               |						И ВложенныйЗапрос.ЗаказаноОстаток = ВложенныйЗапрос.Готово
	               |					ТОГДА 3
	               |				ИНАЧЕ 0
	               |			КОНЕЦ,
	               |			ВложенныйЗапрос.ЗаказаноОстаток,
	               |			ВложенныйЗапрос.Готово,
	               |			ВложенныйЗапрос.Номенклатура,
	               |			ВложенныйЗапрос.Характеристика,
	               |			ВложенныйЗапрос.ВРезервеОстаток,
	               |			ВложенныйЗапрос.КОтгрузкеОстаток) КАК ГотовностьОтгрузки
	               |		ПО вт_ТоварыКОплате.Номенклатура = ГотовностьОтгрузки.Номенклатура
	               |			И вт_ТоварыКОплате.Характеристика = ГотовностьОтгрузки.Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	вт_Финал.Номенклатура,
	               |	вт_Финал.Характеристика,
	               |	вт_Финал.КоличествоЗаказ,
	               |	вт_Финал.СуммаЗаказ,
	               |	вт_Финал.Платим,
	               |	вт_Финал.Остаток,
	               |	вт_Финал.КоличествоЧек,
	               |	вт_Финал.СуммаЧек,
	               |	вт_Финал.КоличествоОплачено,
	               |	вт_Финал.СуммаОплачено,
	               |	вт_Финал.КассаККМ,
	               |	вт_Финал.КоличествоОстатокКОтгрузке,
	               |	вт_Финал.КоличествоДоступноКОтгрузке,
	               |	вт_Финал.СуммаОтгружено,
	               |	вт_Финал.СуммаОстатокКОплате,
	               |	вт_Финал.РазрешеноОтгружатьКолич,
	               |	вт_Финал.СуммаОплатыНеобходима,
	               |	вт_Финал.Цена,
	               |	вт_Финал.ВРезервеОстаток,
	               |	вт_Финал.КОтгрузкеОстаток,
	               |	вт_Финал.КоличествоОтгружено,
	               |	вт_Финал.Упаковка
	               |ИЗ
	               |	вт_Финал КАК вт_Финал
	               |ГДЕ
	               |	вт_Финал.КоличествоОстатокКОтгрузке > 0";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаказКлиента); 
	Запрос.УстановитьПараметр("Склад", Склад); 
	Запрос.УстановитьПараметр("Дата", ТекущаяДата()); 
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	
	ТЗ.Колонки.Добавить("Комент", Новый ОписаниеТипов("Строка"));
	
	// обработаем ТЗ: проверим статус оплат и возможность отгрузки
	
	Для каждого Стр из ТЗ цикл
			ОстатокПредоплаты = Стр.СуммаОплачено - Стр.СуммаОтгружено;
			
			
		Если Стр.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга
				Тогда 
				Стр.КоличествоДоступноКОтгрузке = Стр.КоличествоОстатокКОтгрузке
				Иначе
			Стр.КоличествоДоступноКОтгрузке = мин(Стр.КоличествоОстатокКОтгрузке,  макс(число(Стр.КоличествоДоступноКОтгрузке), число(Стр.ВРезервеОстаток), число(Стр.КОтгрузкеОстаток)));
		КонецЕсли;
		
		
			
			СтоимостьДоступного = Стр.КоличествоДоступноКОтгрузке * Стр.Цена;
			
			Стр.СуммаОстатокКОплате = Стр.СуммаЗаказ - Стр.СуммаОплачено;
				
			
			Если ОстатокПредоплаты >= СтоимостьДоступного
				Тогда 
				Стр.Комент = сокрЛП("");;
				Стр.РазрешеноОтгружатьКолич = Стр.КоличествоДоступноКОтгрузке;
			ИначеЕсли 
				ОстатокПредоплаты < СтоимостьДоступного
				Тогда 
				Стр.Комент = СокрЛП("Потрібна доплата");
				Стр.РазрешеноОтгружатьКолич = 0;
				Стр.СуммаОплатыНеобходима = СтоимостьДоступного - ОстатокПредоплаты;
			КонецЕсли;
	КонецЦикла;
	
	////Для каждого Стр из ТЗ цикл
	////	Если
	////		НЕ Стр.КоличествоОстатокКОтгрузке > 0
	////		Тогда
	////		//Инд = ТЗ.Индекс(Стр);
	////		ТЗ.Удалить(Стр);			
	////		
	////	КонецЕсли;
	////КонецЦикла;
	
	ОстаткиКОтгрузке.Загрузить(ТЗ);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

