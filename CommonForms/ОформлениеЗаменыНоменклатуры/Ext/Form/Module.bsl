
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры = неопределено
		Тогда
		НоменклатураСтар = Параметры.НоменклатураСтар;
		ХарактеристикаСтар = Параметры.ХарактеристикаСтар;
		Если ЗначениеЗаполнено(ХарактеристикаСтар)
			Тогда
			Элементы.ХарактеристикаСтар.Видимость = Истина;
		КонецЕсли;
		НоменклатураНов = Параметры.НоменклатураНов;
		ХарактеристикаНов = Параметры.ХарактеристикаНов;
		Если ЗначениеЗаполнено(ХарактеристикаНов)
			Тогда
			Элементы.ХарактеристикаНов.Видимость = Истина;
		КонецЕсли;
		
		Назначен  = Параметры.Назначение;
		ЗаказКлиента = Назначен.Заказ;
		Количество = Параметры.Количество;
		Автор = ПараметрыСеанса.ТекущийПользователь;
		ДокументСсылка = Параметры.ДокументСсылка;   
				
	КонецЕсли;   	
	
	М = Новый Массив;
	М.Количество();
	м = ПроверкаВыполнениеОбработкиВозможно();
	
	Если М.Количество() > 0
		Тогда
		Элементы.ГруппаОбработкаПриемлема.Видимость = Ложь;
		Элементы.ГруппаОбработкаНеПриемлема.Видимость = Истина;
		
		Для каждого Стр из М Цикл
			НовСтр = ДокументыМешают.Добавить();
			НовСтр.ссылка = Стр;
		КонецЦикла;
		
	
	Иначе
		Элементы.ГруппаОбработкаПриемлема.Видимость = Истина;
		Элементы.ГруппаОбработкаНеПриемлема.Видимость = Ложь;

	КонецЕсли;	
		
	
	ЗаполнитьПереченьДокументовЗамены(ЗаказКлиента);
	
КонецПроцедуры

&НаСервере
Функция ПроверкаВыполнениеОбработкиВозможно()
	
	П = Новый Структура("ДокументИсточник, Статус, ЗаказКлиента, НоменклатураСтар, ХарактеристикаСтар");
	ЗаполнитьЗначенияСвойств(П, ЭтаФорма);
	Возврат Инфра_ОбщиеМодули.ПроверкаВыполнениеОбработкиВозможнаЗамена(П);

КонецФункции

&НаСервере
Функция ИспХарактеристикНоменколатурыНаСервере(Номенклатура)
	Если
		Номенклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать
		Тогда Возврат Ложь
	Иначе Возврат Истина
	КонецЕсли;
КонецФункции 

&НаКлиенте
Процедура НоменклатураНовПриИзменении(Элемент)
	ХарактеристикаНов = неопределено;
	Если 
		ИспХарактеристикНоменколатурыНаСервере(НоменклатураНов) = Истина
		Тогда
		Элементы.ХарактеристикаНов.Видимость = Истина
	Иначе
		Элементы.ХарактеристикаНов.Видимость = Ложь
	КонецЕсли;
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьПереченьДокументовЗамены(ЗаказКлиента)
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНаПеремещениеТовары.Ссылка.Ссылка КАК Документ,
		|	ЗаказНаПеремещениеТовары.Ссылка.Дата,
		|	ЗаказНаПеремещениеТовары.Ссылка.Ответственный КАК Автор,
		|	ЗаказНаПеремещениеТовары.Ссылка.Статус
		|ПОМЕСТИТЬ вт_Сборка
		|ИЗ
		|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
		|ГДЕ
		|	ЗаказНаПеремещениеТовары.Характеристика = &Характеристика
		|	И ЗаказНаПеремещениеТовары.Номенклатура = &Номенклатура
		|	И ЗаказНаПеремещениеТовары.Назначение.Заказ = &ЗаказКлиента
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаПеремещениеТовары.Ссылка.Ссылка,
		|	ЗаказНаПеремещениеТовары.Ссылка.Дата,
		|	ЗаказНаПеремещениеТовары.Ссылка.Ответственный,
		|	ЗаказНаПеремещениеТовары.Ссылка.Статус
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказПоставщикуТовары.Ссылка.Ссылка,
		|	ЗаказПоставщикуТовары.Ссылка.Дата,
		|	ЗаказПоставщикуТовары.Ссылка.Автор,
		|	NULL
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|ГДЕ
		|	ЗаказПоставщикуТовары.Характеристика = &Характеристика
		|	И ЗаказПоставщикуТовары.Номенклатура = &Номенклатура
		|	И ЗаказПоставщикуТовары.Назначение.Заказ = &ЗаказКлиента
		|	И ЗаказПоставщикуТовары.Ссылка = &СсылкаТекущийЗаказПоставщику
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПоставщикуТовары.Ссылка.Ссылка,
		|	ЗаказПоставщикуТовары.Ссылка.Дата,
		|	ЗаказПоставщикуТовары.Ссылка.Автор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказНаСборкуТовары.Ссылка.Ссылка,
		|	ЗаказНаСборкуТовары.Ссылка.Дата,
		|	ЗаказНаСборкуТовары.Ссылка.Ответственный,
		|	ЗаказНаСборкуТовары.Ссылка.Статус
		|ИЗ
		|	Документ.ЗаказНаСборку.Товары КАК ЗаказНаСборкуТовары
		|ГДЕ
		|	ЗаказНаСборкуТовары.Характеристика = &Характеристика
		|	И ЗаказНаСборкуТовары.Номенклатура = &Номенклатура
		|	И ЗаказНаСборкуТовары.Назначение.Заказ = &ЗаказКлиента
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаСборкуТовары.Ссылка.Ссылка,
		|	ЗаказНаСборкуТовары.Ссылка.Дата,
		|	ЗаказНаСборкуТовары.Ссылка.Ответственный,
		|	ЗаказНаСборкуТовары.Ссылка.Статус
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка,
		|	ЗаказКлиента.Дата,
		|	ЗаказКлиента.Менеджер,
		|	ЗаказКлиента.Статус
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка = &ЗаказКлиента
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиента.Ссылка,
		|	ЗаказКлиента.Дата,
		|	ЗаказКлиента.Менеджер,
		|	ЗаказКлиента.Статус
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Сборка.Документ,
		|	вт_Сборка.Дата КАК Дата,
		|	вт_Сборка.Автор,
		|	вт_Сборка.Статус
		|ИЗ
		|	вт_Сборка КАК вт_Сборка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
		Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	    Запрос.УстановитьПараметр("Номенклатура", НоменклатураСтар);
	    Запрос.УстановитьПараметр("Характеристика", ХарактеристикаСтар);
	   	Запрос.УстановитьПараметр("СсылкаТекущийЗаказПоставщику", ДокументИсточник);
        
		ТЗ = Новый ТаблицаЗначений;
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		РеестрДокументов.Загрузить(ТЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗакрыть(Команда)
	
	Если 
		ИспХарактеристикНоменколатурыНаСервере(НоменклатураНов) = Истина
		Тогда
		Если ЗначениеЗаполнено(НоменклатураНов) и ЗначениеЗаполнено(ХарактеристикаНов)
			Тогда
			МожноВыполнять = Истина 
		Иначе МожноВыполнять = Ложь 
		КонецЕсли; 
	Иначе
		Если ЗначениеЗаполнено(НоменклатураНов) Тогда
			МожноВыполнять = Истина 
		Иначе МожноВыполнять = Ложь 
		КонецЕсли; 
	КонецЕсли;
	
	// СформируемПараметрыЗамены
	Если  МожноВыполнять = Истина
		Тогда
		ТЗ = Новый Массив;
		Для каждого Стр из РеестрДокументов цикл
			ТЗ.Добавить(Стр.Документ)
		КонецЦикла;
		
		П = Новый Структура;
		П.Вставить("ДокументИсточник", ДокументИсточник);
		П.Вставить("НоменклатураСтар", НоменклатураСтар);
		П.Вставить("ХарактеристикаСтар", ХарактеристикаСтар);
		П.Вставить("НоменклатураНов", НоменклатураНов);
		П.Вставить("ХарактеристикаНов", ХарактеристикаНов);
		П.Вставить("Назначение", Назначен);
		П.Вставить("Количество", Количество);
		П.Вставить("Автор", Автор);
		П.Вставить("ПричинаОтмены", ПричинаОтмены);
		П.Вставить("Комментарий", Комментарий);
		П.вставить("ТЗ", ТЗ);
		П.Вставить("ДокументСсылка", ДокументСсылка);

		
		Рез = ВыполнитьЗаменуНаСервере(П);
		Если Рез = Истина
			ТОгда
			П = Новый Структура("Успешно", Истина);
			//Оповестить("ВыполненаЗаменаНоменклатуры", П);
			ЭтаФорма.Закрыть(П);
		КонецЕсли;	
			
	Иначе
		Сообщить("Не обрано нову номенклатуру. Заміна неможлива");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗаменуНаСервере(П)
	
	Возврат Инфра_ОбщиеМодули.ВыполнитьЗаменуНоменклатурыНаСервере(П)	

КонецФункции

&НаКлиенте
Процедура ПеренестиНоменклатуру(Команда)

	НоменклатураНов = НоменклатураСтар;

	ХарактеристикаНов = неопределено;
	Если 
		ИспХарактеристикНоменколатурыНаСервере(НоменклатураНов) = Истина
		Тогда
		Элементы.ХарактеристикаНов.Видимость = Истина
	Иначе
		Элементы.ХарактеристикаНов.Видимость = Ложь
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РеестрДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтр = Элементы.РеестрДокументов.ТекущиеДанные;
	Если Не ТекСтр = Неопределено
		Тогда
		СтандартнаяОбработка = Ложь;
		П = Новый Структура("Ключ",ТекСтр.Документ); 
		Если ТипЗнч(ТекСтр.Документ) = Тип("ДокументСсылка.ЗаказКлиента")
			Тогда ФормаДок = "Документ.ЗаказКлиента.Форма.ФормаДокумента"
		ИНАче
			ФормаДок = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента"
		КонецЕсли;
			
		ОткрытьФорму(ФормаДок, П, ЭтаФорма, ,,,,РежимОТкрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры



 

