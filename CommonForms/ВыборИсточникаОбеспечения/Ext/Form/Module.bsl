
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Номенклатура = Параметры.Номенклатура;
	Характеристика = Параметры.Характеристика;
	ЗаказКлиента = Параметры.ЗаказКлиента;
	Количество = Параметры.Количество;
	Магазин = Параметры.Магазин;

	ЗаполнитьСвободныеОстатки();
	
	ЭтаФорма.ОстатокКЗаказу = Количество;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвободныеОстатки()
	
	ЭтаФорма.Таблица.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвободныеОстаткиОстатки.Склад КАК Магазин,
		|	ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0) КАК СвобОстаток
		|ПОМЕСТИТЬ вт_Остатки
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(
		|			&Дата,
		|			Номенклатура = &Номенклатура
		|				И Характеристика = &Характеристика
		|				И НЕ Склад = &Магазин) КАК СвободныеОстаткиОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	СвободныеОстаткиОстатки.Склад,
		|	ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	вт_Остатки.Магазин,
		|	вт_Остатки.СвобОстаток
		|ИЗ
		|	вт_Остатки КАК вт_Остатки
		|ГДЕ
		|	вт_Остатки.СвобОстаток > 0";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ЭтаФорма.Таблица.Загрузить(ТЗ);
	
КонецПроцедуры	

&НаКлиенте
Процедура ТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбПриИзменении(Элемент)
	
	ТекСтр = Элементы.Таблица.ТекущиеДанные;
	
	Если ТекСтр.Выб = Истина
		Тогда ТекСтр.КоличествоВыбор = Мин(ТекСтр.СвобОстаток,(Количество - ВыбраноКоличество));
		Если ТекСтр.КоличествоВыбор = 0
			ТОгда
			ТекСтр.Выб = Ложь;
		КонецЕсли;
	ИначеЕсли ТекСтр.Выб = Ложь
		Тогда  ТекСтр.КоличествоВыбор = 0;
	КонецЕсли;
	
	// Пересчитаем выбранное количество
	Выбрано = 0;
	Для каждого Стр из ЭтаФорма.Таблица цикл
		
		Если Стр.КоличествоВыбор > 0 Тогда
			Выбрано = Выбрано + Стр.КоличествоВыбор;
		КонецЕсли;
	КонецЦикла;
	ВыбраноКоличество = Выбрано;	
	
	Если  Количество = ВыбраноКоличество 
		Тогда 	ВсеПодобрано = Истина
	Иначе   ВсеПодобрано = Ложь
	КонецЕсли;
	
	ОстатокКЗаказу =  Количество - ВыбраноКоличество;
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьЗакрыть(Команда)
	
	ПП = Новый Структура;
	М = Новый Массив;
	Для каждого Стр из ЭтаФорма.Таблица цикл
		Если Стр.КоличествоВыбор > 0
			Тогда
			П = Новый Структура;
			П.Вставить("Склад", Стр.Магазин);
			П.Вставить("Количество", Стр.КоличествоВыбор);
			М.Добавить(П);
		КонецЕсли;
	КонецЦикла;
	ПП.Вставить("М", М);
	ПП.Вставить("КоличествоПоставщик", Количество - ВыбраноКоличество);
	ПП.Вставить("ЗаказКлиента", ЗаказКлиента);
	ПП.Вставить("Номенклатура", Номенклатура);
	ПП.Вставить("Характеристика", Характеристика);
	ПП.Вставить("Склад", Магазин);
	
	ПП.Вставить("Поставщику", ЗаказПоставщику);
	ПП.Вставить("КоличествоВсего", Количество);

	//ПП.Вставить("Автор", ПараметрыСеанса.ТекущийПользователь);	
	Если НЕ (М.Количество()	> 0 ИЛИ ВыбраноКоличество > 0 ИЛИ ЗаказПоставщику = Истина)
		Тогда
		ПП = неопределено
	КонецЕсли;
	
	ЭтаФорма.Закрыть(ПП);
		
КонецПроцедуры
