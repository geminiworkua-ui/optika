#КонецОбласти

&НаСервере
Процедура ОбменНаСервере(ТипДанных, ПолныйОбмен)
	Если ПолныйОбмен Тогда
		Узел = Неопределено;
	Иначе
		Узел = Сайт;
	КонецЕсли;              
	Если ТипДанных = "Nomenclature" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьВсюНоменклатуру(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "Category" Тогда
        Результат = ИнфралайнОбменСайт.ПолучитьВсеКатегории(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "Rubricator" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьРубрикатор(Узел, СписокУдаления);			
	ИначеЕсли ТипДанных = "Manufacturer" ИЛИ ТипДанных = "Brand" ИЛИ ТипДанных = "Country" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьРазное(ТипДанных, Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "Property" Тогда 
		Результат = ИнфралайнОбменСайт.ПолучитьСвойства(Узел, СписокУдаления); 
	ИначеЕсли ТипДанных = "PropertyAs" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьСвойстваКак(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "PropertySet" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьНаборСвойств(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "CategoryPrice" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьВидыЦен(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "PropertyNomenclature" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьХарактеристики(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "PriceNomenclature" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьЦеныНоменклатуры(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "RestNomenclature" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьОстатки(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "NomenclaturePicture" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьКартинки(Узел, СписокУдаления);              
	ИначеЕсли ТипДанных = "TableChange" Тогда
		Результат = ИнфралайнОбменСайт.ОбработатьРасписаниеВрачей(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "WorkTime" Тогда
		Результат = ИнфралайнОбменСайт.ОбработатьЗаписиКВрачу(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "Doctors" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьВрачей(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "Shops" Тогда
		Результат = ИнфралайнОбменСайт.ПолучитьМагазины(Узел, СписокУдаления);
	ИначеЕсли ТипДанных = "All" Тогда
		СтруктураОтправки = Новый Структура();
		СтруктураОтправки.Вставить("Category"				, ИнфралайнОбменСайт.ПолучитьВсеКатегории(Узел, СписокУдаления));
		СтруктураОтправки.Вставить("Rubricator"				, ИнфралайнОбменСайт.ПолучитьРубрикатор(Узел, СписокУдаления));
		СтруктураОтправки.Вставить("Brand"					, ИнфралайнОбменСайт.ПолучитьРазное("Brand", Узел, СписокУдаления));
		СтруктураОтправки.Вставить("Country"				, ИнфралайнОбменСайт.ПолучитьРазное("Country", Узел, СписокУдаления));
		СтруктураОтправки.Вставить("Manufacturer"			, ИнфралайнОбменСайт.ПолучитьРазное("Manufacturer", Узел, СписокУдаления));
		СтруктураОтправки.Вставить("Property"				, ИнфралайнОбменСайт.ПолучитьСвойства(Узел, СписокУдаления));
		СтруктураОтправки.Вставить("PropertyAs"				, ИнфралайнОбменСайт.ПолучитьСвойстваКак(Узел, СписокУдаления)); 
		СтруктураОтправки.Вставить("PropertySet"			, ИнфралайнОбменСайт.ПолучитьНаборСвойств(Узел, СписокУдаления));  
		СтруктураОтправки.Вставить("CategoryPrice"			, ИнфралайнОбменСайт.ПолучитьЦенуКатегории(Узел, СписокУдаления));  
		СтруктураОтправки.Вставить("Nomenclature"			, ИнфралайнОбменСайт.ПолучитьВсюНоменклатуру(Узел, СписокУдаления));
		СтруктураОтправки.Вставить("PropertyNomenclature"	, ИнфралайнОбменСайт.ПолучитьХарактеристики(Узел, СписокУдаления));
		СтруктураОтправки.Вставить("PriceNomenclature"		, ИнфралайнОбменСайт.ПолучитьЦены(Узел, СписокУдаления));
		СтруктураОтправки.Вставить("RestNomenclature"		, ИнфралайнОбменСайт.ПолучитьОстатки(Узел, СписокУдаления));
		СтруктураОтправки.Вставить("NomenclaturePicture"	, ИнфралайнОбменСайт.ПолучитьКартинки(Узел, СписокУдаления));
		СтруктураОтправки.Вставить("TableChange"		 	, ИнфралайнОбменСайт.ОбработатьЗаписиКВрачу(Узел, СписокУдаления));
		СтруктураОтправки.Вставить("WorkTime"		 	    , ИнфралайнОбменСайт.ОбработатьРасписаниеВрачей(Узел, СписокУдаления));
	КонецЕсли;
    Если Не ТипДанных = "All" Тогда	
		СтруктураОтправки = ИнфралайнОбменСайт.СформироватьДанныеОчки(ТипДанных, Результат, Сайт.Сайт);  
	КонецЕсли;
	//МассивПакетов = ОбменСайт.РазбитьНаПакеты(СтруктураОтправки);
	ИнфралайнОбменСайт.ОтправитьДанныеОчки(СтруктураОтправки, Сайт, ТипДанных, "", СписокУдаления);
КонецПроцедуры

