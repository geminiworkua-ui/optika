&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Идентификатор", Идентификатор);
	Заголовок = "ФР" + " """ + Строка(Идентификатор) + """";
	
	времСервер = Неопределено;
	времПорт = Неопределено;
	времИмяУстройства = Неопределено;
	времТокен = Неопределено;
	времВыводНаПринтер = Неопределено;
	времШиринаЛенты = Неопределено;

	Если Найти(НРег(ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьИмяКонфигурацииНаСервере()), НРег("Розница")) Тогда
		Параметры.Свойство("Сервер", времСервер);
		Параметры.Свойство("Порт", времПорт);
		Параметры.Свойство("ИмяУстройства", времИмяУстройства);
		Параметры.Свойство("Токен", времТокен);
		Параметры.Свойство("ВыводНаПринтер", времВыводНаПринтер);
		Параметры.Свойство("ШиринаЛенты", времШиринаЛенты);	
	Иначе
		Параметры.ПараметрыОборудования.Свойство("Сервер", времСервер);
		Параметры.ПараметрыОборудования.Свойство("Порт", времПорт);
		Параметры.ПараметрыОборудования.Свойство("ИмяУстройства", времИмяУстройства);
		Параметры.ПараметрыОборудования.Свойство("Токен", времТокен);
		Параметры.ПараметрыОборудования.Свойство("ВыводНаПринтер", времВыводНаПринтер);
		Параметры.ПараметрыОборудования.Свойство("ШиринаЛенты", времШиринаЛенты);
	КонецЕсли;

	Сервер = ?(времСервер = Неопределено, "localhost", времСервер);
	Порт = ?(времПорт = Неопределено, 3939, времПорт);
	ИмяУстройства = ?(времИмяУстройства = Неопределено, "", времИмяУстройства);
	Токен = ?(времТокен = Неопределено, "", времТокен);
	ВыводНаПринтер = ?(времВыводНаПринтер = Неопределено, "", времВыводНаПринтер);
	ШиринаЛенты = ?(времШиринаЛенты = Неопределено, 80, времШиринаЛенты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьИнформациюОДрайвере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если Найти(НРег(ПодключаемоеОборудованиеВчасноКасаВызовСервера.ПолучитьИмяКонфигурацииНаСервере()), НРег("Розница")) Тогда
		Параметры.ПараметрыНастройки.Добавить(Сервер, "Сервер");
		Параметры.ПараметрыНастройки.Добавить(Порт, "Порт");
		Параметры.ПараметрыНастройки.Добавить(ИмяУстройства, "ИмяУстройства");
		Параметры.ПараметрыНастройки.Добавить(Токен, "Токен");
		Параметры.ПараметрыНастройки.Добавить(ВыводНаПринтер, "ВыводНаПринтер");
		Параметры.ПараметрыНастройки.Добавить(ШиринаЛенты, "ШиринаЛенты");
		
		Закрыть(КодВозвратаДиалога.ОК);
	Иначе	
		НовыеЗначениеПараметров = Новый Структура;
		НовыеЗначениеПараметров.Вставить("Сервер", Сервер);
		НовыеЗначениеПараметров.Вставить("Порт", Порт);
		НовыеЗначениеПараметров.Вставить("ИмяУстройства", ИмяУстройства);
		НовыеЗначениеПараметров.Вставить("Токен", Токен);
		НовыеЗначениеПараметров.Вставить("ВыводНаПринтер", ВыводНаПринтер);
		НовыеЗначениеПараметров.Вставить("ШиринаЛенты", ШиринаЛенты);
		
		Результат = Новый Структура;
		Результат.Вставить("Идентификатор", Идентификатор);
		Результат.Вставить("ПараметрыОборудования", НовыеЗначениеПараметров);
		
		Закрыть(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнформациюОДрайвере()

	Драйвер = "Не потрібно";
	Версия = "Не визначена";

КонецПроцедуры

