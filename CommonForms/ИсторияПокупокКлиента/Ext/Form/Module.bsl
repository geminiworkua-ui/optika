
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Клиент = Параметры.Клиент;
	
	
	
	
	ЗаписиКВрачу.Параметры.УстановитьЗначениеПараметра("Клиент", Клиент);
	ЗаписиКВрачу.Параметры.УстановитьЗначениеПараметра("ТекДата",началодня(ТекущаяДата()));
	ИсторияПокупок.Параметры.УстановитьЗначениеПараметра("Клиент", Клиент);
	ИсторияНазначений.Параметры.УстановитьЗначениеПараметра("Клиент", Клиент);
	ИсторияНазначенийОптика.Параметры.УстановитьЗначениеПараметра("Клиент", Клиент);
	
	ИсторияВозвратов.Параметры.УстановитьЗначениеПараметра("Партнер", Клиент);
	
	Если ЕстьВозвраты(Клиент) Тогда
		Элементы.ГруппаИсториЗаказов.Видимость = Истина;
	Иначе
		Элементы.ГруппаИсториЗаказов.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьВозвраты(Клиент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВозвратТоваровОтКлиентаТовары.Ссылка) КАК Количество
		|ИЗ
		|	Документ.ВозвратТоваровОтКлиента.Товары КАК ВозвратТоваровОтКлиентаТовары
		|ГДЕ
		|	ВозвратТоваровОтКлиентаТовары.ДокументРеализации.ЗаказКлиента.Партнер = &Партнер
		|	И ВозвратТоваровОтКлиентаТовары.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Партнер", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() и Выборка.Количество > 0 тогда
		Возврат Истина
	Иначе
		Возврат Ложь
	КонецЕсли;
	
КонецФункции

	