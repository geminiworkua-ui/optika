
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Склад = неопределено
		Тогда
		ЭтаФорма.Магазин = Параметры.Склад;
		ЭтаФорма.Элементы.Магазин.ТолькоПросмотр = Истина;
	КонецЕсли;
	ЗаполнитьПотребностьНаСервере(Магазин);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПотребностьНаСервере(Магазин)
	
	ЭтаФорма.Таблица.Очистить();
	
	Запрос = новый Запрос (
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыКлиентовГруппировка.Номенклатура,
	|	ЗаказыКлиентовГруппировка.Характеристика,
	|	СУММА(ЗаказыКлиентовГруппировка.Потребность) КАК Потребность,
	|	ЗаказыКлиентовГруппировка.ЗаказКлиента,
	|	ЗаказыКлиентовГруппировка.Заказчик,
	|	ЗаказыКлиентовГруппировка.Склад,
	|	СУММА(ГотовыеЗаказы.Заказано) КАК Заказано,
	|	СУММА(ЕСТЬNULL(ЗаказыКлиентовГруппировка.Потребность, 0) - ЕСТЬNULL(ГотовыеЗаказы.Заказано, 0)) КАК Необходимо,
	|	ЗаказыКлиентовГруппировка.ВариантОбеспечения
	|ПОМЕСТИТЬ вт_РеестрЗаказов
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|		ЗаказКлиентаТовары.Характеристика КАК Характеристика,
	|		СУММА(ЗаказКлиентаТовары.КоличествоУпаковок) КАК Потребность,
	|		ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	|		ЗаказКлиентаТовары.Ссылка.Партнер КАК Заказчик,
	|		ЗаказКлиентаТовары.Ссылка.Склад КАК Склад,
	|		ЗаказКлиентаТовары.ВариантОбеспечения КАК ВариантОбеспечения
	|	ИЗ
	|		Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|	ГДЕ
	|		ЗаказКлиентаТовары.Ссылка.Проведен
	|		И ЗаказКлиентаТовары.Ссылка.Склад = &Склад
	|		И ЗаказКлиентаТовары.Ссылка.Статус В(&Статус)
	|		И НЕ ЗаказКлиентаТовары.Отменено
	|		И ЗаказКлиентаТовары.ВариантОбеспечения = &ВариантыОбеспечения
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЗаказКлиентаТовары.Ссылка,
	|		ЗаказКлиентаТовары.Номенклатура,
	|		ЗаказКлиентаТовары.Характеристика,
	|		ЗаказКлиентаТовары.Ссылка.Партнер,
	|		ЗаказКлиентаТовары.Ссылка.Склад,
	|		ЗаказКлиентаТовары.ВариантОбеспечения) КАК ЗаказыКлиентовГруппировка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ГотовыеЗаказы.Номенклатура КАК Номенклатура,
	|			ГотовыеЗаказы.Характеристика КАК Характеристика,
	|			СУММА(ГотовыеЗаказы.Заказано) КАК Заказано,
	|			ГотовыеЗаказы.ЗаказКлиента КАК ЗаказКлиента,
	|			ГотовыеЗаказы.РегистраторСкладПолучатель КАК РегистраторСкладПолучатель
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
	|				ЗаказНаПеремещениеТовары.Характеристика КАК Характеристика,
	|				ЗаказНаПеремещениеТовары.КоличествоУпаковок КАК Заказано,
	|				ЗаказНаПеремещениеТовары.Назначение.Заказ.Ссылка КАК ЗаказКлиента,
	|				ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель КАК РегистраторСкладПолучатель
	|			ИЗ
	|				Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
	|			ГДЕ
	|				ЗаказНаПеремещениеТовары.Ссылка.Проведен
	|				И НЕ ЗаказНаПеремещениеТовары.Отменено) КАК ГотовыеЗаказы
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ГотовыеЗаказы.Характеристика,
	|			ГотовыеЗаказы.ЗаказКлиента,
	|			ГотовыеЗаказы.РегистраторСкладПолучатель,
	|			ГотовыеЗаказы.Номенклатура) КАК ГотовыеЗаказы
	|		ПО ЗаказыКлиентовГруппировка.Номенклатура = ГотовыеЗаказы.Номенклатура
	|			И ЗаказыКлиентовГруппировка.Характеристика = ГотовыеЗаказы.Характеристика
	|			И ЗаказыКлиентовГруппировка.ЗаказКлиента = ГотовыеЗаказы.ЗаказКлиента
	|			И ЗаказыКлиентовГруппировка.Склад = ГотовыеЗаказы.РегистраторСкладПолучатель
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыКлиентовГруппировка.Характеристика,
	|	ЗаказыКлиентовГруппировка.Номенклатура,
	|	ЗаказыКлиентовГруппировка.ЗаказКлиента,
	|	ЗаказыКлиентовГруппировка.Заказчик,
	|	ЗаказыКлиентовГруппировка.Склад,
	|	ЗаказыКлиентовГруппировка.ВариантОбеспечения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	вт_РеестрЗаказов.Номенклатура,
	|	вт_РеестрЗаказов.Характеристика,
	|	вт_РеестрЗаказов.ЗаказКлиента,
	|	вт_РеестрЗаказов.Заказчик,
	|	вт_РеестрЗаказов.Номенклатура.ЕдиницаИзмерения КАК ЕдИзм,
	|	СУММА(вт_РеестрЗаказов.Необходимо) КАК КоличествоПотребность,
	|	вт_РеестрЗаказов.ВариантОбеспечения
	|ИЗ
	|	вт_РеестрЗаказов КАК вт_РеестрЗаказов
	|ГДЕ
	|	вт_РеестрЗаказов.Необходимо > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_РеестрЗаказов.Номенклатура,
	|	вт_РеестрЗаказов.Характеристика,
	|	вт_РеестрЗаказов.ЗаказКлиента,
	|	вт_РеестрЗаказов.Заказчик,
	|	вт_РеестрЗаказов.Номенклатура.ЕдиницаИзмерения,
	|	вт_РеестрЗаказов.ВариантОбеспечения
	|
	|УПОРЯДОЧИТЬ ПО
	|	вт_РеестрЗаказов.ЗаказКлиента.Дата");
	
	Запрос.УстановитьПараметр("Склад", Магазин);
	
	МС = новый Массив;
	МС.Добавить(Перечисления.СтатусыЗаказовКлиентов.КОбеспечению);
	МС.Добавить(Перечисления.СтатусыЗаказовКлиентов.КОтгрузке);
	Запрос.УстановитьПараметр("Статус", МС);
	
//	М = Новый Массив;
//	М.Добавить(Перечисления.ВариантыОбеспечения.Обособленно);
//	М.Добавить(Перечисления.ВариантыОбеспечения.Требуется);
//	М.Добавить(Перечисления.ВариантыОбеспечения.ИзЗаказов);
//	Запрос.УстановитьПараметр("ВариантыОбеспечения", М);
	Запрос.УстановитьПараметр("ВариантыОбеспечения", Перечисления.ВариантыОбеспечения.Обособленно);
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
		
	ЭтаФорма.Таблица.Загрузить(ТЗ);
	

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если ЗначениеЗаполнено(Магазин)
		Тогда
		ЗаполнитьПотребностьНаСервере(Магазин);
	КонецЕсли;
	
	Для каждого Стр из ЭтаФорма.Таблица цикл
		Стр.Картинка = БиблиотекаКартинок.ПереходВправоАктивный;
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаКоличествоПотребность"
		ИЛИ  Поле.Имя = "ТаблицаЕдИзм"
		ИЛИ Поле.Имя = "ТаблицаВариантОбеспечения"
		ИЛИ Поле.Имя = "ТаблицаКартинка"
		Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекСтр = Элементы.Таблица.ТекущиеДанные;
		
		
		Если НЕ ТекСтр.ВариантОбеспечения = ПодобратьВариантОбеспечения()
			Тогда
			Текст = "Автоформування замовлень на переміщення можливо у разі визначення варіанту забезпечення /Забезпечувати відокремлено/";
			Сообщить(Текст);
		Иначе
			
			П = Новый Структура;
			П.Вставить("Номенклатура", ТекСтр.Номенклатура);
			П.Вставить("Характеристика", ТекСтр.Характеристика);
			П.Вставить("ЗаказКлиента", ТекСтр.ЗаказКлиента);
			П.Вставить("Магазин", Магазин);
			П.Вставить("Количество", ТекСтр.КоличествоПотребность);
			
			
			ОписаниеОповещения  = Новый ОписаниеОповещения("ВыполнитьОповещение",ЭтотОбъект);
			ОткрытьФорму("ОбщаяФорма.ВыборИсточникаОбеспечения",П,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодобратьВариантОбеспечения()
	Возврат Перечисления.ВариантыОбеспечения.Обособленно;
КонецФункции	

&НаКлиенте
Процедура ВыполнитьОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено
		Тогда 
		СформироватьЗаказНаПеремещение(Результат);
		ЗаполнитьПотребностьНаСервере(Магазин);
		Для каждого Стр из ЭтаФорма.Таблица цикл
			Стр.Картинка = БиблиотекаКартинок.ПереходВправоАктивный;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗаказНаПеремещение(Результат)

	Инфра_ОбщиеМодули.СформироватьЗаказНаПеремещениеПодОбеспечение(Результат);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		Для каждого Стр из ЭтаФорма.Таблица цикл
		Стр.Картинка = БиблиотекаКартинок.ПереходВправоАктивный;
КонецЦикла;
	

КонецПроцедуры
