
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("М")
		Тогда
		М = Параметры.М;
		ДокОбъект = Параметры.ДокОбъект;
		ЗаполнитьТЗвариантов(М);
	КонецЕсли;
	
	Партнер = ДокОбъект.Партнер;
	ЭтаФорма.ПараметрыДоставки = ДокОбъект.ПараметрыДоставки;    
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПартнерыКонтактнаяИнформация.Вид,
		|	ПартнерыКонтактнаяИнформация.Представление
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
		|ГДЕ
		|	ПартнерыКонтактнаяИнформация.Ссылка.Ссылка = &Партнер";
	
	Запрос.УстановитьПараметр("Партнер", Партнер);
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ЭтаФорма.КонтактнаяИнформация.Загрузить(ТЗ);
    Элементы.КонтактнаяИнформация.ВысотаВСтрокахТаблицы = ТЗ.Количество();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЗвариантов(М)   
	// М - массив с потребностью (Ном, Хар, колич)
	
	ТЗ = новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура", новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Характеристика", новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗ.Колонки.Добавить("Количество", новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("Код", новый ОписаниеТипов("Число")); 
	Для каждого Стр из М Цикл
		
		П = Стр;
		Номенклатура = Неопределено;
		П.Свойство("Номенклатура", Номенклатура);
		Если Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар
			Тогда
			НовСтр = ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		КонецЕсли;  
		
	КонецЦикла;
	
	ТЗ.Свернуть("Номенклатура, Характеристика","Количество, Код");
	
	Код = 1;
	Для каждого Стр из ТЗ Цикл
			Стр.Код = Код; 
			Код = Код + 1;
	КонецЦикла;
    	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Номенклатура,
		|	ТЗ.Характеристика,
		|	ТЗ.Количество,
		|	ТЗ.Код
		|ПОМЕСТИТЬ вт_ТЗ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТЗ.Номенклатура,
		|	вт_ТЗ.Характеристика,
		|	СУММА(вт_ТЗ.Количество) КАК Количество,
		|	вт_ТЗ.Код КАК Код,
		|	ВложенныйЗапрос.ТипНоменклатуры
		|ПОМЕСТИТЬ вт_ТЗ2
		|ИЗ
		|	вт_ТЗ КАК вт_ТЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
		|			Номенклатура.Ссылка КАК Ссылка
		|		ИЗ
		|			Справочник.Номенклатура КАК Номенклатура) КАК ВложенныйЗапрос
		|		ПО вт_ТЗ.Номенклатура = ВложенныйЗапрос.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ТЗ.Номенклатура,
		|	вт_ТЗ.Характеристика,
		|	ВложенныйЗапрос.ТипНоменклатуры,
		|	вт_ТЗ.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТЗ2.Номенклатура,
		|	вт_ТЗ2.Характеристика,
		|	ВложенныйЗапрос.Склад,
		|	СУММА(ВложенныйЗапрос.Остаток) КАК Остаток,
		|	вт_ТЗ2.Код,
		|	вт_ТЗ2.ТипНоменклатуры
		|ПОМЕСТИТЬ вт_сбор4
		|ИЗ
		|	вт_ТЗ2 КАК вт_ТЗ2
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
		|			СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
		|			СвободныеОстаткиОстатки.Склад КАК Склад,
		|			СУММА(СвободныеОстаткиОстатки.ВНаличииОстаток - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток, 0) - ЕСТЬNULL(СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток, 0)) КАК Остаток
		|		ИЗ
		|			РегистрНакопления.СвободныеОстатки.Остатки(&ТекДата, ) КАК СвободныеОстаткиОстатки
		|		
		|		СГРУППИРОВАТЬ ПО
		|			СвободныеОстаткиОстатки.Номенклатура,
		|			СвободныеОстаткиОстатки.Характеристика,
		|			СвободныеОстаткиОстатки.Склад) КАК ВложенныйЗапрос
		|		ПО вт_ТЗ2.Номенклатура = ВложенныйЗапрос.Номенклатура
		|			И вт_ТЗ2.Характеристика = ВложенныйЗапрос.Характеристика
		|ГДЕ
		|	вт_ТЗ2.ТипНоменклатуры = &ТипНоменклатуры
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ТЗ2.Номенклатура,
		|	вт_ТЗ2.Характеристика,
		|	ВложенныйЗапрос.Склад,
		|	вт_ТЗ2.Код,
		|	вт_ТЗ2.ТипНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_сбор4.Номенклатура,
		|	вт_сбор4.Характеристика,
		|	вт_сбор4.Склад,
		|	вт_сбор4.Остаток,
		|	вт_сбор4.Код,
		|	вт_сбор4.ТипНоменклатуры
		|ИЗ
		|	вт_сбор4 КАК вт_сбор4
		|ГДЕ
		|	вт_сбор4.Остаток > 0";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("ТЗ", ТЗ);   
	Запрос.УстановитьПараметр("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Товар);
	
	ТЗост = Новый ТаблицаЗначений;
	ТЗост = Запрос.Выполнить().Выгрузить();
	
	ТЗС = новый ТаблицаЗначений;
	
	Типы = Новый Массив;
	Типы.Добавить(Тип("Строка"));
	Типы.Добавить(Тип("СправочникСсылка.Склады"));  
	ТЗС.Колонки.Добавить("Склад", новый ОписаниеТипов(Типы)); 
	
	ТЗскладов = ТЗост.Скопировать(,"Склад");
	ТЗскладов.Свернуть("Склад");	
	
	Для каждого Стр из ТЗ цикл
		ТЗС.Колонки.Добавить(Строка("Ост_" + Строка(Стр.Код)), новый ОписаниеТипов("Число"));
	    ТЗС.Колонки.Добавить(Строка("Выб_" + Строка(Стр.Код)), новый ОписаниеТипов("Булево"));
		ТЗС.Колонки.Добавить(Строка("Кол_" + Строка(Стр.Код)), новый ОписаниеТипов("Число"));
	КонецЦикла;
	
	НовСтр = ТЗС.Добавить();
	НовСтр.Склад = "Під замовлення";
	
	Для каждого Стр из ТЗ цикл
		ИмяКолонки = Строка("Ост_" + Строка(Стр.Код)); 	
		НовСтр[ИмяКолонки] = Стр.Количество;
	КонецЦикла;
	
	сскл = Новый Соответствие;
	Для каждого Стр из  ТЗскладов цикл
		НовСтр = ТЗС.Добавить();
		НовСтр.Склад = Стр.Склад;
		сскл.Вставить(Стр.Склад, ТЗС.Индекс(НовСтр)); 
	КонецЦикла;	   
		 
	Для каждого Стр из ТЗост цикл
		Если ЗначениеЗаполнено(Стр.Склад) и Стр.Остаток > 0 
			Тогда
			ИмяКолонки = Строка("Ост_" + Строка(Стр.Код)); 	
			НовСтр = ТЗС[сскл.Получить(Стр.Склад)];
			НовСтр[ИмяКолонки] = Стр.Остаток;
		КонецЕсли;
	КонецЦикла;	
	
	// теперь попробуем заполнить форму
	
	Для каждого Стр из ТЗ цикл
		
	Ч = Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10,2));
	Б = Новый ОписаниеТипов("Булево");

	МассивДобавляемыхРеквизитов = Новый Массив; 
	имя = Строка("Ост_" + Строка(Стр.Код));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(Имя, Ч, "ТаблицаПодбора" ,Имя)); 
	имя = Строка("Выб_" + Строка(Стр.Код));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(Имя, Б, "ТаблицаПодбора" ,Имя)); 
	имя = Строка("Кол_" + Строка(Стр.Код));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(Имя, Ч, "ТаблицаПодбора" ,Имя)); 
    ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);     
	
	Если ЗначениеЗаполнено(Стр.Характеристика) 
		Тогда
		ИмяГрКол = Строка(Стр.Номенклатура) + " / " + Строка(Стр.Характеристика) + ", " + строка(Стр.Номенклатура.ЕдиницаИзмерения);
	Иначе
		ИмяГрКол = Строка(Стр.Номенклатура) + ", " + строка(Стр.Номенклатура.ЕдиницаИзмерения)	
	КонецЕсли;
	
	ТаблицаТовары = Элементы.ТаблицаПодбораФорма;
	имяКолонки = "К_" + Строка(Стр.Код); // "К_1"
	НоваяГруппа = Элементы.Добавить(имяКолонки,Тип("ГруппаФормы"),ТаблицаТовары);
	НоваяГруппа.Заголовок = ИмяГрКол;
	НоваяГруппа.Вид = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппа.ОтображатьВШапке = Истина;  
	НоваяГруппа.РастягиватьПоВертикали = Истина;
	НоваяГруппа.Ширина = 100;
	НоваяГруппа.Группировка = ГруппировкаКолонок.Горизонтальная;
	БазШрифт = Элементы.ТаблицаПодбораСклад.ШрифтЗаголовка;
	
	
	мШрифт = Новый Шрифт(, , Истина, );
	НоваяГруппа.ШрифтЗаголовка = мШрифт;
		
	имя = Строка("Ост_" + Строка(Стр.Код));	
	//Род = строка("Элементы.ТаблицаПодбораФорма" + "." + имяКолонки);
	НоваяКолонка = Элементы.Добавить(Имя, Тип("ПолеФормы"),НоваяГруппа); 
	НоваяКолонка.Заголовок = "Залишок"; 
	НоваяКолонка.ПутьКДанным = строка("ТаблицаПодбора."+имя); 
	НоваяКолонка.Вид = ВидПоляФормы.ПолеНадписи; 
	//НоваяКолонка.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	//
	имя = Строка("Выб_" + Строка(Стр.Код));	
	НоваяКолонка = Элементы.Добавить(Имя, Тип("ПолеФормы"),НоваяГруппа); 
	НоваяКолонка.Заголовок = "В"; 
	НоваяКолонка.ПутьКДанным = строка("ТаблицаПодбора."+имя); 
	НоваяКолонка.Вид = ВидПоляФормы.ПолеФлажка; 
	//НоваяКолонка.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
    //
	имя = Строка("Кол_" + Строка(Стр.Код));	
	НоваяКолонка = Элементы.Добавить(Имя, Тип("ПолеФормы"),НоваяГруппа); 
	НоваяКолонка.Заголовок = "Обрано"; 
	НоваяКолонка.ПутьКДанным = строка("ТаблицаПодбора."+имя); 
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода; 
	//НоваяКолонка.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	
	КонецЦикла;
	
	// заполним иаблицу
	
	ЭтаФорма.ТаблицаИтогов.Загрузить(ТЗ);
	Для каждого Стр из ЭтаФорма.ТаблицаИтогов цикл
		Стр.Нужно = Стр.Количество;
	КонецЦикла;
	
	ЭтаФорма.ТаблицаПодбора.Загрузить(ТЗС);
	
		
КонецПроцедуры	

&НаКлиенте
Процедура ТаблицаПодбораФормаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
			
	Если	
		Поле.Имя = "ТаблицаПодбораСклад"
		Тогда
		ТекСтр = Элементы.ТаблицаПодбораФорма.ТекущиеДанные;
		Для каждого Стр из ЭтаФорма.ТаблицаИтогов цикл
			нПоля = Стр.Код;
			ОстатокКПодбору = ЭтаФорма.ТаблицаИтогов[нПоля-1].Нужно;
			ОстатокПоСкладуВыбора = ТекСтр[Строка("Ост_"+нПоля)];
			Выбрано = мин(ОстатокКПодбору,ОстатокПоСкладуВыбора);
			
			Если Выбрано > 	0   
				Тогда
				ТекСтр[Строка("Кол_"+нПоля)] = Выбрано;
				ТекСтр[Строка("Выб_"+нПоля)] = Истина;
				ЭтаФорма.ТаблицаИтогов[нПоля-1].Выбрано = Выбрано;	
				ЭтаФорма.ТаблицаИтогов[нПоля-1].Выбрано = Выбрано;
				ЭтаФорма.ТаблицаИтогов[нПоля-1].Нужно = ЭтаФорма.ТаблицаИтогов[нПоля-1].Количество - ЭтаФорма.ТаблицаИтогов[нПоля-1].Выбрано;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	
	СформироватьУведомления();
		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПодбораФормаПриИзменении(Элемент)
	
	ТекСтр = Элементы.ТаблицаПодбораФорма.ТекущиеДанные;
	ТекПоле = Элементы.ТаблицаПодбораФорма.ТекущийЭлемент.Имя;
	
	кПоля = Лев(ТекПоле,4);
	
	Если кПоля = "Выб_"
		Тогда
		Ном = СтрЗаменить(ТекПоле,кПоля,""); 
		нПоля = число(Ном);
		
		Если
			ТекСтр[Строка(кПоля+нПоля)] = Истина
			Тогда
			ОстатокКПодбору = ЭтаФорма.ТаблицаИтогов[(нПоля-1)].Нужно;
			ОстатокПоСкладуВыбора = ТекСтр[Строка("Ост_"+нПоля)];
			Выбрано = мин(ОстатокКПодбору,ОстатокПоСкладуВыбора);
			ТекСтр[Строка("Кол_"+нПоля)] = 	Выбрано;
			
			Если Выбрано > 0 тогда
				ЭтаФорма.ТаблицаИтогов[нПоля-1].Выбрано = Выбрано;
				ЭтаФорма.ТаблицаИтогов[нПоля-1].Нужно = ЭтаФорма.ТаблицаИтогов[нПоля-1].Количество - ЭтаФорма.ТаблицаИтогов[нПоля-1].Выбрано;
			Иначе
				ТекСтр[Строка("Выб_"+нПоля)] = Ложь;
			КонецЕсли;	
			
		Иначе
			ТекСтр[Строка("Кол_"+нПоля)] = 0;
			// обвновим итоги по данной позиции
			КолВыб = 0;
			ИмяПоля = Строка ("Кол_" +нПоля);
			Для каждого Стр из ЭтаФорма.ТаблицаПодбора цикл
				КолВыб = КолВыб + число(Стр[ИмяПоля]);
			КонецЦикла;
			ЭтаФорма.ТаблицаИтогов[нПоля-1].Выбрано = КолВыб;
			ЭтаФорма.ТаблицаИтогов[нПоля-1].Нужно = ЭтаФорма.ТаблицаИтогов[нПоля-1].Количество - КолВыб;
		КонецЕсли;	
		
	ИначеЕсли	
		кПоля = "Кол_"
		Тогда         
		Ном = СтрЗаменить(ТекПоле,кПоля,""); 
		нПоля = число(Ном);
		
		Если 
			ЭтаФорма.ТаблицаПодбора[нПоля-1][Строка(кПоля+нПоля)] = Истина
			Тогда
			ОстатокКПодбору = ЭтаФорма.ТаблицаИтогов[(нПоля-1)].Нужно;
			ОстатокПоСкладуВыбора = ТекСтр[Строка("Ост_"+нПоля)];
			ВставленоРуками = ТекСтр[Строка("Кол_"+нПоля)];
			Выбрано = мин(ОстатокКПодбору,ОстатокПоСкладуВыбора-ВставленоРуками,ВставленоРуками);
			ТекСтр[Строка("Кол_"+нПоля)] = Выбрано;
			
			ЭтаФорма.ТаблицаИтогов[нПоля-1].Выбрано = Выбрано;
			ЭтаФорма.ТаблицаИтогов[нПоля-1].Нужно = ЭтаФорма.ТаблицаИтогов[нПоля-1].Количество - ЭтаФорма.ТаблицаИтогов[нПоля-1].Выбрано;
		Иначе
			ТекСтр[Строка("Кол_"+нПоля)] = 0;
			
		КонецЕсли;	 
	КонецЕсли;

	СформироватьУведомления();

		
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДокументы(Команда)
	
	// сформируем массив структур, сожержащих массивы
	// одна структура - одна реализация
	
	ПП = Новый Структура("М, ДокОбъект, Комментарий");
	М = Новый Массив;
	
	Для каждого Стр из ЭтаФорма.ТаблицаПодбора цикл
				
		Для каждого СтрТ из ЭтаФорма.ТаблицаИтогов цикл
			ИмяИскомойЯчейки = Строка("Кол_" + Строка(СтрТ.Код));	
			Если Число(Стр[ИмяИскомойЯчейки]) > 0
				Тогда
				П = Новый Структура("Номенклатура, Характеристика, Количество, Склад");
                П.Номенклатура = СтрТ.Номенклатура;
				П.Характеристика = СтрТ.Характеристика;
				П.Количество = Число(Стр[ИмяИскомойЯчейки]);
				П.Склад = Стр.Склад;
				М.Добавить(П);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ПП.М = М;
	ПП.ДокОбъект = ЭтаФорма.ДокОбъект;
	ПП.Комментарий = ЭтаФорма.ПараметрыДоставки;
	
	ЭтаФорма.Закрыть(ПП);
  
КонецПроцедуры

&НаКлиенте
Процедура СформироватьУведомления()
	
	ОсталосьПодобрать = ЭтаФорма.ТаблицаИтогов.Итог("Нужно");
	
	Если ОсталосьПодобрать > 0 Тогда
		 Текст = "Підбору потребує " + Строка(ОсталосьПодобрать) + " од товару";
		 Цвет = WebЦвета.Розовый;      
		 ЦветТекста = WebЦвета.Красный;
		 
	Иначе
		Текст = "Усі замовлення забезпечені";
		Цвет = WebЦвета.ЗеленаяЛужайка;
		ЦветТекста = WebЦвета.Черный;
		
	КонецЕсли;	

	ЭтаФорма.Элементы.Уведомление.Заголовок = Текст;
	ЭтаФорма.Элементы.Уведомление.ЦветТекста = ЦветТекста; 
	ЭтаФорма.Элементы.СформироватьДокументы.ЦветФона = Цвет;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СформироватьУведомления();

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	ЭтаФорма.Закрыть(Неопределено);
	
КонецПроцедуры

	
	